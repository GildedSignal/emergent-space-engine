{
  "contract_id": "es-litmus-gallery-v0",
  "date": "2026-09-14",
  "status": "frozen-cues-and-interfaces",
  "not": [
    "gravity-law",
    "glm-shortcut",
    "gallery-ui",
    "Engine::advance"
  ],
  "canonical_engine_law_id": "es-inertial-causal-v1",
  "gallery_gravity_law_id": {
    "status": "UNCONFIRMED",
    "value": null,
    "note": "Owned by packet 1 law specialist. Julien has not selected a finite coupled law."
  },
  "rng_version_inertial": "emergent-space-random-v1",
  "semantic_random": {
    "function": "semantic_random",
    "args": ["seed", "entity", "event", "purpose", "lane"],
    "seed_type": "u64",
    "note": "Never keyed by task order or family partitioning."
  },
  "governing": [
    "docs/compiler-engine-plan-20260913.md behavior instrument and seed tables",
    "heading-check card emergent-space.md",
    "HISTORY H0075 visual families",
    "HISTORY H0070 light-bend must-feel"
  ],
  "judgment": {
    "steps": [
      "Read intended_outcome_class",
      "Glance look_for for that class",
      "Fast-fail on looks_wrong",
      "Expand physical_checks only if glance is ambiguous"
    ],
    "seed_diversity": "A second seed may yield a different allowed class. It cannot erase the first result.",
    "no_seed_search": true,
    "gallery_does_not_prove_all_future_behavior": true
  },
  "cards": [
    {
      "id": "fast-ships-light-twins",
      "glance": "Light always leaves at c; clocks and sky fit the motion.",
      "look_for": "Pulses reach moving receivers in an order that matches emission events and finite c. A boosted observer sees direction and arrival times change while the same physical events stay put. Accumulated proper time fits the worldline.",
      "looks_wrong": [
        "Emitter speed is added to light",
        "Rotating or boosting the camera changes when pulses meet",
        "Reunion aging is equal after a high-speed trip",
        "Already-received pulses reorder after a frame change"
      ],
      "do_not_force": "Not every seed is a closed twin circuit or a textbook Doppler poster. A one-way pulse to a receding ship is enough if arrivals and clocks fit the motion.",
      "allowed_outcome_classes": [
        "one_way_pulse",
        "moving_receiver",
        "twin_reunion",
        "aberration_only"
      ],
      "physical_checks": [
        "local light speed",
        "aberration",
        "admitted Doppler ratios",
        "accumulated proper time from the same geometry as the pulses"
      ],
      "dimensionless_controls": ["v_over_c"]
    },
    {
      "id": "solar-system-hierarchy",
      "glance": "A supported hierarchy stays organized; a kick breathes, it does not snap to a circle.",
      "look_for": "Bound configurations initialized in a supported stable regime remain organized over the declared duration. Perturbations and precession appear smoothly. Inner and outer motions keep distinct timescales.",
      "looks_wrong": [
        "Every seed spirals in or out numerically",
        "Every orbit is forced perfect despite perturbations",
        "A small kick instantly circularizes or unbinds the whole hierarchy",
        "Inner and outer periods look the same"
      ],
      "do_not_force": "Not every seed is a miniature Solar System. A binary plus distant companion, a compact pair, or a mildly eccentric hierarchy all count. An unbound flyby belongs to three-body classes.",
      "allowed_outcome_classes": [
        "supported_hierarchy",
        "binary_plus_companion",
        "perturbed_precessing",
        "compact_pair"
      ],
      "physical_checks": [
        "timescales",
        "source recoil",
        "drift",
        "magnitude relations"
      ],
      "dimensionless_controls": [
        "mass_ratio",
        "compactness_gm_over_r_c2",
        "perturbation_duration_orbits"
      ]
    },
    {
      "id": "three-bodies",
      "glance": "Nested seeds can stay bound; encounter seeds can swap, eject, or go messy.",
      "look_for": "At least one hierarchical diagnostic seed can remain bound over the declared window. Encounter seeds can exchange partners, eject a body, or become chaotic. Trajectories stay continuous through close passes.",
      "looks_wrong": [
        "Every seed must remain stable to pass",
        "Bodies jump through encounters",
        "The chaotic seed is a looped identical animation",
        "A different late trajectory is treated as a compiler regression"
      ],
      "do_not_force": "Do not require the same late identity. Stability is one class, not a universal pass. Report the mix.",
      "allowed_outcome_classes": [
        "hierarchical_bound",
        "partner_exchange",
        "ejection",
        "chaotic_close_pass"
      ],
      "physical_checks": [
        "conserved or accounted quantities",
        "short-time reference behavior",
        "ensemble outcomes"
      ],
      "dimensionless_controls": [
        "mass_ratio",
        "closest_approach_ratio"
      ]
    },
    {
      "id": "galaxy-like-population",
      "glance": "The crowd shears together; mass, not sprites, moves it.",
      "look_for": "Coherent collective motion and shear. An introduced perturber dents the flow. Member masses affect the common field.",
      "looks_wrong": [
        "Decorative test particles",
        "Every seed is forced into a spiral",
        "Already-seen motion changes when more members are decoded",
        "A reduced scene is sold as cosmological formation"
      ],
      "do_not_force": "Not every seed is a grand-design spiral. A clumpy disk, a triaxial blob, or a sheared stream can pass if collective and mass-responsive.",
      "allowed_outcome_classes": [
        "sheared_disk",
        "clumpy_collection",
        "triaxial_blob",
        "perturber_response"
      ],
      "physical_checks": [
        "mass accounting",
        "density and velocity profiles",
        "perturbation response over declared dynamical times"
      ],
      "dimensionless_controls": [
        "mass_ratio",
        "perturbation_duration_orbits"
      ]
    },
    {
      "id": "black-hole-near-mass",
      "glance": "Closer pass: more bend, more delay; too close, no return; clocks agree with that story.",
      "look_for": "A connected family from weak flyby through strong bending and delay into absorbing capture. Near-mass clocks run slow in a way compatible with the same geometry.",
      "looks_wrong": [
        "Rays pass through an absorbing region",
        "Extra delay vanishes after a cache or partition change",
        "Bend, delay and clocks disagree",
        "Interiors are required to tell the capture story"
      ],
      "do_not_force": "Not every seed is a photon-sphere postcard. A weak-field graze plus one capture seed is a valid family. How much bend is band-UNCONFIRMED; whether light bends and takes extra time is must-feel.",
      "allowed_outcome_classes": [
        "weak_flyby",
        "strong_bending_delay",
        "absorbing_capture",
        "near_mass_clock"
      ],
      "physical_checks": [
        "supported compact trajectories",
        "reception",
        "committed history"
      ],
      "dimensionless_controls": [
        "compactness_gm_over_r_c2",
        "closest_approach_ratio",
        "v_over_c"
      ]
    },
    {
      "id": "fleet-asteroid-causal",
      "glance": "Many specks matter together; news arrives at different times; later motion feels the change.",
      "look_for": "Many small masses jointly affect a larger body. Weak influence accumulates. A source or course change reaches different observers at different times and produces later feedback.",
      "looks_wrong": [
        "Remote bodies react before possible influence",
        "Old gravity disappears at capture",
        "Small-body effect is dropped",
        "Overlay sampling moves the asteroid"
      ],
      "do_not_force": "Not every seed needs a visible asteroid shove in one short loop. Cumulative effect may be tiny — if magnified, label it. A too-sparse fleet is a reported outcome, not a cue to hunt a prettier seed.",
      "allowed_outcome_classes": [
        "collective_nudge",
        "slow_backreaction",
        "staggered_arrival",
        "capture_keeps_history"
      ],
      "physical_checks": [
        "materialized small-world comparison",
        "direction and magnitude of moving-source response",
        "source/field exchange",
        "A-to-B-to-A feedback"
      ],
      "dimensionless_controls": [
        "mass_ratio",
        "perturbation_duration_orbits",
        "v_over_c"
      ]
    }
  ],
  "coupled_transition": {
    "id": "coupled-fleet-hierarchy-inflight-ray-observer-boost",
    "seventh_physics": false,
    "description": "A fleet perturbs a hierarchical system while a ray is in flight and the observer changes speed.",
    "reuses_cards": [
      "solar-system-hierarchy",
      "fast-ships-light-twins",
      "black-hole-near-mass",
      "fleet-asteroid-causal"
    ],
    "look_for": "Conjunction of hierarchy organization, in-flight light, observer boost, and delayed many-body feedback.",
    "looks_wrong": [
      "Any participating card fast-fail",
      "The ray's committed history changes because the observer boosted"
    ]
  },
  "work_overlay": {
    "kinds": [
      "reuse",
      "newly_compiled",
      "refinement",
      "repaired_prediction"
    ],
    "sampling_charged": true,
    "mutates_world": false,
    "must_preserve": "history_digest at a declared committed cut",
    "budget_type": "WorkBudget"
  },
  "comparison_classes": [
    {
      "id": "compiler_only",
      "fixed": [
        "law_id",
        "resolved_initial_state",
        "interventions",
        "queried_cuts"
      ],
      "must_agree": "Canonical outcomes exactly, including chaotic worlds."
    },
    {
      "id": "physical_law",
      "fixed": [
        "literal shared initial states where both laws admit them",
        "new law_id retained"
      ],
      "must_agree": "Short-time physical relationships, regime-dependent magnitude anchors, and ensemble structure. Long chaotic trajectories need not coincide."
    },
    {
      "id": "law_aware_init",
      "fixed": [
        "declared common distribution of physical regimes",
        "both generator versions and both resulting states recorded"
      ],
      "must_agree": "Behavior across that distribution. Recomputing equilibrium initial conditions is a separate experiment."
    },
    {
      "id": "generator_only",
      "fixed": [
        "physical law",
        "declared target distribution"
      ],
      "must_agree": "Generated-state properties and outcome distributions. The same numeric seed may now produce a different world."
    }
  ],
  "seed_policy": {
    "seed_is_not_universe_identity": true,
    "no_seed_search_until_law_appears_to_work": true,
    "second_seed_cannot_erase_first_result": true,
    "report_unstable_rejected_and_failed": true,
    "init_rejection_independent_of_outcome": true,
    "retain_rejection_rate": true,
    "banks": {
      "diagnostic": {
        "use": "daily feedback; small fixed set of short cases",
        "numeric_seeds": { "status": "UNCONFIRMED", "value": null }
      },
      "held_out": {
        "use": "predeclared; not used for tuning; candidate decisions",
        "numeric_seeds": { "status": "UNCONFIRMED", "value": null }
      }
    },
    "roles_frozen_not_lucky_numbers": true
  },
  "dimensionless_controls": {
    "v_over_c": { "symbol": "v/c", "role": "kinematic / twin / boost regime" },
    "compactness_gm_over_r_c2": {
      "symbol": "GM/(r c^2)",
      "role": "weak vs strong field"
    },
    "mass_ratio": { "symbol": "m_i/m_j", "role": "hierarchy / three-body / fleet" },
    "closest_approach_ratio": {
      "symbol": "r_min/r_ref",
      "role": "flyby vs capture vs encounter"
    },
    "perturbation_duration_orbits": {
      "symbol": "Delta t / P",
      "role": "backreaction window"
    },
    "exact_encoding": "rational string",
    "display_float": "presentation only, not canonical"
  },
  "numeric_bands": {
    "status": "UNCONFIRMED",
    "julien_has_chosen": false,
    "not_gates": true,
    "no_universal_percentage": true,
    "regimes": [
      {
        "id": "kinematic",
        "controls": ["v_over_c"],
        "observables": ["pulse_order", "aberration", "twin_aging"],
        "band": { "status": "UNCONFIRMED", "value": null }
      },
      {
        "id": "weak_field",
        "controls": ["compactness_gm_over_r_c2"],
        "observables": ["graze_bend", "extra_delay", "clock_rate"],
        "band": { "status": "UNCONFIRMED", "value": null }
      },
      {
        "id": "close_encounter",
        "controls": ["closest_approach_ratio", "mass_ratio"],
        "observables": ["partner_exchange_vs_jump"],
        "band": { "status": "UNCONFIRMED", "value": null }
      },
      {
        "id": "strong_field_compact",
        "controls": ["compactness_gm_over_r_c2", "closest_approach_ratio"],
        "observables": ["connected_flyby_to_capture"],
        "band": { "status": "UNCONFIRMED", "value": null }
      },
      {
        "id": "collective",
        "controls": ["mass_ratio"],
        "observables": ["shear", "perturber_dent", "decode_invariance"],
        "band": { "status": "UNCONFIRMED", "value": null }
      },
      {
        "id": "slow_backreaction",
        "controls": ["perturbation_duration_orbits", "mass_ratio"],
        "observables": ["fleet_on_asteroid", "A_to_B_to_A"],
        "band": { "status": "UNCONFIRMED", "value": null }
      }
    ]
  },
  "knowledge_channels": [
    {
      "id": "diagnostic",
      "host": "ViewMode::Diagnostic",
      "engine": ["inspect", "position"],
      "may_reveal": "coordinate-time state and true present positions",
      "must_not": "mutate canonical history"
    },
    {
      "id": "historical_sensor",
      "host": "ViewMode::HistoricalSensor",
      "engine": ["observe", "observe_with_budget"],
      "may_reveal": "emission coordinates that have reached the observer",
      "must_not": [
        "silently substitute inferred present positions",
        "empty sky on incomplete query"
      ],
      "incomplete": "pending/warning; ObserveResult.complete = false; does not mutate history_digest"
    },
    {
      "id": "decode_only",
      "engine": ["decode"],
      "may_reveal": "generator parameters",
      "must_not": "certify a future"
    },
    {
      "id": "work_overlay_sample",
      "engine": ["WorkBudget"],
      "may_reveal": "reuse / compile / refine / repair visualization",
      "must_not": "change the world or history_digest"
    }
  ],
  "observatory_host_mapping": {
    "$comment": "Types and existing names only. This packet does not implement gallery UI.",
    "ObservatoryWorld": ["LaboratoryPatch", "InertialLaboratory"],
    "ViewMode": ["HistoricalSensor", "Diagnostic"],
    "UiSnapshot_fields": [
      "canonical_hash",
      "law_name",
      "warning",
      "progress_label",
      "mode"
    ],
    "canonical_hash": "history_digest(through) at a declared completed cut",
    "in_world_planners_use": "historical_sensor"
  },
  "interface_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://emergent.space/schemas/litmus-gallery-run-20260914.json",
    "title": "Litmus gallery run or playback record",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "card_id",
      "law_id",
      "rng_version",
      "seed",
      "intended_outcome_class",
      "seed_bank",
      "comparison_class",
      "normalized_parameters",
      "resolved_initial_state",
      "interventions",
      "observing_frame",
      "queried_cuts",
      "knowledge_channel",
      "playback"
    ],
    "properties": {
      "card_id": {
        "type": "string",
        "enum": [
          "fast-ships-light-twins",
          "solar-system-hierarchy",
          "three-bodies",
          "galaxy-like-population",
          "black-hole-near-mass",
          "fleet-asteroid-causal"
        ]
      },
      "coupled_transition_id": {
        "type": ["string", "null"],
        "enum": [
          null,
          "coupled-fleet-hierarchy-inflight-ray-observer-boost"
        ]
      },
      "law_id": { "type": "string", "minLength": 1 },
      "rng_version": { "type": "string", "minLength": 1 },
      "seed": {
        "description": "Engine seed is u64. JSON numbers are not a full u64; a decimal string is allowed.",
        "oneOf": [
          { "type": "integer", "minimum": 0 },
          { "type": "string", "pattern": "^[0-9]+$" }
        ]
      },
      "intended_outcome_class": { "type": "string", "minLength": 1 },
      "observed_outcome_class": { "type": ["string", "null"] },
      "init_rejected": { "type": "boolean" },
      "seed_bank": { "type": "string", "enum": ["diagnostic", "held_out"] },
      "comparison_class": {
        "type": "string",
        "enum": [
          "compiler_only",
          "physical_law",
          "law_aware_init",
          "generator_only"
        ]
      },
      "normalized_parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "v_over_c",
          "compactness_gm_over_r_c2",
          "mass_ratio",
          "closest_approach_ratio",
          "perturbation_duration_orbits"
        ],
        "properties": {
          "v_over_c": { "$ref": "#/$defs/exactDisplay" },
          "compactness_gm_over_r_c2": { "$ref": "#/$defs/exactDisplay" },
          "mass_ratio": { "$ref": "#/$defs/exactDisplay" },
          "closest_approach_ratio": { "$ref": "#/$defs/exactDisplay" },
          "perturbation_duration_orbits": { "$ref": "#/$defs/exactDisplay" }
        }
      },
      "resolved_initial_state": {
        "type": "object",
        "required": ["genesis_digest"],
        "properties": {
          "genesis_digest": { "type": "string", "minLength": 1 },
          "bodies": { "type": "object" },
          "families": { "type": "array" }
        }
      },
      "interventions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["tick", "observer", "command", "event_id"],
          "properties": {
            "tick": { "type": "integer" },
            "observer": { "type": "integer", "minimum": 0 },
            "command": { "type": "object" },
            "event_id": { "type": "string" }
          }
        }
      },
      "observing_frame": {
        "type": "object",
        "required": ["observer_id", "v_over_c", "knowledge_channel"],
        "properties": {
          "observer_id": { "type": "integer", "minimum": 0 },
          "v_over_c": { "$ref": "#/$defs/exactDisplay" },
          "knowledge_channel": {
            "type": "string",
            "enum": [
              "diagnostic",
              "historical_sensor",
              "decode_only",
              "work_overlay_sample"
            ]
          }
        }
      },
      "queried_cuts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["through"],
          "properties": {
            "through": { "type": "integer" },
            "history_digest": { "type": ["string", "null"] }
          }
        }
      },
      "knowledge_channel": {
        "type": "string",
        "enum": [
          "diagnostic",
          "historical_sensor",
          "decode_only",
          "work_overlay_sample"
        ]
      },
      "work_overlay_sample": {
        "type": ["object", "null"],
        "required": ["kind", "charged", "budget", "mutates_world"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "reuse",
              "newly_compiled",
              "refinement",
              "repaired_prediction"
            ]
          },
          "charged": { "type": "boolean", "const": true },
          "budget": {
            "type": "object",
            "required": ["operations"],
            "properties": {
              "operations": { "type": "integer", "minimum": 0 },
              "max_events": { "type": "integer", "minimum": 0 }
            }
          },
          "mutates_world": { "type": "boolean", "const": false }
        }
      },
      "playback": {
        "type": "object",
        "required": ["cached", "law_id"],
        "properties": {
          "cached": { "type": "boolean" },
          "law_id": { "type": "string" },
          "source_revision": { "type": ["string", "null"] },
          "label": { "type": "string" }
        },
        "if": { "properties": { "cached": { "const": true } } },
        "then": {
          "required": ["cached", "law_id", "label"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "Must state this is cached playback, not a fresh validation run."
            }
          }
        }
      },
      "magnification": {
        "type": "object",
        "required": ["factor"],
        "properties": {
          "factor": { "type": "number" },
          "label": { "type": ["string", "null"] },
          "effect": { "type": ["string", "null"] }
        },
        "if": {
          "not": { "properties": { "factor": { "const": 1 } } }
        },
        "then": {
          "required": ["factor", "label"],
          "properties": { "label": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "$defs": {
      "exactDisplay": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["exact"],
            "additionalProperties": false,
            "properties": {
              "exact": {
                "type": "string",
                "description": "Canonical rational string, engine style."
              },
              "display": { "type": ["number", "null"] }
            }
          }
        ]
      }
    }
  }
}
