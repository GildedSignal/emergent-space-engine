diff --git a/crates/universe/src/keytrace.rs b/crates/universe/src/keytrace.rs
new file mode 100644
index 00000000..3a80bf86
--- /dev/null
+++ b/crates/universe/src/keytrace.rs
@@ -0,0 +1,33 @@
+//! A lab probe (run 20261015-1450-library-3793): an env-gated trace of every in-flight read of a
+//! standing binding's compiled trajectory, keyed by catalogue slot (`tube.key`, the key a lazy
+//! retained-entry cache would be keyed on). `ES_KEYTRACE=1` arms it; the flight harness dumps the
+//! read sequence to `ES_KEYTRACE_OUT` at the canonical cut, so bounded-cache policies (LRU, 2Q)
+//! can be priced offline by replaying the exact trace the engine produced. Off by default: one
+//! branch per read.
+
+use std::io::Write;
+use std::sync::{LazyLock, Mutex};
+
+static TRACE: LazyLock<Option<Mutex<Vec<u32>>>> =
+    LazyLock::new(|| std::env::var("ES_KEYTRACE").ok().map(|_| Mutex::new(Vec::new())));
+
+#[inline]
+pub fn touch(key: u32) {
+    if let Some(t) = TRACE.as_ref() {
+        if let Ok(mut v) = t.lock() {
+            v.push(key);
+        }
+    }
+}
+
+/// Write the trace (little-endian u32 keys) and return its length. Not part of the engine.
+pub fn dump(path: &str) -> std::io::Result<usize> {
+    let Some(t) = TRACE.as_ref() else { return Ok(0) };
+    let v = std::mem::take(&mut *t.lock().unwrap());
+    let mut f = std::io::BufWriter::new(std::fs::File::create(path)?);
+    for k in &v {
+        f.write_all(&k.to_le_bytes())?;
+    }
+    f.flush()?;
+    Ok(v.len())
+}
