diff --git a/crates/universe/src/rcensus.rs b/crates/universe/src/rcensus.rs
new file mode 100644
index 00000000..ad6dc0bf
--- /dev/null
+++ b/crates/universe/src/rcensus.rs
@@ -0,0 +1,235 @@
+//! The read census (lab run 20261021-0429-spacex-9d3a): between the events that rebuild a body's
+//! binding, who reads the compiled trajectory it stands for, and how long after the last touch it
+//! stays untouched. One question: is the engine's live set the bodies, or only the bodies around
+//! their events (the board's macro row "live set and memory": demotion back to the compact store)?
+//!
+//! Gated by ES_RCENSUS=1; otherwise every hook is one relaxed load. Identity is the `Entry`
+//! allocation address (an `Arc` per mint; reuse of an address closes the generation that held it).
+//! The harness sets FRAME per frame and PHASE (1 engine, 2 view gather, 3 sampling).
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+
+pub static ON: AtomicBool = AtomicBool::new(false);
+pub static FRAME: AtomicU32 = AtomicU32::new(0);
+pub static PHASE: AtomicU32 = AtomicU32::new(0);
+pub static MISSES: AtomicU64 = AtomicU64::new(0);
+
+/// Demotion slacks in frames (60 fps): an entry untouched longer than S is demotion-eligible;
+/// a read after a gap > S is the rebuild a demotion policy would pay.
+pub const SLACKS: [u32; 4] = [1, 60, 300, 1200];
+
+pub(crate) const M_ORBIT: u8 = 0;
+pub(crate) const M_READOUT: u8 = 1;
+
+/// Read ES_RCENSUS and arm the census.
+pub fn init() {
+    let on = std::env::var("ES_RCENSUS").map_or(false, |v| v == "1");
+    ON.store(on, Ordering::Relaxed);
+}
+
+struct Gen {
+    mint: u32,
+    last_act: u32,
+    closed: u32, // frame the allocation was dropped (u32::MAX = still open)
+    reads: [u32; 4], // orbit-engine, orbit-view, readout-engine, readout-view
+    birth_reads: u32, // reads in the mint's own frame (the mint's birth-read)
+    rebuilds: [u32; SLACKS.len()],
+}
+
+thread_local! {
+    static C: RefCell<State> = RefCell::new(State { ids: HashMap::new(), gens: Vec::new(), reads_total: [0; 4], sampled: 0, live_samples: [0u64; SLACKS.len()] });
+}
+
+struct State {
+    ids: HashMap<usize, u32>,
+    gens: Vec<Gen>,
+    reads_total: [u64; 4],
+    sampled: u32,
+    live_samples: [u64; SLACKS.len()],
+}
+
+fn key(entry: &super::bind::Entry) -> usize {
+    entry as *const _ as usize
+}
+
+/// A compiled trajectory was minted (creation or rebind).
+pub fn mint(entry: &super::bind::Entry) {
+    if !ON.load(Ordering::Relaxed) {
+        return;
+    }
+    let f = FRAME.load(Ordering::Relaxed);
+    let k = key(entry);
+    let ok = C.try_with(|c| {
+        let mut c = c.borrow_mut();
+        let next = c.gens.len() as u32;
+        match c.ids.insert(k, next) {
+            None => {
+                c.gens.push(Gen { mint: f, last_act: f, closed: u32::MAX, reads: [0; 4], birth_reads: 0, rebuilds: [0; SLACKS.len()] });
+            }
+            Some(old) => {
+                // address reused: the old generation is closed, a new one begins
+                let _ = old;
+                c.gens.push(Gen { mint: f, last_act: f, closed: u32::MAX, reads: [0; 4], birth_reads: 0, rebuilds: [0; SLACKS.len()] });
+            }
+        }
+    });
+    if ok.is_err() {
+        MISSES.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// The allocation behind a generation was dropped (the entry is out of the catalogue and of history).
+pub fn close(addr: usize) {
+    if !ON.load(Ordering::Relaxed) {
+        return;
+    }
+    let f = FRAME.load(Ordering::Relaxed);
+    let ok = C.try_with(|c| {
+        let id = c.borrow().ids.get(&addr).copied();
+        if let Some(id) = id {
+            c.borrow_mut().gens[id as usize].closed = f;
+        }
+    });
+    if ok.is_err() {
+        MISSES.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// A binding was read through its compiled trajectory. `method`: 0 orbit_state, 1 readout (cartesian
+/// delegates to readout).
+pub fn read(entry: &super::bind::Entry, method: u8) {
+    if !ON.load(Ordering::Relaxed) {
+        return;
+    }
+    let f = FRAME.load(Ordering::Relaxed);
+    let phase = PHASE.load(Ordering::Relaxed);
+    let k = key(entry);
+    let ok = C.try_with(|c| {
+        let mut c = c.borrow_mut();
+        c.reads_total[(method as usize) * 2 + (phase == 2) as usize] += 1;
+        let Some(id) = c.ids.get(&k).copied() else { MISSES.fetch_add(1, Ordering::Relaxed); return };
+        let g = &mut c.gens[id as usize];
+        g.reads[(method as usize) * 2 + (phase == 2) as usize] += 1;
+        if f == g.mint {
+            g.birth_reads += 1;
+        }
+        let gap = f.saturating_sub(g.last_act);
+        for (s, slack) in SLACKS.iter().enumerate() {
+            if gap > *slack {
+                g.rebuilds[s] += 1;
+            }
+        }
+        g.last_act = f;
+    });
+    if ok.is_err() {
+        MISSES.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Working-set sample: fraction of generations alive (minted by f) whose last touch is within each slack.
+pub fn sample() {
+    if !ON.load(Ordering::Relaxed) {
+        return;
+    }
+    let f = FRAME.load(Ordering::Relaxed);
+    let _ = C.try_with(|c| {
+        let mut c = c.borrow_mut();
+        c.sampled += 1;
+        let mut alive = 0u64;
+        let mut live = [0u64; SLACKS.len()];
+        for g in &c.gens {
+            if g.mint > f || g.closed <= f {
+                continue;
+            }
+            alive += 1;
+            for (s, slack) in SLACKS.iter().enumerate() {
+                if f.saturating_sub(g.last_act) <= *slack {
+                    live[s] += 1;
+                }
+            }
+        }
+        if alive > 0 {
+            for s in 0..SLACKS.len() {
+                c.live_samples[s] += live[s] * 100_000 / alive;
+            }
+        }
+    });
+}
+
+/// The census line: every number the dossier's demotion arithmetic needs.
+pub fn report(bodies: usize, catalogue_live: usize, bytes_per_body: usize, frames_run: u32) {
+    println!("rcensus-on");
+    let _ = frames_run;
+    let _ = C.try_with(|c| {
+        let c = c.borrow();
+        let gens = c.gens.len() as u64;
+        let mut zero_post = 0u64;
+        let mut zero_all = 0u64;
+        let mut zero_post_build = 0u64;
+        let mut still_open = 0u64;
+        let mut hist = [0u64; 8];
+        let mut in_flight = 0u64;
+        let mut rebuilds = [0u64; SLACKS.len()];
+        let mut rebuilds_buildborn = [0u64; SLACKS.len()];
+        for g in &c.gens {
+            let r = g.reads.iter().sum::<u32>();
+            if r == 0 {
+                zero_all += 1;
+            }
+            if r == g.birth_reads {
+                zero_post += 1;
+                if g.mint == 0 {
+                    zero_post_build += 1;
+                }
+            }
+            if g.closed == u32::MAX {
+                still_open += 1;
+            }
+            let b = (r as usize).min(255);
+            let h = if b == 0 { 0 } else if b == 1 { 1 } else if b < 4 { 2 } else if b < 8 { 3 } else if b < 16 { 4 } else if b < 64 { 5 } else if b < 256 { 6 } else { 7 };
+            hist[h] += 1;
+            if g.mint > 0 {
+                in_flight += 1;
+                for s in 0..SLACKS.len() {
+                    rebuilds[s] += g.rebuilds[s] as u64;
+                }
+            } else {
+                for s in 0..SLACKS.len() {
+                    rebuilds_buildborn[s] += g.rebuilds[s] as u64;
+                }
+            }
+        }
+        println!(
+            "rcensus: gens={gens} bodies={bodies} catalogue_live={catalogue_live} bytes_per_body={bytes_per_body} in_flight_gens={in_flight} build_born={}",
+            gens - in_flight
+        );
+        println!(
+            "rcensus reads: total={} orbit_engine={} orbit_view={} readout_engine={} readout_view={} misses={}",
+            c.reads_total.iter().sum::<u64>(),
+            c.reads_total[0], c.reads_total[1], c.reads_total[2], c.reads_total[3],
+            MISSES.load(Ordering::Relaxed)
+        );
+        println!(
+            "rcensus gens: zero_read={zero_all} zero_post_birth={zero_post} pct_zero_post={:.2} zero_post_build={zero_post_build} build_born={} pct_zero_post_build={:.2} still_open={still_open} hist_0_1_2-3_4-7_8-15_16-63_64-255_256p={}",
+            100.0 * zero_post as f64 / gens.max(1) as f64,
+            gens - in_flight,
+            100.0 * zero_post_build as f64 / (gens - in_flight).max(1) as f64,
+            hist.iter().map(|h| h.to_string()).collect::<Vec<_>>().join("_")
+        );
+        if c.sampled > 0 {
+            println!(
+                "rcensus live fraction (avg over {} samples, slack frames {:?}): {}",
+                c.sampled,
+                SLACKS,
+                c.live_samples.iter().map(|l| format!("{:.5}", (*l as f64) / (c.sampled as f64) / 100_000.0)).collect::<Vec<_>>().join(" ")
+            );
+        }
+        println!(
+            "rcensus rebuilds by slack {:?}: build_born={} in_flight={}",
+            SLACKS,
+            rebuilds_buildborn.iter().map(|r| r.to_string()).collect::<Vec<_>>().join("_"),
+            rebuilds.iter().map(|r| r.to_string()).collect::<Vec<_>>().join("_")
+        );
+    });
+}
