diff --git a/crates/universe/examples/rcensus.rs b/crates/universe/examples/rcensus.rs
new file mode 100644
index 00000000..34f2cab0
--- /dev/null
+++ b/crates/universe/examples/rcensus.rs
@@ -0,0 +1,105 @@
+//! The read census (lab run 20261021-0429-spacex-9d3a): the plane plus N belt bodies, flown the way
+//! the page flies it (nladder's loop: 60 frames a second of wall time at rtf 100, `frame_to`, 12 ms
+//! engine budget), with every read of every compiled trajectory counted per generation (an `Entry`
+//! from its mint to its replacement). The question is the board's macro row "live set and memory":
+//! between a body's events, is its compiled orbit read at all — i.e. is the live set the bodies, or
+//! only the bodies around their events? `ES_RCENSUS=1` arms the census; without it the run is a
+//! plain nladder flight (one relaxed load a read).
+//!
+//! cargo run --release -p emergent-universe --example rcensus [-- <N> [<wall seconds> [<view: none|frame|sparse>]]]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::view::{gather_cached, ViewCache, TICK_SECONDS};
+use emergent_universe::{Budget, Config};
+use emergent_universe::rcensus;
+use std::time::{Duration, Instant};
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+fn footprint() -> (u64, u64) {
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+        for line in s.lines() {
+            if let Some(v) = line.strip_prefix("VmRSS:") {
+                now = v.trim().trim_end_matches(" kB").parse::<u64>().unwrap_or(0) * 1024;
+            } else if let Some(v) = line.strip_prefix("VmHWM:") {
+                peak = v.trim().trim_end_matches(" kB").parse::<u64>().unwrap_or(0) * 1024;
+            }
+        }
+    }
+    (now, peak)
+}
+
+fn main() {
+    rcensus::init();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let seconds: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(20.0);
+    let view_mode = args.get(3).cloned().unwrap_or_else(|| "none".into());
+    let frames = (seconds * 60.0) as usize;
+    let t_start = Instant::now();
+    let (_, peak0) = footprint();
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let (now1, rss1) = footprint();
+    let bodies = p.u.n_bodies();
+    println!("rcensus rung N={n} ({bodies} bodies), view={view_mode}, {seconds} s; build {build:.2} s, peak footprint {:.0} MB (now {:.0} MB)", rss1 as f64 / 1e6, now1 as f64 / 1e6);
+    let _ = peak0;
+    let mut rows: Vec<(usize, f64, u64)> = Vec::new();
+    let mut cache = ViewCache::default();
+    let mut view_reads_seen = 0usize;
+    let mut alive = true;
+    let mut ran = 0usize;
+    let mut last_stats = p.u.stats;
+    let mut late_stats: Option<(emergent_universe::universe::Stats, i64)> = None;
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs(55) {
+            println!("truncated");
+            break;
+        }
+        if f == 60 {
+            late_stats = Some((p.u.stats, p.u.now));
+        }
+        rcensus::FRAME.store(f as u32, std::sync::atomic::Ordering::Relaxed);
+        rcensus::PHASE.store(1, std::sync::atomic::Ordering::Relaxed);
+        let start = Instant::now();
+        let frame = p.u.frame_to(1.0 / 60.0, 100.0, Budget { events: u64::MAX, until: Some(start + Duration::from_micros(12_000)) }, i64::MAX);
+        let took = start.elapsed();
+        // the page's own view gather: every frame while it is cheap (small N), every 600 frames above
+        if view_mode == "frame" || (view_mode == "sparse" && f % 600 == 599) {
+            rcensus::PHASE.store(2, std::sync::atomic::Ordering::Relaxed);
+            if let Some(v) = gather_cached(&p.u, &p.names, &mut cache) {
+                view_reads_seen += v.seen.len();
+            }
+        }
+        rcensus::PHASE.store(3, std::sync::atomic::Ordering::Relaxed);
+        if f % 60 == 59 {
+            rcensus::sample();
+        }
+        rows.push((f, took.as_secs_f64() * 1e3, frame.events));
+        last_stats = p.u.stats;
+        ran += 1;
+        if !p.u.rec(p.player).alive {
+            alive = false;
+            break;
+        }
+    }
+    let (now2, rss2) = footprint();
+    let late: Vec<&(usize, f64, u64)> = rows.iter().filter(|r| r.0 >= 60).collect();
+    let mut ms: Vec<f64> = late.iter().map(|r| r.1).collect();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let (s0, t_first) = late_stats.unwrap_or((p.u.stats, p.u.now));
+    let game_s = (p.u.now - t_first) as f64 * TICK_SECONDS;
+    let kicks = last_stats.kicks - s0.kicks;
+    println!(
+        "frames after 1 s: {}  engine ms p50 {:.3} p99 {:.3} max {:.3}; game {game_s:.1} s: kicks {kicks} ({:.3e}/body/game-s); view bodies seen {view_reads_seen}; alive(player) {alive}",
+        late.len(), pct(&ms, 0.5), pct(&ms, 0.99), pct(&ms, 1.0), if game_s > 0.0 { kicks as f64 / bodies as f64 / game_s } else { 0.0 }
+    );
+    println!("memory: peak footprint {:.0} MB at the build's end, {:.0} MB at the flight's end; {:.0} B a body from the build; dashboard bytes/body {}; catalogue {} entries", rss1 as f64 / 1e6, rss2 as f64 / 1e6, rss1.saturating_sub(0) as f64 / n.max(1) as f64, p.u.bytes_per_body(), p.u.catalogue_live());
+    rcensus::report(bodies, p.u.catalogue_live(), p.u.bytes_per_body(), ran as u32);
+    println!("rcensus: n={n} bodies={bodies} build_s={build:.2} foot_build_mb={:.0} foot_end_mb={:.0} b_per_body={:.0} p50_ms={:.3} p99_ms={:.3} kicks_per_body_gs={:.3e} frames={ran}", rss1 as f64 / 1e6, rss2 as f64 / 1e6, rss1 as f64 / n.max(1) as f64, pct(&ms, 0.5), pct(&ms, 0.99), if game_s > 0.0 { kicks as f64 / bodies as f64 / game_s } else { 0.0 });
+}
