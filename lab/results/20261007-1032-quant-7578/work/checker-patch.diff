+fn pct_f(v: &mut Vec<f64>, p: f64) -> f64 {
+    if v.is_empty() {
+        return 0.0;
+    }
+    v.sort_by(|x, y| x.total_cmp(y));
+    v[((v.len() - 1) as f64 * p) as usize]
+}
+
+fn pct_u(v: &mut Vec<u64>, p: f64) -> u64 {
+    if v.is_empty() {
+        return 0;
+    }
+    v.sort();
+    v[((v.len() - 1) as f64 * p) as usize]
+}
