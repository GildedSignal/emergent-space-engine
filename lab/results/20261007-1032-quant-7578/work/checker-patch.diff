+/// The per-body tail of the certificate pipeline at the shipped fixed-degree scaling (rho = 1/n,
+/// sigma_e = 1e-2, a in [1, 1.5]): tier-1 scan width, candidate degree, single-threaded setup time
+/// per body (the cost one kick re-pays), and the numeric window evals per pair. Means hide what
+fn tail(n: usize, seed: u64, sample_n: usize) {
+    let rho = 1.0 / n as f64;
+    tail_run(spec("tail", n, 1e-2, rho, 1.0, 1.5, 0, 0.0, seed), sample_n)
+}
+
+/// The same tail instrument on an adversarial set (co-orbital, narrow, keys) from `verify c`.
+fn tailc(set: &str, seed: u64, sample_n: usize) {
+    let mut sp = verify_set("c").into_iter().find(|s| s.name == set).expect("unknown set");
+    sp.seed = seed;
+    tail_run(sp, sample_n)
+}
