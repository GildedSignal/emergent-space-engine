new file mode 100644
index 00000000..4871bd00
--- /dev/null
+++ b/crates/universe/examples/frame_split.rs
@@ -0,0 +1,138 @@
+//! Where the flight's frame time goes: the sweep's forward flights, per frame, with the engine's
+//! own attribution (Stats: kicks/opens/boundaries, items and cost by kind) against the frame's
+//! wall time. Two budgets: `paced` is the page's 12 ms cap, `demand` is unlimited (the true cost).
+//!
+//! cargo run --release -p emergent-universe --example frame_split --
+//!   [mode paced|demand] [rtf] [wall seconds] [members] [levels...]
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::{fleet::Order, num::to_f64, universe::Stats, view::TICK_SECONDS, Budget, Config};
+use std::time::{Duration, Instant};
+
+fn pct_f(sorted: &[f64], q: f64) -> f64 {
+    if sorted.is_empty() { return 0.0; }
+    let i = ((sorted.len() as f64 - 1.0) * q).round() as usize;
+    sorted[i.min(sorted.len() - 1)]
+}
+
+fn pct_u(sorted: &[u64], q: f64) -> u64 {
+    if sorted.is_empty() { return 0; }
+    let i = ((sorted.len() as f64 - 1.0) * q).round() as usize;
+    sorted[i.min(sorted.len() - 1)]
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let mode = args.get(1).cloned().unwrap_or_else(|| "paced".into());
+    let rtf: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(20.0);
+    let members: u64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(48);
+    let levels: Vec<u8> = args.iter().skip(5).filter_map(|s| s.parse().ok()).collect();
+    let levels: Vec<u8> = if levels.is_empty() { vec![0, 2, 4, 6, 8, 10, 12, 15] } else { levels };
+    let frames = (seconds * 60.0) as usize;
+    println!("mode,rtf,members,level,frames,alive,refusals,vmax,cpu_ms_total,cpu_us_p50,cpu_us_p99,cpu_us_max,ev_total,ev_fr_p50,ev_fr_p99,lag_s_max,overflows,tick_now,ev_fr_max,it3_fr_max,us3_fr_max,kicks,opens,boundaries,handoffs,slices,decisions,encounters,lost,leavers,dissolved,it_planet,us_planet,it_moon,us_moon,it_ship,us_ship,it_player,us_player,it_fleet,us_fleet,fault");
+    let mut flights: Vec<(String, u8)> = vec![("coast".into(), 0)];
+    for &l in &levels {
+        flights.push((format!("forward L{l}"), l));
+    }
+    for (name, level) in flights {
+        let mut cpu: Vec<f64> = Vec::with_capacity(frames);
+        let mut ev_fr: Vec<u64> = Vec::with_capacity(frames);
+        let mut it3_fr: Vec<u64> = Vec::with_capacity(frames);
+        let mut us3_fr: Vec<u64> = Vec::with_capacity(frames);
+        let mut cpu_total = Duration::ZERO;
+        let (mut ev_total, mut over, mut fr) = (0u64, 0u64, 0usize);
+        let hold = name != "coast";
+        let mut p = plane(Config::default(), 1, Order::Sparse, 1, members).unwrap();
+        let s0: Stats = p.u.stats;
+        let (mut next, mut lag, mut vmax) = (0usize, 0f64, 0f64);
+        let script: Vec<(f64, u8, u8)> = if hold { vec![(1.0, 1, level)] } else { vec![] };
+        for f in 0..frames {
+            let wall = f as f64 / 60.0;
+            while next < script.len() && script[next].0 <= wall {
+                let (_, keys, lv) = script[next];
+                let t = p.u.now;
+                let _ = p.u.input(t, word(keys, lv));
+                next += 1;
+            }
+            let start = Instant::now();
+            let budget = if mode == "paced" {
+                Budget { events: u64::MAX, until: Some(start + Duration::from_millis(12)) }
+            } else {
+                Budget::unlimited()
+            };
+            let s_before = p.u.stats;
+            let frame = p.u.frame_to(1.0 / 60.0, rtf, budget, i64::MAX);
+            let dt = start.elapsed();
+            cpu_total += dt;
+            cpu.push(dt.as_secs_f64() * 1e6);
+            ev_fr.push(frame.events);
+            ev_total += frame.events;
+            over += frame.overflow as u64;
+            let it3 = p.u.stats.items[3].saturating_sub(s_before.items[3]);
+            if it3 > 50 {
+                let us3 = p.u.stats.cost_ns[3].saturating_sub(s_before.cost_ns[3]);
+                eprintln!("burst {name} frame {f} wall {wall:.2}s: {it3} player items, {:.1} ms, target-advanced {} ticks", us3 as f64 / 1e6, frame.ticks);
+            }
+            it3_fr.push(p.u.stats.items[3].saturating_sub(s_before.items[3]));
+            us3_fr.push(p.u.stats.cost_ns[3].saturating_sub(s_before.cost_ns[3]));
+            lag = lag.max((frame.target - frame.presented) as f64 * TICK_SECONDS);
+            fr = f + 1;
+            let rec = p.u.rec(p.player);
+            if !rec.alive {
+                break;
+            }
+            if let Ok((_, v)) = rec.b.cartesian(frame.presented.max(rec.b.event_time)) {
+                vmax = vmax.max((to_f64(v[0]).powi(2) + to_f64(v[1]).powi(2)).sqrt());
+            }
+        }
+        let rec = p.u.rec(p.player);
+        let fault = rec.fault.map(|f| format!("{f:?}")).unwrap_or_default();
+        let s1 = p.u.stats;
+        let d = Stats {
+            kicks: s1.kicks - s0.kicks,
+            opens: s1.opens - s0.opens,
+            boundaries: s1.boundaries - s0.boundaries,
+            handoffs: s1.handoffs - s0.handoffs,
+            lost: s1.lost - s0.lost,
+            refused: s1.refused - s0.refused,
+            slices: s1.slices - s0.slices,
+            encounters: s1.encounters - s0.encounters,
+            decisions: s1.decisions - s0.decisions,
+            leavers: s1.leavers - s0.leavers,
+            dissolved: s1.dissolved - s0.dissolved,
+            cost_ns: std::array::from_fn(|i| s1.cost_ns[i] - s0.cost_ns[i]),
+            items: std::array::from_fn(|i| s1.items[i] - s0.items[i]),
+        };
+        let mut cs = cpu.clone();
+        cs.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let mut es = ev_fr.clone();
+        es.sort();
+        let mut fields: Vec<String> = vec![
+            mode.clone(), format!("{rtf}"), format!("{members}"),
+            format!("{}", if hold { level as i32 } else { -1 }),
+            format!("{fr}"), format!("{}", rec.alive), format!("{}", rec.refusals),
+            format!("{vmax:.6}"),
+            format!("{:.1}", cpu_total.as_secs_f64() * 1e3),
+            format!("{:.1}", pct_f(&cs, 0.5)), format!("{:.1}", pct_f(&cs, 0.99)),
+            format!("{:.1}", cs.last().unwrap_or(&0.0)),
+            format!("{ev_total}"),
+            format!("{}", es.get(es.len() / 2).copied().unwrap_or(0)),
+            format!("{}", pct_u(&es, 0.99)),
+            format!("{lag:.3}"), format!("{over}"), format!("{}", p.u.now),
+            format!("{}", es.last().copied().unwrap_or(0)),
+            format!("{}", it3_fr.iter().copied().max().unwrap_or(0)),
+            format!("{:.1}", us3_fr.iter().copied().max().unwrap_or(0) as f64 / 1e3),
+            format!("{}", d.kicks), format!("{}", d.opens), format!("{}", d.boundaries),
+            format!("{}", d.handoffs), format!("{}", d.slices), format!("{}", d.decisions),
+            format!("{}", d.encounters), format!("{}", d.lost), format!("{}", d.leavers),
+            format!("{}", d.dissolved),
+        ];
+        for k in 0..5 {
+            fields.push(format!("{}", d.items[k]));
+            fields.push(format!("{:.1}", d.cost_ns[k] as f64 / 1e3));
+        }
+        fields.push(fault);
+        println!("{}", fields.join(","));
+    }
+}
