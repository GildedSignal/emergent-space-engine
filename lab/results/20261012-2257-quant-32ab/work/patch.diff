new file mode 100644
index 00000000..6b954d10
--- /dev/null
+++ b/crates/universe/examples/player_items.rs
@@ -0,0 +1,63 @@
+//! Per-item cost of the player's own item stream along a forward flight: at each wall second,
+//! resolve up to K consecutive plan items locally (chaining `Update.rec`), timing each, with the
+//! speed the flight has reached. Controls: coast and L8.
+//!
+//! cargo run --release -p emergent-universe --example player_items -- [level] [rtf] [wall s] [members] [K]
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::{fleet::Order, num::to_f64, Budget, Config};
+use std::time::{Duration, Instant};
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let level: u8 = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(15);
+    let rtf: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(20.0);
+    let members: u64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(48);
+    let k: usize = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(40);
+    let frames = (seconds * 60.0) as usize;
+    let mut p = plane(Config::default(), 1, Order::Sparse, 1, members).unwrap();
+    println!("wall_s,vmax,alive,idx,kind,us,plan_len");
+    let mut next = 0usize;
+    let script: Vec<(f64, u8, u8)> = if level == 255 { vec![] } else { vec![(1.0, 1, level)] };
+    for f in 0..frames {
+        let wall = f as f64 / 60.0;
+        while next < script.len() && script[next].0 <= wall {
+            let (_, keys, lv) = script[next];
+            let t = p.u.now;
+            let _ = p.u.input(t, word(keys, lv));
+            next += 1;
+        }
+        // at each whole wall second, probe the player's item stream
+        if f % 60 == 0 && f > 0 {
+            let ctx = p.u.ctx();
+            let mut rec = p.u.rec(p.player);
+            let rec0 = p.u.rec(p.player);
+            let vmax = rec0
+                .b
+                .cartesian(p.u.now.max(rec0.b.event_time))
+                .ok()
+                .map(|(_, v)| (to_f64(v[0]).powi(2) + to_f64(v[1]).powi(2)).sqrt())
+                .unwrap_or(0.0);
+            for i in 0..k {
+                if rec.plan.is_empty() {
+                    break;
+                }
+                let t0 = Instant::now();
+                let upd = emergent_universe::step::process(&ctx, p.player, rec.clone());
+                let us = t0.elapsed().as_secs_f64() * 1e6;
+                println!("{:.2},{vmax:.6},{},{},{:?},{:.1},{}", wall, rec0.alive, i, upd.kind, us, upd.rec.plan.len());
+                std::hint::black_box(&upd);
+                rec = upd.rec;
+            }
+        }
+        let start = Instant::now();
+        let frame = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_millis(12)) }, i64::MAX);
+        let rec = p.u.rec(p.player);
+        if !rec.alive {
+            println!("# died at wall {wall:.2}");
+            break;
+        }
+        let _ = frame.events;
+    }
+}
