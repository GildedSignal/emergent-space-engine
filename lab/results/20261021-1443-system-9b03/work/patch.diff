new file mode 100644
index 00000000..86a876ec
--- /dev/null
+++ b/crates/universe/examples/scannews.rs
@@ -0,0 +1,66 @@
+//! Run 20261021-1443-system-9b03: how much of the player's scan walk is news on the shipped belt plane.
+//!
+//! The plane (`scenario::plane_extra`: a few hundred locals about Home and the Moon, the rest a belt at 2–3 AU), flown
+//! the way `nladder` flies it, with `SCAN_NEWS=1` printing per-scan counters from `encounter.rs` (candidates walked,
+//! bindings changed since the previous scan, the player's own binding, the fallback flag) and a summary line at the end.
+//!
+//! cargo run --release -p emergent-universe --example scannews [-- <N> <coast|burn> [<wall s> [<rtf> [<budget ms>]]]]
+use emergent_universe::encounter::{scan_summary, SCAN_CANDS, SCAN_CHANGED, SCAN_CLEAN, SCAN_FALLBACK, SCAN_ME_CHANGED, SCAN_MEMO, SCAN_TOTAL};
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(30_000);
+    let burn = args.get(2).map(|s| s == "burn").unwrap_or(false);
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(20.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms: f64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(12.0);
+    let frames = (seconds * 60.0) as usize;
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let bodies = p.u.n_bodies();
+    let mut kicks0 = p.u.stats.kicks;
+    let t0 = Instant::now();
+    for f in 0..frames {
+        if f == 60 && burn {
+            let t = p.u.now;
+            let _ = p.u.input(t, word(1, 8));
+        }
+        let start = Instant::now();
+        let _ = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)) }, i64::MAX);
+        if t0.elapsed() > Duration::from_secs(50) {
+            break;
+        }
+    }
+    let (_, _) = (kicks0, p.u.stats.kicks);
+    kicks0 = p.u.stats.kicks;
+    p.u.flush_scans();
+    let held = p.u.held_scans();
+    let digest = p.u.digest();
+    let game_s = p.u.now as f64 * emergent_universe::view::TICK_SECONDS;
+    println!(
+        "scannews N={n} ({bodies} bodies) burn={burn} rtf={rtf} wall={seconds}s build={build:.1}s game_s={game_s:.0} kicks={kicks0} held_left={held} digest={digest:?}"
+    );
+    let s = SCAN_TOTAL.load(std::sync::atomic::Ordering::Relaxed);
+    let c = SCAN_CANDS.load(std::sync::atomic::Ordering::Relaxed);
+    let ch = SCAN_CHANGED.load(std::sync::atomic::Ordering::Relaxed);
+    if s > 0 {
+        println!(
+            "scannews scans={s} cands/scan={:.1} changed/scan={:.1} news_frac={:.5} me_changed={} ({:.3}/scan) clean={} fallback={} memo_hits={}",
+            c as f64 / s as f64,
+            ch as f64 / s as f64,
+            ch as f64 / c.max(1) as f64,
+            SCAN_ME_CHANGED.load(std::sync::atomic::Ordering::Relaxed),
+            SCAN_ME_CHANGED.load(std::sync::atomic::Ordering::Relaxed) as f64 / s as f64,
+            SCAN_CLEAN.load(std::sync::atomic::Ordering::Relaxed),
+            SCAN_FALLBACK.load(std::sync::atomic::Ordering::Relaxed),
+            SCAN_MEMO.load(std::sync::atomic::Ordering::Relaxed)
+        );
+    }
+    scan_summary();
+}
diff --git a/crates/universe/src/encounter.rs b/crates/universe/src/encounter.rs
index e8e74e0c..034f1217 100644
--- a/crates/universe/src/encounter.rs
+++ b/crates/universe/src/encounter.rs
@@ -17,6 +17,38 @@ use std::sync::{Arc, Mutex, OnceLock};
 
 pub const ENCOUNTER_LOG2: i32 = 10;
 
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// Run 20261021-1443-system-9b03: how much of each scan's walk is news (a binding that changed since the previous scan).
+pub static SCAN_TOTAL: AtomicU64 = AtomicU64::new(0);
+pub static SCAN_CANDS: AtomicU64 = AtomicU64::new(0);
+pub static SCAN_CHANGED: AtomicU64 = AtomicU64::new(0);
+pub static SCAN_ME_CHANGED: AtomicU64 = AtomicU64::new(0);
+pub static SCAN_CLEAN: AtomicU64 = AtomicU64::new(0);
+pub static SCAN_FALLBACK: AtomicU64 = AtomicU64::new(0);
+pub static SCAN_MEMO: AtomicU64 = AtomicU64::new(0);
+
+pub fn scan_summary() {
+    let (s, c, ch, me, cl, fb, memo) = (
+        SCAN_TOTAL.load(Ordering::Relaxed),
+        SCAN_CANDS.load(Ordering::Relaxed),
+        SCAN_CHANGED.load(Ordering::Relaxed),
+        SCAN_ME_CHANGED.load(Ordering::Relaxed),
+        SCAN_CLEAN.load(Ordering::Relaxed),
+        SCAN_FALLBACK.load(Ordering::Relaxed),
+        SCAN_MEMO.load(Ordering::Relaxed),
+    );
+    if s > 0 {
+        eprintln!(
+            "SCANNEWS scans={s} cands/scan={:.1} changed/scan={:.2} news_frac={:.5} me_changed={me} clean={cl} fallback={fb} memo_hits={memo}",
+            c as f64 / s as f64,
+            ch as f64 / s as f64,
+            ch as f64 / c.max(1) as f64
+        );
+    }
+}
+
 #[derive(Clone, Copy, Debug, PartialEq, Eq)]
 pub struct Encounter {
     pub a: usize,
@@ -171,6 +203,7 @@ impl Encounters for PlayerNeighbourhood {
             let w = Window { r: norm(x), v: norm(v), reach_p: to_f64(ctx.info[body].radius), near_log2: ENCOUNTER_LOG2, h: to_f64(h) };
             ctx.radial.candidates(me.doll, &w)
         })();
+        let fb = near.is_none();
         let mut candidates = Vec::new();
         for j in near.map_or_else(|| Box::new(0..ctx.bodies.len()) as Box<dyn Iterator<Item = usize>>, |ids| Box::new(ids.into_iter())) {
             // A member handed out of a frame is there for the ticks after its hand-out.
@@ -188,8 +221,34 @@ impl Encounters for PlayerNeighbourhood {
             candidates.push((j, other, reach));
         }
         let mut last = self.last.lock().expect("the finder's last scan");
+        // 20261021-1443-system-9b03: count the walk's news against the previous scan (pure reads).
+        let prev = last.as_ref().map(|l| l.clone());
+        let mut changed = 0u64;
+        let mut me_ch = false;
+        if let Some(p) = prev.as_ref() {
+            me_ch = !same(&p.me, &me);
+            let old: std::collections::HashMap<usize, &Binding> =
+                p.candidates.iter().map(|(j, b, _)| (*j, b)).collect();
+            for (j, other, _) in &candidates {
+                if !old.get(j).is_some_and(|b| same(b, other)) {
+                    changed += 1;
+                }
+            }
+        }
+        SCAN_TOTAL.fetch_add(1, Ordering::Relaxed);
+        SCAN_CANDS.fetch_add(candidates.len() as u64, Ordering::Relaxed);
+        SCAN_CHANGED.fetch_add(changed, Ordering::Relaxed);
+        SCAN_FALLBACK.fetch_add(u64::from(fb), Ordering::Relaxed);
+        SCAN_ME_CHANGED.fetch_add(u64::from(me_ch), Ordering::Relaxed);
+        if prev.is_some() && changed == 0 && !me_ch {
+            SCAN_CLEAN.fetch_add(1, Ordering::Relaxed);
+        }
+        if std::env::var("SCAN_NEWS").is_ok() {
+            eprintln!("SCANNEWS t={t} n={} ch={changed} me={me_ch} fb={fb}", candidates.len());
+        }
         let reusable = |l: &&Arc<Scan>| if self.sloppy { l.body == body } else { l.same_inputs(body, t, interval, &me, &candidates) };
         if let Some(l) = last.as_ref().filter(reusable) {
+            SCAN_MEMO.fetch_add(1, Ordering::Relaxed);
             return Some(l.clone() as Arc<dyn Held>);
         }
         let scan = Arc::new(Scan { body, t, interval, me, candidates, found: OnceLock::new() });
