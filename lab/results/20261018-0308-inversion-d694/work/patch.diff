+/// Linux port of the same instrument (RSS now, high-water mark peak): the lab machines are Linux, where
+/// `proc_pid_rusage` does not link. Order of magnitude only, as the macOS one.
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let (mut now, mut peak) = (0u64, 0u64);
+    if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+        let kb = |l: &str| l.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()).map(|v| v * 1024).unwrap_or(0);
+        for line in s.lines() {
+            if line.starts_with("VmRSS:") {
+                now = kb(line);
+            } else if line.starts_with("VmHWM:") {
+                peak = kb(line);
+            }
+        }
+    }
+    (now, peak)
+}
