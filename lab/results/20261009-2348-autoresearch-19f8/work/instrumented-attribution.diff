+/// Inverse-path event counters: [0] poly evals, [1] bisection iterations,
+/// [2] evals skipped by the witness, [3] witness attempts, [4] Newton iterations,
+/// [5] bracket doublings; ops from 8: [8] Scalar::mul, [9] Scalar::div,
+/// [10] Scalar::add, [11] Scalar::sqrt, [12] isqrt, [13] div_word.
+#[inline]
+pub(crate) fn count(i: usize) {
+    COUNTS.with(|c| {
+        let mut v = c.get();
+        v[i] += 1;
+        c.set(v);
+    })
+}
+/// Phase timer for stages beyond the old cycle path's 0..=3 (indices 4..=7).
+pub(crate) fn phase<T>(i: usize, f: impl FnOnce() -> T) -> T {
+    stage(i, f)
+}
+/// Nanoseconds per stage on this thread; resets the counters.
+pub fn take() -> [u128; 8] {
+    NS.with(|s| s.replace([0; 8]))
+}
+/// Resets and returns the event counters.
+pub fn take_counts() -> [u64; 16] {
+    COUNTS.with(|c| c.replace([0; 16]))
 }
