+        CROSS_TRIED.store(0, Ordering::Relaxed);
+        CROSS_USED.store(0, Ordering::Relaxed);
+        for b in D_BUCKETS.iter() {
+            b.store(0, Ordering::Relaxed);
+        }
+    }
