+/// Where does a kick's re-certification go? Setup vs query, per section kind, with the profiling
+/// counters from pairs::prof (numeric windows, never-windows, d_of_s calls, cross windows).
+fn prof_exp(nsamp: usize) {
+    let sp = spec("kick", 10_000, 1e-2, 1e-4, 1.0, 1.5, 0, 0.0, 20261050);
+    let b = make_belt(&sp);
+    let sorted = Sorted::new(&b, sp.rho);
+    let horizon = 1000.0 * TAU;
+    let t0 = 10.0 * TAU;
+    let sample: Vec<usize> = (0..nsamp).map(|q| (q * 97 + 13) % sp.n).collect();
+    emergent_encounters::pairs::prof::reset();
+    let mut st = Stats::default();
+    let mut dmins: Vec<f64> = Vec::new();
+    let tstart = Instant::now();
+    let mut setup_secs = 0.0;
+    for &i in &sample {
+        let bi = &b[i];
+        let (lo, hi) = sorted.range(bi.binet()[0], sorted.reach(bi));
+        for &(_, j) in &sorted.order[lo..hi] {
+            let bj = &b[j as usize];
+            if j as usize == i || !is_candidate(bi, bj, sp.rho) {
+                continue;
+            }
+            st.pairs += 1;
+            let ts = Instant::now();
+            let secs = sections(bi, bj, sp.rho, SAFETY, &mut st.evals);
+            setup_secs += ts.elapsed().as_secs_f64();
+            for k in 0..3 {
+                st.sections[k] += secs.iter().filter(|s| s.kind as usize == k).count() as u64;
+            }
+            for sec in &secs {
+                let mut v = Vec::new();
+                run_section(bi, bj, sec, sp.rho, t0, t0 + horizon, &mut st, &mut v);
+            }
+        }
+    }
+    let all_secs = tstart.elapsed().as_secs_f64();
+    let p = emergent_encounters::pairs::prof::vals();
+    let dmin = dmins.pop();
+    println!(
+        "{{\"exp\":\"prof\",\"n\":{},\"rho\":{},\"sample\":{},\"pairs\":{},\"sections\":[{},{},{}],\"evals_setup_per_pair\":{:.1},\"checks_per_pair\":{:.3},\"queries_per_pair\":{:.3},\"qsteps_per_pair\":{:.1},\"setup_frac\":{:.3},\"num_win\":{},\"num_none\":{},\"dof_s_per_numwin\":{:.1},\"cross_tried\":{},\"cross_used\":{},\"us_per_pair\":{:.2}}}",
+        sp.n, sp.rho, nsamp, st.pairs, st.sections[0], st.sections[1], st.sections[2],
+        st.evals as f64 / st.pairs as f64, st.checks_total() as f64 / st.pairs as f64,
+        st.queries as f64 / st.pairs as f64, st.qsteps as f64 / st.pairs as f64,
+        setup_secs / all_secs, p[0], p[1], p[2] as f64 / p[0].max(1) as f64, p[3], p[4],
+        all_secs * 1e6 / st.pairs as f64
+    );
+    println!(
+        "{{\"exp\":\"prof-d\",\"d_over_rho\":[{},{},{},{},{}]}}",
+        p[5], p[6], p[7], p[8], p[9]
+    );
+    let _ = dmin;
+}
