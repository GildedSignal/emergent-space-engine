+    pub static D_BUCKETS: [AtomicU64; 5] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+    pub fn dbucket(d: f64, rho: f64) {
+        let r = d / rho;
