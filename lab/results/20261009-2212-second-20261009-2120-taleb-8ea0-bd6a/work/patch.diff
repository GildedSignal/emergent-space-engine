+/// The depth-matched scripts' decisions at canonical ticks, a function of *game* time: the same burns at any rtf
+/// (the jink pattern, a function of nominal frames, stretches ∝rtf in game time). `hold`: forward, reverse, left,
+/// right — one word per 4-game-second slot, each burn 1/3 game-second — so each pair cancels in rapidity
+/// (Δη = α·Δτ along an unturned heading) and the cycle nets zero: station-keeping by symmetry, keeping the living
+/// frame (thrust, kicks, gather) measurable at player-scale horizons. `coast`: no decisions, the pure-orbit control.
+fn game_log(game_seconds: f64, script: Script, level: u8) -> Vec<(i64, u8)> {
+    if script == Script::Coast {
+        return Vec::new();
+    }
+    let period = (4.0 / emergent_universe::view::TICK_SECONDS).round() as i64;
+    let burn = ((20.0 / 60.0) / emergent_universe::view::TICK_SECONDS).round() as i64;
+    let words = [1u8, 2, 4, 8];
+    let slots = (game_seconds / 4.0).ceil() as usize;
+    let mut log = Vec::with_capacity(2 * slots);
+    for i in 0..slots {
+        let t = i as i64 * period;
+        log.push((t, emergent_universe::thrust::word(words[i % 4], level)));
+        log.push((t + burn, 0));
+    }
+    log
+}
 
