+//! Checker adversarial probes for run 20261011-0324-inversion-0981 (not the author's code).
+//! A1: seed robustness of the S1 law. A2: onset of the coordinate artifact vs e.
+//! A3: the author's claimed safe case (ϖ-aligned eccentric).
+
+use emergent_encounters::belt::Rng;
+use emergent_encounters::kepler::Body;
+use emergent_encounters::truth::{truth_pair, TruthStats};
+use emergent_encounters::par_chunks;
+use std::f64::consts::{PI, TAU};
+
+struct Spec {
+    name: &'static str,
+    n: usize,
+    rho: f64,
+    orbits: f64,
+    da: f64,
+    e_fixed: Option<f64>,
+    e_sigma: f64,
+    pom_half: Option<f64>,
+    lam: Option<(f64, f64)>,
+    phi: bool,
+    seed: u64,
+}
+
+fn gen(s: &Spec) -> Vec<Body> {
+    let mut rng = Rng(s.seed);
+    (0..s.n)
+        .map(|_| {
+            let a = 1.0 + s.da * (2.0 * rng.f64() - 1.0);
+            let e = match s.e_fixed {
+                Some(f) => f,
+                None => (s.e_sigma * (-2.0 * (1.0 - rng.f64()).ln()).sqrt()).min(0.9),
+            };
+            let pom = match s.pom_half {
+                Some(h) => h * (2.0 * rng.f64() - 1.0),
+                None => TAU * rng.f64(),
+            };
+            let lam = match s.lam {
+                Some((c, hw)) => c + hw * (2.0 * rng.f64() - 1.0),
+                None => TAU * rng.f64(),
+            };
+            Body::new(a, e, pom, lam)
+        })
+        .collect()
+}
+
+#[inline]
+fn wrap(x: f64) -> f64 {
+    (x + PI).rem_euclid(TAU) - PI
+}
+
+#[inline]
+fn mean_long(b: &Body, t: f64) -> f64 {
+    b.pom + b.mean_anomaly(t)
+}
+
+#[inline]
+fn true_long(b: &Body, t: f64) -> f64 {
+    let s = b.state(t);
+    s[1].atan2(s[0])
+}
+
+fn main() {
+    let scenes = vec![
+        // A1: author's s1_1000 geometry, held-out seed
+        Spec { name: "a1_s1_1000_seed42", n: 1000, rho: 2e-3, orbits: 10.0, da: 1e-3, e_fixed: None, e_sigma: 5e-4, pom_half: None, lam: Some((1.0, 0.05)), phi: false, seed: 424242 },
+        // A1b: same but wider lambda window (w=0.4): law says pop ~ 2*rho*n/w
+        Spec { name: "a1b_w04_n2000", n: 2000, rho: 2e-3, orbits: 5.0, da: 1e-3, e_fixed: None, e_sigma: 5e-4, pom_half: None, lam: Some((1.0, 0.2)), phi: false, seed: 515151 },
+        // A2: e-onset on the formation geometry (author only tested 5e-4 and 0.7)
+        Spec { name: "a2_form_e01", n: 200, rho: 2e-3, orbits: 20.0, da: 1e-3, e_fixed: Some(0.1), e_sigma: 0.0, pom_half: Some(0.15), lam: Some((PI, 0.05)), phi: true, seed: 616161 },
+        Spec { name: "a2_form_e03", n: 200, rho: 2e-3, orbits: 20.0, da: 1e-3, e_fixed: Some(0.3), e_sigma: 0.0, pom_half: Some(0.15), lam: Some((PI, 0.05)), phi: true, seed: 626262 },
+        // A3: author's claimed safe case: eccentric but pom-aligned
+        Spec { name: "a3_pomalign_e07", n: 200, rho: 2e-3, orbits: 20.0, da: 1e-3, e_fixed: Some(0.7), e_sigma: 0.0, pom_half: Some(0.02), lam: None, phi: true, seed: 636363 },
+    ];
+    let threads = 4;
+    println!("{{\"adv\": \"20261011-0324-inversion-0981-checker\", \"scenes\": [");
+    for (k, spec) in scenes.iter().enumerate() {
+        let bodies = gen(spec);
+        let t_end = spec.orbits * TAU;
+        let n = bodies.len();
+        let mut pairs: Vec<(u32, u32)> = Vec::new();
+        for i in 0..n {
+            for j in (i + 1)..n {
+                let (bi, bj) = (&bodies[i], &bodies[j]);
+                if bi.rmax() + spec.rho < bj.rmin() || bj.rmax() + spec.rho < bi.rmin() {
+                    continue;
+                }
+                pairs.push((i as u32, j as u32));
+            }
+        }
+        let parts = par_chunks(pairs.len(), 4096, threads, |range| {
+            let mut encs: Vec<(u32, u32, f64, f64)> = Vec::new();
+            let mut st = TruthStats::default();
+            let mut buf: Vec<(f64, f64)> = Vec::new();
+            for &p in &pairs[range] {
+                buf.clear();
+                truth_pair(&bodies[p.0 as usize], &bodies[p.1 as usize], spec.rho, t_end, &mut buf, &mut st);
+                for &(t, d) in &buf {
+                    encs.push((p.0, p.1, t, d));
+                }
+            }
+            (encs, st)
+        });
+        let mut encs = Vec::new();
+        for (e, _) in parts {
+            encs.extend(e);
+        }
+        let stride = encs.len().div_ceil(8000).max(1);
+        let mut rank_l = Vec::new();
+        let mut pop_w = Vec::new();
+        let mut rank_p = Vec::new();
+        let mut pop_pw = Vec::new();
+        let mut fracw = 0usize;
+        let mut m = 0usize;
+        for e in encs.iter().step_by(stride) {
+            let (bi, bj) = (&bodies[e.0 as usize], &bodies[e.1 as usize]);
+            let t = e.2;
+            let li = mean_long(bi, t);
+            let sep_l = wrap(mean_long(bj, t) - li).abs();
+            let mut rl = 1.0f64;
+            let mut pw = 0.0f64;
+            for b in &bodies {
+                let dl = wrap(mean_long(b, t) - li).abs();
+                if dl > 0.0 && dl < sep_l {
+                    rl += 1.0;
+                }
+                if dl > 0.0 && dl <= spec.rho {
+                    pw += 1.0;
+                }
+            }
+            let dn = (bi.n - bj.n).abs();
+            let inw = sep_l <= spec.rho;
+            if !inw {
+                fracw += 1;
+            }
+            let _ = dn;
+            rank_l.push(rl);
+            pop_w.push(pw);
+            if spec.phi {
+                let pi_ = true_long(bi, t);
+                let sep_p = wrap(true_long(bj, t) - pi_).abs();
+                let mut rp = 1.0f64;
+                let mut ppw = 0.0f64;
+                for b in &bodies {
+                    let d = wrap(true_long(b, t) - pi_).abs();
+                    if d > 1e-12 && d < sep_p {
+                        rp += 1.0;
+                    }
+                    if d <= spec.rho {
+                        ppw += 1.0;
+                    }
+                }
+                rank_p.push(rp);
+                pop_pw.push(ppw);
+            }
+            m += 1;
+        }
+        rank_l.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        pop_w.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let pct = |v: &[f64], q: f64| v[((q * (v.len() as f64 - 1.0)).round() as usize).min(v.len() - 1)];
+        let mut extra = String::new();
+        if spec.phi {
+            rank_p.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            pop_pw.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            extra = format!(
+                ", \"rank_phi_p50\": {:.1}, \"rank_phi_p99\": {:.1}, \"rank_phi_max\": {:.1}, \"frac_phi_gt4\": {:.4}, \"pop_phi_w_p50\": {:.1}",
+                pct(&rank_p, 0.5), pct(&rank_p, 0.99), rank_p.last().copied().unwrap_or(f64::NAN),
+                rank_p.iter().filter(|x| **x > 4.0).count() as f64 / m.max(1) as f64,
+                pct(&pop_pw, 0.5)
+            );
+        }
+        println!(
+            "  {{\"name\": \"{}\", \"n\": {}, \"encounters\": {}, \"sampled\": {}, \"rank_l_p50\": {:.1}, \"rank_l_p99\": {:.1}, \"rank_l_max\": {:.1}, \"frac_gt4\": {:.4}, \"pop_w_p50\": {:.1}, \"perm_miss_window\": {:.4}{}}}",
+            spec.name, spec.n, encs.len(), m,
+            pct(&rank_l, 0.5), pct(&rank_l, 0.99), rank_l.last().copied().unwrap_or(f64::NAN),
+            rank_l.iter().filter(|x| **x > 4.0).count() as f64 / m.max(1) as f64,
+            pct(&pop_w, 0.5),
+            fracw as f64 / m.max(1) as f64,
+            extra
+        );
+        if k + 1 < scenes.len() {
+            println!(",");
+        }
+    }
+    println!("\n]}}");
+}
