+/// A memo of [`Ctx::state_of`]: every body with an item at tick `t` in a doll reads the same
+/// sources' states at `t`, and a source's state at `t` is final before the first reader (any item
+/// of the source at or below `t` is pulled first), so the memo returns exactly what recomputing
+/// would. It changes the work, never the bits. Shard-locked so the wave's threads do not queue.
+pub struct StateCache {
+    shards: Vec<Mutex<HashMap<(usize, Tick), (V2, V2)>>>,
+    pub calls: AtomicU64,
+    pub hits: AtomicU64,
+}
+
+impl Default for StateCache {
+    fn default() -> Self {
+        Self { shards: (0..16).map(|_| Mutex::new(HashMap::new())).collect(), calls: AtomicU64::new(0), hits: AtomicU64::new(0) }
+    }
+}
+
+impl StateCache {
+    const SHARDS: usize = 16;
+    /// Off switch for A/B measurement (`ESPACEX_NOCACHE`): the memo must be deletable to nothing.
+    pub fn disabled() -> bool {
+        static OFF: LazyLock<bool> = LazyLock::new(|| std::env::var("ESPACEX_NOCACHE").is_ok());
+        *OFF
+    }
+    fn shard(&self, j: usize, t: Tick) -> usize {
+        (j.wrapping_mul(0x9E3779B9).wrapping_add(t as usize)) & (Self::SHARDS - 1)
+    }
+    fn lock_of(&self, j: usize, t: Tick) -> std::sync::MutexGuard<'_, HashMap<(usize, Tick), (V2, V2)>> {
+        // Poisoning needs a panic while held; recover the map regardless, it is only a memo.
+        self.shards[self.shard(j, t)].lock().unwrap_or_else(|p| p.into_inner())
+    }
+}
 
