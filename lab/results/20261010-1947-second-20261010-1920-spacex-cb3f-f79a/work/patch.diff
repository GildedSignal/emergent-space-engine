+// The per-event idiot index and the scan's two deletions: (a) the foreign-doll slope (a binding
+// clone per body in the universe, per player item) deleted by a clone-free doll test, (b) the
+// same-doll exact tier (a tube decode per pair) deleted by a provably-safe radial-annulus
+// pre-filter. Run twice, once with ESPACEX_PREFILTER / ESPACEX_FASTDOLL unset: the digest and
+// the event counters must match bit for bit, only the time may move.
+//
+//   cargo run --release -p emergent-universe --example spacex_probe -- [cohort] [seed] [ticks] [threads] [place]
+//
+// place: 0 star-doll belt (original), 1 home doll separated annulus, 2 home doll co-radial with
+// the player (the adversarial dense case), 3 home doll wide annuli (e up to 0.3).
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_cohort_at;
+use emergent_universe::Config;
+use std::time::Instant;
+
+fn main() {
+    let mut a = std::env::args().skip(1);
+    let cohort: usize = a.next().and_then(|x| x.parse().ok()).unwrap_or(200);
+    let seed: u64 = a.next().and_then(|x| x.parse().ok()).unwrap_or(1);
+    let ticks: i64 = a.next().and_then(|x| x.parse().ok()).unwrap_or(1_500_000_000);
+    let threads: usize = a.next().and_then(|x| x.parse().ok()).unwrap_or(1);
+    let place: u8 = a.next().and_then(|x| x.parse().ok()).unwrap_or(0);
+    let t0 = Instant::now();
+    let world = emergent_engine::scenes::battle(8, emergent_universe::fleet::Q, seed, 1 << 15, false).0;
+    let mut p = plane_cohort_at(Config::default(), seed, Order::Sparse, threads, world, cohort, place).expect("the plane builds");
+    let build = t0.elapsed();
+    let t0 = Instant::now();
+    p.u.settle(ticks);
+    let run = t0.elapsed();
+    let s = p.u.stats;
+    let ev = s.kicks + s.opens + s.boundaries;
+    let (calls, hits) = (
+        p.u.state_cache.calls.load(std::sync::atomic::Ordering::Relaxed),
+        p.u.state_cache.hits.load(std::sync::atomic::Ordering::Relaxed),
+    );
+    println!("cohort {cohort} seed {seed} threads {threads} ticks {ticks} place {place}");
+    println!("build {:.2}s settle {:.2}s", build.as_secs_f64(), run.as_secs_f64());
+    for (k, name) in ["planet", "moon", "ship", "player", "fleet"].iter().enumerate() {
+        println!("  {name}: {} items, {:.1} us/item", s.items[k], s.cost_ns[k] as f64 / 1e3 / s.items[k].max(1) as f64);
+    }
+    let scan = emergent_universe::universe::SCAN_NS.load(std::sync::atomic::Ordering::Relaxed);
+    println!("player scan: {:.2}s ({:.0}% of settle, {:.1} us per player item)", scan as f64 / 1e9, scan * 100 / (run.as_secs_f64() * 1e9) as u64, scan as f64 / 1e3 / s.items[3].max(1) as f64);
+    println!("per event: {:.2} us", run.as_secs_f64() * 1e6 / ev.max(1) as f64);
+    println!("state_of: {calls} calls, {hits} memo hits ({:.1}%), distinct decodes {}", hits * 100 / calls.max(1), calls - hits);
+    let (same, rej) = (
+        emergent_universe::encounter::PAIRS_SAME.load(std::sync::atomic::Ordering::Relaxed),
+        emergent_universe::encounter::PAIRS_REJECTED.load(std::sync::atomic::Ordering::Relaxed),
+    );
+    println!("prefilter: {same} same-doll pairs, {rej} rejected ({:.1}%), {:.2} us per pair item", rej * 100 / same.max(1), scan as f64 / 1e3 / same.max(1) as f64);
+    println!("digest {}", p.u.digest());
+    println!("encounters {} contacts {}", p.u.enc_log.len(), p.u.contacts);
+}
