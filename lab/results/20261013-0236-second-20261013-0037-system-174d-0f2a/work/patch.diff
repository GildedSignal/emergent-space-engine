+//! The burn-input waterfall, decomposed (lab run 20261013-0037-system-174d; second author
+//! 20261013-0236-...-0f2a adds the law's own tide cadence). The sweep's L8+ stutter was attributed
+//! to "a replan waterfall of up to 1,036 player items in the burn frame"; this example answers
+//! *what those items are*, *what each one buys*, and — new — *what the tide alone would cost at
+//! the law's own cadence* (`kick_clock`'s step before the thrust clamp), which is the number the
+//! carry-the-burn lever is priced against.
+//!
+//! cargo run --release -p emergent-universe --example waterfall [-- <rtf> <wall seconds> [demand] [seed]]
+use emergent_universe::scenario::plane;
+use emergent_universe::step::waterfall;
+use emergent_universe::thrust::word;
+use emergent_universe::{fleet::Order, Budget, Config};
+use std::sync::atomic::Ordering;
+use std::time::{Duration, Instant};
+
+fn flights() -> Vec<(String, Vec<(f64, u8, u8)>)> {
+    vec![
+        ("coast (control)".into(), vec![]),
+        ("forward L8".into(), vec![(1.0, 1, 8)]),
+        ("forward L12".into(), vec![(1.0, 1, 12)]),
+        ("forward L15".into(), vec![(1.0, 1, 15)]),
+        ("reverse L8 (brake)".into(), vec![(1.0, 2, 8)]),
+        ("turn left then burn L8".into(), vec![(1.0, 4, 8), (2.0, 0, 8), (2.5, 1, 8)]),
+    ]
+}
+
+fn bucket(q: i64) -> usize {
+    match q {
+        0 => 0,
+        1 => 1,
+        2..=3 => 2,
+        4..=7 => 3,
+        8..=15 => 4,
+        16..=63 => 5,
+        _ => 6,
+    }
+}
+
+fn main() {
+    std::env::set_var("ES_WATERFALL", "1");
+    let args: Vec<String> = std::env::args().collect();
+    let rtf: f64 = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let seconds: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(4.0);
+    let demand = args.get(3).map(|s| s == "demand").unwrap_or(false);
+    let seed: u64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let frames = (seconds * 60.0) as usize;
+    println!(
+        "rtf {rtf}, {seconds} s per flight ({frames} frames at 60 Hz), budget {}, seed {seed}",
+        if demand { "unlimited (demand)" } else { "12 ms" }
+    );
+
+    for (name, script) in flights() {
+        let mut p = plane(Config::default(), seed, Order::Sparse, 1, 48).unwrap();
+        let items0 = p.u.stats.items[3];
+        let wf0: Vec<u64> = waterfall::PLAYER_ITEMS.iter().map(|c| c.load(Ordering::Relaxed)).collect();
+        let (mut next, mut worst_items, mut worst_frame, mut max_lag, mut alive_for) = (0usize, 0u64, 0usize, 0f64, frames);
+        let mut cumulative: Vec<u64> = Vec::with_capacity(frames);
+        for f in 0..frames {
+            let wall = f as f64 / 60.0;
+            while next < script.len() && script[next].0 <= wall {
+                let (_, keys, level) = script[next];
+                let _ = p.u.input(p.u.now, word(keys, level));
+                next += 1;
+            }
+            let start = Instant::now();
+            let frame = p.u.frame_to(
+                1.0 / 60.0,
+                rtf,
+                Budget { events: u64::MAX, until: if demand { None } else { Some(start + Duration::from_millis(12)) } },
+                i64::MAX,
+            );
+            let items = p.u.stats.items[3] - items0;
+            let prev = cumulative.last().copied().unwrap_or(0);
+            if items - prev > worst_items {
+                worst_items = items - prev;
+                worst_frame = f;
+            }
+            cumulative.push(items);
+            max_lag = max_lag.max((frame.target - frame.presented) as f64 * emergent_universe::view::TICK_SECONDS);
+            if !p.u.rec(p.player).alive {
+                alive_for = f + 1;
+                break;
+            }
+        }
+        let rec = p.u.rec(p.player);
+        let items = *cumulative.last().unwrap_or(&0);
+        let wf: Vec<u64> = waterfall::PLAYER_ITEMS.iter().map(|c| c.load(Ordering::Relaxed)).zip(wf0).map(|(a, b)| a - b).collect();
+        let kicks = waterfall::take_kicks();
+        let thrust: Vec<_> = kicks.iter().filter(|k| k.burn_q > 0).collect();
+        let coast: Vec<_> = kicks.iter().filter(|k| k.burn_q == 0).collect();
+        let tide_zero = thrust.iter().filter(|k| k.tide_q == 0).count();
+        let mut tide_h = [0usize; 7];
+        let mut burn_h = [0usize; 7];
+        for k in &thrust {
+            tide_h[bucket(k.tide_q)] += 1;
+            burn_h[bucket(k.burn_q)] += 1;
+        }
+        let mut tide_coast_h = [0usize; 7];
+        let mut tide_coast_fire = 0usize;
+        for k in &coast {
+            tide_coast_h[bucket(k.tide_q)] += 1;
+            tide_coast_fire += (k.tide_q > 0) as usize;
+        }
+        let steps_sum: i64 = thrust.iter().map(|k| k.step).sum();
+        let tide_sum: i128 = thrust.iter().map(|k| k.tide_q as i128).sum();
+        let coast_median = {
+            let mut qs: Vec<i64> = coast.iter().map(|k| k.tide_q).collect();
+            qs.sort_unstable();
+            qs.get(qs.len() / 2).copied().unwrap_or(0)
+        };
+        let tide_only_events = if coast_median > 0 { (tide_sum / coast_median as i128).max(0) } else { -1 };
+
+        // --- New (second author): the law's own tide cadence. ---
+        // The clock's unclamped step `clock_full` is what the step would be without the burn; the
+        // tide carried alone would mint one event per `clock_full` ticks along the same path.
+        // Law-bound kicks (clock_full <= step) are already the law's own events; burn-bound ones
+        // are the burn's fine sampling of a coarser law cadence.
+        let clock = |k: &emergent_universe::step::waterfall::ThrustKick| if k.clock_full > 0 { k.clock_full } else { k.step };
+        let first_thrust = kicks.iter().position(|k| k.burn_q > 0);
+        let mut n_law = 0f64;
+        let mut law_bound = 0usize;
+        let mut burn_bound = 0usize;
+        if let Some(i0) = first_thrust {
+            for i in i0..kicks.len() {
+                let k = &kicks[i];
+                let dt = match kicks.get(i + 1) {
+                    Some(next) => (next.tick - k.tick) as f64,
+                    None => k.step as f64,
+                };
+                n_law += dt / clock(k) as f64;
+                if clock(k) <= k.step { law_bound += 1 } else { burn_bound += 1 }
+            }
+        }
+        // The law's per-event tide budget, regime-scaled and integrated: walk the flight's kicks
+        // grouping them into law-cadence windows (a window closes when its elapsed ticks reach the
+        // clock of the kick that opened it); the budget of a window is the tide its kicks actually
+        // accumulate. At the coast this reproduces the coast budget by construction; near the plunge
+        // it is the number the fixed-granularity counterfactual ignored.
+        let mut budgets: Vec<i128> = Vec::new();
+        if let Some(i0) = first_thrust {
+            let mut acc: i128 = 0;
+            let mut elapsed = 0f64;
+            let mut window = clock(&kicks[i0]) as f64;
+            for i in i0..kicks.len() {
+                let k = &kicks[i];
+                let dt = match kicks.get(i + 1) {
+                    Some(next) => (next.tick - k.tick) as f64,
+                    None => k.step as f64,
+                };
+                acc += k.tide_q as i128;
+                elapsed += dt;
+                if elapsed >= window {
+                    budgets.push(acc);
+                    acc = 0;
+                    elapsed = 0.0;
+                    window = clock(k) as f64;
+                }
+            }
+            if acc > 0 {
+                budgets.push(acc);
+            }
+        }
+        budgets.sort();
+        let law_budget_max = *budgets.last().unwrap_or(&0) as f64;
+        let law_budget_med = budgets.get(budgets.len() / 2).copied().unwrap_or(0) as f64;
+        let r_min = kicks.iter().skip(first_thrust.unwrap_or(0)).map(|k| k.r_e6).min().unwrap_or(0);
+
+        let mut ratio_h = [0usize; 5];
+        for k in &thrust {
+            let r = (k.tide_q as f64 + 1.0) / (k.burn_q as f64 + 1.0);
+            ratio_h[match r {
+                r if r < 2f64.powi(-40) => 0,
+                r if r < 2f64.powi(-30) => 1,
+                r if r < 2f64.powi(-20) => 2,
+                r if r < 2f64.powi(-10) => 3,
+                _ => 4,
+            }] += 1;
+        }
+        println!(
+            "\n=== {name} (alive {} of {frames}{})",
+            alive_for,
+            rec.fault.map(|f| format!(", fault {f:?}")).unwrap_or_default()
+        );
+        println!("  thrust steps: sum {steps_sum} ticks over ticks {}..{}", kicks.first().map(|k| k.tick).unwrap_or(0), kicks.last().map(|k| k.tick).unwrap_or(0));
+        println!(
+            "  counterfactual (fixed granularity): the tide alone at the coast cadence (median tide {coast_median}/kick) would mint ~{tide_only_events} events for the same {}/{} thrust kicks",
+            thrust.len(),
+            kicks.len()
+        );
+        println!(
+            "  counterfactual (law cadence): the tide alone at the clock's own step mints ~{n_law:.0} events (law-bound kicks {law_bound}, burn-bound {burn_bound}); tide per law-cadence event: median {law_budget_med:.3e}, max {law_budget_max:.3e} quanta; closest approach r={:.3e} doll units",
+            r_min as f64 / 1e6
+        );
+        println!("  tide/burn ratio buckets [<2^-40, <2^-30, <2^-20, <2^-10, rest]: {ratio_h:?}");
+        println!("player items total {items} (worst frame {} with {}), max lag {max_lag:.3} s", worst_frame, worst_items);
+        println!("  by kind: kick0 {} kick1+ {} open {} boundary {} crash {} decide {}", wf[0], wf[1], wf[2], wf[3], wf[4], wf[5]);
+        println!(
+            "  kicks recorded {} (thrust {} coast {}); thrust tide==0 quanta: {} ({:.1}%)",
+            kicks.len(),
+            thrust.len(),
+            coast.len(),
+            tide_zero,
+            100.0 * tide_zero as f64 / thrust.len().max(1) as f64
+        );
+        println!("  thrust tide_q buckets [0,1,2-3,4-7,8-15,16-63,64+]: {tide_h:?}");
+        println!("  thrust burn_q buckets: {burn_h:?}");
+        println!("  coast  tide_q buckets: {tide_coast_h:?} (fired {tide_coast_fire} of {})", coast.len());
+        for k in &kicks {
+            println!(
+                "kick tick {} step {} clock {} r {:.6e} beta {:.6e} tide_q {} burn_q {}",
+                k.tick,
+                k.step,
+                clock(k),
+                k.r_e6 as f64 / 1e6,
+                k.beta_e9 as f64 / 1e9,
+                k.tide_q,
+                k.burn_q
+            );
+        }
+    }
+}
