+/// Lab probe (run 20261013-0037-system-174d): what the player's resolved items are, and how much of
+/// each thrust kick is tide (the only part that needs an event) against burn (analytic in rapidity).
+/// Off unless `ES_WATERFALL` is set; no behaviour change either way (counters only).
+pub mod waterfall {
+    use std::sync::atomic::{AtomicU64, Ordering};
+     use std::sync::Mutex;
+
+    /// One thrust kick on the player: `tide_q`/`burn_q` are the max |component| of that part's dv,
+    /// in the velocity word's quanta (rounded toward zero); `step` is the next interval planned.
+    #[derive(Clone, Copy, Debug)]
+    pub struct ThrustKick {
+        pub tick: u64,
+        /// The step that ran: `min(clock, thrust)`.
+        pub step: i64,
+        /// The clock's own step before the thrust clamp: the law's tide cadence at this state.
+        pub clock_full: i64,
+        /// Distance to the doll centre (the star in the root doll), doll units × 10⁻⁶.
+        pub r_e6: u64,
+        pub beta_e9: u64,
+        pub tide_q: i64,
+        pub burn_q: i64,
+    }
+
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    /// Player items by what: kick0, kick1+, open, boundary, crash, decide.
+    pub static PLAYER_ITEMS: [AtomicU64; 6] = [
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+        AtomicU64::new(0),
+    ];
+    static KICKS: Mutex<Option<Vec<ThrustKick>>> = Mutex::new(None);
+
+    pub fn on() -> bool {
+        *ON.get_or_init(|| std::env::var("ES_WATERFALL").is_ok())
+    }
+
+    pub fn item(kind: usize) {
+        PLAYER_ITEMS[kind].fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn kick(k: ThrustKick) {
+        let mut g = KICKS.lock().expect("waterfall");
+        let v = g.get_or_insert_with(Vec::new);
+        if v.len() < 400_000 {
+            v.push(k);
+        }
+    }
+
+    pub fn take_kicks() -> Vec<ThrustKick> {
+        KICKS.lock().expect("waterfall").take().unwrap_or_default()
+    }
+}
