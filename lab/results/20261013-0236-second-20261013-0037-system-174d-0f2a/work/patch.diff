+
+/// The burn's dv alone: the post-burn velocity minus the pre-kick velocity plus the tide's part.
+fn burn_quanta(v: &V2, v2: &V2, exp: i16) -> i64 {
+    (0..2)
+        .map(|c| v2[c].sub(v[c]).map(|d| d.fixed(-(exp as i32)).unwrap_or(0).abs() as i64).unwrap_or(0))
+        .max()
+        .unwrap_or(0)
