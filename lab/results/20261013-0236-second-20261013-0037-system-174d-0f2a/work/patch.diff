+/// The probe's dv magnitudes in velocity quanta (measurement only; the law's own quantize is untouched).
+fn tide_quanta(dv: &V2, exp: i16) -> i64 {
+    dv.iter().map(|s| s.fixed(-(exp as i32)).unwrap_or(0).abs() as i64).max().unwrap_or(0)
