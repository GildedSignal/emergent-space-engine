+/// Lab instrumentation for run `20261010-0541-system-d51f` (the whole-system lens) and its second
+/// author `20261010-0656`. Not part of the law: counters, an opt-in per-frame memo of `ramped`
+/// readouts keyed (body, tick), and an opt-in **incremental deadline** mode for `Universe::apply`
+/// (no per-event doll-chain walk: the last readout is carried forward by its velocity and
+/// re-anchored only when the extrapolation could drift past a fixed fraction of the light
+/// distance). With both off (the default, everywhere outside the lab tests) the engine is the
+/// original, bit for bit.
+pub mod lab {
+    use super::{ramped, Ctx, Res, Tick};
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+
+    /// One doll level's readout: the doll (for shift, μ and the centre), the position and the
+    /// velocity, in the doll's units, as floats.
+    pub type Level = (u16, [f64; 2], [f64; 2]);
+
+    #[derive(Default, Clone, Copy)]
+    pub struct Lab {
+        /// `ramped` readouts paid inside `state_rate` walks (one per chain level).
+        pub levels: u64,
+        pub memo_hits: u64,
+        pub memo_misses: u64,
+        /// The scheduler's per-event position update (`Universe::apply`): calls and nanoseconds.
+        /// In incremental mode a call is charged only when a re-anchor walk ran.
+        pub sched_calls: u64,
+        pub sched_ns: u64,
+    }
+
+    thread_local! {
+        static LAB: RefCell<Lab> = RefCell::default();
+        static MEMO: RefCell<Option<HashMap<(usize, Tick), Level>>> = const { RefCell::new(None) };
+        static INCREMENTAL: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+        static FLOOR: std::cell::Cell<f64> = const { std::cell::Cell::new(1.0e6) };
+    }
+
+    /// The incremental-deadline mode: on, `Universe::apply` stops walking the doll chain per
+    /// event and carries the last readout forward by its velocity (the deadline's own rate
+    /// `1 + n·β`), re-anchoring on a staleness bound. Off (the default) the engine is unchanged.
+    pub fn incremental(on: bool) {
+        INCREMENTAL.with(|f| f.set(on));
+    }
+    pub fn is_incremental() -> bool {
+        INCREMENTAL.with(|f| f.get())
+    }
+
+    /// The staleness bound's distance floor (root units): bodies closer than this to the player
+    /// re-anchor per event, where the relative bound alone would starve the carry. Lab-settable
+    /// (`FLOOR_DEADLINE` is the default), for the cost/error sweep.
+    pub fn floor(f: f64) {
+        FLOOR.with(|c| c.set(f));
+    }
+    pub fn get_floor() -> f64 {
+        FLOOR.with(|c| c.get())
+    }
+
+    pub fn memo(on: bool) {
+        MEMO.with_borrow_mut(|m| *m = if on { Some(HashMap::new()) } else { None });
+    }
+    pub fn reset() {
+        LAB.with_borrow_mut(|l| *l = Lab::default());
+        MEMO.with_borrow_mut(|m| if m.is_some() { *m = Some(HashMap::new()) });
+    }
+    pub fn take() -> Lab {
+        LAB.with_borrow_mut(std::mem::take)
+    }
+
+    /// [`ramped`], memoized per (body, tick) while the memo is on. Levels above the emitter are
+    /// shared by every body of the same doll at the same tick; the memo counts what sharing saves.
+    pub fn ramped_memo(ctx: &Ctx, i: usize, t: Tick) -> Res<Level> {
+        let memo_hit = MEMO.with_borrow(|m| m.as_ref().and_then(|m| m.get(&(i, t)).copied()));
+        if let Some(v) = memo_hit {
+            LAB.with_borrow_mut(|l| {
+                l.levels += 1;
+                l.memo_hits += 1;
+            });
+            return Ok(v);
+        }
+        LAB.with_borrow_mut(|l| {
+            l.levels += 1;
+            l.memo_misses += 1;
+        });
+        let (b, p, v) = ramped(ctx, i, t)?;
+        let out = (b.doll, [super::to_f64(p[0]), super::to_f64(p[1])], [super::to_f64(v[0]), super::to_f64(v[1])]);
+        MEMO.with_borrow_mut(|m| if let Some(m) = m.as_mut() { m.insert((i, t), out); });
+        Ok(out)
+    }
+
+    /// Charge the scheduler's per-event position update. `walked`: the update ran a real
+    /// doll-chain walk (in incremental mode, a re-anchor); without one nothing is charged, so
+    /// `sched_calls` counts walks, not events — the amortization the incremental deadline buys.
+    pub fn sched(d: u64, walked: bool) {
+        if !walked {
+            return;
+        }
+        LAB.with_borrow_mut(|l| {
+            l.sched_calls += 1;
+            l.sched_ns += d;
+        });
+    }
+
+}
