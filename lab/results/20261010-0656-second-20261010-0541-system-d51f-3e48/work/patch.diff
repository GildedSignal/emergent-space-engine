@@ -0,0 +1,323 @@
+//! Lab test for runs `20261010-0541-system-d51f` (the whole-system lens) and its second author
+//! `20261010-0656`: the plane's light-arrival bookkeeping — the scheduler's per-event deadline
+//! position update and the view's per-emitter retarded reads — recomputes the same doll-chain
+//! readouts; a per-frame (body, tick) memo of the `ramped` readout shares them with bit-identical
+//! results (2.9% of levels: retarded ticks differ per emitter), and the scheduler's per-event walk
+//! is deleted by the **incremental deadline**: the last readout carried forward by its velocity
+//! (the arrival rate `1 + n·β` the view already computes), re-anchored by a real walk only when the
+//! carried displacement could pass `REL_DEADLINE` of the light distance.
+//!
+//! The decisive comparison is at a **settle cut** (`frame_to` with `limit`, then `settle`, then
+//! `digest`): the raw flight cuts bite the 5 ms wall budget and diverge by flight timing, not by
+//! behaviour (the first checker's finding). Run with
+//! `cargo test --release -p emergent-universe --test lab_arrival -- --nocapture --test-threads=1`.
+use emergent_universe::observe::lab;
+use emergent_universe::scenario::{plane, stream, Stream};
+use emergent_universe::view::{gather_cached, ViewCache};
+use emergent_universe::fleet::Order;
+use emergent_universe::num::Tick;
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+const FRAMES: usize = 300;
+const RTF: f64 = 100.0;
+
+fn hash_view(v: &emergent_universe::view::View) -> u64 {
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    use std::hash::{Hash, Hasher};
+    v.tick.hash(&mut h);
+    for s in &v.seen {
+        s.id.hash(&mut h);
+        for f in s.direction {
+            f.to_bits().hash(&mut h);
+        }
+        s.light_seconds.to_bits().hash(&mut h);
+        s.offset[0].to_bits().hash(&mut h);
+        s.offset[1].to_bits().hash(&mut h);
+        s.closing.to_bits().hash(&mut h);
+        for f in s.color { f.to_bits().hash(&mut h); }
+        s.luminosity.to_bits().hash(&mut h);
+        s.shift.to_bits().hash(&mut h);
+        s.age.to_bits().hash(&mut h);
+        s.lag.to_bits().hash(&mut h);
+        s.angular_radius.to_bits().hash(&mut h);
+    }
+    v.rate.to_bits().hash(&mut h);
+    v.beta[0].to_bits().hash(&mut h);
+    v.beta[1].to_bits().hash(&mut h);
+    v.proper_seconds.to_bits().hash(&mut h);
+    h.finish()
+}
+
+fn median(v: &mut Vec<u64>) -> f64 {
+    v.sort();
+    v[v.len() / 2] as f64 / 1e3
+}
+fn mean(v: &[u64]) -> f64 {
+    v.iter().sum::<u64>() as f64 / v.len() as f64 / 1e3
+}
+
+struct Flight {
+    gather_ns: Vec<u64>,
+    engine_ns: Vec<u64>,
+    view_hashes: Vec<u64>,
+    digest: String,
+    cut: i64,
+    lab: lab::Lab,
+    events: u64,
+}
+
+fn fly(memo_on: bool) -> Flight {
+    let mut p = plane(Config::default(), 7, Order::Sparse, 1, 48).expect("the plane");
+    let names = p.names.clone();
+    let mut cache = ViewCache::default();
+    let mut out = Flight { gather_ns: Vec::new(), engine_ns: Vec::new(), view_hashes: Vec::new(), digest: String::new(), cut: 0, lab: lab::Lab::default(), events: 0 };
+    lab::memo(memo_on);
+    for n in 0..FRAMES {
+        lab::reset(); // per-frame memo and counters (the gather only; the scheduler counters accumulate per frame too)
+        let t0 = Instant::now();
+        let f = p.u.frame_to(1.0 / 60.0, RTF, Budget::wall(5.0), i64::MAX);
+        let t1 = Instant::now();
+        let v = gather_cached(&p.u, &names, &mut cache).expect("view");
+        let t2 = Instant::now();
+        out.gather_ns.push((t2 - t1).as_nanos() as u64);
+        out.engine_ns.push((t1 - t0).as_nanos() as u64);
+        out.view_hashes.push(hash_view(&v));
+        out.events += f.events;
+        let l = lab::take();
+        out.lab.levels += l.levels;
+        out.lab.memo_hits += l.memo_hits;
+        out.lab.memo_misses += l.memo_misses;
+        out.lab.sched_calls += l.sched_calls;
+        out.lab.sched_ns += l.sched_ns;
+        let _ = n;
+    }
+    lab::memo(false);
+    out.cut = p.u.now;
+    out.digest = p.u.digest();
+    out
+}
+
+#[test]
+fn arrival_bookkeeping_shares_the_doll_chain() {
+    let a = fly(false);
+    let b = fly(true);
+    assert_eq!(a.view_hashes, b.view_hashes, "the memo changed the view's bits");
+    assert_eq!(a.digest, b.digest, "the memo changed the universe digest");
+    assert_eq!(a.cut, b.cut);
+    let share = |l: &lab::Lab| if l.levels > 0 { 100.0 * l.memo_hits as f64 / l.levels as f64 } else { 0.0 };
+    println!(
+        "plane(seed 7, rtf {RTF}, {FRAMES} frames, {} events): levels {} hits {} misses {} hit_share {:.1}% | gather median {:.1} us -> {:.1} us | engine median {:.1} us -> {:.1} us | sched walks {} ({} per event) at {} us each",
+        a.events, b.lab.levels, b.lab.memo_hits, b.lab.memo_misses, share(&b.lab),
+        median(&mut a.gather_ns.clone()), median(&mut b.gather_ns.clone()),
+        median(&mut a.engine_ns.clone()), median(&mut b.engine_ns.clone()),
+        a.lab.sched_calls, a.lab.sched_calls as f64 / a.events as f64, a.lab.sched_ns as f64 / 1e3 / a.lab.sched_calls as f64,
+    );
+
+    // Control (corrected: the counters are reset *before* the gather they measure — the shipped
+    // control reset after reading them, so it measured nothing): the stream scene has every
+    // emitter in the root doll (depth 1), so no level is shared and the memo cannot hit.
+    let (mut u, _ids, _player) = stream(0.0, 0.9, Stream::Toward, 64, 1.0e8, 0).expect("stream");
+    let mut cache = ViewCache::default();
+    let names: Vec<String> = (0..u.n_bodies()).map(|i| format!("b{i}")).collect();
+    lab::memo(true);
+    let mut levels = 0u64;
+    let mut hits = 0u64;
+    for _ in 0..60 {
+        let _ = u.frame_to(1.0 / 60.0, RTF, Budget::wall(5.0), i64::MAX);
+        lab::reset();
+        let _ = gather_cached(&u, &names, &mut cache);
+        let s = lab::take();
+        levels += s.levels;
+        hits += s.memo_hits;
+    }
+    lab::memo(false);
+    let share = if levels > 0 { 100.0 * hits as f64 / levels as f64 } else { 0.0 };
+    println!("control stream(64 emitters, root doll): levels {levels} hits {hits} hit_share {share:.1}%");
+    assert!(levels > 0, "the control measured nothing (the defect the first checker found)");
+    assert!(share < 5.0, "the memo won where no level is shared: an artifact");
+}
+
+// ---- the second author's experiment: the incremental deadline ------------------------------------------------
+//
+// One flight of a scene under one deadline mode, to a canonical cut: `frame_to` never passes
+// `limit`, `settle` finishes everything up to it, and the digest, the view and the deadlines are
+// read at the cut. The budget may bite differently per mode (a different resolution order is the
+// point of the experiment), which is exactly what the settle cut is insensitive to.
+struct DeadFlight {
+    engine_ns: Vec<u64>,
+    events_per_frame: Vec<u64>,
+    events: u64,
+    now_before_settle: Tick,
+    digest: String,
+    view_hash: u64,
+    /// Per body at the cut: the next item's key (canonical) and its deadline as this mode reads it.
+    keys: Vec<Option<Tick>>,
+    deadlines: Vec<Option<Tick>>,
+    lab: lab::Lab,
+}
+
+fn want_ticks(rtf: f64) -> Tick {
+    (rtf * (1.0 / 60.0) / emergent_universe::view::TICK_SECONDS) as Tick
+}
+
+fn flight(u: &mut emergent_universe::Universe, names: &[String], rtf: f64, frames: usize, cut: Tick, incremental: bool) -> DeadFlight {
+    let mut cache = ViewCache::default();
+    let mut out = DeadFlight {
+        engine_ns: Vec::new(),
+        events_per_frame: Vec::new(),
+        events: 0,
+        now_before_settle: 0,
+        digest: String::new(),
+        view_hash: 0,
+        keys: Vec::new(),
+        deadlines: Vec::new(),
+        lab: lab::Lab::default(),
+    };
+    lab::reset();
+    lab::incremental(incremental);
+    for _ in 0..frames {
+        let t0 = Instant::now();
+        let f = u.frame_to(1.0 / 60.0, rtf, Budget::wall(5.0), cut);
+        let t1 = Instant::now();
+        out.engine_ns.push((t1 - t0).as_nanos() as u64);
+        out.events_per_frame.push(f.events);
+        out.events += f.events;
+        let _ = gather_cached(u, names, &mut cache);
+    }
+    out.now_before_settle = u.now;
+    u.settle(cut);
+    out.digest = u.digest();
+    out.view_hash = hash_view(&gather_cached(u, names, &mut cache).expect("view at the cut"));
+    // The keys and the deadlines as this mode reads them (the incremental mode extrapolates; its
+    // flag is still on).
+    out.keys = (0..u.n_bodies()).map(|e| u.horizon_of(e)).collect();
+    out.deadlines = (0..u.n_bodies()).map(|e| u.next_deadline(e)).collect();
+    out.lab = lab::take();
+    lab::incremental(false);
+    out
+}
+
+fn fly_deadline_plane(seed: u64, rtf: f64, frames: usize, incremental: bool) -> DeadFlight {
+    let mut p = plane(Config::default(), seed, Order::Sparse, 1, 48).expect("the plane");
+    let cut = p.u.now + want_ticks(rtf) * frames as Tick;
+    flight(&mut p.u, &p.names, rtf, frames, cut, incremental)
+}
+
+fn fly_deadline_stream(beta_obs: f64, beta: f64, dir: Stream, frames: usize, incremental: bool) -> DeadFlight {
+    let (mut u, _ids, _player) = stream(beta_obs, beta, dir, 64, 1.0e8, 0).expect("stream");
+    let names: Vec<String> = (0..u.n_bodies()).map(|i| format!("b{i}")).collect();
+    let cut = u.now + want_ticks(RTF) * frames as Tick;
+    flight(&mut u, &names, RTF, frames, cut, incremental)
+}
+
+/// The incremental deadlines' error against the walked ones at the cut (the records are the same
+/// there: the digest is equal). Reported as `|d_inc − d_walk|` in ticks: the median and the max,
+/// with the max's walked light distance (which body paid it — near bodies err in hundreds of
+/// ticks, far ones in a bounded fraction of their distance).
+fn deadline_error(a: &DeadFlight, b: &DeadFlight) -> (f64, f64, f64) {
+    let mut abs: Vec<(f64, f64)> = Vec::new(); // (|Δd|, walked dist at the cut)
+    for e in 0..a.deadlines.len() {
+        let (Some(da), Some(db), Some(k)) = (a.deadlines[e], b.deadlines[e], a.keys[e]) else { continue };
+        abs.push(((da as f64 - db as f64).abs(), (da - k).max(0) as f64));
+    }
+    if abs.is_empty() {
+        return (0.0, 0.0, 0.0);
+    }
+    abs.sort_by(|x, y| x.0.partial_cmp(&y.0).unwrap());
+    let med = abs[abs.len() / 2].0;
+    let (m, d) = *abs.last().unwrap();
+    (med, m, d)
+}
+#[test]
+fn incremental_deadline_drops_the_walk_and_keeps_the_bits() {
+    // The plane across seeds and rtfs (seed 7 rtf 100 is the run's own scene; the rest held out).
+    let cases: Vec<(&str, u64, f64, usize)> = vec![
+        ("seed 7", 7, 100.0, FRAMES),
+        ("seed 3", 3, 100.0, FRAMES),
+        ("seed 99", 99, 100.0, FRAMES),
+        ("seed 7, rtf 10", 7, 10.0, FRAMES),
+        ("seed 7, rtf 1000", 7, 1000.0, FRAMES),
+    ];
+    for (name, seed, rtf, frames) in cases {
+        let a = fly_deadline_plane(seed, rtf, frames, false);
+        let b = fly_deadline_plane(seed, rtf, frames, true);
+        assert_eq!(a.digest, b.digest, "{name}: the incremental deadline changed the digest at the settle cut");
+        assert_eq!(a.view_hash, b.view_hash, "{name}: the incremental deadline changed the view at the settle cut");
+        let (emed, emax, edist) = deadline_error(&a, &b);
+        let mut evf = a.events_per_frame.clone();
+        evf.sort();
+        println!(
+            "{name}: events {} (median {}/frame) | engine median {:.1} -> {:.1} us, mean {:.1} -> {:.1} us (sched {} -> {} walks, {:.3} -> {:.3}/event) | presented before settle {:.3e} vs {:.3e} | deadline err ticks med {emed:.3e} max {emax:.3e} (max body's light dist {edist:.3e}; frame = {:.3e} ticks)",
+            a.events, evf[evf.len() / 2],
+            median(&mut a.engine_ns.clone()), median(&mut b.engine_ns.clone()),
+            mean(&a.engine_ns), mean(&b.engine_ns),
+            a.lab.sched_calls, b.lab.sched_calls,
+            a.lab.sched_calls as f64 / a.events as f64, b.lab.sched_calls as f64 / b.events as f64,
+            a.now_before_settle as f64, b.now_before_settle as f64,
+            want_ticks(rtf) as f64,
+        );
+    }
+
+    // The cost knob: the staleness bound's floor. The default (1e6 root units) lets near bodies
+    // (the player's own doll) drift many times their light distance; a smaller floor re-anchors
+    // them more, for walks that are still an order below the per-event tax.
+    for floor in [1.0e6, 1.0e4, 1.0e3] {
+        lab::floor(floor);
+        let a = fly_deadline_plane(7, 100.0, FRAMES, false);
+        let b = fly_deadline_plane(7, 100.0, FRAMES, true);
+        assert_eq!(a.digest, b.digest, "floor {floor}: the incremental deadline changed the digest at the settle cut");
+        let (emed, emax, edist) = deadline_error(&a, &b);
+        println!(
+            "seed 7, floor {floor:.0e}: walks {} -> {} | engine median {:.1} -> {:.1} us, mean {:.1} -> {:.1} | deadline err ticks med {emed:.3e} max {emax:.3e} (max body's light dist {edist:.3e})",
+            a.lab.sched_calls, b.lab.sched_calls,
+            median(&mut a.engine_ns.clone()), median(&mut b.engine_ns.clone()),
+            mean(&a.engine_ns), mean(&b.engine_ns),
+        );
+    }
+    lab::floor(1.0e6);
+
+    // The regime the lens flagged: β → 1. The stream's emitters are inertial at 0.99c: the
+    // carried readout is exact along a straight worldline (measured below), where the rate form
+    // of the deadline (1 + n·β → 0.01 closing, 1.99 receding) is at its worst. The flights then
+    // hold digest and view equality at the settle cut. The shipped scenes have no relativistic
+    // *events* (measured: 0) — the deadline carry under β→1 *kicks* is stated, not run.
+    for (name, obs, beta, dir) in [
+        ("stream 0.99c toward", 0.0, 0.99, Stream::Toward),
+        ("stream 0.99c away", 0.0, 0.99, Stream::Away),
+        ("stream 0.99c toward, observer 0.9c", 0.9, 0.99, Stream::Toward),
+    ] {
+        let a = fly_deadline_stream(obs, beta, dir, 320, false);
+        let b = fly_deadline_stream(obs, beta, dir, 320, true);
+        assert_eq!(a.digest, b.digest, "{name}: the incremental deadline changed the digest at the settle cut");
+        assert_eq!(a.view_hash, b.view_hash, "{name}: the incremental deadline changed the view at the settle cut");
+        println!(
+            "{name}: events {} | engine median {:.1} -> {:.1} us | sched walks {} -> {}",
+            a.events,
+            median(&mut a.engine_ns.clone()), median(&mut b.engine_ns.clone()),
+            a.lab.sched_calls, b.lab.sched_calls,
+        );
+    }
+
+    // The carry itself at β→1: an inertial emitter's walked readout against the carry from tick 0
+    // across the whole flight — the position form does not degrade as the arrival rate goes to
+    // 0.01 (closing) or 1.99 (receding).
+    let (mut u, ids, _player) = stream(0.0, 0.99, Stream::Toward, 8, 1.0e8, 0).expect("stream");
+    u.frame_to(1.0 / 60.0, 100.0, Budget::unlimited(), 1);
+    let ctx = u.ctx();
+    let mut worst = 0.0f64;
+    for &i in &ids {
+        let Ok((p0, v0)) = emergent_universe::observe::root_state_raw(&ctx, i, 0) else { continue };
+        for t in [1.0e6, 1.0e7, 5.0e7] {
+            let Ok((p, _)) = emergent_universe::observe::root_state_raw(&ctx, i, t as Tick) else { continue };
+            let carried = [p0[0] + v0[0] * t, p0[1] + v0[1] * t];
+            let dist = ((p[0] - carried[0]).powi(2) + (p[1] - carried[1]).powi(2)).sqrt();
+            let scale = 1.0e8 + 1.0; // the emitter's distance scale over the flight
+            worst = worst.max(dist / scale);
+        }
+    }
+    println!("carry vs walk, inertial 0.99c over 5e7 ticks: worst relative error {worst:.2e}");
+    // 5e-8 is f64 noise at 1e8 root units (the tube's own quantized readout); drift would grow
+    // with t², and this is flat in t.
+    assert!(worst < 1.0e-6, "the carry drifts along an inertial 0.99c worldline");
+}
