+/// The page's view of the frame on the wire. What the page does not draw (an emitter's luminosity, age,
+/// lag and angular radius, its id) stays in [`View`] and out of the wire: each float is serialised every
+/// frame, in one pass over borrowed data (the fields are declared in the `json!` map's serialised key
+/// order — alphabetical, `serde_json` without `preserve_order` — so the bytes are the ones the `Value`
+/// tree produced; a test pins that).
+#[derive(serde::Serialize)]
+struct FrameJson<'a> {
+    alive: bool,
+    beta: [f64; 2],
+    burning: bool,
+    coordinate: f64,
+    doll: &'a str,
+    doll_beta: [f64; 2],
+    doll_rate: f64,
+    heading: [f64; 2],
+    keys: u8,
+    level: u8,
+    loss: &'a Option<String>,
+    position: [f64; 2],
+    proper: f64,
+    rate: f64,
+    refusals: u64,
+    seen: Vec<SeenJson<'a>>,
+    tick: emergent_universe::num::Tick,
+}
+
+#[derive(serde::Serialize)]
+struct SeenJson<'a> {
+    closing: f64,
+    color: [f64; 3],
+    direction: [f64; 2],
+    kind: u8,
+    light_seconds: f64,
+    name: &'a str,
+    offset: [f64; 2],
+    shift: f64,
+}
+
+impl<'a> From<&'a View> for FrameJson<'a> {
+    fn from(v: &'a View) -> Self {
+        Self {
+            alive: v.alive,
+            beta: v.beta,
+            burning: v.burning,
+            coordinate: v.coordinate_seconds,
+            doll: v.doll,
+            doll_beta: v.doll_beta,
+            doll_rate: v.doll_rate,
+            heading: v.heading,
+            keys: v.keys,
+            level: v.level,
+            loss: &v.loss,
+            position: v.position_light_seconds,
+            proper: v.proper_seconds,
+            rate: v.rate,
+            refusals: v.refusals,
+            seen: v.seen.iter().map(|s| SeenJson {
+                closing: s.closing,
+                color: s.color,
+                direction: s.direction,
+                kind: s.kind,
+                light_seconds: s.light_seconds,
+                name: &s.name,
+                offset: s.offset,
+                shift: s.shift,
+            }).collect(),
+            tick: v.tick,
+        }
+    }
+}
+
+#[cfg(test)]
+mod wire_tests {
+    use super::*;
+    use emergent_universe::view::Seen;
+
+    /// The `json!` tree this frame loop used to build every frame: the wire must be byte for byte its output.
+    fn view_value(v: &View) -> Value {
+        json!({
+            "tick": v.tick, "coordinate": v.coordinate_seconds, "proper": v.proper_seconds, "rate": v.rate,
+            "beta": v.beta, "doll_rate": v.doll_rate, "doll_beta": v.doll_beta, "position": v.position_light_seconds,
+            "heading": v.heading, "doll": v.doll, "level": v.level, "burning": v.burning, "keys": v.keys, "alive": v.alive, "loss": v.loss, "refusals": v.refusals,
+            "seen": v.seen.iter().map(|s| json!({
+                "name": s.name, "kind": s.kind, "direction": s.direction, "light_seconds": s.light_seconds,
+                "offset": s.offset, "closing": s.closing, "color": s.color, "shift": s.shift,
+            })).collect::<Vec<_>>(),
+        })
+    }
+
+    fn sample() -> View {
+        let seen = |id: usize, name: &str, kind: u8, shift: f64| Seen {
+            id,
+            name: name.into(),
+            kind,
+            direction: [-0.5, 0.86],
+            light_seconds: 1.5e-3,
+            offset: [-123.4, 5.678e2],
+            closing: -0.25,
+            color: [0.1, 0.9, 1.0 / 3.0],
+            luminosity: 1e-6,
+            shift,
+            age: 0.0,
+            lag: 3.0,
+            angular_radius: 1e-9,
+        };
+        View {
+            tick: -6090763,
+            coordinate_seconds: 30.0000000001,
+            proper_seconds: 29.9999999998,
+            rate: 1.0 - 1e-12,
+            beta: [1e-9, -2e-9],
+            doll_rate: 0.999999999,
+            doll_beta: [0.0, 0.0],
+            level: 11,
+            burning: true,
+            alive: true,
+            loss: None,
+            keys: 0b0101,
+            refusals: 0,
+            position_light_seconds: [1e-7, -3.5e-7],
+            heading: [1.0, 0.0],
+            doll: "root",
+            seen: vec![seen(usize::MAX, "star", 0, 0.8), seen(1_048_576, "fleet", 4, 1.2), seen(3, "ship", 3, 1e-15)],
+        }
+    }
+
+    #[test]
+    fn wire_bytes_unchanged() {
+        let v = sample();
+        assert_eq!(
+            serde_json::to_vec(&view_value(&v)).unwrap(),
+            serde_json::to_vec(&FrameJson::from(&v)).unwrap()
+        );
+        let mut lost = sample();
+        lost.alive = false;
+        lost.loss = Some("burned".into());
+        assert_eq!(
+            serde_json::to_vec(&view_value(&lost)).unwrap(),
+            serde_json::to_vec(&FrameJson::from(&lost)).unwrap()
+        );
+    }
 }
