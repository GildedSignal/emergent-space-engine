+/// floor(n/d) for any n and d < 2^64: the word path when the precondition holds,
+/// the compiler's 128-bit division otherwise. Bit-identical to `n / d as u128`.
+#[inline]
+pub(crate) fn div_w64(n: u128, d: u64) -> u64 {
+    if (n >> 64) < d as u128 {
+        div_word(n, d)
+    } else {
+        (n / d as u128) as u64
+    }
+}
