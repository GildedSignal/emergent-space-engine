+/// Coarse wall-clock timers for both kick paths (lab run 20261009-0521: stage shares on the path the
+/// kick bench actually samples — the legacy split `fn kick`, not the register's `kick_clock`).
+/// Thread-local, additive, printed by the kick bench; zero effect when unread. Paths are accumulated
+/// separately (LEGACY = `fn kick`, CLOCK = `kick_clock`, the energy-register path of law v2), and so
+/// are three phases: 0 = the bench's replayed kicks, 1 = the bench's cold-paired replays, 2 = the
+/// engine's own calls while advancing frames. A phase is just a slot key: the caller sets it around
+/// the calls it wants attributed together.
+pub mod stages {
+    pub const N: usize = 6;
+    /// readout, gather (sources+tide), forces+velocity update, rebind, other, total.
+    pub const NAMES: [&str; N] = ["readout", "gather", "forces_quant", "rebind", "other", "total"];
+    pub const LEGACY: u8 = 0;
+    pub const CLOCK: u8 = 1;
+    pub const SLOTS: usize = 6;
+    thread_local! {
+        static NS: std::cell::RefCell<[[u64; N]; SLOTS]> = const { std::cell::RefCell::new([[0; N]; SLOTS]) };
+        static ADDS: std::cell::RefCell<[[u64; N]; SLOTS]> = const { std::cell::RefCell::new([[0; N]; SLOTS]) };
+        static ENTERS: std::cell::RefCell<[u64; SLOTS]> = const { std::cell::RefCell::new([0; SLOTS]) };
+        static PHASE: std::cell::Cell<u8> = const { std::cell::Cell::new(0) };
+    }
+    pub fn set_phase(p: u8) {
+        PHASE.with(|c| c.set(p % 3));
+    }
+    fn slot(path: u8) -> usize {
+        (PHASE.with(|p| p.get()) as usize) * 2 + (path as usize & 1)
+    }
+    pub fn add(path: u8, i: usize, ns: u64) {
+        let s = slot(path);
+        NS.with(|c| c.borrow_mut()[s][i] += ns);
+        ADDS.with(|c| c.borrow_mut()[s][i] += 1);
+    }
+    pub fn enter(path: u8) {
+        ENTERS.with(|c| c.borrow_mut()[slot(path)] += 1);
+    }
+    pub fn report() -> String {
+        NS.with(|ns| ADDS.with(|ad| ENTERS.with(|en| {
+            let (ns, ad, en) = (ns.borrow(), ad.borrow(), en.borrow());
+            let fmt = |tag: &str, k: usize| {
+                let c = &ns[k];
+                let sum: u64 = c[..4].iter().sum();
+                format!(
+                    "{tag}_calls={} {tag}_readout_ns={} {tag}_gather_ns={} {tag}_forces_quant_ns={} \
+                     {tag}_rebind_ns={} {tag}_rebind_calls={} {tag}_other_ns={} {tag}_total_ns={}",
+                    en[k], c[0], c[1], c[2], c[3], ad[k][3], c[5].saturating_sub(sum), c[5]
+                )
+            };
+            format!(
+                "{}\n{}\n{}\n{}\n{}\n{}",
+                fmt("legacy", 0),
+                fmt("clock", 1),
+                fmt("legacy_cold", 2),
+                fmt("clock_cold", 3),
+                fmt("legacy_engine", 4),
+                fmt("clock_engine", 5)
+            )
+        })))
+    }
+}
