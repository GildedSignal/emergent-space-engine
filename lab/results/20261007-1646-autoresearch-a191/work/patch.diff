diff --git a/crates/space/src/prof.rs b/crates/space/src/prof.rs
new file mode 100644
index 0000000..3558c05
--- /dev/null
+++ b/crates/space/src/prof.rs
@@ -0,0 +1,65 @@
+//! Temporary phase timers for this lab run only (diagnostic; the patch is a proposal).
+//! `EMERGENT_PROF=1` gates the dump; scopes are thread-local and add ~25 ns each.
+use std::cell::RefCell;
+use std::time::Instant;
+
+const N: usize = 24;
+
+thread_local! {
+    static PHASES: RefCell<[(&'static str, u128, u64); N]> = const { RefCell::new([("", 0, 0); N]) };
+}
+
+pub struct Guard {
+    name: &'static str,
+    t0: Instant,
+}
+
+pub fn scope(name: &'static str) -> Guard {
+    Guard { name, t0: Instant::now() }
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        let ns = self.t0.elapsed().as_nanos();
+        PHASES.with(|p| {
+            let mut p = p.borrow_mut();
+            for s in p.iter_mut() {
+                if s.0 == self.name {
+                    s.1 += ns;
+                    s.2 += 1;
+                    return;
+                }
+            }
+            for s in p.iter_mut() {
+                if s.0.is_empty() {
+                    *s = (self.name, ns, 1);
+                    return;
+                }
+            }
+        });
+    }
+}
+
+/// Print the table to stderr, sorted by total time.
+pub fn dump() {
+    if std::env::var("EMERGENT_PROF").ok().as_deref() != Some("1") {
+        return;
+    }
+    PHASES.with(|p| {
+        let mut p = p.borrow().clone();
+        p.sort_by(|a, b| b.1.cmp(&a.1));
+        let total: u128 = p.iter().map(|s| s.1).sum();
+        eprintln!("--- prof (thread) ---");
+        for (name, ns, count) in p {
+            if name.is_empty() {
+                continue;
+            }
+            eprintln!(
+                "{name:<14} {ns:>10} ns  {count:>7}x  {ns_u:>9} ns/x  {pct:>5.1}%",
+                ns_u = ns / (count as u128).max(1),
+                pct = 100.0 * ns as f64 / total.max(1) as f64
+            );
+        }
+        eprintln!("--- total {total} ns ---");
+    });
+}
