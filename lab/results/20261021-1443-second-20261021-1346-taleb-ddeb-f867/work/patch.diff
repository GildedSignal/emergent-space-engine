new file mode 100644
index 00000000..d90ca9fa
--- /dev/null
+++ b/crates/universe/examples/beltcensus.rs
@@ -0,0 +1,160 @@
+// The fine-class census of the plane's belt (kick-cadence's open direction 1): which bodies must stay
+// fine (encounters, resonances) and what fraction they are, on the shipped birth law (`ladder_ship`'s
+// belt arm verbatim: a uniform [2,3) AU, Rayleigh e = 0.07 redrawn above 0.4) against the shipped
+// planets (PLANETS). The floors are the measured ones: belt 16/planet-period (cbe6, interior draws
+// 6.3-8.8 Hill, e <= 0.23), bridge/strong 64 (the unflown interior bridge below 6.3 Hill), encounter
+// and resonance 256 per own orbit (B13/7076), first-order resonance = uncertifiable at any cadence
+// (67be). Zone widths are the oracle side (pendulum model, Murray & Dermott ch. 8: first order
+// delta-a/a = (j/k) sqrt(16 mu e / 3), order q carries e^q by d'Alembert); floats explore here, the
+// counts decide. WIDTHMULT sweeps the width; ARM remaps the belt's a-marginal (design arm).
+//
+// beltcensus [EXTRA] [SEEDS] [WIDTHMULT] [ARM]
+//   ARM: shipped (default) | 3.0:3.5 | 1.4:2.4
+use emergent_universe::num::to_f64;
+use emergent_universe::scenario::{ladder_locals, ladder_ship, PLANETS};
+use emergent_universe::OrbitSpec;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let extra: u64 = args.get(1).map(|s| s.parse().unwrap()).unwrap_or(1_000_002);
+    let seeds: Vec<u64> = args.get(2).map(|s| s.split(',').map(|x| x.parse().unwrap()).collect()).unwrap_or(vec![1, 2, 3]);
+    let wmult: f64 = args.get(3).map(|s| s.parse().unwrap()).unwrap_or(1.0);
+    let argf = |i: usize| args.get(i).map(|s| s.parse::<f64>().unwrap()).unwrap_or(0.0);
+    // Measured class floors in kicks per Giant-period (zonecad, this run's patch): zone / e-tail / bridge.
+    // 0 keeps ddeb's census floors (zone and e-tail 256/own-orbit, bridge 64 per Giant-period).
+    let (zf, ef, bf) = (argf(5), argf(6), argf(7));
+    eprintln!("floors zf={zf} ef={ef} bf={bf} (kicks per Giant-period; 0 = ddeb's census floors)");
+    let arm = args.get(4).cloned().unwrap_or_else(|| "shipped".into());
+    let (lo, hi) = match arm.as_str() {
+        "shipped" => (2.0f64, 3.0f64),
+        s => {
+            let (a, b) = s.split_once(':').unwrap();
+            (a.parse().unwrap(), b.parse().unwrap())
+        }
+    };
+
+    // The planets, in AU and star masses (the star's M is one root unit; P in years = a_AU^1.5).
+    let planets: Vec<(String, f64, f64, f64)> = PLANETS
+        .iter()
+        .map(|p| {
+            let e = p.e_q48 as f64 / (1u64 << 48) as f64;
+            let a = p.periapsis as f64 / 101_300_000.0 / (1.0 - e);
+            (p.name.to_string(), a, e, 2f64.powi(p.mass_log2))
+        })
+        .collect();
+    eprintln!("planets (a AU, e, mu): {:?}", planets.iter().map(|(n, a, e, m)| format!("{n} {a:.4} {e:.3} {m:.2e}")).collect::<Vec<_>>());
+
+
+    let mut resonances: Vec<(usize, &str, f64, usize, usize, f64)> = Vec::new(); // (planet, a_res, j, k, mu)
+    // Resonances with each planet whose zone can touch the arm's window: coprime (j, k), order
+    // q = j - k <= 6, with a_res = a_p (k/j)^(2/3) in [lo - 6%, hi + 6%].
+    for (name, a_p, _, mu) in &planets {
+        for j in 2..=24usize {
+            for k in 1..j {
+                if gcd(j, k) != 1 { continue; }
+                let a_res = a_p * (k as f64 / j as f64).powf(2.0 / 3.0);
+                if a_res > lo * 0.94 && a_res < hi * 1.06 {
+                    resonances.push((0, name.as_str(), a_res, j, k, *mu));
+                }
+            }
+        }
+    }
+    fn gcd(a: usize, b: usize) -> usize { if b == 0 { a } else { gcd(b, a % b) } }
+    eprintln!("resonance candidates: {}", resonances.iter().map(|(_, n, a, j, k, _)| format!("{n} {j}:{k}@{a:.3}")).collect::<Vec<_>>().join(" "));
+
+    for &seed in &seeds {
+        let locals = ladder_locals(extra);
+        let mut cls = [0u64; 5]; // A16, B64, C256(res+enc+e-domain), D first-order, (spare)
+        let mut zones: std::collections::HashMap<String, u64> = std::collections::HashMap::new();
+        let mut rate_sum = 0.0f64; // conservative events per belt-orbit, both combs (x2 applied at print)
+        let mut rate_opt = 0.0f64; // optimistic: bridge at 16
+        let mut strong = 0u64;
+        let mut bins = [0u64; 32];
+        let mut bins_fine = [0u64; 32];
+        let mut a_min = f64::MAX;
+        let mut a_max = 0.0f64;
+        for k in locals..extra {
+            let Ok((spec, _)) = ladder_ship(seed, k, extra, 1) else { continue };
+            let (a, e) = ship_ae(&spec, lo, hi);
+            a_min = a_min.min(a); a_max = a_max.max(a);
+            let bin = (((a - lo) / (hi - lo) * 32.0) as usize).min(31);
+            bins[bin] += 1;
+            // Periapsis and apoapsis in AU.
+            let (peri, apo) = (a * (1.0 - e), a * (1.0 + e));
+            let mut crossing = false;
+            let mut gap_hill_min = f64::MAX;
+            for (_, a_p, e_p, mu) in &planets {
+                let (peri_p, apo_p) = (*a_p * (1.0 - e_p), *a_p * (1.0 + e_p));
+                if peri < apo_p && apo > peri_p { crossing = true; }
+                let gap = if apo <= peri_p { peri_p - apo } else if peri >= apo_p { peri - apo_p } else { 0.0 };
+                let hill = a_p * (mu / 3.0).cbrt();
+                gap_hill_min = gap_hill_min.min(gap / hill);
+            }
+            let mut first_order = false;
+            let mut in_zone = None;
+            for (_, name, a_res, j, k, mu) in &resonances {
+                let q = j - k;
+                let w = (*j as f64 / *k as f64) * (16.0 * *mu * e.powi(q as i32) / 3.0).sqrt() * wmult;
+                if (a - a_res).abs() <= w * a_res {
+                    if q == 1 { first_order = true; }
+                    *zones.entry(format!("{name} {j}:{k}")).or_insert(0) += 1;
+                    in_zone = Some((q, *j, *k));
+                }
+            }
+            let p_own = a.powf(1.5); // belt-orbit in years
+            let p_g = planets[2].1.powf(1.5); // the Giant, the belt's perturber
+            let bin_fine = crossing || first_order || in_zone.is_some() || e > 0.23;
+            if bin_fine { bins_fine[bin] += 1; }
+            // Class and per-belt-orbit rate (kick comb; both combs = x2).
+            let (c, r_cons, r_opt) = if crossing {
+                (2u8, 256.0, 256.0)
+            } else if first_order {
+                (3u8, f64::INFINITY, f64::INFINITY)
+            } else if in_zone.is_some() || e > 0.23 {
+                // Zone bodies at the measured zone floor (zf), the e-tail at ef (zonecad, this run);
+                // both in kicks per Giant-period; 0 keeps ddeb's 256/own-orbit.
+                let f = if in_zone.is_some() { zf } else { ef };
+                let r = if f > 0.0 { f * p_own / p_g } else { 256.0 };
+                (2u8, r, r)
+            } else if gap_hill_min < 6.3 {
+                let r = if bf > 0.0 { bf * p_own / p_g } else { 64.0 * p_own / p_g };
+                (1u8, r, if bf > 0.0 { r } else { 16.0 * p_own / p_g })
+            } else {
+                (0u8, 16.0 * p_own / p_g, 16.0 * p_own / p_g)
+            };
+            cls[c as usize] += 1;
+            if !crossing && !bin_fine && gap_hill_min < 4.1 { strong += 1; }
+            rate_sum += r_cons;
+            rate_opt += r_opt;
+        }
+        let n: u64 = cls.iter().sum();
+        let fine = cls[2] + cls[3];
+        let worst = (0..32).map(|b| if bins[b] > 0 { (bins_fine[b] as f64 / bins[b] as f64, b) } else { (0.0, b) }).fold((0.0f64, 0usize), |x, y| if y.0 > x.0 { y } else { x });
+        println!(
+            "arm={arm} seed={seed} wmult={wmult} extra={extra} n={n} a=[{a_min:.4},{a_max:.4}] A16={} B64={} C256={} D1={} fine={fine} ({:.4}) rate/belt-orbit cons={:.2} opt={:.2} headroom9000 cons={:.0}x opt={:.0}x worstbin={} ({:.0}% fine, {}/{} bodies)",
+            cls[0], cls[1], cls[2], cls[3],
+            fine as f64 / n as f64,
+            2.0 * rate_sum / n as f64, 2.0 * rate_opt / n as f64,
+            9000.0 / (2.0 * rate_sum / n as f64), 9000.0 / (2.0 * rate_opt / n as f64),
+            worst.1, 100.0 * worst.0, bins_fine[worst.1], bins[worst.1],
+        );
+        let mut zs: Vec<(String, u64)> = zones.into_iter().collect();
+        zs.sort_by_key(|(_, c)| std::cmp::Reverse(*c));
+        println!("  strong<4.1hill={strong} zones: {}", zs.iter().take(8).map(|(z, c)| format!("{z}={c}")).collect::<Vec<_>>().join(" "));
+        let mut holes: Vec<(usize, u64)> = bins.iter().enumerate().filter(|(b, c)| **c > 0 && bins_fine[*b] as f64 / **c as f64 > 0.5).map(|(b, c)| (b, *c)).collect();
+        holes.sort_by_key(|(b, _)| *b);
+        if !holes.is_empty() {
+            println!("  bins >50% fine: {} of {}", holes.iter().map(|(b, c)| format!("{}({} bodies)", b, c)).collect::<Vec<_>>().join(" "), bins.iter().sum::<u64>());
+        }
+    }
+}
+
+/// The belt arm's elements: shipped window [2,3) or the design arm's remapped marginal (the same
+/// shipped draw, linearly stretched; e, angles untouched).
+fn ship_ae(spec: &OrbitSpec, lo: f64, hi: f64) -> (f64, f64) {
+    let e = spec.e_q48 as f64 / (1u64 << 48) as f64;
+    let p2 = to_f64(spec.periapsis) / 101_300_000.0; // periapsis AU, shipped window
+    let a2 = p2 / (1.0 - e);
+    let a = lo + (a2 - 2.0) * (hi - lo); // identity for the shipped arm (2,3)
+    (a, e)
+}
diff --git a/crates/universe/examples/zonecad.rs b/crates/universe/examples/zonecad.rs
new file mode 100644
index 00000000..7da84b2f
--- /dev/null
+++ b/crates/universe/examples/zonecad.rs
@@ -0,0 +1,205 @@
+//! The two unflown arms of the fine-class census (ddeb's zone floor and bridge floor): cbe6's
+//! `beltcad` instrument verbatim — same scene (star + Jupiter 2^-10 at sep 527e6, surface 49000),
+//! same samplers, same scaled-Jacobi metric and B12's frozen 1e-4 bar — with the belt drawn from
+//! the shipped birth law (`ladder_ship`'s belt arm verbatim: a uniform [2,3) AU, Rayleigh e = 0.07
+//! redrawn above 0.4) and kept by census class:
+//!   zone31 — inside the scene planet's 3:1 zone (q = 2, the census's dominant fine zone, 9.4% of
+//!            the belt): |a - a_res| <= 3 sqrt(16 mu e^2 / 3) a_res, ddeb's width model, WMULT dial;
+//!   clean  — gap >= 6.3 Hill, outside every q >= 2 zone, e <= 0.23 (the census's A16 class, here
+//!            eccentric: cbe6 flew circles only);
+//!   etail  — e > 0.23, outside every q >= 2 zone, gap >= 4.1 Hill (the census's e-tail C256
+//!            population, above cbe6's certified e-domain);
+//!   beltc  — cbe6's belt circles verbatim (the control: step 4 must PASS at ~1e-5).
+//! `zonecad STEP_LOG2 PERIODS SHIPS CLASS [SEED] [WMULT]`; SEED feeds `ladder_ship` (default 1).
+use emergent_universe::body::Kind;
+use emergent_universe::num::{s, to_f64};
+use emergent_universe::observe::{root_state, root_state_raw};
+use emergent_universe::scenario::{ladder_locals, ladder_ship, STAR_RADIUS};
+use emergent_universe::{Config, Mass, OrbitSpec, Universe};
+use emergent_space::orbit::Scalar;
+
+fn main() {
+    let step_log2: i32 = std::env::args().nth(1).map(|s| s.parse().unwrap()).unwrap_or(4);
+    let periods: i64 = std::env::args().nth(2).map(|s| s.parse().unwrap()).unwrap_or(100);
+    let n: usize = std::env::args().nth(3).map(|s| s.parse().unwrap()).unwrap_or(6);
+    let class = std::env::args().nth(4).unwrap_or_else(|| "beltc".into());
+    let lseed: u64 = std::env::args().nth(5).map(|s| s.parse().unwrap()).unwrap_or(1);
+    let wmult: f64 = std::env::args().nth(6).map(|s| s.parse().unwrap()).unwrap_or(1.0);
+    let sep = 527_000_000i64;
+    let planet_radius_root = 49_000i64;
+    let au = 101_300_000i64;
+    let mu = 2f64.powi(-10);
+    let a_p = sep as f64 / au as f64; // 5.2004 AU, circular (the scene's own planet)
+    let hill = a_p * (mu / 3.0).cbrt();
+
+    // The class predicates: ddeb's census logic against the scene's own planet.
+    let zones: Vec<(usize, usize, f64)> = (2..=24usize)
+        .flat_map(|j| (1..j).map(move |k| (j, k)))
+        .filter(|(j, k)| gcd(*j, *k) == 1 && j - k <= 6)
+        .map(|(j, k)| (j, k, a_p * (k as f64 / j as f64).powf(2.0 / 3.0)))
+        .filter(|&(_, _, a_res)| a_res > 2.0 * 0.94 && a_res < 3.0 * 1.06)
+        .collect();
+    let zone_of = |a: f64, e: f64| -> Option<(usize, usize)> {
+        for &(j, k, a_res) in &zones {
+            let q = j - k;
+            let w = (j as f64 / k as f64) * (16.0 * mu * e.powi(q as i32) / 3.0).sqrt() * wmult;
+            if (a - a_res).abs() <= w * a_res {
+                return Some((j, k));
+            }
+        }
+        None
+    };
+    let a_res31 = a_p * (1.0f64 / 3.0).powf(2.0 / 3.0);
+    let in_zone31 = |a: f64, e: f64| {
+        let w = 3.0 * (16.0 * mu * e * e / 3.0).sqrt() * wmult;
+        (a - a_res31).abs() <= w * a_res31
+    };
+
+    // The ships: cbe6's circles for the control, else the shipped belt draw kept by class.
+    let mut specs: Vec<OrbitSpec> = Vec::new();
+    let mut meta: Vec<(f64, f64, f64, f64)> = Vec::new(); // (a AU, e, gap/hill, Jacobi scale in root units)
+    let extra = 1_000_002u64;
+    let mut k = ladder_locals(extra);
+    let mut seed: u64 = 0x9E37_79B9_7F4A_7C15;
+    let mut rnd =
+        || { seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407); (seed >> 11) as f64 / (1u64 << 53) as f64 };
+    while specs.len() < n {
+        if class == "beltc" {
+            let r = (2.0 + rnd()) * au as f64;
+            let alpha = ((rnd() * (1u64 << 32) as f64) as u64 % (1 << 32)) as u32;
+            specs.push(OrbitSpec { doll: 0, periapsis: s(r as i64), e_q48: 0, clockwise: false, angle: alpha, phase: 0 });
+            let a = r / au as f64;
+            meta.push((a, 0.0, (a_p - a) / hill, r));
+            continue;
+        }
+        let (spec, _radius) = ladder_ship(lseed, k, extra, 1).unwrap();
+        k += 1;
+        if spec.doll != 0 {
+            continue; // the belt arm only
+        }
+        let e = spec.e_q48 as f64 / (1u64 << 48) as f64;
+        let p2 = to_f64(spec.periapsis) / au as f64; // periapsis AU
+        let a = p2 / (1.0 - e);
+        let gap_hill = (a_p - a * (1.0 + e)) / hill;
+        let keep = match class.as_str() {
+            "zone31" => in_zone31(a, e),
+            "zone31c" => {
+                let w = 3.0 * (16.0 * mu * e * e / 3.0).sqrt() * wmult;
+                (a - a_res31).abs() <= 0.1 * w * a_res31
+            }
+            "bridge" => gap_hill >= 5.0 && gap_hill < 6.3 && zone_of(a, e).is_none() && e <= 0.23,
+            "bridge2" => gap_hill >= 4.1 && gap_hill < 5.0 && zone_of(a, e).is_none() && e <= 0.23,
+            "clean" => gap_hill >= 6.3 && zone_of(a, e).is_none() && e <= 0.23,
+            "etail" => e > 0.23 && zone_of(a, e).is_none() && gap_hill >= 4.1,
+            _ => panic!("class {class}: zone31 | zone31c | bridge | bridge2 | clean | etail | beltc"),
+        };
+        if keep {
+            specs.push(spec);
+            meta.push((a, e, gap_hill, a * au as f64));
+        }
+    }
+    println!("class {class} sep {sep} hill_au {hill:.4} a_res31 {a_res31:.4} k_drawn {k} wmult {wmult} lseed {lseed}");
+    for (i, m) in meta.iter().enumerate() {
+        println!("  ship {i}: a {:.4} e {:.4} gap {:+.2} hill (scale {:.3e})", m.0, m.1, m.2, m.3);
+    }
+
+    // The scene: `restricted_with`'s body verbatim, with the drawn (possibly eccentric) specs.
+    let cfg = Config { step_log2, ..Config::default() };
+    let mut w = Universe::new(s(STAR_RADIUS), cfg);
+    w.threads = 1;
+    let mass: Mass = Mass::from(-10);
+    let planet = w
+        .add_body(
+            Kind::Planet,
+            OrbitSpec { doll: 0, periapsis: s(sep), e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+            Scalar::ZERO,
+        )
+        .unwrap();
+    let surface = Scalar::raw(planet_radius_root as i128, -mass.octave).unwrap();
+    w.add_doll("planet", planet, mass, surface).unwrap();
+    let mut ids = Vec::new();
+    for spec in &specs {
+        ids.push(w.add_body(Kind::Ship, *spec, Scalar::raw(34, -10).unwrap()).unwrap());
+    }
+    w.start().unwrap();
+
+    let omega = (1.0 + mu).sqrt() / (sep as f64).powf(1.5);
+    let period = 2.0 * std::f64::consts::PI / omega;
+    let jac = |w: &Universe, sh: usize, t: i64| -> Option<f64> {
+        let ctx = w.ctx();
+        let read = if std::env::var("RAW").is_ok() { root_state_raw } else { root_state };
+        let (xs, vs) = read(&ctx, sh, t).ok()?;
+        let (xp, _) = read(&ctx, planet, t).ok()?;
+        let r = (xs[0] * xs[0] + xs[1] * xs[1]).sqrt();
+        let d = ((xs[0] - xp[0]).powi(2) + (xs[1] - xp[1]).powi(2)).sqrt();
+        let rp3 = (xp[0] * xp[0] + xp[1] * xp[1]).powf(1.5);
+        let e = 0.5 * (vs[0] * vs[0] + vs[1] * vs[1]) - 1.0 / r - mu / d + mu * (xs[0] * xp[0] + xs[1] * xp[1]) / rp3;
+        let l = xs[0] * vs[1] - xs[1] * vs[0];
+        Some(e - omega * l)
+    };
+    let osc_e = |w: &Universe, sh: usize, t: i64| -> Option<f64> {
+        let ctx = w.ctx();
+        let (xs, vs) = root_state(&ctx, sh, t).ok()?;
+        let r = (xs[0] * xs[0] + xs[1] * xs[1]).sqrt();
+        let v2 = vs[0] * vs[0] + vs[1] * vs[1];
+        let rv = xs[0] * vs[0] + xs[1] * vs[1];
+        let ex = (v2 - 1.0 / r) * xs[0] - rv * vs[0];
+        let ey = (v2 - 1.0 / r) * xs[1] - rv * vs[1];
+        Some((ex * ex + ey * ey).sqrt())
+    };
+    let c0: Vec<f64> = ids.iter().map(|&sh| jac(&w, sh, 0).unwrap()).collect();
+    let e0: Vec<f64> = ids.iter().map(|&sh| osc_e(&w, sh, 0).unwrap()).collect();
+    let mut worst = vec![0.0f64; ids.len()];
+    let mut worst_e = vec![0.0f64; ids.len()];
+    let mut read_refused = vec![0u32; ids.len()];
+    let mut last_doll = vec![0u16; ids.len()];
+    let mut passes = vec![0u32; ids.len()];
+    let t0 = std::time::Instant::now();
+    let fine: i64 = std::env::var("FINE").ok().map(|v| v.parse().unwrap()).unwrap_or(1);
+    for kk in 1..=(periods * 8 * fine) {
+        let t = (kk as f64 * period / (8.0 * fine as f64)) as i64;
+        w.settle(t);
+        for (i, &sh) in ids.iter().enumerate() {
+            let ts = if std::env::var("SYNC").is_ok() { w.rec(sh).anchor } else { t };
+            if let Some(err) = jac(&w, sh, ts).map(|j| ((j - c0[i]) * meta[i].3).abs()) {
+                worst[i] = worst[i].max(err);
+            } else {
+                read_refused[i] += 1;
+            }
+            if let Some(de) = osc_e(&w, sh, ts).map(|e| (e - e0[i]).abs()) {
+                worst_e[i] = worst_e[i].max(de);
+            }
+            let d = w.rec(sh).b.doll;
+            if d != last_doll[i] {
+                if d == 1 {
+                    passes[i] += 1;
+                }
+                last_doll[i] = d;
+            }
+        }
+    }
+    let steps: Vec<f64> = ids.iter().map(|&sh| w.rec(sh).step as f64).collect();
+    println!("kick step H (ticks) per ship: {:?}", steps.iter().map(|h| format!("{h:.3e}")).collect::<Vec<_>>());
+    println!("kicks/planet-period per ship: {:?}", steps.iter().map(|h| format!("{:.1}", period / h)).collect::<Vec<_>>());
+    println!("captures per ship: {passes:?}");
+    for (i, &sh) in ids.iter().enumerate() {
+        let r = w.rec(sh);
+        if !r.alive {
+            println!("ship {i} is gone: fault {:?}, doll {}, last binding at {}, refusals {}", r.fault, r.b.doll, r.b.event_time, r.refusals);
+        }
+    }
+    println!("read refusals per ship: {read_refused:?}");
+    println!(
+        "step 2^-{step_log2}: worst jacobi {:?} | worst de {:?} | {:.1}s kicks {} handoffs {} lost {}",
+        worst.iter().map(|x| format!("{x:.1e}")).collect::<Vec<_>>(),
+        worst_e.iter().map(|x| format!("{x:.1e}")).collect::<Vec<_>>(),
+        t0.elapsed().as_secs_f64(),
+        w.stats.kicks,
+        w.stats.handoffs,
+        w.stats.lost
+    );
+}
+
+fn gcd(a: usize, b: usize) -> usize {
+    if b == 0 { a } else { gcd(b, a % b) }
+}
