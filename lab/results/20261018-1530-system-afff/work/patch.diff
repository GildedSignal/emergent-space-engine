+/// A print-only census of the player-neighbourhood scan (the system-lens run 20261018-1530): what the walk walks, and what the
+/// answer yields. No canonical state reads or writes; the floats never touch a law outcome.
+pub mod census {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    pub static SCANS: AtomicU64 = AtomicU64::new(0);
+    /// Scans whose radial filter bailed (the walk then reads every body).
+    pub static BAIL: AtomicU64 = AtomicU64::new(0);
+    pub static CAND: AtomicU64 = AtomicU64::new(0);
+    /// Distinct scans whose answer was computed at least once.
+    pub static ANSWERED: AtomicU64 = AtomicU64::new(0);
+    pub static EMPTY: AtomicU64 = AtomicU64::new(0);
+    pub static HITS: AtomicU64 = AtomicU64::new(0);
+    /// The rank histogram of found encounters among the walked candidates: bucket r is "rank r" (r < 16), bucket 16 is "rank > 15".
+    pub static RANK_ALONG: [AtomicU64; 17] = [const { AtomicU64::new(0) }; 17];
+    pub static RANK_NEAR: [AtomicU64; 17] = [const { AtomicU64::new(0) }; 17];
+
+    pub fn bucket(rank: usize) -> usize {
+        rank.min(16)
+    }
+
+    pub fn report() -> String {
+        let (scans, bail, cand, answered, empty, hits) = (
+            SCANS.load(Ordering::Relaxed),
+            BAIL.load(Ordering::Relaxed),
+            CAND.load(Ordering::Relaxed),
+            ANSWERED.load(Ordering::Relaxed),
+            EMPTY.load(Ordering::Relaxed),
+            HITS.load(Ordering::Relaxed),
+        );
+        let hist = |h: &[AtomicU64]| {
+            h.iter().map(|a| a.load(Ordering::Relaxed).to_string()).collect::<Vec<_>>().join(",")
+        };
+        format!(
+            "scan_census: scans={scans} bail={bail} cand_total={cand} cand_mean={:.1} answered={answered} empty={empty} hits={hits} rank_along={} rank_near={}",
+            if scans > 0 { cand as f64 / scans as f64 } else { 0.0 },
+            hist(&RANK_ALONG),
+            hist(&RANK_NEAR)
+        )
+    }
+}
