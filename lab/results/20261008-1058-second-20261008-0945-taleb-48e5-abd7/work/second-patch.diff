+/// Per-doll units (the second-author probe): the whole belt scaled by s (same N, same relative
+/// structure and seed, rho -> s·rho so rho/a is fixed), horizon = h_loc·s^1.5 orbits at a = 1,
+/// i.e. h_loc orbits at the belt's own scale. The per-doll work-per-encounter is
+/// cpe_perloc = cand_per_enc / a^1.5: candidates a body holds per encounter it suffers per *local*
+/// orbit (the mean-motion clock a^1.5 divided out). Scale-free physics + cone test ⇒ flat in s.
+/// `doll <n> <sigma_e> <rho0> <a_lo0> <a_hi0> <h_loc> <samples_per_bin> <e_cap> <gamma> <scales..>`
+fn doll(args: &[String]) {
+    let (n, sigma_e, rho0, a_lo0, a_hi0) = (
+        args[0].parse::<usize>().unwrap(),
+        args[1].parse::<f64>().unwrap(),
+        args[2].parse::<f64>().unwrap(),
+        args[3].parse::<f64>().unwrap(),
+        args[4].parse::<f64>().unwrap(),
+    );
+    let h_loc: f64 = args[5].parse().unwrap();
+    let samples: usize = args[6].parse().unwrap();
+    let cap: f64 = args[7].parse().unwrap();
+    let gamma: f64 = args[8].parse().unwrap();
+    for sc in &args[9..] {
+        let s: f64 = sc.parse().unwrap();
+        let (a_lo, a_hi, rho) = (a_lo0 * s, a_hi0 * s, rho0 * s);
+        let horizon = h_loc * s.powf(1.5);
+        let wall = Instant::now();
+        let b = make_belt_capped(n, sigma_e, a_lo, a_hi, gamma, cap, 20261081);
+        let sorted = Sorted::new(&b, rho);
+        let mut deg = vec![0u32; n];
+        for d in par_chunks(sorted.order.len(), 1024, THREADS, |r| {
+            let mut d = vec![0u32; n];
+            for k in r {
+                let (u, i) = sorted.order[k];
+                let bi = &b[i as usize];
+                let reach = sorted.reach(bi);
+                for &(uj, j) in &sorted.order[k + 1..] {
+                    if uj - u > reach {
+                        break;
+                    }
+                    if is_candidate(bi, &b[j as usize], rho) {
+                        d[i as usize] += 1;
+                        d[j as usize] += 1;
+                    }
+                }
+            }
+            d
+        }) {
+            for (x, y) in deg.iter_mut().zip(d) {
+                *x += y;
+            }
+        }
+        let mut ds = deg.clone();
+        ds.sort_unstable();
+        let q = |p: f64| ds[((n as f64 * p) as usize).min(n - 1)];
+        let deg_mean = ds.iter().sum::<u32>() as f64 / n as f64;
+        let mxi = deg.iter().enumerate().max_by_key(|x| x.1).unwrap().0;
+        let mxe = b.iter().enumerate().max_by(|x, y| x.1.e.total_cmp(&y.1.e)).unwrap().0;
+        // Radial bins (equal count by a), `samples` bodies spread by a-rank per bin: exact
+        // encounter checks over each sampled body's whole candidate set.
+        const NB: usize = 10;
+        let mut by_a: Vec<usize> = (0..n).collect();
+        by_a.sort_by(|&x, &y| b[x].a.total_cmp(&b[y].a));
+        let mut bins = String::new();
+        for k in 0..NB {
+            let r = k * n / NB..(k + 1) * n / NB;
+            let bd = r.clone().map(|x| deg[by_a[x]] as f64).sum::<f64>() / r.len() as f64;
+            let mut st = Stats::default();
+            let mut tmp = Vec::new();
+            let mut asum = 0.0;
+            let mut ns = 0usize;
+            if samples > 0 {
+                for t in 0..samples {
+                    let cand = by_a[r.start + (r.len() * (2 * t + 1)) / (2 * samples)];
+                    if deg[cand] == 0 {
+                        continue;
+                    }
+                    let bi = &b[cand];
+                    asum += bi.a;
+                    ns += 1;
+                    let (lo, hi) = sorted.range(bi.binet()[0], sorted.reach(bi));
+                    for &(_, j) in &sorted.order[lo..hi] {
+                        if j != cand as u32 && is_candidate(bi, &b[j as usize], rho) {
+                            pair_events(bi, &b[j as usize], rho, SAFETY, 0.0, horizon * TAU, &mut st, &mut tmp);
+                        }
+                    }
+                }
+            }
+            let (pairs, hits) = (st.pairs, st.hits_total());
+            let a_eff = if ns > 0 { asum / ns as f64 } else { b[by_a[(r.start + r.end) / 2]].a };
+            let cpe = if hits > 0 { pairs as f64 * horizon / hits as f64 } else { -1.0 };
+            let cpl = if hits > 0 { cpe / a_eff.powf(1.5) } else { -1.0 };
+            bins.push_str(&format!(
+                "{{\"a\":{:.5},\"deg\":{:.1},\"pairs\":{},\"hits\":{},\"cand_per_enc\":{:.4e},\"cpe_perloc\":{:.4e},\"loc_orb\":{:.1}}},",
+                a_eff, bd, pairs, hits, cpe, cpl, horizon / a_eff.powf(1.5)
+            ));
+        }
+        bins.pop();
+        println!(
+            "{{\"exp\":\"doll\",\"s\":{},\"n\":{},\"sigma_e\":{},\"rho\":{},\"e_cap\":{},\"a_range\":[{},{}],\"h_loc\":{},\"horizon\":{:.1},\
+\"deg_mean\":{:.1},\"deg_p99\":{},\"deg_max\":{},\"deg_max_over_mean\":{:.2},\"deg_of_emax\":{},\"f\":{:.4},\"bins\":[{}],\"wall_s\":{:.2}}}",
+            s, n, sigma_e, rho, cap, a_lo, a_hi, h_loc, horizon, deg_mean, q(0.99), deg[mxi],
+            deg[mxi] as f64 / deg_mean, deg[mxe], deg_mean / n as f64, bins, wall.elapsed().as_secs_f64()
+        );
+    }
+}
