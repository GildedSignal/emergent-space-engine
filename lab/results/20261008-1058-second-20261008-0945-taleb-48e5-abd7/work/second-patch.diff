+/// Radial concentration (the Taleb probe): dN/da ∝ a^{-gamma} belts. Per-body candidate degree
+/// (what setup and the steady state pay, per pair) against that body's real encounter rate
+/// (exact pair checks over a horizon), binned by radius; the degree tail (max, p99) against its
+/// mean, and where the max lives. `cusp <n> <sigma_e> <rho> <a_lo> <a_hi> <orbits> <truth 0|1> <gamma..>`
+fn cusp(args: &[String]) {
+    let (n, sigma_e, rho, a_lo, a_hi) = (
+        args[0].parse::<usize>().unwrap(),
+        args[1].parse::<f64>().unwrap(),
+        args[2].parse::<f64>().unwrap(),
+        args[3].parse::<f64>().unwrap(),
+        args[4].parse::<f64>().unwrap(),
+    );
+    let horizon: f64 = args[5].parse().unwrap();
+    let truth: bool = args[6].parse::<u8>().unwrap() != 0;
+    for g in &args[7..] {
+        let gamma: f64 = g.parse().unwrap();
+        let wall = Instant::now();
+        let b = make_cusp(n, sigma_e, a_lo, a_hi, gamma, 20261081);
+        let sorted = Sorted::new(&b, rho);
+        // Per-body candidate degree (both sides) and the scan cost.
+        let mut deg = vec![0u32; n];
+        let mut scanned = 0u64;
+        for (d, s) in par_chunks(sorted.order.len(), 1024, THREADS, |r| {
+            let mut d = vec![0u32; n];
+            let mut s = 0u64;
+            for k in r {
+                let (u, i) = sorted.order[k];
+                let bi = &b[i as usize];
+                let reach = sorted.reach(bi);
+                for &(uj, j) in &sorted.order[k + 1..] {
+                    if uj - u > reach {
+                        break;
+                    }
+                    s += 1;
+                    if is_candidate(bi, &b[j as usize], rho) {
+                        d[i as usize] += 1;
+                        d[j as usize] += 1;
+                    }
+                }
+            }
+            (d, s)
+        }) {
+            scanned += s;
+            for (x, y) in deg.iter_mut().zip(d) {
+                *x += y;
+            }
+        }
+        let mut ds = deg.clone();
+        ds.sort_unstable();
+        let q = |p: f64| ds[((n as f64 * p) as usize).min(n - 1)];
+        let deg_mean = ds.iter().sum::<u32>() as f64 / n as f64;
+        let mxi = deg.iter().enumerate().max_by_key(|x| x.1).unwrap().0;
+        let mxe = b.iter().enumerate().max_by(|x, y| x.1.e.total_cmp(&y.1.e)).unwrap().0;
+        // Radial bins: bodies sorted by a, NBINS equal-count; degree mean and (if asked) one
+        // sampled body's real encounters over its whole candidate set.
+        const NB: usize = 10;
+        let mut by_a: Vec<usize> = (0..n).collect();
+        by_a.sort_by(|&x, &y| b[x].a.total_cmp(&b[y].a));
+        let mut bins = String::new();
+        for k in 0..NB {
+            let r = k * n / NB..(k + 1) * n / NB;
+            let bd = r.clone().map(|x| deg[by_a[x]] as f64).sum::<f64>() / r.len() as f64;
+            let mid = by_a[(r.start + r.end) / 2];
+            let mid2 = by_a[r.start + (r.end - r.start) / 3];
+            let (pairs, hits) = if truth && (deg[mid] > 0 || deg[mid2] > 0) {
+                let mut st = Stats::default();
+                let mut tmp = Vec::new();
+                for cand in [mid, mid2] {
+                    if deg[cand] == 0 {
+                        continue;
+                    }
+                    let bi = &b[cand];
+                    let (lo, hi) = sorted.range(bi.binet()[0], sorted.reach(bi));
+                    for &(_, j) in &sorted.order[lo..hi] {
+                        if j != cand as u32 && is_candidate(bi, &b[j as usize], rho) {
+                            pair_events(bi, &b[j as usize], rho, SAFETY, 0.0, horizon * TAU, &mut st, &mut tmp);
+                        }
+                    }
+                }
+                (st.pairs, st.hits_total())
+            } else {
+                (0, 0)
+            };
+            // candidate pairs per real encounter at this radius (1 / per-pair encounter rate).
+            let cpe = if hits > 0 { pairs as f64 * horizon / hits as f64 } else { -1.0 };
+            bins.push_str(&format!(
+                "{{\"a\":{:.4},\"deg\":{:.1},\"pairs\":{},\"hits\":{},\"cand_per_enc\":{:.3e}}},",
+                b[mid].a, bd, pairs, hits, cpe
+            ));
+        }
+        bins.pop();
+        println!(
+            "{{\"exp\":\"cusp\",\"gamma\":{},\"n\":{},\"sigma_e\":{},\"rho\":{},\"a_range\":[{},{}],\"orbits\":{},\
+\"pairs\":{},\"scanned\":{},\"scanned_per_body\":{:.0},\"deg_mean\":{:.1},\"deg_p50\":{},\"deg_p90\":{},\"deg_p99\":{},\"deg_max\":{},\
+\"deg_max_a\":{:.4},\"deg_max_e\":{:.3},\"deg_max_over_mean\":{:.1},\"deg_of_emax\":{},\"a_of_emax\":{:.4},\"e_of_emax\":{:.3},\"bins\":[{}],\"wall_s\":{:.2}}}",
+            gamma, n, sigma_e, rho, a_lo, a_hi, horizon, deg.iter().sum::<u32>() / 2, scanned,
+            scanned as f64 / n as f64, deg_mean, q(0.5), q(0.9), q(0.99), deg[mxi], b[mxi].a, b[mxi].e,
+            deg[mxi] as f64 / deg_mean, deg[mxe], b[mxe].a, b[mxe].e, bins, wall.elapsed().as_secs_f64()
+        );
+    }
+}
