+/// A radially concentrated belt: dN/da ∝ a^{gamma} on [a_lo, a_hi] (gamma = 0 is `make_belt`;
+/// gamma > 0 concentrates toward a_hi, gamma < 0 toward a_lo — the two edge cases). Same Rayleigh
+/// eccentricities and random angles, so only the radial density profile changes (gamma = -1 is the
+/// logarithmic profile and is not representable).
+pub fn make_cusp(n: usize, sigma_e: f64, a_lo: f64, a_hi: f64, gamma: f64, seed: u64) -> Vec<Body> {
+    make_belt_capped(n, sigma_e, a_lo, a_hi, gamma, 0.5, seed)
+}
+
+/// `make_cusp` with the Rayleigh e-cap exposed (the population model's knob).
+pub fn make_belt_capped(n: usize, sigma_e: f64, a_lo: f64, a_hi: f64, gamma: f64, cap: f64, seed: u64) -> Vec<Body> {
+    let mut rng = Rng(seed);
+    let g1 = gamma + 1.0;
+    let lo = a_lo.powf(g1);
+    let w = a_hi.powf(g1) - lo;
+    (0..n)
+        .map(|_| {
+            let a = (lo + rng.f64() * w).powf(1.0 / g1);
+            let u = rng.f64();
+            let e = (sigma_e * (-2.0 * (1.0 - u).ln()).sqrt()).min(cap);
+            Body::new(a, e, TAU * rng.f64(), TAU * rng.f64())
+        })
+        .collect()
+}
