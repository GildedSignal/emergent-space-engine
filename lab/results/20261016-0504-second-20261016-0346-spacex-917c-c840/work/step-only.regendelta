diff --git a/crates/universe/src/step.rs b/crates/universe/src/step.rs
index ba8c2a9a..21fbe7e4 100644
--- a/crates/universe/src/step.rs
+++ b/crates/universe/src/step.rs
@@ -330,6 +330,20 @@ pub(crate) fn passage_edge(ctx: &Ctx, doll: u16) -> Option<Scalar> {
     (doll != 0).then(|| ctx.dolls[doll as usize].edge.scale(2).ok()).flatten()
 }
 
+/// Whether ES_STAGGER is armed: ship birth kicks are spread over one step (read once).
+fn stagger_on() -> bool {
+    static ON: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var_os("ES_STAGGER").is_some_and(|v| v != "0"));
+    *ON
+}
+/// A uniform 64-bit draw from a body id (splitmix64's finalizer): the stagger's fraction of a step.
+fn stagger_hash(mut x: u64) -> u64 {
+    x = x.wrapping_add(0x9E3779B97F4A7C15);
+    x = (x ^ (x >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);
+    x = (x ^ (x >> 27)).wrapping_mul(0x94D049BB133111EB);
+    x ^ (x >> 31)
+}
+
 struct Work<'a, 'c> {
     ctx: &'a Ctx<'c>,
     i: usize,
@@ -625,7 +639,8 @@ impl Work<'_, '_> {
     /// is planned at the middle of the first step.
     fn plan_clock(&mut self, t: Tick) -> Res<()> {
         let d = self.rec.b.doll;
-        if self.rec.ext.is_none() {
+        let first = self.rec.ext.is_none();
+        if first {
             let st = self.rec.b.readout(t)?;
             let (ds, c, b) = crate::ext::constants(self.ctx, d, t, self.i, self.ctx.cfg.step_log2)?;
             let pt_exp = i16::try_from(2 * st.velocity_exponent as i32 + 64).map_err(|_| Error::Refused("exponent"))?;
@@ -649,7 +664,15 @@ impl Work<'_, '_> {
         self.rec.step = 2 * half;
         // The synchronised state a reader's partial step starts from, until the first kick: this one.
         self.rec.b.kick = Kick { len: 2 * half, level: 0, dv: [0; 2], clock: true, boundary: t, lead: 0 };
-        insert(&mut self.rec.plan, Item { t: t + half, what: What::Kick(0) });
+        // ES_STAGGER (default off): a SHIP's first clock kick is offset by a uniform id-derived fraction of one
+        // step, so a population born at one tick does not kick as one wave (the belt's first-kick wave). Only the
+        // item's time moves; the kick's weight, the step, the readouts and the player are untouched.
+        let off = if first && stagger_on() && self.rec.kind == Kind::Ship {
+            ((stagger_hash(self.i as u64) as u128 * (2 * half) as u128) >> 64) as i64
+        } else {
+            0
+        };
+        insert(&mut self.rec.plan, Item { t: t + half + off, what: What::Kick(0) });
         self.plan_terminal(t)
     }
 
