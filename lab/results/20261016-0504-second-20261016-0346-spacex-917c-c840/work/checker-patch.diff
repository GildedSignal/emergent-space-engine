index 00000000..994caf84
--- /dev/null
+++ b/crates/universe/examples/stagger_probe.rs
@@ -0,0 +1,259 @@
+//! The stagger's legality probe (run 20261016-0504-second-…-spacex-917c-c840): the B13/B14-class
+//! scenes of `xtask behave`'s plane adapter, built through the same public API (copied from
+//! xtask/src/behave/plane.rs `build_scene`), flown to fixed times with the ship's state printed at
+//! full precision (hex bits), so ES_STAGGER=1 vs unset can be diffed exactly.
+//! Modes: `flyby` (8 assists over the gate's parameter ranges) and `moon` (8 Hill births,
+//! 0.2-0.9 R_H, e0 <= 0.3, pro/retro; prints the planetocentric apsidal series' rate, hill.rs's
+//! estimator verbatim, plus the escape class at 1.5 R_H). Scene = JUPITER (mu 1e-3, sep 5.27e8).
+use emergent_space::orbit::Scalar;
+use emergent_universe::num::{from_f64, to_f64};
+use emergent_universe::observe;
+use emergent_universe::scenario::{AU, STAR_RADIUS};
+use emergent_universe::world::Mass;
+use emergent_universe::{Config, Kind, OrbitSpec, Universe};
+use std::f64::consts::TAU;
+
+const MU: f64 = 1e-3;
+const SEP: f64 = 5.27e8;
+const PLANET_RADIUS: f64 = 4.84e4;
+const STEP_LOG2: i32 = 7;
+
+fn period() -> f64 {
+    TAU * SEP.powf(1.5) // Ω⁻¹ = 2π·sep^{3/2} with G = M_total = 1
+}
+fn omega() -> f64 {
+    SEP.powf(-1.5)
+}
+/// Barycentric judge-units positions at t (restricted.rs's scene: ccw from (sep(1−μ), 0)).
+fn planet(t: f64) -> [f64; 2] {
+    let (s, c) = (omega() * t).sin_cos();
+    [SEP * (1.0 - MU) * c, SEP * (1.0 - MU) * s]
+}
+fn star(t: f64) -> [f64; 2] {
+    let (s, c) = (omega() * t).sin_cos();
+    [-SEP * MU * c, -SEP * MU * s]
+}
+fn star_vel(t: f64) -> [f64; 2] {
+    let (s, c) = (omega() * t).sin_cos();
+    [-SEP * MU * omega() * s, SEP * MU * omega() * c]
+}
+fn soi() -> f64 {
+    SEP * (MU / 3.0).powf(1.0 / 3.0)
+}
+fn hill() -> f64 {
+    soi()
+}
+
+/// plane.rs's build_scene, verbatim in substance: star, planet on a circle, ship bare at doll 0.
+fn build_scene(ship: [f64; 4]) -> Option<(Universe, usize)> {
+    let to_root = 1.0 / (1.0 - MU);
+    let mass = Mass::of(from_f64(MU / (1.0 - MU))).ok()?;
+    let cfg = Config { step_log2: STEP_LOG2, ..Config::default() };
+    let mut u = Universe::new(from_f64(STAR_RADIUS as f64 * (SEP * to_root / AU as f64).min(1.0)), cfg);
+    u.threads = 1;
+    let planet_id = u
+        .add_body(
+            Kind::Planet,
+            OrbitSpec { doll: 0, periapsis: from_f64(SEP * to_root), e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+            Scalar::ZERO,
+        )
+        .ok()?;
+    let surface = from_f64(PLANET_RADIUS * to_root).scale(-mass.octave).ok()?;
+    u.add_doll("planet", planet_id, mass, surface).ok()?;
+    let (sp, sv) = (star(0.0), star_vel(0.0));
+    let id = u
+        .add_body_state(
+            Kind::Ship,
+            0,
+            [from_f64((ship[0] - sp[0]) * to_root), from_f64((ship[1] - sp[1]) * to_root)],
+            [from_f64(ship[2] - sv[0]), from_f64(ship[3] - sv[1])],
+            Scalar::ZERO,
+        )
+        .ok()?;
+    u.start().ok()?;
+    Some((u, id))
+}
+
+fn hex(s: &[f64]) -> String {
+    s.iter().map(|x| format!("{:016x}", x.to_bits())).collect::<Vec<_>>().join(" ")
+}
+
+/// The ship's barycentric judge-units state at tick (plane.rs's readback, verbatim in substance).
+fn state_at(u: &mut Universe, id: usize, t: f64) -> Option<[f64; 4]> {
+    let to_root = 1.0 / (1.0 - MU);
+    let tick = (t * to_root).round() as i64;
+    u.settle(tick);
+    if !u.bodies().alive(id) {
+        return None;
+    }
+    let (pos, vel) = observe::root_state(&u.ctx(), id, tick).ok()?;
+    let (sp, sv) = (star(t), star_vel(t));
+    Some([pos[0] / to_root + sp[0], pos[1] / to_root + sp[1], vel[0] + sv[0], vel[1] + sv[1]])
+}
+
+/// The planet's barycentric velocity at t.
+fn planet_vel(t: f64) -> [f64; 2] {
+    let (s, c) = (omega() * t).sin_cos();
+    [-SEP * (1.0 - MU) * omega() * s, SEP * (1.0 - MU) * omega() * c]
+}
+
+/// assist.rs's flyby start (q planet radii, v_inf, psi), verbatim in substance: planetocentric
+/// hyperbola at 1.5 R_SOI, made barycentric with the planet's own position and velocity.
+fn flyby_start(q: f64, v_inf: f64, psi: f64) -> [f64; 4] {
+    let (mu, q) = (MU, q * PLANET_RADIUS);
+    let e = 1.0 + q * v_inf * v_inf / mu;
+    let p = q * (1.0 + e);
+    let r = 1.5 * soi();
+    let nu = -((p / r - 1.0) / e).acos();
+    let angle = psi + (-1.0 / e).acos() + nu;
+    let h = (mu * p).sqrt();
+    let (radial, along) = (mu / h * e * nu.sin(), h / r);
+    let (s, c) = angle.sin_cos();
+    let (pp, pv) = (planet(0.0), planet_vel(0.0));
+    [
+        pp[0] + r * c,
+        pp[1] + r * s,
+        pv[0] + radial * c - along * s,
+        pv[1] + radial * s + along * c,
+    ]
+}
+
+/// hill.rs's moon birth, verbatim in substance: a in metres-of-sep units (caller passes a/HILL).
+fn moon_start(a_over_hill: f64, phase: f64, e0: f64, prograde: bool) -> [f64; 4] {
+    let a = a_over_hill * hill();
+    let (s, c) = phase.sin_cos();
+    let (r, v) = (
+        a * (1.0 - e0),
+        (MU * (1.0 + e0) / (a * (1.0 - e0))).sqrt() * if prograde { 1.0 } else { -1.0 },
+    );
+    let (pp, pv) = (planet(0.0), planet_vel(0.0));
+    [pp[0] + r * c, pp[1] + r * s, pv[0] - v * s, pv[1] + v * c]
+}
+
+/// hill.rs's apsidal-rate estimator on the planetocentric series, verbatim in substance.
+fn apsidal_rate(times: &[f64], states: &[[f64; 4]]) -> Option<(f64, f64)> {
+    let mut varpi: Vec<f64> = Vec::new();
+    for (&t, s) in times.iter().zip(states) {
+        let p = planet(t);
+        let w = [s[0] - p[0], s[1] - p[1], s[2], s[3]];
+        let (r2, v2, rv) = (w[0] * w[0] + w[1] * w[1], w[2] * w[2] + w[3] * w[3], w[0] * w[2] + w[1] * w[3]);
+        let k = v2 - MU / r2.sqrt();
+        let (ex, ey) = (k * w[0] - rv * w[2], k * w[1] - rv * w[3]);
+        if !(ex.hypot(ey) > 1e-9 * MU) {
+            return None;
+        }
+        let ang = ey.atan2(ex);
+        let Some(&last) = varpi.last() else {
+            varpi.push(ang);
+            continue;
+        };
+        let mut jump = (ang - last) % TAU;
+        if jump > std::f64::consts::PI {
+            jump -= TAU;
+        } else if jump < -std::f64::consts::PI {
+            jump += TAU;
+        }
+        if jump.abs() > std::f64::consts::FRAC_PI_2 {
+            return None;
+        }
+        varpi.push(last + jump);
+    }
+    let u: Vec<f64> = times.iter().map(|&t| t / period()).collect();
+    let n = u.len() as f64;
+    let (mu_, mv) = (u.iter().sum::<f64>() / n, varpi.iter().sum::<f64>() / n);
+    let (num, den) = (
+        u.iter().zip(&varpi).map(|(a, b)| (a - mu_) * (b - mv)).sum::<f64>(),
+        u.iter().map(|a| (a - mu_) * (a - mu_)).sum::<f64>(),
+    );
+    Some((num / den, varpi.last().copied()? - varpi[0]))
+}
+
+/// A tiny deterministic LCG (the probe's own draws; the gate's stream is its own).
+fn lcg(seed: u64) -> impl FnMut() -> f64 {
+    let mut s = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+    move || {
+        s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        ((s >> 11) as f64 / (1u64 << 53) as f64)
+    }
+}
+
+fn main() {
+    let mode = std::env::args().nth(1).unwrap_or_else(|| "flyby".into());
+    let armed = std::env::var_os("ES_STAGGER").is_some_and(|v| v != "0");
+    println!("probe mode={mode} stagger={armed} step_log2={STEP_LOG2} mu={MU} sep={SEP} P={}", period());
+    match mode.as_str() {
+        "flyby" => {
+            let mut rng = lcg(0x5EED_0001);
+            for i in 0..8 {
+                let q = 1.2 * (50.0f64 / 1.2).powf(rng());
+                let v_inf = 1.67e-5 + (6.7e-5 - 1.67e-5) * rng();
+                let psi = TAU * rng();
+                let ship = flyby_start(q, v_inf, psi);
+                let Some((mut u, id)) = build_scene(ship) else {
+                    println!("flyby {i} q={q:.2}r v_inf={v_inf:.3e} psi={psi:.3} BUILD-REFUSED");
+                    continue;
+                };
+                let st0 = state_at(&mut u, id, 0.0).unwrap();
+                print!("flyby {i} q={q:.2}r v_inf={v_inf:.3e} psi={psi:.3} start {}", hex(&st0));
+                for frac in [0.2f64, 0.4, 0.6, 0.8, 1.0] {
+                    let t = frac * period();
+                    match state_at(&mut u, id, t) {
+                        Some(s) => {
+                            // heliocentric E and L (assist.rs's formulas)
+                            let (sp, sv) = (star(t), star_vel(t));
+                            let (rx, ry) = (s[0] - sp[0], s[1] - sp[1]);
+                            let (vx, vy) = (s[2] - sv[0], s[3] - sv[1]);
+                            let e_h = (vx * vx + vy * vy) / 2.0 - (1.0 - MU) / (rx * rx + ry * ry).sqrt();
+                            let l_h = rx * vy - ry * vx;
+                            print!(" t{frac:.1} {} E={:016x} L={:016x}", hex(&s), e_h.to_bits(), l_h.to_bits());
+                        }
+                        None => print!(" t{frac:.1} LOST"),
+                    }
+                }
+                println!();
+            }
+        }
+        "moon" => {
+            let mut rng = lcg(0x5EED_0002);
+            for i in 0..8 {
+                let a_h = 0.2 + 0.7 * rng();
+                let e0 = [0.0f64, 0.15, 0.3][i % 3];
+                let pro = i % 2 == 0;
+                let phase = TAU * rng();
+                let ship = moon_start(a_h, phase, e0, pro);
+                let Some((mut u, id)) = build_scene(ship) else {
+                    println!("moon {i} a={a_h:.3}H e0={e0} pro={pro} BUILD-REFUSED");
+                    continue;
+                };
+                let n_per = 10; // planet periods (the frozen gate flies 50; the plane times out there)
+                let samples: Vec<f64> = (1..=n_per * 64).map(|j| j as f64 * period() / 64.0).collect();
+                let mut states = Vec::with_capacity(samples.len());
+                let mut lost = false;
+                for &t in &samples {
+                    match state_at(&mut u, id, t) {
+                        Some(s) => states.push(s),
+                        None => {
+                            lost = true;
+                            break;
+                        }
+                    }
+                }
+                let escaped = samples.iter().zip(&states).any(|(&t, s)| {
+                    let p = planet(t);
+                    ((s[0] - p[0]).hypot(s[1] - p[1])) > 1.5 * hill()
+                });
+                for (j, (&t, s)) in samples.iter().zip(&states).enumerate() {
+                    println!("raw {i} {j} {t:.6e} {}", hex(s));
+                }
+                match (lost, apsidal_rate(&samples[..states.len()], &states)) {
+                    (false, Some((rate, adv))) => println!(
+                        "moon {i} a={a_h:.3}H e0={e0:.2} pro={pro} phase={phase:.3} n={} escaped={escaped} rate={:.9e} rad/P advance={:.6} end {}",
+                        states.len(), rate, adv, hex(&states[states.len() - 1])
+                    ),
+                    _ => println!("moon {i} a={a_h:.3}H e0={e0:.2} pro={pro} phase={phase:.3} lost={lost} states={} escaped={escaped}", states.len()),
+                }
+            }
+        }
+        _ => eprintln!("modes: flyby | moon"),
+    }
+}
