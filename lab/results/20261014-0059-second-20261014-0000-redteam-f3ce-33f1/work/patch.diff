+fn owed_shift(law: Law, m: i64, t: Target, owed_e: i128, q: i64) -> [i64; 2] {
+    let den = t.1;
+    let q2 = q as i128 * q as i128;
+    let inside = |c: [i128; 2]| c[0] * c[0] + c[1] * c[1] < q2 / 100 * 99;
+    let base = [t.0[0].div_euclid(den), t.0[1].div_euclid(den)];
+    let step = [t.0[0].signum(), t.0[1].signum()];
+    if step == [0, 0] {
+        return [0, 0];
+    }
+    let pt = |c: [i128; 2]| momentum(law, m, [c[0] as i64, c[1] as i64], q);
+    if !inside(base) {
+        return [0, 0];
+    }
+    let shifted = [base[0] + step[0], base[1] + step[1]];
+    if !inside(shifted) {
+        return [0, 0];
+    }
+    let de = (pt(shifted)[0] - pt(base)[0]).abs();
+    if de == 0 {
+        return [0, 0];
+    }
+    let mut n = owed_e.abs() / de;
+    let sign = -(owed_e.signum());
+    loop {
