+        }
+        let dk = [sign * n * step[0], sign * n * step[1]];
+        let shifted_target = [t.0[0] - dk[0] * den, t.0[1] - dk[1] * den];
+        if inside(shifted_target) {
+            return [dk[0] as i64, dk[1] as i64];
+        }
+        n /= 2;
+    }
