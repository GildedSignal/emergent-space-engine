+/// H_live probe: histogram of the quanta each kick emits, per velocity component, in buckets
+static EMITTED: [std::sync::atomic::AtomicU64; 40] = [const { std::sync::atomic::AtomicU64::new(0) }; 40];
+
+fn dvq_bucket(q: i64) -> usize {
+    if q == 0 {
+        0
+    } else {
+        let mag = (q.unsigned_abs().min(256) - 1).next_power_of_two().trailing_zeros() as usize; // 0..=8, 8 also for ≥256
+        let sign = usize::from(q < 0);
+        1 + 2 * mag + sign
+    }
+}
+
+/// The emitted-quanta histogram since process start, per component (c0, c1): bucket 0 is zero,
+/// 1+2k+`s` is `s`-signed magnitude `2^k` (k < 8), and magnitude ≥ 2^8 shares k = 8.
+pub fn emitted_quanta() -> [u64; 18] {
+    let mut out = [0u64; 18];
+    for c in 0..2 {
+        for b in 0..18 {
+            out[b] += EMITTED[20 * c + b].load(Ordering::Relaxed);
+        }
+    }
+    out
+}
