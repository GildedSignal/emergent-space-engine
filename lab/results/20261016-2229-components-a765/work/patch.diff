+/// The floor prototype of [`fit_key`]: the same closed-form prefix, barrier refusal and
+/// key tail, with the turning root from 8 Newton steps on the critical-region seed (the
+/// seed `root_witness` uses) instead of the 128-step bisection plus witness. Disagreement
+/// with `fit_key` can only come from the root's ulp-level rounding moving the 48-bit key
+/// word (lab run 20261016-2229-components-a765).
+fn fit_key_proto(state: IntegerState) -> Result<(OrbitKey, Scalar, bool, bool)> {
+    let (p, v) = state.components()?;
+    let r = norm(p)?;
+    let u = r.reciprocal()?;
+    let lapse = Scalar::ONE.sub(u.scale(1)?)?;
+    if !lapse.is_positive() {
+        return Err(Error::NoBoundOrbit);
+    }
+    let vr = dot(p, v)?.div(r)?;
+    let vt = p[0].mul(v[1])?.sub(p[1].mul(v[0])?)?.div(r)?;
+    if crate::inverse::circular(state) {
+        return Ok((OrbitKey::new(r, 1 << 48)?, r, vt < Scalar::ZERO, false));
+    }
+    let kinetic = vr.mul(vr)?.div(lapse)?.add(vt.mul(vt)?)?;
+    let den = lapse.sub(kinetic)?;
+    if !den.is_positive() || vt.is_zero() {
+        return Err(Error::NoBoundOrbit);
+    }
+    let angular = r.mul(vt)?;
+    let l2 = angular.mul(angular)?.div(den)?;
+    let q = l2.reciprocal()?;
+    let alpha = kinetic.sub(u.scale(1)?.mul(lapse)?)?.div(den)?.mul(l2)?;
+    if alpha.abs() < Scalar::power_of_two(-48) {
+        return crate::inverse::fit(state).map(|k| (k, r, vt < Scalar::ZERO, vr < Scalar::ZERO));
+    }
+    let disc = Scalar::ONE.sub(q.mul(Scalar::integer(12))?)?;
+    if !disc.is_positive() {
+        return Err(Error::NoBoundOrbit);
+    }
+    let root = disc.sqrt()?;
+    let uc = Scalar::integer(2).div(Scalar::ONE.add(root)?)?;
+    let minimum = Scalar::ONE.add(root)?.div(q.mul(Scalar::integer(6))?)?;
+    let poly = |z: Scalar| -> Result<Scalar> { alpha.add(z.scale(1)?)?.sub(z.mul(z)?)?.add(q.scale(1)?.mul(z.mul(z)?.mul(z)?)?) };
+    let slope = |z: Scalar| -> Result<Scalar> { Scalar::integer(2).sub(z.scale(1)?)?.add(q.mul(Scalar::integer(6))?.mul(z.mul(z)?)?) };
+    let inverse = minimum.reciprocal()?;
+    let barrier = alpha
+        .mul(inverse)?
+        .mul(inverse)?
+        .add(inverse.scale(1)?)?
+        .sub(Scalar::ONE)?
+        .add(q.scale(1)?.mul(minimum)?)?;
+    if q > Scalar::power_of_two(-10) && barrier.abs() < Scalar::power_of_two(-24) {
+        return crate::inverse::fit(state).map(|k| (k, r, vt < Scalar::ZERO, vr < Scalar::ZERO));
+    }
+    if barrier.is_positive() {
+        return Err(Error::NoBoundOrbit);
+    }
+    let at_c = poly(uc)?;
+    let zp = if at_c <= Scalar::ZERO {
+        if at_c.abs() > Scalar::power_of_two(-56) {
+            return Err(Error::NoBoundOrbit);
+        }
+        uc
+    } else {
+        // Concave cubic on [uc, minimum]: the tangent at a point left of the root crosses
+        // zero left of the root, so Newton from the critical-region seed rises monotonically.
+        let lo = uc;
+        let curvature = Scalar::ONE.sub(q.mul(Scalar::integer(6))?.mul(lo)?)?;
+        let mut z = if curvature.is_positive() {
+            let seed = lo.add(poly(lo)?.div(curvature)?.sqrt()?)?;
+            if seed > lo && seed < minimum { seed } else { lo.add(minimum)?.scale(-1)? }
+        } else {
+            lo.add(minimum)?.scale(-1)?
+        };
+        for _ in 0..8 {
+            let d = slope(z)?;
+            if d.is_zero() {
+                break;
+            }
+            let next = z.sub(poly(z)?.div(d)?)?;
+            if next <= lo || next >= minimum || next == z {
+                break;
+            }
+            z = next;
+        }
+        z
+    };
+    let rp = l2.div(zp)?;
+    let compact = rp.reciprocal()?;
+    let d = zp.reciprocal()?;
+    let b = Scalar::ONE.add(compact.scale(1)?)?;
+    let discriminant = b.mul(b)?.sub(compact.mul(Scalar::integer(16))?.mul(compact.add(d)?)?)?;
+    let k = compact.add(d)?.scale(1)?.div(b.add(discriminant.sqrt()?)?)?;
+    let word = u64::try_from(k.fixed(48)?).map_err(|_| Error::Range)?.min(1 << 48);
+    if k >= Scalar::power_of_two(-28) && k.sub(Scalar::raw(word as i128, -48)?)?.abs() > k.scale(-20)? {
+        return Err(Error::Range);
+    }
+    let scaled = k < Scalar::power_of_two(-28);
+    let full_k = k;
+    let mut k = word;
+    if alpha.is_zero() {
+        k = 1 << 47;
+    } else if alpha.is_positive() {
+        k = k.min((1 << 47) - 1);
+    } else {
+        k = k.max((1 << 47) + 1);
+    }
+    let key = if scaled { OrbitKey::scaled(rp, full_k)? } else { OrbitKey::new(rp, k)? };
+    if alpha.is_positive() && key.needs_gap()? {
+        let (q, k) = (key.compactness()?, key.shape()?);
+        let one_minus_2q = Scalar::ONE.sub(q.scale(1)?)?;
+        let tn = k.mul(one_minus_2q)?.mul(Scalar::ONE.add(q.scale(1)?.mul(Scalar::ONE.sub(k.scale(1)?)?)?)?)?;
+        let gap = tn.mul(den)?.div(lapse.mul(lapse)?)?;
+        return Ok((key.with_gap(gap)?, r, vt < Scalar::ZERO, vr < Scalar::ZERO));
+    }
+    Ok((key, r, vt < Scalar::ZERO, vr < Scalar::ZERO))
+}
+
+/// Floor-audit instrument (lab run 20261016-2229-components-a765): stage timings of the
+/// rebind on real kick states, plus the prototype's key agreement and the exact-vs-law-
+/// quantum key census. Enabled by ES_FLOOR_AUDIT=1; zero cost otherwise.
+pub mod floor_audit {
+    use std::cell::RefCell;
+    use std::collections::HashSet;
+    use std::time::Instant;
+
+    #[derive(Default)]
+    struct Acc {
+        ns: [u64; 8],
+        calls: u64,
+        errs: u64,
+        agree: u64,
+        disagree: u64,
+        agree_quant: u64,
+        disagree_quant: u64,
+        proto_err: u64,
+        circular: u64,
+        exact: u64,
+        passage: u64,
+        keys_exact: HashSet<(i64, i16, u64, i16, u8)>,
+        keys_quant: HashSet<(i64, i16, u64, i16)>,
+    }
+    thread_local! {
+        static ACC: RefCell<Acc> = RefCell::new(Acc::default());
+    }
+    fn enabled() -> bool {
+        static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("ES_FLOOR_AUDIT").is_some())
+    }
+    pub fn on() -> bool {
+        enabled()
+    }
+    pub fn stage(i: usize, t: Instant) {
+        if enabled() {
+            ACC.with(|a| a.borrow_mut().ns[i] += t.elapsed().as_nanos() as u64);
+        }
+    }
+    pub fn circular() {
+        if enabled() {
+            ACC.with(|a| a.borrow_mut().circular += 1);
+        }
+    }
+    pub fn exact() {
+        if enabled() {
+            ACC.with(|a| a.borrow_mut().exact += 1);
+        }
+    }
+    pub fn note_err() {
+        if enabled() {
+            ACC.with(|a| a.borrow_mut().errs += 1);
+        }
+    }
+    /// One rebind: the shipped key, the prototype's outcome on the same state, the
+    /// prototype's nanoseconds. The quantum census drops 20 bits of the periapsis
+    /// significand and 24 of the key mantissa: the law's own 2^-20 relative tolerance.
+    pub fn note(periodic: bool, proto: &crate::Result<(super::OrbitKey, super::Scalar, bool, bool)>, key: &super::OrbitKey, proto_ns: u64) {
+        if !enabled() {
+            return;
+        }
+        ACC.with(|a| {
+            let mut a = a.borrow_mut();
+            a.calls += 1;
+            a.passage += u64::from(!periodic);
+            a.ns[5] += proto_ns;
+            a.keys_exact.insert((
+                key.periapsis.significand(),
+                key.periapsis.exponent(),
+                key.k,
+                key.k_exponent,
+                u8::from(key.gap.is_some()),
+            ));
+            a.keys_quant.insert((
+                key.periapsis.significand() >> 20,
+                key.periapsis.exponent(),
+                key.k >> 24,
+                key.k_exponent,
+            ));
+            let quant = |k: &super::OrbitKey| (
+                k.periapsis.significand() >> 20,
+                k.periapsis.exponent(),
+                k.k >> 24,
+                k.k_exponent,
+            );
+            match proto {
+                Ok((pk, _, _, _)) if pk == key => a.agree += 1,
+                Ok((pk, _, _, _)) => {
+                    a.disagree += 1;
+                    if quant(pk) == quant(key) {
+                        a.agree_quant += 1;
+                    } else {
+                        a.disagree_quant += 1;
+                    }
+                }
+                Err(_) => a.proto_err += 1,
+            }
+        });
+    }
+    pub fn json() -> String {
+        ACC.with(|a| {
+            let a = a.borrow();
+            format!(
+                "{{\"calls\": {}, \"fit_errors\": {}, \"proto_errors\": {}, \"agree\": {}, \"disagree\": {}, \"circular\": {}, \"exact_path\": {}, \"passages\": {}, \"distinct_exact_keys\": {}, \"distinct_quantized_keys\": {}, \"agree_quantum\": {}, \"disagree_quantum\": {}, \"ns_fit_key\": {}, \"ns_compile\": {}, \"ns_phase_residual\": {}, \"ns_proto\": {}}}",
+                a.calls, a.errs, a.proto_err, a.agree, a.disagree, a.circular, a.exact, a.passage,
+                a.keys_exact.len(), a.keys_quant.len(),
+                a.agree_quant, a.disagree_quant,
+                a.ns[0], a.ns[1], a.ns[2], a.ns[5]
+            )
+        })
+    }
+}
