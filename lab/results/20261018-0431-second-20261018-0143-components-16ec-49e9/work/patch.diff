+// ---- the boundary's key-range fast path (lab/results/20261018-0143-components-16ec) ------------------
+//
+// A clock body's boundary tests two certificates against the readout's radius: the doll's surface and
+// the system's leave radius. Between events the body rides one compiled tube, and a bound cycle's
+// radius never leaves [periapsis, apoapsis] (x = k + (1-k)·cos psi spans exactly [2k-1, 1]), so when
+// that range, widened by everything the readout adds on top of the tube (component rounding, the
+// turn's shear slack, the carried residual), sits strictly inside (surface, leave), no readout at any
+// tick can fire a certificate: the walk is deleted, never skipped around — the anchor write and the
+// event's tick are unchanged, so the digest cannot move unless the bound itself is wrong.
+
+/// Whether the fast path decides boundaries (an adoption dial; the census is print-only).
+pub static RANGE_FAST: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Print-only census of the clock path's boundaries (zero when nothing reads them).
+#[derive(Default)]
+pub struct BoundCensus {
+    pub total: std::sync::atomic::AtomicU64,
+    pub fast: std::sync::atomic::AtomicU64,
+    /// A cycle whose range straddled a certificate radius (or whose range failed to compute).
+    pub slow_cycle: std::sync::atomic::AtomicU64,
+    /// A passage or plunge: no finite range, the readout always runs.
+    pub passage: std::sync::atomic::AtomicU64,
+    pub ns_slow: std::sync::atomic::AtomicU64,
+    pub ns_fast: std::sync::atomic::AtomicU64,
+    /// Boundaries whose shipped path killed the body.
+    pub deaths: std::sync::atomic::AtomicU64,
+}
+pub static BOUND_CENSUS: BoundCensus = BoundCensus {
+    total: std::sync::atomic::AtomicU64::new(0),
+    fast: std::sync::atomic::AtomicU64::new(0),
+    slow_cycle: std::sync::atomic::AtomicU64::new(0),
+    passage: std::sync::atomic::AtomicU64::new(0),
+    ns_slow: std::sync::atomic::AtomicU64::new(0),
+    ns_fast: std::sync::atomic::AtomicU64::new(0),
+    deaths: std::sync::atomic::AtomicU64::new(0),
+};
+
+impl BoundCensus {
+    fn add(f: &std::sync::atomic::AtomicU64) -> u64 {
+        f.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
+    }
+}
+
+/// The tube's exact radial range in the doll's units, widened by everything the readout adds to the
+/// tube: component rounding at the position quantum, the turn's shear (within two quanta of the
+/// rotation it stands for) and the carried residual (in position quanta). A bound cycle's radius
+/// never leaves it, at any tick. `None` when the trajectory has no finite range (a passage compiles
+/// out to an edge, a plunge ends at the surface) or the key is not a plain bound cycle.
+pub fn safe_range(b: &Binding) -> Option<(Scalar, Scalar)> {
+    let Trajectory::Cycle(c) = &b.entry.trajectory else { return None };
+    let key = c.key();
+    if !key.periodic() {
+        return None;
+    }
+    // The outer turning point in the tube's units: radius = periapsis/(2k-1) (the same
+    // expression `word_for` uses to size the integer word).
+    let outer = key.shape().ok()?.scale(1).ok()?.sub(Scalar::ONE).ok()?;
+    if !outer.is_positive() {
+        return None;
+    }
+    let hi = b.to_doll(key.periapsis.div(outer).ok()?).ok()?;
+    let lo = b.to_doll(key.periapsis).ok()?;
+    // Slack, in the doll's units: |res| component sums (an upper bound of its norm) plus four
+    // position quanta for rounding and the turn.
+    let res = b.residual.position;
+    let quanta = res[0].abs() + res[1].abs() + 4;
+    let slack = Scalar::raw(quanta, b.units.0 as i32).ok()?;
+    Some((lo.sub(slack).ok()?, hi.add(slack).ok()?))
+}
