+//! The exactness probe for the boundary's key-range fast path (lab/results/20261018-0143-components-16ec).
+//!
+//! Builds bindings the way the engine does — an exact doll-unit state off a compiled cycle (the same
+//! `cartesian`-after-`to_doll` readout `decode` uses), optionally perturbed so the fit carries a
+//! residual — then sweeps the readout over whole cycles and asserts the invariant the fast path stands
+//! on: the readout's radius never leaves the widened [periapsis, apoapsis] range, at any tick,
+//! residual included. Non-cycle tubes must be refused (no finite range).
+//!
+use emergent_space::binding::{cartesian, Trajectory};
+use emergent_space::orbit::{Orbit, OrbitKey, Scalar};
+use emergent_universe::bind::{bind, bind_exact, choose_units, scalars};
+use emergent_universe::num::{norm2, Tick};
+use emergent_universe::step::safe_range;
+use emergent_universe::world::Unit;
+
+fn as_f(s: Scalar) -> f64 {
+    s.significand() as f64 * 2f64.powi(s.exponent() as i32 - 62)
+}
+
+fn main() {
+    let mut cases = 0usize;
+    let mut cycles = 0usize;
+    let mut noncycles = 0usize;
+    let mut held = 0usize;
+    let mut worst = (0.0f64, String::new());
+    for p_exp in [4i16, 8, 12, 16, 20] {
+        for e48 in [0u64, 1 << 44, 1 << 47, (0.9 * (1u64 << 48) as f64) as u64, (0.99 * (1u64 << 48) as f64) as u64] {
+            let key = OrbitKey::bound(Scalar::power_of_two(p_exp), e48).unwrap();
+            let Ok(orbit) = Orbit::compile(key) else { continue };
+            let period_m = orbit.period().unwrap();
+            let k = key.shape().unwrap();
+            let apo_m = key.periapsis.div(k.scale(1).unwrap().sub(Scalar::ONE).unwrap()).unwrap();
+            for mu_pow in [10i16, 20] {
+                for mu in [Scalar::power_of_two(mu_pow), Scalar::raw(3, mu_pow as i32 - 1).unwrap()] {
+                    let unit = Unit::of(mu).unwrap();
+                    let period = unit.to_doll(period_m).unwrap();
+                    let apo = unit.to_doll(apo_m).unwrap();
+                    for phase in 0..4u64 {
+                        let t0: Tick = 1 << 20;
+                        let mut st = orbit.state(period_m.scale(-(2 + phase as i32)).unwrap()).unwrap();
+                        st.radius = unit.to_doll(st.radius).unwrap();
+                        let vmax = st.radial_velocity.abs().max(st.transverse_velocity.abs()).scale(2).unwrap();
+                        let units = choose_units(apo, vmax);
+                        let exact = cartesian(st, (phase as u32) * 0x40000000, phase % 2 == 0, units).unwrap();
+                        for perturb in [0i64, 255, 1 << 20] {
+                            let mut ex = exact;
+                            for c in &mut ex.velocity {
+                                *c = c.saturating_add(perturb);
+                            }
+                            for c in &mut ex.position {
+                                *c = c.saturating_add(perturb / 64);
+                            }
+                            let Ok(bound) = bind(ex, t0, 0, None, unit) else { continue };
+                            let binding = bind_exact(bound.entry.clone(), bound.tube, 0, bound.units, t0, 0);
+                            cases += 1;
+                            let range = safe_range(&binding);
+                            if !matches!(&bound.entry.trajectory, Trajectory::Cycle(_)) {
+                                noncycles += 1;
+                                assert!(range.is_none(), "a non-cycle must have no range");
+                                continue;
+                            }
+                            cycles += 1;
+                            let Some((lo, hi)) = range else { held += 1; continue };
+                            // Three cycles densely, plus both turning-point families.
+                            let mut ts: Vec<i64> = Vec::new();
+                            for j in 0..96i128 {
+                                let dt = period.mul(Scalar::integer(j as i64)).unwrap().div(Scalar::integer(32)).unwrap();
+                                ts.push(t0 + dt.fixed(0).unwrap() as i64);
+                            }
+                            for j in 0..7i128 {
+                                let dt = period.mul(Scalar::integer(j as i64)).unwrap().div(Scalar::integer(2)).unwrap();
+                                ts.push(t0 + dt.fixed(0).unwrap() as i64);
+                            }
+                            for t in ts {
+                                let (x, _) = scalars(&binding.readout(t).unwrap()).unwrap();
+                                let r = norm2(x).unwrap();
+                                let viol = lo.sub(r).unwrap().max(r.sub(hi).unwrap());
+                                let v = as_f(viol) / as_f(r);
+                                if v > worst.0 {
+                                    worst = (v, format!("p2^{p_exp} e{e48} mu2^{mu_pow}{} phase{phase} pert{perturb} dt{:e}", if mu == Scalar::power_of_two(mu_pow) { "" } else { "x1.5" }, as_f(period) * ((t - t0) as f64 / as_f(period))));
+                                }
+                                assert!(r >= lo && r <= hi, "range violated: r={:?} outside [{lo:?}, {hi:?}] (p2^{p_exp} e{e48} pert{perturb})", as_f(r));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // The refusal control: unbound states must compile to passages and never claim a range.
+    for p_exp in [8i16, 16] {
+        let key = OrbitKey::bound(Scalar::power_of_two(p_exp), 1 << 44).unwrap();
+        let orbit = Orbit::compile(key).unwrap();
+        let period_m = orbit.period().unwrap();
+        for mu in [Scalar::power_of_two(10i16), Scalar::raw(3, 9).unwrap()] {
+            let unit = Unit::of(mu).unwrap();
+            let mut st = orbit.state(period_m.scale(-3).unwrap()).unwrap();
+            st.radius = unit.to_doll(st.radius).unwrap();
+            st.transverse_velocity = st.transverse_velocity.scale(1).unwrap();
+            let vmax = st.transverse_velocity.scale(2).unwrap();
+            let units = choose_units(st.radius.scale(4).unwrap(), vmax);
+            let mut ex = cartesian(st, 0, false, units).unwrap();
+            for c in &mut ex.velocity {
+                *c = c.saturating_mul(3) / 2 + 1;
+            }
+            let bound = bind(ex, 1 << 20, 0, Some(Scalar::power_of_two(p_exp + 30)), unit).unwrap();
+            cases += 1;
+            let binding = bind_exact(bound.entry.clone(), bound.tube, 0, bound.units, 1 << 20, 0);
+            assert!(safe_range(&binding).is_none(), "an unbound state must have no range (p2^{p_exp})");
+            noncycles += 1;
+        }
+    }
+    println!(
+        "bound_probe: {cases} bindings ({cycles} cycles swept, {noncycles} non-cycles refused, {held} cycles without a computable range); worst relative excursion beyond the widened range: {:+.3e} at {}",
+        worst.0, worst.1
+    );
+}
