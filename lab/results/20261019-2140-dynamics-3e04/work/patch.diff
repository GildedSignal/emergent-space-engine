+//! Belt-interior e-walk instrument (run 20261019-2140-dynamics-3e04).
+//!
+//! Rebuilds the gravity-belt family of 20261019-1551-dynamics-e3b7 on shipped code:
+//! `Chronon` + `Law::RelativisticV1`, Q = 2^20, external central mass MU = 70·2^52
+//! (v_circ(70q) = q/16 exactly), belt of unit-mass, radius-q bouncers on rings
+//! 36–102q, per-chronon rounded 1/r² tide through `Kickable::kick` with each
+//! component of dk clamped to ±DK_CAP (q/16; clamp zone below r ≈ 2.2q aligned /
+//! ≈ 1.85q diagonal, the DK_CAP zone of 20261019-1656-…-9b3b).
+//!
+//! Instrument: per chronon, each body's osculating eccentricity relative to the
+//! central mass is computed twice — e_pre at the detection state (positions at
+//! t−1, velocities before the chronon's response) and e_post at the responded
+//! state (positions at t, velocities after the batch response, before the tide
+//! kick). Δe_contact = e_post − e_pre for bodies in this chronon's contact set;
+//! Δe_tide = e_pre(t+1) − e_post(t) for every body (pure tide, no response in
+//! between). Both are accumulated online into 40 log-spaced e-bins (count, ΣΔe,
+//! ΣΔe²) separately for contact/tide, so the drift field μ(e) and the diffusion
+//! D(e) of the walk come out decomposed by mechanism. Timelines (e-percentiles,
+//! maxk, rms radius, escapees, contact rate), per-body coarse samples, first
+//! threshold crossings, and a summary JSON complete the record.
+//!
+//! All e-computations use only IEEE +, −, ×, ÷, sqrt on f64, so the analysis
+//! numbers are bit-identical on every IEEE machine; the law itself stays integer.
+
+use emergent_lattice::law::{Body, Law, Response, World};
+use emergent_lattice::{chronon::Chronon, Kind, Kickable, Stepper};
+use std::env;
+use std::fs::File;
+use std::io::{BufWriter, Write};
+
+const Q: i64 = 1 << 20;
+const MU: i128 = 70 << 52; // u^3 / ch^2, v_circ(70q) = q/16 exactly
+const DK_CAP: i64 = 1 << 16; // q/16 per component
+const R_MIN_Q: f64 = 36.0;
+const R_MAX_Q: f64 = 102.0;
+const NB: usize = 800;
+const N_RINGS: usize = 40;
+const E_BINS: usize = 40;
+
+fn sin_cos(x: f64) -> (f64, f64) {
+    // Same shape as worlds::sin_cos: reduce to [−π, π], Taylor to x^25.
+    let pi = 3.14159265358979323846264338327950288_f64;
+    let mut y = x;
+    let k = (y / pi).round();
+    y -= k * pi;
+    let mut s = y;
+    let mut term = y;
+    let mut m: u64 = 1;
+    for i in 1..=13 {
+        m += 2;
+        term *= -y * y / ((m - 1) as f64 * m as f64);
+        s += term;
+    }
+    let mut c = 1.0;
+    let mut term = 1.0;
+    let mut m: u64 = 0;
+    for i in 1..=13 {
+        m += 2;
+        term *= -y * y / ((m - 1) as f64 * m as f64);
+        c += term;
+    }
+    let (s, c) = match (k as i64).rem_euclid(4) {
+        0 => (s, c),
+        1 => (-c, s),
+        2 => (-s, -c),
+        _ => (c, -s),
+    };
+    (s.min(1.0).max(-1.0), c.min(1.0).max(-1.0))
+}
+
+struct SplitMix(u64);
+impl SplitMix {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);
+        z ^ (z >> 31)
+    }
+}
+
+/// Osculating (e, a_q, rp_q) relative to the central mass, IEEE-deterministic.
+fn elements(x: [i64; 2], k: [i64; 2]) -> (f64, f64, f64) {
+    let xf = [x[0] as f64, x[1] as f64];
+    let kf = [k[0] as f64, k[1] as f64];
+    let r2 = xf[0] * xf[0] + xf[1] * xf[1];
+    let r = r2.sqrt();
+    let v2 = kf[0] * kf[0] + kf[1] * kf[1];
+    let h = xf[0] * kf[1] - xf[1] * kf[0]; // u^2/ch
+    let muf = MU as f64;
+    let eps = 0.5 * v2 - muf / r; // u^2/ch^2
+    let c1 = 1.0 + 2.0 * eps * h * h / (muf * muf);
+    let e = if c1 <= 0.0 { 0.0 } else { c1.sqrt() };
+    let a_q = if eps < 0.0 { -muf / (2.0 * eps) / Q as f64 } else { f64::INFINITY };
+    let rp_q = if eps < 0.0 { a_q * (1.0 - e) } else { f64::NAN };
+    (e, a_q, rp_q)
+}
+
+fn bin_of(e: f64) -> Option<usize> {
+    if !e.is_finite() || e < 1e-4 || e >= 1.0 {
+        None
+    } else {
+        let b = ((e.ln() - (1e-4f64).ln()) / ((1.0f64).ln() - (1e-4f64).ln()) * E_BINS as f64) as usize;
+        Some(b.min(E_BINS - 1))
+    }
+}
+
+#[derive(Default, Clone, Copy)]
+struct Acc {
+    n: u64,
+    sum: f64,
+    sumsq: f64,
+    sum_e: f64,
+}
+impl Acc {
+    #[inline]
+    fn add(&mut self, de: f64, e: f64) {
+        self.n += 1;
+        self.sum += de;
+        self.sumsq += de * de;
+        self.sum_e += e;
+    }
+}
+
+fn main() {
+    let n_override: Option<usize> = args.get(5).and_then(|s| s.parse().ok());
+    let rings_override: Option<usize> = args.get(6).and_then(|s| s.parse().ok());
+    // Single-body arms: "orbit <seed> <horizon> <dir> <r_q> <e0>" — one body at r_q with
+    // osculating e0 (pericenter at +x for e0 > 0), 9b3b's ladder anchor.
+    let (mut nb, mut n_rings) = (NB, N_RINGS);
+    if let (Some(n), Some(nr)) = (n_override, rings_override) {
+        nb = n.max(1);
+        n_rings = nr.max(1);
+    }
+    if arm == "orbit" {
+        let r_q: f64 = args.get(7).and_then(|s| s.parse().ok()).unwrap_or(70.0);
+        let e0: f64 = args.get(8).and_then(|s| s.parse().ok()).unwrap_or(0.0);
+        let r = (r_q * Q as f64).round() as i64;
+        let vc = ((MU as f64) / r as f64).sqrt();
+        let v_peri = vc * (1.0 + e0).sqrt();
+        let x = [r, 0i64];
+        let k = [0i64, v_peri.round() as i64];
+        let bodies = vec![Body::new(0, x, k, 1, 1, Response::Pass)];
+        let world = World::new(Q, None, bodies).unwrap().with_law(Law::RelativisticV1).unwrap();
+        let mut st = Chronon::new(world, false).unwrap();
+        let f = File::create(format!("{out_dir}/orbit_{arm}_s{seed}_r{r_q}_e{e0}.tsv")).unwrap();
+        let mut f = BufWriter::new(f);
+        writeln!(f, "t\te\tr_q\tv_ulp").unwrap();
+        let mut motions = Vec::new();
+        for t in 1..=horizon {
+            st.step();
+            let mut dks: Vec<[i64; 2]> = Vec::new();
+            st.motions(&mut motions);
+            for m in motions.iter() {
+                let x = m.x;
+                let r2 = (x[0] as i128) * x[0] as i128 + (x[1] as i128) * x[1] as i128;
+                let r3 = if r2 == 0 { 1 } else { integer_sqrt_128(r2) * r2 };
+                let mut dk = [0i64; 2];
+                for c in 0..2 {
+                    let num = -(MU * x[c] as i128);
+                    let mut v = num / r3;
+                    let rem = num - v * r3;
+                    if rem * 2 >= r3 { v += 1; }
+                    v = v.clamp(-(DK_CAP as i128), DK_CAP as i128);
+                    dk[c] = v as i64;
+                }
+                dks.push(dk);
+            }
+            st.kick(&dks).unwrap();
+            if t % 64 == 0 {
+                st.motions(&mut motions);
+                let m = motions[0];
+                let (e, _, _) = elements(m.x, m.k);
+                let rq = (m.x[0] as f64).hypot(m.x[1] as f64) / Q as f64;
+                writeln!(f, "{t}\t{e:.8}\t{rq:.4}\t{}", m.k[0].abs().max(m.k[1].abs())).unwrap();
+            }
+        }
+        eprintln!("orbit r{r_q} e{e0} done");
+        return;
+    }
+        "t64" => Q / 64,
+        _ => 0,
+    };
+    let response = if arm == "pass" { Response::Pass } else { Response::Bounce };
+
+    // Genesis: N_RINGS rings from R_MIN_Q to R_MAX_Q, NB/N_RINGS bodies per ring,
+    // equally spaced in angle with a per-ring golden-angle offset, circular
+    // velocity rounded to the nearest ulp (+ deterministic thermal jitter).
+    let mut rng = SplitMix(seed.wrapping_mul(0x2545F4914F6CDD1D).wrapping_add(0x9E3779B97F4A7C15));
+    let mut bodies: Vec<Body> = Vec::with_capacity(NB);
+    let per_ring = NB / N_RINGS;
+    let golden = 1.6180339887498949_f64;
+    let mut id = 0u64;
+    for ri in 0..N_RINGS {
+        let rq = R_MIN_Q + (R_MAX_Q - R_MIN_Q) * ri as f64 / (N_RINGS - 1) as f64;
+        let r = (rq * Q as f64).round() as i64;
+        let v_circ = (MU as f64 / r as f64).sqrt().round() as i64;
+        for j in 0..per_ring {
+            let th = (j as f64 + 0.5) / per_ring as f64 * 6.283185307179586_f64 + ri as f64 * golden;
+            let (s, c) = sin_cos(th);
+            let x = [(r as f64 * c).round() as i64, (r as f64 * s).round() as i64];
+            let mut k = [(-v_circ as f64 * s).round() as i64, (v_circ as f64 * c).round() as i64];
+            if thermal > 0 {
+                for c in k.iter_mut() {
+                    let jitter = ((rng.next() % (2 * thermal as u64 + 1)) as i64) - thermal;
+                    *c += jitter;
+                }
+            }
+            bodies.push(Body::new(id, x, k, 1, Q, response));
+            id += 1;
+        }
+    }
+    let world = World::new(Q, None, bodies).expect("genesis valid").with_law(Law::RelativisticV1).expect("law valid");
+    let mut st = Chronon::new(world, true).expect("chronon");
+
+    // Files.
+    let tl = File::create(format!("{out_dir}/timeline_{arm}_s{seed}.tsv")).unwrap();
+    let mut tl = BufWriter::new(tl);
+    writeln!(tl, "t\tcontacts64\tmaxk\trmsr_q\tnesc\tep50\tep90\tep99\temax\trpmin_q").unwrap();
+    let bd = File::create(format!("{out_dir}/bindata_{arm}_s{seed}.tsv")).unwrap();
+    let mut bd = BufWriter::new(bd);
+    writeln!(bd, "e_lo\te_hi\tn_c\tsum_c\tsumsq_c\tmean_e_c\tn_t\tsum_t\tsumsq_t\tmean_e_t").unwrap();
+    let pb = File::create(format!("{out_dir}/perbody_{arm}_s{seed}.tsv")).unwrap();
+    let mut pb = BufWriter::new(pb);
+    writeln!(pb, "t\tid\te\ta_q\trp_q\tr_q\trk_ulp").unwrap();
+    let cr = File::create(format!("{out_dir}/crossings_{arm}_s{seed}.tsv")).unwrap();
+    let mut cr = BufWriter::new(cr);
+    writeln!(cr, "id\tt_e03\tt_e05\tt_e07\tt_e09\tt_e097\tt_rp21\tmax_e\tfinal_e\tfinal_bound\tfinal_r_q").unwrap();
+
+    let mut acc_c = [Acc::default(); E_BINS];
+    let mut acc_t = [Acc::default(); E_BINS];
+    let mut cur_e = vec![0.0f64; NB]; // e_pre cache, filled at t=0 below
+    let mut max_e = vec![0.0f64; NB];
+    let mut t_cross = vec![[-1i64; 6]; NB]; // e>0.3,0.5,0.7,0.9,0.97, rp<2.1q
+    let mut seen_events = 0usize;
+    let mut contacts_total = 0u64;
+    let mut contacts_win = 0u64;
+    let mut motions = Vec::with_capacity(NB);
+
+    // e_pre at genesis (detection state of chronon 1).
+    st.motions(&mut motions);
+    for (i, m) in motions.iter().enumerate() {
+        cur_e[i] = elements(m.x, m.k).0;
+        max_e[i] = cur_e[i];
+    }
+
+    let mut summary = format!("arm\t{arm}\nseed\t{seed}\nhorizon\t{horizon}\nthermal\t{thermal}\nresponse\t{response:?}\n");
+
+    let t0 = std::time::Instant::now();
+    for t in 1..=horizon {
+        // e_pre(t): from the detection state — motions() before step().
+        let mut in_contact = [false; NB];
+        st.step();
+        // New contact events of this tick: mark participants.
+        {
+            let log = st.log();
+            let ev = &log.events;
+            while seen_events < ev.len() {
+                let e = &ev[seen_events];
+                seen_events += 1;
+                if e.kind == Kind::Contact {
+                    contacts_total += 1;
+                    contacts_win += 1;
+                    in_contact[(e.a as usize).min(NB - 1)] = true;
+                    in_contact[(e.b as usize).min(NB - 1)] = true;
+                }
+            }
+        }
+        // e_post(t): positions at t, velocities after response (before tide).
+        st.motions(&mut motions);
+        let mut es_post = vec![0.0f64; NB];
+        for (i, m) in motions.iter().enumerate() {
+            let (e, _, rp) = elements(m.x, m.k);
+            es_post[i] = e;
+            let de_c = e - cur_e[i];
+            if in_contact[i] {
+                if let Some(b) = bin_of(cur_e[i]) {
+                    acc_c[b].add(de_c, cur_e[i]);
+                }
+            }
+            if e > max_e[i] {
+                max_e[i] = e;
+            }
+            let th = [0.3, 0.5, 0.7, 0.9, 0.97];
+            for (ci, &tv) in th.iter().enumerate() {
+                if t_cross[i][ci] < 0 && e > tv {
+                    t_cross[i][ci] = t;
+                }
+            }
+            if t_cross[i][5] < 0 && rp.is_finite() && rp < 2.1 {
+                t_cross[i][5] = t;
+            }
+        }
+        // Tide kick at position x(t), then next chronon's e_pre(t+1) − e_post(t) is Δe_tide.
+        let mut dks: Vec<[i64; 2]> = Vec::with_capacity(NB);
+        for m in motions.iter() {
+            let x = m.x;
+            let r2 = (x[0] as i128) * x[0] as i128 + (x[1] as i128) * x[1] as i128;
+            if r2 == 0 {
+                dks.push([0, 0]);
+                continue;
+            }
+            let r3 = integer_sqrt_128(r2);
+            let r3 = r3 * r2; // |x|^3 with |x| floored: a fixed, deterministic rounded tide.
+            let mut dk = [0i64; 2];
+            for c in 0..2 {
+                let num = -(MU * x[c] as i128); // attract: −MU·x/r³
+                let mut v = num / r3;
+                let rem = num - v * r3;
+                if rem * 2 >= r3 {
+                    v += 1;
+                }
+                v = v.clamp(-(DK_CAP as i128), DK_CAP as i128);
+                dk[c] = v as i64;
+            }
+            dks.push(dk);
+        }
+        st.kick(&dks).expect("kick legal");
+        // e_pre(t+1) for Δe_tide and the next round's Δe_contact.
+        st.motions(&mut motions);
+        for (i, m) in motions.iter().enumerate() {
+            let e = elements(m.x, m.k).0;
+            let de_t = e - es_post[i];
+            if let Some(b) = bin_of(es_post[i]) {
+                acc_t[b].add(de_t, es_post[i]);
+            }
+            cur_e[i] = e;
+        }
+
+        if t % 64 == 0 {
+            let mut es: Vec<f64> = cur_e.clone();
+            es.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            st.motions(&mut motions);
+            let mut maxk = 0i64;
+            let mut rmsr = 0.0f64;
+            let mut nesc = 0usize;
+            let mut rpmin = f64::INFINITY;
+            for m in motions.iter() {
+                maxk = maxk.max(m.k[0].abs()).max(m.k[1].abs());
+                let rq = ((m.x[0] as f64).hypot(m.x[1] as f64)) / Q as f64;
+                rmsr += rq * rq;
+                let (e, _, rp) = elements(m.x, m.k);
+                let v2 = (m.k[0] as f64).powi(2) + (m.k[1] as f64).powi(2);
+                let eps = 0.5 * v2 - MU as f64 / (rq * Q as f64);
+                if eps > 0.0 && rq > 103.0 {
+                    nesc += 1;
+                }
+                if rp.is_finite() && rp < rpmin {
+                    rpmin = rp;
+                }
+            }
+            rmsr = (rmsr / NB as f64).sqrt();
+            let q = |f: f64| es[((f * NB as f64) as usize).min(NB - 1)];
+            writeln!(
+                tl,
+                "{t}\t{contacts_win}\t{maxk}\t{rmsr:.2}\t{nesc}\t{:.5}\t{:.5}\t{:.5}\t{:.5}\t{rpmin:.3}",
+                q(0.5), q(0.9), q(0.99), es[NB - 1]
+            ).unwrap();
+            contacts_win = 0;
+        }
+        if t % 1024 == 0 {
+            st.motions(&mut motions);
+            for (i, m) in motions.iter().enumerate() {
+                let (e, a, rp) = elements(m.x, m.k);
+                let rq = ((m.x[0] as f64).hypot(m.x[1] as f64)) / Q as f64;
+                let rk = m.k[0].abs().max(m.k[1].abs());
+                writeln!(pb, "{t}\t{i}\t{e:.6}\t{a:.2}\t{rp:.3}\t{rq:.2}\t{rk}").unwrap();
+            }
+        }
+    }
+    let wall = t0.elapsed().as_secs_f64();
+
+    // Crossings + final states.
+    st.motions(&mut motions);
+    for (i, m) in motions.iter().enumerate() {
+        let (e, _, _) = elements(m.x, m.k);
+        let rq = ((m.x[0] as f64).hypot(m.x[1] as f64)) / Q as f64;
+        let v2 = (m.k[0] as f64).powi(2) + (m.k[1] as f64).powi(2);
+        let eps = 0.5 * v2 - MU as f64 / (rq * Q as f64);
+        let bound = if eps < 0.0 { 1 } else { 0 };
+        let c = &t_cross[i];
+        writeln!(cr, "{}\t{}\t{}\t{}\t{}\t{}\t{}\t{:.5}\t{:.5}\t{bound}\t{rq:.2}",
+            i, c[0], c[1], c[2], c[3], c[4], c[5], max_e[i], e).unwrap();
+    }
+    for b in 0..E_BINS {
+        let lo = 1e-4 * (1e4f64).powf(b as f64 / E_BINS as f64);
+        let hi = 1e-4 * (1e4f64).powf((b + 1) as f64 / E_BINS as f64);
+        let ac = &acc_c[b];
+        let at = &acc_t[b];
+        writeln!(bd, "{lo:.6}\t{hi:.6}\t{}\t{:.6}\t{:.9}\t{:.6}\t{}\t{:.6}\t{:.9}\t{:.6}",
+            ac.n, ac.sum, ac.sumsq, if ac.n>0 {ac.sum_e/ac.n as f64} else {0.0},
+            at.n, at.sum, at.sumsq, if at.n>0 {at.sum_e/at.n as f64} else {0.0}).unwrap();
+    }
+    summary.push_str(&format!("wall_s\t{wall:.1}\ncontacts_total\t{contacts_total}\n"));
+    // Median first-crossing times for the summary.
+    for (ci, name) in [0usize, 1, 2, 3, 4, 5].iter().zip(["e03","e05","e07","e09","e097","rp21"]) {
+        let mut v: Vec<i64> = t_cross.iter().filter_map(|c| if c[*ci] > 0 { Some(c[*ci]) } else { None }).collect();
+        v.sort_unstable();
+        let med = if v.is_empty() { -1 } else { v[v.len() / 2] };
+        let n = v.len();
+        summary.push_str(&format!("cross_{name}_n\t{n}\ncross_{name}_med\t{med}\n"));
+    }
+    let mut f = File::create(format!("{out_dir}/summary_{arm}_s{seed}.txt")).unwrap();
+    f.write_all(summary.as_bytes()).unwrap();
+    eprintln!("{arm} s{seed}: {contacts_total} contacts, {wall:.1}s");
+}
+
+fn integer_sqrt_128(n: i128) -> i128 {
+    if n < 2 {
+        return n;
+    }
+    // Newton from a f64 seed (deterministic on IEEE).
+    let mut x = (n as f64).sqrt() as i128;
+    if x < 1 {
+        x = 1;
+    }
+    loop {
+        let y = (x + n / x) >> 1;
+        if y >= x {
+            break;
+        }
+        x = y;
+    }
+    while x * x > n {
+        x -= 1;
+    }
+    while (x + 1) * (x + 1) <= n {
+        x += 1;
+    }
+    x
+}
