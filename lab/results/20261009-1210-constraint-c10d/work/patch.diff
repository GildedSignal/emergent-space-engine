+/// Section timers for the gather (this run's probe, lab 20261009-1210): player readout, per-body
+/// crossing searches, fleet-member extrapolation. Atomic nanos, read by the bench.
+pub static T_PLAYER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static T_BODIES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static T_FLEETS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn add(a: &std::sync::atomic::AtomicU64, t: std::time::Instant) {
+    a.fetch_add(t.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// The gather's section totals in ms (a probe; not part of the view).
+pub fn gather_timing_ms() -> [f64; 3] {
+    let f = |a: &std::sync::atomic::AtomicU64| a.load(std::sync::atomic::Ordering::Relaxed) as f64 / 1e6;
+    [f(&T_PLAYER), f(&T_BODIES), f(&T_FLEETS)]
+}
