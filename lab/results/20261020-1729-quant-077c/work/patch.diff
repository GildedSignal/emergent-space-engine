+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let (mut now, mut peak) = (0u64, 0u64);
+    if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+        for line in s.lines() {
+            let strip = |p: &str| line.strip_prefix(p).map(|v| v.trim().trim_end_matches(" kB").parse::<u64>().unwrap_or(0) * 1024);
+            if let Some(v) = strip("VmRSS:") { now = v; }
+            if let Some(v) = strip("VmHWM:") { peak = v; }
+        }
+    }
+    (now, peak)
+}
