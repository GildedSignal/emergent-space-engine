+// ---- run 20261020-1729-quant-077c: stage census of `Rebinding::from_state`, print-only. ----
+// One instrument for both regimes (plane kick-bench, belt ladder), adjudicating 7fd3's census
+// (compile 26% of a belt rebind) against a765's stage timings (84-87% on the plane).
+// Off unless ES_REBIND_AUDIT is set; when on, four `Instant::now()` reads per call.
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+pub struct RebindAudit {
+    pub calls: AtomicU64,
+    pub cycles: AtomicU64,
+    pub passages: AtomicU64,
+    pub fit_ns: AtomicU64,
+    pub compile_ns: AtomicU64,
+    pub anchor_ns: AtomicU64,
+    pub residual_ns: AtomicU64,
+    pub wall_ns: AtomicU64,
+    pub errs: AtomicU64,
+}
+pub static REBIND_AUDIT: RebindAudit = RebindAudit {
+    calls: AtomicU64::new(0),
+    cycles: AtomicU64::new(0),
+    passages: AtomicU64::new(0),
+    fit_ns: AtomicU64::new(0),
+    compile_ns: AtomicU64::new(0),
+    anchor_ns: AtomicU64::new(0),
+    residual_ns: AtomicU64::new(0),
+    wall_ns: AtomicU64::new(0),
+    errs: AtomicU64::new(0),
+};
+static AUDIT_STATE: AtomicU64 = AtomicU64::new(0); // 0 unread, 1 off, 2 on
+pub fn rebind_audit_on() -> bool {
+    match AUDIT_STATE.load(Ordering::Relaxed) {
+        0 => {
+            let v = if std::env::var("ES_REBIND_AUDIT").is_ok() { 2 } else { 1 };
+            AUDIT_STATE.store(v, Ordering::Relaxed);
+            v == 2
+        }
+        v => v == 2,
+    }
+}
+pub fn rebind_audit_reset() {
+    use RebindAudit as R;
+    let r: &R = &REBIND_AUDIT;
+    for a in [&r.calls, &r.cycles, &r.passages, &r.fit_ns, &r.compile_ns, &r.anchor_ns, &r.residual_ns, &r.wall_ns, &r.errs] {
+        a.store(0, Ordering::Relaxed);
+    }
+}
+fn rebind_add(counter: &AtomicU64, ns: u64) {
+    counter.fetch_add(ns, Ordering::Relaxed);
+}
+/// Totals: [calls, cycles, passages, fit_ns, compile_ns, anchor_ns, residual_ns, wall_ns, errs].
+pub fn rebind_audit_snapshot() -> [u64; 9] {
+    let r = &REBIND_AUDIT;
+    [
+        r.calls.load(Ordering::Relaxed),
+        r.cycles.load(Ordering::Relaxed),
+        r.passages.load(Ordering::Relaxed),
+        r.fit_ns.load(Ordering::Relaxed),
+        r.compile_ns.load(Ordering::Relaxed),
+        r.anchor_ns.load(Ordering::Relaxed),
+        r.residual_ns.load(Ordering::Relaxed),
+        r.wall_ns.load(Ordering::Relaxed),
+        r.errs.load(Ordering::Relaxed),
+    ]
+}
+pub fn rebind_report(tag: &str) {
+    if !rebind_audit_on() {
+        return;
+    }
+    let s = rebind_audit_snapshot();
+    if s[0] == 0 {
+        eprintln!("rebind_audit tag={tag} calls=0");
+        return;
+    }
+    let us = |i: usize| s[i] as f64 / s[0] as f64 / 1e3;
+    eprintln!(
+        "rebind_audit tag={tag} calls={} cycles={} passages={} errs={} fit_us={:.2} compile_us={:.2} anchor_us={:.2} residual_us={:.2} wall_us={:.2} shares=fit/{:.1}%compile/{:.1}%anchor/{:.1}%residual/{:.1}%",
+        s[0], s[1], s[2], s[8], us(3), us(4), us(5), us(6), us(7),
+        100.0 * s[3] as f64 / s[7] as f64, 100.0 * s[4] as f64 / s[7] as f64,
+        100.0 * s[5] as f64 / s[7] as f64, 100.0 * s[6] as f64 / s[7] as f64
+    );
+}
