+//! run 20261020-1729-quant-077c: `Rebinding::from_state` stage costs on a controlled key grid.
+//! Adjudicates the frame-cost contradiction (7fd3: compile 26% of a belt rebind; a765: 84-87% on
+//! the plane) by measuring fit / compile / anchor / residual per e at fixed radii, with the same
+//! audit counters the two scenes use.
+//! `cargo run --release -p emergent-space --example rebind_stages [-- off]` — `off` times the
+//! uninstrumented wall for the timer-overhead control.
+use emergent_space::binding::{cartesian, rebind_audit_reset, rebind_audit_snapshot, rebind_audit_on, Rebinding};
+use emergent_space::orbit::{Orbit, OrbitKey};
+use emergent_space::scaled::Scalar;
+
+fn main() {
+    let off = std::env::args().nth(1).as_deref() == Some("off");
+    let event_time = Scalar::integer(12345);
+    // q48 = e * 2^48: near-circular, belt (Rayleigh 0.07, redrawn at 0.4), mid, plane (0.9, 0.99).
+    let es: [(f64, u64); 9] = [
+        (0.0, 0),
+        (0.01, 1 << 40),
+        (0.07, (7 << 44) / 100),
+        (0.1, (1 << 48) / 10),
+        (0.2, (1 << 48) / 5),
+        (0.4, (1 << 48) * 2 / 5),
+        (0.6, (3 << 48) / 5),
+        (0.9, (9 << 48) / 10),
+        (0.99, (99 << 48) / 100),
+    ];
+    let radius_exps = [8i16, 17, 30];
+    println!("radius_exp\te\tcalls\terrs\tfit_us\tcompile_us\tanchor_us\tresidual_us\twall_us\tbare_wall_us");
+    for &re in &radius_exps {
+        for &(e, q) in &es {
+            let Ok(p) = Scalar::integer(16).scale(re.into()) else { continue };
+            let Ok(key) = OrbitKey::bound(p, q) else { continue };
+            let Ok(orbit) = Orbit::compile(key) else { continue };
+            let Ok(period) = orbit.period() else { continue };
+            let mut states = Vec::new();
+            for j in 0u32..72 {
+                let Ok(time) = period.mul(Scalar::raw((j % 24) as i128 * 2 + 1, -5).unwrap()) else { continue };
+                let Ok(st) = orbit.state(time) else { continue };
+                let units = (st.radius.exponent() - 60, st.transverse_velocity.abs().exponent() - 60);
+                let Ok(state) = cartesian(st, j.wrapping_mul(0x1000_0000), j % 2 == 0, units) else { continue };
+                states.push(state);
+            }
+            if states.len() < 64 {
+                continue;
+            }
+            // Shared box: vCPU steal is bimodal (~±35%); min of 5 batches kills it (the belt/kick
+            // scenes below are long enough that steal lands outside the stages' ratios).
+            let mut best: Option<([u64; 9], f64)> = None;
+            for _rep in 0..5 {
+                rebind_audit_reset();
+                let t0 = std::time::Instant::now();
+                let mut errs = 0u64;
+                for st in states.iter().skip(8) {
+                    if Rebinding::from_state(*st, event_time, None).is_err() {
+                        errs += 1;
+                    }
+                }
+                let bare = t0.elapsed().as_secs_f64() / (states.len() - 8) as f64;
+                let s = rebind_audit_snapshot();
+                if best.map(|(b, _)| s[7] < b[7]).unwrap_or(true) {
+                    best = Some((s, bare));
+                }
+            }
+            let (s, bare) = best.unwrap();
+            let n = s[0].max(1) as f64;
+            println!(
+                "{re}\t{e:.2}\t{}\t{}\t{:.2}\t{:.2}\t{:.2}\t{:.2}\t{:.2}\t{:.2}",
+                s[0], s[8],
+                s[3] as f64 / n / 1e3,
+                s[4] as f64 / n / 1e3,
+                s[5] as f64 / n / 1e3,
+                s[6] as f64 / n / 1e3,
+                s[7] as f64 / n / 1e3,
+                bare * 1e6
+            );
+            let _ = rebind_audit_on(); // keep the env read warm; harmless when unset
+            let _ = off;
+        }
+    }
+    if off {
+        eprintln!("mode=off (bare walls only; audit counters still filled if ES_REBIND_AUDIT is set)");
+    }
+}
