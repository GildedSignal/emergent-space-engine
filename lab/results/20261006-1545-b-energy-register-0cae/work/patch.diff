+/// The coordinate velocity after a **canonical** momentum kick `Δp` at the state `(x, v)` of a doll whose
+/// centre has mass `mu` (doll units). The kick is the flow of `−f(U_P + c)` (the motion law v2, `crate::ext`):
+/// Hamilton's equation moves the canonical momentum of the doll's geodesic Hamiltonian at fixed `x`, and
+/// **the coordinate velocity is not canonical in a curved doll**. The pair (per unit mass):
+///
+/// ```text
+///   lapse = 1 − 2·mu/r,   den = lapse − (vr²/lapse + vt²),   E = lapse/√den
+///   p_r = E·vr/lapse²,    p_φ = E·vt/lapse                   (x × p = E·(x × v)/lapse = L_GR)
+///   E′² = lapse·(1 + lapse·p_r′² + p_φ′²/r²),   vr′ = lapse²·p_r′/E′,   vt′ = lapse·p_φ′/(E′·r)
+/// ```
+///
+/// `x×p` is linear in `p`, so a kick `Δp = w·∇U_P` changes `L_GR` by exactly `x×Δp`, which is what
+/// `Δp_t = w·∂_tU_P = −Ω·w·(x×∇U_P)` pairs with (a source on a circle): `J = p_t + Ω·L_GR` is conserved
+/// to the quanta at any kick strength. Kicking the coordinate velocity instead leaves
+/// `ΔJ ≈ (E/lapse − 1)·Ω·(x×Δv)`, small only while the kick is (the probe P3').
+pub fn canonical_kick(x: V2, v: V2, dp: V2, mu: Scalar) -> Res<V2> {
+    let r = norm2(x)?;
+    let lapse = Scalar::ONE.sub(Scalar::integer(2).mul(mu)?.div(r)?)?;
+    if !lapse.is_positive() {
+        return Err(crate::num::Error::Refused("a kick inside the horizon"));
+    }
+    let rh = [x[0].div(r)?, x[1].div(r)?];
+    let th = [rh[1].negate(), rh[0]];
+    let (vr, vt) = (dot2(v, rh)?, dot2(v, th)?);
+    let den = lapse.sub(vr.mul(vr)?.div(lapse)?.add(vt.mul(vt)?)?)?;
+    if !den.is_positive() {
+        return Err(crate::num::Error::Refused("a state off the geodesic mass shell"));
+    }
+    let e = lapse.div(den.sqrt()?)?;
+    // p, kicked, and the new energy and velocity from the mass shell.
+    let pr = e.mul(vr)?.div(lapse.mul(lapse)?)?.add(dot2(dp, rh)?)?;
+    let pp = e.mul(r)?.mul(vt)?.div(lapse)?.add(dot2(dp, th)?)?;
+    let e1 = lapse
+        .mul(Scalar::ONE.add(lapse.mul(pr.mul(pr)?)?.add(pp.mul(pp)?.div(r.mul(r)?)?)?)?)?
+        .sqrt()?;
+    let vr1 = pr.mul(lapse)?.mul(lapse)?.div(e1)?;
+    let vt1 = pp.mul(lapse)?.div(e1.mul(r)?)?;
+    add2(scale2(rh, vr1)?, scale2(th, vt1)?)
+}
+
+/// The geodesic invariants of a state `(x, v)` in a doll whose centre has mass `mu` (doll units): `(E, L)`,
+/// with `E = lapse/√den` and `L = r·vt/√den` on `den = lapse − (vr²/lapse + vt²)` — the fit's own formula
+/// (`emergent_space::binding::fit_key`), read on the exact state and not on the quantised key.
+pub fn geodesic_of(x: V2, v: V2, mu: Scalar) -> Res<(Scalar, Scalar)> {
+    let r = norm2(x)?;
+    let lapse = Scalar::ONE.sub(Scalar::integer(2).mul(mu)?.div(r)?)?;
+    if !lapse.is_positive() {
+        return Err(crate::num::Error::Refused("a state inside the horizon"));
+    }
+    let rh = [x[0].div(r)?, x[1].div(r)?];
+    let vt = crate::num::cross2(x, v)?.div(r)?;
+    let vr = dot2(v, rh)?;
+    let den = lapse.sub(vr.mul(vr)?.div(lapse)?.add(vt.mul(vt)?)?)?;
+    if !den.is_positive() {
+        return Err(crate::num::Error::Refused("a state off the geodesic mass shell"));
+    }
+    let root = den.sqrt()?;
+    Ok((lapse.div(root)?, r.mul(vt)?.div(root)?))
+}
