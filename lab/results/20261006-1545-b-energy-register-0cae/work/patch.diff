+        // (2) along a drift: the binding's own readout, sampled inside the step it stands for.
+        for (n, &s) in w.ships.iter().enumerate() {
+            let rec = w.u.rec(s);
+            let (Some(ext), Some(next)) = (
+                rec.ext.as_ref(),
+                rec.plan.iter().find(|p| matches!(p.what, What::Kick(_))).map(|p| p.t),
+            ) else { continue };
+            let mid = rec.b.event_time + (next - rec.b.event_time) / 2;
+            if !rec.alive || mid <= rec.b.event_time + 1 || rec.b.event_time < 2 {
+                continue;
+            }
+            let (j0, q) = j_of(&rec.b, ext, rec.b.event_time);
+            worst_drift = worst_drift.max((j_of(&rec.b, ext, mid).0 - j0).abs() / q);
+            trend[n] = j0;
+            if first[n].is_nan() {
+                first[n] = j0;
+            }
+            // (4) the key's invariants are the tube's own: compare with the decoded state's, mid-drift.
+            let st = rec.b.readout(mid).unwrap();
+            let (x, v) = scalars(&st).unwrap();
+            let (e_state, l_state) = force::geodesic_of(x, v, star_mu).unwrap();
+            let (e_key, l_key) = emergent_universe::ext::tube_invariants(rec.b.entry.trajectory.key()).unwrap();
+            let l_key = rec.b.to_doll(l_key).unwrap();
+            let l_key = if rec.b.entry.clockwise { l_key.negate() } else { l_key };
+            worst_key = worst_key.max(to_f64(e_key.sub(e_state.sub(Scalar::ONE).unwrap()).unwrap().abs())).max(to_f64(l_key.sub(l_state).unwrap().abs().div(l_state.abs()).unwrap()));
+        }
+        if w.u.advance(end, emergent_universe::Budget::events(1)).events == 0 {
+            break;
+        }
+        // (1) and (3): every kick, before against after, and the coordinate-kick control.
+        for (n, &s) in w.ships.iter().enumerate() {
+            let rec = w.u.rec(s);
+            if !rec.alive {
+                continue;
+            }
+            let (Some(e0), Some(e1)) = (before[n].ext.as_ref(), rec.ext.as_ref()) else { continue };
+            let kicked = rec.b.event_time != before[n].b.event_time || e1.pt != e0.pt;
+            if !kicked || rec.b.event_time < 2 || before[n].b.event_time > rec.b.event_time {
+                continue;
+            }
+            let t = rec.b.event_time;
+            let (ja, q) = j_of(&rec.b, e1, t);
+            let (jb, _) = j_of(&before[n].b, e0, t);
+            worst_kick = worst_kick.max((ja - jb).abs() / q);
+            kicks += 1;
+            // The control: the same weight on the coordinate velocity (the law before the canonical kick).
+            let st = before[n].b.readout(t).unwrap();
+            let (x, v) = scalars(&st).unwrap();
+            let secs = w.u.ctx().secondaries(0, t, s).unwrap();
+            let f = force::field(&secs, x).unwrap();
+            let wgt = e0.time(e0.y(f.potential).unwrap(), e0.ds).unwrap();
+            let v_coord = add2(v, scale2(f.accel, wgt).unwrap()).unwrap();
+            let (_, l_coord) = force::geodesic_of(x, v_coord, star_mu).unwrap();
+            let (_, l_before) = force::geodesic_of(x, v, star_mu).unwrap();
+            let dpt = to_f64(wgt.mul(f.rate).unwrap());
+            worst_control = worst_control.max((dpt + omega * (to_f64(l_coord) - to_f64(l_before))).abs() / q);
+        }
+    }
+    let drift_of_trend = trend.iter().zip(&first).map(|(j, f)| (j - f).abs()).fold(0.0, f64::max);
+    println!("{kicks} kicks: worst |ΔJ| {worst_kick:.2} quanta, drift {worst_drift:.3}, control (coordinate kick) {worst_control:.2e}, trend {drift_of_trend:.2}, key invariants {worst_key:.2e}");
+    assert!(kicks > 2000, "enough kicks looked at: {kicks}");
+    assert!(worst_kick <= 2.0, "a kick moved J by {worst_kick} quanta");
+    assert!(worst_drift <= 1.0, "a drift moved J by {worst_drift} quanta");
+    assert!(drift_of_trend <= 8.0, "J trended by {drift_of_trend} quanta");
+    assert!(worst_control >= 1e3, "the control: the coordinate kick moves J by only {worst_control} quanta");
+    assert!(worst_key <= 1e-12, "the key's invariants are not the tube's: {worst_key}");
+}
