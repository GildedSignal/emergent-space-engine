+/// The tube's own geodesic invariants from its key `(r_p, k)`: the reduced energy `E − 1` (dimensionless,
+/// so the same number in the doll's units) and the angular momentum `L` (tube units, a length; the doll
+/// value is the tube's by the unit's length scale). This is the exact algebra of the fit
+/// (`emergent_space::binding::fit_key`) inverted: the key was built from the periapsis turning point of
+/// the cubic in `z = L²/r`, so with `u = 1/r_p` and `A = 2u − k(1 + 2u)`,
+///
+/// ```text
+///   S = 1 + 4u(1 + 2A) − 12u² + 16k²u²,    d = (k·√S − A − 4k²u)/2
+///   L² = 1/(u·d),                          E² = (1 − 2u)(1 + u/d)
+/// ```
+///
+/// Controls: a circular key (`k = 1`) gives `L² = r²/(r − 3)` and `E = (r − 2)/√(r(r − 3))`, the exact
+/// Schwarzschild circular orbit (M = 1). The drift conserves these exactly — the Kepler form of the
+/// readout state does not (it oscillates along the geodesic), which is why the register reads `E − 1`
+/// and not `force::kepler` (the probe P3': the Kepler register moved J by 6e5–2e8 quanta across a kick).
+pub fn tube_invariants(key: OrbitKey) -> Res<(Scalar, Scalar)> {
+    let u = key.periapsis.reciprocal()?;
+    let two_u = u.scale(1)?;
+    let k = Scalar::raw(key.k as i128, -48)?;
+    let a = two_u.sub(k.mul(Scalar::ONE.add(two_u)?)?)?;
+    let (u2, k2) = (u.mul(u)?, k.mul(k)?);
+    // S = 1 + 4u(1 + 2A) − 12u² + 16k²u²
+    let s = Scalar::ONE
+        .add(u.scale(2)?.mul(Scalar::ONE.add(a.scale(1)?)?)?)?
+        .add(u2.mul(k2.scale(4)?.sub(Scalar::integer(12))?)?)?;
+    let d = k.mul(s.sqrt()?)?.sub(a)?.sub(u.mul(k2)?.scale(2)?)?.scale(-1)?;
+    if !d.is_positive() {
+        return Err(Error::Refused("a key whose periapsis is not a turning point"));
+    }
+    let l2 = u.mul(d)?.reciprocal()?;
+    let e2 = Scalar::ONE.sub(two_u)?.mul(Scalar::ONE.add(u.div(d)?)?)?;
+    if !e2.is_positive() {
+        return Err(Error::Refused("a key outside the geodesic energy's range"));
+    }
+    Ok((e2.sqrt()?.sub(Scalar::ONE)?, l2.sqrt()?))
+}
