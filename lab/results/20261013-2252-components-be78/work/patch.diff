+/// The closed-form half of [`Rebinding::from_state`], published alone: the turning key a state
+/// fits (and the radius it is at). A caller can derive the unit word the compile will need from
+/// the key ([`word_of_key`]) before paying for the compile.
+pub fn fit_of_state(state: IntegerState) -> Result<(OrbitKey, Scalar, bool, bool)> {
+    fit_key(state, true)
+}
+
+/// The unit exponents the trajectory this key compiles to will need — the same integers the
+/// engine's `word_for` reads off the finished entry: the apoapsis `periapsis/(k−1)` for a
+/// turning orbit, the compiled-out `outer` edge for a flyby, and the periapsis speed with a
+/// factor of two of margin, each minus 60 bits. `outer` is what `from_state` will pass to
+/// `Passage::compile`: the caller's passage edge in tube units, else the state's own radius.
+pub fn word_of_key(key: &OrbitKey, outer: Scalar) -> Result<(i32, i32)> {
+    let k = Scalar::raw(key.k as i128, -48)?;
+    let r_max = if key.periodic() {
+        key.periapsis.div(k.scale(1)?.sub(Scalar::ONE)?)?
+    } else {
+        outer
+    };
+    let v_max = Scalar::ONE.div(key.periapsis.mul(k)?)?.sqrt()?.scale(1)?;
+    Ok((r_max.exponent() as i32 - 60, v_max.exponent() as i32 - 60))
+}
