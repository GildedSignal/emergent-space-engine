+/// Whether `ES_WORD_FIRST` is set: the word is chosen before the first bind.
+fn word_first() -> bool {
+    static W: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var_os("ES_WORD_FIRST").is_some_and(|v| v != "0"));
+    *W
+}
+
+/// The state re-expressed at the word its own key implies, when that word is coarser than the
+/// state's — bit for bit the re-expression the shipped retry performs. `None` when the state's
+/// word already holds what the key implies, or the key cannot be taken (then the shipped path,
+/// with its check, is the only authority).
+fn word_before(exact: IntegerState, edge: Option<Scalar>, unit: Unit) -> Option<IntegerState> {
+    let input = in_tube_units(exact, unit).ok()?;
+    let (key, r, _, _) = emergent_space::binding::fit_of_state(input).ok()?;
+    let outer = match edge.map(|e| unit.to_tube(e)) {
+        Some(Ok(e)) => e,
+        Some(Err(_)) => return None,
+        None => r.scale(1).ok()?,
+    };
+    let (len, vel) = emergent_space::binding::word_of_key(&key, outer).ok()?;
+    let (cur_len, cur_vel) = (exact.length_exponent as i32, exact.velocity_exponent as i32);
+    if len <= cur_len && vel <= cur_vel {
+        return None;
+    }
+    let (nl, nv) = (len.max(cur_len), vel.max(cur_vel));
+    let shift = |v: i64, by: i32| -> i64 { if by <= 0 { v } else { v / (1i64 << by.min(62)) } };
+    Some(IntegerState {
+        position: [shift(exact.position[0], nl - cur_len), shift(exact.position[1], nl - cur_len)],
+        velocity: [shift(exact.velocity[0], nv - cur_vel), shift(exact.velocity[1], nv - cur_vel)],
+        length_exponent: nl as i16,
+        velocity_exponent: nv as i16,
+    })
+}
