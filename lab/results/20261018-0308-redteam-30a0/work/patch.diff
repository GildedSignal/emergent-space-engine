+//! The ether bench (run 20261018-0308-redteam-30a0). Premise under test:
+//! representation.md §2 "Contacts use the **exact integer special-relativity
+//! law** (`es-lattice-relativistic-v1`)". Exact SR means the contact's outcome
+//! is a function of the two worldlines only — it cannot depend on which
+//! inertial frame the engine's lattice sits in.
+//!
+//! The resolver's reflection normal is built from `d` = the separation at the
+//! detection chronon's lattice-simultaneous end (`relativity.rs`, after the
+//! advance), and detection itself tests the reach ball in lattice time. Both
+//! are frame-sliced inputs. This bench presents the SAME two worldlines to the
+//! shipped stepper (`Chronon`, `Law::RelativisticV1`, Q = 2^20) in frames
+//! boosted by W (exact Lorentz construction of the t'=0 presentation, rounded
+//! to lattice integers) and measures the outcome in frame-invariant terms:
+//! the deflection of body A's momentum in the pair's centre of momentum.
+//!
+//! Beside the shipped law, an f64 covariant reference (COM-simultaneous
+//! contact at |d| = reach, elastic reflection about d̂) consumes the identical
+//! integer-rounded initial data. If the law is SR, both deflections are flat
+//! in W; the reference's flatness is the instrument's positive control.
+
+use emergent_lattice::chronon::Chronon;
+use emergent_lattice::law::{Body, Law, Response, World};
+use emergent_lattice::Stepper;
+
+const Q: i64 = 1 << 20;
+
+#[derive(Clone, Copy)]
+struct Line {
+    x: [f64; 2],
+    beta: [f64; 2],
+}
+
+/// Exact boost (velocity `w` along `axis`) of a worldline's t = 0 presentation
+/// to the t' = 0 presentation of the same line in the boosted frame.
+fn boost(l: Line, w: f64, axis: usize) -> Line {
+    let o = 1 - axis;
+    let g = 1.0 / (1.0 - w * w).sqrt();
+    let t = w * l.x[axis] / (1.0 - w * l.beta[axis]); // t' = 0 slice along this line
+    let mut x = [0.0; 2];
+    x[axis] = g * ((l.x[axis] + l.beta[axis] * t) - w * t);
+    x[o] = l.x[o] + l.beta[o] * t;
+    let mut beta = [0.0; 2];
+    beta[axis] = (l.beta[axis] - w) / (1.0 - w * l.beta[axis]);
+    beta[o] = l.beta[o] / (g * (1.0 - w * l.beta[axis]));
+    Line { x, beta }
+}
+
+fn gamma(b2: f64) -> f64 {
+    1.0 / (1.0 - b2).sqrt()
+}
+
+/// Pair COM velocity (vector) of two bodies from velocities and masses.
+fn com_velocity(ba: [f64; 2], bb: [f64; 2], ma: f64, mb: f64) -> [f64; 2] {
+    let (ga, gb) = (gamma(ba[0] * ba[0] + ba[1] * ba[1]), gamma(bb[0] * bb[0] + bb[1] * bb[1]));
+    let e = ma * ga + mb * gb;
+    [(ma * ga * ba[0] + mb * gb * bb[0]) / e, (ma * ga * ba[1] + mb * gb * bb[1]) / e]
+}
+
+/// Boost a momentum (E, p) by frame velocity v (vector), returning (E', p').
+fn boost_momentum(e: f64, p: [f64; 2], v: [f64; 2]) -> (f64, [f64; 2]) {
+    let v2 = v[0] * v[0] + v[1] * v[1];
+    if v2 < 1e-24 {
+        return (e, p);
+    }
+    let g = gamma(v2);
+    let pdv = p[0] * v[0] + p[1] * v[1];
+    let e2 = g * (e - pdv);
+    let f = ((g - 1.0) * pdv / v2 - g * e) / v2.sqrt();
+    (e2, [p[0] + f * v[0], p[1] + f * v[1]])
+}
+
+fn wrap(a: f64) -> f64 {
+    let mut a = a.rem_euclid(2.0 * std::f64::consts::PI);
+    if a > std::f64::consts::PI {
+        a -= 2.0 * std::f64::consts::PI;
+    }
+    a
+}
+
+/// A's momentum direction (angle) in the pair COM from lattice integer velocities.
+fn theta_com_law(ka: [i64; 2], kb: [i64; 2], ma: f64, mb: f64) -> f64 {
+    let ba = [ka[0] as f64 / Q as f64, ka[1] as f64 / Q as f64];
+    let bb = [kb[0] as f64 / Q as f64, kb[1] as f64 / Q as f64];
+    let ga = gamma(ba[0] * ba[0] + ba[1] * ba[1]);
+    let pa = [ma * ga * ba[0], ma * ga * ba[1]];
+    let vc = com_velocity(ba, bb, ma, mb);
+    let (_e, p) = boost_momentum(ma * ga, pa, vc);
+    p[1].atan2(p[0])
+}
+
+/// The covariant f64 reference: resolve the same pair at the COM-simultaneous
+/// contact |d| = reach, reflect A's COM momentum about d̂. Consumes exactly the
+/// integer-rounded data the engine got. Returns (incoming, outgoing) angles of
+/// A's COM momentum, or None with a reason on stderr.
+fn reference(xa: [f64; 2], ka: [i64; 2], xb: [f64; 2], kb: [i64; 2], ma: f64, mb: f64, reach: f64, tag: &str) -> Option<(f64, f64)> {
+    let ba = [ka[0] as f64 / Q as f64, ka[1] as f64 / Q as f64];
+    let bb = [kb[0] as f64 / Q as f64, kb[1] as f64 / Q as f64];
+    let ga = gamma(ba[0] * ba[0] + ba[1] * ba[1]);
+    let pa = [ma * ga * ba[0], ma * ga * ba[1]];
+    let vc = com_velocity(ba, bb, ma, mb);
+    let v2 = vc[0] * vc[0] + vc[1] * vc[1];
+    let (g, vn) = if v2 < 1e-24 { (1.0, 0.0) } else { (gamma(v2), v2.sqrt()) };
+    // COM-simultaneous separation as a function of A's lattice time ta
+    // (chronons); all boost arithmetic below runs in light-quanta, T = ta*Q.
+    let dcom = |ta: f64| -> [f64; 2] {
+        let big_t = ta * Q as f64;
+        let tau_a = g * (big_t - (vc[0] * (xa[0] + ba[0] * big_t) + vc[1] * (xa[1] + ba[1] * big_t)));
+        let cb = 1.0 - (vc[0] * bb[0] + vc[1] * bb[1]);
+        let tb = (tau_a / g + (vc[0] * xb[0] + vc[1] * xb[1])) / cb;
+        let dt = tb - big_t;
+        let dx = [xb[0] + bb[0] * tb - xa[0] - ba[0] * big_t, xb[1] + bb[1] * tb - xa[1] - ba[1] * big_t];
+        if vn == 0.0 {
+            return dx;
+        }
+        let par = (dx[0] * vc[0] + dx[1] * vc[1]) / vn;
+        let f = ((g - 1.0) * par - g * dt * vn) / vn;
+        [dx[0] + f * vc[0], dx[1] + f * vc[1]]
+    };
+    let dist = |ta: f64| (dcom(ta)[0] * dcom(ta)[0] + dcom(ta)[1] * dcom(ta)[1]).sqrt();
+    if dist(0.0) <= reach {
+        eprintln!("ref-none[{tag}]: starts in contact (dist {} reach {})", dist(0.0), reach);
+        return None;
+    }
+    // Linear scan (0.25 chronons) to catch the contact window, then bisect the
+    // approach-side crossing. The window is at least 2*sqrt(1-u^2)*rho ~ 5.7
+    // chronons wide at u = 0.7, so a 0.25 step cannot miss it.
+    let step = 0.25f64;
+    let mut t = step;
+    let mut hi = None;
+    while t < 512.0 {
+        if dist(t) <= reach {
+            hi = Some(t);
+            break;
+        }
+        t += step;
+    }
+    let Some(mut hi) = hi else {
+        eprintln!("ref-none[{tag}]: never within reach");
+        return None;
+    };
+    let mut lo = hi - step;
+    for _ in 0..200 {
+        let m = 0.5 * (lo + hi);
+        if dist(m) > reach {
+            lo = m;
+        } else {
+            hi = m;
+        }
+    }
+    let d = dcom(hi);
+    let dd = (d[0] * d[0] + d[1] * d[1]).sqrt();
+    let n = [d[0] / dd, d[1] / dd];
+    if dot <= 0.0 {
+        let mut tdbg = step;
+        let mut dmin = f64::INFINITY;
+        let mut tmin = 0.0;
+        while tdbg < 512.0 {
+            let dd = dist(tdbg);
+            if dd < dmin {
+                dmin = dd;
+                tmin = tdbg;
+            }
+            tdbg += step;
+        }
+        eprintln!("ref-none[{tag}]: not approaching at contact (dot {dot:.3}, min dist {dmin:.0} = {:.3} reach at t {tmin}, n ({:.3},{:.3}), pia ({:.3},{:.3}))", dmin / reach, n[0], n[1], pia[0], pia[1]);
+        return None;
+    }
+    let po = [pia[0] - 2.0 * dot * n[0], pia[1] - 2.0 * dot * n[1]];
+    Some((pia[1].atan2(pia[0]), po[1].atan2(po[0])))
+}
+
+fn isqrt(n: i128) -> i128 {
+    let (mut lo, mut hi) = (0i128, 1i128 << 63);
+    while lo < hi {
+        let m = (lo + hi + 1) / 2;
+        if m * m <= n {
+            lo = m;
+        } else {
+            hi = m - 1;
+        }
+    }
+    lo
+}
+
+/// v1 exact energy: m * floor(2 Q^3 / sqrt(Q^2 - |k|^2)).
+fn energy_v1(m: i64, k: [i64; 2]) -> i128 {
+    let kk = (k[0] as i128) * (k[0] as i128) + (k[1] as i128) * (k[1] as i128);
+    let q = Q as i128;
+    m as i128 * isqrt(4 * q * q * q * q * q * q / (q * q - kk))
+}
+
+/// v1 exact momentum component: sgn * m * floor(2 Q^2 |k_c| / sqrt(Q^2 - |k|^2)).
+fn momentum_v1(m: i64, k: [i64; 2], c: usize) -> i128 {
+    let kk = (k[0] as i128) * (k[0] as i128) + (k[1] as i128) * (k[1] as i128);
+    let q = Q as i128;
+    let kc = k[c] as i128;
+    m as i128 * isqrt(4 * q * q * q * q * kc.abs() * kc.abs() / (q * q - kk)) * kc.signum()
+}
+
+struct Arm {
+    beta_rel: f64,
+    u: f64,
+    wboost: f64,
+    axis: usize,
+    mass_ratio: i64,
+    phase: f64,
+    exchanged: bool,
+    contacts: u64,
+    theta_in: f64,
+    theta_out: f64,
+    defl_law: f64,
+    defl_ref: f64,
+    tilt: f64,
+    ledger: bool,
+}
+
+/// Run one arm: the two worldlines defined in frame S (closing along x, impact
+/// parameter u * reach, rho = reach/|w| = 4 — the resolving regime, skip-free
+/// at every u <= 0.7), presented in the frame boosted by `wboost` along `axis`.
+/// `phase` shifts A's initial x by that fraction of one chronon of closing.
+fn arm(beta_rel: f64, u: f64, wboost: f64, axis: usize, mass_ratio: i64, phase: f64) -> Arm {
+    let wmag = 8.0 * (beta_rel * Q as f64 / 8.0).round();
+    let reach = 4.0 * wmag;
+    let r = 0.5 * reach;
+    // Velocities: zero total momentum, SR relative speed beta_rel (solve for the split).
+    let (ma, mb) = (mass_ratio as f64, 1.0);
+    let p_of = |fa: f64| {
+        let ba = fa * beta_rel;
+        let bb = -(1.0 - fa) * beta_rel;
+        (ma * gamma(ba * ba) * ba + mb * gamma(bb * bb) * bb, (ba - bb) / (1.0 - ba * bb))
+    };
+    let (mut flo, mut fhi) = (1e-9f64, 1.0 - 1e-9);
+    for _ in 0..200 {
+        let fm = 0.5 * (flo + fhi);
+        if p_of(fm).0 > 0.0 {
+            fhi = fm;
+        } else {
+            flo = fm;
+        }
+    }
+    let f = 0.5 * (flo + fhi);
+    let ba = f * beta_rel;
+    let bb = -(1.0 - f) * beta_rel;
+    // Frame-S presentation, then the boosted one, rounded to lattice integers.
+    let l = 3.0 * reach;
+    let la = Line { x: [-0.5 * l + phase * wmag, -0.5 * u * reach], beta: [ba, 0.0] };
+    let lb = Line { x: [0.5 * l, 0.5 * u * reach], beta: [bb, 0.0] };
+    let (la2, lb2) = if wboost == 0.0 { (la, lb) } else { (boost(la, wboost, axis), boost(lb, wboost, axis)) };
+    let xa = [la2.x[0].round() as i64, la2.x[1].round() as i64];
+    let xb = [lb2.x[0].round() as i64, lb2.x[1].round() as i64];
+    let ka = [(Q as f64 * la2.beta[0]).round() as i64, (Q as f64 * la2.beta[1]).round() as i64];
+    let kb = [(Q as f64 * lb2.beta[0]).round() as i64, (Q as f64 * lb2.beta[1]).round() as i64];
+
+    // Shipped law.
+    let bodies = vec![
+        Body::new(0, xa, ka, mass_ratio, r as i64, Response::Bounce),
+        Body::new(1, xb, kb, 1, r as i64, Response::Bounce),
+    ];
+    let world = World::new(Q, None, bodies).unwrap().with_law(Law::RelativisticV1).unwrap();
+    let e0 = [energy_v1(mass_ratio, ka) + energy_v1(1, kb), momentum_v1(mass_ratio, ka, 0) + momentum_v1(1, kb, 0), momentum_v1(mass_ratio, ka, 1) + momentum_v1(1, kb, 1)];
+    let mut c = Chronon::new(world, true).unwrap();
+    c.run_to(64);
+    let wf = c.world();
+    let (ka2, kb2) = (wf.bodies[0].k, wf.bodies[1].k);
+    let exchanged = ka2 != ka || kb2 != kb;
+    let contacts = c.log().contacts;
+    let e1 = [
+        energy_v1(mass_ratio, ka2) + energy_v1(1, kb2) + wf.bodies[0].residual as i128 + wf.bodies[1].residual as i128,
+        momentum_v1(mass_ratio, ka2, 0) + momentum_v1(1, kb2, 0) + wf.bodies[0].carry[0] as i128 + wf.bodies[1].carry[0] as i128,
+        momentum_v1(mass_ratio, ka2, 1) + momentum_v1(1, kb2, 1) + wf.bodies[0].carry[1] as i128 + wf.bodies[1].carry[1] as i128,
+    ];
+    let ledger = e1 == e0;
+
+    // Outcome in the pair COM (incoming and outgoing), plus the covariant
+    // reference on the identical integers.
+    let theta_in_law = theta_com_law(ka, kb, ma, mb);
+    let theta_out = if exchanged { theta_com_law(ka2, kb2, ma, mb) } else { f64::NAN };
+    let (defl_law, defl_ref, tilt) = match reference(
+        [xa[0] as f64, xa[1] as f64],
+        ka,
+        [xb[0] as f64, xb[1] as f64],
+        kb,
+        ma,
+        mb,
+        reach,
+        &format!("b{beta_rel} u{u} W{wboost:+} ax{axis} m{mass_ratio} ph{phase}"),
+    ) {
+        Some((i, o)) => {
+            let dl = if exchanged { wrap(theta_out - theta_in_law) } else { f64::NAN };
+            let dr = wrap(o - i);
+            let t = if exchanged { wrap(dl - dr) } else { f64::NAN };
+            (dl, dr, t)
+        }
+        None => (f64::NAN, f64::NAN, f64::NAN),
+    };
+    Arm { beta_rel, u, wboost, axis, mass_ratio, phase, exchanged, contacts, theta_in: theta_in_law, theta_out, defl_law, defl_ref, tilt, ledger }
+}
+
+fn main() {
+    let stdout = std::io::stdout().lock();
+    let mut out = std::io::BufWriter::new(stdout);
+    use std::io::Write;
+
+    let mut arms: Vec<Arm> = Vec::new();
+    for beta in [0.2f64, 0.4, 0.6, 0.9] {
+        for u in [0.0f64, 0.25, 0.45, 0.7] {
+            for w in [-0.5f64, -0.3, -0.1, 0.0, 0.1, 0.3, 0.5] {
+                arms.push(arm(beta, u, w, 0, 1, 0.0));
+            }
+        }
+    }
+    for w in [-0.5f64, -0.3, 0.0, 0.3, 0.5] {
+        arms.push(arm(0.6, 0.45, w, 1, 1, 0.0));
+    }
+    for w in [-0.5f64, -0.3, -0.1, 0.0, 0.1, 0.3, 0.5] {
+        arms.push(arm(0.6, 0.45, w, 0, 16, 0.0));
+    }
+    for phase in [0.0f64, 0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875] {
+        arms.push(arm(0.6, 0.45, 0.0, 0, 1, phase));
+    }
+
+    writeln!(out, "beta,u,w,axis,mratio,phase,exchanged,contacts,theta_in,theta_out,defl_law_deg,defl_ref_deg,tilt_deg,ledger").unwrap();
+    for a in &arms {
+        writeln!(
+            out,
+            "{:.2},{},{:+.2},{},{},{:.3},{},{},{:.6},{:.6},{:+.4},{:+.4},{:+.4},{}",
+            a.beta_rel, a.u, a.wboost, a.axis, a.mass_ratio, a.phase, a.exchanged as i32, a.contacts,
+            a.theta_in, a.theta_out, a.defl_law.to_degrees(), a.defl_ref.to_degrees(), a.tilt.to_degrees(), a.ledger as i32
+        )
+        .unwrap();
+    }
+
+    // Per-cell swing: max |deflection(W) - deflection(0)| for the law and the reference.
+    writeln!(out).unwrap();
+    writeln!(out, "# cell,arms,exchanged,law_swing_deg,ref_swing_deg,max|tilt|_deg,ledger_all").unwrap();
+    let mut cells: Vec<(f64, f64, usize, i64)> = Vec::new();
+    for beta in [0.2f64, 0.4, 0.6, 0.9] {
+        for u in [0.0f64, 0.25, 0.45, 0.7] {
+            cells.push((beta, u, 0, 1));
+        }
+    }
+    cells.push((0.6, 0.45, 1, 1));
+    cells.push((0.6, 0.45, 0, 16));
+    for &(beta, u, axis, mr) in &cells {
+        let rows: Vec<&Arm> = arms.iter().filter(|a| a.beta_rel == beta && a.u == u && a.axis == axis && a.mass_ratio == mr && a.phase == 0.0).collect();
+        let base = rows.iter().find(|a| a.wboost == 0.0 && a.exchanged && a.defl_law.is_finite() && a.defl_ref.is_finite());
+        let Some(base) = base else {
+            writeln!(out, "# b{beta}_u{u}_ax{axis}_m{mr}: NO VALID BASE ARM").unwrap();
+            continue;
+        };
+        let (mut law_sw, mut ref_sw, mut max_tilt, mut exch) = (0.0f64, 0.0f64, 0.0f64, 0usize);
+        let mut ledger_all = true;
+        for a in &rows {
+            ledger_all &= a.ledger;
+            if !a.exchanged || !a.defl_law.is_finite() {
+                continue;
+            }
+            exch += 1;
+            law_sw = law_sw.max((a.defl_law - base.defl_law).abs());
+            if a.defl_ref.is_finite() {
+                ref_sw = ref_sw.max((a.defl_ref - base.defl_ref).abs());
+            }
+            if a.tilt.is_finite() {
+                max_tilt = max_tilt.max(a.tilt.abs());
+            }
+        }
+        writeln!(out, "b{beta:.2}_u{u}_ax{axis}_m{mr},{},{},{:.3},{:.6},{:.3},{}", rows.len(), exch, law_sw.to_degrees(), ref_sw.to_degrees(), max_tilt.to_degrees(), ledger_all).unwrap();
+    }
+
+    // Arrival-phase scan at W = 0 (same frame): the instrument's separating control.
+    let ph: Vec<&Arm> = arms.iter().filter(|a| a.beta_rel == 0.6 && a.u == 0.45 && a.axis == 0 && a.mass_ratio == 1 && a.wboost == 0.0).collect();
+    if let Some(b0) = ph.iter().find(|a| a.phase == 0.0 && a.exchanged) {
+        let (mut law_sw, mut ref_sw) = (0.0f64, 0.0f64);
+        for a in &ph {
+            if a.exchanged && a.defl_law.is_finite() {
+                law_sw = law_sw.max((a.defl_law - b0.defl_law).abs());
+                ref_sw = ref_sw.max((a.defl_ref - b0.defl_ref).abs());
+            }
+        }
+        writeln!(out, "# phase_scan b0.60_u0.45: phases {}, law spread {:.3} deg, ref spread {:.6} deg", ph.len(), law_sw.to_degrees(), ref_sw.to_degrees()).unwrap();
+    }
+}
