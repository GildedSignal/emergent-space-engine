+/// The live-amendment stream: what each distinct kick changes about a body's program and binding.
+/// game-second). Channels: the Q48 k-axis (1/(1+e)) delta in lattice quanta, the quantized memo
+/// code (12+12 bits) revisit structure, and the binding residual's four i128 components by
+/// magnitude bucket (log2).
+#[derive(Default)]
+struct Amendments {
+    kicks: u64,
+    passages: u64,
+    dk_exact: HashMap<i64, u64>,
+    dk_far: u64,
+    first_kick: u64,
+    revisits: u64,
+    memo_fail: u64,
+    res: [HashMap<i32, u64>; 4],
+    per_body: HashMap<usize, u64>,
+}
+impl Amendments {
+    fn bucket(x: i128) -> i32 {
+        let m = x.unsigned_abs();
+        if m == 0 {
+            -1
+        } else {
+            127 - m.leading_zeros() as i32
+        }
+    }
+    #[allow(clippy::too_many_arguments)]
+    fn note(
+        &mut self,
+        i: usize,
+        t: &Trajectory,
+        residual: Residual,
+        last_k: &mut Vec<Option<u64>>,
+        visited: &mut Vec<Option<HashSet<u64>>>,
+    ) {
+        self.kicks += 1;
+        *self.per_body.entry(i).or_default() += 1;
+        let key = t.key();
+        if !matches!(t, Trajectory::Cycle(_)) {
+            self.passages += 1;
+        }
+        if let Some(prev) = last_k[i] {
+            let dk = key.k as i64 - prev as i64;
+            let bucket = if dk.unsigned_abs() <= 8 {
+                dk
+            } else {
+                dk.signum() * (63 - dk.unsigned_abs().leading_zeros() as i64)
+            };
+            *self.dk_exact.entry(bucket).or_default() += 1;
+        } else {
+            self.first_kick += 1;
+        }
+        last_k[i] = Some(key.k);
+        match MemoCode::encode(key) {
+            Ok(code) => {
+                let bits = code.bits();
+                let seen = visited[i].get_or_insert_with(HashSet::new);
+                if !seen.insert(bits) {
+                    self.revisits += 1;
+                }
+            }
+            Err(_) => self.memo_fail += 1,
+        }
+        for (c, x) in residual
+            .position
+            .iter()
+            .chain(residual.velocity.iter())
+            .enumerate()
+        {
+            *self.res[c].entry(Self::bucket(*x)).or_default() += 1;
+        }
+    }
+    fn entropy<K: std::hash::Hash + Eq>(h: &HashMap<K, u64>) -> f64 {
+        let n: u64 = h.values().sum();
+        if n == 0 {
+            return 0.0;
+        }
+        h.values().map(|&c| {
+            let p = c as f64 / n as f64;
+            -p * p.log2()
+        }).sum()
+    }
+    fn json(&self, bodies_at_risk: usize, game_seconds: f64) -> serde_json::Value {
+        json!({
+            "distinct_kicks": self.kicks,
+            "passages": self.passages,
+            "bodies_that_kicked": self.per_body.len(),
+            "bodies_at_risk": bodies_at_risk,
+            "kicks_per_body_per_game_second": self.per_body.values().map(|&c| c as f64).sum::<f64>()
+                / bodies_at_risk.max(1) as f64 / game_seconds.max(1e-9),
+            "mean_kicks_per_kicking_body": self.kicks as f64 / self.per_body.len().max(1) as f64,
+            "dk_bits_bucket_entropy": Self::entropy(&self.dk_exact),
+            "dk_far_outside_pm4096": self.dk_far,
+            "dk_histogram": self.dk_exact,
+            "memo_revisit_rate": self.revisits as f64 / self.kicks.max(1) as f64,
+            "memo_encode_failures": self.memo_fail,
+            "residual_bucket_entropy_bits": self.res.iter().map(Self::entropy).collect::<Vec<_>>(),
+            "residual_zero_fraction": self.res.iter().map(|h| *h.get(&(-1)).unwrap_or(&0) as f64
+                / h.values().sum::<u64>().max(1) as f64).collect::<Vec<_>>(),
+            "game_seconds": game_seconds,
+        })
+    }
+}
