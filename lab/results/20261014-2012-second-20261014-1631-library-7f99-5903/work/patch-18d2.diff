+pub mod probe {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+    pub static GATE: AtomicBool = AtomicBool::new(false);
+    pub static WOULD_CAPTURE: AtomicU64 = AtomicU64::new(0);
+    pub static WOULD_RELEASE: AtomicU64 = AtomicU64::new(0);
+    pub static REFIT_REFUSED: AtomicU64 = AtomicU64::new(0);
