+    pub static LAST: AtomicU64 = AtomicU64::new(0);
+    pub static CALLS: AtomicU64 = AtomicU64::new(0);
+    pub static NONE_DOLL: AtomicU64 = AtomicU64::new(0);
+    pub static NONE_WIDTH: AtomicU64 = AtomicU64::new(0);
+    pub static NONE_HORIZON: AtomicU64 = AtomicU64::new(0);
+    /// `hit + unbounded` over calls that returned Some: the certificate's own keep set.
+    pub static KEPT_SOME: AtomicU64 = AtomicU64::new(0);
+    pub static CALLS_SOME: AtomicU64 = AtomicU64::new(0);
+    pub static LINES: Mutex<Vec<String>> = Mutex::new(Vec::new());
