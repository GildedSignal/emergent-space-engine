+pub mod census {
+    use std::cell::Cell;
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+    pub static ON: AtomicBool = AtomicBool::new(false);
+    pub static MINTS: AtomicU64 = AtomicU64::new(0);
+    pub static COMPILE_NS: AtomicU64 = AtomicU64::new(0);
+    pub static READS_STATE: AtomicU64 = AtomicU64::new(0);
+    pub static READS_RADIUS: AtomicU64 = AtomicU64::new(0);
+    pub static MINT_OWN: AtomicU64 = AtomicU64::new(0);
+
+    thread_local! {
+        pub static IN_MINT: Cell<bool> = const { Cell::new(false) };
+    }
+
+    #[inline]
+    pub fn enabled() -> bool {
+        ON.load(Ordering::Relaxed)
+    }
+
+    pub fn init() {
+        if std::env::var("ES_MINT_CENSUS").as_deref() == Ok("1") {
+            ON.store(true, Ordering::Relaxed);
+        }
+    }
+
+    /// One mint: a compile of a fresh trajectory; its reads belong to the mint, not to the world.
+    pub struct Mint;
+    impl Mint {
+        #[inline]
+        pub fn enter() -> Option<Self> {
+            enabled().then(|| {
+                MINTS.fetch_add(1, Ordering::Relaxed);
+                IN_MINT.with(|f| f.set(true));
+                Self
+            })
+        }
+    }
+    impl Drop for Mint {
+        fn drop(&mut self) {
+            IN_MINT.with(|f| f.set(false));
+        }
+    }
+
+    #[inline]
+    pub fn clock() -> Option<std::time::Instant> {
+        enabled().then(std::time::Instant::now)
+    }
+
+    #[inline]
+    pub fn compile_elapsed(clock: Option<std::time::Instant>) {
+        if let Some(c) = clock {
+            COMPILE_NS.fetch_add(c.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        }
+    }
+
+    pub fn print() {
+        if enabled() {
+            println!(
+                "census[space]: mints {} compile_ms {:.1} reads_state {} reads_radius {} mint_own {}",
+                MINTS.load(Ordering::Relaxed),
+                COMPILE_NS.load(Ordering::Relaxed) as f64 / 1e6,
+                READS_STATE.load(Ordering::Relaxed),
+                READS_RADIUS.load(Ordering::Relaxed),
+                MINT_OWN.load(Ordering::Relaxed)
+            );
+        }
+    }
+}
