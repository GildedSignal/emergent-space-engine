+/// The same two numbers where libproc does not exist (the lab's Linux machines): resident now and
+/// its high-water mark from /proc/self/status, in bytes.
+#[cfg(not(target_os = "macos"))]
+fn footprint() -> (u64, u64) {
+    let kb = |line: &str| line.split_whitespace().next().and_then(|v| v.parse::<u64>().ok()).map(|kb| kb * 1024);
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    if let Ok(status) = std::fs::read_to_string("/proc/self/status") {
+        for line in status.lines() {
+            if let Some(v) = line.strip_prefix("VmRSS:") {
+                now = kb(v).unwrap_or(0);
+            } else if let Some(v) = line.strip_prefix("VmHWM:") {
+                peak = kb(v).unwrap_or(0);
+            }
+        }
+    }
+    (now, peak)
