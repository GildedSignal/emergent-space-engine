+//! The print-only universe census (lab run 20261020-1621-system-7fd3): fired kicks, rebinds and
+//! history walks beside the same paths, on only when `ES_MINT_CENSUS=1`. Counters are relaxed
+//! atomics; the shipped path is otherwise untouched.
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::time::Instant;
+
+pub static ON: AtomicBool = AtomicBool::new(false);
+pub static KICKS: AtomicU64 = AtomicU64::new(0);
+pub static KICK_NS: AtomicU64 = AtomicU64::new(0);
+pub static REBINDS: AtomicU64 = AtomicU64::new(0);
+pub static REBIND_NS: AtomicU64 = AtomicU64::new(0);
+pub static HIST_Q: AtomicU64 = AtomicU64::new(0);
+pub static HIST_HIT: AtomicU64 = AtomicU64::new(0);
+
+#[inline]
+pub fn enabled() -> bool {
+    ON.load(Ordering::Relaxed)
+}
+
+/// Times a whole function into `bucket` (a `?` return drops the guard, so nothing is missed).
+pub struct Timer(&'static AtomicU64, Instant);
+impl Timer {
+    #[inline]
+    pub fn start(bucket: &'static AtomicU64) -> Option<Self> {
+        enabled().then(|| Self(bucket, Instant::now()))
+    }
+}
+impl Drop for Timer {
+    fn drop(&mut self) {
+        self.0.fetch_add(self.1.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+}
+
+pub fn init() {
+    if std::env::var("ES_MINT_CENSUS").as_deref() == Ok("1") {
+        ON.store(true, Ordering::Relaxed);
+        emergent_space::binding::census::init();
+    }
+}
+
+pub fn print() {
+    if enabled() {
+        println!(
+            "ucensus[universe]: kicks {} kick_ms {:.1} rebinds {} rebind_ms {:.1} hist_queries {} hist_hits {}",
+            KICKS.load(Ordering::Relaxed),
+            KICK_NS.load(Ordering::Relaxed) as f64 / 1e6,
+            REBINDS.load(Ordering::Relaxed),
+            REBIND_NS.load(Ordering::Relaxed) as f64 / 1e6,
+            HIST_Q.load(Ordering::Relaxed),
+            HIST_HIT.load(Ordering::Relaxed)
+        );
+    }
+}
