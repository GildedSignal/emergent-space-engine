diff --git a/crates/space/src/orbit/jet.rs b/crates/space/src/orbit/jet.rs
new file mode 100644
index 0000000..92b7cd2
--- /dev/null
+++ b/crates/space/src/orbit/jet.rs
@@ -0,0 +1,130 @@
+//! The law's jet (docs/law.md, "Not adopted"), built as a lab experiment only
+//! (run 20261008-0338-second): a body keeps its exactly-compiled weak-branch shape,
+//! and a kick corrects the knot tables by the stored derivative of the knot integrals
+//! (a first-order offset in the dimensionless shape parameter gap = 2k−1), re-anchoring
+//! (exact recompile) when the accumulated offset crosses a bound. The derived fields
+//! (clock numerators, floor, quad parameters) are recomputed exactly at the new key, so
+//! only the cumulative knot sums carry the first-order correction; their residual error
+//! is the second-order term C·(Δgap/gap)² that the re-anchor bound controls.
+//!
+//! Additive only: no shipped path calls this module. The weak branch only (ShapeKey
+//! compactness zero): the plane's whole population; the strong field needs the q
+//! dimension and is out of this experiment's scope (fallback there is the exact compile).
+use super::{Integral, Orbit, OrbitKey, OrbitShape, Scalar, ShapeKey, HALF, UNIT};
+use crate::{Error, Result};
+use std::sync::Arc;
+
+/// Why a jetted read was not produced.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum JetError {
+    /// The accumulated offset crossed the bound (or the jet is unanchored): re-anchor exactly.
+    ReAnchor,
+    /// The key is outside the jet's domain (strong field, circle, passage, refusal).
+    Law(Error),
+}
+
+pub struct Jet {
+    /// The shape key the base tables are exact at (weak branch: compactness zero, k > 1/2).
+    anchor_k: u64,
+    base: Arc<OrbitShape>,
+    /// Cumulated forward difference of the knot sums on the base's fixed psi grid:
+    /// D_i = I(k₀+δ)_i − I(k₀)_i, undivided. The per-kick correction is D_i·(Δgap/δ).
+    diff: Vec<Integral>,
+    delta_raw: i128,
+    /// Cumulated |Δgap| since the anchor, for the error-law record.
+    pub drift_kicks: u64,
+}
+
+impl Jet {
+    /// Anchor at an exactly-compiled shape (the body's own bound cycle), pricing the
+    /// derivative table by one extra quadrature sweep at k₀+δ over the base's grid.
+    /// Refuses anything but weak-branch bound cycles.
+    pub fn anchor(shape: Arc<OrbitShape>) -> Result<Self> {
+        let key = shape.key;
+        if key.null || key.compactness != Scalar::ZERO || key.k <= HALF || key.k >= UNIT {
+            return Err(Error::NotPeriodic);
+        }
+        let gap_raw = 2 * key.k as i128 - UNIT as i128;
+        // A step of gap·2^-24: small enough that the forward-difference truncation
+        // (~δ·f'') sits far below the 10^-6 floor at any drift the bound allows, large
+        // enough to keep ~38 significant bits in the differenced tables.
+        let mut delta = (gap_raw >> 24).max(1);
+        if key.k as i128 + delta > UNIT as i128 {
+            delta = (UNIT as i128 - key.k as i128).max(1);
+        }
+        let plus = OrbitShape::new(ShapeKey {
+            k: (key.k as i128 + delta) as u64,
+            compactness: Scalar::ZERO,
+            null: false,
+        })?;
+        let mut diff = Vec::with_capacity(shape.knots.len());
+        let mut cum = Integral::default();
+        for w in shape.knots.windows(2) {
+            let (a, b) = (w[0].psi as i128, w[1].psi as i128);
+            // The base interval integral is the difference of successive cumulative sums.
+            let base_int = w[1].sum.subtract(w[0].sum)?;
+            let step = plus.quad(a, b)?.subtract(base_int)?;
+            cum = cum.add(step)?;
+            diff.push(cum);
+        }
+        Ok(Self { anchor_k: key.k, base: shape, diff, delta_raw: delta, drift_kicks: 0 })
+    }
+
+    /// The jetted read of `key`: base tables corrected to first order, derived fields
+    /// exact. `bound` > 0 re-anchors (Err(ReAnchor)) once |Δgap|/gap exceeds it; 0 never
+    /// re-anchors (the drift-measurement mode).
+    pub fn orbit(&mut self, key: OrbitKey, bound: f64) -> std::result::Result<Orbit, JetError> {
+        let sk = ShapeKey::for_orbit(key).map_err(JetError::Law)?;
+        if sk.compactness != Scalar::ZERO || key.k <= HALF || key.k >= UNIT {
+            return Err(JetError::Law(Error::NotPeriodic));
+        }
+        let dgap = 2 * key.k as i128 - 2 * self.anchor_k as i128;
+        if bound > 0.0
+            && dgap.abs() as f64 > bound * (2 * self.anchor_k as i128 - UNIT as i128) as f64
+        {
+            return Err(JetError::ReAnchor);
+        }
+        // The derivative table was differenced at k₀+δ (k units); gap = 2k−1, so the
+        // correction is D·(Δgap/2)/δ.
+        let rho = match Scalar::raw(dgap, -48)
+            .and_then(|d| d.div(Scalar::raw(2 * self.delta_raw, -48)?))
+        {
+            Ok(r) => r,
+            Err(e) => return Err(JetError::Law(e)),
+        };
+        let jetted = self.corrected(key, sk, rho).map_err(JetError::Law)?;
+        self.drift_kicks += 1;
+        Ok(jetted)
+    }
+
+    /// |Δgap|/gap since the anchor, the drift the error law is written in.
+    pub fn drift(&self, key: OrbitKey) -> f64 {
+        let dgap = 2 * key.k as i128 - 2 * self.anchor_k as i128;
+        dgap.abs() as f64 / (2 * self.anchor_k as i128 - UNIT as i128) as f64
+    }
+
+    fn corrected(&self, key: OrbitKey, sk: ShapeKey, rho: Scalar) -> Result<Orbit> {
+        let tmpl = OrbitShape::new(sk)?;
+        let mut s = (*self.base).clone();
+        s.k = tmpl.k;
+        s.q = tmpl.q;
+        s.t_numerator = tmpl.t_numerator;
+        s.tau_numerator = tmpl.tau_numerator;
+        s.weak_tau_term = tmpl.weak_tau_term;
+        s.floor = tmpl.floor;
+        s.fast = tmpl.fast;
+        s.word_root = tmpl.word_root;
+        s.clock_shift = tmpl.clock_shift;
+        s.clock_factor = tmpl.clock_factor;
+        s.key = sk;
+        for (knot, d) in s.knots.iter_mut().skip(1).zip(self.diff.iter()) {
+            let mut sum = knot.sum;
+            for i in 0..5 {
+                sum.0[i] = sum.0[i].add(d.0[i].mul(rho)?)?;
+            }
+
+            knot.sum = sum;
+        }
+        Orbit::from_shape(key, Arc::new(s))
+    }
+}
