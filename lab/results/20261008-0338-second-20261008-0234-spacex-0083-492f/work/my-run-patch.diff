+
+/// Lab experiment hook (run 20261008-0338-second): [`Self::from_state`] with the bound
+/// cycle supplied by the caller (the jet, `crate::orbit::Jet`). Additive only; the shipped
+/// `from_state` never routes through it, and with `Orbit::compile` as the hook it must be
+/// bit-identical to `from_state` (the bench asserts this control).
+pub fn from_state_with(
+    state: IntegerState,
+    event_time: Scalar,
+    passage_edge: Option<Scalar>,
+    cycle: &mut dyn FnMut(OrbitKey) -> Result<Orbit>,
+) -> Result<Self> {
+    let (key, r, clockwise, incoming) = fit_key(state, true)?;
+    let trajectory = if key.periodic() {
+        Trajectory::Cycle(cycle(key)?)
+    } else {
+        Trajectory::Passage(Passage::compile(key, passage_edge.unwrap_or(r.scale(1)?))?)
+    };
+    let (mut offset, mut sample) = trajectory.at_radius(r)?;
+    if incoming {
+        offset = offset.negate();
+        sample.reflect();
+    }
+    let (p, _) = state.components()?;
+    let at = angle(p[0], p[1])?;
+    let orientation = (at - if clockwise { -phase(sample)? } else { phase(sample)? }).rem_euclid(2 * PI);
+    let periapsis_angle = ((orientation << 32) / (2 * PI)) as u32;
+    let mut fit = Self {
+        trajectory,
+        periapsis_time: event_time.sub(offset)?,
+        periapsis_angle,
+        clockwise,
+        residual: Residual {
+            position: [0; 2],
+            velocity: [0; 2],
+        },
+        event_time,
+        units: (state.length_exponent, state.velocity_exponent),
+    };
+    fit.residual = Residual::between(state, fit.decoded_event()?);
+    Ok(fit)
+}
