+#[cfg(target_os = "linux")]
+mod linux_mem {
+    /// (resident now, its peak) in bytes, from /proc: this example's macOS footprint probe has no
+    /// counterpart here, so the resident size stands in (disclosed: compressed pages are not counted).
+    pub fn footprint() -> (u64, u64) {
+        let mut now = 0u64;
+        let mut peak = 0u64;
+        if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+            for line in s.lines() {
+                if let Some(v) = line.strip_prefix("VmRSS:") {
+                    now = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0) * 1024;
+                } else if let Some(v) = line.strip_prefix("VmHWM:") {
+                    peak = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0) * 1024;
+                }
+            }
+        }
+        (now, peak)
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    linux_mem::footprint()
+}
