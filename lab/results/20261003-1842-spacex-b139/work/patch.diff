+// Temporary lab instrumentation (run 20261003-1842-spacex-b139): from_state stage accounting.
+type Stages = ([u128; 4], u64, u64, u64, std::collections::HashMap<crate::orbit::ShapeKey, u64>);
+thread_local! {
+    pub static STAGES: std::cell::RefCell<Stages> =
+        std::cell::RefCell::new(([0; 4], 0, 0, 0, std::collections::HashMap::new()));
+}
+/// Lab only: take and reset the from_state stage counters.
+pub fn take_stages() -> ([u128; 4], u64, u64, u64, usize, u64) {
+    STAGES.with(|s| {
+        let mut v = s.borrow_mut();
+        let distinct = v.4.len() as usize;
+        let repeat: u64 = v.4.values().map(|c| c - 1).sum();
+        let out = (v.0, v.1, v.2, v.3, distinct, repeat);
+        *v = ([0; 4], 0, 0, 0, std::collections::HashMap::new());
+        out
+    })
+}
+
+/// Lab A/B switch: when false, `from_state` compiles exactly as before (control arm).
+pub static MEMO_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+/// Lab seam (20261003-1842-spacex-b139): thread-local for measurement; the production seam
+/// is the resolver's worker context.
+fn shape_memo(key: crate::orbit::OrbitKey) -> Result<crate::orbit::Orbit> {
+    thread_local! {
+        static MEMO: std::cell::RefCell<crate::orbit::ShapeMemo> =
+            std::cell::RefCell::new(crate::orbit::ShapeMemo::default());
+    }
+    const CAP: usize = 4096;
+    MEMO.with(|m| {
+        let mut m = m.borrow_mut();
+        if m.len() >= CAP {
+            *m = crate::orbit::ShapeMemo::default();
+        }
+        m.get(key)
+    })
+}
 
