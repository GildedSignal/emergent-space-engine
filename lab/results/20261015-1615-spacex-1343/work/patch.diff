 /// (physical footprint now, its peak over the process's life) in bytes: the memory the process holds, compressed pages
 /// included (the resident size alone drops pages the machine has compressed or swapped, and this machine does under load).
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    // VmRSS now, VmHWM peak, from /proc (kB): the closest Linux analogue of the physical
+    // footprint; compressed pages are not recoverable here, so both are lower bounds.
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+        for line in s.lines() {
+            if let Some(v) = line.strip_prefix("VmRSS:") {
+                now = v.trim().trim_end_matches(" kB").parse().unwrap_or(0) * 1024;
+            }
+            if let Some(v) = line.strip_prefix("VmHWM:") {
+                peak = v.trim().trim_end_matches(" kB").parse().unwrap_or(0) * 1024;
+            }
+        }
+    }
+    (now, peak)
+}
