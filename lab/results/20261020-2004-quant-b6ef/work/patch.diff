+/// Linux has no `proc_pid_rusage`: VmRSS (now) and VmHWM (peak) from /proc/self/status carry the same
+/// two numbers (resident, without the compressed pages a Mac account holds; disclosed, not equal).
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    for line in status.lines() {
+        if let Some(v) = line.strip_prefix("VmRSS:") {
+            now = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0) * 1024;
+        }
+        if let Some(v) = line.strip_prefix("VmHWM:") {
+            peak = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0) * 1024;
+        }
+    }
+    (now, peak)
+}
