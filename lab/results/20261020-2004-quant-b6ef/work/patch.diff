index 00000000..c2fb3c75
--- /dev/null
+++ b/crates/universe/src/scaffold.rs
@@ -0,0 +1,111 @@
+//! Print-only scaffold audit: the price of every stage of a rebind outside `Rebinding::from_state`
+//! (the frame-cost page's named unpriced term). Off (default): every helper is one relaxed load of a
+//! settled `LazyLock`; nothing else runs, the engine is what it was. On (`ES_SCAFFOLD_AUDIT=1`):
+//! wall nanoseconds and call counts accumulate in relaxed atomics beside the same paths, and
+//! `report` prints them. It computes no value the engine reads: digests cannot move.
+//!
+//! Buckets are disjoint by construction: the coarser-word retry's inner stages are suppressed while
+//! it runs (the retry window), so `RETRY` carries the whole second `bind_in`.
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::LazyLock;
+use std::time::Instant;
+
+pub const FIT: usize = 0; // `Rebinding::from_state` / `ending_at` (the fit incl. the compile)
+pub const PRE: usize = 1; // `bind_in`'s unit/time/edge conversions before the fit
+pub const TUBE: usize = 2; // `bind_in`'s peri/tube/entry/plunge block after the fit
+pub const TURN: usize = 3; // `bind_in`'s decode + turn + residual
+pub const WORD: usize = 4; // `bind_surface`'s `word_for`
+pub const RETRY: usize = 5; // `bind_surface`'s second `bind_in` (the coarser word), whole
+pub const TAU_T: usize = 6; // `Work::rebind`: `old.orbit_state(t)`
+pub const TAU_EV: usize = 7; // `Work::rebind`: `old.orbit_state(old.event_time)`
+pub const RETIRE: usize = 8; // `Work::rebind`: proper-time add, retired push, binding build, plan retain
+pub const TERM: usize = 9; // `Work::rebind`: `plan_terminal`
+pub const REBIND: usize = 10; // `Work::rebind` whole
+pub const BINDSURF: usize = 11; // `bind_surface` whole (every caller: rebinds, births, hand-outs)
+pub const KICK_READ: usize = 12; // `Work::kick`: `readout(t)` before the rebind (the same decode as TAU_T)
+pub const N: usize = 13;
+
+pub const NAMES: [&str; N] = [
+    "fit (Rebinding::from_state/ending_at)",
+    "pre-fit conversions (units/time/edge)",
+    "post-fit tube/entry/plunge",
+    "decode+turn+residual (new binding)",
+    "word_for",
+    "retry bind_in (coarser word)",
+    "tau read: orbit_state(t)",
+    "tau read: orbit_state(event_time)",
+    "retire+construct+retain",
+    "plan_terminal",
+    "rebind (whole)",
+    "bind_surface (whole, all callers)",
+    "kick readout(t) (decode identical to tau read)",
+];
+
+static ON: LazyLock<bool> = LazyLock::new(|| std::env::var("ES_SCAFFOLD_AUDIT").is_ok_and(|v| v != "0" && !v.is_empty()));
+static NS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+static CALLS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+static PAUSED: AtomicBool = AtomicBool::new(false);
+
+pub fn on() -> bool {
+    *ON
+}
+
+#[inline]
+pub fn t() -> Option<Instant> {
+    on().then(Instant::now)
+}
+
+#[inline]
+pub fn add(stage: usize, t0: Option<Instant>) {
+    if let Some(t0) = t0 {
+        if PAUSED.load(Ordering::Relaxed) {
+            return;
+        }
+        NS[stage].fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        CALLS[stage].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Suppress the inner-stage buckets while the retry's `bind_in` runs (RETRY itself is timed outside).
+#[inline]
+pub fn retry_window(t0: Option<Instant>) {
+    if t0.is_some() {
+        PAUSED.store(true, Ordering::Relaxed);
+    }
+}
+
+#[inline]
+pub fn retry_done(t0: Option<Instant>) {
+    if let Some(t0) = t0 {
+        PAUSED.store(false, Ordering::Relaxed);
+        add(RETRY, Some(t0));
+    }
+}
+
+/// Zero every counter (call between an example's build and its flight, so build-time bindings do not pollute).
+pub fn reset() {
+    for s in 0..N {
+        NS[s].store(0, Ordering::Relaxed);
+        CALLS[s].store(0, Ordering::Relaxed);
+    }
+}
+
+/// Print the bill: calls, µs per call, and each stage's share of the rebind wall and of `bind_surface`.
+pub fn report(scene: &str) {
+    if !on() {
+        return;
+    }
+    let (ns, calls): (Vec<u64>, Vec<u64>) = (0..N).map(|s| (NS[s].load(Ordering::Relaxed), CALLS[s].load(Ordering::Relaxed))).unzip();
+    let rebind_ns = ns[REBIND];
+    let bs_ns = ns[BINDSURF];
+    println!("scaffold audit ({scene}): rebind calls {}, bind_surface calls {} (every caller), rebind wall {:.2} µs/call, bind_surface wall {:.2} µs/call", calls[REBIND], calls[BINDSURF], rebind_ns as f64 / calls[REBIND].max(1) as f64 / 1e3, bs_ns as f64 / calls[BINDSURF].max(1) as f64 / 1e3);
+    for s in 0..N {
+        if calls[s] > 0 && s != REBIND && s != BINDSURF {
+            println!("  {:<46} calls {:>8}  {:>7.2} µs/call  {:>5.1}% of rebind  {:>5.1}% of bind_surface", NAMES[s], calls[s], ns[s] as f64 / calls[s] as f64 / 1e3, 100.0 * ns[s] as f64 / rebind_ns.max(1) as f64, 100.0 * ns[s] as f64 / bs_ns.max(1) as f64);
+        }
+    }
+    let inner: u64 = ns[PRE] + ns[FIT] + ns[TUBE] + ns[TURN] + ns[WORD] + ns[RETRY];
+    println!("  {:<46} {:>8}  {:>7.2} µs/call  (bind_surface inner sum; outside it: the rebind's tau/retire/term)", "sum of bind_in+word stages", 0, inner as f64 / calls[BINDSURF].max(1) as f64 / 1e3);
+    let outside: u64 = ns[TAU_T] + ns[TAU_EV] + ns[RETIRE] + ns[TERM];
+    println!("  {:<46} {:>8}  {:>7.2} µs/call  {:>5.1}% of rebind", "outside bind_surface (in rebind)", 0, outside as f64 / calls[REBIND].max(1) as f64 / 1e3, 100.0 * outside as f64 / rebind_ns.max(1) as f64);
+}
