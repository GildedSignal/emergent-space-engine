+
+/// The fixed per-frame cost of `Universe::advance` at the state the bench leaves the universe in after
+/// `warm` frames: `advance(target, Budget::events(0))` rekeys every deadline and does the queue and
+/// horizon bookkeeping, then stops at the first due item having bought **zero events** — the prologue
+/// every frame pays before any event is resolved. `rekey` alone is timed beside it for the split.
+fn prologue_bench(mut s: Session, iters: usize, warm: usize) -> crate::Result<u8> {
+    for _ in 0..warm {
+        s.step(None, 1.0 / 60.0)?;
+    }
+    let u = &mut s.p.u;
+    let target = u.now.saturating_add(1 << 40);
+    let t0 = Instant::now();
+    for _ in 0..iters {
+        std::hint::black_box(u.advance(target, emergent_universe::Budget::events(0)));
+    }
+    let prologue = t0.elapsed().as_secs_f64() / iters as f64 * 1e6;
+    let t1 = Instant::now();
+    for _ in 0..iters {
+        u.rekey();
+    }
+    let rekey = t1.elapsed().as_secs_f64() / iters as f64 * 1e6;
+    println!("{}", serde_json::to_string_pretty(&json!({
+        "bodies": s.n_bodies(), "frames_warm": warm, "iters": iters,
+        "prologue_us_per_frame": prologue, "rekey_us_per_frame": rekey,
+        "queue_bookkeeping_us": prologue - rekey,
+        "note": "advance(target, Budget::events(0)) = rekey + one queue peek, zero events bought; the fixed cost every frame pays"
+    })).map_err(|e| format!("json: {e}"))?);
+    Ok(0)
+}
