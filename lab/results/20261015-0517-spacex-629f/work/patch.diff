+//! The demote-after-kick seam's certificate (lab `20261015-0517-spacex-629f`): flies the ladder
+//! scene exactly as the scout's `promote` did (same frames, same presented times: `frame_to` is a
+//! pure function of its args, so a slow flight lands on the same digest), once with the seam off
+//! (shipped, the control) and once on (kicks demote: the compiled entry, its catalogue slot and
+//! the slot's index go; every read re-mints the entry by the pure `Orbit::compile(key)`), and
+//! prints both digests with the counters. Digest equality is the certificate: the digest reads
+//! key+sense+unit, and every kick after a promotion read a re-minted state and minted the same
+//! next key. The optional shared mint cache (`cache` arg, capacity) is the bounded form of
+//! "retain one mint per kick": one event chain's reads hit; standing memory stays the cap.
+//!
+//! cargo run --release -p emergent-universe --example lazy -- \
+//!     [<N> [coast|burn] [<wall s>] [lazy 0|1] [cache 0|N] [seed] [rtf]]
+use emergent_space::binding::Trajectory;
+use emergent_universe::bind::{lazy_counters, EntrySlot, LAZY_DEMOTE, MINT_CACHE};
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::{Budget, Config};
+use std::sync::atomic::Ordering;
+use std::time::{Duration, Instant};
+
+/// (resident bytes now, peak resident bytes) — Linux.
+fn footprint() -> (u64, u64) {
+    let statm = std::fs::read_to_string("/proc/self/statm").unwrap_or_default();
+    let rss = statm.split_whitespace().nth(1).and_then(|s| s.parse::<u64>().ok()).unwrap_or(0) * 4096;
+    let hwm = std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines().find(|l| l.starts_with("VmHWM:")).and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+        })
+        .unwrap_or(0)
+        * 1024;
+    (rss, hwm)
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(8.0);
+    let lazy: usize = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let cache: usize = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let seed: u64 = args.get(6).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let rtf: f64 = args.get(7).and_then(|s| s.parse().ok()).unwrap_or(6000.0);
+    let burn = flight == "burn";
+    let frames = (seconds * 60.0) as usize;
+    LAZY_DEMOTE.store(lazy != 0, Ordering::Relaxed);
+    MINT_CACHE.store(cache, Ordering::Relaxed);
+    let (rss0, _) = footprint();
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let (foot_build, _) = footprint();
+    let bodies = p.u.n_bodies();
+    let last_stats = p.u.stats;
+    let t_first = p.u.now;
+    for f in 0..frames {
+        let cap = std::env::var("LAZY_CAP_SECS").ok().and_then(|v| v.parse().ok()).unwrap_or(75);
+        if t_start.elapsed() > Duration::from_secs(cap) {
+            eprintln!("cap: stopped at frame {f}/{frames}");
+            break;
+        }
+        if f == 60 && burn {
+            let _ = p.u.input(p.u.now, word(1, 8));
+        }
+        let _ = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: None }, i64::MAX);
+    }
+    let wall = t_start.elapsed().as_secs_f64();
+    let (rss_end, hwm) = footprint();
+    let game_s = (p.u.now - t_first) as f64 * emergent_universe::view::TICK_SECONDS;
+    let kicks = p.u.stats.kicks - last_stats.kicks;
+    let (demotions, promotions, compiles) = lazy_counters();
+    // The census at the cut: standing compiled orbits (Live only — a demoted slot keeps none).
+    let (mut live, mut demoted, mut passages, mut plunges) = (0usize, 0usize, 0usize, 0usize);
+    let mut knots_bytes = 0u64;
+    for i in 0..bodies {
+        match &p.u.rec(i).b.entry {
+            EntrySlot::Live(e) => {
+                live += 1;
+                if let Trajectory::Cycle(o) = &e.trajectory {
+                    knots_bytes += (o.shape().knots().len() * std::mem::size_of::<emergent_space::orbit::Knot>()
+                        + o.shape().crossings().len() * std::mem::size_of::<usize>()) as u64;
+                    live += 0;
+                } else if matches!(e.trajectory, Trajectory::Passage(_)) {
+                    passages += 1;
+                } else {
+                    plunges += 1;
+                }
+            }
+            EntrySlot::Demoted { .. } => demoted += 1,
+        }
+    }
+    live -= passages + plunges;
+    println!(
+        "lazy: N={n} ({bodies} bodies) {flight} seed {seed} lazy={lazy} cache={cache}; build {build:.2} s, wall {wall:.1} s, {game_s:.0} game-s, kicks {kicks}; digest {}",
+        p.u.digest()
+    );
+    println!(
+        "seam: demotions {demotions} ({:.1}% of kicked bindings standing demoted), promotions {promotions} ({:.1}/demotion), compiles {compiles} (cache hit {:.1}%); wall/frame {:.1} ms",
+        100.0 * demoted as f64 / bodies.max(1) as f64,
+        promotions as f64 / demotions.max(1) as f64,
+        100.0 * (1.0 - compiles as f64 / promotions.max(1) as f64),
+        wall * 1e3 / frames.max(1) as f64
+    );
+    println!(
+        "mem: rss end {:.0} MB (peak {:.0}), build {:.0} B/body; slots live {live} demoted {demoted} passages {passages} plunges {plunges}; knots standing {:.1} MB ({:.0} B/body); catalogue_live {}",
+        rss_end as f64 / 1e6, hwm as f64 / 1e6, (foot_build.saturating_sub(rss0)) as f64 / n.max(1) as f64,
+        knots_bytes as f64 / 1e6, knots_bytes as f64 / bodies.max(1) as f64, p.u.catalogue_live()
+    );
+    println!(
+        "row: n={n} flight={flight} seed={seed} lazy={lazy} cache={cache} digest={} wall={wall:.2} build={build:.2} game_s={game_s:.0} kicks={kicks} demotions={demotions} promotions={promotions} compiles={compiles} rss_mb={:.0} hwm_mb={:.0} knots_mb={:.1} catalogue_live={} live={live} demoted={demoted}",
+        p.u.digest(), rss_end as f64 / 1e6, hwm as f64 / 1e6, knots_bytes as f64 / 1e6, p.u.catalogue_live()
+    );
+}
