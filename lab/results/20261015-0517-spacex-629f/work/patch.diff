+/// A binding's compiled entry, or — once demoted — the key that regenerates it exactly.
+///
+/// The demote-after-kick seam (lab `20261015-0517-spacex-629f`, off by default: `LAZY_DEMOTE`).
+/// A cycle's compiled trajectory is a pure function of its key ([`Orbit::compile`], bit for bit —
+/// measured 120,083/120,083 by the scout, then by every digest below), so a settled binding
+/// needs no compiled entry standing: every read re-mints one. Passages (their compile needs the
+/// outer radius) and plunges (coefficients) never demote. The digest reads key+sense+unit only,
+/// so it cannot tell a demoted slot from a live one.
+#[derive(Clone, Debug)]
+pub enum EntrySlot {
+    Live(Arc<Entry>),
+    Demoted { key: OrbitKey, clockwise: bool, unit: Unit },
+}
+
+static DEMOTE_COUNT: AtomicU64 = AtomicU64::new(0);
+static PROMOTE_COUNT: AtomicU64 = AtomicU64::new(0);
+static COMPILE_COUNT: AtomicU64 = AtomicU64::new(0);
+
+/// Whether kicks demote their binding (the seam; default off = shipped behaviour bit for bit).
+pub static LAZY_DEMOTE: AtomicBool = AtomicBool::new(false);
+/// Capacity of the shared mint cache (0: every promotion recompiles; the bounded form of
+/// "retain one mint per kick" — one event chain's reads hit, standing memory stays the cap).
+pub static MINT_CACHE: AtomicUsize = AtomicUsize::new(0);
+
+/// (demotions, promotions, promotions that had to compile) since process start.
+pub fn lazy_counters() -> (u64, u64, u64) {
+    (DEMOTE_COUNT.load(Ordering::Relaxed), PROMOTE_COUNT.load(Ordering::Relaxed), COMPILE_COUNT.load(Ordering::Relaxed))
+}
+
+static MINTS: LazyLock<Mutex<(HashMap<OrbitKey, Arc<Entry>>, Vec<OrbitKey>)>> =
+    LazyLock::new(|| Mutex::new((HashMap::new(), Vec::new())));
+
+impl EntrySlot {
+    /// The compiled entry, minted from the key if it was dropped (the promotion). The mint is
+    /// fresh unless the shared cache holds one for the key; either way its bits are the pure
+    /// compile's, so the read is identical to a live entry's.
+    pub fn entry(&self) -> Res<Arc<Entry>> {
+        match self {
+            Self::Live(e) => Ok(e.clone()),
+            Self::Demoted { key, clockwise, unit } => {
+                PROMOTE_COUNT.fetch_add(1, Ordering::Relaxed);
+                let cap = MINT_CACHE.load(Ordering::Relaxed);
+                if cap > 0 {
+                    if let Some(e) = MINTS.lock().unwrap().0.get(key) {
+                        return Ok(e.clone());
+                    }
+                }
+                COMPILE_COUNT.fetch_add(1, Ordering::Relaxed);
+                let e = Arc::new(Entry {
+                    trajectory: Trajectory::Cycle(Orbit::compile(*key).map_err(|_| Error::Refused("promotion compile"))?),
+                    clockwise: *clockwise,
+                    unit: *unit,
+                });
+                if cap > 0 {
+                    let mut m = MINTS.lock().unwrap();
+                    if m.0.len() >= cap {
+                        while m.0.len() >= cap {
+                            if let Some(oldest) = m.1.first().copied() {
+                                m.1.remove(0);
+                                m.0.remove(&oldest);
+                            } else {
+                                break;
+                            }
+                        }
+                    }
+                    m.0.insert(*key, e.clone());
+                    m.1.push(*key);
+                }
+                Ok(e)
+            }
+        }
+    }
+
+    pub fn key(&self) -> Option<OrbitKey> {
+        match self {
+            Self::Live(e) => e.trajectory.key(),
+            Self::Demoted { key, .. } => Some(*key),
+        }
+    }
+    pub fn clockwise(&self) -> bool {
+        match self {
+            Self::Live(e) => e.clockwise,
+            Self::Demoted { clockwise, .. } => *clockwise,
+        }
+    }
+    pub fn unit(&self) -> Unit {
+        match self {
+            Self::Live(e) => e.unit,
+            Self::Demoted { unit, .. } => *unit,
+        }
+    }
+    pub fn is_plunge(&self) -> bool {
+        matches!(self, Self::Live(e) if matches!(e.trajectory, Trajectory::Plunge(_)))
+    }
+    pub fn is_passage(&self) -> bool {
+        matches!(self, Self::Live(e) if matches!(e.trajectory, Trajectory::Passage(_)))
+    }
+    /// Drop the compiled entry, keeping what regenerates it (cycles only). The owner must
+    /// release the catalogue slot this binding held (the slot's index dies with the entry).
+    pub fn demote(&mut self) -> bool {
+        if let Self::Live(e) = self {
+            if let Trajectory::Cycle(_) = &e.trajectory {
+                let next = Self::Demoted { key: e.trajectory.key().expect("a cycle has a key"), clockwise: e.clockwise, unit: e.unit };
+                *self = next;
+                DEMOTE_COUNT.fetch_add(1, Ordering::Relaxed);
+                return true;
+            }
+        }
+        false
+    }
+}
