                 events: 0,
+
                 refusals: 0,
                 fault: None,
             };
@@ -718,6 +719,21 @@ impl Universe {
             }
         }
         // The next member in line has the next id.
+        // PROBE (spacex-3463): attribute resident growth to handouts.
+        {
+            use std::sync::atomic::{AtomicU64, Ordering};
+            static N: AtomicU64 = AtomicU64::new(0);
+            static BASE: AtomicU64 = AtomicU64::new(0);
+            let n = N.fetch_add(1, Ordering::Relaxed);
+            if n % 50 == 0 {
+                let rss = std::fs::read_to_string("/proc/self/statm").ok()
+                    .and_then(|s| s.split_whitespace().nth(1).and_then(|p| p.parse::<u64>().ok()))
+                    .unwrap_or(0) * 4096 / 1024;
+                let b = BASE.swap(rss, Ordering::Relaxed);
+                if n == 0 { BASE.store(rss, Ordering::Relaxed); }
+                eprintln!("PROBE handout #{n} rss_kb={rss} delta_kb={}", rss.saturating_sub(b));
+            }
+        }
         self.requeue(self.bodies.len());
     }
 
