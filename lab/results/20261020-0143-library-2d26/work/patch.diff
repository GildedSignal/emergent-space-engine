+/// print-only Linux stand-in (the lab box; prior lab runs did the same, disclosed): VmRSS now, VmHWM peak, bytes.
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let (mut now, mut peak) = (0u64, 0u64);
+    if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+        for line in s.lines() {
+            let kv = |l: &str| l.split_whitespace().next().and_then(|v| v.parse::<u64>().ok()).unwrap_or(0) * 1024;
+            if let Some(r) = line.strip_prefix("VmRSS:") { now = kv(r); }
+            if let Some(r) = line.strip_prefix("VmHWM:") { peak = kv(r); }
+        }
+    }
+    (now, peak)
+}
