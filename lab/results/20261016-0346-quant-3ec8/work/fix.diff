@@ -0,0 +1,35 @@
+//! The birth-pass A/B probe (lab run 20261016-0346-quant-3ec8): builds the plane with the N
+//! ladder's belt (`extra` ships) and prints the whole build wall and the post-`start` digest.
+//! `ES_PASS_SPLIT=1` (read by `Universe::start`) prints the pass's phases; `ES_ONE_READ` selects
+//! the arm (`0`/unset = shipped read-for-read, `1` = one readout serves `plan_clock`'s reads).
+//! Usage: `pass_bench <extra> <seed>`.
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::Config;
+use std::time::Instant;
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let extra: usize = args.next().unwrap_or_else(|| "10000".into()).parse().expect("extra (belt N)");
+    let seed: u64 = args.next().unwrap_or_else(|| "1".into()).parse().expect("seed");
+    let arm = std::env::var("ES_ONE_READ").unwrap_or_else(|_| "0".into());
+    let rss = || -> u64 {
+        std::fs::read_to_string("/proc/self/status")
+            .ok()
+            .and_then(|s| s.lines().find(|l| l.starts_with("VmHWM:")).and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse().ok())))
+            .unwrap_or(0)
+    };
+    let t0 = Instant::now();
+    let plane = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, extra).expect("the plane");
+    let build = t0.elapsed();
+    println!(
+        "pass_bench arm={} n={} seed={} build_us={} per_body_us={} peak_rss_kb={} digest={}",
+        arm,
+        extra,
+        seed,
+        build.as_micros(),
+        build.as_micros() as f64 / extra as f64,
+        rss(),
+        plane.u.digest()
+    );
+}
