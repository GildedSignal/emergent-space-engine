+/// The one-readout arm of the birth-pass probe: `ES_ONE_READ=1` serves every own-state read of a
+/// clock plan from one `readout`. Default off: the shipped path, read for read.
+fn one_read() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("ES_ONE_READ").is_ok_and(|v| v != "0"));
+    *ON
+}
