+/// floor(sqrt(x)) for x < 2^62: the correctly rounded f64 root, corrected by at
+/// most one unit. Same bits as u64::isqrt on this range.
+#[inline]
+pub fn isqrt_word(x: u64) -> u64 {
+    let mut y = (x as f64).sqrt() as u64;
+    if y > 0 && y.saturating_mul(y) > x {
+        y -= 1;
+    } else {
+        let z = y + 1;
+        if z.saturating_mul(z) <= x {
+            y = z;
+        }
+    }
+    y
+}
