+// ---- the read census (a print-only instrument; lab run 20261019-1817-system-c7a6) -------------------
+
+//
+// What `binding_at` is asked for, per call site: the current binding, or history, and how far behind
+// `now` the history read sits. Nothing is written and nothing decides; `READ_CENSUS` arms it and the
+// shipped behaviour is identical either way (the off path is one relaxed load).
+pub mod census {
+    use crate::num::Tick;
+    use std::sync::atomic::{AtomicBool, AtomicI64, AtomicU64, AtomicU8, Ordering};
+
+    pub const VIEW: u8 = 1; // the past-light-cone gather (view.rs)
+    pub const SCAN: u8 = 2; // a held scan's capture (encounter.rs)
+
+    pub static ON: AtomicBool = AtomicBool::new(false);
+    pub static NOW: AtomicI64 = AtomicI64::new(0);
+    pub static SITE: AtomicU8 = AtomicU8::new(0);
+
+    static READS: AtomicU64 = AtomicU64::new(0);
+    static HIST: AtomicU64 = AtomicU64::new(0);
+    static LB_MAX: AtomicI64 = AtomicI64::new(0);
+    static LB_MAX_RUN: AtomicI64 = AtomicI64::new(0);
+    static LB_SUM: AtomicU64 = AtomicU64::new(0);
+    static LB_N: AtomicU64 = AtomicU64::new(0);
+    static R_V: AtomicU64 = AtomicU64::new(0);
+    static H_V: AtomicU64 = AtomicU64::new(0);
+    static LB_V: AtomicI64 = AtomicI64::new(0);
+    static R_S: AtomicU64 = AtomicU64::new(0);
+    static H_S: AtomicU64 = AtomicU64::new(0);
+    static LB_S: AtomicI64 = AtomicI64::new(0);
+
+    #[inline]
+    pub fn read(t: Tick, event_time: Tick) {
+        if !ON.load(Ordering::Relaxed) {
+            return;
+        }
+        let site = SITE.load(Ordering::Relaxed);
+        if site == VIEW {
+            R_V.fetch_add(1, Ordering::Relaxed);
+        } else if site == SCAN {
+            R_S.fetch_add(1, Ordering::Relaxed);
+        }
+        READS.fetch_add(1, Ordering::Relaxed);
+        if t >= event_time {
+            return;
+        }
+        let lb = NOW.load(Ordering::Relaxed) - t as i64;
+        if site == VIEW {
+            H_V.fetch_add(1, Ordering::Relaxed);
+            LB_V.fetch_max(lb, Ordering::Relaxed);
+        } else if site == SCAN {
+            H_S.fetch_add(1, Ordering::Relaxed);
+            LB_S.fetch_max(lb, Ordering::Relaxed);
+        }
+        HIST.fetch_add(1, Ordering::Relaxed);
+        LB_MAX.fetch_max(lb, Ordering::Relaxed);
+        LB_MAX_RUN.fetch_max(lb, Ordering::Relaxed);
+        LB_SUM.fetch_add(lb.max(0) as u64, Ordering::Relaxed);
+        LB_N.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// One window of the census, taking the counters (the run max is never reset).
+    pub struct Snap {
+        pub reads: u64,
+        pub hist: u64,
+        pub lb_max: i64,
+        pub lb_sum: u64,
+        pub lb_n: u64,
+        pub lb_max_run: i64,
+        pub r_v: u64,
+        pub h_v: u64,
+        pub lb_v: i64,
+        pub r_s: u64,
+        pub h_s: u64,
+        pub lb_s: i64,
+    }
+
+    pub fn take() -> Snap {
+        Snap {
+            reads: READS.swap(0, Ordering::Relaxed),
+            hist: HIST.swap(0, Ordering::Relaxed),
+            lb_max: LB_MAX.swap(0, Ordering::Relaxed),
+            lb_sum: LB_SUM.swap(0, Ordering::Relaxed),
+            lb_n: LB_N.swap(0, Ordering::Relaxed),
+            lb_max_run: LB_MAX_RUN.load(Ordering::Relaxed),
+            r_v: R_V.swap(0, Ordering::Relaxed),
+            h_v: H_V.swap(0, Ordering::Relaxed),
+            lb_v: LB_V.swap(0, Ordering::Relaxed),
+            r_s: R_S.swap(0, Ordering::Relaxed),
+            h_s: H_S.swap(0, Ordering::Relaxed),
+            lb_s: LB_S.swap(0, Ordering::Relaxed),
+        }
+    }
+
+    /// Tags every `binding_at` call in its scope as `site`, restoring the previous one after.
+    pub struct SiteGuard(u8);
+    impl Drop for SiteGuard {
+        fn drop(&mut self) {
+            SITE.store(self.0, Ordering::Relaxed);
+        }
+    }
+    pub fn tag(site: u8) -> SiteGuard {
+        SiteGuard(SITE.swap(site, Ordering::Relaxed))
+    }
+}
