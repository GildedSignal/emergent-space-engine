+
+/// A fleet on one orbit: m bodies, a ∈ [1, 1+da], Rayleigh e, periapses aligned when `aligned`
+/// (a convoy shares its apsidal line), mean longitude uniform in an arc of length `arc`
+/// (arc ≥ TAU: uniform over the whole orbit, a dense ring).
+pub fn make_fleet(m: usize, arc: f64, da: f64, sigma_e: f64, aligned: bool, seed: u64) -> Vec<Body> {
+    let mut rng = Rng(seed);
+    (0..m)
+        .map(|_| {
+            let a = 1.0 + da * rng.f64();
+            let u = rng.f64();
+            let e = (sigma_e * (-2.0 * (1.0 - u).ln()).sqrt()).min(0.5);
+            let pom = if aligned { 0.0 } else { TAU * rng.f64() };
+            let lam = if arc >= TAU { TAU * rng.f64() } else { arc * (rng.f64() - 0.5) };
+            Body::new(a, e, pom, lam)
+        })
+        .collect()
+}
