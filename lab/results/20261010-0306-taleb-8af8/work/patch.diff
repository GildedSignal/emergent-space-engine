+/// One scene, judged: truth (radial superset, conservative advancement) vs the method (cone pairs),
+/// misses and false reports by family (0 fleet-fleet, 1 fleet-belt, 2 belt-belt), and the partner
+/// rank of every true encounter, at setup and at the encounter.
+fn seam_scene(tag: &str, m: usize, arc: f64, n_belt: usize, rho: f64, orbits: f64, seed: u64) {
+    let t_wall = Instant::now();
+    let b = seam_bodies(m, arc, n_belt, rho, seed);
+    let t_end = orbits * TAU;
+    let rp = radial_pairs(&b, rho);
+    let (truth, tst) = truth_all(&b, &rp, rho, t_end);
+    let cs = cone_pairs(&b, rho);
+    let (meth, mst) = method_all(&b, &cs.pairs, rho, 0.0, t_end);
+    let (missed, false_, matched, dup) = matchup(&truth, &meth, t_end, 1e-3);
+    let fam = |e: &Enc| {
+        if (e.0 as usize) < m && (e.1 as usize) < m {
+            0
+        } else if (e.0 as usize) < m || (e.1 as usize) < m {
+            1
+        } else {
+            2
+        }
+    };
+    let inside = |t: f64| t > 0.05 && t < t_end - 0.05;
+    let mut t_n = [0u64; 3];
+    for e in truth.iter().filter(|e| inside(e.2)) {
+        t_n[fam(e) as usize] += 1;
+    }
+    let mut m_n = [0u64; 3];
+    for e in missed.iter() {
+        m_n[fam(e) as usize] += 1;
+    }
+    let mut f_n = [0u64; 3];
+    for e in false_.iter() {
+        f_n[fam(e) as usize] += 1;
+    }
+    let (mut c_ff, mut c_fx, mut c_xx) = (0u64, 0u64, 0u64);
+    for &(i, j) in &cs.pairs {
+        match ((i as usize) < m, (j as usize) < m) {
+            (true, true) => c_ff += 1,
+            (true, false) | (false, true) => c_fx += 1,
+            (false, false) => c_xx += 1,
+        }
+    }
+    let outside_cone = truth
+        .iter()
+        .filter(|e| inside(e.2) && !is_candidate(&b[e.0 as usize], &b[e.1 as usize], rho))
+        .count();
+    // Cross pairs that ever held an encounter: the fraction of cross setup that was real work.
+    let mut cross_hit: std::collections::HashSet<(u32, u32)> = std::collections::HashSet::new();
+    for e in meth.iter() {
+        if fam(e) == 1 {
+            cross_hit.insert((e.0.min(e.1), e.0.max(e.1)));
+        }
+    }
+    let mut r_enc = [Vec::new(), Vec::new(), Vec::new()];
+    let mut r_set = [Vec::new(), Vec::new(), Vec::new()];
+    for e in truth.iter().filter(|e| inside(e.2)) {
+        let f = fam(e) as usize;
+        r_enc[f].push(partner_rank(&b, e.0 as usize, e.1 as usize, e.2));
+        r_set[f].push(partner_rank(&b, e.0 as usize, e.1 as usize, 0.0));
+    }
+    let (e0, s0) = (pct(&mut r_enc[0]), pct(&mut r_set[0]));
+    let (e1, s1) = (pct(&mut r_enc[1]), pct(&mut r_set[1]));
+    println!(
+        "{{\"exp\":\"seam\",\"tag\":\"{}\",\"m\":{},\"arc\":{:.4},\"n_belt\":{},\"rho\":{:.0e},\"orbits\":{},\
+\"radial_pairs\":{},\"cone_pairs\":{},\"c_ff\":{},\"c_fx\":{},\"c_xx\":{},\"outside_cone\":{},\
+\"truth\":[{},{},{}],\"missed\":[{},{},{}],\"false\":[{},{},{}],\"matched\":{},\"dup\":{},\
+\"cross_hit\":{},\"cross_waste_frac\":{:.4},\
+\"rank_enc_ff\":{{\"med\":{:.1},\"p95\":{:.1},\"max\":{},\"le4\":{:.3}}},\
+\"rank_set_ff\":{{\"med\":{:.1},\"p95\":{:.1},\"max\":{},\"le4\":{:.3}}},\
+\"rank_enc_fx\":{{\"med\":{:.1},\"p95\":{:.1},\"max\":{},\"le4\":{:.3}}},\
+\"rank_set_fx\":{{\"med\":{:.1},\"p95\":{:.1},\"max\":{},\"le4\":{:.3}}},\
+\"truth_steps\":{},\"truth_fine\":{},\"checks\":{},\"evals\":{},\"wall_s\":{:.2}}}",
+        tag, m, arc, n_belt, rho, orbits, rp.len(), cs.pairs.len(), c_ff, c_fx, c_xx, outside_cone,
+        t_n[0], t_n[1], t_n[2], m_n[0], m_n[1], m_n[2], f_n[0], f_n[1], f_n[2], matched, dup,
+        cross_hit.len(), 1.0 - cross_hit.len() as f64 / c_fx.max(1) as f64,
+        e0.0, e0.1, e0.2, e0.3, s0.0, s0.1, s0.2, s0.3,
+        e1.0, e1.1, e1.2, e1.3, s1.0, s1.1, s1.2, s1.3,
+        tst.steps, tst.fine, mst.checks_total(), mst.evals, t_wall.elapsed().as_secs_f64()
+    );
+}
