+// ---- the seam between the certificate tiers (lab run 20261010-0306-taleb-8af8) ----
+//
+// The adopted design routes between the pairwise Binet-cone tier and a phase-neighbour certificate
+// by a concentration number. Its evidence is fleet-only. These scenes hold a fleet (co-orbital,
+// aligned apsides, one arc) inside a belt whose inner bodies cross the fleet's orbit, so both tiers
+// must cooperate on one scene.
+
+fn seam_bodies(m: usize, arc: f64, n_belt: usize, rho: f64, seed: u64) -> Vec<Body> {
+    let mut b = make_fleet(m, arc, 5e-3, 2e-3, true, seed);
+    b.extend(make_belt(&spec("seam-belt", n_belt, 5e-2, rho, 1.02, 1.5, 0, 0.0, seed + 1)));
+    b
+}
+
+fn circd(a: f64, b: f64) -> f64 {
+    let d = (a - b).abs().rem_euclid(TAU);
+    d.min(TAU - d)
+}
+
+fn lam_at(x: &Body, t: f64) -> f64 {
+    (x.mean_anomaly(t) + x.pom).rem_euclid(TAU)
+}
+
+/// The partner's rank among all bodies by circular mean-longitude distance from body i, at time t.
+fn partner_rank(b: &[Body], i: usize, j: usize, t: f64) -> u32 {
+    let li = lam_at(&b[i], t);
+    let dj = circd(lam_at(&b[j], t), li);
+    b.iter()
+        .enumerate()
+        .filter(|&(k, _)| k != i && k != j && circd(lam_at(&b[k], t), li) < dj)
+        .count() as u32
+}
+
+fn pct(v: &mut Vec<u32>) -> (f64, f64, u32, f64) {
+    if v.is_empty() {
+        return (0.0, 0.0, 0, 0.0);
+    }
+    v.sort_unstable();
+    let at = |q: f64| v[((q * (v.len() - 1) as f64).round() as usize).min(v.len() - 1)] as f64;
+    (at(0.5), at(0.95), *v.last().unwrap(), v.iter().filter(|&&r| r <= 4).count() as f64 / v.len() as f64)
+}
