+/// Candidate degree by family against fleet size (no truth): does the fleet's candidate work track
+/// its real encounters, or does the seam pay per cross pair regardless of encounters?
+fn seam_cost() {
+    let n_belt = 1000usize;
+    let rho = 5e-3;
+    for &m in &[100usize, 300, 1000, 3000] {
+        let t0 = Instant::now();
+        let b = seam_bodies(m, 0.1, n_belt, rho, 20261101);
+        let s = Sorted::new(&b, rho);
+        let (mut ff, mut fx, mut xx, mut scanned) = (0u64, 0u64, 0u64, 0u64);
+        for (k, &(u, i)) in s.order.iter().enumerate() {
+            let bi = &b[i as usize];
+            let reach = s.reach(bi);
+            for &(uj, j) in &s.order[k + 1..] {
+                if uj - u > reach {
+                    break;
+                }
+                scanned += 1;
+                if is_candidate(bi, &b[j as usize], rho) {
+                    match ((i as usize) < m, (j as usize) < m) {
+                        (true, true) => ff += 1,
+                        (true, false) | (false, true) => fx += 1,
+                        (false, false) => xx += 1,
+                    }
+                }
+            }
+        }
+        println!(
+            "{{\"exp\":\"seam-cost\",\"m\":{},\"n_belt\":{},\"scanned\":{},\"fleet_fleet\":{},\"cross\":{},\"belt_belt\":{},\
+\"deg_fleet\":{:.1},\"deg_belt\":{:.2},\"cross_per_fleet_body\":{:.1},\"wall_s\":{:.2}}}",
+            m, n_belt, scanned, ff, fx, xx,
+            (2.0 * ff as f64 + fx as f64) / m as f64,
+            (2.0 * xx as f64 + fx as f64) / n_belt as f64,
+            fx as f64 / m as f64,
+            t0.elapsed().as_secs_f64()
+        );
+    }
+}
