-/// The constants of the clock of a body of doll `d` (its secondaries other than `except`), read at `t`: `(Δs, c, b)`.
-pub fn constants(ctx: &Ctx, d: u16, t: Tick, except: usize, kicks_log2: i32) -> Res<(Scalar, Scalar, Scalar)> {
+/// The constants of the clock of a body of doll `d` (its secondaries other than `except`), read at `t`: `(ds_unit, c, b)`,
+/// where `ds_unit = P_D/f'(c)` floored to a power of two — the step is `ds_unit·2^-k` for the body's own `k` ([`split_k`],
