+//! A belt cost scene (the lab's clock-path cost run, 20261009-0709-second-20261009-0621-system-7f97-1eca):
+//! the plane's star and its three planets, plus a belt of clock bodies (root-doll ships) in the gap between
+//! Home and the Giant — no moon, no fleet, no player. Every belt body is a clock body far from every Hill
+//! shell: the population the doll-wide Δs overpaid for, and the one the per-body rule is for. Reports the
+//! engine's own event counters (`stats`) per game-second and the digest at a canonical cut, for whatever
+//! cadence the environment chose (`Config::default` reads UNIVERSE_STEP_LOG2 / UNIVERSE_CLOCK_SPLIT).
+//!
+//! Usage: `belt_bench [rtf] [frames] [n_belt] [seed]` (defaults 20000 3300 2000 7).
+use emergent_space::orbit::Scalar;
+use emergent_universe::num::from_f64;
+use emergent_universe::scenario::{PlanetSpec, PLANETS, STAR_RADIUS};
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config, Kind, OrbitSpec, Universe};
+
+fn lcg(seed: &mut u64) -> f64 {
+    *seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+    (*seed >> 11) as f64 / (1u64 << 53) as f64
+}
+
+fn main() -> Result<(), String> {
+    let mut it = std::env::args().skip(1);
+    let mut val = |d: &str| it.next().and_then(|s| s.parse::<f64>().ok()).unwrap_or_else(|| d.parse().unwrap());
+    let (rtf, frames, n, seed, a_lo, a_hi, e_max) = (
+        val("20000") as f64,
+        val("3300") as u32 as usize,
+        val("2000") as u32 as usize,
+        val("7") as u32 as u64,
+        val("1.8"),
+        val("3.6"),
+        val("0.25"),
+    );
+    let cfg = Config::default();
+    let au = emergent_universe::scenario::AU as f64;
+    let mut u = Universe::new(Scalar::integer(STAR_RADIUS), cfg);
+    u.threads = 1;
+    for PlanetSpec { name, mass_log2, periapsis, e_q48, angle, phase, radius } in PLANETS {
+        let b = u
+            .add_body(Kind::Planet, OrbitSpec { doll: 0, periapsis: Scalar::integer(periapsis), e_q48, clockwise: false, angle, phase }, Scalar::ZERO)
+            .map_err(|e| format!("{e:?}"))?;
+        let surface = Scalar::raw(radius as i128, -mass_log2).map_err(|e| format!("{e:?}"))?;
+        u.add_doll(name, b, mass_log2, surface).map_err(|e| format!("{e:?}"))?;
+    }
+    // The belt: heliocentric ships at 1.8–3.6 AU, e ≤ 0.25, fixed seeded draw (the scenario's own generator).
+    let mut rng = (seed ^ 0x5DEECE66Du64) | 1;
+    for _ in 0..n {
+        let a = (a_lo + (a_hi - a_lo) * lcg(&mut rng)) * au;
+        let e = e_max * lcg(&mut rng);
+        u.add_body(
+            Kind::Ship,
+            OrbitSpec {
+                doll: 0,
+                periapsis: from_f64(a * (1.0 - e)),
+                e_q48: (e * (1u64 << 48) as f64) as u64,
+                clockwise: false,
+                angle: (lcg(&mut rng) * 4294967296.0) as u32,
+                phase: (lcg(&mut rng) * 4294967296.0) as u32,
+            },
+            Scalar::ZERO,
+        )
+        .map_err(|e| format!("{e:?}"))?;
+    }
+    u.start().map_err(|e| format!("{e:?}"))?;
+    let wall = std::time::Instant::now();
+    for _ in 0..frames {
+        u.frame(1.0 / 60.0, rtf, Budget::unlimited());
+    }
+    let cut = u.now;
+    u.settle(cut);
+    let st = &u.stats;
+    let game_s = cut as f64 * TICK_SECONDS;
+    let alive = (0..u.n_bodies()).filter(|&i| u.rec(i).alive).count();
+    let rate = |x: u64| x as f64 / game_s;
+    println!(
+        "belt_bench rtf={rtf} frames={frames} n={n} seed={seed} clock_split={} step_log2={}\
+         \nkicks {} ({:.3e}/game_s) opens {} boundaries {} handoffs {} slices {} decisions {} lost {} refused {}\
+         \nevents {} ({:.3e}/game_s) game_seconds {:.3e} cut {cut} alive {alive}/{} digest {} wall_seconds {:.1}",
+        cfg.clock_split, cfg.step_log2, st.kicks, rate(st.kicks), st.opens, st.boundaries, st.handoffs, st.slices, st.decisions, st.lost, st.refused,
+        st.events(), rate(st.events()), game_s, u.n_bodies(), u.digest(), wall.elapsed().as_secs_f64()
+    );
+    Ok(())
+}
