+        let clock_split = std::env::var("UNIVERSE_CLOCK_SPLIT").ok().is_some_and(|s| !s.is_empty() && s != "0");
+        Self { thrust_log2: -44, turn_log2: -30, leave_log2: 40, step_log2, clock_split }
     }
 }
 
