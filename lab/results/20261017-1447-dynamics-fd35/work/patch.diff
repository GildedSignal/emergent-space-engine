+//! Lab 20261017-1447-dynamics-fd35: the finality race on sustained-overlap churn (four dense
+//! Bounce gases, light-cone finality on; `sabotage` optionally forces rollbacks the shipped
+//! finality tests use), frames harness. One process per arm so a firing assert ends only
+//! that arm. HAZ/PRE/RB/FIRE lines go to stderr (the instrument in alloc.rs); one summary
+//! row to stdout.
+//!
+//!     cargo run -p emergent-allocator --release --offline --example race -- \
+//!         <n-per-cluster> <seed> <min_region> <rate> <seconds> [window] [stride_max] [vmax] [spacing] [sabotage] [ahead]
+use emergent_allocator::{scenes, Allocator, Config, Factory, FrameConfig};
+use emergent_lattice::{chronon::Chronon, law::{Law, World}};
+use std::sync::Arc;
+
+fn scene_churn(n: u64, seed: u64, vmax: i64, spacing: i64) -> Vec<World> {
+    // Four dense Bounce gases on a 2x2 grid `spacing` units apart (box side ~65 units at
+    // n = 400): overlap or approach churn; `sabotage` widens forecasts into conflicts.
+    let q = 256;
+    let ws = (0..4u64)
+        .map(|c| scenes::loose_gas(n, q, vmax, seed * 10 + c, c * 1_000_000, [(c as i64 % 2) * spacing, (c as i64 / 2) * spacing]))
+        .collect();
+    scenes::with_law(ws, Law::Relativistic)
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let n: u64 = a.first().unwrap_or(&"400".into()).parse().unwrap();
+    let seed: u64 = a.get(1).unwrap_or(&"11".into()).parse().unwrap();
+    let min_region: usize = a.get(2).unwrap_or(&"1".into()).parse().unwrap();
+    let rate: f64 = a.get(3).unwrap_or(&"900".into()).parse().unwrap();
+    let seconds: f64 = a.get(4).unwrap_or(&"3".into()).parse().unwrap();
+    let window: i64 = a.get(5).unwrap_or(&"16".into()).parse().unwrap();
+    let stride_max: u32 = a.get(6).unwrap_or(&"8".into()).parse().unwrap();
+    let vmax: i64 = a.get(7).unwrap_or(&"64".into()).parse().unwrap();
+    let spacing: i64 = a.get(8).unwrap_or(&"40".into()).parse().unwrap();
+    let sabotage: Option<u64> = a.get(9).and_then(|s| s.parse().ok()).map(|k: u64| k.max(1));
+    let ahead: f64 = a.get(10).unwrap_or(&"0.3".into()).parse().unwrap();
+    let scene = scene_churn(n, seed, vmax, spacing);
+    let factory: Factory<Chronon> = Arc::new(|w| Chronon::new(w, false).expect("valid region world"));
+    let cfg = Config { min_region, window, stride_max, observer: [0, 0], sabotage, speed_margin: if sabotage.is_some() { 0.0 } else { 1.0 }, ..Config::default() };
+    let mut al = Allocator::new(scene, factory, cfg).expect("scene");
+    let r = al.run_frames(&FrameConfig { hz: 60.0, seconds, rate, ahead_seconds: ahead, record: false });
+    let f = r.frames.as_ref().expect("frames");
+    println!(
+        "SUM n={n} seed={seed} min={min_region} rate={rate} win={window} vmax={vmax} sp={spacing} sab={:?} ahead={ahead} frames={} present/s={:.0} present_end={:.0} rollbacks={} rgn0={} splits={} chr/s={:.0}",
+        sabotage, f.frames, r.sim.present_chronons_per_wall_second, r.sim.present_end, r.regions.rollbacks, r.regions.initial, r.regions.splits, r.sim.region_chronons_per_wall_second
+    );
+}
