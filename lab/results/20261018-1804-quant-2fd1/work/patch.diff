+        }
+        let eq = chk[0] == chk[1] && (chk[0] % 1_000_003) == (chk[2] % 1_000_003) && (chk[0] % 1_000_003) == (chk[3] % 1_000_003);
+        let med = |v: &Vec<f64>| {
