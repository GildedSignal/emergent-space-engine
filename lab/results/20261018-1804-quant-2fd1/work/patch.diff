+        };
+        let (m0, m1, m2, m3) = (med(&t0v), med(&t1v), med(&t2v), med(&t3v));
+        let mut total_steps = 0u64;
+        for &(c, d, m, w) in t.iter().step_by((t.len() / 997).max(1)) {
+            let mut s = 0u64;
+            black_box(first_hit(c as u128, d as u128, m as u128, 0, w as u128, &mut s));
+            total_steps += s;
+        }
+        println!(
+            "BENCH {} tuples={} rounds={} V0_ns={:.1} V1_ns={:.1} V2_ns={:.1} V3_ns={:.1} gainV1={:.2}x gainV2={:.2}x gainV3={:.2}x depth={:.1} chk_eq={} chk={:016x}{:016x}",
+            mx.name, t.len(), ROUNDS, m0, m1, m2, m3, m0 / m1, m0 / m2, m0 / m3,
+            total_steps as f64 / (t.len().div_ceil((t.len() / 997).max(1))) as f64,
+            eq, chk[0], chk[1]
+        );
+    }
+}
+
+fn main() {
+    let mode = std::env::args().nth(1).unwrap_or_else(|| "all".into());
+    match mode.as_str() {
+        "exact" => mode_exact(),
+        "random" => mode_random(),
+        "bench" => mode_bench(),
+        "all" => {
+            mode_exact();
+            mode_random();
+            mode_bench();
+        }
+        _ => panic!("modes: exact | random | bench | all"),
+    }
+}
