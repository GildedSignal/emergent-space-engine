+//! Price the encounters page's named, unpriced lever: `dioph::first_hit`'s u128 arithmetic.
+//!
+//! The exact integer conjunction decision ("does some passage of j land in the pair's window
+//! within the horizon, and which one first") is the hot per-pair-per-kick call of the cached
+//! decision path (e87d: 416 ns/pair/kick after the section cache). All section values are
+//! periods in ticks (< 2^39 at any playable a), so a u64 port is in reach. Variants:
+//!   V0  shipped u128 (baseline, byte-for-byte the crate's `dioph::first_hit`),
+//!   V1  u64 body with the return line's m*y widened to u128 (sound for m < 2^63),
+//!   V2  V1 with a checked u64 return line (u128 tail only when m*y + l + a would overflow),
+//!   V3  V2 plus the merged ceil/mod division (one DIV yields both ceil(l/a) and l%a).
+//! Exactness: all variants must return identical Option values AND identical `steps` counts.
+//! Modes: exact | random | bench | all.
+
+use encounters::belt::{make_belt, Spec};
+use encounters::dioph::first_hit;
+use encounters::kepler::Body;
+use encounters::pairs::{is_candidate, sections};
+use std::hint::black_box;
+use std::time::Instant;
+
+const SAFETY: f64 = 1.1;
+
+// ------------------------------------------------------------------ V1
+fn first_hit64(c: u64, d: u64, m: u64, lo: u64, hi: u64, steps: &mut u64) -> Option<u64> {
+    if lo <= c && c <= hi {
+        return Some(0);
+    }
+    let l2 = (lo + m - c) % m;
+    let h2 = (hi + m - c) % m;
+    min_k64(d % m, m, l2, h2, steps)
+}
+
+fn min_k64(a: u64, m: u64, l: u64, r: u64, steps: &mut u64) -> Option<u64> {
+    *steps += 1;
+    if l == 0 {
+        return Some(0);
+    }
+    if a == 0 {
+        return None;
+    }
+    let k = l.div_ceil(a);
+    if a * k <= r {
+        return Some(k);
+    }
+    let y = min_k64(m % a, a, a - r % a, a - l % a, steps)?;
+    Some(((l as u128 + m as u128 * y as u128 + a as u128 - 1) / a as u128) as u64)
+}
+
+// ------------------------------------------------------------------ V2
+fn first_hit64c(c: u64, d: u64, m: u64, lo: u64, hi: u64, steps: &mut u64, fb: &mut u64) -> Option<u64> {
+    if lo <= c && c <= hi {
+        return Some(0);
+    }
+    let l2 = (lo + m - c) % m;
+    let h2 = (hi + m - c) % m;
+    min_k64c(d % m, m, l2, h2, steps, fb)
+}
+
+fn min_k64c(a: u64, m: u64, l: u64, r: u64, steps: &mut u64, fb: &mut u64) -> Option<u64> {
+    *steps += 1;
+    if l == 0 {
+        return Some(0);
+    }
+    if a == 0 {
+        return None;
+    }
+    let k = l.div_ceil(a);
+    if a * k <= r {
+        return Some(k);
+    }
+    let y = min_k64c(m % a, a, a - r % a, a - l % a, steps, fb)?;
+    match m
+        .checked_mul(y)
+        .and_then(|my| l.checked_add(my))
+        .and_then(|t| t.checked_add(a - 1))
+    {
+        Some(t) => Some(t / a),
+        None => {
+            *fb += 1;
+            Some(((l as u128 + m as u128 * y as u128 + a as u128 - 1) / a as u128) as u64)
+        }
+    }
+}
+
+// ------------------------------------------------------------------ V3
+fn first_hit64m(c: u64, d: u64, m: u64, lo: u64, hi: u64, steps: &mut u64, fb: &mut u64) -> Option<u64> {
+    if lo <= c && c <= hi {
+        return Some(0);
+    }
+    let l2 = (lo + m - c) % m;
+    let h2 = (hi + m - c) % m;
+    min_k64m(d % m, m, l2, h2, steps, fb)
+}
+
+fn min_k64m(a: u64, m: u64, l: u64, r: u64, steps: &mut u64, fb: &mut u64) -> Option<u64> {
+    *steps += 1;
+    if l == 0 {
+        return Some(0);
+    }
+    if a == 0 {
+        return None;
+    }
+    // One DIV (compiled as one hardware division: quotient and remainder of the same
+    // dividend/divisor) yields both ceil(l/a) and l % a: with t = l + a - 1,
+    // l % a = 0 if (t % a) + 1 == a else (t % a) + 1.
+    let t = l + (a - 1);
+    let q = t / a;
+    let tm = t % a;
+    let k = q;
+    if a * k <= r {
+        return Some(k);
+    }
+    let lmod = {
+        let x = tm + 1;
+        if x == a { 0 } else { x }
+    };
+    let y = min_k64m(m % a, a, a - r % a, a - lmod, steps, fb)?;
+    match m
+        .checked_mul(y)
+        .and_then(|my| l.checked_add(my))
+        .and_then(|t| t.checked_add(a - 1))
+    {
+        Some(t) => Some(t / a),
+        None => {
+            *fb += 1;
+            Some(((l as u128 + m as u128 * y as u128 + a as u128 - 1) / a as u128) as u64)
+        }
+    }
+}
+
+// ------------------------------------------------------------------ census mirror (V1 + product-bit tracking)
+fn min_k_census(a: u64, m: u64, l: u64, r: u64, steps: &mut u64, maxbits: &mut u32, tail64: &mut u64, levels: &mut u64) -> Option<u64> {
+    *steps += 1;
+    *levels += 1;
+    if l == 0 {
+        return Some(0);
+    }
+    if a == 0 {
+        return None;
+    }
+    let k = l.div_ceil(a);
+    if a * k <= r {
+        return Some(k);
+    }
+    let y = min_k_census(m % a, a, a - r % a, a - l % a, steps, maxbits, tail64, levels)?;
+    let prod = (m as u128) * (y as u128);
+    let bits = 128 - prod.leading_zeros();
+    if bits > *maxbits {
+        *maxbits = bits;
+    }
+    if (l as u128 + prod + (a - 1) as u128) >> 64 == 0 {
+        *tail64 += 1;
+    }
+    Some(((l as u128 + prod + a as u128 - 1) / a as u128) as u64)
+}
+
+// ------------------------------------------------------------------ belt mixes
+struct Mix {
+    name: &'static str,
+    spec: Spec,
+    /// Full-corner formation: identical (a, e, pom), uniform lambdas.
+    formation: Option<(usize, f64)>,
+}
+
+fn mixes() -> Vec<Mix> {
+    vec![
+        Mix { name: "cell1e-4", spec: Spec { name: "cell".into(), n: 2000, sigma_e: 0.07, rho: 3.34e-6, a_lo: 3.0 - 1e-4, a_hi: 3.0, keys: 0, seed: 20261018, orbits: 1.0 }, formation: None },
+        Mix { name: "cell1e-5", spec: Spec { name: "cell".into(), n: 2000, sigma_e: 0.07, rho: 3.34e-6, a_lo: 3.0 - 1e-5, a_hi: 3.0, keys: 0, seed: 777, orbits: 1.0 }, formation: None },
+        Mix { name: "wide2-3", spec: Spec { name: "wide".into(), n: 2000, sigma_e: 0.07, rho: 3.34e-6, a_lo: 2.0, a_hi: 3.0, keys: 0, seed: 20261018, orbits: 1.0 }, formation: None },
+        Mix { name: "thin-a1-s3e-1", spec: Spec { name: "thin".into(), n: 2000, sigma_e: 0.3, rho: 1e-3, a_lo: 1.0 - 1e-3, a_hi: 1.0, keys: 0, seed: 20261019, orbits: 1.0 }, formation: None },
+        Mix { name: "formation", spec: Spec { name: "form".into(), n: 500, sigma_e: 0.05, rho: 3.34e-6, a_lo: 1.0, a_hi: 1.0, keys: 0, seed: 20261018, orbits: 1.0 }, formation: Some((500, 0.05)) },
+    ]
+}
+
+fn bodies_of(mx: &Mix) -> Vec<Body> {
+    if let Some((n, e)) = mx.formation {
+        use std::f64::consts::TAU;
+        return (0..n)
+            .map(|k| Body::new(1.0, e, 0.3, TAU * k as f64 / n as f64))
+            .collect();
+    }
+    make_belt(&mx.spec)
+}
+
+/// The shipped tuple convention (main.rs `setup_cost`): (c, d, m=pi, w) per section.
+fn tuples_for(b: &[Body], rho: f64, cap: usize) -> (Vec<(u64, u64, u64, u64)>, u64, u64, [u64; 3]) {
+    let mut t = Vec::new();
+    let (mut cand, mut evals) = (0u64, 0u64);
+    let mut kinds = [0u64; 3];
+    'outer: for i in 0..b.len() {
+        for j in (i + 1)..b.len() {
+            if !is_candidate(&b[i], &b[j], rho) {
+                continue;
+            }
+            cand += 1;
+            for sec in sections(&b[i], &b[j], rho, SAFETY, &mut evals) {
+                kinds[sec.kind as usize] += 1;
+                let (pi, pj) = (b[i].period, b[j].period);
+                let c = ((sec.ti as i128 - sec.tj as i128 + sec.w1 as i128).rem_euclid(pi as i128)) as u64;
+                let d = (pi - pj % pi) % pi;
+                let w = ((sec.w1 + sec.w2).max(0) as u64).min(pi - 1);
+                t.push((c, d, pi, w));
+                if t.len() >= cap {
+                    break 'outer;
+                }
+            }
+        }
+    }
+    (t, cand, evals, kinds)
+}
+
+// ------------------------------------------------------------------ modes
+fn mode_exact() {
+    for mx in mixes() {
+        let b = bodies_of(&mx);
+        let rho = mx.spec.rho;
+        let (t, cand, evals, kinds) = tuples_for(&b, rho, 2_000_000);
+        let (mut mm, mut sm, mut fb2, mut fb3) = (0u64, 0u64, 0u64, 0u64);
+        let (mut maxbits, mut tail64, mut levels) = (0u32, 0u64, 0u64);
+        for &(c, d, m, w) in &t {
+            let (mut s0, mut s1, mut s2, mut s3, mut sc) = (0u64, 0u64, 0u64, 0u64, 0u64);
+            let r0 = first_hit(c as u128, d as u128, m as u128, 0, w as u128, &mut s0);
+            let r1 = first_hit64(c, d, m, 0, w, &mut s1);
+            let r2 = first_hit64c(c, d, m, 0, w, &mut s2, &mut fb2);
+            let r3 = first_hit64m(c, d, m, 0, w, &mut s3, &mut fb3);
+            let rc = min_k_census(d % m, m, (m - c) % m, (m - c + w) % m, &mut sc, &mut maxbits, &mut tail64, &mut levels);
+            if r0 != r1.map(|x| x as u128) { mm += 1; }
+            if r0 != r2.map(|x| x as u128) { mm += 1; }
+            if r0 != r3.map(|x| x as u128) { mm += 1; }
+            if r0 != rc.map(|x| x as u128) { mm += 1; }
+            if s0 != s1 || s0 != s2 || s0 != s3 || s0 != sc { sm += 1; }
+        }
+        let (mut total_steps, mut calls) = (0u64, 0u64);
+        for &(c, d, m, w) in t.iter().step_by((t.len() / 997).max(1)) {
+            let mut s = 0u64;
+            black_box(first_hit(c as u128, d as u128, m as u128, 0, w as u128, &mut s));
+            total_steps += s;
+            calls += 1;
+        }
+        println!(
+            "EXACT {} bodies={} cands={} sections={} tuples={} mismatch={} steps_neq={} maxprod_bits={} u64tail_fit={}/{} depth_mean={:.2} kinds={}/{}/{} evals={}",
+            mx.name, b.len(), cand, t.len(), t.len(), mm, sm, maxbits, tail64, levels,
+            total_steps as f64 / calls as f64, kinds[0], kinds[1], kinds[2], evals
+        );
+    }
+}
+
+struct Rng(pub u64);
+impl Rng {
+    fn next_u64(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+    fn below(&mut self, n: u64) -> u64 {
+        self.next_u64() % n
+    }
+    /// Log-uniform in [lo, hi] (powers of two).
+    fn log2_range(&mut self, lo: u32, hi: u32) -> u64 {
+        let e = lo as f64 + self.next_u64() as f64 / u64::MAX as f64 * (hi - lo) as f64;
+        1u64 << e as u32
+    }
+}
+
+fn check_all(c: u64, d: u64, m: u64, lo: u64, hi: u64, mm: &mut u64, sm: &mut u64, maxbits: &mut u32, fb: &mut u64, worst: &mut u64) {
+    let (mut s0, mut s1, mut s2, mut s3, mut sc) = (0u64, 0u64, 0u64, 0u64, 0u64);
+    let (mut t1, mut t2, mut lv) = (0u64, 0u64, 0u64);
+    let r0 = first_hit(c as u128, d as u128, m as u128, lo as u128, hi as u128, &mut s0);
+    let r1 = first_hit64(c, d, m, lo, hi, &mut s1);
+    let r2 = first_hit64c(c, d, m, lo, hi, &mut s2, &mut t1);
+    let r3 = first_hit64m(c, d, m, lo, hi, &mut s3, &mut t2);
+    let l2 = (lo + m - c) % m;
+    let h2 = (hi + m - c) % m;
+    let rc = min_k_census(d % m, m, l2, h2, &mut sc, maxbits, &mut fb, &mut lv);
+    if r0 != r1.map(|x| x as u128) || r0 != r2.map(|x| x as u128) || r0 != r3.map(|x| x as u128) || r0 != rc.map(|x| x as u128) {
+        *mm += 1;
+        if *mm < 4 {
+            println!("  MISMATCH c={c} d={d} m={m} lo={lo} hi={hi}: v0={r0:?} v1={:?} v2={:?} v3={:?}", r1, r2, r3);
+        }
+    }
+    if s0 != s1 || s0 != s2 || s0 != s3 || s0 != sc {
+        *sm += 1;
+    }
+    if s0 > *worst {
+        *worst = s0;
+    }
+}
+
+fn mode_random() {
+    let mut rng = Rng(0xA5A5_1234);
+    let flavors: Vec<(&str, u32, u32)> = vec![
+        ("unif-thinwin", 30, 40),
+        ("unif-widewin", 30, 40),
+        ("commensurate", 30, 40),
+        ("golden", 30, 40),
+        ("small-m", 20, 30),
+    ];
+    for (name, elo, ehi) in flavors {
+        let draws = 400_000u64;
+        let (mut mm, mut sm, mut maxbits, mut tail64, mut worst) = (0u64, 0u64, 0u32, 0u64, 0u64);
+        for _ in 0..draws {
+            let m = rng.log2_range(elo, ehi);
+            let d = match name {
+                "commensurate" => 1 + rng.below(1 << 20),
+                "golden" => {
+                    let g = (m as f64 / 1.618_033_988_749_895).round() as u64;
+                    1 + g % m
+                }
+                _ => rng.below(m),
+            };
+            let wmax = (m / 4).max(2);
+            let hi = match name {
+                "unif-widewin" => 1 + rng.below(wmax),
+                "unif-thinwin" => 1 + rng.below((wmax / 1000).max(1)),
+                _ => 1 + rng.below(wmax),
+            };
+            let lo = if rng.next_u64() & 1 == 0 { 0 } else { rng.below(m - hi) };
+            let hi = (lo + hi).min(m - 1);
+            let c = rng.below(m);
+            check_all(c, d, m, lo, hi, &mut mm, &mut sm, &mut maxbits, &mut tail64, &mut worst);
+        }
+        println!("RANDOM {name} draws={draws} mismatch={mm} steps_neq={sm} maxprod_bits={maxbits} u64tail_fit={tail64} worst_steps={worst}");
+    }
+    // Domain edge: m up to just under 2^63 (values), all variants must still agree.
+    {
+        let draws = 500_000u64;
+        let (mut mm, mut sm, mut maxbits, mut tail64, mut worst) = (0u64, 0u64, 0u32, 0u64, 0u64);
+        for _ in 0..draws {
+            let m = rng.log2_range(60, 62);
+            let d = 1 + rng.below(m);
+            let hi = 1 + rng.below((m / 4).max(2));
+            let lo = rng.below(m - hi);
+            let hi = (lo + hi).min(m - 1);
+            let c = rng.below(m);
+            check_all(c, d, m, lo, hi, &mut mm, &mut sm, &mut maxbits, &mut tail64, &mut worst);
+        }
+        println!("RANDOM edge-2^60-2^62 draws={draws} mismatch={mm} steps_neq={sm} maxprod_bits={maxbits} u64tail_fit={tail64} worst_steps={worst}");
+    }
+    // Brute force at small m: the shipped tests' independent oracle.
+    {
+        let draws = 300_000u64;
+        let (mut mm, mut sm, mut mb) = (0u64, 0u64, 0u32);
+        for _ in 0..draws {
+            let m = 8 + rng.below(1 << 16);
+            let d = rng.below(m);
+            let lo = rng.below(m);
+            let hi = lo + rng.below(m - lo);
+            let c = rng.below(m);
+            let brute = (0..m).map(|k| (c + d * k) % m).find(|&x| lo <= x && x <= hi);
+            let (mut s0, mut s1) = (0u64, 0u64);
+            let r0 = first_hit(c as u128, d as u128, m as u128, lo as u128, hi as u128, &mut s0);
+            let r1 = first_hit64(c, d, m, lo, hi, &mut s1);
+            if r0 != brute.map(|x| x as u128) || r1 != brute {
+                mm += 1;
+                if mm < 4 {
+                    println!("  BRUTE MISMATCH c={c} d={d} m={m} lo={lo} hi={hi} brute={brute:?} v0={r0:?} v1={r1:?}");
+                }
+            }
+            if s0 != s1 {
+                sm += 1;
+            }
+            let bits = 128 - ((m as u128) * (m as u128)).leading_zeros();
+            if bits > mb { mb = bits; }
+        }
+        println!("RANDOM brute-small draws={draws} mismatch={mm} steps_neq={sm} note=worst-possible-prod-bits={mb}");
+    }
+}
+
+fn mode_bench() {
+    const ROUNDS: usize = 9;
+    for mx in mixes() {
+        let b = bodies_of(&mx);
+        let rho = mx.spec.rho;
