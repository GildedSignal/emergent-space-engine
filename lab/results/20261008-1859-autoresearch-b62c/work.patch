+/// Throwaway instrumentation for the autoresearch run: splits setup cost into scan+cone,
+/// analytic cross windows, numeric (Wide) windows, and Diophantine queries.
+fn setup_decompose(b: &[Body], sorted: &Sorted, rho: f64, sample: &[u32]) {
+    let (mut scan_ns, mut cross_ns, mut wide_ns, mut q_ns) = (0u128, 0u128, 0u128, 0u128);
+    let (mut pairs, mut scanned, mut evals, mut qsteps) = (0u64, 0u64, 0u64, 0u64);
+    let mut kinds = [0u64; 3];
+    for &i in sample {
+        let bi = &b[i as usize];
+        let t = Instant::now();
+        let (lo, hi) = sorted.range(bi.binet()[0], sorted.reach(bi));
+        let mut cands: Vec<u32> = Vec::new();
+        for &(_, j) in &sorted.order[lo..hi] {
+            if j == i {
+                continue;
+            }
+            scanned += 1;
+            if is_candidate(bi, &b[j as usize], rho) {
+                cands.push(j);
+            }
+        }
+        scan_ns += t.elapsed().as_nanos();
+        for j in cands {
+            let bj = &b[j as usize];
+            pairs += 1;
+            let t = Instant::now();
+            let secs = sections(bi, bj, rho, SAFETY, &mut evals);
+            let el = t.elapsed().as_nanos();
+            let wide = secs.iter().any(|s| s.kind == Kind::Wide);
+            if wide {
+                wide_ns += el;
+            } else {
+                cross_ns += el;
+            }
+            for sec in secs {
+                kinds[sec.kind as usize] += 1;
+                let t = Instant::now();
+                let (pi, pj) = (bi.period as u128, bj.period as u128);
+                let c = ((sec.ti as i128 - sec.tj as i128 + sec.w1 as i128).rem_euclid(pi as i128)) as u128;
+                let d = (pi - pj % pi) % pi;
+                let w = ((sec.w1 + sec.w2).max(0) as u128).min(pi - 1);
+                std::hint::black_box(dioph::first_hit(c, d, pi, 0, w, &mut qsteps));
+                q_ns += t.elapsed().as_nanos();
+            }
+        }
+    }
+    println!(
+        "{{\"exp\":\"decompose\",\"pairs\":{},\"scanned\":{},\"scan_ns_per_pair\":{:.1},\"cross_ns_per_pair\":{:.1},\"wide_ns_per_pair\":{:.1},\"q_ns_per_pair\":{:.1},\"evals_per_pair\":{:.2},\"qsteps_per_pair\":{:.2},\"kinds\":{:?}}}",
+        pairs, scanned,
+        scan_ns as f64 / pairs as f64, cross_ns as f64 / pairs as f64,
+        wide_ns as f64 / pairs as f64, q_ns as f64 / pairs as f64,
+        evals as f64 / pairs as f64, qsteps as f64 / pairs as f64, kinds
+    );
+}
