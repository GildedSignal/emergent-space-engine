+/// Wide-section census: counts are published by `sections` into these globals (instrumentation).
+fn wide_census(b: &[Body], sorted: &Sorted, rho: f64, sample: &[u32]) {
+    {
+        use emergent_encounters::pairs::WIDE_CENSUS;
+        use std::sync::atomic::Ordering;
+        WIDE_CENSUS.iter().for_each(|c| c.store(0, Ordering::Relaxed));
+    }
+    let mut evals = 0u64;
+    for &i in sample {
+        let bi = &b[i as usize];
+        let (lo, hi) = sorted.range(bi.binet()[0], sorted.reach(bi));
+        for &(_, j) in &sorted.order[lo..hi] {
+            if j == i || !is_candidate(bi, &b[j as usize], rho) {
+                continue;
+            }
+            std::hint::black_box(sections(bi, &b[j as usize], rho, SAFETY, &mut evals));
+        }
+    }
+    {
+        use emergent_encounters::pairs::WIDE_CENSUS;
+        use std::sync::atomic::Ordering;
+        let [m0, mp, ni, lt02, l02t05, ge05, crej] = std::array::from_fn(|k| WIDE_CENSUS[k].load(Ordering::Relaxed));
+        println!(
+            "{{\"exp\":\"wide_census\",\"merged0\":{},\"merged_pi\":{},\"near_ident\":{},\"cross_lt02\":{},\"cross_02_05\":{},\"cross_ge05\":{},\"cross_window_rejected\":{}}}",
+            m0, mp, ni, lt02, l02t05, ge05, crej
+        );
+    }
+}
