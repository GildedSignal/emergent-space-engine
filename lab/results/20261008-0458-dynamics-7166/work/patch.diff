+// Divergence check: EventCore vs Chronon on the same trapped gas, same law, over time.
+use emergent_lattice::chronon::Chronon;
+use emergent_lattice::{Law, Stepper, worlds};
+use emergent_lattice_event::EventCore;
+
+#[test]
+fn divergence() {
+    let q = 1024;
+    let mk = || worlds::gas(1024, 0.05, q, q / 8, 7).with_law(Law::RelativisticV1).unwrap();
+    let mut r = Chronon::new(mk(), true).unwrap();
+    let mut e = EventCore::new(mk(), false).unwrap();
+    println!("tick | chronon fired ops | event fired ops | same world digest");
+    for t in [300i64, 600, 900, 1200, 1500, 1700] {
+        r.run_to(t);
+        while e.tick() < t { e.advance(t, u64::MAX); }
+        let (rm, em) = (r.metrics(), e.metrics());
+        let same = r.world().digest() == e.world().digest();
+        println!("{t} | {} {} | {} {} | {same} (event tick {})", rm.fired, rm.ops, em.fired, em.ops, e.tick());
+    }
+}
