+/// [`plane_extra`] with the player moved into the belt band: the same universe bit for bit except the player, a body of
+/// the root doll on a circular orbit at `au_q8` e-2^8 AU about the star (the belt is 2–3 AU, on the same 2^-8 AU grid).
+/// The lab's probe scene for the seam the record names untested (the player inside the band when the wave arrives);
+/// not a game scene.
+pub fn plane_extra_band(cfg: Config, seed: u64, order: crate::fleet::Order, threads: usize, members: u64, extra: usize, au_q8: u64) -> Res<Plane> {
+    let (world, _) = emergent_engine::scenes::battle(members, crate::fleet::Q, seed, 1 << 15, false);
+    plane_built(cfg, seed, order, threads, world, extra, Some(au_q8))
+}
