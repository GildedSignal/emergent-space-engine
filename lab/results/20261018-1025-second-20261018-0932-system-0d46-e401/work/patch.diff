+//! The phase-word gather probe (lab run 20261018-1025-second-…-e401): a formation ring — K ships
+//! on ONE compiled orbit (same OrbitSpec but the phase) in Home's doll beside the shipped plane —
+//! flown through the shipped `gather_cached` with the run's print-only tier probe inside it.
+//! The audit and the prices print as TIERPROBE lines; nothing feeds back into the View.
+//! cargo run --release -p emergent-universe --example phasegather -- [K [frames [rtf]]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::{plane_extra, Plane};
+use emergent_universe::{Budget, Config};
+use emergent_space::orbit::Scalar;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let k: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(4_000);
+    let frames: usize = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(600);
+    let rtf: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let e_q48: u64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let Plane { mut u, dolls, names, player, .. } =
+        plane_extra(Config::default(), 1, Order::Sparse, 1, 48, 0).expect("the plane");
+    let home = dolls[1];
+    let peri = Scalar::raw(6_000, 18).unwrap(); // 6000 root units: above the player's 4,740
+    let angle = 0x2000_0000u32;
+    for j in 0..k {
+        let phase = (((j as u128) << 32) / (k as u128)) as u32;
+        let id = u
+            .add_body(emergent_universe::body::Kind::Ship, emergent_universe::OrbitSpec { doll: home, periapsis: peri, e_q48, clockwise: false, angle, phase }, Scalar::raw(3, -2).unwrap())
+            .expect("ring member");
+        let _ = id;
+    }
+    u.start().expect("start");
+    let mut cache = emergent_universe::view::ViewCache::default();
+    let mut names = names;
+    names.resize(u.n_bodies(), String::new());
+    let _ = player;
+    let t0 = std::time::Instant::now();
+    for _ in 0..frames {
+        let _ = u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: None }, i64::MAX);
+        let _ = emergent_universe::view::gather_cached(&u, &names, &mut cache);
+    }
+    println!("phasegather: K={k} frames={frames} rtf={rtf} e_q48={e_q48} bodies={} wall={:.2}s", u.n_bodies(), t0.elapsed().as_secs_f64());
+}
