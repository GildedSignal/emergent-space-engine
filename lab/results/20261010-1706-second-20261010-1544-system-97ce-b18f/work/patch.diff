+/// The trade-off falsifier: the same held-out seed at a 48× tighter threshold (num 1/2^16 =
+/// 1.53e-5). If the anchored law's error is first-order in the window's carried drift (the
+/// offset-carry has no derivative terms), tightening 48× cuts the per-window error ~48² and the
+/// total ~48×, while compiles/kick rise ~48× toward 1 — i.e. no threshold reaches the law's
+/// 10⁻⁶ floor at a compile rate below always-compile. Measured on seed 2, both laws against the
+/// reference.
+#[test]
+fn threshold_tightening_tradeoff() {
+    let (ru, _rw, h) = run_belt(Config { reanchor_num: 0, ..Config::default() }, 2, (SEP, -10));
+    let (au, aw, _) = run_belt(Config { reanchor_num: 1, ..Config::default() }, 2, (SEP, -10));
+    let mut da = Vec::new();
+    let mut unreadable = 0usize;
+    for i in 0..ru.n_bodies() {
+        if ru.rec(i).kind != Kind::Ship {
+            continue;
+        }
+        let (Ok(rst), Ok(ast)) = (ru.rec(i).b.readout(h), au.rec(i).b.readout(h)) else {
+            unreadable += 1;
+            continue;
+        };
+        let el = |st: &emergent_space::binding::IntegerState| -> f64 {
+            let k = 2f64.powi(st.length_exponent as i32);
+            let lv = 2f64.powi(st.velocity_exponent as i32);
+            let x = [st.position[0] as f64 * k, st.position[1] as f64 * k];
+            let v = [st.velocity[0] as f64 * lv, st.velocity[1] as f64 * lv];
+            let r = (x[0] * x[0] + x[1] * x[1]).sqrt();
+            let v2 = v[0] * v[0] + v[1] * v[1];
+            1.0 / (2.0 / r - v2)
+        };
+        let (ra, aa) = (el(&rst), el(&ast));
+        da.push((aa - ra).abs() / ra);
+    }
+    da.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    println!(
+        "seed 2, threshold 1/2^16 (48x tighter): compiles/kick {:.3}, da/a med {:.3e} max {:.3e}, unreadable {unreadable}, wall {aw:.2}s",
+        au.stats.compiles as f64 / au.stats.kicks.max(1) as f64,
+        da[da.len() / 2],
+        da[da.len() - 1],
+    );
+}
+/// Control for the instrument, and the strong field under the re-anchor: ships co-orbital with
+/// the planet (sep ± 1.5–3 Hill radii), where kicks are strongest on this scene. The first run's
+/// control showed every kick rekeying when every kick compiles; here the re-anchor is ON, so what
+/// must hold is different: kicks still fire (the instrument is alive), and the anchored evolution
+/// stays with the reference law within the same bounds as the belt.
+#[test]
+fn control_coorbital_kicks_are_quantum_large() {
+    let mk = |reanchor: u32| {
+        let cfg = Config { reanchor_num: reanchor, ..Config::default() };
+        let mut u = Universe::new(s(emergent_universe::scenario::STAR_RADIUS), cfg);
+        let planet = u
+            .add_body(Kind::Planet, OrbitSpec { doll: 0, periapsis: s(SEP), e_q48: 0, clockwise: false, angle: 0, phase: 0 }, Scalar::ZERO)
+            .unwrap();
+        u.add_doll("planet", planet, -10, Scalar::raw(36_000_000, 0).unwrap()).unwrap();
+        let hill = 36_000_000i64;
+        let ships: Vec<usize> = [1.5f64, 2.0, 2.5, 3.0]
+            .iter()
+            .flat_map(|h| [SEP + (*h as i64) * hill / 3, SEP - (*h as i64) * hill / 3])
+            .map(|r| {
+                u.add_body(Kind::Ship, OrbitSpec { doll: 0, periapsis: s(r), e_q48: 0, clockwise: false, angle: 0x2000_0000, phase: 0 }, Scalar::ZERO).unwrap()
+            })
+            .collect();
+        u.start().unwrap();
+        let pp = planet_period_ticks(&u, planet);
+        let horizon = (pp * 0.2) as i64;
+        let t0 = std::time::Instant::now();
+        u.settle(horizon);
+        (u, ships, horizon, t0.elapsed().as_secs_f64())
+    };
+    let (ru, rships, h, _rw) = mk(0);
+    let (au, aships, h2, aw) = mk(48);
+    assert_eq!(h, h2);
+    let (rs, st2) = (&ru.stats, &au.stats);
+    println!(
+        "control (8 co-orbital ships, 0.2 planet periods): REFERENCE kicks {} rekeys {}; ANCHORED kicks {} (compiles {} = {:.3}/kick, re-anchors {}), wall {aw:.2}s",
+        rs.kicks, rs.rekeys, st2.kicks, st2.compiles, st2.compiles as f64 / st2.kicks.max(1) as f64, st2.anchors
+    );
+    println!("   dv histogram of fired kicks, reference (0,1,2,3-4,>=5 quanta... at the fired word): {:?}", rs.dv_class);
+    assert!(rs.rekeys > 0, "instrument control failed: co-orbital kicks must fire and rekey under the reference law");
+    // Behaviour: the anchored co-orbital evolution against the reference law.
+    let mut devs = Vec::new();
+    for (&i, &j) in rships.iter().zip(aships.iter()) {
+        let (rst, ast) = (ru.rec(i).b.readout(h).unwrap(), au.rec(j).b.readout(h).unwrap());
+        let r0 = (rst.position[0].unsigned_abs().max(rst.position[1].unsigned_abs()) as f64) * 2f64.powi(rst.length_exponent as i32);
+        let dx = (rst.position[0] - ast.position[0]).unsigned_abs().max((rst.position[1] - ast.position[1]).unsigned_abs()) as f64
+            * 2f64.powi(rst.length_exponent as i32);
+        devs.push(dx / r0);
+    }
+    devs.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    println!("   co-orbital |dx|/r vs reference: med {:.3e} max {:.3e}", devs[devs.len() / 2], devs[devs.len() - 1]);
+    let alive_diff = rships.iter().zip(aships.iter()).filter(|(&i, &j)| ru.rec(i).alive != au.rec(j).alive).count();
+    println!("   alive-diff {alive_diff}");
+    let _ = std::mem::size_of::<(Binding, Segment, BodyRec)>();
+}
