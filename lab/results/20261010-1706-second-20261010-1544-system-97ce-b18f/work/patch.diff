diff --git a/crates/universe/tests/hlive.rs b/crates/universe/tests/hlive.rs
new file mode 100644
index 0000000..7d6aa49
--- /dev/null
+++ b/crates/universe/tests/hlive.rs
@@ -0,0 +1,342 @@
+//! Lab probe 20261010-1706-second (second author on 20261010-1544-system-97ce): the re-anchor wired.
+//!
+//! The first run measured that the belt's every fired kick rebinds (1.000/kick) and priced the
+//! designed fix (law.md, "re-anchored"); the checker held gold on wiring it. This file wires it
+//! (Config::reanchor_num, `anchor_or_rebind`): below the law's accumulated-offset threshold
+//! √(floor/C) ≈ 7.3×10⁻⁴ of the motion's own speed, a fired kick keeps the compiled cycle and
+//! rides the binding's residual (exact at the event); past it, or under thrust, it compiles as
+//! before. What is measured: compiles per kick against the design's 0.05, the belt's wall
+//! (the checker's attribution says ≈1.7×), and behaviour against the reference law
+//! (`reanchor_num: 0`, always compile) on held-out seeds and a second perturber.
+//!
+//! Belt scene unchanged from the first run (B18's generator shape, fixed LCG): banded periapsis
+//! 2.1–3.3 AU, Rayleigh e σ=0.1 clamped at 0.3, uniform angle and phase, one Jupiter analog
+//! (5.27e8, 2⁻¹⁰) — here seedable, and with a Saturn analog (9.58e8, 2⁻¹²) for the weak-field row.
+
+use emergent_space::orbit::Scalar;
+use emergent_universe::body::{BodyRec, Segment};
+use emergent_universe::bind::Binding;
+use emergent_universe::num::{s, to_f64};
+use emergent_universe::{Config, Kind, OrbitSpec, Universe};
+
+/// A Jupiter analog: 5.2 AU, mass 2^-10 of the star. A Saturn analog: 9.58 AU, 2^-12.
+const SEP: i64 = 527_000_000;
+const P_LO: i64 = 212_730_000;
+const P_HI: i64 = 333_900_000;
+const N: usize = 384;
+/// Two planet periods.
+const PERIODS: i32 = 2;
+
+struct Lcg(u64);
+impl Lcg {
+    fn f(&mut self) -> f64 {
+        self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        (self.0 >> 11) as f64 / (1u64 << 53) as f64
+    }
+}
+
+/// The belt: `seed` drives the LCG, `planet` is (periapsis, mass log2).
+fn belt(cfg: Config, seed: u64, planet: (i64, i32)) -> (Universe, usize, Vec<usize>) {
+    let mut u = Universe::new(s(emergent_universe::scenario::STAR_RADIUS), cfg);
+    let (sep, mlog2) = planet;
+    let planet = u
+        .add_body(Kind::Planet, OrbitSpec { doll: 0, periapsis: s(sep), e_q48: 0, clockwise: false, angle: 0, phase: 0 }, Scalar::ZERO)
+        .unwrap();
+    u.add_doll("planet", planet, mlog2, Scalar::raw(36_000_000, 0).unwrap()).unwrap();
+    let mut g = Lcg(seed);
+    let ships = (0..N)
+        .map(|_| {
+            let p = P_LO as f64 + g.f() * (P_HI - P_LO) as f64;
+            // Rayleigh(0.1), clamped at 0.3: the belt's eccentricity distribution.
+            let e = (0.1 * (-2.0 * (1.0 - g.f()).ln()).sqrt()).min(0.3);
+            u.add_body(
+                Kind::Ship,
+                OrbitSpec {
+                    doll: 0,
+                    periapsis: s(p as i64),
+                    e_q48: ((1u64 << 48) as f64 * e) as u64,
+                    clockwise: false,
+                    angle: (g.f() * u32::MAX as f64) as u32,
+                    phase: (g.f() * u32::MAX as f64) as u32,
+                },
+                Scalar::ZERO,
+            )
+            .unwrap()
+        })
+        .collect();
+    u.start().unwrap();
+    (u, planet, ships)
+}
+
+fn planet_period_ticks(u: &Universe, planet: usize) -> f64 {
+    let b = &u.rec(planet).b;
+    let emergent_space::binding::Trajectory::Cycle(c) = &b.entry.trajectory else { unreachable!() };
+    to_f64(b.to_doll(c.period().unwrap()).unwrap()) * 2f64.powi(-(u.dolls[b.doll as usize].shift as i32))
+}
+
+fn ship_period_ticks(u: &Universe, ship: usize) -> f64 {
+    let b = &u.rec(ship).b;
+    let emergent_space::binding::Trajectory::Cycle(c) = &b.entry.trajectory else { unreachable!() };
+    to_f64(b.to_doll(c.period().unwrap()).unwrap()) * 2f64.powi(-(u.dolls[b.doll as usize].shift as i32))
+}
+
+/// One settled belt run; returns (universe, wall seconds, horizon).
+fn run_belt(cfg: Config, seed: u64, planet: (i64, i32)) -> (Universe, f64, i64) {
+    let (mut u, planet, _ships) = belt(cfg, seed, planet);
+    let pp = planet_period_ticks(&u, planet);
+    let horizon = (pp * PERIODS as f64) as i64;
+    let t0 = std::time::Instant::now();
+    u.settle(horizon);
+    (u, t0.elapsed().as_secs_f64(), horizon)
+}
+
+fn report(u: &Universe, wall: f64, horizon: i64, tag: &str) {
+    let st = &u.stats;
+    let game_s = horizon as f64 * emergent_universe::view::TICK_SECONDS;
+    let events = st.events();
+    let sp = ship_period_ticks(u, 1);
+    let per_body_orbit = events as f64 / N as f64 / (horizon as f64 / sp);
+    println!(
+        "== {tag}: events {events} (kicks {}, opens {}, boundaries {}), refused {}, lost {} | {game_s:.3e} game-s ==",
+        st.kicks, st.opens, st.boundaries, st.refused, st.lost
+    );
+    println!(
+        "   {:.1} events/body/ship-orbit; wall {wall:.2} s = {:.1} us/event; rebinds {} (compiles {}, re-anchors {}), rekeys {} ({:.4}/kick), compiles/kick {:.5}",
+        per_body_orbit,
+        wall * 1e6 / events.max(1) as f64,
+        st.rebinds,
+        st.compiles,
+        st.anchors,
+        st.rekeys,
+        st.rekeys as f64 / st.kicks.max(1) as f64,
+        st.compiles as f64 / st.kicks.max(1) as f64,
+    );
+    println!(
+        "   fired |dv| quanta: mean {:.3e} max {:.3e} (over {} fired kicks); dv classes [0,1,2,3-4,>=5]: {:?}",
+        st.dv_total as f64 / st.kicks_dv.max(1) as f64,
+        st.dv_max,
+        st.kicks_dv,
+        st.dv_class
+    );
+}
+
+/// The first run's record, then the same belt with the re-anchor wired, at both cadences.
+#[test]
+fn belt_reference_vs_anchored() {
+    for step_log2 in [7, 4] {
+        let (u, wall, h) = run_belt(Config { step_log2, reanchor_num: 0, ..Config::default() }, 0x5EED_97CE_0000_0001, (SEP, -10));
+        report(&u, wall, h, &format!("step_log2 {step_log2} REFERENCE (always compile)"));
+        let (u, wall, h) = run_belt(Config { step_log2, reanchor_num: 48, ..Config::default() }, 0x5EED_97CE_0000_0001, (SEP, -10));
+        report(&u, wall, h, &format!("step_log2 {step_log2} ANCHORED (threshold 48/2^16)"));
+    }
+}
+
+/// How far the belt ever gets from a recompile, and the dv the fires carry.
+#[test]
+fn belt_offset_headroom() {
+    let (u, wall, h) = run_belt(Config { reanchor_num: 48, ..Config::default() }, 0x5EED_97CE_0000_0001, (SEP, -10));
+    report(&u, wall, h, "ANCHORED headroom");
+    let mut max_carried: f64 = 0.0;
+    let mut min_threshold: f64 = f64::INFINITY;
+    for i in 0..u.n_bodies() {
+        let rec = u.rec(i);
+        if rec.kind != Kind::Ship {
+            continue;
+        }
+        let carried = rec.carried[0].unsigned_abs().max(rec.carried[1].unsigned_abs());
+        let st = rec.b.readout(h).unwrap();
+        let speed = (st.velocity[0].unsigned_abs() + st.velocity[1].unsigned_abs()) as f64;
+        max_carried = max_carried.max(carried as f64);
+        min_threshold = min_threshold.min(48.0 * speed / 65536.0);
+    }
+    println!(
+        "max |carried| since anchor: {max_carried:.0} quanta; smallest recompile threshold on the belt: {min_threshold:.3e} quanta; headroom {:.3e}x",
+        min_threshold / max_carried.max(1.0)
+    );
+}
+
+/// Behaviour against the reference law on held-out seeds and both perturbers: per-ship final
+/// state deviation, semi-major axis and eccentricity drift, event counts, and determinism of
+/// the anchored path itself.
+#[test]
+fn behaviour_vs_reference_many_seeds() {
+    let cases: Vec<(u64, (i64, i32), &str)> = vec![
+        (2, (SEP, -10), "jupiter"),
+        (3, (SEP, -10), "jupiter"),
+        (4, (SEP, -10), "jupiter"),
+        (5, (SEP, -10), "jupiter"),
+        (6, (SEP, -10), "jupiter"),
+        (2, (958_000_000, -12), "saturn"),
+        (3, (958_000_000, -12), "saturn"),
+        (4, (958_000_000, -12), "saturn"),
+    ];
+    for (seed, planet, name) in cases {
+        let (ru, _rw, h) = run_belt(Config { reanchor_num: 0, ..Config::default() }, seed, planet);
+        let (au, aw, h2) = run_belt(Config { reanchor_num: 48, ..Config::default() }, seed, planet);
+        assert_eq!(h, h2, "the horizon must not depend on the law's memo");
+        let mut devs = Vec::with_capacity(N);
+        let mut da_rel = Vec::with_capacity(N);
+        let mut de = Vec::with_capacity(N);
+        let mut lost_diff = 0usize;
+        for i in 0..ru.n_bodies() {
+            if ru.rec(i).kind != Kind::Ship {
+                continue;
+            }
+            lost_diff += (ru.rec(i).alive != au.rec(i).alive) as usize;
+            let (Ok(rst), Ok(ast)) = (ru.rec(i).b.readout(h), au.rec(i).b.readout(h)) else {
+                // A readout outside the word is itself the deviation: count it, don't die on it.
+                devs.push(f64::INFINITY);
+                da_rel.push(f64::INFINITY);
+                de.push(f64::INFINITY);
+                continue;
+            };
+            let r0 = (rst.position[0].unsigned_abs().max(rst.position[1].unsigned_abs()) as f64) * 2f64.powi(rst.length_exponent as i32);
+            let dx = (rst.position[0] - ast.position[0]).unsigned_abs().max((rst.position[1] - ast.position[1]).unsigned_abs()) as f64
+                * 2f64.powi(rst.length_exponent as i32);
+            devs.push(dx / r0);
+            // Elements in the doll's units (mu = 1): a = 1/(2/r - v^2), e from the eccentricity vector.
+            let el = |st: &emergent_space::binding::IntegerState| -> (f64, f64) {
+                let k = 2f64.powi(st.length_exponent as i32);
+                let lv = 2f64.powi(st.velocity_exponent as i32);
+                let x = [st.position[0] as f64 * k, st.position[1] as f64 * k];
+                let v = [st.velocity[0] as f64 * lv, st.velocity[1] as f64 * lv];
+                let r = (x[0] * x[0] + x[1] * x[1]).sqrt();
+                let v2 = v[0] * v[0] + v[1] * v[1];
+                let a = 1.0 / (2.0 / r - v2);
+                let rv = x[0] * v[0] + x[1] * v[1];
+                let ev = [(v2 - 1.0 / r) * x[0] - rv * v[0], (v2 - 1.0 / r) * x[1] - rv * v[1]];
+                (a, (ev[0] * ev[0] + ev[1] * ev[1]).sqrt())
+            };
+            let (ra, re) = el(&rst);
+            let (aa, ae) = el(&ast);
+            da_rel.push((aa - ra).abs() / ra);
+            de.push((ae - re).abs());
+        }
+        devs.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        da_rel.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        de.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let q = |v: &Vec<f64>, p: f64| v[(((v.len() as f64) * p) as usize).min(v.len() - 1)];
+        println!(
+            "seed {seed} {name}: ref kicks {} vs anchored {}; |dx|/r med {:.3e} p99 {:.3e} max {:.3e} | da/a med {:.3e} p99 {:.3e} max {:.3e} | de med {:.3e} max {:.3e} | alive-diff {lost_diff} | anchored wall {aw:.2}s, compiles/kick {:.5}",
+            ru.stats.kicks,
+            au.stats.kicks,
+            q(&devs, 0.5),
+            q(&devs, 0.99),
+            devs[devs.len() - 1],
+            q(&da_rel, 0.5),
+            q(&da_rel, 0.99),
+            da_rel[da_rel.len() - 1],
+            q(&de, 0.5),
+            de[de.len() - 1],
+            au.stats.compiles as f64 / au.stats.kicks.max(1) as f64,
+        );
+        println!();
+    }
+    // Determinism of the anchored path: the same seed twice is the same universe.
+    let (a, _, h) = run_belt(Config { reanchor_num: 48, ..Config::default() }, 7, (SEP, -10));
+    let (b, _, _) = run_belt(Config { reanchor_num: 48, ..Config::default() }, 7, (SEP, -10));
+    assert_eq!(a.stats.kicks, b.stats.kicks, "anchored kick count must be deterministic");
+    for i in 0..a.n_bodies() {
+        let (ra, rb) = (a.rec(i).b.readout(h), b.rec(i).b.readout(h));
+        assert_eq!(ra.is_ok(), rb.is_ok(), "readout failure must be deterministic too");
+        if let (Ok(ra), Ok(rb)) = (&ra, &rb) {
+            assert_eq!(ra.position, rb.position, "anchored positions must be bit-identical");
+        }
+    }
+    println!("determinism: seed 7 twice, kicks {} and readouts bit-identical", a.stats.kicks);
+}
