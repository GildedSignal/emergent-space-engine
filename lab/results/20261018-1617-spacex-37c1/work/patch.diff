 use crate::law::{dot, sub, Body, Container, Law, Response, World};
 use num_bigint::BigInt;
 
+/// Print-only contact census switch (lab run 20261018-1617-spacex-37c1): SPACEX_CENSUS=1 logs
+/// every pair that reaches a response batch, with the receding gate's own integers.
+static CENSUS: std::sync::LazyLock<bool> =
+    std::sync::LazyLock::new(|| std::env::var_os("SPACEX_CENSUS").is_some_and(|v| v != "0"));
+
 /// Fixed-point scale of γ in v0: 2^16. Γ is floored before the product with Q, so Γ = F for
 /// every |k| < √(2/F)·Q and v0's energy cannot see kinetic energy below about 0.0055c
 /// (measured in H0173); v1 fixes this.
@@ -233,6 +238,14 @@ pub fn resolve_law(
         }
         let d = sub(bodies[b].x, bodies[a].x);
         let w = sub(k[b], k[a]);
+        let dw = (d[0] as i128) * (w[0] as i128) + (d[1] as i128) * (w[1] as i128);
+        let ww = (w[0] as i128) * (w[0] as i128) + (w[1] as i128) * (w[1] as i128);
+        if *CENSUS {
+            // Print-only census (lab run 20261018-1617-spacex-37c1): every pair that reached
+            // this response batch, with the exact integers of the receding gate below. The gate
+            // drops the pair (a detected contact that exchanges nothing) iff dw ≥ 0.
+            eprintln!("CENSUS {ww} {dw} {}", (bodies[a].radius + bodies[b].radius) as i128);
+        }
         if dot(d, w) >= 0 || dot(d, d) == 0 {
             continue;
         }
