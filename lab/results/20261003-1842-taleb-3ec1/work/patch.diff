+/// Lazy sections for a dormancy certificate: the arcs and their cap (passage-overlap) windows only.
+/// The cap window is a superset of every offset s that can hold an encounter (both bodies must be
+/// inside the arc's longitude span at once), so a first-hit query against it is sound for skipping:
+/// if no passage lands in the cap window within the horizon, none lands in the true window either.
+/// No numeric refinement, no cross windows: cost is a few closed-form Kepler solves per arc.
+pub fn lazy_sections(bi: &Body, bj: &Body, rho: f64) -> Vec<Section> {
+    let (a, b) = (bi.binet(), bj.binet());
+    let du = a[0] - b[0];
+    let dv = a[1] - b[1];
+    let dw = a[2] - b[2];
+    let r = dv.hypot(dw);
+    let eps = eps_u(bi, bj, rho);
+    if du.abs() - r >= eps {
+        return Vec::new();
+    }
+    if r < 1e-300 {
+        return vec![full_section(bi, bj, rho)];
+    }
+    let th0 = dw.atan2(dv);
+    let c_lo = (-eps - du) / r;
+    let c_hi = (eps - du) / r;
+    let merged0 = c_hi >= 1.0;
+    let merged_pi = c_lo <= -1.0;
+    let phi1 = c_hi.min(1.0).acos();
+    let phi2 = c_lo.max(-1.0).acos();
+    let arcs = if merged0 && merged_pi {
+        return vec![full_section(bi, bj, rho)];
+    } else if merged0 {
+        vec![Arc { c: th0, dm: phi2, dp: phi2, cross: false }]
+    } else if merged_pi {
+        vec![Arc { c: th0 + PI, dm: PI - phi1, dp: PI - phi1, cross: false }]
+    } else {
+        let phx = (-du / r).clamp(-1.0, 1.0).acos();
+        vec![
+            Arc { c: th0 + phx, dm: phx - phi1, dp: phi2 - phx, cross: true },
+            Arc { c: th0 - phx, dm: phi2 - phx, dp: phx - phi1, cross: true },
+        ]
+    };
+    arcs.into_iter().map(|arc| lazy_arc_section(bi, bj, &arc)).collect()
+}
+
+fn lazy_arc_section(bi: &Body, bj: &Body, arc: &Arc) -> Section {
+    let th = arc.c.rem_euclid(TAU);
+    let di = (bi.travel(th - arc.dm, th), bi.travel(th, th + arc.dp));
+    let dj = (bj.travel(th - arc.dm, th), bj.travel(th, th + arc.dp));
+    let cap = (dj.0 + di.1, dj.1 + di.0);
+    Section {
+        kind: Kind::Wide,
+        theta: th,
+        ti: bi.passage_tick(th),
+        tj: bj.passage_tick(th),
+        w1: ticks_up(cap.0),
+        w2: ticks_up(cap.1),
+        di,
+        dj,
+    }
+}
+
 fn ticks_up(x: f64) -> i64 {
     (x * TICKS).ceil() as i64
 }
