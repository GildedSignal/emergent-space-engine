+/// The first tick at which a passage of j through the section's reference longitude has its offset
+/// inside the section window (the engine's own first-hit query, as in setup_cost and run_section).
+fn first_proposal_ticks(bi: &Body, bj: &Body, sec: &Section, qsteps: &mut u64) -> Option<u128> {
+    let (pi, pj) = (bi.period as u128, bj.period as u128);
+    if pi == 0 || pj == 0 {
+        return None;
+    }
+    let c = ((sec.ti as i128 - sec.tj as i128 + sec.w1 as i128).rem_euclid(pi as i128)) as u128;
+    let d = (pi - pj % pi) % pi;
+    let w = ((sec.w1 + sec.w2).max(0) as u128).min(pi - 1);
+    let l = dioph::first_hit(c, d, pi, 0, w, qsteps)?;
+    Some(sec.tj as u128 + l * pj)
+}
+
+fn min_first_proposal_orbits(bi: &Body, bj: &Body, secs: &[Section], qsteps: &mut u64) -> Option<f64> {
+    let mut best: Option<u128> = None;
+    for sec in secs {
+        if let Some(t) = first_proposal_ticks(bi, bj, sec, qsteps) {
+            best = Some(best.map_or(t, |b: u128| b.min(t)));
+        }
+    }
+    best.map(|t| t as f64 / TICKS / TAU)
+}
