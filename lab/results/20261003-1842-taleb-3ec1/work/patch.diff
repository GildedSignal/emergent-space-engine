+/// The player wildcard: one body kicked to high e at the belt's dense end re-setups O(N) pairs.
+fn kicktail() {
+    for n in [2_500usize, 10_000, 40_000] {
+        let sp = spec("kicktail", n, 1e-2, 1e-4, 1.0, 1.5, 0, 0.0, 20261060 + n as u64);
+        let b = make_belt(&sp);
+        let sorted = Sorted::new(&b, sp.rho);
+        let nm = n.min(200);
+        let msample: Vec<u32> = (0..nm).map(|k| (k * n / nm) as u32).collect();
+        let mut mc: Vec<u64> = Vec::new();
+        for &i in &msample {
+            let bi = &b[i as usize];
+            let (lo, hi) = sorted.range(bi.binet()[0], sorted.reach(bi));
+            let mut c = 0u64;
+            for &(_, j) in &sorted.order[lo..hi] {
+                if j != i && is_candidate(bi, &b[j as usize], sp.rho) {
+                    c += 1;
+                }
+            }
+            mc.push(c);
+        }
+        mc.sort();
+        let med_c = mc[mc.len() / 2];
+        for e_inj in [0.05, 0.1, 0.3, 0.5] {
+            let inj = Body::new(1.02, e_inj, 0.7, 1.3);
+            let (lo, hi) = sorted.range(inj.binet()[0], sorted.reach(&inj));
+            let mut pairs = 0u64;
+            let mut evals = 0u64;
+            let mut qs = 0u64;
+            let t0 = Instant::now();
+            for &(_, j) in &sorted.order[lo..hi] {
+                let bj = &b[j as usize];
+                if !is_candidate(&inj, bj, sp.rho) {
+                    continue;
+                }
+                pairs += 1;
+                for sec in sections(&inj, bj, sp.rho, SAFETY, &mut evals) {
+                    std::hint::black_box(first_proposal_ticks(&inj, bj, &sec, &mut qs));
+                }
+            }
+            let eager_s = t0.elapsed().as_secs_f64();
+            let (mut lpairs, mut lqs) = (0u64, 0u64);
+            let t1 = Instant::now();
+            for &(_, j) in &sorted.order[lo..hi] {
+                let bj = &b[j as usize];
+                if !is_candidate(&inj, bj, sp.rho) {
+                    continue;
+                }
+                lpairs += 1;
+                for sec in lazy_sections(&inj, bj, sp.rho) {
+                    std::hint::black_box(first_proposal_ticks(&inj, bj, &sec, &mut lqs));
+                }
+            }
+            let lazy_s = t1.elapsed().as_secs_f64();
+            println!(
+                "{{\"exp\":\"kicktail\",\"n\":{},\"sigma_e\":1e-2,\"rho\":1e-4,\"e_inject\":{},\"median_body_cands\":{},\"cands\":{},\
+\"eager_ms\":{:.2},\"eager_us_per_pair\":{:.2},\"eager_evals_per_pair\":{:.2},\"lazy_ms\":{:.2},\"lazy_us_per_pair\":{:.2},\
+\"extrap_eager_s_at_1e6\":{:.2},\"extrap_lazy_s_at_1e6\":{:.2}}}",
+                n, e_inj, med_c, pairs,
+                eager_s * 1e3, eager_s * 1e6 / pairs.max(1) as f64, evals as f64 / pairs.max(1) as f64,
+                lazy_s * 1e3, lazy_s * 1e6 / lpairs.max(1) as f64,
+                eager_s * 1e6 as f64 / n as f64, lazy_s * 1e6 as f64 / n as f64
+            );
+        }
+    }
+}
