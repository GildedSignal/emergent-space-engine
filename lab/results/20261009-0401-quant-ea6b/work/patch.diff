+/// Coarse wall-clock timers for the kick path (lab run 20261009-0401-quant-ea6b: where one kick's
+/// time goes). Thread-local, additive, printed by the kick bench; zero effect when unread.
+pub mod stages {
+    pub const N: usize = 6;
+    pub const NAMES: [&str; N] = ["readout", "gather", "forces_clock", "rebind", "other", "total"];
+    thread_local! {
+        static NS: std::cell::RefCell<[u64; N]> = const { std::cell::RefCell::new([0; N]) };
+    }
+    pub fn add(i: usize, ns: u64) {
+        NS.with(|c| c.borrow_mut()[i] += ns);
+    }
+    pub fn report() -> String {
+        NS.with(|c| {
+            let c = c.borrow();
+            let sum: u64 = c[..4].iter().sum();
+            format!(
+                "readout_ns={} gather_ns={} forces_clock_ns={} rebind_ns={} other_ns={} total_ns={}",
+                c[0], c[1], c[2], c[3], c[5].saturating_sub(sum), c[5]
+            )
+        })
+    }
+}
