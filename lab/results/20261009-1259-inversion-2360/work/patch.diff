+    #[test]
+    fn window_spans_cover_brute() {
+        // The enumerated spans cover exactly the brute-force λ̄-close ticks.
+        let cases = [
+            (57u64, 61u64, 0.30f64, 20_000i128),
+            (1000u64, 998u64, 0.05f64, 200_000i128),
+            (4096u64, 4104u64, 0.02f64, 500_000i128),
+            (123_457u64, 123_503u64, 0.004f64, 3_000_000i128),
+        ];
+        for (pi, pj, win, tmax) in cases {
+            let bi = Body::with_period(pi, 0.01, 0.3, 0.0);
+            let bj = Body::with_period(pj, 0.02, 0.5, 0.0);
+            let mut st = TrainStats::default();
+            let spans = window_spans(&bi, &bj, win, 0, tmax, &mut st);
+            assert!(!spans.is_empty(), "case ({pi},{pj}) must open at least one span");
+            let dlam = |t: i128| -> f64 {
+                let li = TAU * (((t - bi.tp as i128) as f64) / pi as f64).fract();
+                let lj = TAU * (((t - bj.tp as i128) as f64) / pj as f64).fract();
+                let d = (li + bi.pom - lj - bj.pom).rem_euclid(TAU);
+                d.min(TAU - d)
+            };
+            for t in 0..tmax {
+                if dlam(t) <= win * 0.999 {
+                    assert!(spans.iter().any(|&(a, b)| t >= a && t <= b), "tick {t} close but uncovered ({pi},{pj})");
+                }
+            }
+            for &(a, b) in &spans {
+                assert!((a..=b).any(|t| dlam(t) <= win * 1.001), "phantom span {a}..{b} ({pi},{pj})");
+            }
+        }
+    }
