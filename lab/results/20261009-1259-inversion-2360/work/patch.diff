+                e_max: e_j.max(e_i),
+                p_min: bi.p.min(bj.p),
+                dv_max: (bi.e * bi.cp - bj.e * bj.cp).hypot(bi.e * bi.sp - bj.e * bj.sp),
+            };
+            let w = ctx.window(&bi, &bj);
+            for _ in 0..200 {
+                let t = 6.0 * rng.f64();
+                let (si, sj) = (bi.state(t), bj.state(t));
+                let d = (si[0] - sj[0]).hypot(si[1] - sj[1]);
+                if d < rho {
+                    close += 1;
+                    let dl = (lam_bar(&bi, t) - lam_bar(&bj, t)).rem_euclid(TAU);
+                    let dl = dl.min(TAU - dl);
+                    assert!(dl <= w + 1e-12, "encounter at {t}: |Δλ̄|={dl} > window {w} (dpom {dpom})");
+                }
+            }
+        }
+        assert!(close > 50, "the probe must actually find encounters (found {close})");
+    }
+
+    #[test]
+    fn equal_period_pair() {
+        // Same period: one sweep covers all time and events repeat with the period; a λ̄-far
+        // equal-period pair sweeps nothing.
+        let rho = 1e-4;
+        let near = (Body::new(1.0, 0.0, 0.0, 0.0), Body::new(1.0, 5e-5, 0.0, 3e-5));
+        let far = (Body::new(1.0, 0.0, 0.0, 0.0), Body::new(1.0, 5e-5, 0.0, 0.05));
+        let p = near.0.period;
+        let mut st = TrainStats::default();
+        let mut out = Vec::new();
+        train_events(&[near.0, near.1], &[0, 1], rho, 0.0, 10.0 * TAU, &mut st, &mut out);
+        assert_eq!(st.equal_p, 1);
+        assert!(!out.is_empty(), "the oscillating co-period pair must encounter");
+        // up to two minima per period (both lobes of the equation of centre): every event must
+        // sit at one of the first period's residues, modulo the period.
+        let pt = p as f64 / TICKS;
+        let residues: Vec<f64> = out.iter().take(2).map(|e| e.2).collect();
+        assert!(out.len() >= 4, "several periods must be covered");
+        for e in &out {
+            assert!(
+                residues.iter().any(|&r| {
+                    let v = ((e.2 - r) % pt + pt) % pt;
+                    v.min(pt - v) < 1e-6
+                }),
+                "event {e:?} not periodic with P"
+            );
+        }
+        let mut st2 = TrainStats::default();
+        let mut out2 = Vec::new();
+        train_events(&[far.0, far.1], &[0, 1], rho, 0.0, 10.0 * TAU, &mut st2, &mut out2);
+        assert!(out2.is_empty() && st2.windows == 0, "λ̄-far equal-period pair must not sweep");
+    }
+
+    #[test]
+    fn train_matches_truth_on_a_formation() {
+        // A bunched formation: the train and the r8 truth construction agree on every pair.
+        let rho = 1e-4;
+        let mut rng = crate::belt::Rng(7);
+        let pom0 = TAU * rng.f64();
+        let lam0 = TAU * rng.f64();
+        let mut b: Vec<Body> = (0..12)
+            .map(|_| {
+                let a = 1.0 + (rng.f64() - 0.5) * 2e-5;
+                let e = (0.001 * (-2.0 * (1.0 - rng.f64()).ln()).sqrt()).min(0.01);
+                Body::new(a, e, pom0 + (rng.f64() - 0.5) * 0.2, lam0 + 0.02 * (rng.f64() - 0.5) * 2.0)
+            })
+            .collect();
+        // guarantee one near-twin pair (identical elements but a small mean-longitude offset)
+        b[1] = Body::new(b[0].a, b[0].e, b[0].pom, 3e-5);
+        let members: Vec<u32> = (0..b.len() as u32).collect();
+        let t_end = 2.0 * TAU;
+        let mut st = TrainStats::default();
+        let mut out = Vec::new();
+        train_events(&b, &members, rho, 0.0, t_end, &mut st, &mut out);
+        let mut tst = crate::truth::TruthStats::default();
+        let mut truth: Vec<(u32, u32, f64, f64)> = Vec::new();
+        for i in 0..b.len() {
+            for j in (i + 1)..b.len() {
+                let mut tmp = Vec::new();
+                crate::truth::truth_pair(&b[i], &b[j], rho, t_end, &mut tmp, &mut tst);
+                truth.extend(tmp.iter().map(|&(t, d)| (i as u32, j as u32, t, d)));
+            }
+        }
+        assert!(!truth.is_empty(), "the formation must produce encounters");
+        let inside = |t: f64| t > 0.05 && t < t_end - 0.05;
+        let tol = 1e-3;
+        for e in truth.iter().filter(|e| inside(e.2)) {
+            assert!(
+                out.iter().any(|m| m.0 == e.0 && m.1 == e.1 && (m.2 - e.2).abs() < tol),
+                "train missed {e:?}"
+            );
+        }
+        for m in out.iter().filter(|m| inside(m.2)) {
+            assert!(
+                truth.iter().any(|e| e.0 == m.0 && e.1 == m.1 && (e.2 - m.2).abs() < tol),
+                "train phantom {m:?}"
+            );
+        }
+    }
+}
