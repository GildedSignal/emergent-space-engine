+//! The phase-neighbour (train) certificate for co-orbital clumps.
+//!
+//! Lab gold `20261006-0346-taleb-09b5`: under co-orbital concentration (a fleet in formation)
+//! the pairwise tier is quadratic in the clump (n_c²/2 sections, each paying a numeric window)
+//! and its window construction even misses real encounters, while every measured encounter lies
+//! within phase-neighbour rank 4 of its partner. This module replaces the pairwise tier *inside a
+//! detected clump* by a sound longitudinal watch at O(n_c·k):
+//!
+//! 1. An encounter (distance < ρ) implies the true longitudes differ by at most
+//!    δ = (π/2)·ρ/r_min: at radii ≥ r_min the chord is ≥ 2·r_min·sin(|Δλ|/2).
+//! 2. True longitude λ = ϖ + ν differs from mean longitude λ̄ = ϖ + M by the equation of centre
+//!    G = ν − M, a function of (e, M) only — a pair's apsidal difference never enters G itself.
+//!    At an encounter the two bodies share a true longitude λ (within δ), so
+//!        Δλ̄ = Δλ − [G_i(M_i) − G_j(M_j)],
+//!    |ΔG| ≤ L_E·|Δλ| + sup_λ|g_i(λ) − g_j(λ)| with g(λ) = G(M(λ−ϖ; e)) and
+//!    L_E(e) = sup|dg/dλ| = √(1+e)/(1−e)^{3/2} − 1 (extremal at the apses). The sup over shared
+//!    longitude is a phasor difference: g ≈ 2e sin(λ−ϖ), so sup_λ|g_i − g_j| ≤ K_v·|(ΔV, ΔW)|·p,
+//!    the Binet (V, W) distance (verified numerically in the tests; ϖ enters only through the
+//!    vector, so mirrored apsides are covered by the same formula). Hence an encounter implies
+//!        |Δλ̄| ≤ δ·(1 + L_E) + K_v·p·|(ΔV, ΔW)| =: L̄_ij        (the tight window),
+//!    or coarsely |Δλ̄| ≤ δ + φ(e_i) + φ(e_j) with φ(e) = sup_M|G| (the crude window, also
+//!    ϖ-free). The watch takes the min of the two.
+//! 3. Δλ̄ drifts linearly on the integer clock, so every time span with |Δλ̄| ≤ L̄ is found
+//!    exactly as a windowed circle rotation (`first_hit`; periods ≤ 2^42 keep every u128 product
+//!    below 2^126). Equal integer periods make the relative configuration exactly periodic:
+//!    one period sweep covers all time, and events repeat with the period.
+//! 4. Inside each window the pair is swept by this module's own conservative stepping (a plain
+//!    quadratic distance bound) with Newton states; the truth (truth.rs) uses Halley states and a
+//!    Gronwall-refined bound — the two paths share no solver and no step control.
+//!
+//! Trigger. A clump is a connected component of Binet points under L1 distance ≤ D_c. It fires
+//! the train when the dimensionless watch degree ζ = 2·n_c·L̄_max/(spread(λ̄)·(n_c−1)) is < 1:
+//! the watch then touches fewer pairs than the pairwise tier's n_c(n_c−1)/2 setups. Declined
+//! clumps stay on the pairwise tier, unchanged.
+
+use crate::dioph::first_hit;
+use crate::kepler::{rel, Body, TICKS};
+use crate::pairs::{dot, is_candidate, norm, refine};
+use std::f64::consts::{PI, TAU};
+
+/// sup|dG/dλ| with G = ν − M as a function of true longitude (see the module doc). Rigorous:
+/// dM/dν = (1−e²)^{3/2}/(1+e cos ν)² is extremal at the apses, and sup|1 − x| ≤ sup|1/x − 1|.
+#[inline]
+pub fn l_e(e: f64) -> f64 {
+    (1.0 + e).sqrt() / (1.0 - e).powf(1.5) - 1.0
+}
+
+/// A bound on the phasor Lipschitz constant: sup_λ|g_{e1,ϖ1}(λ) − g_{e2,ϖ2}(λ)| ≤
+/// K_v·|(e cos ϖ, e sin ϖ) difference|. g = 2e sin(λ−ϖ) + O(e²) makes 2 + 6e generous; the test
+/// `bounds_hold` verifies it by finite differences to e = 0.4.
+#[inline]
+pub fn k_v(e: f64) -> f64 {
+    2.0 + 6.0 * e
+}
+
+/// φ(e) = sup_ν |ν − M(ν)|, in closed form: the extremum of G = ν − M sits where
+/// dG/dν = 1 − (1−e²)^{3/2}/(1+e cos ν)² = 0, i.e. 1+e cos ν* = (1−e²)^{3/4}; G vanishes at
+/// the apses, so this interior critical point is the supremum (the two lobes are antisymmetric).
+pub fn phi_e(e: f64) -> f64 {
+    if e <= 0.0 {
+        return 0.0;
+    }
+    let c = (((1.0 - e * e).powf(0.75) - 1.0) / e).clamp(-1.0, 1.0);
+    let nu = c.acos();
+    let (s, co) = (0.5 * nu).sin_cos();
+    let ea = 2.0 * ((1.0 - e).sqrt() * s).atan2((1.0 + e).sqrt() * co);
+    (nu - ea + e * ea.sin()).abs()
+}
+
+/// |Δ(V, W)|·p: the pair's Binet e-vector distance in length units.
+#[inline]
+fn d_v(bi: &Body, bj: &Body) -> f64 {
+    let p = bi.p.min(bj.p);
+    let (a, b) = (bi.binet(), bj.binet());
+    p * ((a[1] - b[1]).hypot(a[2] - b[2]))
+}
+
+/// Clump-wide constants for the watch window.
+pub struct Ctx {
+    /// (π/2)·ρ/r_min over the clump: an encounter's true-longitude tolerance.
+    pub delta: f64,
+    pub e_max: f64,
+    pub p_min: f64,
+    /// Upper bound on any pairwise e-vector distance in the clump (the bbox diagonal).
+    pub dv_max: f64,
+}
+
+impl Ctx {
+    /// The sound mean-longitude window L̄_ij (radians): an encounter implies |Δλ̄| ≤ this.
+    #[inline]
+    pub fn window(&self, bi: &Body, bj: &Body) -> f64 {
+        let crude = self.delta + phi_e(bi.e) + phi_e(bj.e);
+        let tight = self.delta * (1.0 + l_e(self.e_max)) + k_v(self.e_max) * d_v(bi, bj);
+        crude.min(tight)
+    }
+
+    /// The walk bound for body i: any L̄_ij + drift_ij with j in the clump is ≤ this (the two
+    /// windows are maximised by the clump's φ and e-vector spreads; the drift by the clump's
+    /// mean-motion spread over the horizon h).
+    #[inline]
+    pub fn walk_bound(&self, bi: &Body, n_i: f64, n_lo: f64, n_hi: f64, h: f64) -> f64 {
+        let crude = self.delta + phi_e(bi.e) + phi_e(self.e_max);
+        let tight = self.delta * (1.0 + l_e(self.e_max)) + k_v(self.e_max) * self.dv_max;
+        crude.min(tight) + h * (n_hi - n_i).max(n_i - n_lo)
+    }
+}
+
+/// Mean longitude at time t (radians, [0, TAU)).
+#[inline]
+fn lam_bar(b: &Body, t: f64) -> f64 {
+    (b.mean_anomaly(t) + b.pom).rem_euclid(TAU)
+}
+
+#[derive(Default, Clone, Copy, Debug)]
+pub struct TrainStats {
+    pub clumps: u64,
+    pub fired: u64,
+    pub declined: u64,
+    /// Pairs admitted by the λ̄ walk (the watch; O(n_c·k)).
+    pub watched: u64,
+    /// Watched pairs killed by the exact Binet cone/eps_u test (no state evaluations).
+    pub cone_filtered: u64,
+    /// Windowed-congruence queries (equal-period pairs are counted in `equal_p` instead).
+    pub queries: u64,
+    pub qsteps: u64,
+    pub equal_p: u64,
+    /// Time windows swept.
+    pub windows: u64,
+    /// Exact state evaluations in sweeps.
+    pub evals: u64,
+    pub events: u64,
+}
+
+impl TrainStats {
+    pub fn add(&mut self, o: &TrainStats) {
+        self.clumps += o.clumps;
+        self.fired += o.fired;
+        self.declined += o.declined;
+        self.watched += o.watched;
+        self.cone_filtered += o.cone_filtered;
+        self.queries += o.queries;
+        self.qsteps += o.qsteps;
+        self.equal_p += o.equal_p;
+        self.windows += o.windows;
+        self.evals += o.evals;
+        self.events += o.events;
+    }
+}
+
+/// The time spans (ticks, absolute, entry and exit) with |Δλ̄(t)| ≤ `win` that intersect
+/// [t0, t1]. P_i ≠ P_j. Exact: a windowed circle rotation solved by `first_hit`.
+fn window_spans(bi: &Body, bj: &Body, win: f64, t0: i128, t1: i128, st: &mut TrainStats) -> Vec<(i128, i128)> {
+    let (pi, pj) = (bi.period as i128, bj.period as i128);
+    debug_assert!(pi != pj && pi > 0 && pj > 0);
+    let m = (pi * pj) as u128; // ≤ 2^84 for periods ≤ 2^42
+    // D(t) = (c + a·t) mod m tracks Δλ̄·m/TAU. Keep the advance a positive and small (≤ 2^42) by
+    // flipping the sign of c when j's period is the smaller: the window |D| ≤ w is symmetric, so
+    // D and −D have the same solution set.
+    let dpom = (bi.pom - bj.pom).rem_euclid(TAU);
+    let q = (dpom / TAU * m as f64).round() as i128; // error ≤ 0.5 tick in D, covered by +2 slack
+    let c0 = ((bj.tp as i128) * pi - (bi.tp as i128) * pj + q).rem_euclid(m as i128) as u128;
+    let (c0, a) = if pj > pi {
+        (c0, (pj - pi) as u128)
+    } else {
+        ((m - c0) % m, (pi - pj) as u128)
+    };
+    // |Δλ̄| ≤ win ⟺ D ∈ [m−w, m) ∪ [0, w]. Rotate by +w: the single window [0, 2w].
+    let w = ((win / TAU) * m as f64).ceil() as u128 + 2;
+    debug_assert!(2 * w + 2 < m);
+    let dur = (2 * w + 4) / a + 8; // ticks to traverse the window at advance-rate a
+    let mut out = Vec::new();
+    let mut base = t0;
+    loop {
+        let c = (c0 + w + (a * ((base as u128) % m)) % m) % m;
+        st.queries += 1;
+        let mut qs = 0u64;
+        match first_hit(c, a, m, 0, 2 * w, &mut qs) {
+            Some(k) => {
+                st.qsteps += qs;
+                let t = base + k as i128;
+                if t > t1 {
+                    break;
+                }
+                out.push((t, t + dur as i128));
+                base = t + dur as i128 + 1; // the next span opens only after this one closes
+            }
+            None => break, // the rotation never lands in the window again
+        }
+    }
+    out
+}
+
+/// Every local minimum of the pair's distance below ρ in [lo, hi] (time units), by this module's
+/// own conservative stepping: while d > 2ρ a step is taken only if the quadratic bound
+/// min_|Δr+Δvτ| − A·h²/2 ≥ 1.5ρ holds over it, so a sub-ρ dip cannot hide inside a far step;
+/// inside 2ρ the step moves ≤ ρ/4 of relative motion (curvature capped likewise) and sign
+/// changes of Δr·Δv are refined (Newton states).
+fn sweep(bi: &Body, bj: &Body, rho: f64, lo: f64, hi: f64, st: &mut TrainStats, out: &mut Vec<(f64, f64)>) {
+    if !(hi > lo) {
+        return;
+    }
+    let amax = 1.0 / bi.rmin().powi(3) + 1.0 / bj.rmin().powi(3);
+    let hcap = (0.5 * rho / amax).sqrt(); // curvature ≤ ρ/4 per step even at zero relative speed
+    let mut t = lo;
+    let (mut r, mut v, _) = rel(bi, bj, t, false);
+    st.evals += 1;
+    let mut g = dot(r, v);
+    while t < hi {
+        let d = norm(r);
+        let mut h = if d > 2.0 * rho {
+            let mut h = (hi - t).min(2.0 * ((d - 1.5 * rho) / amax).sqrt().max(1e-12));
+            let (rv, vv) = (dot(r, v), dot(v, v));
+            loop {
+                let tau = if vv > 0.0 { (-rv / vv).clamp(0.0, h) } else { 0.0 };
+                let ml = norm([r[0] + v[0] * tau, r[1] + v[1] * tau]);
+                if ml - 0.5 * amax * h * h >= 1.5 * rho || h <= 1e-13 {
+                    break;
+                }
+                h *= 0.5;
+            }
+            h
+        } else {
+            (0.25 * rho / norm(v).max(1e-12)).min(hi - t).min(hcap)
+        };
+        if !(h > 0.0) {
+            h = hi - t;
+        }
+        let tn = (t + h).min(hi);
+        let (rn, vn, _) = rel(bi, bj, tn, false);
+        st.evals += 1;
+        let gn = dot(rn, vn);
+        if d <= 2.0 * rho && g < 0.0 && gn >= 0.0 {
+            let (tm, dm) = refine(bi, bj, t, tn, false, &mut st.evals);
+            if dm < rho && tm > lo && tm < hi {
+                out.push((tm, dm));
+            }
+        }
+        t = tn;
+        r = rn;
+        v = vn;
+        g = gn;
+    }
+}
+
+/// Clumps: connected components of Binet points under L1 distance ≤ d_c (grid hash, O(n)).
+pub fn clumps(b: &[Body], d_c: f64) -> Vec<Vec<u32>> {
+    let n = b.len();
+    let mut parent: Vec<u32> = (0..n as u32).collect();
+    fn find(p: &mut Vec<u32>, mut x: u32) -> u32 {
+        while p[x as usize] != x {
+            p[x as usize] = p[p[x as usize] as usize];
+            x = p[x as usize];
+        }
+        x
+    }
+    let union = |p: &mut Vec<u32>, i: u32, j: u32| {
+        let (ri, rj) = (find(p, i), find(p, j));
+        if ri != rj {
+            p[ri as usize] = rj;
+        }
+    };
+    let mut cell: std::collections::HashMap<(i64, i64, i64), Vec<u32>> = std::collections::HashMap::new();
+    let inv = 1.0 / d_c;
+    let key = |u: [f64; 3]| -> (i64, i64, i64) {
+        ((u[0] * inv).floor() as i64, (u[1] * inv).floor() as i64, (u[2] * inv).floor() as i64)
+    };
+    for (k, x) in b.iter().enumerate() {
+        cell.entry(key(x.binet())).or_default().push(k as u32);
+    }
+    let l1 = |a: [f64; 3], c: [f64; 3]| (a[0] - c[0]).abs() + (a[1] - c[1]).abs() + (a[2] - c[2]).abs();
+    for (ka, va) in cell.iter() {
+        for da in -1i64..=1 {
+            for db in -1i64..=1 {
+                for dc in -1i64..=1 {
+                    let kb = (ka.0 + da, ka.1 + db, ka.2 + dc);
+                    if kb <= *ka {
+                        continue; // each neighbouring cell pair once; (0,0,0) handled below
+                    }
+                    let Some(vb) = cell.get(&kb) else { continue };
+                    for &i in va {
+                        for &j in vb {
+                            if l1(b[i as usize].binet(), b[j as usize].binet()) <= d_c {
+                                union(&mut parent, i, j);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    for v in cell.values() {
+        for &i in &v[1..] {
+            union(&mut parent, v[0], i); // same cell ⇒ L1 ≤ 3·d_c, one component by design
+        }
+    }
+    let mut groups: std::collections::HashMap<u32, Vec<u32>> = std::collections::HashMap::new();
+    for k in 0..n as u32 {
+        groups.entry(find(&mut parent, k)).or_default().push(k);
+    }
+    let mut out: Vec<Vec<u32>> = groups.into_values().filter(|v| v.len() >= 2).collect();
+    for v in &mut out {
+        v.sort_unstable();
+    }
+    out.sort();
+    out
+}
+
+fn ctx_of(b: &[Body], members: &[u32]) -> Ctx {
+    let r_min = members.iter().map(|&i| b[i as usize].rmin()).fold(f64::INFINITY, f64::min);
+    let e_max = members.iter().map(|&i| b[i as usize].e).fold(0.0, f64::max);
+    let p_min = members.iter().map(|&i| b[i as usize].p).fold(f64::INFINITY, f64::min);
+    // e-vector bbox: any pairwise distance ≤ the diagonal
+    let mut x_lo = f64::INFINITY;
+    let mut x_hi = f64::NEG_INFINITY;
+    let mut y_lo = f64::INFINITY;
+    let mut y_hi = f64::NEG_INFINITY;
+    for &i in members {
+        let x = b[i as usize].e * b[i as usize].cp;
+        let y = b[i as usize].e * b[i as usize].sp;
+        x_lo = x_lo.min(x);
+        x_hi = x_hi.max(x);
+        y_lo = y_lo.min(y);
+        y_hi = y_hi.max(y);
+    }
+    Ctx { delta: 0.5 * PI * 1e-9, e_max, p_min, dv_max: 0.0 }
+    .with_delta(r_min)
+    .with_dv((x_hi - x_lo).hypot(y_hi - y_lo))
+}
+
+impl Ctx {
+    fn with_delta(mut self, r_min: f64) -> Self {
+        self.delta = 0.5 * PI * (self.p_min / r_min).max(0.0) * 0.0 + self.delta; // placeholder, replaced below
+        self
+    }
+    fn with_dv(mut self, dv: f64) -> Self {
+        self.dv_max = dv;
+        self
+    }
+}
+
+/// The dimensionless concentration number of a clump: the sound watch degree
+/// ζ = 2·n_c·L̄_max/(spread(λ̄)·(n_c−1)). ζ < 1 means the watch touches fewer pairs than the
+/// pairwise tier's n_c(n_c−1)/2; the train fires then (and only then).
+pub fn zeta(b: &[Body], members: &[u32], rho: f64) -> f64 {
+    let n_c = members.len() as f64;
+    if members.len() < 2 {
+        return f64::INFINITY;
+    }
+    let ctx = ctx_of(b, members);
+    let l_max = members
+        .iter()
+        .map(|&i| ctx.walk_bound(&b[i as usize], 0.0, -1.0, 1.0, 0.0))
+        .fold(0.0f64, f64::max)
+        .max(ctx.delta * (1.0 + l_e(ctx.e_max)) + k_v(ctx.e_max) * ctx.dv_max);
+    let mut lams: Vec<f64> = members.iter().map(|&i| lam_bar(&b[i as usize], 0.0)).collect();
+    lams.sort_by(|x, y| x.total_cmp(y));
+    let mut gap = 0.0f64;
+    for w in lams.windows(2) {
+        gap = gap.max(w[1] - w[0]);
+    }
+    let spread = (TAU - gap).max(1e-12); // the circle's occupied arc (1 minus the largest gap)
+    2.0 * n_c * l_max / (spread * (n_c - 1.0))
+}
+
+/// All encounters (minima below ρ) between members of one clump over [t0, t1] (time units),
+/// by the phase-neighbour watch. Sound regardless of ζ; the caller decides whether to use this
+/// or the pairwise tier (see `zeta`).
+pub fn train_events(b: &[Body], members: &[u32], rho: f64, t0: f64, t1: f64, st: &mut TrainStats, out: &mut Vec<(u32, u32, f64, f64)>) {
+    st.clumps += 1;
+    let n = members.len();
+    if n < 2 {
+        return;
+    }
+    let h = t1 - t0;
+    let r_min = members.iter().map(|&i| b[i as usize].rmin()).fold(f64::INFINITY, f64::min);
+    let mut ctx = ctx_of(b, members);
+    ctx.delta = 0.5 * PI * rho / r_min;
+    let (n_lo, n_hi) = members.iter().map(|&i| b[i as usize].n).fold((f64::INFINITY, f64::NEG_INFINITY), |a, x| (a.0.min(x), a.1.max(x)));
+    // (λ̄ at t0, position in `members`), sorted circularly.
+    let mut order: Vec<(f64, usize)> = members.iter().enumerate().map(|(k, &i)| (lam_bar(&b[i as usize], t0), k)).collect();
+    order.sort_by(|x, y| x.0.total_cmp(&y.0));
+    let t0t = (t0 * TICKS) as i128;
+    let t1t = (t1 * TICKS) as i128;
+    let mut tmp: Vec<(f64, f64)> = Vec::new();
+    for k in 0..n {
+        let (lam_i, ki) = order[k];
+        let i = members[ki];
+        let (bi, n_i) = (&b[i as usize], b[i as usize].n);
+        let bound = ctx.walk_bound(bi, n_i, n_lo, n_hi, h);
+        for s in 1..n {
+            let (lam_j, kj) = order[(k + s) % n];
+            let gap = if k + s < n { lam_j - lam_i } else { lam_j + TAU - lam_i };
+            if gap > bound {
+                break;
+            }
+            let j = members[kj];
+            let bj = &b[j as usize];
+            let win = ctx.window(bi, bj);
+            if gap > win + h * (bj.n - n_i).abs() {
+                continue; // never within the sound window during the horizon
+            }
+            st.watched += 1;
+            if !is_candidate(bi, bj, rho) {
+                st.cone_filtered += 1; // the orbits cannot touch: exact Binet test, no evals
+                continue;
+            }
+            tmp.clear();
+            let start = out.len();
+            if bi.period == bj.period {
+                st.equal_p += 1;
+                // The relative configuration repeats exactly with the period: one sweep covers
+                // all time; replicate the found minima across the horizon.
+                sweep(bi, bj, rho, t0, t0 + bi.period as f64 / TICKS, st, &mut tmp);
+                let p = bi.period as f64 / TICKS;
+                let mut reps = 0;
+                while t0 + reps as f64 * p < t1 {
+                    for &(tm, dm) in &tmp {
+                        let t = tm + reps as f64 * p;
+                        if t >= t0 && t <= t1 {
+                            out.push((i.min(j), i.max(j), t, dm));
+                        }
+                    }
+                    reps += 1;
+                }
+            } else {
+                for (ta, tb) in window_spans(bi, bj, win, t0t, t1t, st) {
+                    st.windows += 1;
+                    sweep(bi, bj, rho, ta as f64 / TICKS, (tb as f64 / TICKS).min(t1), st, &mut tmp);
+                }
+                for &(t, d) in &tmp {
+                    out.push((i.min(j), i.max(j), t, d));
+                }
+            }
+            st.events += (out.len() - start) as u64;
+        }
+    }
+    out.sort_by(|x, y| x.0.cmp(&y.0).then(x.1.cmp(&y.1)).then(x.2.total_cmp(&y.2)));
+}
