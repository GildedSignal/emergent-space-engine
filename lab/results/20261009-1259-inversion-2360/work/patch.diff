+    #[test]
+    fn bounds_hold() {
+        for e in [0.001f64, 0.01, 0.05, 0.1, 0.25, 0.4] {
+            let phi = phi_e(e);
+            assert!(phi <= 2.0 * e + 1.25 * e * e + 1.1 * e.powi(3) + 1e-9, "phi({e}) = {phi}");
+            assert!(phi >= 2.0 * e - 1e-9);
+            assert!(l_e(e) >= 2.0 * e - 1e-9 && l_e(e) <= 4.0 * e + 1e-9);
+            // K_v: sup_λ|g1 − g2| ≤ K_v·(e-vector distance), by phasor finite differences.
+            let g = |e: f64, pom: f64, lam: f64| {
+                let m = {
+                    let (s, c) = (0.5 * (lam - pom)).sin_cos();
+                    let ea = 2.0 * ((1.0 - e).sqrt() * s).atan2((1.0 + e).sqrt() * c);
+                    ea - e * ea.sin()
+                };
+                (lam - pom) - m
+            };
+            let mut rng = crate::belt::Rng(4242);
+            for _ in 0..200 {
+                let (e1, p1) = (e * rng.f64(), TAU * rng.f64());
+                let (e2, p2) = (e * rng.f64(), TAU * rng.f64());
+                let de = (e1 * p1.cos() - e2 * p2.cos()).hypot(e1 * p1.sin() - e2 * p2.sin()).max(1e-12);
+                let mut sup = 0.0f64;
+                for q in 0..512 {
+                    let lam = TAU * q as f64 / 512.0;
+                    sup = sup.max((g(e1, p1, lam) - g(e2, p2, lam)).abs());
+                }
+                assert!(sup <= k_v(e) * de + 1e-12, "sup|Δg|={sup} > K_v·d={}", k_v(e) * de);
+            }
+        }
+    }
