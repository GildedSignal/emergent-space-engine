+def fold_runs(*groups):
+    """`## Runs` union folded to one line per run id; earlier groups win a collision."""
+    out, seen = [], set()
+    for lines in groups:
+        for line in lines:
+            m = re.match(r"^- (\S+)", line)
+            if m and m.group(1) in seen:
+                continue
+            if m:
+                seen.add(m.group(1))
+            out.append(line)
+    return out
