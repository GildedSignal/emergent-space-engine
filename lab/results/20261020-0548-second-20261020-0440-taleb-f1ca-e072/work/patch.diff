 struct Job<S> {
@@ -536,6 +574,124 @@ impl<S: Stepper + Send + 'static> State<S> {
             *self.verified_at.entry(t).or_default() += 1;
         }
     }
+    /// v5 arm: the per-region floor is active (stride gate on, v3/v4 not selected).
+    fn v5_on(&self) -> bool {
+        self.cfg.stride_gate && std::env::var("ESE_V3").is_err() && std::env::var("ESE_V5").is_ok()
+    }
+
+    /// v5: resolve a clan label to its current root (labels union at every merge/rollback).
+    fn clan_find(&self, mut c: u64) -> u64 {
+        while let Some(&p) = self.clan_uf.get(&c) {
+            c = p;
+        }
+        c
+    }
+    fn fresh_clan(&mut self) -> u64 {
+        let c = self.next_clan;
+        self.next_clan += 1;
+        c
+    }
+    /// v5: unite `labels` under a fresh label and return it. Live regions keep their stale
+    /// labels; every lookup resolves through `clan_uf`, so no relabeling is needed.
+    fn clan_union(&mut self, labels: &[u64]) -> u64 {
+        let c = self.fresh_clan();
+        for l in labels {
+            self.clan_uf.insert(self.clan_find(*l), c);
+        }
+        c
+    }
+    /// v5: the clan of a truth's owner lineage — its carrier region if live, else the label
+    /// recorded at its death (both resolved to current roots).
+    fn truth_clan(&self, id: u64) -> Option<u64> {
