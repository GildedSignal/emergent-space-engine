+/// `cos` for four arguments at once: the same thirteen nested factors per argument,
+/// identical floored products (bit-identical to [`cos`]), with the four chains
+/// step-locked so their independent multiplies interleave. A panel's four Gauss
+/// nodes exist at once, so the walk trades serial chain latency for throughput.
+pub fn cos4(psi: [i128; 4]) -> [i128; 4] {
+    const UONE: u64 = 1 << 62;
+    let mut out = [0i128; 4];
+    let mut x = [0i64; 4];
+    let mut x2 = [0u64; 4];
+    let mut live = [false; 4];
+    for j in 0..4 {
+        if psi[j] == 0 {
+            out[j] = ONE;
+        } else if psi[j] == PI {
+            out[j] = -ONE;
+        } else {
+            live[j] = true;
+            x[j] = (2 * psi[j] - PI) as i64;
+            x2[j] = (((x[j] as i128) * (x[j] as i128)) >> 62) as u64;
+        }
+    }
+    let mut s = [UONE; 4];
+    for k in (0..13).rev() {
+        let r = SINE[k] as u64;
+        for j in 0..4 {
+            if live[j] {
+                let y = ((x2[j] as u128 * s[j] as u128) >> 62) as u64;
+                s[j] = UONE - ((y as u128 * r as u128) >> 62) as u64;
+            }
+        }
+    }
+    for j in 0..4 {
+        if live[j] {
+            out[j] = -((x[j] as i128 * s[j] as i128) >> 62);
+        }
+    }
+    out
+}
+
 /// atan(s) in Q62 for s in [0, 1] in Q62. j = round(16 s) (ties up), a = j/16,
 /// t = trunc((s - a) 2^62 / (1 + s a)) with |t| <= 1/32, and
 /// atan(s) = atan(j/16) + t(1 - t^2/3 + t^4/5 - ... + t^12/13), nested, products floored.
@@ -179,4 +218,27 @@ mod tests {
         assert_eq!(atan(ONE), PI / 2);
         assert_eq!(atan(0), 0);
     }
+    #[test]
+    fn cos4_is_bit_identical_to_cos() {
+        // corners first
+        for psi in [0, 1, PI / 2 - 1, PI / 2, PI / 2 + 1, PI - 1, PI] {
+            assert_eq!(cos4([psi; 4]), [cos(psi); 4], "psi {psi}");
+        }
+        let mut x: u128 = 0x2545F4914F6CDD1D;
+        for _ in 0..60_000 {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            let psi = (x % (PI as u128 + 1)) as i128;
+            assert_eq!(cos4([psi; 4]), [cos(psi); 4], "psi {psi}");
+        }
+        // mixed lanes, dense grid
+        for i in 0..4096 {
+            let a = PI * i / 4096;
+            let b = PI * (4096 - i) / 4096;
+            let c = PI / 2 + i;
+            let d = (PI / 2).saturating_sub(i);
+            assert_eq!(cos4([a, b, c, d]), [cos(a), cos(b), cos(c), cos(d)], "i {i}");
+        }
+    }
 }
