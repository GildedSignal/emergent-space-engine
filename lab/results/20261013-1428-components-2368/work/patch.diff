+// The compile node's cos: shipped serial chain vs bit-identical unrolled and 4-way
+// interleaved evaluations, plus the whole-compile A/B on a key grid.
+// Bit identity is the law: every variant must reproduce shipped `cos` bit for bit.
+use emergent_space::num::cos;
+use emergent_space::orbit::{Orbit, OrbitKey};
+use emergent_space::scaled::Scalar;
+use emergent_space::tables::{PI, SINE};
+
+const ONE: u64 = 1 << 62;
+
+#[inline(always)]
+fn mul_hi(a: u64, b: u64) -> u64 {
+    (((a as u128) * (b as u128)) >> 62) as u64
+}
+
+#[inline(always)]
+fn sq_q62(x: i64) -> u64 {
+    (((x as i128) * (x as i128)) >> 62) as u64
+}
+
+/// Straight-line, unrolled: identical operations to shipped `cos`, no loop.
+pub fn cos1(psi: i128) -> i128 {
+    if psi == 0 {
+        return ONE as i128;
+    }
+    if psi == PI {
+        return -(ONE as i128);
+    }
+    let x = (2 * psi - PI) as i64;
+    let x2 = sq_q62(x);
+    let mut s = ONE;
+    let r = SINE;
+    macro_rules! step {
+        ($rr:expr) => {
+            s = ONE - mul_hi(mul_hi(x2, s), $rr as u64);
+        };
+    }
+    step!(r[12]);
+    step!(r[11]);
+    step!(r[10]);
+    step!(r[9]);
+    step!(r[8]);
+    step!(r[7]);
+    step!(r[6]);
+    step!(r[5]);
+    step!(r[4]);
+    step!(r[3]);
+    step!(r[2]);
+    step!(r[1]);
+    step!(r[0]);
+    -((x as i128 * s as i128) >> 62)
+}
+
+/// Four independent chains step-locked: same floored products per chain, ILP across chains.
+pub fn cos4(psi: [i128; 4]) -> [i128; 4] {
+    let mut out = [0i128; 4];
+    let mut x = [0i64; 4];
+    let mut x2 = [0u64; 4];
+    let mut live = [false; 4];
+    for j in 0..4 {
+        if psi[j] == 0 {
+            out[j] = ONE as i128;
+        } else if psi[j] == PI {
+            out[j] = -(ONE as i128);
+        } else {
+            live[j] = true;
+            x[j] = (2 * psi[j] - PI) as i64;
+            x2[j] = sq_q62(x[j]);
+        }
+    }
+    let mut s = [ONE; 4];
+    let r = SINE;
+    for k in (0..13).rev() {
+        let rr = r[k] as u64;
+        for j in 0..4 {
+            if live[j] {
+                s[j] = ONE - mul_hi(mul_hi(x2[j], s[j]), rr);
+            }
+        }
+    }
+    for j in 0..4 {
+        if live[j] {
+            out[j] = -((x[j] as i128 * s[j] as i128) >> 62);
+        }
+    }
+    out
+}
+
+fn operands() -> Vec<i128> {
+    // uniform over [0, pi] plus the corners and the psi=pi/2 region
+    let mut v = Vec::new();
+    let n = 1 << 16;
+    for i in 0..=n {
+        v.push(PI * i / n);
+    }
+    v.push(PI / 2);
+    v.push(PI / 2 - 1);
+    v.push(PI / 2 + 1);
+    v.push(1);
+    v.push(PI - 1);
+    v
+}
+
+fn main() {
+    // 1. bit identity, dense grid + pseudo-random (deterministic xorshift)
+    let ops = operands();
+    let mut bad = 0u64;
+    let mut shown = 0;
+    for &psi in &ops {
+        let want = cos(psi);
+        let got1 = cos1(psi);
+        let got4 = cos4([psi; 4]);
+        if got1 != want || got4 != [want; 4] {
+            bad += 1;
+            if shown < 6 {
+                shown += 1;
+                println!("dense mismatch psi={psi} want={want} cos1={got1} cos4={got4:?}");
+            }
+        }
+    }
+    let mut state = 0x2545F4914F6CDD1Du64;
+    let rnd = |state: &mut u64| {
+        *state ^= *state << 13;
+        *state ^= *state >> 7;
+        *state ^= *state << 17;
+        *state
+    };
+    for _ in 0..2_000_000u64 {
+        let psi = (rnd(&mut state) % (PI as u64 + 1)) as i128;
+        let want = cos(psi);
+        if cos1(psi) != want || cos4([psi; 4]) != [want; 4] {
+            bad += 1;
+            if bad < 5 {
+                println!("random mismatch psi={psi} want={want}");
+            }
+        }
+    }
+    println!("bit-identity: {} mismatches over {} dense + 2M random", bad, ops.len());
+
+    // 2. primitive timing (the chain's cost is data-independent; operand mix is irrelevant)
+    let batch = 4096;
+    let psis: Vec<i128> = (0..batch).map(|i| PI * i / batch).collect();
+    let mut sink = 0i128;
+    for rep in 0..3 {
+        let t = std::time::Instant::now();
+        for _ in 0..200 {
+            for &psi in &psis {
+                sink = sink.wrapping_add(cos(psi));
+            }
+        }
+        let shipped = t.elapsed().as_secs_f64() / (200 * batch) as f64 * 1e9;
+        let t = std::time::Instant::now();
+        for _ in 0..200 {
+            for &psi in &psis {
+                sink = sink.wrapping_add(cos1(psi));
+            }
+        }
+        let unrolled = t.elapsed().as_secs_f64() / (200 * batch) as f64 * 1e9;
+        let q: Vec<[i128; 4]> = psis.chunks(4).map(|c| [c[0], c[1], c[2], c[3]]).collect();
+        let t = std::time::Instant::now();
+        for _ in 0..200 {
+            for p in &q {
+                let r = cos4(*p);
+                sink = sink.wrapping_add(r[0] + r[3]);
+            }
+        }
+        let batch4 = t.elapsed().as_secs_f64() / (200 * batch) as f64 * 1e9;
+        println!(
+            "rep {}: shipped {:.1} ns  unrolled {:.1} ns  interleaved4 {:.2} ns/cos  (ratio {:.2}x / {:.2}x)",
+            rep + 1,
+            shipped,
+            unrolled,
+            batch4,
+            shipped / unrolled,
+            shipped / batch4
+        );
+    }
+    std::hint::black_box(&sink);
+
+    // 3. whole-compile A/B on a key grid: periapsis powers x eccentricities
+    let mut keys = Vec::new();
+    for p in 2..=18i16 {
+        for e in [0.0f64, 0.2, 0.5, 0.8, 0.9] {
+            let k = ((1u128 << 96) / (((1u64 << 48) as f64 * (1.0 + e)) as u128)) as u64;
+            if let Ok(key) = OrbitKey::new(Scalar::power_of_two(p), k) {
+                keys.push(key);
+            }
+        }
+    }
+    let valid: Vec<Orbit> = keys.iter().filter_map(|k| Orbit::compile(*k).ok()).collect();
+    println!("grid: {} keys, {} compiled", keys.len(), valid.len());
+    let mut digest = 0u64;
+    for o in &valid {
+        for k in o.shape().knots() {
+            digest = digest
+                .wrapping_mul(31)
+                .wrapping_add(format!("{k:?}").bytes().map(|b| b as u64).sum::<u64>());
+        }
+    }
+    println!("shape digest {:016x}", digest);
+    let n = 20;
+    let mut best = f64::INFINITY;
+    for rep in 0..5 {
+        let t = std::time::Instant::now();
+        for _ in 0..n {
+            for &k in &keys {
+                std::hint::black_box(Orbit::compile(k).ok());
+            }
+        }
+        let per = t.elapsed().as_secs_f64() * 1e6 / (n * keys.len()) as f64;
+        best = best.min(per);
+        println!("compile rep {}: {:.2} us/key", rep + 1, per);
+    }
+    #[cfg(feature = "profile")]
+    {
+        let st = emergent_space::profile::take();
+        let tot = (n * keys.len()) as f64;
+        println!(
+            "stages us/key: roots {:.2} cuts {:.2} walk {:.2} convert {:.2}",
+            st[0] as f64 / tot / 1e3,
+            st[1] as f64 / tot / 1e3,
+            st[2] as f64 / tot / 1e3,
+            st[3] as f64 / tot / 1e3
+        );
+    }
+    println!("compile best {:.2} us/key over {} keys", best, keys.len());
+}
