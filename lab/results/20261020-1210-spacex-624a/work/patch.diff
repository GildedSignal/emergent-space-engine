+#[test]
+fn mint_census_full_walk_control() {
+    // The instrument must be able to pass: one full-period walk touches
+    // (nearly) every compiled panel of the mint it walked.
+    let key = OrbitKey::bound(Scalar::integer(16).scale(18).unwrap(), (1 << 48) / 10).unwrap();
+    let orbit = Orbit::compile(key).unwrap();
+    let period = orbit.period().unwrap();
+    for j in 0..512i128 {
+        let t = period.mul(Scalar::raw(j, -9).unwrap()).unwrap();
+        orbit.signed_state(t).unwrap();
+    }
+    let recs = mint_census::take();
+    let r = recs.last().unwrap();
+    assert_eq!(r.class, "cycle");
+    assert!(r.knots > 4, "expected a real table, got {} knots", r.knots);
+    let coverage = r.touched.len() as f64 / (r.knots - 1) as f64;
+    assert!(coverage > 0.85, "full walk covered only {coverage}");
+}
