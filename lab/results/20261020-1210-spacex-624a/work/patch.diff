@@ -8,6 +8,57 @@ use emergent_universe::{body::What, step, Budget, Kind};
 use serde_json::json;
 use std::collections::HashSet;
 use std::time::Instant;
+use emergent_space::orbit::mint_census::{self, MintRec};
+
+/// Per-mint span coverage: which fraction of the compiled knot panels the
+/// readouts ever landed in between the mint and its discard.
+fn census_json() -> serde_json::Value {
+    let recs = mint_census::take();
+    let mut rows = Vec::new();
+    let mut classes = serde_json::Map::new();
+    for class in ["cycle", "passage"] {
+        let rs: Vec<&MintRec> = recs.iter().filter(|r| r.class == class).collect();
+        if rs.is_empty() {
+            continue;
+        }
+        let mut cov: Vec<f64> = rs
+            .iter()
+            .filter(|r| r.knots > 1)
+            .map(|r| r.touched.len() as f64 / (r.knots - 1) as f64)
+            .collect();
+        cov.sort_by(f64::total_cmp);
+        let at = |p: f64| cov.get(((cov.len().saturating_sub(1)) as f64 * p).ceil() as usize).copied().unwrap_or(1.0);
+        let mut knots: Vec<usize> = rs.iter().map(|r| r.knots).collect();
+        knots.sort_unstable();
+        let mut touches: Vec<u64> = rs.iter().map(|r| r.touches).collect();
+        touches.sort_unstable();
+        let walked = rs.iter().filter(|r| r.touches > 0).count();
+        classes.insert(
+            class.into(),
+            json!({
+                "mints": rs.len(),
+                "walked": walked,
+                "knots_median": knots[knots.len() / 2],
+                "knots_max": *knots.last().unwrap(),
+                "coverage_median": at(0.5), "coverage_p10": at(0.1), "coverage_p90": at(0.9),
+                "frac_ge_0p9": cov.iter().filter(|c| **c >= 0.9).count() as f64 / cov.len() as f64,
+                "frac_le_0p5": cov.iter().filter(|c| **c <= 0.5).count() as f64 / cov.len() as f64,
+                "touches_median": touches[touches.len() / 2],
+                "with_tail": rs.iter().filter(|r| r.tail > 0).count(),
+                "tail_touches_total": rs.iter().map(|r| r.tail_touches).sum::<u64>(),
+            }),
+        );
+    }
+    for (id, r) in recs.iter().enumerate() {
+        rows.push(json!({
+            "id": id, "class": r.class, "knots": r.knots, "crossings": r.crossings,
+            "touched": r.touched.len(),
+            "coverage": if r.knots > 1 { r.touched.len() as f64 / (r.knots - 1) as f64 } else { 1.0 },
+            "touches": r.touches, "tail": r.tail, "tail_touches": r.tail_touches,
+        }));
+    }
+    json!({"classes": classes, "rows": rows})
+}
 
