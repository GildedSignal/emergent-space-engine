+/// Print-only census of minted knot vectors: which panels the readouts land in
+/// between a mint and its discard. Never read by the law; changes no arithmetic.
+pub mod mint_census {
+    use std::collections::HashSet;
+    use std::sync::{LazyLock, Mutex, PoisonError};
+
+    pub struct MintRec {
+        pub class: &'static str,
+        pub knots: usize,
+        pub crossings: usize,
+        pub span_psi: i128,
+        pub tail: usize,
+        pub touched: HashSet<usize>,
+        pub touches: u64,
+        pub tail_touches: u64,
+        pub min_psi: i128,
+        pub max_psi: i128,
+    }
+
+    fn table() -> &'static Mutex<Vec<MintRec>> {
+        static T: LazyLock<Mutex<Vec<MintRec>>> =
+            LazyLock::new(|| Mutex::new(Vec::new()));
+        &T
+    }
+
+    pub fn mint(
+        class: &'static str,
+        knots: usize,
+        span_psi: i128,
+        crossings: usize,
+    ) -> u64 {
+        let mut t = table().lock().unwrap_or_else(PoisonError::into_inner);
+        t.push(MintRec {
+            class,
+            knots,
+            crossings,
+            span_psi,
+            tail: 0,
+            touched: HashSet::new(),
+            touches: 0,
+            tail_touches: 0,
+            min_psi: i128::MAX,
+            max_psi: i128::MIN,
+        });
+        (t.len() - 1) as u64
+    }
+
+    pub fn set_tail(id: u64, tail: usize) {
+        if id == u64::MAX {
+            return;
+        }
+        if let Ok(mut t) = table().lock() {
+            if let Some(r) = t.get_mut(id as usize) {
+                r.tail = tail;
+            }
+        }
+    }
+
+    pub fn touch(id: u64, panel: usize, psi: i128) {
+        if id == u64::MAX {
+            return;
+        }
+        if let Ok(mut t) = table().lock() {
+            if let Some(r) = t.get_mut(id as usize) {
+                r.touched.insert(panel);
+                r.touches += 1;
+                r.min_psi = r.min_psi.min(psi);
+                r.max_psi = r.max_psi.max(psi);
+            }
+        }
+    }
+
+    pub fn touch_tail(id: u64) {
+        if id == u64::MAX {
+            return;
+        }
+        if let Ok(mut t) = table().lock() {
+            if let Some(r) = t.get_mut(id as usize) {
+                r.tail_touches += 1;
+            }
+        }
+    }
+
+    pub fn take() -> Vec<MintRec> {
+        std::mem::take(&mut *table().lock().unwrap_or_else(PoisonError::into_inner))
+    }
 }
