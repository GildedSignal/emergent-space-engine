+//! Run 20261021-0312-system-15d7: does the BOUNDARY comb ever fire on the belt's own stream?
+//! Flies the ladder scene (plane_extra: locals + belt + player) as the page flies it
+//! (1/60 s frames at rtf 100) to a cut, settles there, and prints the boundary bill.
+//!
+//! cargo run --release -p emergent-universe --example boundary_bill [-- <N> <game seconds>]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::step::bill;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+
+const RTF: f64 = 100.0;
+
+fn main() {
+    let n: usize = std::env::args().nth(1).and_then(|s| s.parse().ok()).unwrap_or(30_000);
+    let gs: f64 = std::env::args().nth(2).and_then(|s| s.parse().ok()).unwrap_or(60_000.0);
+    let cut = (gs * RTF / TICK_SECONDS) as i64;
+    let t0 = std::time::Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    for _ in 0..2_000_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        p.u.frame_to(1.0 / 60.0, RTF, Budget::unlimited(), cut);
+    }
+    p.u.settle(cut);
+    let c = bill::counters();
+    println!(
+        "N {n} horizon {gs:.0} gs reached {:.0} gs | digest {} | kicks {} encounters {} contacts {}",
+        p.u.now as f64 * TICK_SECONDS,
+        &p.u.digest()[..32],
+        p.u.stats.kicks,
+        p.u.stats.encounters,
+        p.u.contacts
+    );
+    println!(
+        "boundary combs {} (clock-stepped {}) | fires: crash {} leave {} handoff {} | kick-surface fires {}",
+        c[0], c[1], c[2], c[3], c[4], c[5]
+    );
+    println!("wall {:.1} s", t0.elapsed().as_secs_f64());
+}
