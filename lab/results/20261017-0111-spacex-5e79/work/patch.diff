+            c.fetch_add(1, Ordering::Relaxed);
+        }
+    });
+}
+
+/// The resolver polled doll `d`'s sources at `t`; `v` is the poll's validity key (the latest
+/// `event_time` among the sources read, so a rebind in between makes a different key).
+pub fn poll(d: u16, t: i64, v: i64) {
+    POLLS.fetch_add(1, Ordering::Relaxed);
+    if !KEYS_ON.load(Ordering::Relaxed) {
+        return;
+    }
+    let mut k = KEYS.lock().unwrap_or_else(|e| e.into_inner());
+    if k.len() >= CAP {
+        FULL.store(true, Ordering::Relaxed);
+        return;
+    }
+    k.insert((d, t, v));
+}
+
+const CAP: usize = 3_000_000;
+static FULL: AtomicBool = AtomicBool::new(false);
+static KEYS_ON: AtomicBool = AtomicBool::new(true);
+static POLLS: AtomicU64 = AtomicU64::new(0);
+static KEYS: LazyLock<Mutex<HashSet<(u16, i64, i64)>>> = LazyLock::new(|| Mutex::new(HashSet::new()));
+thread_local! {
+    static PER_BODY: Cell<Option<std::rc::Rc<Vec<AtomicU64>>>> = const { Cell::new(None) };
+}
+
+/// Point the per-body counters at `n` fresh slots (repeated calls re-zero in place).
+pub fn size(n: usize) {
+    PER_BODY.with(|b| {
+        let fresh = match b.take() {
+            Some(v) if v.len() >= n => {
+                for c in &v[..n] {
+                    c.store(0, Ordering::Relaxed);
+                }
+                v
+            }
+            _ => std::rc::Rc::new((0..n).map(|_| AtomicU64::new(0)).collect()),
+        };
+        b.set(Some(fresh));
+    });
+}
+
+/// Zero the tag counters, the per-body counters and the key set (between arms of one process).
+pub fn reset() {
+    for r in &READS {
+        r.store(0, Ordering::Relaxed);
+    }
+    KEYS.lock().unwrap_or_else(|e| e.into_inner()).clear();
+    FULL.store(false, Ordering::Relaxed);
+    POLLS.store(0, Ordering::Relaxed);
+}
+
+/// Totals by tag plus the poll-key duplication.
+pub fn report() -> String {
+    let total: u64 = READS.iter().map(|r| r.load(Ordering::Relaxed)).sum();
+    let keys = KEYS.lock().unwrap_or_else(|e| e.into_inner()).len() as u64;
+    let mut s = format!(
+        "reads_total={total} polls={} poll_keys={keys} keys_full={}",
+        POLLS.load(Ordering::Relaxed),
+        FULL.load(Ordering::Relaxed)
+    );
+    for (i, l) in LABELS.iter().enumerate() {
+        s.push_str(&format!(" {l}={}", READS[i].load(Ordering::Relaxed)));
+    }
+    s
+}
+
+/// Per-body reads: (index, count) sorted descending, top `m`.
+pub fn top(m: usize) -> Vec<(usize, u64)> {
+    let mut v: Vec<(usize, u64)> = PER_BODY
+        .with(|b| b.borrow().clone())
+        .iter()
+        .enumerate()
+        .map(|(i, c)| (i, c.load(Ordering::Relaxed)))
+        .filter(|&(_, c)| c > 0)
+        .collect();
+    v.sort_unstable_by(|a, b| b.1.cmp(&a.1));
+    v.truncate(m);
+    v
+}
+
+/// How many distinct bodies were read at least once.
+pub fn distinct() -> usize {
+    PER_BODY.with(|b| b.borrow().iter().filter(|c| c.load(Ordering::Relaxed) > 0).count())
+}
+
+pub fn total() -> u64 {
+    READS.iter().map(|r| r.load(Ordering::Relaxed)).sum()
+}
