+//! Print-only read counters (a lab probe, 20261017-0111-spacex-5e79): what every store read
+//! (`binding_at`) is FOR, which bodies it falls on, and how much of the resolver's per-event
+//! source poll is a repeated `(doll, tick)` key. Counting only: no behaviour change.
+use std::cell::Cell;
+use std::collections::HashSet;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{LazyLock, Mutex};
+
+pub const KICK: u16 = 0; // Work::kick's source poll (secondaries + tide)
+pub const OPEN: u16 = 1; // Work::open (engage poll, maybe_capture's centre reads)
+pub const CLOCK: u16 = 2; // clock law: plan_clock/project/kick_clock + ext::constants
+pub const BOUNDARY: u16 = 3; // boundary/boundary_clock (certificates, maybe_capture)
+pub const HANDOFF: u16 = 4; // capture/release: the doll centre's exact readout
+pub const SCAN: u16 = 5; // encounters: the scan's me + candidates
+pub const VIEW: u16 = 6; // observe (ramped/partial/state_rate) + the view's crossings
+pub const FLEET: u16 = 7; // fleet origin state + its kicks' source polls
+pub const OTHER: u16 = 8;
+pub const N: usize = 9;
+pub const LABELS: [&str; N] = ["kick", "open", "clock", "boundary", "handoff", "scan", "view", "fleet", "other"];
+
+static READS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+thread_local! {
+    static TAG: Cell<u16> = const { Cell::new(OTHER) };
+}
+
+/// Run `f` with every store read it makes counted under tag `t`.
+pub fn tagged<R>(t: u16, f: impl FnOnce() -> R) -> R {
+    struct Reset(u16);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            TAG.with(|c| c.set(self.0));
+        }
+/// Run `f` with every store read it makes counted under tag `t`.
+pub struct TagGuard(u16);
+impl TagGuard {
+    /// Every store read until this guard drops is counted under tag `t`.
+    pub fn new(t: u16) -> Self {
+        TagGuard(TAG.with(|c| c.replace(t)))
+    }
+}
+impl Drop for TagGuard {
+    fn drop(&mut self) {
+        TAG.with(|c| c.set(self.0));
+    }
+}
