+//! The birth rail: what one belt body costs to make on the shipped plane, and where the ladder's
+//! 28-31 us/body build goes that `add_body`'s 9.2 us promotion path (c4d3) does not cover.
+//!
+//! Runs `plane_extra` (the ladder's own population, seed 1, one thread, as the ladder flies) at
+//! each N, best of REPS after one warm rep. With `ES_BIRTH_SPLIT=1` the crate prints the split
+//! (`[birth] ladder ...` = draw+add_body per body; `[birth] start ...` = the first-plan pass,
+//! requeue, allocations, fleet, rekey) to stderr; without it this is the shipped path, prints and
+//! all. Per-body terms are slopes against the N=0 arm (the plane's own ~30 bodies are the fixed
+//! part). Cloud timings are Linux/x86: orders and ratios only.
+//!
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::Config;
+
+fn main() {
+    let ns: Vec<usize> = std::env::args().skip(1).map(|s| s.parse().unwrap()).collect();
+    let ns = if ns.is_empty() { vec![0, 10_000, 100_000, 300_000] } else { ns };
+    let reps: usize = std::env::var("REPS").ok().and_then(|s| s.parse().ok()).filter(|&r| r > 0).unwrap_or(3);
+    let seed: u64 = std::env::var("SEED").ok().and_then(|s| s.parse().ok()).unwrap_or(1);
+    let load = std::fs::read_to_string("/proc/loadavg").unwrap_or_default();
+    let load = load.split_whitespace().next().unwrap_or("?");
+    println!("birth_rail: seed {seed}, {reps} reps (best of, after 1 warm), 1 thread, load {load}");
+    let mut prev: Option<(usize, f64)> = None;
+    for &n in &ns {
+        let mut best = f64::INFINITY;
+        for r in 0..=reps {
+            let t = std::time::Instant::now();
+            let p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+            let dt = t.elapsed().as_secs_f64();
+            drop(p);
+            if r > 0 {
+                best = best.min(dt);
+            }
+        }
+        let incl = best * 1e6 / (n.max(1)) as f64;
+        let line = format!("N={n:>8} build {best:8.3} s  {incl:7.1} us/body(incl fixed)");
+        match prev {
+            Some((n0, t0)) if n > n0 => {
+                let slope = (best - t0) * 1e6 / (n - n0) as f64;
+                println!("{line}  slope vs N={n0}: {slope:7.1} us/body");
+            }
+            _ => println!("{line}"),
+        }
+        prev = Some((n, best));
+    }
+}
