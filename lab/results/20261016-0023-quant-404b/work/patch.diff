@@ -23,3 +23,13 @@ pub use body::Kind;
 pub use ctx::Config;
 pub use universe::{Budget, OrbitSpec, Universe};
 pub use world::{Mass, Unit};
+/// `ES_BIRTH_SPLIT=1`: print-only timers for the birth rail (the ladder build's per-body cost split
+/// into the draw+`add_body` loop and `Universe::start`'s passes). No engine state is read or changed;
+/// unset, `0` and `""` mean off and the code below `start`/`plane_with_extra` is the shipped path.
+pub(crate) static BIRTH_SPLIT: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| {
+    std::env::var("ES_BIRTH_SPLIT").map(|v| !v.is_empty() && v != "0").unwrap_or(false)
+});
+
+pub(crate) fn birth_split() -> bool {
+    *BIRTH_SPLIT
+}
