+/// The record a demoted binding keeps: what re-mints its compiled orbit. The compile is pure, so the
+/// entry is a cache (recompiling every standing binding from the key it carries was bit-identical for
+/// 120,083/120,083 cycles, 20261015-0250-scout-760f).
+#[derive(Clone, Debug)]
+pub struct DemotedEntry {
+    pub key: OrbitKey,
+    pub clockwise: bool,
+    pub unit: Unit,
+}
+
+impl DemotedEntry {
+    /// Re-mint the compiled entry: bit-identical to the one the fit compiled from this key.
+    pub fn mint(&self) -> Res<Arc<Entry>> {
+        Ok(Arc::new(Entry { trajectory: Trajectory::Cycle(Orbit::compile(self.key)?), clockwise: self.clockwise, unit: self.unit }))
+    }
+}
+
+/// A binding's compiled trajectory, or — once the lazy store has demoted it — the key that re-mints it.
+/// Passages (their outer radius) and plunges (their coefficients) are not re-mintable: they never demote.
+#[derive(Clone, Debug)]
+pub enum EntrySlot {
+    Live(Arc<Entry>),
+    Demoted(Box<DemotedEntry>),
+}
+
+impl EntrySlot {
+    /// The live entry. Every binding handed out of the store is live; a demoted slot is the store's own.
+    pub fn entry(&self) -> Res<&Entry> {
+        match self {
+            EntrySlot::Live(e) => Ok(e),
+            EntrySlot::Demoted(_) => Err(Error::Refused("a demoted entry needs a mint")),
+        }
+    }
+    /// The demoted record for a compiled orbit, if this entry can be re-minted.
+    pub fn demoted(&self) -> Option<EntrySlot> {
+        match self {
+            EntrySlot::Live(e) => match &e.trajectory {
+                Trajectory::Cycle(o) => Some(EntrySlot::Demoted(Box::new(DemotedEntry { key: o.key(), clockwise: e.clockwise, unit: e.unit }))),
+                _ => None,
+            },
+            EntrySlot::Demoted(_) => None,
+        }
+    }
+    /// Whether two live entries are the same allocation (the scan memo's key; minted entries never are).
+    pub fn same(&self, other: &EntrySlot) -> bool {
+        matches!((self, other), (EntrySlot::Live(a), EntrySlot::Live(b)) if Arc::ptr_eq(a, b))
+    }
+    pub fn clockwise(&self) -> bool {
+        match self { EntrySlot::Live(e) => e.clockwise, EntrySlot::Demoted(d) => d.clockwise }
+    }
+}
