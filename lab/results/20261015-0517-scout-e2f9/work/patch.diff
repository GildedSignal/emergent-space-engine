@@ -0,0 +1,69 @@
+//! The lazy store's certificate: the ladder flown past the first kick wave with the demote-after-kick
+//! seam off, on, and on with retention (`ES_LAZY`, `ES_LAZY_RETAIN`), one process an arm — the digest
+//! at the canonical cut (`frame_to` to the cut, `settle(cut)`, `digest()`) must be bit-identical in
+//! every arm, and the arm prints its promotions, demotions and resident memory. Memory on Linux:
+//! `/proc/self/status` (the shipped `nladder` reads macOS's `proc_pid_rusage`).
+//!
+//! cargo run --release -p emergent-universe --example lazy [-- <N> <coast|burn> <game-s cut> [seed]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+fn rss() -> (u64, u64) {
+    let mut now = 0;
+    let mut hwm = 0;
+    for line in std::fs::read_to_string("/proc/self/status").unwrap().lines() {
+        if let Some(v) = line.strip_prefix("VmRSS:") {
+            now = v.trim_end_matches(" kB").trim().parse().unwrap();
+        }
+        if let Some(v) = line.strip_prefix("VmHWM:") {
+            hwm = v.trim_end_matches(" kB").trim().parse().unwrap();
+        }
+    }
+    (now, hwm)
+}
+
+fn main() {
+    let n: usize = std::env::args().nth(1).unwrap_or_else(|| "100000".into()).parse().unwrap();
+    let burn = std::env::args().nth(2).unwrap_or_else(|| "coast".into()) == "burn";
+    let seconds: f64 = std::env::args().nth(3).unwrap_or_else(|| "48000".into()).parse().unwrap();
+    let seed: u64 = std::env::args().nth(4).unwrap_or_else(|| "1".into()).parse().unwrap();
+    let rtf = 1000.0;
+    let cut = (seconds * rtf / TICK_SECONDS) as i64;
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+    let t_build = t0.elapsed();
+    if burn {
+        p.u.schedule((1.0 * rtf / TICK_SECONDS) as i64, word(1, 8)).unwrap();
+    }
+    let t1 = Instant::now();
+    let mut frames = 0u64;
+    let mut late = 0u64;
+    for _ in 0..4_000_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        let f = p.u.frame_to(1.0 / 60.0, rtf, Budget::unlimited(), cut);
+        frames += 1;
+        late += (f.presented < f.target) as u64;
+    }
+    p.u.settle(cut);
+    let t_fly = t1.elapsed();
+    let (prom, dem) = p.u.lazy_counters();
+    let (now, hwm) = rss();
+    let digest = p.u.digest();
+    println!(
+        "lazy: n={n} {} seed={seed} cut={seconds:.0}gs | {digest} | frames {frames} late {late} | build {:.1}s fly {:.1}s | rss {now}/{hwm} MB | promotions {prom} demotions {dem}",
+        burn_str(burn),
+        t_build.as_secs_f64(),
+        t_fly.as_secs_f64(),
+    );
+    eprintln!("{}", &digest[..32.min(digest.len())]);
+}
+
+fn burn_str(b: bool) -> &'static str {
+    if b { "burn" } else { "coast" }
+}
