+/// Lab run 20261010-0920-quant-30e1: counters only, never a value. Not part of the law.
+pub mod budget {
+    use std::cell::RefCell;
+    /// Op classes: 0 add, 1 mul, 2 div, 3 sqrt, then extras (below).
+    pub const QUAD: usize = 4;
+    pub const WEAK_QUAD: usize = 5;
+    pub const FAST_QUAD: usize = 6;
+    pub const NEWTON: usize = 7;
+    pub const BOUND: usize = 8;
+    pub const CBRT: usize = 9;
+    pub const KICK: usize = 10;
+    pub const KICK_CLOCK: usize = 11;
+    pub const N: usize = 12;
+    /// Stage labels (set by the universe's kick path): 0 unlabeled, 1..5 the kick's stages.
+    pub const STAGES: usize = 6;
+    thread_local! {
+        static B: RefCell<Counters> = RefCell::new(Counters::default());
+    }
+    #[derive(Default)]
+    struct Counters {
+        stage: usize,
+        ops: [u64; N],
+        by_stage: [[u64; N]; STAGES],
+        ns: [u128; STAGES],
+    }
+    #[inline]
+    pub fn bump(class: usize) {
+        B.with(|b| {
+            let mut b = b.borrow_mut();
+            let s = b.stage;
+            b.ops[class] += 1;
+            b.by_stage[s][class] += 1;
+        });
+    }
+    pub fn set_stage(s: usize) {
+        B.with(|b| b.borrow_mut().stage = s);
+    }
+    pub fn stage_ns(s: usize, ns: u128) {
+        B.with(|b| b.borrow_mut().ns[s] += ns);
+    }
+    /// Read and reset everything on this thread.
+    pub fn take() -> ([u64; N], [[u64; N]; STAGES], [u128; STAGES]) {
+        B.with(|b| {
+            let mut b = b.borrow_mut();
+            (
+                std::mem::take(&mut b.ops),
+                std::mem::take(&mut b.by_stage),
+                std::mem::take(&mut b.ns),
+            )
+        })
+    }
+}
