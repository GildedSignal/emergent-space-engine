+//! The zero-event frame's cost and the digest's schedule-independence, for the lazy calendar
+//! (a due lane keyed on the next item tick, a rekey that runs only when the observer moved,
+//! and no deferral). Run with `ES_LAZY_CAL=0` for the shipped path, `ES_LAZY_CAL=1` (default)
+//! for the patched one.
+//!
+//! - `quiet`:  K zero-event frames (`advance(now)`) at N = 1e4..2e5 root-doll ships: p50/p99/max.
+//! - `busy`:   settle 5e4 ships to a horizon: wall time and events (the lane's per-event overhead).
+//! - `digest`: plane (fleet + player + decisions) at 5 schedules and the ship population at 3
+//!             schedules: asserts one digest per scenario, prints them for the cross-mode diff.
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::{plane, restricted_with};
+use emergent_universe::{Budget, Config, Universe};
+use std::time::Instant;
+
+const H: i64 = 150_000_000;
+
+/// N ships about the star in the root doll, phases and radii spread (the restricted problem's
+/// population: every ship is a planned, queued body with real kicks).
+fn pop(n: usize) -> Universe {
+    let ships: Vec<(i64, u32)> = (0..n)
+        .map(|i| {
+            let a = i as f64 / n as f64;
+            let r = 300_000_000.0 + 6_000_000.0 * (1.0 + (((i.wrapping_mul(2_654_435_761) >> 13) % 1000) as f64) / 500.0);
+            (r as i64, (a * (1u64 << 32) as f64) as u32)
+        })
+        .collect();
+    restricted_with(20, 300_000_000, 49_000, &ships, 1, Config::default()).unwrap().u
+}
+
+fn quiet(ns: &[usize], k: usize) {
+    for &n in ns {
+        let mut u = pop(n);
+        let mut times = Vec::with_capacity(k);
+        let mut events = 0u64;
+        for _ in 0..k {
+            let t0 = Instant::now();
+            let a = u.advance(u.now, Budget::unlimited());
+            times.push(t0.elapsed().as_nanos() as f64);
+            events += a.events;
+        }
+        times.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let q = |p: f64| times[(p * (times.len() - 1) as f64) as usize];
+        println!(
+            "quiet n={n:>7} events={events} p50={:8.0}ns p99={:8.0}ns max={:8.0}ns per-body-p50={:7.3}ns",
+            q(0.5), q(0.99), times[times.len() - 1], q(0.5) / n as f64
+        );
+    }
+}
+
+fn busy(n: usize) {
+    let mut u = pop(n);
+    let t0 = Instant::now();
+    u.settle(H);
+    let s = u.stats;
+    println!("busy n={n} settle {:.2}s events {} kicks {}", t0.elapsed().as_secs_f64(), s.events(), s.kicks);
+}
+
+/// Frames the way a session runs them, then the canonical cut.
+fn run_pop(n: usize, budget: Budget, step: i64) -> String {
+    let mut u = pop(n);
+    while u.now < H {
+        let target = (u.now + step).min(H);
+        let a = u.advance(target, budget);
+        u.now = a.horizon.max(u.now);
+        if a.events == 0 && a.overflow {
+            u.settle(target);
+        }
+    }
+    u.settle(H);
+    u.digest()
+}
+
+const PH: i64 = 2_000_000_000;
+const MEMBERS: u64 = 24;
+const INPUTS: [(i64, u8); 8] = [
+    (10_000_000, 1), (12_000_000, 0), (300_000_000, 9), (302_000_000, 0),
+    (900_000_000, 2), (902_000_000, 0), (1_200_000_000, 4), (1_201_000_000, 0),
+];
+
+fn run_plane(threads: usize, budget: Budget, step: i64) -> String {
+    let mut p = plane(Config::default(), 7, Order::Sparse, threads, MEMBERS).unwrap();
+    let mut next_input = 0;
+    while p.u.now < PH {
+        let mut target = (p.u.now + step).min(PH);
+        if let Some(&(t, _)) = INPUTS.get(next_input) {
+            target = target.min(t.max(p.u.now + 1));
+        }
+        let a = p.u.advance(target, budget);
+        p.u.now = a.horizon.max(p.u.now);
+        if let Some(&(t, keys)) = INPUTS.get(next_input) {
+            if p.u.now >= t {
+                p.u.input(t, keys).unwrap();
+                next_input += 1;
+            }
+        }
+        if a.events == 0 && a.overflow {
+            p.u.settle(target);
+        }
+    }
+    p.u.settle(PH);
+    p.u.digest()
+}
+
+fn digest() {
+    let mut ok = true;
+    let reference = run_plane(1, Budget::unlimited(), 3_000_000);
+    println!("plane reference digest {}", &reference[..32]);
+    for (threads, events, step) in [
+        (1usize, 13u64, 3_000_000i64), (2, 200, 40_000_000), (4, 7, 1_000_000),
+        (8, 64, 100_000_000), (3, u64::MAX, 7_000_000),
+    ] {
+        let d = run_plane(threads, Budget::events(events), step);
+        println!("plane threads={threads} events={events} step={step}: {} {}", &d[..32], if d == reference { "same" } else { "DIFFERENT" });
+        ok &= d == reference;
+    }
+    let r0 = run_pop(400, Budget::unlimited(), 3_000_000);
+    println!("pop reference digest {}", &r0[..32]);
+    for (events, step) in [(13u64, 1_000_000i64), (7, 20_000_000)] {
+        let d = run_pop(400, Budget::events(events), step);
+        println!("pop events={events} step={step}: {} {}", &d[..32], if d == r0 { "same" } else { "DIFFERENT" });
+        ok &= d == r0;
+    }
+    // A control that can fail: another input log gives another digest.
+    let d = run_pop(401, Budget::unlimited(), 3_000_000);
+    println!("pop n=401 control: {} {}", &d[..32], if d != r0 { "differs (good)" } else { "IDENTICAL (bad control)" });
+    ok &= d != r0;
+    assert!(ok, "a digest moved");
+}
+
+fn main() {
+    let mode = std::env::args().nth(1).unwrap_or_else(|| "quiet".into());
+    let lazy = std::env::var("ES_LAZY_CAL").map_or(true, |v| v != "0");
+    println!("mode={mode} lazy={lazy}");
+    match mode.as_str() {
+        "quiet" => quiet(&[10_000, 50_000, 100_000, 200_000], 300),
+        "busy" => busy(50_000),
+        "digest" => digest(),
+        _ => panic!("unknown mode"),
+    }
+}
