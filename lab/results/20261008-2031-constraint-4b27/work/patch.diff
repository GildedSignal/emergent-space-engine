+fn chain_mark(u: &Universe, i: usize) -> Tick {
+    let b = u.bodies();
+    let mut m = b.event_time(i);
+    let mut cur = i;
+    while let Some(c) = u.dolls[b.doll(cur) as usize].centre {
+        m = m.max(b.event_time(c));
+        cur = c;
+    }
+    m
+}
+
+/// The extrapolation span cap, from the worldline's measured curvature: probe the state `S` ticks
+/// past the exact crossing, take the deviation from the linear model (`½aS²`), and allow the span
+// `τ` whose deviation `½aτ²` is a direction error of `1e-4` rad at the emitter's distance.
+fn measured_cap(dev: f64, dist: f64, s: f64) -> f64 {
+    if dev <= 0.0 {
+        return f64::INFINITY;
+    }
+    s * (1e-4 * dist / dev).sqrt()
 }
 
