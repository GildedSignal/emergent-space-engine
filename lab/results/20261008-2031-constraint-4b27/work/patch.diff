+/// Profiling marks for the gather (lab run 20261008-2031-constraint-4b27): microseconds accumulated
+/// per section of the last gather(s): [0] player prologue, [1] bodies loop, [2] fleets loop, [3] star.
+/// A lab instrument only; nothing here is read by the engine.
+pub mod prof {
+    use std::cell::Cell;
+    thread_local! {
+        static MARKS: [Cell<u64>; 4] = [const { Cell::new(0) }, const { Cell::new(0) }, const { Cell::new(0) }, const { Cell::new(0) }];
+    }
+    pub fn mark(idx: usize, us: u64) {
+        MARKS.with(|m| m[idx].set(m[idx].get() + us));
+    }
+    pub fn take() -> [u64; 4] {
+        MARKS.with(|m| std::array::from_fn(|i| m[i].replace(0)))
+    }
+    thread_local! {
+        pub static GATE: [Cell<u64>; 4] = [const { Cell::new(0) }, const { Cell::new(0) }, const { Cell::new(0) }, const { Cell::new(0) }];
+    }
+    pub fn gate(idx: usize) {
+        GATE.with(|m| m[idx].set(m[idx].get() + 1));
+    }
+    pub fn gate_take() -> [u64; 4] {
+        GATE.with(|m| std::array::from_fn(|i| m[i].replace(0)))
+    }
+}
+
+fn timed<T>(idx: usize, f: impl FnOnce() -> T) -> T {
+    let t0 = std::time::Instant::now();
+    let r = f();
+    prof::mark(idx, t0.elapsed().as_micros() as u64);
+    r
+}
