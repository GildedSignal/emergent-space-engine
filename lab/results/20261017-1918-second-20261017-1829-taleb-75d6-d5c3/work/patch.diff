+/// The birth stagger's offset (lab run 20261015-0128-fermi-ed3a): a uniform id-derived fraction of one step
+/// `2·half`, by the splitmix64 finalizer — a pure function of the body's id (no new state). Both gates
+/// (`ES_STAGGER`, `ES_STAGGER_SYM`) draw the same offset for a body; what differs is what the clock does with it.
+fn stagger_off(i: usize, step: i64) -> i64 {
+    let mut z = (i as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    (((z ^ (z >> 31)) >> 33) as u128 * step as u128 >> 31) as i64
+}
+
