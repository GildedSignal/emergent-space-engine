 use std::sync::Arc;
 
+// ── print-only kick census (lab probe; env ES_KICKCENSUS; counters only, no state touched) ──
+// What a resolved kick item did to the velocity word: a kick whose quantized dv is zero fires
+// nothing (no rebind, no new tube), so the fired share is the share that a static compact
+// certificate cannot sleep through. Each slot: [items, fired (non-thrust), Σ|dvq|max, #m==1,
+// #m≥2, #m≥4, #m≥16, max|dvq|, thrusting items].
+pub const CENSUS_N: usize = 11;
+const CEN_Z: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static CEN_ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("ES_KICKCENSUS").is_ok());
+static CEN_SPLIT: [std::sync::atomic::AtomicU64; CENSUS_N] = [CEN_Z; CENSUS_N];
+static CEN_CLOCK: [std::sync::atomic::AtomicU64; CENSUS_N] = [CEN_Z; CENSUS_N];
+
+fn census(slot: &[std::sync::atomic::AtomicU64; CENSUS_N], dvq: [i64; 2], thrusting: bool, vwords: [i64; 2]) {
+    use std::sync::atomic::Ordering::Relaxed;
+    if !*CEN_ON {
+        return;
+    }
+    slot[0].fetch_add(1, Relaxed);
+    if thrusting {
+        slot[8].fetch_add(1, Relaxed);
+        return;
+    }
+    let m = dvq[0].unsigned_abs().max(dvq[1].unsigned_abs());
+    if m > 0 {
+        slot[1].fetch_add(1, Relaxed);
+    }
+    slot[2].fetch_add(m, Relaxed);
+    if m == 1 {
+        slot[3].fetch_add(1, Relaxed);
+    }
+    if m >= 2 {
+        slot[4].fetch_add(1, Relaxed);
+    }
+    slot[9].fetch_add(vwords[0].unsigned_abs().max(vwords[1].unsigned_abs()) as u64, Relaxed);
+    slot[10].fetch_add(1, Relaxed);
+    if m >= 4 {
+        slot[5].fetch_add(1, Relaxed);
+    }
+    if m >= 16 {
+        slot[6].fetch_add(1, Relaxed);
+    }
+    let mut cur = slot[7].load(Relaxed);
+    while m > cur {
+        match slot[7].compare_exchange_weak(cur, m, Relaxed, Relaxed) {
+            Ok(_) => break,
+            Err(v) => cur = v,
+        }
+    }
+}
+
+/// The census so far: `(the split's kicks, the clock's kicks)`, each `[items, fired (non-thrust),
+/// Σ|dvq|max, #m==1, #m≥2, #m≥4, #m≥16, max|dvq|, thrusting items, Σ|v|max (non-thrust), #non-thrust]`.
+pub fn kick_census() -> ([u64; CENSUS_N], [u64; CENSUS_N]) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let mut load = |s: &[std::sync::atomic::AtomicU64; CENSUS_N]| {
+        let mut out = [0u64; CENSUS_N];
+        for k in 0..CENSUS_N {
+            out[k] = s[k].load(Relaxed);
+        }
+        out
+    };
+    (load(&CEN_SPLIT), load(&CEN_CLOCK))
+}
