+//! The birth rail's shared-readout rung (nladder's named next experiment, after 404b/cfe5): the belt is
+//! built (`scenario::plane_extra`, the ladder's own population) and settled to a pre-wave canonical cut,
+//! with `ES_BIRTH_SPLIT` printing the plan pass per body and `ES_PLANETS_AT_T` arming one shared
+//! "planets at t" readout for both read paths (`Ctx::secondaries`/`tide` and `ext::constants`' source).
+//! The digest after the cut must be the same with the memo off and on: the table only re-serves, bit for
+//! bit, reads the live paths would make anyway.
+//!
+//! cargo run --release -p emergent-universe --example birth_rail [-- <N> <seed> [cut_game_seconds]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::Config;
+use std::time::Instant;
+
+fn main() {
+    let n: usize = std::env::args().nth(1).and_then(|a| a.parse().ok()).unwrap_or(10_000);
+    let seed: u64 = std::env::args().nth(2).and_then(|a| a.parse().ok()).unwrap_or(1);
+    let cut_s: f64 = std::env::args().nth(3).and_then(|a| a.parse().ok()).unwrap_or(3_000.0);
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed();
+    let cut = (cut_s / TICK_SECONDS) as i64;
+    let t1 = Instant::now();
+    p.u.settle(cut);
+    let settle = t1.elapsed();
+    println!(
+        "birth_rail: n={n} seed={seed} memo={} build_s={:.2} settle_s={:.2} kicks={} digest={}",
+        emergent_universe::ctx::memo_on(),
+        build.as_secs_f64(),
+        settle.as_secs_f64(),
+        p.u.stats.kicks,
+        p.u.digest()
+    );
+}
