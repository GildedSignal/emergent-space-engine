+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::time::Instant;
 
+/// Print-only birth instrumentation (`ES_BIRTH_SPLIT`, 404b's knob, cfe5's continuation): the accumulators are
+/// armed only inside `Universe::start`'s pass, so flights never accumulate (and the disarmed path is one
+/// relaxed load). `""`/`0`/`off` mean off.
+pub static TIMERS_ARMED: AtomicBool = AtomicBool::new(false);
+pub static T_CONSTANTS: AtomicU64 = AtomicU64::new(0);
+pub static T_PROJECT: AtomicU64 = AtomicU64::new(0);
+pub static T_READOUT: AtomicU64 = AtomicU64::new(0);
+pub static T_SECONDARIES: AtomicU64 = AtomicU64::new(0);
+pub static T_APPLY: AtomicU64 = AtomicU64::new(0);
+/// Plan-path own-state readout calls while armed (integer, unlike the timers: 3 per body shipped).
+pub static T_READOUTS: AtomicU64 = AtomicU64::new(0);
+/// Plan-path constants-cache hits while armed (integer: ~1 per body when `ES_CONSTANTS_ONCE` is on).
+pub static T_CONSTANTS_HITS: AtomicU64 = AtomicU64::new(0);
+
+fn env_on(name: &str) -> bool {
+    matches!(std::env::var(name).as_deref(), Ok(v) if !v.is_empty() && v != "0" && v != "off")
+}
+/// Whether the birth timers print (`ES_BIRTH_SPLIT`).
+pub fn split_on() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| env_on("ES_BIRTH_SPLIT"));
+    *ON
+}
+/// Whether the shared planets readout is armed (`ES_PLANETS_AT_T`); off is the shipped path verbatim.
+pub fn memo_on() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| env_on("ES_PLANETS_AT_T"));
+    *ON
+}
+/// Whether one state serves the plan's reads (`ES_STATE_ONCE`): the plan reads the body's exact state
+/// at `t` once and every consumer of it (the register's word, the projection, the tail's Kepler) uses
+/// that read; off is the shipped path verbatim (one read per consumer).
+pub fn state_once() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| env_on("ES_STATE_ONCE"));
+    *ON
+}
+/// Whether the plan's per-doll clock constants are served from the shared readout
+/// (`ES_CONSTANTS_ONCE`): every non-source body of a doll computes the same `(Δs, c, b)` sum; off is
+/// the shipped path verbatim (the sum per body).
+pub fn constants_once() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| env_on("ES_CONSTANTS_ONCE"));
+    *ON
+}
+
+#[inline]
+pub(crate) fn add_ns(counter: &AtomicU64, t0: Instant) {
+    if TIMERS_ARMED.load(Ordering::Relaxed) {
+        counter.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+}
+
+/// Count a plan-path own-state readout call (integer evidence, independent of the timers' overheads).
+#[inline]
+pub(crate) fn count_readout() {
+    if TIMERS_ARMED.load(Ordering::Relaxed) {
+        T_READOUTS.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Count a plan-path constants-cache hit (integer evidence, as [`count_readout`]).
+#[inline]
+pub(crate) fn count_constants_hit() {
+    if TIMERS_ARMED.load(Ordering::Relaxed) {
+        T_CONSTANTS_HITS.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// One source of a doll, read once at one tick: **both projections of the same readout** — the Cartesian
+/// state the forces read ([`Ctx::secondaries`], [`Ctx::tide`]) and the elements the clock reads
+/// ([`ext::constants`](crate::ext::constants)' `source`): `(gm, semi-major axis, period)`, or the refusal
+/// the live path would return (`Err`), replayed bit for bit. A pass that reads every body against the same
+/// sources at the same tick (a birth pass, a same-epoch kick batch) reads them once, not once per body.
+#[derive(Clone, Debug)]
+pub struct PlanetsAt {
+    /// The tick the table was read at; a read at any other tick misses (and falls back to the live path).
+    pub tick: Tick,
+    /// Per doll, in `sources[d]`'s order: the source's id and its Cartesian state as a secondary.
+    pub per_doll: Vec<Vec<(usize, Secondary)>>,
+    /// The clock's projection of the same readouts: `(j, Ok((gm, axis, period)) | Err(reason))`.
+    pub elems: Vec<(usize, Res<(Scalar, Scalar, Scalar)>)>,
+    /// Per doll: the parent's tide — its mass and the centre's position, in the doll's units.
+    pub tide: Vec<Option<(Scalar, V2)>>,
+    /// Per doll: the centre's state (position, velocity) in the parent's units.
+    pub centre: Vec<Option<Res<(V2, V2)>>>,
+    /// Per doll: the clock constants every non-source body of the doll computes identically — the
+    /// live sum with an `except` that matches no source, `(Δs, c, b)` or the `Err` each would get.
+    pub constants: Vec<Res<(Scalar, Scalar, Scalar)>>,
+}
+
+impl PlanetsAt {
+    /// Read every doll's sources at `t` once, through the same live paths the per-body reads use
+    /// (the table is built before it is armed, so these are the shipped reads verbatim). A live
+    /// refusal is a refusal to arm: if any read errs, no table is served and every body reads live —
+    /// the memo never converts an error into a shorter answer (an `Err` it *stores*, like an
+    /// element's, is replayed bit for bit, which the live path would re-derive identically).
+    pub fn build(ctx: &Ctx, t: Tick) -> Option<PlanetsAt> {
+        let mut per_doll = Vec::with_capacity(ctx.sources.len());
+        for src in ctx.sources {
+            let mut doll = Vec::with_capacity(src.len());
+            for &j in src {
+                let (pos, vel) = ctx.state_of(j, t).ok()?;
+                doll.push((j, Secondary { gm: ctx.info[j].gm, pos, vel, edge: ctx.info[j].soi }));
+            }
+            per_doll.push(doll);
+        }
+        let elems = ctx
+            .sources
+            .iter()
+            .flatten()
+            .map(|&j| (j, crate::ext::source_live(ctx, j, t).map(|s| (s.gm, s.axis, s.period))))
+            .collect();
+        let mut tide = Vec::with_capacity(ctx.dolls.len());
+        for d in 0..ctx.dolls.len() {
+            tide.push(ctx.tide_live(d as u16, t).ok()?);
+        }
+        let centre = (0..ctx.dolls.len())
+            .map(|d| (d != 0).then(|| ctx.centre_live(d as u16, t)))
+            .collect();
+        let constants = (0..ctx.dolls.len())
+            .map(|d| crate::ext::constants_live(ctx, d as u16, t, usize::MAX, ctx.cfg.step_log2))
+            .collect();
+        Some(PlanetsAt { tick: t, per_doll, elems, tide, centre, constants })
+    }
+
+    /// The element projection of source `j` at `self.tick`, if this table holds it.
+    pub fn elem(&self, j: usize, t: Tick) -> Option<Res<(Scalar, Scalar, Scalar)>> {
+        (self.tick == t).then(|| self.elems.iter().find(|&&(k, _)| k == j).map_or(Err(crate::num::Error::Refused("not a source")), |(_, r)| *r))
+    }
+}
