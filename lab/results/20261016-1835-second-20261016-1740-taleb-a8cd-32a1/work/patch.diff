diff --git a/xtask/src/behave/handoff.rs b/xtask/src/behave/handoff.rs
index fcc26869..ef584b3b 100644
--- a/xtask/src/behave/handoff.rs
+++ b/xtask/src/behave/handoff.rs
@@ -428,4 +428,99 @@ mod tests {
         assert_eq!(median(vec![f64::NAN, f64::NAN, 1.0]), f64::INFINITY);
         assert_eq!(median(vec![]), f64::INFINITY);
     }
+
+    /// Lab probe (20261016-1740-taleb-a8cd, Taleb): the frozen corpus's knife edges, per ship.
+    /// Arms: pristine (this machine's system libm through `ship`), the drawn angle ±1 ulp, and the
+    /// same seed built through musl (the `libm` crate). The module's own doc: the search "moves
+    /// with the last bit of the arithmetic (one ship in 40 of a rerun changes)" — this measures how
+    /// far the frozen 16 sit from their (crossings, converged, closest) knife edges on this box,
+    /// and whether another libm's last ulp moves them across.
+    #[test]
+    #[ignore = "lab probe a8cd: the frozen corpus's ulp and libm census"]
+    fn lab_corpus_ulp_libm_census() {
+        let scene = JUPITER;
+        let draws = sample::handoffs(sample::HANDOFF_KEPT.iter().max().map_or(0, |m| m + 1));
+        let musl_ship = |side: f64, k: f64, alpha: f64| {
+            let r = scene.sep * (1.0 + side * scene.hill() / scene.sep * k);
+            let v = libm::pow(r, -0.5);
+            [r * libm::cos(alpha), r * libm::sin(alpha), -v * libm::sin(alpha), v * libm::cos(alpha)]
+        };
+        let ulp = |a: f64, d: i64| f64::from_bits((a.to_bits() as i64 + d) as u64);
+        let show = |a: &Option<Assessed>| match a {
+            Some(x) => format!("cr {} cv {} {:.3} Rp", x.crossings, x.converged, x.closest / scene.planet_radius),
+            None => "gave up".to_string(),
+        };
+        let judged = |a: &Option<Assessed>| matches!(a, Some(x) if x.converged && x.closest >= scene.planet_radius);
+        let pristine_arm = |p: &Kept| Some(Assessed { crossings: p.crossings, converged: p.converged, closest: p.closest });
+        let (mut trig_ships, mut pow_ships, mut counts) = (0usize, 0usize, [0usize; 4]);
+        for (rank, &i) in sample::HANDOFF_KEPT.iter().enumerate() {
+            let (side, k, alpha) = draws[i];
+            let r = scene.sep * (1.0 + side * scene.hill() / scene.sep * k);
+            let (c, s, p) = (libm::cos(alpha) != alpha.cos(), libm::sin(alpha) != alpha.sin(), libm::pow(r, -0.5) != r.powf(-0.5));
+            trig_ships += (c || s) as usize;
+            pow_ships += p as usize;
+            let pristine = &kept()[rank];
+            let same = Assessed { crossings: pristine.crossings, converged: pristine.converged, closest: pristine.closest };
+            let arms = [
+                pristine_arm(pristine),
+                assess(&scene, ship(&scene, side, k, ulp(alpha, 1))),
+                assess(&scene, ship(&scene, side, k, ulp(alpha, -1))),
+                if c || s || p { assess(&scene, musl_ship(side, k, alpha)) } else { Some(same) },
+            ];
+            for (j, a) in arms.iter().enumerate() {
+                counts[j] += judged(a) as usize;
+            }
+            println!(
+                "kept[{rank:2}] #{i:3} seedlibm c{} s{} p{}: pristine [{}] | a+1ulp [{}] | a-1ulp [{}] | musl [{}]",
+                c as u8, s as u8, p as u8, show(&arms[0]), show(&arms[1]), show(&arms[2]), show(&arms[3])
+            );
+        }
+        println!(
+            "judged (converged and outside): pristine {}/16, alpha+1ulp {}/16, alpha-1ulp {}/16, musl {}/16; glibc-vs-musl seed sin/cos differ on {} ships, powf on {}",
+            counts[0], counts[1], counts[2], counts[3], trig_ships, pow_ships
+        );
+    }
+
+    /// Lab probe (20261016-1835-…-32a1, the checker's named missing experiment): the CR-only seed
+    /// path. `work/crseeds.py` recomputes the draws exactly (they are portable) and every non-CR
+    /// libm call of `ship`'s seed path — `cbrt` inside `hill`, `powf(r,−0.5)`, `cos`, `sin` —
+    /// correctly rounded at 60 digits, each f64 op rounded individually; the table arrives via
+    /// env `CR_TABLE`. If CR seeds gave back a stable corpus (16/16 judged, crossings ≥ 20), the
+    /// seed leg of fix (b) alone would repair the instrument; if not, the walk's per-step calls
+    /// (`sin_cos`, `hypot`) must go CR too, or the assessed fields must be frozen (fix (a)).
+    #[test]
+    #[ignore = "lab probe 32a1: the CR-only seed path corpus"]
+    fn lab_corpus_cr_seeds() {
+        let scene = JUPITER;
+        let draws = sample::handoffs(sample::HANDOFF_KEPT.iter().max().map_or(0, |m| m + 1));
+        let table = std::fs::read_to_string(std::env::var("CR_TABLE").unwrap_or_default())
+            .unwrap_or_else(|_| panic!("set CR_TABLE=<cr_seeds.txt> (work/crseeds.py writes it)"));
+        let word = |h: &str| f64::from_bits(u64::from_str_radix(h, 16).unwrap());
+        let dist = |a: f64, b: f64| (a.to_bits() as i64 - b.to_bits() as i64).unsigned_abs();
+        let (mut judged, mut crossings) = (Vec::new(), Vec::new());
+        for line in table.lines().filter(|l| !l.trim().is_empty()) {
+            let p: Vec<&str> = line.split_whitespace().collect();
+            assert_eq!(p.len(), 12, "bad CR table line: {line:?}");
+            let rank = sample::HANDOFF_KEPT.iter().position(|&i| i == p[0].parse::<usize>().unwrap()).unwrap();
+            let (side, k, alpha) = draws[sample::HANDOFF_KEPT[rank]];
+            // The draws are portable arithmetic, so the table must match this box bit for bit.
+            assert_eq!(k.to_bits(), u64::from_str_radix(p[2], 16).unwrap(), "draw k moved at rank {rank}");
+            assert_eq!(alpha.to_bits(), u64::from_str_radix(p[3], 16).unwrap(), "draw alpha moved at rank {rank}");
+            let (r_cr, v_cr, c_cr, s_cr) = (word(p[4]), word(p[5]), word(p[6]), word(p[7]));
+            let seed = [word(p[8]), word(p[9]), word(p[10]), word(p[11])];
+            // How far this box's glibc seed path sits from CR, per call.
+            let r_g = scene.sep * (1.0 + side * scene.hill() / scene.sep * k);
+            let (dr, dv, dc, ds) = (dist(r_g, r_cr), dist(r_g.powf(-0.5), v_cr), dist(alpha.cos(), c_cr), dist(alpha.sin(), s_cr));
+            let a = assess(&scene, seed).unwrap_or(Assessed { crossings: 0, converged: false, closest: 0.0 });
+            judged.push(a.converged && a.closest >= scene.planet_radius);
+            crossings.push(a.crossings);
+            println!(
+                "kept[{rank:2}] #{:3}: glibc-vs-CR ulps r{dr} v{dv} cos{dc} sin{ds} | CR cr {} cv {} {:.3} Rp judged {}",
+                sample::HANDOFF_KEPT[rank], a.crossings, a.converged, a.closest / scene.planet_radius, judged[rank] as u8
+            );
+        }
+        assert_eq!(judged.len(), 16, "the CR table must hold all 16 frozen ships");
+        let n = judged.iter().filter(|&&j| j).count();
+        println!("CR corpus: {n}/16 judged, crossings {crossings:?} (frozen at ≥ 20 each; pristine glibc seeds read 14/16 here)");
+    }
 }
