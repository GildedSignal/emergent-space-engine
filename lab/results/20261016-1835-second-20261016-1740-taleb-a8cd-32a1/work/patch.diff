+    /// Lab probe (20261016-1740-taleb-a8cd, Taleb): the failure anatomy of `across_a_kick…` on
+    /// this box — every frozen ship's oracle fields (this machine's `assess`), which ships the
+    /// test's `closest >= planet_radius` filter takes here, and each taken ship's J walk. The
+    /// integer law is machine-portable; this separates "which ships get judged" from "what the law
+    /// did".
+    #[test]
+    #[ignore = "lab probe a8cd: the across_a_kick selection and J walks"]
+    fn lab_across_a_kick_selection() {
+        use super::super::handoff;
+        use super::super::sample;
+        let scene = JUPITER;
+        let mut taken = 0;
+        for (i, k) in handoff::kept().iter().enumerate() {
+            println!(
+                "kept[{i:2}] #{}: crossings {}, converged {}, closest {:.3} Rp",
+                sample::HANDOFF_KEPT[i], k.crossings, k.converged, k.closest / scene.planet_radius
+            );
+            if k.closest >= scene.planet_radius && taken < 6 {
+                taken += 1;
+                let r = j_run(k.ship, 6, 40.0, false);
+                println!(
+                    "  -> the test's filtered#{taken} (kept index {i}): {} kicks, across a kick {:.2} quanta, over its work {:.3e}",
+                    r.kicks, r.across_kick, r.across_kick_over_work
+                );
+            }
+        }
+    }
+
+    /// Lab probe (20261016-1740-taleb-a8cd): is the failing ship's J walk stable against the last
+    /// bit of its seed? `j_run` is integer arithmetic throughout, so the only cross-machine channel
+    /// into it is the f64 seed's quantization at scene build. If ±1 ulp on every seed component
+    /// leaves the walk unchanged, no libm can move this test's outcome between machines.
+    #[test]
+    #[ignore = "lab probe a8cd: the failing ship's seed-ulp stability"]
+    fn lab_across_a_kick_ulp_stability() {
+        use super::super::handoff;
+        let ulp4 = |s: [f64; 4], d: i64| s.map(|x| f64::from_bits((x.to_bits() as i64 + d) as u64));
+        let k = &handoff::kept()[3]; // candidate #57, this test's ship 3 on this box
+        for (name, ship) in [("pristine", k.ship), ("all+1ulp", ulp4(k.ship, 1)), ("all-1ulp", ulp4(k.ship, -1))] {
+            let r = j_run(ship, 6, 40.0, false);
+            println!("{name}: {} kicks, across a kick {:.2} quanta, over its work {:.3e}", r.kicks, r.across_kick, r.across_kick_over_work);
+        }
+    }
+
+    /// Lab probe (20261016-1835-…-32a1): `j_run` on the CR seeds of the test's four ships — the
+    /// portable observable. `j_run` past `build_scene` is integer arithmetic, so on CR seeds
+    /// (machine-independent bits) the whole observable becomes machine-independent: it passes the
+    /// 5e-8 bar everywhere or fails it everywhere, and stops being a libm coin flip. Table via
+    /// env `CR_TABLE` (work/crseeds.py writes it).
+    #[test]
+    #[ignore = "lab probe 32a1: across_a_kick on the CR seeds"]
+    fn lab_across_a_kick_cr_seeds() {
+        use super::super::sample;
+        let table = std::fs::read_to_string(std::env::var("CR_TABLE").unwrap_or_default())
+            .unwrap_or_else(|_| panic!("set CR_TABLE=<cr_seeds.txt> (work/crseeds.py writes it)"));
+        let word = |h: &str| f64::from_bits(u64::from_str_radix(h, 16).unwrap());
+        for line in table.lines().filter(|l| !l.trim().is_empty()) {
+            let p: Vec<&str> = line.split_whitespace().collect();
+            let rank = sample::HANDOFF_KEPT.iter().position(|&i| i == p[0].parse::<usize>().unwrap()).unwrap();
+            if rank > 3 {
+                continue; // the test's .take(4): the first four frozen ships
+            }
+            let seed = [word(p[8]), word(p[9]), word(p[10]), word(p[11])];
+            let r = j_run(seed, 6, 40.0, false);
+            println!(
+                "CR kept[{rank}] (#{}, the test's ship {rank}): {} kicks, across a kick {:.2} quanta, over its work {:.3e}{}",
+                sample::HANDOFF_KEPT[rank], r.kicks, r.across_kick, r.across_kick_over_work,
+                if r.across_kick_over_work <= 5e-8 { " (≤ 5e-8: pass)" } else { " (> 5e-8: fail)" }
+            );
+        }
+    }
 }
