+/// Linux port (the tree's only memory instrument was macOS-only, so every ladder number read 0 MB on the lab's machines):
+/// (VmRSS now, VmHWM peak) from /proc/self/status, in bytes.
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let Ok(status) = std::fs::read_to_string("/proc/self/status") else {
+        return (0, 0);
+    };
+    let kb = |line: &str| -> u64 {
+        line.split_whitespace().next().and_then(|k| k.parse::<u64>().ok()).unwrap_or(0) * 1024
+    };
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    for line in status.lines() {
+        if let Some(rest) = line.strip_prefix("VmRSS:") {
+            now = kb(rest);
+        } else if let Some(rest) = line.strip_prefix("VmHWM:") {
+            peak = kb(rest);
+        }
+    }
+    (now, peak)
+}
