+//! The scene tests of gravity at c (run 20261006-1738's missing evidence, second author
+//! 20261006-1931): a **consumer whose cadence resolves a massive source's light delay**, and the
+//! freely-falling pair's three-way control. The cone's integer exactness is pinned in
+//! `src/news.rs`; what was missing is the *behaviour*: news bites, and it bites never before the
+//! cone.
+//!
+//! Scene A (the twins): a massive player-class burner in Home's doll (mass 2^-3 of Home: the API's
+//! player has thrust, and `make_source` gives it pull — the lens's "a thrusting planet's pull
+//! reaches others at light speed", which no shipped scene could express, the first checker's
+//! structural finding) burns at `t_on`..`t_off`, and two ships at 6,000 root units of Home read it
+//! while it sits at 60,000 (light delay ~5.4e4–6.6e4 ticks against kick intervals of ~1.4e3: about
+//! 40 kicks inside the light window). The burn/no-burn twins must be **bit-identical at every poll
+//! outside the source's light cone**, and the first differing poll must be the first one inside it
+//! — the integer cone `news::arrived` evaluated on the measured states, not a float delay. The
+//! Instant control (yesterday's law, exactly "delete the cursor and read the current binding")
+//! must differ *before* the cone: that is the falsifier, the test that fails if the cursor is
+//! deleted. The Retarded control (Laplace's field) must also stay behind the cone.
+//!
+//! Scene B (the pair): two massive moons of Home on eccentric orbits that pass close, each read by
+//! the other. For a freely falling source the delivered tube evaluated now places it where it is
+//! (the aberration cancels: the generator travels, not the position), so News ≡ Instant to ~1e-6;
+//! the retarded read pulls toward where the source *was* (Laplace's wrong field) and the pair
+//! drifts ~100× further. The spiral's e-folding needs a mutual β the API cannot express (members
+//! must stay bound in their own doll; the first checker's cap), so the control pins the split, not
+//! the unbinding.
+use emergent_space::binding::IntegerState;
+use emergent_space::events::{Doll, LogMass};
+use emergent_space::orbit::Scalar;
+use emergent_universe::news::{arrived, Gravity};
+use emergent_universe::num::{s, to_f64, Tick};
+use emergent_universe::thrust::word;
+use emergent_universe::universe::{OrbitSpec, Universe};
+use emergent_universe::{Config, Kind};
+
+/// Home as the plane flies it, alone (no perturber: the planet is a pure tube, as in every gate
+/// scene): a circular orbit at 1 AU, radius 4,313 root units, its doll at mass 2^-18 of the star.
+fn home_system(cfg: Config) -> Res<(Universe, usize, u16)> {
+    let mut u = Universe::new(s(471_000), cfg);
+    let home = u.add_body(
+        Kind::Planet,
+        OrbitSpec { doll: 0, periapsis: s(99_300_000), e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+        s(4_313),
+    )?;
+    let doll = u.add_doll("Home", home, -18, Scalar::raw(4_313, 18)?)?;
+    Ok((u, home, doll))
+}
+
+/// Make `i` a secondary of mass 2^`log2` of its host, its sphere of influence from the mass ratio
+/// (the moon's own recipe in `scenario.rs`).
+fn give_mass(u: &mut Universe, i: usize, log2_vs_star: i32, log2_vs_host: i32) -> Res<()> {
+    let sep = u.rec(i).b.entry.trajectory.key().periapsis;
+    let doll = u.rec(i).b.doll;
+    let proto = Doll::child(LogMass((log2_vs_star as i32) << 24), doll, u.rec(i).b.tube);
+    let soi = proto.edge_radius(&u.dolls[doll as usize].record.clone(), sep)?;
+    u.make_source(i, log2_vs_host, soi)
+}
+
+/// One body's exact observable at `t`: the committed tick, the sub-quantum carry and the read
+/// state. Twins that agree here agree everywhere the physics lives (the cursors are plumbing:
+/// after the twins diverge their version chains differ, and a *quiet* rebind can advance the
+/// quiet twin's `seen` without any change in what either side reads).
+fn signature(u: &Universe, i: usize, t: Tick) -> Res<(Tick, [i64; 2], IntegerState)> {
+    let r = u.rec(i);
+    let st = r.b.readout(t)?;
+    Ok((r.b.event_time, r.carry, st))
+}
+/// The root-unit position words of body `i` at `t`, with the exponent `arrived` wants
+/// (doll words relabelled to root units, as `news::secondaries` does).
+fn root_words(u: &Universe, i: usize, t: Tick) -> Res<([i64; 2], i32)> {
+    let r = u.rec(i);
+    let st = r.b.readout(t)?;
+    Ok((st.position, st.length_exponent as i32 - u.dolls[r.b.doll as usize].shift as i32))
+}
+
+/// return (t_e', the emission position in root words, the polls where each side of each assertion
+/// lives, per-poll match flags).
+struct Twins {
+    /// The burn's flush tick (the burner's first rebind the twins disagree on).
+    t_e: Tick,
+    /// The burner's root-unit words at `t_e` (the cone's emission event).
+    xb: ([i64; 2], i32),
+    /// (poll tick, twins match, cone says arrived at that poll).
+    polls: Vec<(Tick, bool, bool)>,
+    /// The first poll where the consumer's cursor has seen the burn (None if never).
+    cursor_arrival: Option<Tick>,
+    /// The consumer the report is taken on.
+    consumer: usize,
+}
+
+fn twins(gravity: Gravity, verbose: bool) -> Res<Twins> {
+    let step_log2 = 20;
+    let mk = |burn: bool| -> Res<(Universe, usize, usize, usize)> {
+        let cfg = Config { step_log2, gravity, ..Config::default() };
+        let (mut u, _home, doll) = home_system(cfg)?;
+        let burner = u.add_body(
+            Kind::Player,
+            OrbitSpec { doll, periapsis: Scalar::raw(60_000, 18)?, e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+            Scalar::raw(34, 8)?,
+        )?;
+        give_mass(&mut u, burner, -21, -3)?;
+        let mut consumers = Vec::new();
+        for phase in [0u32, 0x8000_0000] {
+            consumers.push(u.add_body(
+                Kind::Ship,
+                OrbitSpec { doll, periapsis: Scalar::raw(6_000, 18)?, e_q48: 0, clockwise: false, angle: 0, phase },
+                Scalar::raw(34, 8)?,
+            )?);
+        }
+        u.threads = 1;
+        if burn {
+            // A level-8 hold of 1.6e5 ticks: rapidity 2.3e-6, a third of the burner's escape
+            // speed at 60,000 root units, flushed at the burner's own kicks.
+            u.schedule(100_000, word(1, 8))?;
+            u.schedule(260_000, 0)?;
+        }
+        u.start()?;
+        Ok((u, burner, consumers[0], consumers[1]))
+    };
+    let (mut quiet, burner, c0, c1) = mk(false)?;
+    let (mut hot, _, _, _) = mk(true)?;
+    let mut out = Twins { t_e: 0, xb: ([0; 2], 0), polls: Vec::new(), cursor_arrival: None, consumer: c0 };
+    let poll = 600;
+    let end = 500_000;
+    let mut t = 0;
+    while t < end {
+        t += poll;
+        quiet.settle(t);
+        hot.settle(t);
+        // The consumers' physics: the burner is the emission itself (it differs from t_e' on),
+        // so the twin comparison walks the ships it reads.
+        let mut match_now = true;
+        for &i in &[c0, c1] {
+            if signature(&quiet, i, t)? != signature(&hot, i, t)? {
+                match_now = false;
+            }
+        }
+        // The burn's emission: the first poll where the burner's read state itself differs.
+        if out.t_e == 0 && signature(&quiet, burner, t)?.2.velocity != signature(&hot, burner, t)?.2.velocity {
+            out.t_e = hot.rec(burner).b.event_time;
+            out.xb = root_words(&hot, burner, out.t_e)?;
+            if verbose {
+                println!("[{:?}] emission at t_e'={}", gravity, out.t_e);
+            }
+        }
+        let xc = root_words(&hot, c0, t)?;
+        let a = if out.t_e == 0 { false } else { arrived(t, out.t_e, (&xc.0, xc.1), (&out.xb.0, out.xb.1)) };
+        if out.t_e > 0 && out.cursor_arrival.is_none() {
+            let seen = hot.rec(c0).cursors.iter().find(|c| c.source == burner).map(|c| c.seen);
+            if seen.is_some_and(|tk| tk >= out.t_e) {
+                out.cursor_arrival = Some(t);
+            }
+        }
+        out.polls.push((t, match_now, a));
+    }
+    Ok(out)
+}
+
+/// Scene A: news never bites before the cone, and bites at it; Instant bites immediately.
+#[test]
+fn the_burn_reaches_consumers_at_light_speed_only() -> Res<()> {
+    let news = twins(Gravity::News, true)?;
+    assert!(news.t_e > 0, "the burn flushed");
+    assert!(news.polls.iter().any(|&(_, m, _)| !m), "the twins eventually differ under News");
+    // (1) Bit-identical at every poll outside the cone (the causality property).
+    for &(t, m, a) in &news.polls {
+        if !a {
+            assert!(m, "News: the twins differ at t={t}, before the cone (t_e'={})", news.t_e);
+        }
+    }
+    // (2) The first differing poll is the first one inside the cone.
+    let first = news.polls.iter().position(|&(_, m, _)| !m).unwrap();
+    let (t_star, _, a_star) = news.polls[first];
+    assert!(a_star, "News: the first differing poll t={t_star} is outside the cone");
+    assert!(news.polls[first - 1].1, "it is the first");
+    let arrival = news.cursor_arrival.expect("the cursor saw the burn");
+    assert!(arrival <= t_star, "the cursor delivers before the state fires");
+    assert!(t_star - arrival <= 6 * 600, "the burn fires within a few kicks of its arrival");
+    for &(t, m, _) in &news.polls {
+        if t < arrival {
+            assert!(m, "News: the twins differ at t={t}, before the cursor even saw the burn");
+        }
+    }
+    let delay = t_star - news.t_e;
+    let first_inside = news.polls.iter().position(|&(_, _, a)| a).map_or(0, |k| news.polls[k].0);
+    println!("News: t_e'={} first cone-inside poll={} first difference t*={} (light delay {} ticks)",
+        news.t_e, first_inside, t_star, delay);
+    // The falsifier: with the cursor deleted (the current binding read at the kick's tick), the
+    let instant = twins(Gravity::Instant, true)?;
+    assert!(instant.t_e > 0);
+    let first_i = instant.polls.iter().position(|&(_, m, _)| !m).expect("Instant differs");
+    let (t_i, _, a_i) = instant.polls[first_i];
+    assert!(!a_i, "Instant: the first difference t={t_i} is INSIDE the cone (acausal)");
+    println!("Instant: t_e'={} first difference t={} ({} ticks after the emission, INSIDE the light window of {} ticks)",
+        instant.t_e, t_i, t_i - instant.t_e, t_star - news.t_e);
+
+    // Laplace's read is causal too (it selects the version by the same cone), though its field is
+    // wrong: it must not cross the cone either.
+    let retarded = twins(Gravity::Retarded, true)?;
+    let first_r = retarded.polls.iter().position(|&(_, m, _)| !m);
+    if let Some(k) = first_r {
+        let (t_r, _, a_r) = retarded.polls[k];
+        assert!(a_r, "Retarded: the first difference t={t_r} is outside the cone");
+    }
+    Ok(())
+}
+
+/// Scene B: two massive moons of Home passing close. News vs Instant (the aberration cancels for a
+/// freely falling source) against Retarded (Laplace's field, which drifts the pair).
+#[test]
+fn the_freely_falling_pair_is_news_eq_instant_not_retarded() -> Res<()> {
+    // The pair's light delay (~2e4 ticks at a 2e4-root trailing gap) must exceed the moons' rebind
+    // interval (h = T/2^step_log2 ~ 6.1e3): news bites only then.
+    let step_log2 = 22;
+    let mk = |gravity: Gravity| -> Res<(Universe, [usize; 2])> {
+        let cfg = Config { step_log2, gravity, ..Config::default() };
+        let (mut u, _home, doll) = home_system(cfg)?;
+        let mut moons = [0usize; 2];
+        for (k, (angle, phase)) in [(0u32, 0u32), (0u32, 0x147A_E14A)].into_iter().enumerate() {
+            let m = u.add_body(
+                Kind::Moon,
+                OrbitSpec {
+                    doll,
+                    periapsis: Scalar::raw(20_000, 18)?,
+                    e_q48: (1u64 << 48) / 2,
+                    clockwise: false,
+                    angle,
+                    phase,
+                },
+                Scalar::raw(1_176, 8)?,
+            )?;
+            give_mass(&mut u, m, -24, -6)?;
+            moons[k] = m;
+        }
+        u.threads = 1;
+        u.start()?;
+        Ok((u, moons))
+    };
+    let mut modes: Vec<(Gravity, Universe, [usize; 2])> = [
+        (Gravity::News, mk(Gravity::News)?.0, mk(Gravity::News)?.1),
+        (Gravity::Instant, mk(Gravity::Instant)?.0, mk(Gravity::Instant)?.1),
+        (Gravity::Retarded, mk(Gravity::Retarded)?.0, mk(Gravity::Retarded)?.1),
+    ]
+    .into();
+    let state = |u: &Universe, moons: &[usize; 2], t: Tick| -> Res<[f64; 4]> {
+        let mut out = [0.0; 4];
+        for (k, &m) in moons.iter().enumerate() {
+            let (x, _) = u.rec(m).b.cartesian(t)?;
+            out[2 * k] = to_f64(x[0]);
+            out[2 * k + 1] = to_f64(x[1]);
+        }
+        Ok(out)
+    };
+    let end = 20_000_000_000; // ~0.8 radial periods of a = 4e4 root units
+    let stride = 500_000_000;
+    let mut samples: Vec<(Tick, [f64; 4], [f64; 4], [f64; 4])> = Vec::new();
+    let mut t = 0;
+    while t < end {
+        t += stride;
+        for (_, u, _) in modes.iter_mut() {
+            u.settle(t);
+            // The run is headless: forget the history the cones here can no longer need (the
+            // frame loop's own rule; without it the version ring grows without bound).
+            u.prune();
+        }
+        let mut s: Vec<[f64; 4]> = Vec::new();
+        for (_, u, m) in modes.iter() {
+            s.push(state(u, m, t)?);
+        }
+        samples.push((t, s[0], s[1], s[2]));
+    }
+    let dist = |a: &[f64; 4], b: &[f64; 4]| ((a[0] - b[0]).powi(2) + (a[1] - b[1]).powi(2)).sqrt();
+    let mut worst_pair = 0.0f64;
+    let mut sep_min = f64::MAX;
+    let mut worst_ret = 0.0f64;
+    let mut sep_now = 0.0f64;
+    for &(_t, n, i, r) in &samples {
+        let sep_n = ((n[0] - n[2]).powi(2) + (n[1] - n[3]).powi(2)).sqrt();
+        sep_min = sep_min.min(sep_n);
+        sep_now = sep_n;
+        worst_pair = worst_pair.max(dist(&n, &i) / sep_n);
+        worst_ret = worst_ret.max(dist(&n, &r) / sep_n);
+    }
+    println!(
+        "pair: separation now {:.0} (min {:.0}) Home units; worst relative News-vs-Instant {:.3e}, Retarded-vs-News {:.3e}",
+        sep_now, sep_min, worst_pair, worst_ret
+    );
+    assert!(worst_pair <= 1e-6, "News ≡ Instant for the freely falling pair: {worst_pair:.3e}");
+    assert!(worst_ret >= 10.0 * worst_pair, "Retarded drifts the pair an order further: {worst_ret:.3e} vs {worst_pair:.3e}");
+    Ok(())
+}
+
+/// The lab's result type, as the crate spells it.
+type Res<T> = Result<T, emergent_universe::num::Error>;
