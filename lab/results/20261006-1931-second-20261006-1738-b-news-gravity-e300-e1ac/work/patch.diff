+//! Gravity at c in the plane's kicks: **news, kept by a cursor** (docs/law.md, "Gravity travels
+//! at c"; the Opus math memo R5; the lab's `q-gravity-at-c` and `q-gravity-cursor`).
+//!
+//! A kick does not read its sources where they are now: it reads each source **as the kicking
+//! body's past light cone last saw it** — the newest *version* of the source (a binding: every
+//! rebinding, from a kick, a burn or a handoff, is a change of the source's motion) whose
+//! binding event lies inside the body's past light cone — and then evaluates that version's
+//! tube **at the kick's tick**. In free fall the tube places the source where it is now (the
+//! aberration cancels; measured: the lab's news twins agree with instantaneous gravity to
+//! 10⁻⁷ for a free-falling source), so quiet sources cost no behaviour at all; a *change* of
+//! the source's motion (a thrust, a kick, a contact) reaches the body only when its light cone
+//! does. What travels is the generator, not the position.
+//!
+//! The cone is an integer test, `(t − t_k)² ≥ |x − x_k|²` (c = 1: one root length unit is a tick
+//! of light), and it never moves backward along a timelike worldline, so one **cursor** per
+//! (body, source) advances it: the usual kick is one test against the next undelivered version,
+//! cached — the store's own version chain (retired segments plus the current binding, kept for
+//! the view's past-light-cone gathers) *is* the version ring; no new history is stored. A frozen
+//! single version is unstable (the lab's Laplace control: mutual L3), so every rebinding is a
+//! version; the ring a light cone still sees is a light time of cadence — one or two versions
+//! in a star system at the real c.
+//!
+//! The controls (negative, like the judge's planted laws; the shipped default is [`Gravity::News`]):
+//! [`Gravity::Instant`] is yesterday's law — the source read at the kick's tick off its current
+//! binding, cone ignored — and it *reacts before the light cone*, which is the causality failure
+//! this change removes. [`Gravity::Retarded`] pulls toward where the source **was** (the selected
+//! version read at the retarded tick): Laplace's naive retardation, which spirals binaries apart —
+//! the wrong representation, kept so the test can show it.
+use crate::bind::Binding;
+use crate::body::{Cursor, Pending};
+use crate::ctx::Ctx;
+use crate::force::Secondary;
+use crate::num::{Error, Res, Tick};
+use crate::world::pow2;
+use emergent_space::orbit::Scalar;
+
+/// How a kick reads its sources (docs/law.md, "Gravity travels at c"). The law is [`News`];
+/// the other two are the judge's and the tests' controls.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum Gravity {
+    /// The source's tube as the kicker's past light cone last saw it, evaluated now.
+    #[default]
+    News,
+    /// The source's current binding at the kick's tick: yesterday's acausal read.
+    Instant,
+    /// The same version read at the retarded tick: Laplace's spiral (the control that must fail).
+    Retarded,
+}
+
+/// Has the version emitted at `t_k` from `x_k` (root units at exponent `ek`) reached a body at
+/// `(t, x)` (root units at exponent `ex`)? `(t − t_k)² ≥ |x − x_k|²` in exact integers: c = 1,
+/// a tick of light is one root unit, so the comparison runs at a fixed quantum of `2^-22` root
+/// units — below a thousandth of a tick of light and above any word's need for range — decided
+/// the same bits on every machine. (`dt` beyond `2^41` ticks is longer than any run: there the
+/// whole unit is the quantum, which the distance in the system cannot approach.)
+pub const CONE_LOG2: i32 = -22;
+
+pub fn arrived(t: Tick, t_k: Tick, x: (&[i64; 2], i32), xk: (&[i64; 2], i32)) -> bool {
+    if t < t_k {
+        return false;
+    }
+    let dt = (t - t_k) as i128;
+    let long = dt >= 1i128 << 41;
+    let q = if long { 0 } else { CONE_LOG2 };
+    // Each word at the quantum: lifted left where the binding is coarser (exact), floored right
+    // where it is finer (the loss is a fraction of the quantum, by construction below a tick).
+    let word = |w: i64, e: i32| -> i128 {
+        if e >= q { (w as i128) << (e - q) } else { (w as i128) >> (q - e) }
+    };
+    let dx = word(x.0[0], x.1) - word(xk.0[0], xk.1);
+    let dy = word(x.0[1], x.1) - word(xk.0[1], xk.1);
+    let side = |d: i128| -> Option<u128> {
+        let a = d.unsigned_abs();
+        (a < 1u128 << 63).then(|| a * a)
+    };
+    // A component beyond 2^63 quanta is farther than any delay this side of `long` certifies.
+    let (Some(dx2), Some(dy2)) = (side(dx), side(dy)) else { return long };
+    let dtq = if long { dt } else { dt << (-CONE_LOG2) };
+    dtq as u128 * dtq as u128 >= dx2 + dy2
+}
+
+/// The exponent of a binding's position words in root units (a tick of light): its own length
+/// exponent, relabelled by the doll's (a doll unit is `2^-shift` root units).
+fn root_exp(ctx: &Ctx, b: &Binding) -> i32 {
+    b.units.0 as i32 - ctx.dolls[b.doll as usize].shift as i32
+}
+
+/// Source `j` as body `i`'s kick at `(t, x)` (root units) reads it, advancing `cur`.
+fn secondary(
+    ctx: &Ctx,
+    j: usize,
+    t: Tick,
+    x: (&[i64; 2], i32),
+    cur: &mut Cursor,
+    mode: Gravity,
+) -> Res<Secondary> {
+    let info = ctx.info[j];
+    let read = |b: &Binding, at: Tick| -> Res<Secondary> {
+        let (pos, vel) = b.cartesian(at)?;
+        Ok(Secondary { gm: info.gm, pos, vel, edge: info.soi })
+    };
+    if mode == Gravity::Instant {
+        let b = ctx.bodies.binding_at(j, t).ok_or(Error::Refused("history pruned"))?;
+        return read(&b, t);
+    }
+    let store = ctx.bodies;
+    // Advance the cursor: one integer test per undelivered version, the next one cached, so the
+    // steady state (no news in flight) is a single comparison. `next_news` walks the version
+    // chain (retired segments, then the current binding); if history the cursor names was pruned,
+    // the walk simply resumes from the oldest remembered version — an older, still-causal read.
+    loop {
+        if cur.pending.is_some_and(|p| p.future && p.t <= t) {
+            // A version the queue had not committed last time is now in play: read where it was emitted.
+            cur.pending = None;
+        }
+        if cur.pending.is_none() {
+            let Some(t_k) = store.next_news(j, cur.seen) else { break };
+            if t_k > t {
+                // Emitted after this kick, as far as the queue's order can tell: not a candidate.
+                cur.pending = Some(Pending { t: t_k, x: [0; 2], exp: 0, future: true });
+                break;
+            }
+            let b = store.binding_at(j, t_k).ok_or(Error::Refused("history pruned"))?;
+            let st = b.readout(t_k)?;
+            cur.pending = Some(Pending { t: t_k, x: st.position, exp: root_exp(ctx, &b), future: false });
+        }
+        let p = cur.pending.expect("set above");
+        if p.future || !arrived(t, p.t, x, (&p.x, p.exp)) {
+            break;
+        }
+        cur.seen = p.t;
+        cur.pending = None;
+    }
+    // The version the cone has delivered: the last one bound at or before `seen`, falling back to
+    // the oldest remembered (a young, distant source: its birth version is all the cone holds)
+    // and, only if even that was pruned away, to the current binding (yesterday's read).
+    let oldest = store.next_news(j, Tick::MIN);
+    let at = if cur.seen == Tick::MIN { oldest } else { Some(cur.seen) };
+    let b = at
+        .and_then(|at| store.binding_at(j, at))
+        .or_else(|| store.binding_at(j, t))
+        .ok_or(Error::Refused("history pruned"))?;
+    match mode {
+        Gravity::News => read(&b, t),
+        Gravity::Retarded => {
+            // Where the source was when its light left: a fixed point on the delivered version's
+            // own path (ticks and root units are the same quantity, c = 1). Three floor iterations
+            // from the emission — the control, not the law.
+            let shift = pow2(-ctx.dolls[b.doll as usize].shift as i32);
+            let xi = [Scalar::raw(x.0[0] as i128, x.1)?, Scalar::raw(x.0[1] as i128, x.1)?];
+            let mut t_r = cur.seen.max(b.event_time);
+            for _ in 0..3 {
+                let (xj, _) = b.cartesian(t_r)?;
+                let d = crate::num::norm2(crate::num::sub2(
+                    xi,
+                    [xj[0].mul(shift)?, xj[1].mul(shift)?],
+                )?)?;
+                let whole = i64::try_from(d.max(Scalar::ZERO).fixed(0)?).unwrap_or(0);
+                t_r = (t - whole).max(b.event_time);
+            }
+            read(&b, t_r)
+        }
+        Gravity::Instant => unreachable!("handled above"),
+    }
+}
+
+/// The secondaries of doll `d` at `t` for body `i` (excluded), each read as `i`'s past light cone
+/// last saw it, with `i`'s state `st` (in `d`'s units) the cone is taken from. `cursors` is the
+/// body's per-source news state, one entry per source of the dolls it has lived in.
+pub fn secondaries(
+    ctx: &Ctx,
+    d: u16,
+    t: Tick,
+    i: usize,
+    st: &emergent_space::binding::IntegerState,
+    cursors: &mut Vec<Cursor>,
+    mode: Gravity,
+) -> Res<Vec<Secondary>> {
+    let x = (st.position, st.length_exponent as i32 - ctx.dolls[d as usize].shift as i32);
+    let mut out = Vec::new();
+    for &j in &ctx.sources[d as usize] {
+        if j == i {
+            continue;
+        }
+        let slot = cursors.partition_point(|c| c.source < j);
+        if cursors.get(slot).map_or(true, |c| c.source != j) {
+            cursors.insert(slot, Cursor::new(j));
+        }
+        out.push(secondary(ctx, j, t, (&x.0, x.1), &mut cursors[slot], mode)?);
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The cone's boundary in integers: an exact lightlike tie counts as arrived, one tick
+    /// short does not, the past never arrives before `t_k`, and a sub-tick distance (a quarter
+    /// of a tick) is decided exactly at the quantum.
+    #[test]
+    fn the_light_cone_is_exact_integers() {
+        let x = (&[100i64, 0], 0i32);
+        assert!(arrived(10, 0, x, (&[90, 0], 0)));  // exact tie: dt = 10, d = 10
+        assert!(!arrived(9, 0, x, (&[90, 0], 0)));  // one tick short
+        assert!(!arrived(10, 11, x, (&[90, 0], 0))); // not emitted yet
+        assert!(arrived(5, 0, x, (&[103, 4], 0)));  // 3-4-5: 25 = 9 + 16
+        assert!(!arrived(4, 0, x, (&[103, 4], 0)));
+        // A distance of 1.25 ticks of light, words at 2^-3: arrives at the second tick, not the first.
+        assert!(arrived(2, 0, (&[100, 0], -3), (&[90, 0], -3)));
+        assert!(!arrived(1, 0, (&[100, 0], -3), (&[90, 0], -3)));
+    }
+}
+
