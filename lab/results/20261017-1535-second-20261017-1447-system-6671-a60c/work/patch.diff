diff --git a/crates/universe/src/memo.rs b/crates/universe/src/memo.rs
new file mode 100644
index 00000000..e9cf79b0
--- /dev/null
+++ b/crates/universe/src/memo.rs
@@ -0,0 +1,120 @@
+//! An opt-in memo of `Ctx::state_of`'s Ok results, keyed `(body, tick)`, cleared at each
+//! `Universe::advance` (so it never survives a prune, and is bounded by one frame's distinct
+//! keys, not the flight's). The census (census.rs, run 20261017-1447) measured the read stream
+//! to be 44–78% exact `(j,t)` repetition with zero bit-conflicts over ~2.1M reads, so the
+//! repeated evaluations return literally the same bits; this flies that measurement. Refusals
+//! are never cached (`Err` and a missing binding both fall through to recomputation), so a
+//! memo can only serve a value that recomputation just produced at the same `(j,t)`.
+//! `ES_MEMO=1` enables; `ES_MEMO_STATS=1` prints hits/misses at exit.
+use std::cell::RefCell;
+use crate::num::{Tick, V2};
+
+type Val = (V2, V2);
+/// (hits, misses, clears, max live keys)
+type Stats = (u64, u64, u64, usize);
+
+thread_local! {
+    static MAP: RefCell<std::collections::HashMap<(u32, i64), Val>> =
+        RefCell::new(std::collections::HashMap::new());
+    static STATS: RefCell<Stats> = const { RefCell::new((0, 0, 0, 0)) };
+}
+
+/// Enabled by `ES_MEMO`; read once so the off path pays one load.
+pub fn on() -> bool {
+    static E: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var("ES_MEMO").is_ok_and(|v| !v.is_empty() && v != "0"));
+    *E
+}
+
+#[inline]
+pub fn get(j: usize, t: Tick) -> Option<Val> {
+    MAP.with(|m| m.borrow().get(&(j as u32, t)).copied())
+}
+
+// ---- an opt-in timer for `state_of`'s two paths (ES_STATEOF_T=1): attribution only ----
+// The clean timing arms run without it; this exists to price the read term itself.
+
+fn timing() -> bool {
+    static E: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var("ES_STATEOF_T").is_ok_and(|v| !v.is_empty() && v != "0"));
+    *E
+}
+
+thread_local! {
+    static TSTATE: RefCell<(u64, u64, u64, u64)> = const { RefCell::new((0, 0, 0, 0)) }; // hit_ns, hits, miss_ns, misses
+}
+
+pub struct Tic(Option<std::time::Instant>);
+
+#[inline]
+pub fn tic() -> Tic {
+    Tic(if timing() { Some(std::time::Instant::now()) } else { None })
+}
+
+#[inline]
+pub fn toc(t: Tic, hit: bool) {
+    if let Some(i) = t.0 {
+        let ns = i.elapsed().as_nanos() as u64;
+        TSTATE.with(|s| {
+            let mut s = s.borrow_mut();
+            if hit { s.0 += ns; s.1 += 1 } else { s.2 += ns; s.3 += 1 }
+        });
+    }
+}
+
+/// Print the read term's own wall: ns and calls on the hit and miss paths.
+pub fn report_timing() {
+    if !timing() {
+        return;
+    }
+    let (hns, h, mns, m) = TSTATE.with(|s| *s.borrow());
+    println!(
+        "stateof_t: hit_ns {hns} hits {h} ({:.0} ns/call) miss_ns {mns} misses {m} ({:.0} ns/call)",
+        if h > 0 { hns / h } else { 0 },
+        if m > 0 { mns / m } else { 0 }
+    );
+}
+
+#[inline]
+pub fn put(j: usize, t: Tick, v: Val) {
+    MAP.with(|m| m.borrow_mut().insert((j as u32, t), v));
+}
+
+#[inline]
+pub fn count(hit: bool) {
+    STATS.with(|s| {
+        let mut s = s.borrow_mut();
+        if hit { s.0 += 1 } else { s.1 += 1 }
+    });
+}
+
+/// One `advance` begins: drop the memo and keep the high-water mark of live keys.
+pub fn clear() {
+    if !on() {
+        return;
+    }
+    let live = MAP.with(|m| {
+        let mut m = m.borrow_mut();
+        let n = m.len();
+        m.clear();
+        n
+    });
+    STATS.with(|s| {
+        let mut s = s.borrow_mut();
+        s.2 += 1;
+        s.3 = s.3.max(live);
+    });
+}
+
+/// Print the flight's totals: hits, misses, hit rate, clears, the largest live key set.
+pub fn report() {
+    if !on() || !std::env::var("ES_MEMO_STATS").is_ok_and(|v| !v.is_empty()) {
+        return;
+    }
+    let (hits, misses, clears, max_live) = STATS.with(|s| *s.borrow());
+    let live = MAP.with(|m| m.borrow().len());
+    println!(
+        "memo: hits {hits} misses {misses} hit_frac {:.4} clears {clears} max_live_keys {max_live} live_now {live}",
+        hits as f64 / (hits + misses).max(1) as f64
+    );
+}
diff --git a/crates/universe/src/universe.rs b/crates/universe/src/universe.rs
index fc5be609..852b363d 100644
--- a/crates/universe/src/universe.rs
+++ b/crates/universe/src/universe.rs
@@ -982,6 +982,8 @@ impl Universe {
 
     /// Spend `budget` resolving items with a tick up to `target`, in causal-deadline order.
     pub fn advance(&mut self, target: Tick, budget: Budget) -> Advanced {
+        crate::census::pass();
+        crate::memo::clear();
         self.target = target;
         self.rekey();
         let start = self.resolved;
