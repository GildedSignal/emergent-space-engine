+/// Whether the re-anchored jet renews rebinding kicks instead of rebuilding their compiled
+/// cycle (docs/law.md, "the jet"): `ESE_JET` in the environment, read once. Off: the shipped
+/// path, untouched.
+pub fn jet_enabled() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var_os("ESE_JET").is_some_and(|v| v != "0"));
+    *ON
+}
+
+/// Jet counters for measurement: renewals (increments) and full compiles (`bind` calls).
+pub mod jet_stats {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static RENEWALS: AtomicU64 = AtomicU64::new(0);
+    static COMPILES: AtomicU64 = AtomicU64::new(0);
+    pub fn renewal() {
+        RENEWALS.fetch_add(1, Ordering::Relaxed);
+    }
+    pub fn compile() {
+        COMPILES.fetch_add(1, Ordering::Relaxed);
+    }
+    pub fn snapshot() -> (u64, u64) {
+        (RENEWALS.load(Ordering::Relaxed), COMPILES.load(Ordering::Relaxed))
+    }
+}
+
+/// The re-anchor rule's offset bound: the placement's accumulated residual, in word quanta,
+/// past which the cycle is recompiled exactly. The jet's error is C·offset² under the law's
+/// 10⁻⁶ floor with C ≈ 2 (lab red-team 20261006-0346-redteam-df81), so the offset re-anchors
+/// at √(floor/C) ≈ 7×10⁻⁴ of the word's scale: 2⁻¹¹, dyadic and conservative.
+const JET_ANCHOR_QUANTA: i128 = 1 << 48;
+
+/// The jet's binding: renew `old`'s compiled cycle for the exact state `exact` at `t` without
+/// refitting or recompiling — the entry (and its derivative tables) is kept, the tube is
+/// re-placed through the cycle's own radius cut, and the turn+residual carry what the placement
+/// discards, so the readout at the event is the bound state, bit for bit. `None` when the state
+/// does not place (a passage, a radius off the cycle, a word overflow) or the accumulated offset
+/// has crossed the re-anchor rule: the caller compiles exactly, as before.
+pub fn bind_jet(exact: IntegerState, t: Tick, clock_exp: i16, unit: Unit, old: &Binding) -> Option<Bound> {
+    if !jet_enabled() {
+        return None;
+    }
+    if !matches!(old.entry.trajectory, Trajectory::Cycle(_)) || old.entry.unit != unit {
+        return None;
+    }
+    let st = in_tube_units(exact, unit).ok()?;
+    let ev = unit.to_tube(time_of(t, clock_exp).ok()?).ok()?;
+    let fit = Rebinding::on_trajectory(&old.entry.trajectory, old.entry.clockwise, st, ev).ok()?;
+    let peri = i64::try_from(unit.to_doll(fit.periapsis_time).ok()?.fixed(-(clock_exp as i32)).ok()?).ok()?;
+    let tube = Tube::new(0, fit.periapsis_angle, peri);
+    let entry = Arc::clone(&old.entry);
+    let units = (exact.length_exponent, exact.velocity_exponent);
+    let (decoded, orbit) = decode(&entry, &tube, clock_exp, units, t).ok()?;
+    // The turn the 32-bit angle could not hold, as `bind_in` takes it.
+    let q = |a: [i64; 2]| -> Res<V2> { Ok([Scalar::raw(a[0] as i128, 0)?, Scalar::raw(a[1] as i128, 0)?]) };
+    let (dp, ep) = (q(decoded.position).ok()?, q(exact.position).ok()?);
+    let dot = dot2(dp, ep).ok()?;
+    let turn = if dot.is_positive() { Turn::of_tangent(cross2(dp, ep).ok()?.div(dot).ok()?).ok()? } else { Turn::NONE };
+    let (tp, tv) = (turn.apply(decoded.position).ok()?, turn.apply(decoded.velocity).ok()?);
+    let residual = Residual {
+        position: [exact.position[0] as i128 - tp[0], exact.position[1] as i128 - tp[1]],
+        velocity: [exact.velocity[0] as i128 - tv[0], exact.velocity[1] as i128 - tv[1]],
+    };
+    // Re-anchor: the offset the placement now carries crossing the floor rule recompiles exactly.
+    if residual.position.iter().chain(residual.velocity.iter()).any(|&c| c.abs() > JET_ANCHOR_QUANTA) {
+        return None;
+    }
+    jet_stats::renewal();
+    Some(Bound { units, entry, tube, residual, turn, orbit })
+}
