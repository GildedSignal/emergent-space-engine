@@ -0,0 +1,73 @@
+//! The live loop's decision log is canonical (lab runs 20261008-0615, 20261008-0743, and
+//! 20261013-1249's port of the fix to the current tree): the same physical key timeline writes
+//! the same ticks and the same history whatever the frame rate, the budget (load) or the thread
+//! count. AGENTS.md Truth: "Canonical outcomes are exact and independent of cache, partition,
+//! observation, schedule and hardware."
+//!
+//! The hole this pins shut: `xtask`'s `session.rs::step` used to log a key change at the frame's
+//! *presented* tick, and the presented tick is what the budget left behind — load and frame rate
+//! rewrote canonical history (20261013-1249: four digests for one key timeline, contacts 6 vs 54
+//! under load at a 756M-tick cut). The fix logs on the frame's integrated `sched` timeline,
+//! snapped up to the decision quantum.
+use emergent_universe::fleet::Order;
+use emergent_universe::num::Tick;
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::universe::{Budget, Universe};
+use emergent_universe::Config;
+
+/// One flight of the shipped loop's shape: a fixed key timeline at wall moments, every change
+/// logged through [`Universe::input_frame`], frames at `fps`, optionally starved (a budget that
+/// bites: the load-only form, deterministic in `events`).
+fn play(seed: u64, fps: f64, starve: bool, rtf: f64, cut: Tick) -> (String, Vec<Tick>) {
+    let mut u: Universe = plane(Config::default(), seed, Order::Sparse, 1, 48).expect("scene").u;
+    let changes = [0.5f64, 1.7, 3.2, 4.1];
+    let keys_at = [word(1, 0), word(1, 1), word(0, 0), word(4, 0)];
+    let (mut held, mut wall_t, mut guard) = (None, 0.0f64, 0u64);
+    let dt = 1.0 / fps;
+    let budget = if starve { Budget::events(2) } else { Budget::unlimited() };
+    while u.now < cut && guard < 5_000_000 {
+        guard += 1;
+        for (i, w) in changes.iter().enumerate() {
+            if wall_t < *w && wall_t + dt >= *w && held != Some(keys_at[i]) {
+                u.input_frame(keys_at[i], rtf).expect("decision in the past");
+                held = Some(keys_at[i]);
+            }
+        }
+        wall_t += dt;
+        let f = u.frame_to(dt, rtf, budget, cut);
+        if f.events == 0 && f.presented >= cut {
+            break;
+        }
+    }
+    u.settle(cut);
+    (u.digest(), u.inputs.iter().map(|&(t, _)| t).collect())
+}
+
+/// Within one time factor the frame rate and the load (a budget that bites) cannot move the
+/// logged ticks or the digest at the cut.
+#[test]
+fn decision_log_survives_frame_rate_and_load() {
+    let cut = 84_000_000;
+    let paths = [("60 Hz", 60.0, false), ("30 Hz", 30.0, false), ("144 Hz", 144.0, false), ("60 Hz starved (load-only)", 60.0, true)];
+    let mut want: Option<(String, Vec<Tick>)> = None;
+    for &(name, fps, starve) in &paths {
+        let got = play(11, fps, starve, 100.0, cut);
+        match &want {
+            None => want = Some(got),
+            Some(w) => assert!(w == &got, "{name}: diverged\n  want {w:?}\n  got  {got:?}"),
+        }
+    }
+    let (_, ticks) = want.expect("paths");
+    // The logged ticks are decision-quantum multiples: the log's timing is the game's, not the wall's.
+    let q = Universe::decision_quantum(100.0);
+    assert!(ticks.iter().all(|&t| t % q == 0), "ticks {ticks:?} not multiples of the quantum {q}");
+}
+
+/// The shipped real-time pace holds the same property (a different quantum grid, so its own digest).
+#[test]
+fn decision_log_survives_load_at_real_time_pace() {
+    let cut = 84_000_000;
+    let (rich, starved) = (play(11, 60.0, false, 1.0, cut), play(11, 60.0, true, 1.0, cut));
+    assert_eq!(rich, starved, "same fps, different load: one history");
+}
