+//! The decision-log ruin probe (lab run 20261013-1249-taleb-a004).
+//!
+//! The shipped interactive loop (`xtask/src/universe/session.rs::step`) logs a key change at the
+//! frame's *presented* tick (`input(u.now, …)`), and the presented tick is what the budget left
+//! behind: load, machine speed and frame rate move it, so the same physical key timeline writes
+//! a different canonical history on a different machine (20261008-0615-taleb-40c0). This probe
+//! drives the plane through that exact loop shape, deterministically (`Budget::events` arms are
+//! the load surrogate; fixed fps), and prints one line per arm: the digest at a canonical cut,
+//! the logged decision ticks, the counters, and the player's state at the cut.
+//!
+//! `raw` is the shipped loop's two lines. `fix` is the a342 shape (`input_frame`: the decision
+//! tick snapped up to a 0.25 s wall decision quantum on the frame's integrated `sched` timeline),
+//! ported to this tree by this run's patch.
+//!
+//! Usage: ruin_probe <raw|fix> <seed> <fps> <starve 0|1> <cut ticks> <rtf> <members> [std|straddle]
+use emergent_universe::fleet::Order;
+use emergent_universe::num::{to_f64, Tick};
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::universe::{Budget, Universe};
+use emergent_universe::Config;
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let fix = a[1] == "fix";
+    let seed: u64 = a[2].parse().unwrap();
+    let fps: f64 = a[3].parse().unwrap();
+    let starve: bool = &a[4] == "1";
+    let cut: Tick = a[5].parse().unwrap();
+    let rtf: f64 = a[6].parse().unwrap();
+    let members: u64 = a[7].parse().unwrap();
+    // The player's key timeline, in wall seconds: a forward burn, a throttle-up, a release, a turn.
+    // `straddle` puts the first press just past a decision-quantum boundary (0.25 s + 10 ms).
+    let (changes, keys_at): (Vec<f64>, Vec<u8>) = if a.get(8).map(|s| s == "straddle").unwrap_or(false) {
+        (vec![0.26, 1.7, 3.2], vec![word(1, 0), word(1, 1), word(0, 0)])
+    } else {
+        (vec![0.5, 1.7, 3.2, 4.1], vec![word(1, 0), word(1, 1), word(0, 0), word(4, 0)])
+    };
+    let p = plane(Config::default(), seed, Order::Sparse, 1, members).expect("scene");
+    let player = p.player;
+    let mut u: Universe = p.u;
+    let budget = if starve { Budget::events(2) } else { Budget::unlimited() };
+    let dt = 1.0 / fps;
+    let (mut held, mut wall_t, mut guard, mut input_err, mut press_sched) = (None::<u8>, 0.0f64, 0u64, 0u64, Vec::new());
+    let t0 = std::time::Instant::now();
+    while u.now < cut && guard < 5_000_000 {
+        guard += 1;
+        for (i, w) in changes.iter().enumerate() {
+            if wall_t < *w && wall_t + dt >= *w && held != Some(keys_at[i]) {
+                if fix {
+                    if u.input_frame(keys_at[i], rtf).is_err() {
+                        input_err += 1;
+                    }
+                } else if u.input(u.now, keys_at[i]).is_err() {
+                    input_err += 1;
+                }
+                press_sched.push(if fix { u.sched } else { u.now });
+                held = Some(keys_at[i]);
+            }
+        }
+        wall_t += dt;
+        let f = u.frame_to(dt, rtf, budget, cut);
+        if f.events == 0 && f.presented >= cut {
+            break;
+        }
+    }
+    u.settle(cut);
+    let rec = u.rec(player);
+    let (pos, vel) = match rec.b.cartesian(cut) {
+        Ok((x, v)) => (
+            format!("{} {}", to_f64(x[0]), to_f64(x[1])),
+            format!("{} {}", to_f64(v[0]), to_f64(v[1])),
+        ),
+        Err(_) => ("unreadable".into(), "unreadable".into()),
+    };
+    let s = &u.stats;
+    println!(
+        "mode={} seed={} fps={} starve={} cut={} rtf={} members={} script={} digest={} now={} frames={} events={} kicks={} encounters={} contacts={} decisions={} refused={} lost={} input_err={} input_ticks={} press_at={} alive={} fault={:?} px_py={} v={} wall_ms={}",
+        if fix { "fix" } else { "raw" }, seed, fps, starve as u8, cut, rtf, members,
+        if a.get(8).map(|s| s == "straddle").unwrap_or(false) { "straddle" } else { "std" },
+        u.digest(), u.now, guard, s.events(), s.kicks, s.encounters, u.contacts, s.decisions, s.refused, s.lost, input_err,
+        u.inputs.iter().map(|&(t, _)| t.to_string()).collect::<Vec<_>>().join(","),
+        press_sched.iter().map(|&t| t.to_string()).collect::<Vec<_>>().join(","),
+        rec.alive, rec.fault, pos, vel, t0.elapsed().as_millis()
+    );
+}
