+    /// The decision quantum, in wall seconds: the finest timing the player's key changes are logged at.
+    /// Below deliberate human timing, above any frame cadence's sampling spread, so two frame rates
+    /// that first show the same change log the same tick unless the change straddles a grid boundary
+    /// (≤ this much wall time of ambiguity — the declared price of frame-rate-independent logs).
+    pub const DECISION_QUANTUM_SECONDS: f64 = 0.25;
+
+    /// [`Self::DECISION_QUANTUM_SECONDS`] of wall time through the time factor, in ticks.
+    pub fn decision_quantum(rtf: f64) -> Tick {
+        ((rtf * Self::DECISION_QUANTUM_SECONDS / crate::view::TICK_SECONDS) as Tick).max(1)
+    }
+
+    /// A key change the frame's keys first show, logged at its canonical tick: the scheduled game time
+    /// this frame presents (`frame_to`'s integrated `want` — a budget that bites delays work and never
+    /// moves it), quantized up to [`Self::decision_quantum`]. The tick is a function of the frame's
+    /// scheduled time alone, so load, budget, thread count and frame rate cannot move it (docs/law.md
+    /// "Ties": the tick written in the log is the game's, never the wall's); what a faster frame rate
+    /// samples finer than the quantum is intent the quantum declares indistinguishable. The decision
+    /// rides the calendar ([`Self::schedule`]): a lagging frame delays it, never moves or drops it.
+    pub fn input_frame(&mut self, keys: u8, rtf: f64) -> Res<()> {
+        let q = Self::decision_quantum(rtf);
+        let t = self.sched.saturating_add(q - 1) / q * q;
+        self.schedule(t, keys)
+    }
