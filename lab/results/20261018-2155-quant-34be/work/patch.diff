+//! Quant probe (20261018-2155-quant-34be): the price of the u64 port of `dioph::first_hit`.
+//!
+//! Encounters od 1 names the u64 `first_hit` port "unpriced" (all section values < 2⁶³).
+//! This example prices it on e87d-class belt arms: collects the exact (c0, d, pi, w) tuples
+//! `tier::arm_pair` feeds `first_hit`, checks the u64 port is bit-identical to the shipped
+//! u128 on every tuple, then times both on the same tuples, interleaved.
+//!
+//! Run: cargo run --release -p emergent-encounters --example quant_u64
+
+use emergent_encounters::belt::{make_belt, Spec};
+use emergent_encounters::kepler::TICKS;
+use emergent_encounters::tier::arm_sections;
+use std::time::Instant;
+
+/// The port: `dioph::first_hit`/`min_k` verbatim, u128 -> u64.
+fn first_hit_u64(c: u64, d: u64, m: u64, lo: u64, hi: u64, steps: &mut u64) -> Option<u64> {
+    debug_assert!(lo <= hi && hi < m && c < m);
+    if lo <= c && c <= hi {
+        return Some(0);
+    }
+    let l2 = (lo + m - c) % m;
+    let h2 = (hi + m - c) % m;
+    min_k_u64(d % m, m, l2, h2, steps)
+}
+
+fn min_k_u64(a: u64, m: u64, l: u64, r: u64, steps: &mut u64) -> Option<u64> {
+    *steps += 1;
+    if l == 0 {
+        return Some(0);
+    }
+    if a == 0 {
+        return None;
+    }
+    let k = (l + a - 1) / a;
+    if a * k <= r {
+        return Some(k);
+    }
+    let y = min_k_u64(m % a, a, a - r % a, a - l % a, steps)?;
+    Some((l + m * y + a - 1) / a)
+}
+
+/// The sound port: recursion state in u64 (all values < 2^63), but the compose multiply
+fn first_hit_u64_sound(c: u64, d: u64, m: u64, lo: u64, hi: u64, steps: &mut u64) -> Option<u64> {
+    debug_assert!(lo <= hi && hi < m && c < m);
+    if lo <= c && c <= hi {
+        return Some(0);
+    }
+    let l2 = (lo + m - c) % m;
+    let h2 = (hi + m - c) % m;
+    min_k_u64s(d % m, m, l2, h2, steps)
+}
+
+fn min_k_u64s(a: u64, m: u64, l: u64, r: u64, steps: &mut u64) -> Option<u64> {
+    *steps += 1;
+    if l == 0 {
+        return Some(0);
+    }
+    if a == 0 {
+        return None;
+    }
+    let k = (l + a - 1) / a;
+    if a * k <= r {
+        return Some(k);
+    }
+    let y = min_k_u64s(m % a, a, a - r % a, a - l % a, steps)?;
+    Some(((m as u128 * y as u128 + l as u128 + a as u128 - 1) / a as u128) as u64)
+}
+
+
+#[derive(Clone, Copy)]
+struct Tup {
+    c: u64,
+    d: u64,
+    m: u64,
+    w: u64,
+}
+
+fn collect(name: &str, window: f64, seed: u64) -> (Vec<Tup>, String) {
+    let spec = Spec {
+        name: name.to_string(),
+        n: 2_000,
+        sigma_e: 0.07,
+        rho: 3.34e-6,
+        a_lo: 3.0 - window / 2.0,
+        a_hi: 3.0 + window / 2.0,
+        keys: 0,
+        seed,
+        orbits: 100.0,
+    };
+    let b = make_belt(&spec);
+    let (t0, t1) = (0.0, 2.0 * std::f64::consts::PI * 100.0);
+    let mut tups = Vec::new();
+    let mut pairs = 0u64;
+    'outer: for i in 0..b.len() {
+        for j in (i + 1)..b.len() {
+            pairs += 1;
+            for sec in arm_sections(&b[i], &b[j], spec.rho, 1.1) {
+                let ti = sec.ti as i128;
+                let tj = sec.tj as i128;
+                let pi = b[i].period as i128;
+                let pj = b[j].period as i128;
+                let ext = pi + 2 * pj;
+                let t0t = (t0 * TICKS) as i128;
+                let t1t = (t1 * TICKS) as i128;
+                let base = tj + (t0t - ext - tj).div_euclid(pj) * pj;
+                let _lmax = (t1t + ext - base).div_euclid(pj);
+                let w1 = sec.w1 as i128;
+                let w = (w1 + sec.w2 as i128).clamp(0, pi - 1);
+                let c0 = (ti - base + w1).rem_euclid(pi);
+                let d = (pi - pj.rem_euclid(pi)).rem_euclid(pi);
+                tups.push(Tup {
+                    c: c0 as u64,
+                    d: d as u64,
+                    m: pi as u64,
+                    w: w as u64,
+                });
+                if tups.len() >= 100_000 {
+                    break 'outer;
+                }
+            }
+            if pairs >= 60_000 {
+                break 'outer;
+            }
+        }
+    }
+    let note = format!(
+        "name={} seed={} pairs={} tuples={} sec/pair={:.3} max_m={} max_w={}",
+        name,
+        seed,
+        pairs,
+        tups.len(),
+        tups.len() as f64 / pairs as f64,
+        tups.iter().map(|t| t.m).max().unwrap_or(0),
+        tups.iter().map(|t| t.w).max().unwrap_or(0),
+    );
+    (tups, note)
+}
+
+fn pct(sorted: &[u64], p: f64) -> u64 {
+    sorted[((sorted.len() as f64 - 1.0) * p) as usize]
+}
+
+fn main() {
+    // Brute spot-check of the port on small random tuples (independent of the u128 equality).
+    let mut rng = emergent_encounters::belt::Rng(12345);
+    let mut brute_bad = 0u64;
+    for _ in 0..300 {
+        let m = (rng.next_u64() % 20_000 + 2) as u64;
+        let c = rng.next_u64() % m;
+        let d = rng.next_u64() % m;
+        let lo = rng.next_u64() % m;
+        let hi = lo + rng.next_u64() % (m - lo);
+        let brute = (0..m).map(|k| (c + d * k) % m).position(|s| lo <= s && s <= hi);
+        let mut st = 0u64;
+        let got = first_hit_u64(c, d, m, lo, hi, &mut st);
+        if got != brute.map(|x| x as u64) {
+            brute_bad += 1;
+        }
+    }
+    println!("brute_bad={}", brute_bad);
+
+    for (name, window, seed) in [
+        ("w1e-4", 1e-4, 20261018u64),
+        ("w1e-4", 1e-4, 777u64),
+        ("w1e-5", 1e-5, 20261018u64),
+        ("w1e-5", 1e-5, 777u64),
+    ] {
+        let (tups, note) = collect(name, window, seed);
+        println!("{}", note);
+
+        // Soundness census + identity control: u64 port vs shipped u128 on every tuple.
+        use emergent_encounters::dioph::first_hit;
+        let mut ge63 = 0u64;
+        let mut mism = 0u64;
+        let mut mism_sound = 0u64;
+        let mut steps128 = Vec::with_capacity(tups.len());
+        let mut hits = 0u64;
+        for t in &tups {
+            if t.c.max(t.d).max(t.m).max(t.w) >= (1u64 << 63) {
+                ge63 += 1;
+            }
+            let mut s1 = 0u64;
+            let a = first_hit(t.c as u128, t.d as u128, t.m as u128, 0, t.w as u128, &mut s1);
+            let mut s2 = 0u64;
+            let b = first_hit_u64(t.c, t.d, t.m, 0, t.w, &mut s2);
+            if a != b.map(|x| x as u128) || s1 != s2 {
+                mism += 1;
+            }
+            let mut s3 = 0u64;
+            let bs = first_hit_u64_sound(t.c, t.d, t.m, 0, t.w, &mut s3);
+            if a != bs.map(|x| x as u128) || s1 != s3 {
+                mism_sound += 1;
+            }
+            if a.is_some() {
+                hits += 1;
+            }
+            steps128.push(s1);
+        }
+        let mut sc = steps128.clone();
+        sc.sort_unstable();
+        println!(
+            "census ge2^63={} mism_naive={} mism_sound={} hits={}/{} steps p50={} p90={} p99={} max={}",
+            ge63,
+            mism,
+            mism_sound,
+            hits,
+            tups.len(),
+            pct(&sc, 0.50),
+            pct(&sc, 0.90),
+            pct(&sc, 0.99),
+            sc[sc.len() - 1],
+        );
+
+        // Interleaved A/B timing, medians of batch means.
+        let batches = 12u32;
+        let mut a_ns = Vec::new();
+        let mut b_ns = Vec::new();
+        let mut c_ns = Vec::new();
+        let mut sink64s = 0u64;
+        let mut sink128 = 0u128;
+        let mut sink64 = 0u64;
+        for _ in 0..4 {
+            for t in &tups {
+                let mut s = 0u64;
+                sink128 = sink128
+                    .wrapping_add(
+                        first_hit(t.c as u128, t.d as u128, t.m as u128, 0, t.w as u128, &mut s)
+                            .unwrap_or(1),
+                    )
+                    .wrapping_add(s as u128);
+                let mut s2 = 0u64;
+                sink64 = sink64
+                    .wrapping_add(first_hit_u64(t.c, t.d, t.m, 0, t.w, &mut s2).unwrap_or(1))
+                    .wrapping_add(s2);
+                let mut s3 = 0u64;
+                sink64s = sink64s
+                    .wrapping_add(first_hit_u64_sound(t.c, t.d, t.m, 0, t.w, &mut s3).unwrap_or(1))
+                    .wrapping_add(s3);
+            }
+        }
+        for bi in 0..batches * 3 {
+            match bi % 3 {
+                0 => {
+                    let t0 = Instant::now();
+                    for t in &tups {
+                        let mut s = 0u64;
+                        sink128 = sink128.wrapping_add(
+                            first_hit(t.c as u128, t.d as u128, t.m as u128, 0, t.w as u128, &mut s)
+                                .unwrap_or(1),
+                        );
+                    }
+                    a_ns.push(t0.elapsed().as_nanos() as u64);
+                }
+                1 => {
+                    let t0 = Instant::now();
+                    for t in &tups {
+                        let mut s = 0u64;
+                        sink64 = sink64
+                            .wrapping_add(first_hit_u64(t.c, t.d, t.m, 0, t.w, &mut s).unwrap_or(1));
+                    }
+                    b_ns.push(t0.elapsed().as_nanos() as u64);
+                }
+                _ => {
+                    let t0 = Instant::now();
+                    for t in &tups {
+                        let mut s = 0u64;
+                        sink64s = sink64s.wrapping_add(
+                            first_hit_u64_sound(t.c, t.d, t.m, 0, t.w, &mut s).unwrap_or(1),
+                        );
+                    }
+                    c_ns.push(t0.elapsed().as_nanos() as u64);
+                }
+            }
+        }
+        let per = |v: &[u64]| -> Vec<f64> { v.iter().map(|ns| *ns as f64 / tups.len() as f64).collect() };
+        let mut ap = per(&a_ns);
+        let mut bp = per(&b_ns);
+        let mut cp = per(&c_ns);
+        ap.sort_by(|x, y| x.partial_cmp(y).unwrap());
+        bp.sort_by(|x, y| x.partial_cmp(y).unwrap());
+        cp.sort_by(|x, y| x.partial_cmp(y).unwrap());
+        let p = |v: &[f64], q: f64| v[((v.len() as f64 - 1.0) * q) as usize];
+        println!(
+            "timing u128 p50={:.1} p99={:.1} | u64naive p50={:.1} | u64sound p50={:.1} p99={:.1} | win(sound) p50={:.2}x p99={:.2}x (ns/call, {} batches interleaved) sink={}{}{}",
+            p(&ap, 0.50),
+            p(&ap, 0.99),
+            p(&bp, 0.50),
+            p(&cp, 0.50),
+            p(&cp, 0.99),
+            p(&ap, 0.50) / p(&cp, 0.50),
+            p(&ap, 0.99) / p(&cp, 0.99),
+            batches,
+            sink128 % 7,
+            sink64s % 7,
+            sink64 % 7,
+        );
+    }
+}
