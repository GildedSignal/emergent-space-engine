+/// H_live, the live distinguishing information (docs/plane.md, "measured on the whole"; lab run
+/// 20261007-2057-spacex-de6a). An operational proposal: at the one funnel where a body's canonical
+/// record changes (`Universe::apply`), the integer deltas of the stored canonical words — tube key,
+/// periapsis angle (wrapping), periapsis time, the two sub-quantum velocity carries — are histogrammed
+/// per (event kind, body, field). A body's first event is a birth (the program's job, no delta); an
+/// event whose deltas are all zero was predictable from the body's own last state and stores nothing;
+/// otherwise the empirical conditional entropy of the deltas, given (kind, body), is the bits the event
+/// adds. Decisions (the player's words) are counted at `take`. Not counted: the fleet members' internal
+/// lattice carries (the dense order lives in the lattice crates) and the `ext` energy register.
+#[derive(Default)]
+pub struct HLive {
+    /// (kind, body, field) → delta → count. Field 1 (angle) is a wrapping delta.
+    hist: std::collections::HashMap<(u8, usize, u8), std::collections::HashMap<i64, u64>>,
+    events: std::collections::HashMap<(u8, usize), u64>,
+    /// Each body's last canonical words.
+    last: std::collections::HashMap<usize, [i64; 5]>,
+    zero: [u64; 6],
+    births: [u64; 6],
+    decisions: std::collections::HashMap<u8, u64>,
+    /// Bodies removed from the catalogue (a loss): their live distinctions go with them.
+    pub removed: u64,
+}
+
+/// One row of the H_live report: a kind of event.
+pub struct HLiveRow {
+    pub kind: &'static str,
+    pub events: u64,
+    pub births: u64,
+    pub zero_delta: u64,
+    /// Bits per event, averaged over bodies as Σ_bodies n_b · H(·|body) / Σ n_b.
+    pub bits_per_event: f64,
+    /// Per-field bits per event (key, angle, time, carry0, carry1).
+    pub field_bits: [f64; 5],
+}
+
+impl HLive {
+    pub(crate) fn note(&mut self, i: usize, kind: u8, tube: &Tube, carry: &[i64; 2]) {
+        let w = [
+            tube.key as i64,
+            tube.periapsis_angle as i64,
+            tube.periapsis_time.get() as i64,
+            carry[0],
+            carry[1],
+        ];
+        let Some(old) = self.last.get(&i) else {
+            self.last.insert(i, w);
+            self.births[kind as usize] += 1;
+            return;
+        };
+        let mut all_zero = true;
+        for (f, &o) in old.iter().enumerate() {
+            let d = if f == 1 { w[f].wrapping_sub(o) } else { w[f] - o };
+            if d != 0 {
+                all_zero = false;
+            }
+            *self.hist.entry((kind, i, f as u8)).or_default().entry(d).or_insert(0) += 1;
+        }
+        *self.events.entry((kind, i)).or_insert(0) += 1;
+        if all_zero {
+            self.zero[kind as usize] += 1;
+        }
+        self.last.insert(i, w);
+    }
+
+    pub(crate) fn decision(&mut self, keys: u8) {
+        *self.decisions.entry(keys).or_insert(0) += 1;
+    }
+
+    fn entropy(h: &std::collections::HashMap<i64, u64>, n: u64) -> f64 {
+        let mut e = 0.0f64;
+        for &c in h.values() {
+            let p = c as f64 / n as f64;
+            e -= p * p.log2();
+        }
+        e
+    }
+
+    /// The bits gained, per kind; bits per game-second is left to the caller, which knows the
+    /// game-seconds flown. Returns (rows, body events, body bits, decisions, decision bits).
+    pub fn summary(&self) -> (Vec<HLiveRow>, u64, f64, u64, f64) {
+        let names = ["kick", "open", "boundary", "handoff", "lost", "refused"];
+        let mut rows = Vec::new();
+        let mut total_bits = 0.0f64;
+        let mut total_events = 0u64;
+        for (k, &name) in names.iter().enumerate() {
+            let mut bits = 0.0f64;
+            let mut field = [0.0f64; 5];
+            let mut n = 0u64;
+            for ((ek, b), &c) in &self.events {
+                if *ek as usize != k {
+                    continue;
+                }
+                n += c;
+                for f in 0..5u8 {
+                    if let Some(h) = self.hist.get(&(*ek, *b, f)) {
+                        let e = Self::entropy(h, h.values().sum());
+                        bits += e * c as f64;
+                        field[f as usize] += e * c as f64;
+                    }
+                }
+            }
+            if n > 0 {
+                for f in 0..5 {
+                    field[f] /= n as f64;
+                }
+                rows.push(HLiveRow {
+                    kind: name,
+                    events: n,
+                    births: self.births[k],
+                    zero_delta: self.zero[k],
+                    bits_per_event: bits / n as f64,
+                    field_bits: field,
+                });
+            }
+            total_bits += bits;
+            total_events += n;
+        }
+        let dec_n: u64 = self.decisions.values().sum();
+        let dec_map: std::collections::HashMap<i64, u64> = self.decisions.iter().map(|(k, v)| (*k as i64, *v)).collect();
+        let dec_bits = if dec_n > 0 { Self::entropy(&dec_map, dec_n) * dec_n as f64 } else { 0.0 };
+        (rows, total_events, total_bits, dec_n, dec_bits)
+    }
+}
