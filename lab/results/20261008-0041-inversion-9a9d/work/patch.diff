+//! Third-party adjudication of brute-vs-truth disputes on the base phalanx (run 20261008-0041).
+
+use emergent_encounters::belt::Rng;
+use emergent_encounters::kepler::Body;
+use emergent_encounters::pairs::scan_minima;
+use emergent_encounters::truth::{truth_pair, TruthStats};
+use std::f64::consts::TAU;
+
+const RHO: f64 = 1e-4;
+
+fn rayleigh(rng: &mut Rng, s: f64, cap: f64) -> f64 {
+    let u = rng.f64();
+    (s * (-2.0 * (1.0 - u).ln()).sqrt()).min(cap)
+}
+
+fn fleet(nc: usize, a_hw: f64, sigma_e: f64, pom_half: f64, sig_lam: f64, seed: u64) -> Vec<Body> {
+    let mut rng = Rng(seed);
+    let pom0 = TAU * rng.f64();
+    let lam0 = TAU * rng.f64();
+    (0..nc)
+        .map(|_| {
+            let a = 1.0 + (2.0 * rng.f64() - 1.0) * a_hw;
+            let e = rayleigh(&mut rng, sigma_e, (4.0 * sigma_e).min(0.5));
+            let pom = pom0 + (2.0 * rng.f64() - 1.0) * pom_half;
+            let lam = if sig_lam <= 0.0 {
+                TAU * rng.f64()
+            } else {
+                let (u1, u2) = (rng.f64(), rng.f64());
+                lam0 + sig_lam * (-2.0 * (1e-12 + u1).ln()).sqrt() * (TAU * u2).cos()
+            };
+            Body::new(a, e, pom, lam)
+        })
+        .collect()
+}
+
+fn main() {
+    let fl = fleet(200, 1e-5, 0.001, 0.1, 0.01, 27);
+    // dense unbiased scan of every pair whose Kepler distance ever dips below 1.5 rho:
+    // recompute the brute's sub-rho set exactly, then settle each against scan_minima + truth.
+    let dt = 1e-5;
+    let steps = (TAU / dt) as usize;
+    let mut cand: Vec<(u32, u32, f64, f64)> = Vec::new(); // (i, j, dmin, t)
+    let mut s = 0usize;
+    while s < steps {
+        let t = s as f64 * dt;
+        for i in 0..fl.len() {
+            for j in (i + 1)..fl.len() {
+                let si = fl[i].state_at_mean(fl[i].mean_anomaly(t));
+                let sj = fl[j].state_at_mean(fl[j].mean_anomaly(t));
+                let d = (si[0] - sj[0]).hypot(si[1] - sj[1]);
+                match cand.iter_mut().find(|c| c.0 == i as u32 && c.1 == j as u32) {
+                    Some(c) => { if d < c.2 { c.2 = d; c.3 = t; } }
+                    None => { if d < 1.5 * RHO { cand.push((i as u32, j as u32, d, t)); } }
+                }
+            }
+        }
+        s += 40; // subsample 1/40: only to find candidates; scan_minima settles exactly
+    }
+    println!("{{\"candidates_1p5rho\":{}}}", cand.len());
+    for (i, j, d, t) in cand {
+        let (bi, bj) = (&fl[i as usize], &fl[j as usize]);
+        let mut out = Vec::new();
+        let mut ev = 0u64;
+        scan_minima(bi, bj, 0.0, TAU, 8000, RHO, true, &mut out, &mut ev);
+        let mut tout = Vec::new();
+        let mut ts = TruthStats::default();
+        truth_pair(bi, bj, RHO, 2.0 * TAU, &mut tout, &mut ts);
+        println!(
+            "{{\"pair\":[{},{}],\"brute_d\":{:.3e},\"brute_t\":{:.4},\"scan_sub_rho\":{},\"scan_best\":{:.3e},\"truth_2orbits_sub_rho\":{},\"truth_best\":{:.3e}}}",
+            i, j, d, t,
+            out.iter().map(|x| x.1).count(),
+            out.iter().map(|x| x.1).min_by(|a, b| a.total_cmp(b)).unwrap_or(f64::NAN),
+            tout.iter().map(|x| x.1).count(),
+            tout.iter().map(|x| x.1).min_by(|a, b| a.total_cmp(b)).unwrap_or(f64::NAN)
+        );
+    }
+}
diff --git a/crates/encounters/src/bin/invert.rs b/crates/encounters/src/bin/invert.rs
