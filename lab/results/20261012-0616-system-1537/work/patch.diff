+// The whole-system audit: does the engine pay per frame per *entity* (a tick), or per *event*?
+// Modes:
+//   tick_audit quiet <n> [frames]  — n quiet ships (4 AU circles, one planet as the secondary), advance
+//                                    with ~zero events; reports per-frame wall and events.
+//   tick_audit digest              — the plane scenario, three schedules (sparse threads 1, wave threads 4,
+//                                    starved budget), settled at one canonical cut; digests must be equal.
+use emergent_universe::body::Kind;
+use emergent_universe::scenario::{plane, AU, STAR_RADIUS};
+use emergent_universe::{Budget, Config, OrbitSpec, Universe};
+use emergent_space::orbit::Scalar;
+use std::time::Instant;
+
+fn s(v: i64) -> Scalar {
+    Scalar::integer(v)
+}
+
+fn quiet(n: usize, frames: usize) {
+    let mut u = Universe::new(s(STAR_RADIUS), Config::default());
+    u.threads = 1;
+    // One planet at 1 AU: the secondary every ship's kick reads. Its own kicks are ~1e11 ticks apart.
+    let planet = u
+        .add_body(
+            Kind::Planet,
+            OrbitSpec { doll: 0, periapsis: s(AU), e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+            Scalar::ZERO,
+        )
+        .unwrap();
+    u.add_doll("Planet", planet, -10, Scalar::raw(1_000, -10).unwrap()).unwrap();
+    // n quiet ships: circular 4 AU orbits, ~8-year periods, kicks ~8e11 ticks apart.
+    let mut t0 = Instant::now();
+    for k in 0..n {
+        let _ = u
+            .add_body(
+                Kind::Ship,
+                OrbitSpec {
+                    doll: 0,
+                    periapsis: s(4 * AU),
+                    e_q48: 0,
+                    clockwise: false,
+                    angle: (k as u32).wrapping_mul(2_654_435_761),
+                    phase: 0,
+                },
+                Scalar::raw(34, -10).unwrap(),
+            )
+            .unwrap();
+    }
+    let setup_us = t0.elapsed().as_secs_f64() * 1e6;
+    u.start().unwrap();
+    let queued = (0..u.n_bodies()).filter(|e| u.key_of(*e).is_some()).count();
+    // 1e8 ticks per frame: no item can fall due (the nearest is ~1e11 away).
+    let step: i64 = 100_000_000;
+    let mut events_total = 0u64;
+    let mut worst = 0f64;
+    let t0 = Instant::now();
+    for f in 0..frames {
+        let target = step * (f as i64 + 1);
+        let tf = Instant::now();
+        let a = u.advance(target, Budget::unlimited());
+        let dt = tf.elapsed().as_secs_f64() * 1e6;
+        events_total += a.events;
+        if f >= 3 {
+            worst = worst.max(dt);
+        }
+    }
+    let per_frame = t0.elapsed().as_secs_f64() * 1e6 / frames as f64;
+    println!(
+        "quiet n={n} frames={frames} bodies={} queued={} setup={setup_us:.0}us per_frame={per_frame:.2}us worst={worst:.2}us events={events_total} ns_per_body_per_frame={:.2}",
+        u.n_bodies(),
+        queued,
+        per_frame / n as f64 * 1000.0
+    );
+}
+
+fn digest_mode() {
+    let cut: i64 = 90_000_000_000;
+    // Schedule A: single thread, no budget.
+    let mut a = plane(Config::default(), 1, emergent_universe::fleet::Order::Sparse, 1, 8).unwrap();
+    a.u.settle(cut);
+    println!("digest A (threads 1, settle): {}", a.u.digest());
+    // Schedule B: four threads (the wave path), frames under a wall budget.
+    let mut b = plane(Config::default(), 1, emergent_universe::fleet::Order::Sparse, 4, 8).unwrap();
+    let mut t = 0i64;
+    while t < cut {
+        let want = 3_000_000_000i64.min(cut - t);
+        t += want;
+        let _ = b.u.frame_to(1.0, 100.0, Budget::wall(0.5), t);
+    }
+    b.u.settle(cut);
+    println!("digest B (threads 4, budgeted frames): {}", b.u.digest());
+    // Schedule C: starved budget (overflow + the deferred path), then catch up.
+    let mut c = plane(Config::default(), 1, emergent_universe::fleet::Order::Sparse, 1, 8).unwrap();
+    let mut t = 0i64;
+    while t < cut {
+        let want = 9_000_000_000i64.min(cut - t);
+        t += want;
+        let _ = c.u.frame_to(1.0, 300.0, Budget::events(3), t);
+    }
+    c.u.settle(cut);
+    println!("digest C (starved, overflow): {}", c.u.digest());
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    match args.get(1).map(|s| s.as_str()) {
+        Some("quiet") => {
+            let n: usize = args[2].parse().unwrap();
+            let frames: usize = args.get(3).map(|s| s.parse().unwrap()).unwrap_or(30);
+            quiet(n, frames);
+        }
+        Some("digest") => digest_mode(),
+        Some("restricted") => digest_restricted(),
+        _ => println!("usage: tick_audit quiet <n> [frames] | digest"),
+    }
+}
+
+fn digest_restricted() {
+    let cut: i64 = 30_000_000_000;
+    let ships: Vec<(i64, u32)> = (0..8i64).map(|k| (3_000_000 + k * 900_000, 0x1000_0000u32.wrapping_mul((k + 1) as u32))).collect();
+    let mut a = emergent_universe::scenario::restricted(1_000, 60_000_000, 400_000, &ships, 1).unwrap();
+    a.u.settle(cut);
+    println!("digest R (restricted, settle): {}", a.u.digest());
+    let mut b = emergent_universe::scenario::restricted(1_000, 60_000_000, 400_000, &ships, 1).unwrap();
+    let mut t = 0i64;
+    while t < cut {
+        t += 2_000_000_000i64.min(cut - t);
+        let _ = b.u.frame_to(1.0, 100.0, Budget::events(4), t);
+    }
+    b.u.settle(cut);
+    println!("digest R2 (restricted, starved frames): {}", b.u.digest());
+}
