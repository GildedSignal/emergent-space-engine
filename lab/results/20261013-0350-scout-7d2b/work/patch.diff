+/// Scout run 20261013-0350: division census and arm switch (measurement only).
+pub mod census {
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    static TOTAL: AtomicU64 = AtomicU64::new(0);
+    static W128: AtomicU64 = AtomicU64::new(0);
+    static LIBCALL: AtomicBool = AtomicBool::new(false);
+    static CENSUS: AtomicBool = AtomicBool::new(false);
+    thread_local! {
+        static SEEN: RefCell<HashMap<u64, u64>> = RefCell::new(HashMap::new());
+        static SEEN128: RefCell<HashMap<u128, u64>> = RefCell::new(HashMap::new());
+    }
+    pub fn configure(libcall: bool, census: bool) {
+        LIBCALL.store(libcall, Ordering::Relaxed);
+        CENSUS.store(census, Ordering::Relaxed);
+    }
+    pub fn reset() {
+        TOTAL.store(0, Ordering::Relaxed);
+        W128.store(0, Ordering::Relaxed);
+        SEEN.with(|s| s.borrow_mut().clear());
+        SEEN128.with(|s| s.borrow_mut().clear());
+    }
+    #[inline]
+    pub(crate) fn record(d: u64) {
+        TOTAL.fetch_add(1, Ordering::Relaxed);
+        if CENSUS.load(Ordering::Relaxed) {
+            SEEN.with(|s| {
+                *s.borrow_mut().entry(d).or_insert(0) += 1;
+            });
+        }
+    }
+    /// Census the raw u128/u128 `/` sites (the fast_quad family), scout-7d2b.
+    #[inline]
+    pub fn div128_census(n: u128, d: u128) -> u128 {
+        W128.fetch_add(1, Ordering::Relaxed);
+        if CENSUS.load(Ordering::Relaxed) {
+            SEEN128.with(|s| {
+                *s.borrow_mut().entry(d).or_insert(0) += 1;
+            });
+        }
+        n / d
+    }
+    pub fn take() -> (u64, usize, u64, usize) {
+        (
+            TOTAL.load(Ordering::Relaxed),
+            SEEN.with(|s| s.borrow().len()),
+            W128.load(Ordering::Relaxed),
+            SEEN128.with(|s| s.borrow().len()),
+        )
+    }
+    /// Top-k divisors by count, both widths, for the census report.
+    pub fn top(k: usize) -> (Vec<(u64, u64)>, Vec<(u128, u64)>) {
+        let mut a: Vec<(u64, u64)> = SEEN.with(|s| s.borrow().iter().map(|(d, c)| (*d, *c)).collect());
+        let mut b: Vec<(u128, u64)> = SEEN128.with(|s| s.borrow().iter().map(|(d, c)| (*d, *c)).collect());
+        a.sort_by(|x, y| y.1.cmp(&x.1));
+        b.sort_by(|x, y| y.1.cmp(&x.1));
+        a.truncate(k);
+        b.truncate(k);
+        (a, b)
+    }
+    #[inline]
+    pub(crate) fn arm_libcall() -> bool {
+        LIBCALL.load(Ordering::Relaxed)
+    }
+}
