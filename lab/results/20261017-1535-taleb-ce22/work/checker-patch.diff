+++ b/crates/universe/src/memo_oracle.rs
@@ -0,0 +1,176 @@
+//! Print-only staleness oracle for the proposed `(j, t)` state memo (read-stream page, direction 1:
+//! "a pure `(d, t)`-keyed cache ... is bit-identical by construction"). The oracle never changes a
+//! value: it hashes every `Ctx::state_of(j, t)` result at its exact key and, on every repeat,
+//! compares the fresh value against the first-seen hash. A mismatch is a read the memo would have
+//! answered stale — the adoption's ruin mode (silent canonical corruption), measured instead of
+//! argued. Stats are windowed by tick and split by the doll whose `secondaries` loop is reading,
+//! so one flight separates the reader populations (belt comb, locals' doll, birth) that share
+//! sources. Enabled by `ES_MEMO_ORACLE=1`; silent otherwise.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+use crate::num::{Tick, V2};
+
+/// Ticks a window spans: ~120 game-s at the plane's clock, fine enough to separate the birth
+/// wave from the spread belt, coarse enough that one flight's windows fit a page.
+const WINDOW: Tick = 1 << 20;
+/// How many staleness events to name individually.
+const NAME: u64 = 20;
+
+#[derive(Default)]
+struct Totals {
+    calls: u64,
+    hits: u64,
+    mismatch: u64,
+}
+
+thread_local! {
+    /// (j, t) -> (fnv hash of the value, times seen).
+    static SEEN: RefCell<HashMap<(usize, Tick), (u64, u64)>> = RefCell::new(HashMap::new());
+    static WINDOWS: RefCell<HashMap<Tick, Totals>> = RefCell::new(HashMap::new());
+    /// The doll whose `secondaries` loop is on the stack (u16::MAX outside one): the reader
+    /// population a call belongs to — the belt comb and the locals' doll read the same sources.
+    static DOLL: RefCell<u16> = const { RefCell::new(u16::MAX) };
+    static DOLLS: RefCell<HashMap<u16, Totals>> = RefCell::new(HashMap::new());
+    static MISMATCHES: RefCell<u64> = const { RefCell::new(0) };
+    static CALLS: RefCell<u64> = const { RefCell::new(0) };
+    static ENABLED: bool = std::env::var("ES_MEMO_ORACLE").as_deref() == Ok("1");
+}
+
+fn fnv(bytes: &[u8]) -> u64 {
+    let mut h = 0xcbf29ce484222325u64;
+    for &b in bytes {
+        h ^= b as u64;
+        h = h.wrapping_mul(0x100000001b3);
+    }
+    h
+}
+
+/// Enter/leave the doll whose secondaries are being built (observation only).
+pub fn enter_doll(d: u16) {
+    DOLL.with(|x| *x.borrow_mut() = d);
+}
+
+pub fn leave_doll() {
+    DOLL.with(|x| *x.borrow_mut() = u16::MAX);
+}
+
+/// Record one `state_of` result. Observation only.
+pub fn record(j: usize, t: Tick, v: &(V2, V2)) {
+    if !ENABLED.with(|e| *e) {
+        return;
+    }
+    CALLS.with(|c| *c.borrow_mut() += 1);
+    let h = fnv(format!("{v:?}").as_bytes());
+    let w = t.div_euclid(WINDOW) * WINDOW;
+    // First sight stores the hash. A repeat is a hit; a repeat whose fresh hash differs from the
+    // stored one is a staleness event: the never-invalidated memo would answer with the first
+    // value, so every such read is a silent corruption caught in the act.
+    let (hit, stale) = SEEN.with(|s| {
+        let mut s = s.borrow_mut();
+        match s.get_mut(&(j, t)) {
+            Some(e) => {
+                e.1 += 1;
+                (true, e.0 != h)
+            }
+            None => {
+                s.insert((j, t), (h, 1));
+                (false, false)
+            }
+        }
+    });
+    WINDOWS.with(|ws| {
+        let mut ws = ws.borrow_mut();
+        let w0 = ws.entry(w).or_default();
+        w0.calls += 1;
+        if hit {
+            w0.hits += 1;
+        }
+        if stale {
+            w0.mismatch += 1;
+        }
+    });
+    let d = DOLL.with(|x| *x.borrow());
+    DOLLS.with(|ds| {
+        let mut ds = ds.borrow_mut();
+        let d0 = ds.entry(d).or_default();
+        d0.calls += 1;
+        if hit {
+            d0.hits += 1;
+        }
+        if stale {
+            d0.mismatch += 1;
+        }
+    });
+    if stale {
+        MISMATCHES.with(|m| {
+            let seen = {
+                let mut m = m.borrow_mut();
+                let seen = *m;
+                *m += 1;
+                seen
+            };
+            if seen < NAME {
+                println!("memo_oracle STALE: j={j} t={t} window={w} doll={d}");
+            }
+        });
+    }
+}
+
+/// Print the census: global, per-doll (reader population) and per-window calls, hits, mismatches.
+pub fn report() {
+    if !ENABLED.with(|e| *e) {
+        return;
+    }
+    let calls = CALLS.with(|c| *c.borrow());
+    let (keys, hits, maxmult) = SEEN.with(|s| {
+        let s = s.borrow();
+        (
+            s.len() as u64,
+            s.values().map(|e| e.1.saturating_sub(1)).sum::<u64>(),
+            s.values().map(|e| e.1).max().unwrap_or(0),
+        )
+    });
+    let mismatches = MISMATCHES.with(|m| *m.borrow());
+    println!(
+        "memo_oracle: calls={calls} keys={keys} hits={hits} ({:.1}%) top_mult={maxmult} STALE={mismatches}",
+        100.0 * hits as f64 / calls.max(1) as f64
+    );
+    let mut ds: Vec<(u16, Totals)> = DOLLS.with(|d| {
+        d.borrow()
+            .iter()
+            .map(|(k, v)| (*k, Totals { calls: v.calls, hits: v.hits, mismatch: v.mismatch }))
+            .collect()
+    });
+    ds.sort_by_key(|(k, _)| *k);
+    for (k, d) in ds {
+        println!(
+            "memo_oracle: doll={k} calls={} hits={:.1}% STALE={}",
+            d.calls,
+            100.0 * d.hits as f64 / d.calls.max(1) as f64,
+            d.mismatch
+        );
+    }
+    let mut ws: Vec<(Tick, Totals)> = WINDOWS.with(|w| {
+        w.borrow()
+            .iter()
+            .map(|(k, v)| (*k, Totals { calls: v.calls, hits: v.hits, mismatch: v.mismatch }))
+            .collect()
+    });
+    ws.sort_by_key(|(k, _)| *k);
+    let mut quiet = 0u64;
+    for (k, w) in ws {
+        if w.calls < 100 {
+            quiet += 1;
+            continue;
+        }
+        println!(
+            "memo_oracle: w_tick={k} calls={} hits={:.1}% STALE={}",
+            w.calls,
+            100.0 * w.hits as f64 / w.calls.max(1) as f64,
+            w.mismatch
+        );
+    }
+    println!("memo_oracle: {quiet} window(s) under 100 calls suppressed (their STALE is tallied in the global line)");
+}
