+++ b/crates/space/examples/dbg_plunge.rs
@@ -0,0 +1,22 @@
+use emergent_space::binding::{IntegerState, Rebinding};
+fn main() {
+    let (energy, l, r, inbound) = (0.97f64, 3.6f64, 5.0f64, true);
+    let lapse = 1.0 - 2.0 / r;
+    let v2 = energy * energy - lapse * (1.0 + l * l / (r * r));
+    let vr = -lapse * v2.sqrt() / energy * if inbound { 1.0 } else { -1.0 };
+    let vt = lapse * l / (r * energy);
+    let (le, ve) = (24i32, -30i32);
+    let to_int = |x: f64, e: i32| (x * 2f64.powi(-e)).round() as i64;
+    let state = IntegerState { position: [to_int(r, le), 0], velocity: [to_int(vr, ve), to_int(vt, ve)], length_exponent: le as i16, velocity_exponent: ve as i16 };
+    println!("v2={v2} vr={vr} vt={vt}");
+    match Rebinding::from_state(state, emergent_space::orbit::Scalar::ZERO, None, Some(emergent_space::orbit::Scalar::integer(5).div(emergent_space::orbit::Scalar::integer(2)).unwrap())) {
+        Ok(f) => println!("fit ok: {:?}", f.trajectory.key().is_none()),
+        Err(e) => println!("fit err {e:?}"),
+    }
+    // direct compile
+    let sc = |x: f64| { let e = x.log2().floor() as i32; emergent_space::orbit::Scalar::raw((x * 2f64.powi(60 - e)).round() as i128, e - 60).unwrap() };
+    match emergent_space::plunge::Plunge::from_event(sc(energy), sc(l), sc(0.2), true, sc(2.5)) {
+        Ok(p) => println!("compile ok knots={}", p.knots().len()),
+        Err(e) => println!("compile err {e:?}"),
+    }
+}
