+//! Plunge arcs against a float64 geodesic oracle. The oracle integrates the
+//! same invariants in u with dense Simpson panels — an independent path from
+//! the compiler's w-phase — plus the closed form of the radial fall from rest.
+//! Nothing here is tuned on the cases it checks.
+use emergent_space::{
+    binding::{IntegerState, Rebinding, Trajectory},
+    orbit::Scalar,
+    plunge::Plunge,
+};
+
+fn scalar(x: f64) -> Scalar {
+    assert!(x.is_finite() && x > 0.0);
+    let exponent = x.log2().floor() as i32;
+    Scalar::raw((x * 2f64.powi(60 - exponent)).round() as i128, exponent - 60).unwrap()
+}
+fn f(x: Scalar) -> f64 {
+    x.significand() as f64 * 2f64.powi(x.exponent() as i32 - 62)
+}
+fn rel(a: f64, b: f64) -> f64 {
+    ((a - b) / b).abs()
+}
+
+/// Simpson in u over [u_a, u_b] of the three clock rates (V² > 0 throughout).
+fn oracle(energy: f64, l: f64, u_a: f64, u_b: f64) -> (f64, f64, f64) {
+    let v2 = |u: f64| energy * energy - (1.0 - 2.0 * u) * (1.0 + l * l * u * u);
+    let n = 100_000;
+    let h = (u_b - u_a) / n as f64;
+    let node = |u: f64| -> [f64; 3] {
+        let s = v2(u).sqrt();
+        [l / s, energy / ((1.0 - 2.0 * u) * s), 1.0 / (u * u * s)]
+    };
+    let a = node(u_a);
+    let b = node(u_b);
+    let mut sum = [0.0f64; 3];
+    for i in 1..n {
+        let x = node(u_a + h * i as f64);
+        let w = if i % 2 == 1 { 4.0 } else { 2.0 };
+        for j in 0..3 {
+            sum[j] += w * x[j];
+        }
+    }
+    (
+        h / 3.0 * (a[0] + b[0] + sum[0]),
+        h / 3.0 * (a[1] + b[1] + sum[1]),
+        h / 3.0 * (a[2] + b[2] + sum[2]),
+    )
+}
+
+/// The largest real root of V² in f64 (an independent bisection).
+fn root_of(energy: f64, l: f64) -> f64 {
+    let v2 = |u: f64| energy * energy - (1.0 - 2.0 * u) * (1.0 + l * l * u * u);
+    let (mut lo, mut hi) = if energy < 1.0 {
+        (0.0, 0.5)
+    } else {
+        let mut hi = 0.0;
+        let mut lo = -1.0;
+        while v2(lo) >= 0.0 {
+            hi = lo;
+            lo *= 2.0;
+        }
+        (lo, hi)
+    };
+    for _ in 0..200 {
+        let mid = 0.5 * (lo + hi);
+        if v2(mid) > 0.0 {
+            hi = mid;
+        } else {
+            lo = mid;
+        }
+    }
+    hi
+}
+
+/// The fall of a state at `start` with these invariants: the compiled terminal
+/// event against the oracle's integrals over the same window (anchored at the
+/// turn when one exists, else at the event).
+fn case(energy: f64, l: f64, start: f64, terminal: f64, tol: f64) {
+    let p = Plunge::from_event(scalar(energy), scalar(l), scalar(1.0 / start), true, scalar(terminal))
+        .unwrap_or_else(|e| panic!("E {energy} L {l} r {start}: {e:?}"));
+    let u_top = if energy < 1.0 { root_of(energy, l) } else { 1.0 / start };
+    let (t, phi, tau) = p.arrival().unwrap();
+    let want = oracle(energy, l, u_top, 1.0 / terminal);
+    assert!(rel(f(t), want.1) <= tol, "E {energy} L {l}: t {} vs {}", f(t), want.1);
+    assert!(rel(f(phi), want.0) <= tol, "E {energy} L {l}: phi {} vs {}", f(phi), want.0);
+    assert!(rel(f(tau), want.2) <= tol, "E {energy} L {l}: tau {} vs {}", f(tau), want.2);
+}
+
+#[test]
+fn radial_fall_from_rest_matches_the_closed_form_tau() {
+    for &r0 in &[10.0, 100.0, 1e4] {
+        let energy = (1.0 - 2.0 / r0 as f64).sqrt();
+        let terminal = 2.5;
+        let p = Plunge::from_event(scalar(energy), Scalar::ZERO, scalar(1.0 / r0), true, scalar(terminal)).unwrap();
+        let (t, phi, tau) = p.arrival().unwrap();
+        // τ(r) = sqrt(r0³/8) [acos sqrt(r/r0) + sqrt((r/r0)(1 − r/r0))].
+        let x = terminal / r0;
+        let want_tau = (r0 * r0 * r0 / 8.0).sqrt() * (x.sqrt().acos() + (x * (1.0 - x)).sqrt());
+        assert!(rel(f(tau), want_tau) < 1e-9, "r0 {r0}: tau {} vs {want_tau}", f(tau));
+        assert!(f(phi).abs() < 1e-30, "a radial fall turns by phi {}", f(phi));
+        let want_t = oracle(energy, 0.0, 1.0 / r0, 1.0 / terminal).1;
+        assert!(rel(f(t), want_t) < 1e-9, "r0 {r0}: t {} vs {want_t}", f(t));
+    }
+}
+
+#[test]
+fn plunging_orbits_arrive_as_the_oracle_says() {
+    // Bound-mass plunges below the critical angular momentum.
+    case(0.97, 3.6, 4.0, 2.5, 2e-9);
+    case(0.9, 1.0, 6.0, 2.5, 2e-9);
+    // E = 1 exactly.
+    case(1.0, 3.0, 5.0, 2.5, 2e-9);
+    // E > 1: the fall from a hyperbolic approach.
+    case(1.2, 2.0, 5.0, 2.5, 2e-9);
+    // A long window from far out (only E ≥ 1 reaches it).
+    case(1.001, 3.0, 1e6, 2.5, 2e-9);
+    // Near-radial.
+    case(0.99, 1e-3, 50.0, 2.5, 2e-9);
+}
+
+#[test]
+fn a_skimming_plunge_just_below_the_separatrix_still_converges() {
+    // Held out: the critical L of E = 0.95 where the fall lingers on the lip.
+    let energy = 0.95;
+    let plunge = |l: f64| {
+        if l * l <= 12.0 {
+            return true; // no barrier at all: everything falls through
+        }
+        let umin = (1.0 + (1.0 - 12.0 / (l * l)).sqrt()) / 6.0;
+        energy * energy - (1.0 - 2.0 * umin) * (1.0 + l * l * umin * umin) > 0.0
+    };
+    let (mut lo, mut hi) = (3.4, 3.7);
+    assert!(plunge(lo) && !plunge(hi), "the bracket must straddle the separatrix");
+    for _ in 0..100 {
+        let mid = 0.5 * (lo + hi);
+        if plunge(mid) {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    case(energy, lo - 1e-6, 4.0, 2.5, 1e-7);
+}
+
+#[test]
+fn sampled_states_track_the_arc() {
+    let (energy, l, start, terminal) = (0.97f64, 3.6f64, 5.0f64, 2.5f64);
+    let p = Plunge::from_event(scalar(energy), scalar(l), scalar(1.0 / start), true, scalar(terminal)).unwrap();
+    let r_turn = 1.0 / root_of(energy, l);
+    let (t_end, _, _) = p.arrival().unwrap();
+    for frac in [1e-3, 0.1, 0.3, 0.6, 0.9, 0.999] {
+        let t = f(t_end) * frac;
+        let st = p.state(scalar(t)).unwrap();
+        // r(t): invert the oracle's t(r) by bisection on its own integral.
+        let (mut lo, mut hi) = (terminal, r_turn);
+        for _ in 0..60 {
+            let mid = 0.5 * (lo + hi);
+            if oracle(energy, l, 1.0 / r_turn, 1.0 / mid).1 < t {
+                hi = mid;
+            } else {
+                lo = mid;
+            }
+        }
+        let want_r = 0.5 * (lo + hi);
+        assert!(rel(f(st.radius), want_r) < 1e-6, "t {t}: r {} vs {want_r}", f(st.radius));
+        assert!(f(st.proper_time) > 0.0 && f(st.proper_time) < t);
+    }
+    // The mirrored outbound leg: same radius, opposite radial velocity.
+    let half = p.state(scalar(f(t_end) * 0.5)).unwrap();
+    let mirrored = p.state(scalar(f(t_end) * -0.5)).unwrap();
+    assert!(rel(f(half.radius), f(mirrored.radius)) < 1e-9);
+    assert_eq!(half.radial_velocity, mirrored.radial_velocity.negate());
+    // Past the terminal event there is no state to extrapolate.
+    assert!(p.state(scalar(f(t_end) * 1.0000001)).is_err());
+}
+
+#[test]
+fn from_state_fits_plunges_and_reconstructs_exactly() {
+    // Cartesian states on plunging geodesics, inbound and outbound.
+    for &(energy, l, r, inbound) in &[
+        (0.97f64, 3.6f64, 5.0f64, true),
+        (0.97, 3.6, 5.0, false),
+        (1.0, 3.0, 6.0, true),
+        (1.2, 2.0, 4.0, true),
+        (0.9, 0.0, 8.0, true),  // radial (L = 0 exactly)
+        (0.9, 0.0, 8.0, false), // a radial rise to its single turn
+    ] {
+        let lapse = 1.0 - 2.0 / r;
+        let v2 = energy * energy - lapse * (1.0 + l * l / (r * r));
+        assert!(v2 > 0.0, "the case must sit on an allowed arc");
+        let vr = -lapse * v2.sqrt() / energy * if inbound { 1.0 } else { -1.0 };
+        let vt = lapse * l / (r * energy);
+        let (le, ve) = (24i32, -30i32);
+        let to_int = |x: f64, e: i32| (x * 2f64.powi(-e)).round() as i64;
+        let state = IntegerState {
+            position: [to_int(r, le), 0],
+            velocity: [to_int(vr, ve), to_int(vt, ve)],
+            length_exponent: le as i16,
+            velocity_exponent: ve as i16,
+        };
+        let fit = Rebinding::from_state(state, Scalar::ZERO, None, Some(scalar(2.5)));
+        // An outbound E ≥ 1 state escapes and stays refused.
+        if !inbound && energy >= 1.0 {
+            assert!(fit.is_err(), "escape should refuse: E {energy} L {l}");
+            continue;
+        }
+        let fit = fit.unwrap_or_else(|e| panic!("E {energy} L {l} r {r} inbound {inbound}: {e:?}"));
+        let Trajectory::Plunge(p) = &fit.trajectory else {
+            panic!("E {energy} L {l} inbound {inbound} fitted a turning tube");
+        };
+        assert!(rel(f(p.energy()), energy) < 1e-9, "E {}", f(p.energy()));
+        // The exact left inverse: the fit reconstructs its input bit for bit.
+        assert_eq!(fit.reconstruct().unwrap(), state, "E {energy} L {l} inbound {inbound}");
+        // The terminal event is finite and at the surface.
+        let (t, _, _) = p.arrival().unwrap();
+        assert!(f(t) > 0.0);
+        assert!(rel(f(p.terminal), 2.5) < 1e-12);
+    }
+}
+
+#[test]
+fn compilation_is_deterministic_and_refuses_a_horizon_terminal() {
+    let a = Plunge::compile(scalar(0.97), scalar(3.6), scalar(0.2), scalar(2.5)).unwrap();
+    let b = Plunge::compile(scalar(0.97), scalar(3.6), scalar(0.2), scalar(2.5)).unwrap();
+    assert_eq!(a.knots(), b.knots());
+    // The horizon is not a coordinate-time endpoint.
+    assert!(Plunge::compile(scalar(0.97), scalar(3.6), scalar(0.2), scalar(2.0)).is_err());
+    assert!(Plunge::compile(scalar(0.97), scalar(3.6), scalar(0.2), scalar(1.5)).is_err());
+    // A window with a turning point inside it is not a plunge.
+    // E = 0.97, L = 3.83 turns inside (4, 2.5]; the compiler must say so.
+    assert!(Plunge::compile(scalar(0.97), scalar(3.83), scalar(0.25), scalar(2.5)).is_err());
+}
