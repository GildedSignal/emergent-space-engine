@@ -0,0 +1,449 @@
+//! Massive plunge arcs: one-way compiled generators for orbits with no outer
+//! turning point (the barrier is positive, or L² below 12) and for near-radial
+//! falls (L = 0), inbound or riding out to their single turning point, ending
+//! in an exact terminal event on the doll's surface. Null capture is
+//! `light::Capture`; this is the massive counterpart in the same normalized
+//! style: a radial phase with a binary exponent, adaptive Gauss panels, and a
+//! readout that is a pure function of elapsed coordinate time.
+//!
+//! **The phase.** With E and L the invariants (G = c = M = 1) the radial speed
+//! is V²(u) = E² − (1 − 2u)(1 + L²u²) = 2L²u³ − L²u² + 2u + (E² − 1), u = 1/r.
+//! A plunge lives on the band u > u_r, where u_r is the cubic's largest real
+//! root (the band's outer edge; a turn — or negative, for E ≥ 1). Darwin's ψ
+//! needs two real turning roots, which a plunge does not have; the native
+//! substitution here is **w = sqrt(u − u_r)**, which divides the root out of
+//! V² = w²·q(u) exactly, with q(u) = 2L²u² + L²(2u_r − 1)u + (2 + L²u_r(2u_r − 1))
+//! strictly positive on the band. Per unit w, with u = u_r + w² (exact, no
+//! cancellation), all three clock rates are smooth — including at the turning
+//! point w = 0 itself, where 1/V would diverge:
+//!
+//! ```text
+//!   dφ/dw = 2|L|/√q        dt/dw = 2E/((1 − 2u)·u²·√q)        dτ/dw = 2/(u²·√q)
+//! ```
+//!
+//! For E < 1 the window runs from the turn (w = 0) to the terminal surface and
+//! the outbound leg is its exact mirror (`state(t < 0)`, as a passage mirrors
+//! its incoming half). For E ≥ 1 the turning edge is outside the physical
+//! domain (u_r ≤ 0), so the window is anchored at the binding event; an
+//! outbound E ≥ 1 state escapes and is refused. The terminal radius must stay
+//! strictly outside the horizon, exactly as `light::Capture` requires:
+//! Schwarzschild coordinate time has no finite value at r = 2M, and no horizon
+//! chart is claimed here.
+//!
+//! u_r is found with 256-bit dyadic scratch: exact critical points decide a
+//! bracket containing exactly the largest root, then one bisection. The panels
+//! adapt to 2⁻³² agreement; every branch is integer arithmetic fixed by its
+//! inputs, so a compiled arc is bit-identical everywhere.
+use crate::{
+    Error, Result,
+    orbit::{OrbitState, Scalar},
+    tables::{W, X},
+};
+use num_bigint::BigInt;
+use num_traits::{One, Signed, ToPrimitive, Zero};
+
+const BITS: usize = 256;
+
+/// A one-way arc from its turning point (or the binding event, for E ≥ 1) down
+/// to a terminal radius, compiled once from the invariants.
+#[derive(Clone, Debug)]
+pub struct Plunge {
+    energy: Scalar,
+    /// |L|; the compiled arc is prograde, chirality is the binding's.
+    angular: Scalar,
+    /// The cubic's largest real root (the plunge band's outer edge in u).
+    root: Scalar,
+    /// The window's outer edge in u (the turn, or the binding event for E ≥ 1).
+    top: Scalar,
+    /// The terminal radius: the window's inner edge, strictly outside 2M.
+    pub terminal: Scalar,
+    /// (w, [Δφ, Δt, Δτ]) from the window's top inward; the sums are total.
+    knots: Vec<(Scalar, [Scalar; 3])>,
+}
+
+impl Plunge {
+
+    /// Compile the fall of a state at radius-u `event_u` with these invariants
+    /// (`incoming`: falling now, or rising to its turn first), ending at
+    /// `terminal`. The window is anchored at the turn when one exists in the
+    /// physical domain (E < 1); for E ≥ 1 it is anchored at the event, and an
+    /// outbound (escaping) state is refused.
+    pub fn from_event(
+        energy: Scalar,
+        angular: Scalar,
+        event_u: Scalar,
+        incoming: bool,
+        terminal: Scalar,
+    ) -> Result<Self> {
+        let root = largest_root(energy, angular)?;
+        let top = if root.is_positive() {
+            root
+        } else {
+            if !incoming {
+                return Err(Error::NoBoundOrbit);
+            }
+            event_u
+        };
+        Self::compile(energy, angular, top, terminal)
+    }
+    /// Compile the arc of invariants (`energy` = E > 0, `angular` = |L| ≥ 0)
+    /// from `top` (the window's outer edge in u: the turn's u when it is
+    /// physical, else the binding event's u) down to `terminal` (the surface
+    /// radius, strictly outside 2M).
+    pub fn compile(energy: Scalar, angular: Scalar, top: Scalar, terminal: Scalar) -> Result<Self> {
+        if !energy.is_positive() || angular < Scalar::ZERO || !terminal.is_positive() {
+            return Err(Error::Range);
+        }
+        if terminal <= Scalar::integer(2) {
+            // Coordinate time has no finite horizon value; as light::Capture.
+            return Err(Error::Range);
+        }
+        let root = largest_root(energy, angular)?;
+        let u_term = terminal.reciprocal()?;
+        // `top == root` is the turn itself (w = 0); below it is another band.
+        if top < root || u_term <= top {
+            return Err(Error::Range);
+        }
+        let mut p = Self {
+            energy,
+            angular,
+            root,
+            top,
+            terminal,
+            knots: Vec::new(),
+        };
+        let (w_top, w_term) = (p.w(top)?, p.w(u_term)?);
+        // Panel edges: a 15/16 ladder in w preserves relative information over
+        // any window ratio, stopping at the window's top (a turn anchors w = 0;
+        // the last panel down to it is one, the integrands being smooth there).
+        let stop = w_top.max(w_term.div(Scalar::integer(16))?);
+        let mut edges = vec![w_term];
+        loop {
+            let last = *edges.last().unwrap();
+            let next = last
+                .mul(Scalar::integer(15))?
+                .div(Scalar::integer(16))?;
+            if next <= stop || next == last {
+                edges.push(w_top);
+                break;
+            }
+            edges.push(next);
+        }
+        edges.reverse();
+        let mut sum = [Scalar::ZERO; 3];
+        p.knots.push((w_top, sum));
+        for pair in edges.windows(2) {
+            let a = p.integrate(pair[0], pair[1], 0)?;
+            for j in 0..3 {
+                sum[j] = sum[j].add(a[j])?;
+            }
+            p.knots.push((pair[1], sum));
+        }
+        Ok(p)
+    }
+
+    /// The window's outer edge radius (a turn, or the binding event's radius).
+    pub fn outer_radius(&self) -> Result<Scalar> {
+        self.top.reciprocal()
+    }
+    pub fn knots(&self) -> &[(Scalar, [Scalar; 3])] {
+        &self.knots
+    }
+    /// Coordinate time from the window's top to the terminal event.
+    pub fn duration(&self) -> Result<Scalar> {
+        Ok(self.knots.last().unwrap().1[1])
+    }
+    /// The exact terminal event: elapsed coordinate time, azimuth and proper
+    /// time at the surface.
+    pub fn arrival(&self) -> Result<(Scalar, Scalar, Scalar)> {
+        let s = self.knots.last().unwrap().1;
+        Ok((s[1], s[0], s[2]))
+    }
+
+    /// w at radius-u `u` (inside the window).
+    fn w(&self, u: Scalar) -> Result<Scalar> {
+        let gap = u.sub(self.root)?;
+        if gap < Scalar::ZERO {
+            // Outside the plunge band's edge: this state has a turn.
+            return Err(Error::Topology);
+        }
+        // A zero gap is the turn itself (w = 0), a legal window top.
+        gap.sqrt()
+    }
+    /// The invariant E the arc was compiled from.
+    pub fn energy(&self) -> Scalar {
+        self.energy
+    }
+    /// cancellation against a small difference). Strictly positive on the band.
+    fn q(&self, u: Scalar) -> Result<Scalar> {
+        let l2 = self.angular.mul(self.angular)?;
+        let slope = l2.mul(self.root.scale(1)?.sub(Scalar::ONE)?)?;
+        let q = l2
+            .scale(1)?
+            .mul(u.mul(u)?)?
+            .add(slope.mul(u)?)?
+            .add(Scalar::integer(2).add(slope.mul(self.root)?)?)?;
+        if !q.is_positive() {
+            return Err(Error::Range);
+        }
+        Ok(q)
+    }
+
+    /// The clock rates per unit w at phase w.
+    fn node(&self, w: Scalar) -> Result<[Scalar; 3]> {
+        let u = self.root.add(w.mul(w)?)?;
+        let root = self.q(u)?.sqrt()?;
+        let u2 = u.mul(u)?;
+        let lapse = Scalar::ONE.sub(u.scale(1)?)?;
+        if !lapse.is_positive() {
+            return Err(Error::Range);
+        }
+        Ok([
+            self.angular.scale(1)?.div(root)?,
+            self.energy
+                .scale(1)?
+                .div(lapse.mul(u2)?.mul(root)?)?,
+            Scalar::integer(2).div(u2.mul(root)?)?,
+        ])
+    }
+
+    fn quad(&self, lo: Scalar, hi: Scalar) -> Result<[Scalar; 3]> {
+        let h = hi.sub(lo)?;
+        if h.is_zero() {
+            return Ok([Scalar::ZERO; 3]);
+        }
+        let mid = lo.add(hi)?.scale(-1)?;
+        let mut sum = [Scalar::ZERO; 3];
+        for j in 0..2 {
+            let dx = h.mul(Scalar::raw(X[j], -62)?)?.scale(-1)?;
+            let w = h.mul(Scalar::raw(W[j], -62)?)?.scale(-1)?;
+            for x in [mid.sub(dx)?, mid.add(dx)?] {
+                let n = self.node(x)?;
+                for i in 0..3 {
+                    sum[i] = sum[i].add(w.mul(n[i])?)?;
+                }
+            }
+        }
+        Ok(sum)
+    }
+
+    /// Adaptive panels: accept when the halves agree with the whole to 2⁻³².
+    fn integrate(&self, lo: Scalar, hi: Scalar, depth: u8) -> Result<[Scalar; 3]> {
+        let mid = lo.add(hi)?.scale(-1)?;
+        if lo == mid || hi == mid {
+            return self.quad(lo, hi);
+        }
+        let whole = self.quad(lo, hi)?;
+        let a = self.quad(lo, mid)?;
+        let b = self.quad(mid, hi)?;
+        let split = [a[0].add(b[0])?, a[1].add(b[1])?, a[2].add(b[2])?];
+        if (0..3).all(|i| {
+            split[i]
+                .sub(whole[i])
+                .is_ok_and(|e| e.abs() <= split[i].abs().scale(-32).unwrap_or(Scalar::ZERO))
+        }) {
+            return Ok(split);
+        }
+        if depth == 56 {
+            return Err(Error::Range);
+        }
+        let a = self.integrate(lo, mid, depth + 1)?;
+        let b = self.integrate(mid, hi, depth + 1)?;
+        Ok([a[0].add(b[0])?, a[1].add(b[1])?, a[2].add(b[2])?])
+    }
+
+    /// Elapsed coordinate time and the inbound state at radius `r` inside the
+    /// window. The outbound leg is the exact mirror (`reflect`).
+    pub fn at_radius(&self, r: Scalar) -> Result<(Scalar, OrbitState)> {
+        let w = self.w(r.reciprocal()?)?;
+        if w < self.knots[0].0 || w > self.knots.last().unwrap().0 {
+            return Err(Error::Range);
+        }
+        let i = self.knots.partition_point(|k| k.0 < w).saturating_sub(1);
+        let (base, sum) = self.knots[i];
+        let mut total = sum;
+        if w > base {
+            let a = self.integrate(base, w, 0)?;
+            for j in 0..3 {
+                total[j] = total[j].add(a[j])?;
+            }
+        }
+        Ok((total[1], self.read(w, total)?))
+    }
+
+    /// The state at elapsed coordinate time from the window's top; negative
+    /// elapsed reads the mirrored outbound leg. Past the terminal event there
+    /// is no state to extrapolate.
+    pub fn state(&self, elapsed: Scalar) -> Result<OrbitState> {
+        let t = elapsed.abs();
+        if t > self.duration()? {
+            return Err(Error::Range);
+        }
+        let i = self
+            .knots
+            .partition_point(|k| k.1[1] <= t)
+            .saturating_sub(1);
+        let (base, sum) = self.knots[i];
+        let (w, total) = if sum[1] == t || i + 1 == self.knots.len() {
+            (base, sum)
+        } else {
+            let (mut lo, mut hi) = (base, self.knots[i + 1].0);
+            let mut answer = None;
+            for _ in 0..80 {
+                let w = lo.add(hi)?.scale(-1)?;
+                let mut here = sum;
+                let a = self.integrate(base, w, 0)?;
+                for j in 0..3 {
+                    here[j] = here[j].add(a[j])?;
+                }
+                if here[1].sub(t)?.abs() <= t.scale(-30)? || w == lo || w == hi {
+                    answer = Some((w, here));
+                    break;
+                }
+                if here[1] > t {
+                    hi = w;
+                } else {
+                    lo = w;
+                }
+            }
+            answer.ok_or(Error::Range)?
+        };
+        let mut out = self.read(w, total)?;
+        if elapsed < Scalar::ZERO {
+            out.reflect();
+        }
+        Ok(out)
+    }
+
+    /// Compose the inbound state at phase `w` with accumulated sums.
+    fn read(&self, w: Scalar, sum: [Scalar; 3]) -> Result<OrbitState> {
+        let u = self.root.add(w.mul(w)?)?;
+        let speed = w.mul(self.q(u)?.sqrt()?)?;
+        let lapse = Scalar::ONE.sub(u.scale(1)?)?;
+        Ok(OrbitState {
+            radius: u.reciprocal()?,
+            radial_angle: 0,
+            advance: sum[0],
+            proper_time: sum[2],
+            // Coordinate velocity components, as every OrbitState carries them.
+            radial_velocity: lapse.mul(speed)?.div(self.energy)?.negate(),
+            transverse_velocity: lapse.mul(self.angular)?.mul(u)?.div(self.energy)?,
+            cycles: 0,
+            outbound: false,
+            psi: 0,
+        })
+    }
+}
+
+/// The largest real root of V²(u) = 2L²u³ − L²u² + 2u + (E²−1) in 256-bit
+/// dyadic scratch. V² is positive on (u_r, ∞): the plunge band's outer edge.
+/// The critical points (when L² ≥ 12) decide a bracket containing exactly the
+/// largest root, so the bisection cannot land on a smaller one.
+pub(crate) fn largest_root(energy: Scalar, angular: Scalar) -> Result<Scalar> {
+    let one = BigInt::one() << BITS;
+    let e2 = dyadic(energy.mul(energy)?)?;
+    let l2 = dyadic(angular.mul(angular)?)?;
+    let eval = |u: &BigInt| -> BigInt {
+        // Every product truncated to the shared scale, as inverse.rs does.
+        let u2 = (u * u) >> BITS;
+        let u3 = (&u2 * u) >> BITS;
+        (((&l2 * u3) >> BITS) << 1) - ((&l2 * u2) >> BITS) + (u << 1) + &e2 - &one
+    };
+    let bisect = |mut lo: BigInt, mut hi: BigInt| -> BigInt {
+        while &hi - &lo > BigInt::one() {
+            let mid = (&lo + &hi) >> 1;
+            if eval(&mid) > BigInt::zero() {
+                hi = mid;
+            } else {
+                lo = mid;
+            }
+        }
+        hi
+    };
+    let walk_out = |start: BigInt| -> (BigInt, BigInt) {
+        let mut hi = start;
+        let mut lo = -hi.clone();
+        while eval(&lo) >= BigInt::zero() {
+            hi = lo.clone();
+            lo <<= 1;
+        }
+        (lo, hi)
+    };
+    // V²(1/2) = E² > 0: the horizon is reachable for every massive orbit.
+    let half: BigInt = &one >> 1;
+    let root = if eval(&BigInt::zero()) < BigInt::zero() {
+        // E < 1: the largest root lies in (0, 1/2), on the increasing stretch.
+        bisect(BigInt::zero(), half.clone())
+    } else if (&l2 << 3) + (&l2 << 2) < one {
+        // L² < 12: V²' > 0 everywhere, so V² is strictly increasing and the
+        // single real root is negative.
+        let (lo, hi) = walk_out(BigInt::zero());
+        bisect(lo, hi)
+    } else {
+        // Critical points u± = (1 ± sqrt(1 − 12/L²))/6, u_max < u_min ≤ 1/3.
+        let c = (&one * 12) / &l2;
+        let d = sqrt(&((&one - c) * &one))?;
+        let six = &one * 6;
+        let umax = (&one - &d) * &one / &six;
+        let umin = (&one + &d) * &one / &six;
+        if eval(&umin) <= BigInt::zero() {
+            // V² ≤ 0 at the local minimum and increases to +∞ from there:
+            // exactly one crossing in [u_min, 1/2), the largest root.
+            bisect(umin, half.clone())
+        } else if eval(&umax) < BigInt::zero() {
+            // One crossing on the decreasing stretch between the critical
+            // points; the third root is complex, so this is the largest.
+            bisect(umax, umin)
+        } else {
+            // V² > 0 at both critical points: the only real root is below
+            // u_max, on a strictly increasing stretch.
+            let (lo, hi) = walk_out(umax);
+            bisect(lo, hi)
+        }
+    };
+    scalar(&root)
+}
+
+/// A positive BigInt square root at the shared dyadic scale (Newton).
+fn sqrt(a: &BigInt) -> Result<BigInt> {
+    if !a.is_positive() {
+        return Err(Error::Range);
+    }
+    let mut x = BigInt::one() << (a.bits() / 2 + 1);
+    for _ in 0..192 {
+        let next = (&x + ((a << BITS) / &x)) >> 1;
+        if next == x {
+            return Ok(x);
+        }
+        x = next;
+    }
+    Err(Error::Range)
+}
+
+/// A Scalar as 256-bit dyadic scratch. Every physical exponent fits.
+fn dyadic(x: Scalar) -> Result<BigInt> {
+    let e = x.exponent() as i32 - 62;
+    if !(-1000..1000).contains(&e) {
+        return Err(Error::Range);
+    }
+    let n = BigInt::from(x.significand());
+    Ok(if e >= 0 {
+        n << (e + BITS as i32) as usize
+    } else {
+        (n << BITS) >> -e as usize
+    })
+}
+
+/// Narrow a 256-bit dyadic integer back to a Scalar, truncating toward zero.
+fn scalar(n: &BigInt) -> Result<Scalar> {
+    let bits = n.bits() as i32;
+    if bits == 0 {
+        return Ok(Scalar::ZERO);
+    }
+    if bits > 300 {
+        return Err(Error::Range);
+    }
+    let shift = (bits - 62).max(0) as usize;
+    let significand = (n >> shift).to_i128().ok_or(Error::Range)?;
+    Scalar::raw(significand, shift as i32 - BITS as i32)
+}
