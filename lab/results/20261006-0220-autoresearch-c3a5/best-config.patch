+
+#[test]
+fn quad_bench_weak_hyperbolic_ladder() {
+    // One measured leaver shape: weak (compactness zeroed) and hyperbolic (k<1/2),
+    // the population the kick bench prices. Walks the same band ladder to the same
+    // join floor (2^-10 in Q62) as Passage::compile, times it, hashes every knot.
+    let key = ShapeKey { k: 29676364815277, compactness: Scalar::ZERO, null: false };
+    let mut s = OrbitShape::new(key).unwrap();
+    let x: i128 = 1 << 52;
+    let mut band = 1usize;
+    let mut digest = 0u64;
+    let t = std::time::Instant::now();
+    let mut panels = 0usize;
+    loop {
+        let edge = crate::tables::EDGE[band % 16] >> (band / 16);
+        if edge <= x { break; }
+        s.append(s.cut(edge)).unwrap();
+        s.crossings.push(s.knots.len() - 1);
+        band += 1;
+        panels += 1;
+    }
+    s.append(s.cut(x)).unwrap();
+    let us = t.elapsed().as_secs_f64() * 1e6;
+    for k in &s.knots {
+        for c in k.sum.0 {
+            digest = digest.rotate_left(7) ^ (c.significand() as u64).rotate_left(17) ^ (c.exponent() as u64);
+        }
+    }
+    println!("QUAD_BENCH {us:.1} us for {panels} panels, {} knots, digest {digest:016x}", s.knots.len());
+}
