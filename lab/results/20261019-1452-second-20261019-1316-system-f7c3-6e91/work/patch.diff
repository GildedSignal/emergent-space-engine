+
+/// `ES_QMEMO=1` serves cycle compiles from the law's quantized cell with the exact key carried
+/// (docs/law.md "keyed by quantized (E, L)", the carried form). Unset or `0`: `Orbit::compile`
+/// verbatim — the shipped law, bit for bit.
+pub fn served(key: OrbitKey) -> Result<Orbit> {
+    let t = std::time::Instant::now();
+    let r = served_inner(key);
+    SERVE_NS.fetch_add(t.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+    SERVE_N.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    r
+}
+
+fn served_inner(key: OrbitKey) -> Result<Orbit> {
+    if !qmemo_enabled() {
+        return Orbit::compile(key);
+    }
+    // The symbolic circle has no radial instability to integrate: it stays exact (as does the
+    // refusal inside the ISCO, which is `compile`'s own branch).
+    if key.k_exponent == 0 && key.k == UNIT {
+        if let Ok(q) = key.compactness() {
+            if q >= Scalar::ONE.div(Scalar::integer(6))? {
+                return Orbit::compile(key);
+            }
+        }
+    }
+    // Lab (20261019-1452): `ES_QWEAK=1` serves only the weak branch (compactness ≤ 2⁻¹⁸,
+    // the belt's 100% regime); strong-branch keys compile exact — open direction 4's guard.
+    if std::env::var("ES_QWEAK").map(|v| v == "1").unwrap_or(false)
+        && key.compactness().map(|q| q > Scalar::power_of_two(WEAK_EXPONENT)).unwrap_or(true)
+    {
+        return Orbit::compile(key);
+    }
+    SERVED.with(|m| m.borrow_mut().get_carried(key))
+}
+
+static SERVE_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static SERVE_N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// (calls, total ns) of every `served()` call this process: with `ES_QMEMO` unset this times
+/// the exact compile, with it set the served form — one instrument, both arms (lab).
+pub fn qmemo_time() -> (u64, u64) {
+    (SERVE_N.load(std::sync::atomic::Ordering::Relaxed), SERVE_NS.load(std::sync::atomic::Ordering::Relaxed))
+}
+
+/// (hits, builds, distinct cells) of the thread's served memo, for the lab's instruments.
+pub fn qmemo_stats() -> (u64, u64, usize) {
+    SERVED.with(|m| {
+        let m = m.borrow();
+        (m.hits, m.builds, m.shapes.len())
+    })
+}
+
+fn qmemo_enabled() -> bool {
+    static V: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var("ES_QMEMO").map(|v| v == "1").unwrap_or(false));
+    *V
+}
