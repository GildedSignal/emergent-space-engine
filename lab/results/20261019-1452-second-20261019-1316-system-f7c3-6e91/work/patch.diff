+//! Print-only census of the rebind stream (lab run 20261019-1316-system-f7c3).
+//!
+//! Records, per actual rebind (a rebind happens only when a kick fires, a decision flushes a
+//! burn, or a handoff re-expresses the body — so every line is a distinct state change by
+//! construction, never a re-timed pending item), the body index and the law's quantized memo
+//! cell (`MemoCode`, 11+11 fraction bits). No state is read or written on the engine's path
+//! beyond what `rebind` already computed; with `ES_CENSUS` unset the hook is a no-op after one
+//! relaxed load, and digests cannot move.
+
+use emergent_space::binding::Trajectory;
+use emergent_space::orbit::MemoCode;
+use std::sync::{LazyLock, Mutex};
+
+static SINK: LazyLock<Option<Mutex<Vec<(u64, u64)>>>> =
+    LazyLock::new(|| std::env::var("ES_CENSUS").ok().map(|_| Mutex::new(Vec::new())));
+
+/// Record one rebind: `(body index, MemoCode bits of the new cycle key)`. Passages and plunges
+/// are not memo cells and are skipped.
+pub fn rebind(i: usize, trajectory: &Trajectory) {
+    if let Some(m) = SINK.as_ref() {
+        if let Trajectory::Cycle(c) = trajectory {
+            if let Ok(code) = MemoCode::encode(c.key()) {
+                if let Ok(mut m) = m.lock() {
+                    m.push((i as u64, code.bits()));
+                }
+            }
+        }
+    }
+}
+
+/// The recorded stream, drained.
+pub fn take() -> Vec<(u64, u64)> {
+    match SINK.as_ref() {
+        Some(m) => m.lock().map(|mut m| std::mem::take(&mut *m)).unwrap_or_default(),
+        None => Vec::new(),
+    }
+}
+
+/// Whether recording is on.
+pub fn enabled() -> bool {
+    SINK.is_some()
+}
