@@ -0,0 +1,51 @@
+//! Per-branch serve/compile cost on the ladder's own key population (lab run
+//! 20261019-1452): the belt's exact keys, read from the scenario at genesis (the same
+//! source `beltcensus`'s birth census uses), timed exact-compile vs cell-served — so the
+//! 10⁹ rebind row is priced on measured constants of the population it is about, not on
+//! the plane-scene FIT figure. Warm memo: the steady-state serve.
+use emergent_space::binding::Trajectory;
+use emergent_space::orbit::{Orbit, OrbitKey};
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::{census, Config};
+use std::time::Instant;
+
+fn main() {
+    let n: usize = std::env::args().nth(1).and_then(|v| v.parse().ok()).unwrap_or(100_000);
+    let seed: u64 = std::env::args().nth(2).and_then(|v| v.parse().ok()).unwrap_or(1);
+    let p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+    let total = p.u.n_bodies();
+    let locals = emergent_universe::scenario::ladder_locals(n as u64) as usize;
+    let mut keys: Vec<OrbitKey> = Vec::with_capacity(n);
+    for i in (total - n + locals)..(total - 1) {
+        if let Trajectory::Cycle(c) = &p.u.rec(i).b.entry.trajectory {
+            keys.push(c.key());
+        }
+    }
+    let n = keys.len();
+    assert!(n > 1000, "belt keys drawn: {n}");
+    for round in 0..2 {
+        let t = Instant::now();
+        for &k in &keys {
+            std::hint::black_box(Orbit::compile(k).unwrap());
+        }
+        let dt = t.elapsed().as_secs_f64();
+        if round == 1 {
+            println!("belt_keys: n={n} compile_us_per_key={:.3}", dt * 1e6 / n as f64);
+        }
+    }
+    // Served steady state: one warm pass (builds), then time hits only.
+    for &k in &keys {
+        std::hint::black_box(emergent_space::orbit::served(k).unwrap());
+    }
+    let t = Instant::now();
+    for &k in &keys {
+        std::hint::black_box(emergent_space::orbit::served(k).unwrap());
+    }
+    let dt = t.elapsed().as_secs_f64();
+    let (h, b, cells) = emergent_space::orbit::qmemo_stats();
+    println!(
+        "belt_keys: served_us_per_key_hit={:.3} memo_cells={cells} hits={h} builds={b}",
+        dt * 1e6 / n as f64
+    );
+}
