--- /dev/null
+++ b/crates/universe/tests/qmemo.rs
@@ -0,0 +1,185 @@
+//! The rebind's cycle served from the law's quantized cell with the **exact key carried**
+//! (`ES_QMEMO=1`; `emergent_space::orbit::served`). This is the experiment `memo.rs`'s header
+//! names as owed: "the memo that pays is the quantized one … a law-level choice, behind B1,
+//! B2 and B9 re-judged on memo keys" — in the carried form, so the exact integer state and the
+//! residual channel are untouched and the write-back random walk law.md rejected cannot occur.
+//! Unset, the gate serves `Orbit::compile` verbatim and this test measures the shipped law.
+use emergent_space::{
+    binding::Trajectory,
+    orbit::{self, MemoCode, Orbit, Scalar, ShapeKey},
+};
+use emergent_universe::body::What;
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::{step, Budget, Config, Kind};
+use std::collections::HashSet;
+use std::time::Instant;
+
+fn decode(x: Scalar) -> f64 {
+    x.significand() as f64 * 2f64.powi(x.exponent() as i32 - 62)
+}
+
+struct Census {
+    cycles: u64,
+    kick_served: i64,
+    kick_builds: i64,
+    cells: usize,
+    exact_recurrence: f64,
+    max_period_err: f64,
+    max_advance_err: f64,
+    max_knot_delta: i64,
+    med_period_err: f64,
+    hash: u64,
+    wall: std::time::Duration,
+    fit_ns: u64,
+}
+
+fn fnv(hash: u64, bytes: &[u8]) -> u64 {
+    let mut h = hash;
+    for b in bytes {
+        h ^= *b as u64;
+        h = h.wrapping_mul(0x100000001b3);
+    }
+    h
+}
+
+/// The `memo.rs` harness verbatim (distinct kicks only), plus the served-cell census against
+/// the exact compile (the oracle `behave`'s B1/B2 statistics read on this crate), a run-to-run
+/// outcome hash, the FIT stage when `prof` is on, and the kick-only served/build counts (the
+/// birth compiles of the scene's setup are excluded by a baseline taken after construction).
+fn run_stream() -> Census {
+    let mut p = plane(Config::default(), 1, Order::Sparse, 1, 48).unwrap();
+    let (bh, bb, _) = orbit::qmemo_stats();
+    let mut last: Vec<Option<i64>> = Vec::new();
+    let (mut cycles, mut knot_delta_max, mut fit_ns) = (0u64, 0i64, 0u64);
+    let (mut period_errs, mut advance_errs) = (Vec::new(), Vec::new());
+    let (mut exact, mut quantized) = (HashSet::new(), HashSet::new());
+    let mut hash = 0xcbf29ce484222325u64;
+    let t0 = Instant::now();
+    for _ in 0..900 {
+        last.resize(p.u.n_bodies(), None);
+        for i in 0..p.u.n_bodies() {
+            let rec = p.u.rec(i);
+            if rec.kind != Kind::Ship || !rec.alive {
+                continue;
+            }
+            let Some(item) = rec.plan.first().copied() else { continue };
+            if !matches!(item.what, What::Kick(_)) || last[i] == Some(item.t) {
+                continue;
+            }
+            last[i] = Some(item.t);
+            let upd = step::process(&p.u.ctx(), i, rec);
+            let Some(Trajectory::Cycle(c)) = upd.new_entry.as_ref().map(|e| &e.trajectory) else { continue };
+            cycles += 1;
+            let key = c.key();
+            hash = fnv(hash, &i.to_le_bytes());
+            hash = fnv(hash, &item.t.to_le_bytes());
+            hash = fnv(hash, &key.k.to_le_bytes());
+            hash = fnv(hash, &key.periapsis.significand().to_le_bytes());
+            hash = fnv(hash, &(key.periapsis.exponent() as i64).to_le_bytes());
+            hash = fnv(hash, &c.period().unwrap().significand().to_le_bytes());
+            exact.insert(ShapeKey::for_orbit(key).unwrap());
+            quantized.insert(MemoCode::encode(key).unwrap().bits());
+            // The oracle: the shipped exact compile of the same exact key.
+            let o = Orbit::compile(key).unwrap();
+            let pe = (decode(c.period().unwrap()) / decode(o.period().unwrap()) - 1.0).abs();
+            let ae = (decode(c.advance().unwrap()) / decode(o.advance().unwrap()) - 1.0).abs();
+            period_errs.push(pe);
+            advance_errs.push(ae);
+            knot_delta_max =
+                knot_delta_max.max((c.shape().knots().len() as i64) - (o.shape().knots().len() as i64));
+        }
+        let (ns, _) = emergent_universe::prof::take();
+        fit_ns += ns[emergent_universe::prof::FIT];
+        p.u.frame(1.0 / 60.0, 100.0, Budget::unlimited());
+        p.u.settle(p.u.now);
+    }
+    let wall = t0.elapsed();
+    let (hits, builds, cells) = orbit::qmemo_stats();
+    period_errs.sort_by(|a, b| a.total_cmp(b));
+    advance_errs.sort_by(|a, b| a.total_cmp(b));
+    let med = |v: &[f64]| v[v.len() / 2];
+    Census {
+        cycles,
+        kick_served: (hits + builds) as i64 - (bh + bb) as i64,
+        kick_builds: builds as i64 - bb as i64,
+        cells,
+        exact_recurrence: 1.0 - exact.len() as f64 / cycles as f64,
+        max_period_err: period_errs[period_errs.len() - 1],
+        max_advance_err: advance_errs[advance_errs.len() - 1],
+        max_knot_delta: knot_delta_max,
+        med_period_err: med(&period_errs),
+        hash,
+        wall,
+        fit_ns,
+    }
+}
+
+#[test]
+fn the_cell_serves_the_rebind_with_the_exact_key_carried() {
+    std::env::set_var("ES_QMEMO", "1");
+    let first = run_stream();
+    let second = run_stream();
+    let build_rate = first.kick_builds as f64 / first.kick_served as f64;
+    println!(
+        "arm=on cycles={} wall_ms={} fit_ms={} kick_served={} kick_builds={} build_rate={:.4} cells={} standing_test_cells_metric=distinct_quantized_cells/cycles",
+        first.cycles,
+        first.wall.as_millis(),
+        first.fit_ns / 1_000_000,
+        first.kick_served,
+        first.kick_builds,
+        build_rate,
+        first.cells
+    );
+    println!(
+        "census vs exact compile: period max {:.3e} med {:.3e} | advance max {:.3e} | knot_delta_max {} | exact_recurrence {:.3}",
+        first.max_period_err,
+        first.med_period_err,
+        first.max_advance_err,
+        first.max_knot_delta,
+        first.exact_recurrence
+    );
+    println!("outcome hash {:#018x} vs rerun {:#018x}", first.hash, second.hash);
+    assert!(first.cycles > 300, "the stream is real: {}", first.cycles);
+    assert!(first.kick_served > 200, "the served path is exercised: {}", first.kick_served);
+    // P1 (pre-registered bar): shape builds per kick rebind < 0.15.
+    assert!(build_rate < 0.15, "P1 kick build rate {:.4}", build_rate);
+    // P2 (B2's band) and P3 (B1's band), re-judged against the exact compile.
+    assert!(first.max_period_err < 1e-3, "P2 period err {:.3e}", first.max_period_err);
+    assert!(first.max_advance_err < 1e-2, "P3 advance err {:.3e}", first.max_advance_err);
+    // P4: no knot explosion.
+    assert!(first.max_knot_delta <= 2, "P4 knot delta {}", first.max_knot_delta);
+    // P6: the exact key still never recurs — the state channel stayed exact.
+    assert!(first.exact_recurrence < 0.05, "P6 exact recurrence {:.3}", first.exact_recurrence);
+    // P5: the served law is a pure function of the key — identical outcomes on a rerun.
+    assert_eq!(first.hash, second.hash, "P5 rerun diverged");
+    assert_eq!(first.cycles, second.cycles);
+    // P8: standing shapes are bounded by cells, not bodies.
+    assert!(first.cells < 400, "P8 cells {}", first.cells);
+}
+
+#[test]
+fn unset_the_law_is_verbatim() {
+    // In a shared process the on-arm test sets ES_QMEMO before the gate caches it; this arm is
+    // decisive only in a clean process (regen.sh runs it with the environment unset).
+    if std::env::var("ES_QMEMO").ok().as_deref() == Some("1") {
+        println!("skipped: ES_QMEMO=1 leaks into this process (the on-arm sets it); regen.sh runs this arm clean");
+        return;
+    }
+    // The same stream with the gate off must not touch the served memo at all.
+    let before = orbit::qmemo_stats();
+    let run = run_stream();
+    let after = orbit::qmemo_stats();
+    println!(
+        "arm=off cycles={} wall_ms={} fit_ms={} exact_recurrence {:.3} max_period_err {:.3e} (served untouched: {})",
+        run.cycles,
+        run.wall.as_millis(),
+        run.fit_ns / 1_000_000,
+        run.exact_recurrence,
+        run.max_period_err,
+        before == after
+    );
+    assert!(before == after, "the off arm touched the served memo");
+    assert!(run.max_period_err == 0.0, "the off arm is not the exact compile");
+    assert_eq!(run.kick_builds, run.kick_served, "the off arm compiles every rebind");
+}
