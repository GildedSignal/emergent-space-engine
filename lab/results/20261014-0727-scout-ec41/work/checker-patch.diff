index 00000000..21345ac5
--- /dev/null
+++ b/crates/encounters/examples/cycle.rs
@@ -0,0 +1,134 @@
+//! Cycle (20261014-0727-scout-ec41): renewal-on-certificate-failure vs per-kick re-certification.
+//!
+//! The shipped `kick` experiment applies ONE kick and asks which pairs a stored slack would skip.
+//! The engine's real stream is cumulative: every body receives ~2^step_log2 kicks per orbit and a
+//! pair certificate is consumed by BOTH partners' kicks. This probe drifts each sampled body
+//! through 1024 kicks (co-signed and random-walk), recomputes its pairs' exact horizon hits at
+//! log-spaced checkpoints, and counts how often a renewal is actually forced (consecutive
+//! checkpoint hit sets differ) and what the renewal costs in proposals (over-fire).
+//! Baseline: the shipped per-kick policy re-runs every pair every kick (812.8 pairs/kick).
+
+use emergent_encounters::belt::{make_belt, Rng, Spec};
+use emergent_encounters::kepler::Body;
+use emergent_encounters::method::{pair_events, Stats};
+use emergent_encounters::pairs::{is_candidate, Sorted};
+use std::f64::consts::TAU;
+
+const SAFETY: f64 = 1.1;
+const HORIZON: f64 = 1000.0; // orbits, same as shipped `kick`
+const TK: f64 = 10.0 * TAU;
+const KMAX: usize = 1024; // kicks streamed per body (~4 orbits of kicks at step_log2=7 for the pair)
+/// Checkpoints (kicks since start): log grid. Renewal counted when consecutive hit sets differ.
+const GRID: [usize; 11] = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024];
+
+fn spec(n: usize, sigma_e: f64, rho: f64, seed: u64) -> Spec {
+    Spec { name: "cycle".into(), n, sigma_e, rho, a_lo: 1.0, a_hi: 1.5, keys: 0, seed, orbits: 0.0 }
+}
+
+fn drifted(old: &Body, a_new: f64, n_new: f64) -> Body {
+    let lam_k = old.mean_anomaly(TK) + old.pom;
+    Body::new(a_new, old.e, old.pom, lam_k - n_new * TK)
+}
+
+fn same_hits(a: &[(f64, f64)], b: &[(f64, f64)]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).all(|(x, y)| (x.0 - y.0).abs() < 1e-3 && (x.1 - y.1).abs() < 1e-3)
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).map(|x| x.parse().unwrap()).unwrap_or(10_000);
+    let rho: f64 = args.get(2).map(|x| x.parse().unwrap()).unwrap_or(1e-4);
+    let sigma_e: f64 = args.get(3).map(|x| x.parse().unwrap()).unwrap_or(1e-2);
+    let seed: u64 = args.get(4).map(|x| x.parse().unwrap()).unwrap_or(20261050);
+    let nb: usize = args.get(5).map(|x| x.parse().unwrap()).unwrap_or(30);
+
+    let sp = spec(n, sigma_e, rho, seed);
+    let b = make_belt(&sp);
+    let sorted = Sorted::new(&b, rho);
+    let horizon = HORIZON * TAU;
+    let kicked: Vec<usize> = (0..nb).map(|q| (q * 97 + 13) % n).collect();
+    let eps_grid = [1e-9f64, 1e-7, 1e-5];
+    let mut setup_pairs_total = 0u64;
+
+    for &eps in &eps_grid {
+        for &rw in &[false, true] {
+            let t0 = std::time::Instant::now();
+            let (mut renewals, mut checks, mut pairs_total, mut hits_total, mut ever_changed) = (0u64, 0u64, 0u64, 0u64, 0u64);
+            // per-pair first-change kick bracket (upper bound), for the distribution.
+            let mut first_change: Vec<usize> = Vec::new();
+            for &i in &kicked {
+                let old = b[i];
+                let mut rng = Rng(seed.wrapping_add(i as u64));
+                let mut signs: Vec<f64> = Vec::with_capacity(KMAX);
+                for _ in 0..KMAX {
+                    signs.push(if rw && (rng.next_u64() & 1) == 1 { -1.0 } else { 1.0 });
+                }
+                // partners under the original orbit (same enumeration as shipped `kick`).
+                let mut partners: Vec<Body> = Vec::new();
+                let (lo, hi) = sorted.range(old.binet()[0], sorted.reach(&old));
+                for &(_, j) in &sorted.order[lo..hi] {
+                    if j as usize == i || !is_candidate(&old, &b[j as usize], rho) {
+                        continue;
+                    }
+                    partners.push(b[j as usize]);
+                }
+                pairs_total += partners.len() as u64;
+                // checkpoint states of body i (a drifts multiplicatively; lambda held at TK).
+                let mut states: Vec<Body> = Vec::with_capacity(GRID.len() + 1);
+                states.push(old);
+                let mut a_k = old.a;
+                let mut n_k = old.n;
+                let mut next = 0usize;
+                for &k in &GRID {
+                    while next < k {
+                        a_k *= 1.0 + eps * signs[next];
+                        n_k = a_k.powf(-1.5);
+                        next += 1;
+                    }
+                    states.push(drifted(&old, a_k, n_k));
+                }
+                for pj in &partners {
+                    let mut st = Stats::default();
+                    let mut prev: Vec<(f64, f64)> = Vec::new();
+                    pair_events(&states[0], pj, rho, SAFETY, TK, TK + horizon, &mut st, &mut prev);
+                    hits_total += prev.len() as u64;
+                    let mut changed_at = 0usize;
+                    for (c, &k) in GRID.iter().enumerate() {
+                        let mut cur: Vec<(f64, f64)> = Vec::new();
+                        let mut st2 = Stats::default();
+                        pair_events(&states[c + 1], pj, rho, SAFETY, TK, TK + horizon, &mut st2, &mut cur);
+                        checks += st2.checks_total();
+                        hits_total += cur.len() as u64;
+                        if !same_hits(&prev, &cur) {
+                            renewals += 1;
+                            if changed_at == 0 {
+                                changed_at = k;
+                            }
+                        }
+                        prev = cur;
+                    }
+                    if changed_at > 0 {
+                        ever_changed += 1;
+                        first_change.push(changed_at);
+                    }
+                }
+            }
+            setup_pairs_total += pairs_total;
+            first_change.sort_unstable();
+            let q = |f: f64| first_change[((first_change.len() as f64 - 1.0) * f) as usize];
+            let renew_per_pair_per_kick = renewals as f64 / pairs_total as f64 / KMAX as f64;
+            let cut = if renewals == 0 { f64::INFINITY } else { (pairs_total as f64 * KMAX as f64) / renewals as f64 };
+            println!(
+                "{{\"exp\":\"cycle\",\"n\":{},\"sigma_e\":{},\"rho\":{},\"seed\":{},\"eps\":{:e},\"drift\":\"{}\",\"bodies\":{},\"pairs\":{},\"ever_changed_pairs\":{},\
+\"renewals\":{},\"renewals_per_pair_per_kick\":{:.3e},\"cut_vs_per_kick\":{:.1},\"checks_per_renewal\":{:.3},\"checks_per_pair_kick\":{:.3e},\
+\"first_change_k_p10\":{},\"first_change_k_median\":{},\"first_change_k_p90\":{},\"wall_s\":{:.1}}}",
+                n, sigma_e, rho, seed, eps, if rw { "rw" } else { "co" }, kicked.len(), pairs_total, ever_changed,
+                renewals, renew_per_pair_per_kick, cut,
+                checks as f64 / renewals.max(1) as f64, checks as f64 / (pairs_total as f64 * KMAX as f64),
+                if first_change.is_empty() { 0 } else { q(0.10) }, if first_change.is_empty() { 0 } else { q(0.50) }, if first_change.is_empty() { 0 } else { q(0.90) },
+                t0.elapsed().as_secs_f64()
+            );
+        }
+    }
+    eprintln!("pairs sampled total (both arms summed): {setup_pairs_total}");
+}
diff --git a/crates/encounters/examples/cycle2.rs b/crates/encounters/examples/cycle2.rs
new file mode 100644
index 00000000..4d009b02
--- /dev/null
+++ b/crates/encounters/examples/cycle2.rs
@@ -0,0 +1,337 @@
+//! Checker probe (20261014-0727-scout-ec41): the SOUND policy's renewal rate vs the oracle's.
+//!
+//! The author's `cycle` measures how often the exact hit SET changes under a cumulative kick
+//! stream (an oracle: detecting a change requires recomputing it). The only implemented sound
+//! certificate is the shipped slack (`kick`'s silent budget: binary-searched for zero-proposal
+//! pairs, hard 0 for proposal-holding pairs). This probe measures the renewal rate of THAT
+//! policy under the same stream, plus the oracle's per-kick churn (the author sampled on a log
+//! grid, which can miss changes), plus the oracle rate at held-out eps.
+//!
+//! Subcommands: pool | sim | churn | oracle.
+
+use emergent_encounters::belt::{make_belt, Rng, Spec};
+use emergent_encounters::dioph;
+use emergent_encounters::kepler::{Body, TICKS};
+use emergent_encounters::method::{pair_events, Stats};
+use emergent_encounters::pairs::{is_candidate, sections, Sorted};
+use std::f64::consts::TAU;
+
+const SAFETY: f64 = 1.1;
+const HORIZON: f64 = 1000.0;
+const TK: f64 = 10.0 * TAU;
+const GRID: [usize; 11] = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024];
+
+fn spec(n: usize, sigma_e: f64, rho: f64, seed: u64) -> Spec {
+    Spec { name: "cycle2".into(), n, sigma_e, rho, a_lo: 1.0, a_hi: 1.5, keys: 0, seed, orbits: 0.0 }
+}
+
+fn drifted(old: &Body, a_new: f64, n_new: f64) -> Body {
+    let lam_k = old.mean_anomaly(TK) + old.pom;
+    Body::new(a_new, old.e, old.pom, lam_k - n_new * TK)
+}
+
+fn same_hits(a: &[(f64, f64)], b: &[(f64, f64)]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).all(|(x, y)| (x.0 - y.0).abs() < 1e-3 && (x.1 - y.1).abs() < 1e-3)
+}
+
+/// Copy of main.rs's private run_section_proposals: proposals in [t0, t1] for one section.
+fn proposals_in(bi: &Body, bj: &Body, sec: &emergent_encounters::pairs::Section, t0: f64, t1: f64) -> u64 {
+    let pi = bi.period as i128;
+    let pj = bj.period as i128;
+    let t0t = (t0 * TICKS) as i128;
+    let t1t = (t1 * TICKS) as i128;
+    let base = sec.tj as i128 + (t0t - sec.tj as i128).div_euclid(pj) * pj;
+    let lmax = (t1t - base).div_euclid(pj);
+    let w1 = sec.w1 as i128;
+    let w = (w1 + sec.w2 as i128).clamp(0, pi - 1);
+    let c0 = (sec.ti as i128 - base + w1).rem_euclid(pi);
+    let d = (pi - pj.rem_euclid(pi)).rem_euclid(pi);
+    let mut q = 0u64;
+    if let Some(k) = dioph::first_hit(c0 as u128, d as u128, pi as u128, 0, w as u128, &mut q) {
+        if (k as i128) <= lmax {
+            return 1;
+        }
+    }
+    0
+}
+
+/// Copy of kick()'s budget: binary search of window widening before any proposal; 0 if the pair
+/// already holds proposals; INFINITY if it has no sections (never renews on drift).
+fn budget_of(bi: &Body, bj: &Body, rho: f64) -> (u64, f64) {
+    let mut hits = Vec::new();
+    let mut st = Stats::default();
+    pair_events(bi, bj, rho, SAFETY, TK, TK + HORIZON * TAU, &mut st, &mut hits);
+    let proposals = st.checks_total();
+    if proposals > 0 {
+        return (proposals, 0.0);
+    }
+    let mut budget = f64::INFINITY;
+    for sec in sections(bi, bj, rho, SAFETY, &mut 0) {
+        let (mut lo_g, mut hi_g) = (0i64, (bi.period as i64) / 4);
+        for _ in 0..40 {
+            let mid = (lo_g + hi_g) / 2;
+            let mut s2 = sec.clone();
+            s2.w1 += mid;
+            s2.w2 += mid;
+            if proposals_in(bi, bj, &s2, TK, TK + HORIZON * TAU) > 0 {
+                hi_g = mid;
+            } else {
+                lo_g = mid;
+            }
+        }
+        budget = budget.min(lo_g as f64 / (HORIZON * TAU * TICKS));
+    }
+    (proposals, budget)
+}
+
+fn partners_of(b: &[Body], sorted: &Sorted, i: usize, rho: f64) -> Vec<Body> {
+    let old = b[i];
+    let mut partners = Vec::new();
+    let (lo, hi) = sorted.range(old.binet()[0], sorted.reach(&old));
+    for &(_, j) in &sorted.order[lo..hi] {
+        if j as usize == i || !is_candidate(&old, &b[j as usize], rho) {
+            continue;
+        }
+        partners.push(b[j as usize]);
+    }
+    partners
+}
+
+/// A1: the budget pool and the sound policy's renewal rate implied by it (co-signed drift:
+/// renewal on the k-th kick after a renewal, k = first with 1.5 * (1.5*eps*k) >= budget).
+fn pool(n: usize, rho: f64, sigma_e: f64, seed: u64, nb: usize, eps_list: &[f64]) {
+    let sp = spec(n, sigma_e, rho, seed);
+    let b = make_belt(&sp);
+    let sorted = Sorted::new(&b, rho);
+    let kicked: Vec<usize> = (0..nb).map(|q| (q * 97 + 13) % n).collect();
+    let mut budgets: Vec<f64> = Vec::new();
+    let mut zero = 0u64;
+    let mut inf = 0u64;
+    let mut pairs = 0u64;
+    for &i in &kicked {
+        for pj in partners_of(&b, &sorted, i, rho) {
+            let (_, bud) = budget_of(&b[i], &pj, rho);
+            pairs += 1;
+            if bud == 0.0 {
+                zero += 1;
+            } else if bud.is_infinite() {
+                inf += 1;
+            } else {
+                budgets.push(bud);
+            }
+        }
+    }
+    budgets.sort_by(|x, y| x.total_cmp(y));
+    let q = |f: f64| budgets[((budgets.len() as f64 - 1.0) * f) as usize];
+    println!(
+        "{{\"exp\":\"pool\",\"n\":{},\"seed\":{},\"bodies\":{},\"pairs\":{},\"frac_proposal_pairs\":{:.4},\"frac_infinite\":{:.4},\"silent_n\":{},\"budget_p01\":{:.3e},\"budget_p10\":{:.3e},\"budget_p50\":{:.3e},\"budget_p90\":{:.3e},\"budget_max\":{:.3e}}",
+        n, seed, nb, pairs, zero as f64 / pairs as f64, inf as f64 / pairs as f64, budgets.len(),
+        q(0.01), q(0.10), q(0.50), q(0.90), budgets[budgets.len() - 1]
+    );
+    // Sound renewal rate with budget redraws from the pool (stationary belt assumption),
+    // KMAX-kick horizon per pair, co-signed eps drift. Rate 1 per kick for proposal pairs.
+    for &eps in eps_list {
+        let kmax = 4096usize;
+        let mut rng = Rng(seed ^ 0x5eed);
+        let mut renewals = 0u64;
+        for _p in 0..pairs {
+            let mut k = 0usize;
+            while k < kmax {
+                let bud = if (rng.next_u64() % pairs as u64) < zero {
+                    0.0
+                } else if budgets.is_empty() {
+                    f64::INFINITY
+                } else {
+                    budgets[(rng.next_u64() % budgets.len() as u64) as usize]
+                };
+                let interval = if bud == 0.0 {
+                    1
+                } else if bud.is_infinite() {
+                    kmax
+                } else {
+                    ((bud / (2.25 * eps)) as usize).max(1)
+                };
+                if interval >= kmax - k {
+                    k = kmax;
+                } else {
+                    renewals += 1;
+                    k += interval;
+                }
+            }
+        }
+        let rate = renewals as f64 / (pairs as f64 * kmax as f64);
+        println!(
+            "{{\"exp\":\"pool-sound\",\"eps\":{:e},\"renewals_per_pair_per_kick\":{:.3e},\"sound_cut_vs_per_kick\":{:.1}}}",
+            eps, rate, 1.0 / rate
+        );
+    }
+}
+
+/// A2: direct simulation of the shipped sound policy with true recomputation at renewal.
+fn sim(n: usize, rho: f64, sigma_e: f64, seed: u64, nb: usize, eps_list: &[f64], kmax: usize) {
+    let sp = spec(n, sigma_e, rho, seed);
+    let b = make_belt(&sp);
+    let sorted = Sorted::new(&b, rho);
+    let kicked: Vec<usize> = (0..nb).map(|q| (q * 97 + 13) % n).collect();
+    for &eps in eps_list {
+        let t0 = std::time::Instant::now();
+        let (mut renewals, mut pairs, mut oracle_missed) = (0u64, 0u64, 0u64);
+        for &i in &kicked {
+            let old = b[i];
+            let partners = partners_of(&b, &sorted, i, rho);
+            pairs += partners.len() as u64;
+            for pj in &partners {
+                let (_, mut bud) = budget_of(&old, pj, rho);
+                let mut a_k = old.a;
+                let mut drift = 0.0f64; // relative period change since last renewal
+                let mut last_hits = {
+                    let mut v = Vec::new();
+                    let mut st = Stats::default();
+                    pair_events(&old, pj, rho, SAFETY, TK, TK + HORIZON * TAU, &mut st, &mut v);
+                    v
+                };
+                for _ in 0..kmax {
+                    a_k *= 1.0 + eps;
+                    let n_k = a_k.powf(-1.5);
+                    drift += 1.5 * eps;
+                    if 1.5 * drift >= bud {
+                        // sound renewal: full re-certification of the drifted pair
+                        renewals += 1;
+                        let cur = drifted(&old, a_k, n_k);
+                        let mut v = Vec::new();
+                        let mut st = Stats::default();
+                        pair_events(&cur, pj, rho, SAFETY, TK, TK + HORIZON * TAU, &mut st, &mut v);
+                        if !same_hits(&last_hits, &v) {
+                            oracle_missed += 1; // renewals that actually changed the hit set
+                        }
+                        last_hits = v;
+                        let (_, nb2) = budget_of(&cur, pj, rho);
+                        bud = nb2;
+                        drift = 0.0;
+                    }
+                }
+            }
+        }
+        let rate = renewals as f64 / (pairs as f64 * kmax as f64);
+        println!(
+            "{{\"exp\":\"sim-sound\",\"eps\":{:e},\"kmax\":{},\"pairs\":{},\"renewals\":{},\"renewals_per_pair_per_kick\":{:.3e},\"sound_cut_vs_per_kick\":{:.1},\"renewals_that_changed_hits\":{},\"wall_s\"::.1}}",
+            eps, kmax, pairs, renewals, rate, 1.0 / rate, oracle_missed, t0.elapsed().as_secs_f64()
+        );
+    }
+}
+
+/// B: oracle churn — per-kick exact recomputation vs the author's log-grid sampling.
+fn churn(n: usize, rho: f64, sigma_e: f64, seed: u64, nb: usize, npairs: usize, eps: f64, kmax: usize) {
+    let sp = spec(n, sigma_e, rho, seed);
+    let b = make_belt(&sp);
+    let sorted = Sorted::new(&b, rho);
+    let kicked: Vec<usize> = (0..nb).map(|q| (q * 97 + 13) % n).collect();
+    let (mut true_events, mut grid_events, mut pairs) = (0u64, 0u64, 0u64);
+    for &i in &kicked {
+        let old = b[i];
+        let partners = partners_of(&b, &sorted, i, rho);
+        let take = partners.len().min(npairs);
+        for pj in partners.iter().take(take) {
+            pairs += 1;
+            let mut states: Vec<Body> = Vec::with_capacity(kmax + 1);
+            states.push(old);
+            let mut a_k = old.a;
+            for _ in 0..kmax {
+                a_k *= 1.0 + eps;
+                states.push(drifted(&old, a_k, a_k.powf(-1.5)));
+            }
+            let mut prev: Vec<(f64, f64)> = Vec::new();
+            let mut st = Stats::default();
+            pair_events(&states[0], pj, rho, SAFETY, TK, TK + HORIZON * TAU, &mut st, &mut prev);
+            let mut prev_grid = prev.clone();
+            let mut grid_idx = 0usize;
+            for k in 1..=kmax {
+                let mut cur: Vec<(f64, f64)> = Vec::new();
+                let mut st2 = Stats::default();
+                pair_events(&states[k], pj, rho, SAFETY, TK, TK + HORIZON * TAU, &mut st2, &mut cur);
+                if !same_hits(&prev, &cur) {
+                    true_events += 1;
+                }
+                prev = cur;
+                if grid_idx < GRID.len() && GRID[grid_idx] == k {
+                    if !same_hits(&prev_grid, &prev) {
+                        grid_events += 1;
+                    }
+                    prev_grid = prev.clone();
+                    grid_idx += 1;
+                }
+            }
+        }
+    }
+    println!(
+        "{{\"exp\":\"churn\",\"eps\":{:e},\"kmax\":{},\"pairs\":{},\"per_kick_change_events\":{},\"grid_detected\":{},\"undercount_factor\":{:.2}}}",
+        eps, kmax, pairs, true_events, grid_events, true_events as f64 / grid_events.max(1) as f64
+    );
+}
+
+/// C: the author's oracle (grid-sampled hit-set change rate) at arbitrary eps and seed.
+fn oracle(n: usize, rho: f64, sigma_e: f64, seed: u64, nb: usize, eps_list: &[f64], rw: bool) {
+    let sp = spec(n, sigma_e, rho, seed);
+    let b = make_belt(&sp);
+    let sorted = Sorted::new(&b, rho);
+    let kicked: Vec<usize> = (0..nb).map(|q| (q * 97 + 13) % n).collect();
+    for &eps in eps_list {
+        let (mut renewals, mut pairs) = (0u64, 0u64);
+        for &i in &kicked {
+            let old = b[i];
+            let mut rng = Rng(seed.wrapping_add(i as u64));
+            let mut signs: Vec<f64> = Vec::with_capacity(1024);
+            for _ in 0..1024 {
+                signs.push(if rw && (rng.next_u64() & 1) == 1 { -1.0 } else { 1.0 });
+            }
+            let partners = partners_of(&b, &sorted, i, rho);
+            pairs += partners.len() as u64;
+            let mut states: Vec<Body> = Vec::with_capacity(GRID.len() + 1);
+            states.push(old);
+            let (mut a_k, mut n_k, mut next) = (old.a, old.n, 0usize);
+            for &k in &GRID {
+                while next < k {
+                    a_k *= 1.0 + eps * signs[next];
+                    n_k = a_k.powf(-1.5);
+                    next += 1;
+                }
+                states.push(drifted(&old, a_k, n_k));
+            }
+            for pj in &partners {
+                let mut prev: Vec<(f64, f64)> = Vec::new();
+                let mut st = Stats::default();
+                pair_events(&states[0], pj, rho, SAFETY, TK, TK + HORIZON * TAU, &mut st, &mut prev);
+                for (c, &_k) in GRID.iter().enumerate() {
+                    let mut cur: Vec<(f64, f64)> = Vec::new();
+                    let mut st2 = Stats::default();
+                    pair_events(&states[c + 1], pj, rho, SAFETY, TK, TK + HORIZON * TAU, &mut st2, &mut cur);
+                    if !same_hits(&prev, &cur) {
+                        renewals += 1;
+                    }
+                    prev = cur;
+                }
+            }
+        }
+        let rate = renewals as f64 / (pairs as f64 * 1024.0);
+        println!(
+            "{{\"exp\":\"oracle\",\"eps\":{:e},\"drift\":\"{}\",\"seed\":{},\"pairs\":{},\"renewals\":{},\"renewals_per_pair_per_kick\":{:.3e},\"oracle_cut_vs_per_kick\":{:.1}}}",
+            eps, if rw { "rw" } else { "co" }, seed, pairs, renewals, rate, 1.0 / rate
+        );
+    }
+}
+
+fn nums(args: &[String]) -> Vec<f64> {
+    args.iter().map(|x| x.parse().unwrap()).collect()
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let (n, rho, sigma_e, seed, nb) = (10000usize, 1e-4, 1e-2, 20261050u64, 20usize);
+    match args[1].as_str() {
+        "pool" => pool(n, rho, sigma_e, seed, 24, &nums(&args[2..])),
+        "sim" => sim(n, rho, sigma_e, seed, 4, &nums(&args[2..args.len() - 1]), args[args.len() - 1].parse().unwrap()),
+        "churn" => churn(n, rho, sigma_e, seed, 3, 200, args[2].parse().unwrap(), args[3].parse().unwrap()),
+        "oracle" => oracle(n, rho, sigma_e, args[2].parse().unwrap(), 20, &nums(&args[3..args.len() - 1]), args[args.len() - 1] == "rw"),
+        _ => eprintln!("usage: cycle2 pool <eps..> | sim <eps..> <kmax> | churn <eps> <kmax> | oracle <seed> <eps..> co|rw"),
+    }
+}
