+//! Digest control for the lab probe: the same flights as tests/lab_faulttag.rs, run on the
+//! unpatched tree to show the `end` word changed no canonical outcome. `cargo run --release --example lab_digest`.
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust;
+use emergent_universe::Config;
+
+fn flight(name: &str, leave_log2: i32, word: u8, horizon: i64) {
+    let mut p = plane(Config { leave_log2, ..Config::default() }, 7, emergent_universe::fleet::Order::Sparse, 4, 16).unwrap();
+    let player = p.player;
+    p.u.schedule(10_000_000, word).unwrap();
+    p.u.settle(horizon);
+    let r = p.u.rec(player);
+    println!("{name}: alive={} fault={:?} event_time={} digest {}", r.alive, r.fault, r.b.event_time, &p.u.digest()[..32]);
+}
+
+fn main() {
+    flight("crash", 40, thrust::word(1, 1), 200_000_000);
+    flight("leave-tight15", 30, thrust::word(1, 15), 20_000_000_000);
+}
