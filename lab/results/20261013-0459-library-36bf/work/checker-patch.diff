+//! CHECKER control (20261013-0459-library-36bf): two-build digest identity on flights the
+//! author's control did not cover — the long leave-tight8 plane flight (1.24e10 ticks, fleets
+//! and encounters live) and the constructed planet-death scene. Prints no `end` field, so it
+//! compiles on the unpatched tree too: run, stash the patch, run again, compare digests.
+use emergent_space::orbit::Scalar;
+use emergent_universe::scenario::{plane, STAR_RADIUS};
+use emergent_universe::thrust;
+use emergent_universe::{Config, Kind, OrbitSpec, Universe};
+
+fn plane_flight(name: &str, leave_log2: i32, word: u8, horizon: i64) {
+    let mut p = plane(Config { leave_log2, ..Config::default() }, 7, emergent_universe::fleet::Order::Sparse, 4, 16).unwrap();
+    let player = p.player;
+    p.u.schedule(10_000_000, word).unwrap();
+    p.u.settle(horizon);
+    let r = p.u.rec(player);
+    println!("{name}: alive={} fault={:?} event_time={} digest {}", r.alive, r.fault, r.b.event_time, &p.u.digest()[..32]);
+}
+
+fn planet_scene() {
+    let mut u = Universe::new(Scalar::raw(STAR_RADIUS as i128, 0).unwrap(), Config::default());
+    let p = u
+        .add_body(
+            Kind::Planet,
+            OrbitSpec { doll: 0, periapsis: Scalar::raw(500_000_000, 0).unwrap(), e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+            Scalar::ZERO,
+        )
+        .unwrap();
+    u.add_doll("P", p, -10, Scalar::raw(47_400, 10).unwrap()).unwrap();
+    let (pp, pv) = u.rec(p).b.cartesian(0).unwrap();
+    let player = u
+        .add_body_state(Kind::Player, 0, [pp[0].add(Scalar::raw(47_400 / 2, 0).unwrap()).unwrap(), pp[1]], [pv[0], pv[1]], Scalar::raw(34, -10).unwrap())
+        .unwrap();
+    u.start().unwrap();
+    u.settle(20_000_000);
+    let r = u.rec(player);
+    println!("planet-scene: alive={} fault={:?} event_time={} digest {}", r.alive, r.fault, r.b.event_time, &u.digest()[..32]);
+}
+
+fn main() {
+    plane_flight("leave-tight8", 30, thrust::word(1, 8), 20_000_000_000);
+    planet_scene();
+}
