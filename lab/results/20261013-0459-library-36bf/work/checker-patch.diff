diff --git a/crates/universe/tests/check_planet_end.rs b/crates/universe/tests/check_planet_end.rs
new file mode 100644
index 00000000..8f85269b
--- /dev/null
+++ b/crates/universe/tests/check_planet_end.rs
@@ -0,0 +1,39 @@
+//! CHECKER probe (20261013-0459-library-36bf): demonstrate `End::Planet` in flight, the one
+//! variant the author wired but never flew. A minimal system built from the shipped API alone:
+//! star (doll 0), one planet with its own doll (so it is a secondary source of doll 0), and the
+//! player added by state inside the planet's surface, co-moving with it. The player is a root
+//! doll body, so the motion law v2 steps it on the clock and its first kick must find it inside
+//! the planet's surface: `end = Some(Planet)`, `fault = None`.
+use emergent_space::orbit::Scalar;
+use emergent_universe::{scenario, Config, Kind, OrbitSpec, Universe};
+
+#[test]
+fn planet_end_is_reachable_and_silent_on_main() {
+    let mut u = Universe::new(Scalar::raw(scenario::STAR_RADIUS as i128, 0).unwrap(), Config::default());
+    let p = u
+        .add_body(
+            Kind::Planet,
+            OrbitSpec { doll: 0, periapsis: Scalar::raw(500_000_000, 0).unwrap(), e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+            Scalar::ZERO,
+        )
+        .unwrap();
+    // The planet's radius: 47,400 root units, expressed in its own doll's units (root × 2^-mass_log2).
+    let surface = Scalar::raw(47_400, 10).unwrap();
+    u.add_doll("P", p, -10, surface).unwrap();
+    let (pp, pv) = u.rec(p).b.cartesian(0).unwrap();
+    let half = Scalar::raw(47_400 / 2, 0).unwrap();
+    // Inside the surface, co-moving with the planet.
+    let player = u
+        .add_body_state(Kind::Player, 0, [pp[0].add(half).unwrap(), pp[1]], [pv[0], pv[1]], Scalar::raw(34, -10).unwrap())
+        .unwrap();
+    u.start().unwrap();
+    u.settle(20_000_000);
+    let r = u.rec(player);
+    println!(
+        "planet-flight: alive={} end={:?} fault={:?} event_time={} refusals={} digest {}",
+        r.alive, r.end, r.fault, r.b.event_time, r.refusals, &u.digest()[..32]
+    );
+    assert!(!r.alive, "the player must die inside the planet");
+    assert_eq!(r.end, Some(emergent_universe::body::End::Planet), "the death must read Planet");
+    assert_eq!(r.fault, None, "the death is silent on main: no fault");
+}
diff --git a/crates/universe/tests/lab_faulttag.rs b/crates/universe/tests/lab_faulttag.rs
new file mode 100644
index 00000000..b0fc7aa4
--- /dev/null
+++ b/crates/universe/tests/lab_faulttag.rs
@@ -0,0 +1,37 @@
+//! Lab probe 20261013-0459-library-36bf: the three silent ends told apart.
+//!
+//! On main, a crash into the star, a hit on a planet and a leave past the system's edge all end
+//! the body the same way: `alive = false`, `fault = None` (lab wiki, high-gamma-clock: "the
+//! record cannot tell them apart"). The patch adds one word, `BodyRec::end`, set at the seven
+//! `Resolved::Lost` sites of `step.rs` and nowhere else; it is not a digest input, so no
+//! canonical outcome moves. These flights are settle-based (as the wiki's), seed 7.
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust;
+use emergent_universe::Config;
+
+/// One settle-based flight: schedule the held word, settle to `horizon`, report the player's end.
+fn flight(name: &str, leave_log2: i32, word: u8, horizon: i64) {
+    let t0 = std::time::Instant::now();
+    let mut p = plane(Config { leave_log2, ..Config::default() }, 7, emergent_universe::fleet::Order::Sparse, 4, 16).unwrap();
+    let player = p.player;
+    p.u.schedule(10_000_000, word).unwrap();
+    p.u.settle(horizon);
+    let r = p.u.rec(player);
+    let d = p.u.digest();
+    println!(
+        "{name}: keys={:#04x} leave_log2={leave_log2} horizon={horizon:.3e} alive={} end={:?} fault={:?} event_time={} refusals={} ({:.1}s) digest {}",
+        word, r.alive, r.end, r.fault, r.b.event_time, r.refusals, t0.elapsed().as_secs_f64(), &d[..32]
+    );
+}
+
+#[test]
+fn the_three_silent_ends_are_told_apart() {
+    // 1. The crash: a held gentle burn puts the periapsis under the star's surface.
+    flight("crash", 40, thrust::word(1, 1), 200_000_000);
+    // 2. The leave: prediction 2's horizon (2e9) was too short (reported as failed); the climb
+    //    continues, so run the same tight cage (2^30 root units) to 2e10, levels 8 and 15.
+    flight("leave-tight8", 30, thrust::word(1, 8), 20_000_000_000);
+    flight("leave-tight15", 30, thrust::word(1, 15), 20_000_000_000);
+    // 3. The control: the same strong burn in the default cage must not read Leave at 2e9.
+    flight("leave-wide8", 40, thrust::word(1, 8), 2_000_000_000);
+}
