+    /// How the body ended, when it is not alive and no error refused it: the one word the
+    /// record could not tell apart before (crash, planet, leave). Not a digest input.
+    pub end: Option<End>,
+}
+
+/// The silent ends, told apart: the star's (or any doll's) surface, a planet's surface, the
+/// system's edge. All three read `fault = None`; only this word separates them.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum End {
+    Crash,
+    Planet,
+    Leave,
 }
 
