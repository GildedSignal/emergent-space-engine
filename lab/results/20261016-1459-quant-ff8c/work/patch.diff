+//! `apply`'s position walk (stage ROOT) against the carried state (`ES_POS_CARRY`): one belt
+//! flight (the plane with N more ships, the player coasting) through the first kick wave and past
+//! it, with the stage profile, the carry's counters and the digest at the canonical cut. Run the
+//! same command with and without `ES_POS_CARRY`/`ES_POS_VERIFY` in the environment and diff.
+//!
+//! cargo run --release -p emergent-universe --features prof --example pos_carry [-- <N> <game seconds> <rtf>]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(100_000);
+    let seconds: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(20.0);
+    let rtf: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(1000.0);
+    let cut = (seconds * rtf / TICK_SECONDS) as i64;
+    let (on, verify) = emergent_universe::universe::pos_carry();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let t0 = Instant::now();
+    let mut frames = 0usize;
+    let (mut stage_ns, mut stage_calls) = ([0u64; emergent_universe::prof::N], [0u64; emergent_universe::prof::N]);
+    for _ in 0..400_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        let start = Instant::now();
+        let _ = emergent_universe::prof::take();
+        p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_millis(12)) }, cut);
+        let (ns, calls) = emergent_universe::prof::take();
+        for k in 0..emergent_universe::prof::N {
+            stage_ns[k] += ns[k];
+            stage_calls[k] += calls[k];
+        }
+        frames += 1;
+    }
+    p.u.settle(cut);
+    let wall = t0.elapsed().as_secs_f64();
+    println!("arm on={on} verify={verify} N={n} game_s={:.0} frames={frames} wall={wall:.2}s bodies={}", seconds * rtf, p.u.n_bodies());
+    println!("digest {}", p.u.digest());
+    println!("kicks {} boundaries {} opens {} refused {} lost {}", p.u.stats.kicks, p.u.stats.boundaries, p.u.stats.opens, p.u.stats.refused, p.u.stats.lost);
+    for k in 0..emergent_universe::prof::N {
+        if stage_calls[k] > 0 {
+            println!("stage {:38} calls {:>9} ns {:>12} ns/call {:>8.1}", emergent_universe::prof::NAMES[k], stage_calls[k], stage_ns[k], stage_ns[k] as f64 / stage_calls[k] as f64);
+        }
+    }
+    let kicks = stage_calls[emergent_universe::prof::P_KICK_CLOCK].max(1);
+    println!("ROOT total {:.3} s, {:.1} ns/call, {} calls, {:.2} walks/kick", stage_ns[emergent_universe::prof::ROOT] as f64 / 1e9, stage_ns[emergent_universe::prof::ROOT] as f64 / stage_calls[emergent_universe::prof::ROOT].max(1) as f64, stage_calls[emergent_universe::prof::ROOT], stage_calls[emergent_universe::prof::ROOT] as f64 / kicks as f64);
+    println!("kick_clock total {:.3} s over {} kicks = {:.1} us/kick", stage_ns[emergent_universe::prof::P_KICK_CLOCK] as f64 / 1e9, kicks, stage_ns[emergent_universe::prof::P_KICK_CLOCK] as f64 / 1e3 / kicks as f64);
+    use std::sync::atomic::Ordering::Relaxed;
+    println!("carry hits {} skips {} walks {} mismatch {} walk_err {}", emergent_universe::universe::POS_HITS.load(Relaxed), emergent_universe::universe::POS_SKIPS.load(Relaxed), emergent_universe::universe::POS_WALKS.load(Relaxed), emergent_universe::universe::POS_MISMATCH.load(Relaxed), emergent_universe::universe::POS_WALK_ERR.load(Relaxed));
+}
