 }
 
+/// The position half of [`root_state_raw`] for a body whose state at `t` is already in hand
+/// (`state`, in the units of `doll`): what a freshly bound tube holds at its own event tick, so
+/// only the doll chain above it is walked. The arithmetic is `root_state_with`'s own half,
+/// operation for operation.
+pub fn root_pos_from(ctx: &Ctx, doll: u16, state: (V2, V2), t: Tick) -> Res<[f64; 2]> {
+    let k = 2f64.powi(-(ctx.dolls[doll as usize].shift as i32));
+    let (p, _) = state;
+    let mut pos = [to_f64(p[0]) * k, to_f64(p[1]) * k];
+    if let Some(c) = ctx.dolls[doll as usize].centre {
+        let (cp, _) = root_state_with(ctx, c, t, false)?;
+        pos = [pos[0] + cp[0], pos[1] + cp[1]];
+    }
+    Ok(pos)
+}
