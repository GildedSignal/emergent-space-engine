+/// `ES_POS_CARRY` deletes `apply`'s position walk where its value is already in hand: a rebound
+/// body carries the state its binding holds at the event tick (bit for bit, `bind.rs`), and a
+/// body nothing rebound still has the same binding at the same event tick, so the cache is the
+/// walk's exact result. `ES_POS_VERIFY` turns the carry on and re-walks every hit to compare.
+/// Neither set: the engine is what it was.
+pub fn pos_carry() -> (bool, bool) {
+    static G: std::sync::LazyLock<(bool, bool)> = std::sync::LazyLock::new(|| {
+        let verify = std::env::var("ES_POS_VERIFY").is_ok();
+        (verify || std::env::var("ES_POS_CARRY").is_ok(), verify)
+    });
+    *G
+}
