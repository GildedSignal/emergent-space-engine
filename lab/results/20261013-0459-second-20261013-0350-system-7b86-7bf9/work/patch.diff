new file mode 100644
index 00000000..b48c264a
--- /dev/null
+++ b/crates/universe/examples/quad_slot.rs
@@ -0,0 +1,170 @@
+//! One missing slot, three consumers: does a stored acceleration serve every between-events reader?
+//!
+//! The shipped plane derives a body's between-events state through three separate mechanisms, none of
+//! which stores the acceleration: `observe::partial` re-evaluates `force::field` at every read (the
+//! view's frame constraint), the gravity version payload omits it (the measured ½·a·T² lag), and a
+//! held burn rekeys the velocity word every 1/64 of |v| (the waterfall). This probe measures, on the
+//! frame-cost scenes flown deterministically, whether the acceleration the last committed kick already
+//! stored (`kick.dv / kick.len`) reproduces `partial`'s fresh evaluation within the readers' quanta,
+//! over the real read windows; and, for the gravity consumer, what a quadratic version payload leaves
+//! over the scene's light window against the linear payload.
+//!
+//! cargo run --release -p emergent-universe --example quad_slot [-- <wall seconds per flight>]
+use emergent_universe::bind::Binding;
+use emergent_universe::num::{to_f64, Tick};
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::view::{gather_cached, ViewCache, TICK_SECONDS};
+use emergent_universe::{fleet::Order, Budget, Config};
+use std::time::{Duration, Instant};
+
+/// Keys: 1 forward, 2 reverse, 4 left, 8 right. The frame-cost scenes (paced 8 s).
+fn flights() -> Vec<(String, Vec<(f64, u8, u8)>)> {
+    vec![
+        ("coast".into(), vec![]),
+        ("forward L8".into(), vec![(1.0, 1, 8)]),
+        ("forward L12".into(), vec![(1.0, 1, 12)]),
+        ("forward L15".into(), vec![(1.0, 1, 15)]),
+        ("brake L8".into(), vec![(1.0, 2, 8)]),
+        ("turn left then burn L8".into(), vec![(1.0, 4, 8), (2.0, 0, 8), (2.5, 1, 8), (8.0, 0, 8)]),
+    ]
+}
+
+struct Acc {
+    ax: f64,
+    ay: f64,
+}
+
+/// The field acceleration `partial` evaluates: `force::field` at the tube's position at `mid`.
+fn a_fresh(ctx: &emergent_universe::ctx::Ctx, b: &Binding, i: usize, mid: Tick) -> Option<Acc> {
+    let (x, _) = b.cartesian(mid).ok()?;
+    let f = emergent_universe::force::field(&ctx.secondaries(b.doll, mid, i).ok()?, x).ok()?;
+    Some(Acc { ax: to_f64(f.accel[0]), ay: to_f64(f.accel[1]) })
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let seconds: f64 = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(8.0);
+    let frames = (seconds * 60.0) as usize;
+    println!("paced {seconds} s per flight, {frames} frames at 60 Hz, rtf 100, seed 1, 48 members");
+    println!("read quantum: the gather reads integer ticks; 1 root tick = {:.3e} s of light", TICK_SECONDS);
+    println!(
+        "{:<22} {:>6} {:>7} {:>9} {:>8} {:>6} {:>10} {:>10} {:>10} {:>9} {:>9}",
+        "flight", "frames", "clock%", "rd/body/f", "no-stor", "|a|>0", "e_p50 tick", "e_p99 tick", "e_max tick", "ev_p99", "rel_p99"
+    );
+    for (name, script) in flights() {
+        let mut p = plane(Config::default(), 1, Order::Sparse, 1, 48).unwrap();
+        let n = p.u.n_bodies();
+        let names: Vec<String> = (0..n).map(|i| format!("b{i}")).collect();
+        let mut cache = ViewCache::default();
+        let mut next = 0usize;
+        let (mut readouts, mut samples, mut nostored, mut nonzero) = (0u64, 0u64, 0u64, 0u64);
+        let (mut clock_reads, mut total_reads) = (0u64, 0u64);
+        let mut epos: Vec<f64> = Vec::new();
+        let mut evel: Vec<f64> = Vec::new();
+        let mut erel: Vec<f64> = Vec::new();
+        let mut done = 0usize;
+        for f in 0..frames {
+            let wall = f as f64 / 60.0;
+            while next < script.len() && script[next].0 <= wall {
+                let (_, keys, level) = script[next];
+                let t = p.u.now;
+                let _ = p.u.input(t, word(keys, level));
+                next += 1;
+            }
+            let start = Instant::now();
+            let frame = p.u.frame_to(
+                1.0 / 60.0,
+                100.0,
+                Budget { events: u64::MAX, until: Some(start + Duration::from_millis(12)) },
+                i64::MAX,
+            );
+            done = f + 1;
+            if gather_cached(&p.u, &names, &mut cache).is_some() {
+                readouts += cache.readouts;
+            }
+            let t_now = frame.presented;
+            let ctx = p.u.ctx();
+            let bodies = p.u.bodies();
+            let player = p.player;
+            for i in 0..n {
+                total_reads += 1;
+                let Some(b) = bodies.binding_at(i, t_now) else { continue };
+                if !b.kick.clock {
+                    continue; // the ramp path already reads the stored kicks (`credit`)
+                }
+                clock_reads += 1;
+                let shift = ctx.dolls[b.doll as usize].shift as i32;
+                let ct = 2f64.powi(b.clock_exp as i32); // doll time units per tick
+                let len = b.kick.len.max(1);
+                let start_b = if t_now >= b.kick.boundary { b.kick.boundary } else { b.event_time - b.kick.lead };
+                // the acceleration the last committed kick stored: its dv over its window
+                let a_st = (|| {
+                    let prev = bodies.binding_at(i, start_b.saturating_sub(1))?;
+                    let k = prev.kick;
+                    if !k.clock || k.len != len || k.len == 0 {
+                        return None;
+                    }
+                    let ve = prev.units.1 as i32;
+                    Some(Acc {
+                        ax: (k.dv[0] as f64) * 2f64.powi(ve) / (k.len as f64 * ct),
+                        ay: (k.dv[1] as f64) * 2f64.powi(ve) / (k.len as f64 * ct),
+                    })
+                })();
+                for &frac in &[0.25, 0.5, 1.0, 1.5, 2.0] {
+                    let tau = (len as f64 * frac) as i64;
+                    if tau <= 0 || start_b + tau / 2 > t_now || start_b + tau > t_now + len {
+                        continue;
+                    }
+                    let mid = start_b + tau / 2;
+                    let Some(a_f) = a_fresh(&ctx, &b, i, mid) else { continue };
+                    let tau_s = tau as f64 * ct;
+                    let a_mag = (a_f.ax * a_f.ax + a_f.ay * a_f.ay).sqrt();
+                    if a_mag > 0.0 {
+                        nonzero += 1;
+                    }
+                    match &a_st {
+                        Some(a_s) => {
+                            let (dx, dy) = (a_f.ax - a_s.ax, a_f.ay - a_s.ay);
+                            let da = (dx * dx + dy * dy).sqrt();
+                            epos.push(0.5 * da * tau_s * tau_s * 2f64.powi(-shift));
+                            evel.push(da * tau_s);
+                            if a_mag > 0.0 {
+                                erel.push(da / a_mag);
+                            }
+                            samples += 1;
+                        }
+                        None => nostored += 1,
+                    }
+                }
+            }
+            if !p.u.rec(p.player).alive {
+                break;
+            }
+        }
+        epos.sort_by(|a, b| a.total_cmp(b));
+        evel.sort_by(|a, b| a.total_cmp(b));
+        erel.sort_by(|a, b| a.total_cmp(b));
+        let q = |v: &Vec<f64>, f: f64| {
+            if v.is_empty() {
+                0.0
+            } else {
+                v[((v.len() as f64 * f.min(1.0)) as usize).saturating_sub(1)]
+            }
+        };
+        println!(
+            "{:<22} {:>6} {:>6.1}% {:>9.2} {:>8} {:>5.1}% {:>10.2e} {:>10.2e} {:>10.2e} {:>9.2e} {:>9.2e}",
+            name,
+            done,
+            100.0 * clock_reads as f64 / total_reads.max(1) as f64,
+            readouts as f64 / done.max(1) as f64 / n as f64,
+            nostored,
+            100.0 * nonzero as f64 / samples.max(1) as f64,
+            q(&epos, 0.50),
+            q(&epos, 0.99),
+            epos.last().copied().unwrap_or(0.0),
+            q(&evel, 0.99),
+            q(&erel, 0.99)
+        );
+    }
+}
diff --git a/crates/universe/examples/slot_ab.rs b/crates/universe/examples/slot_ab.rs
new file mode 100644
index 00000000..6d22d7af
--- /dev/null
+++ b/crates/universe/examples/slot_ab.rs
@@ -0,0 +1,214 @@
+//! The deletion measured (run 20261013-0459, second author on 7b86): the checker's named experiment —
+//! land the tube-only read (`observe::TUBE_ONLY_READS`: the view's per-read `force::field` evaluation
+//! deleted, the e0 form both checkers validated) and measure, on 7b86's own scenes, interleaved in
+//! one binary (so machine load hits both sides equally):
+//!
+//!   - the digest, bit for bit, fresh read vs deleted read (no law change);
+//!   - what the player's instrument changes by: per-seen position deltas in root ticks, Doppler shift
+//!     deltas, and frames whose visible id sets differ;
+//!   - the gather's cost and share of the frame, and the p99 frame, fresh vs deleted.
+//!
+//! Frames are not wall-cut (`Budget::until = None`): every number below is deterministic given the
+//! machine, and the A/B pair flies identical simulations (the view never writes).
+//!
+//! cargo run --release -p emergent-universe --example slot_ab [-- <reps, default 3>]
+use emergent_universe::observe::TUBE_ONLY_READS;
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::view::{gather_cached, ViewCache, TICK_SECONDS};
+use emergent_universe::{fleet::Order, Budget, Config};
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+/// (name, members, frames, script): the keys are 1 forward, 2 reverse, 4 left; the level is the burn's.
+fn flights() -> Vec<(String, u64, usize, Vec<(f64, u8, u8)>)> {
+    // SLOT_DENSE_FRAMES (default 240) lengthens the dense-fleet attack: at 240 frames no read has
+    // yet taken the partial path there (the fleet is read through its motions, the planets ride the
+    // stored ramp), so the default shows the empty side of the census and the env shows the phase.
+    let dense: usize = std::env::var("SLOT_DENSE_FRAMES").ok().and_then(|s| s.parse().ok()).unwrap_or(240);
+    vec![
+        ("coast".into(), 48, 480, vec![]),
+        ("forward L8".into(), 48, 480, vec![(1.0, 1, 8)]),
+        ("forward L12".into(), 48, 480, vec![(1.0, 1, 12)]),
+        ("forward L15".into(), 48, 480, vec![(1.0, 1, 15)]),
+        ("brake L8".into(), 48, 480, vec![(1.0, 2, 8)]),
+        ("turn left then burn L8".into(), 48, 480, vec![(1.0, 4, 8), (2.0, 0, 8), (2.5, 1, 8), (8.0, 0, 8)]),
+        ("dense 400 forward L12".into(), 400, dense, vec![(1.0, 1, 12)]),
+    ]
+}
+
+struct Run {
+    frames: usize,
+    eng_p99_ms: f64,
+    gat_p50_ms: f64,
+    gat_p99_ms: f64,
+    frame_p99_ms: f64,
+    share_p50: f64,
+    readouts: u64,
+    fresh: u64,
+    bodies: usize,
+    digest: String,
+    /// per frame: (id, offset [s], Doppler shift)
+    seen: Vec<Vec<(usize, [f64; 2], f64)>>,
+}
+
+fn fly(members: u64, frames: usize, script: &[(f64, u8, u8)], tube_only: bool, keep_seen: bool) -> Run {
+    TUBE_ONLY_READS.store(tube_only, Ordering::Relaxed);
+    emergent_universe::observe::FRESH_READS.store(0, Ordering::Relaxed);
+    let mut p = plane(Config::default(), 1, Order::Sparse, 1, members).unwrap();
+    let n = p.u.n_bodies();
+    let names: Vec<String> = (0..n).map(|i| format!("b{i}")).collect();
+    let mut cache = ViewCache::default();
+    let mut next = 0usize;
+    let mut eng: Vec<f64> = Vec::with_capacity(frames);
+    let mut gat: Vec<f64> = Vec::with_capacity(frames);
+    let mut seen: Vec<Vec<(usize, [f64; 2], f64)>> = Vec::with_capacity(frames);
+    let mut readouts = 0u64;
+    let mut done = 0usize;
+    for f in 0..frames {
+        let wall = f as f64 / 60.0;
+        while next < script.len() && script[next].0 <= wall {
+            let (_, keys, level) = script[next];
+            let t = p.u.now;
+            let _ = p.u.input(t, word(keys, level));
+            next += 1;
+        }
+        let t0 = Instant::now();
+        let _ = p.u.frame_to(1.0 / 60.0, 100.0, Budget { events: u64::MAX, until: None }, i64::MAX);
+        let t1 = Instant::now();
+        if let Some(v) = gather_cached(&p.u, &names, &mut cache) {
+            readouts += cache.readouts;
+            if keep_seen {
+                seen.push(v.seen.iter().map(|s| (s.id, s.offset, s.shift)).collect());
+            }
+        }
+        let t2 = Instant::now();
+        done = f + 1;
+        eng.push((t1 - t0).as_secs_f64() * 1e3);
+        gat.push((t2 - t1).as_secs_f64() * 1e3);
+        if !p.u.rec(p.player).alive {
+            break;
+        }
+    }
+    TUBE_ONLY_READS.store(false, Ordering::Relaxed);
+    let digest = p.u.digest();
+    let q = |v: &mut Vec<f64>, p: f64| {
+        if v.is_empty() {
+            return 0.0;
+        }
+        v.sort_by(|a, b| a.total_cmp(b));
+        v[((v.len() as f64 * p).ceil() as usize).saturating_sub(1).min(v.len() - 1)]
+    };
+    let (mut e99, mut g50, mut g99, mut sh50) = (eng.clone(), gat.clone(), gat.clone(), Vec::new());
+    let (e99, g50, g99) = (q(&mut e99, 0.99), q(&mut g50, 0.50), q(&mut g99, 0.99));
+    let frame: Vec<f64> = eng.iter().zip(&gat).map(|(a, b)| a + b).collect();
+    let mut f99 = frame.clone();
+    for (a, b) in eng.iter().zip(&gat) {
+        sh50.push(b / (a + b).max(1e-9));
+    }
+    let share_p50 = q(&mut sh50, 0.50);
+    Run {
+        frames: done,
+        eng_p99_ms: e99,
+        gat_p50_ms: g50,
+        gat_p99_ms: g99,
+        frame_p99_ms: q(&mut f99, 0.99),
+        share_p50,
+        readouts,
+        fresh: emergent_universe::observe::FRESH_READS.load(Ordering::Relaxed),
+        bodies: n,
+        digest,
+        seen,
+    }
+}
+
+fn median(v: &mut Vec<f64>) -> f64 {
+    if v.is_empty() {
+        return 0.0;
+    }
+    v.sort_by(|a, b| a.total_cmp(b));
+    v[v.len() / 2]
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let reps: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(3);
+    println!("slot_ab: the deletion measured — fresh `force::field` read vs tube-only, one binary, interleaved");
+    println!("linux/x86 shared box: read orders of magnitude; the integrator re-measures on the M1\n");
+
+    // 1. Digest and instrument deltas: one deterministic pair per scene, view recorded every frame.
+    println!("== digest and instrument (deterministic pair per scene, no wall cut) ==");
+    println!(
+        "{:<24} {:>7} {:>8}  {:>10} {:>10} {:>10}  {:>10} {:>6}  {}",
+        "scene", "frames", "digest", "dp50 tick", "dp99 tick", "dmax tick", "dshift99", "idset", "bodies seen"
+    );
+    for (name, members, frames, script) in flights() {
+        let a = fly(members, frames, &script, false, true);
+        let b = fly(members, frames, &script, true, true);
+        let same_digest = if a.digest == b.digest { "same" } else { "DIFFER" };
+        let (mut dt, mut dsh) = (Vec::new(), Vec::new());
+        let mut id_diff = 0usize;
+        for (fa, fb) in a.seen.iter().zip(&b.seen) {
+            let ia: Vec<usize> = fa.iter().map(|s| s.0).collect();
+            let ib: Vec<usize> = fb.iter().map(|s| s.0).collect();
+            if ia != ib {
+                id_diff += 1;
+                continue;
+            }
+            for (sa, sb) in fa.iter().zip(fb) {
+                if sa.0 != sb.0 {
+                    continue;
+                }
+                let d = ((sa.1[0] - sb.1[0]).powi(2) + (sa.1[1] - sb.1[1]).powi(2)).sqrt() / TICK_SECONDS;
+                dt.push(d);
+                dsh.push((sa.2 - sb.2).abs());
+            }
+        }
+        let q = |v: &mut Vec<f64>, p: f64| {
+            if v.is_empty() {
+                0.0
+            } else {
+                v.sort_by(|a, b| a.total_cmp(b));
+                v[((v.len() as f64 * p).ceil() as usize).saturating_sub(1).min(v.len() - 1)]
+            }
+        };
+        let dmax = dt.iter().fold(0.0f64, |m, &x| m.max(x));
+        let (mut p50, mut p99) = (dt.clone(), dt.clone());
+        let (dp50, dp99) = (q(&mut p50, 0.50), q(&mut p99, 0.99));
+        let mut s99 = dsh.clone();
+        println!(
+            "{:<24} {:>7} {:>8}  {:>10.2e} {:>10.2e} {:>10.2e}  {:>10.2e} {:>6}  {}",
+            name, a.frames, same_digest, dp50, dp99, dmax, q(&mut s99, 0.99), id_diff, a.seen.last().map(|s| s.len()).unwrap_or(0)
+        );
+    }
+
+    // 2. The cost: interleaved A/B, reps each, medians reported.
+    println!(
+        "{:<24} {:>4} {:>9} {:>9} {:>9} {:>9} {:>9} {:>8} {:>8} {:>8}",
+        "scene", "cfg", "gat_p50", "gat_p99", "eng_p99", "frame99", "share50", "part/f", "part%", "rd/b/f"
+    );
+    for (name, members, frames, script) in flights() {
+        let reps = if members > 100 { reps.min(2) } else { reps };
+        let mut runs = (Vec::new(), Vec::new());
+        for _ in 0..reps {
+            runs.0.push(fly(members, frames, &script, false, false));
+            runs.1.push(fly(members, frames, &script, true, false));
+        }
+        let col = |rs: &Vec<Run>, f: &dyn Fn(&Run) -> f64| median(&mut rs.iter().map(f).collect());
+        for (tag, rs) in [("fresh", &runs.0), ("tube", &runs.1)] {
+            println!(
+                "{:<24} {:>4} {:>8.2}ms {:>8.2}ms {:>8.2}ms {:>8.2}ms {:>7.1}% {:>8.1} {:>7.1}% {:>8.2}",
+                name, tag, col(rs, &|r| r.gat_p50_ms), col(rs, &|r| r.gat_p99_ms), col(rs, &|r| r.eng_p99_ms),
+                col(rs, &|r| r.frame_p99_ms), 100.0 * col(rs, &|r| r.share_p50),
+                col(rs, &|r| r.fresh as f64 / r.frames.max(1) as f64),
+                100.0 * col(rs, &|r| r.fresh as f64 / r.readouts.max(1) as f64),
+                col(rs, &|r| r.readouts as f64 / r.frames.max(1) as f64 / r.bodies as f64)
+            );
+        }
+        let (g, fh) = (
+            col(&runs.0, &|r| r.gat_p50_ms) / col(&runs.1, &|r| r.gat_p50_ms).max(1e-9),
+            col(&runs.0, &|r| r.frame_p99_ms) / col(&runs.1, &|r| r.frame_p99_ms).max(1e-9),
+        );
+        println!("{:<60} {:>8.2}x {:>8.2}x", format!("{name}: gain fresh/tube"), g, fh);
+    }
+}
diff --git a/crates/universe/src/observe.rs b/crates/universe/src/observe.rs
index 5d15c9d9..c7d11e7e 100644
--- a/crates/universe/src/observe.rs
+++ b/crates/universe/src/observe.rs
@@ -113,6 +113,17 @@ pub fn credit(bodies: &dyn BodyStore, i: usize, t: Tick, b: &Binding) -> Res<(V2
 /// The tube is the binding that was current at `B` (the history one back for a reader before the binding's own kick, which the
 /// partial step replaces), run on past its own end. A binding that is not a clock's (a creation, a handoff, a flush) keeps the
 /// tube alone. Where the step cannot be read (history pruned, a tube that ends, a kick that never fired) the tube alone is read.
+
+/// Lab probe (run 20261013-0459): when set, a clock body's between-boundaries read is the tube alone —
+/// the fresh `force::field` evaluation and the `secondaries` walk that feeds it are skipped (the
+/// deletion run 7b86 priced, here measured). Observation only: the engine's canonical paths read the
+/// tubes, so digests do not move (verified in the `slot_ab` example). Defaults to the shipped read.
+pub static TUBE_ONLY_READS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Lab probe (same run): reads that entered `partial`'s step path — the ones that pay the fresh
+/// field evaluation when it is not deleted. The census behind the measured gain.
+pub static FRESH_READS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
 fn partial(ctx: &Ctx, i: usize, t: Tick, b: &Binding) -> Res<(V2, V2)> {
     let raw = || b.cartesian(t);
     let k = b.kick;
@@ -140,6 +151,12 @@ fn partial(ctx: &Ctx, i: usize, t: Tick, b: &Binding) -> Res<(V2, V2)> {
         return base.cartesian(t).or_else(|_| raw());
     }
     let step = || -> Res<(V2, V2)> {
+        FRESH_READS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        if TUBE_ONLY_READS.load(std::sync::atomic::Ordering::Relaxed) {
+            // the lab's deletion (run 20261013-0459): the drifts without the kick — the fresh
+            // field evaluation and the secondaries walk that feeds it are not done at all.
+            return base.cartesian(t);
+        }
         let mid = start + tau / 2;
         let (x_mid, _) = base.cartesian(mid)?;
         let field = force::field(&ctx.secondaries(base.doll, mid, i)?, x_mid)?;
