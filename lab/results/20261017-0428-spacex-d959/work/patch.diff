 }
 
+/// Read-stream census, a print-only instrument: counts `readout` calls by call site. The burn read
+/// stream owns burn memory and CPU at 10⁹ (lab/wiki/promotion.md, open direction 1: "what are the
+/// resolver's re-reads FOR?"); this names it. Inert unless armed; no arithmetic is touched.
+pub mod readstat {
+    use std::collections::HashMap;
+    use std::panic::Location;
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    use std::sync::Mutex;
+
+    pub static ARMED: AtomicBool = AtomicBool::new(false);
+    static TOTAL: AtomicU64 = AtomicU64::new(0);
+    fn sites() -> &'static Mutex<HashMap<(String, u32), u64>> {
+        static S: std::sync::LazyLock<Mutex<HashMap<(String, u32), u64>>> =
+            std::sync::LazyLock::new(|| Mutex::new(HashMap::new()));
+        &S
+    }
+    pub fn note(loc: &'static Location<'static>) {
+        TOTAL.fetch_add(1, Ordering::Relaxed);
+        if let Ok(mut m) = sites().lock() {
+            *m.entry((loc.file().to_string(), loc.line())).or_insert(0) += 1;
+        }
+    }
+    /// A tagged count (e.g. `state_of`'s caller), kept in the same table with a labelled key.
+    pub fn note_tag(loc: &'static Location<'static>, tag: &str) {
+        TOTAL.fetch_add(1, Ordering::Relaxed);
+        if let Ok(mut m) = sites().lock() {
+            *m.entry((format!("{tag} {}", loc.file()), loc.line())).or_insert(0) += 1;
+        }
+    }
+    pub fn total() -> u64 {
+        TOTAL.load(Ordering::Relaxed)
+    }
+    /// One `readstat:` line per site, busiest first (file shortened to its crate name).
+    pub fn dump() {
+        let mut rows: Vec<((String, u32), u64)> = sites().lock().map(|m| m.iter().map(|(k, v)| (k.clone(), *v)).collect()).unwrap_or_default();
+        rows.sort_by_key(|(_, v)| std::cmp::Reverse(*v));
+        for ((file, line), n) in rows {
+            let short = file.rsplit_once("src/").map(|(_, s)| s).unwrap_or(file.as_str());
+            println!("readstat: {n} {short}:{line}");
+        }
+        println!("readstat: total {}", TOTAL.load(Ordering::Relaxed));
+    }
+}
+
 /// An integer state as scalars (units of the doll, c = 1).
 pub fn scalars(st: &IntegerState) -> Res<(V2, V2)> {
     let p = |i: usize| Scalar::raw(st.position[i] as i128, st.length_exponent as i32);
