+/// Exact floor division of u128 by u128: the word path (`div_word`) when the quotient
+/// provably fits one word and the divisor does too, the native multiword division
+/// otherwise. Same bits as `/` by construction.
+#[inline]
+fn div_exact(n: u128, d: u128) -> u128 {
+    if d <= u64::MAX as u128 && (n >> 64) < d {
+        crate::num::div_word(n, d as u64) as u128
+    } else {
+        n / d
+    }
+}
 
