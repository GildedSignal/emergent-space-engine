+/// The bulk regime's clearance from a source's band, in that source's Hill radii (lab run
+/// 20261016-2229-...-98cb): a body whose orbit stays this far from every source's band never makes a
+/// deep passage, so 7f97's measured bulk cadence (16 kicks per perturbation period, `step_log2 − 3`)
+/// serves it; inside it the shipped cadence stays (B13's deep passages need ≥ 128).
+pub const BULK_HILL: i64 = 4;
+
+/// Whether a clock body of doll `d` with the orbit band `[peri, apo]` (doll units) is in the bulk
+/// regime: from constants only (the sources' bands and Hill radii at `t`), never the state. `false`
+/// on any doubt (an unbound body, a pruned source): the shipped cadence is the safe side.
+pub fn bulk_regime(ctx: &Ctx, d: u16, t: Tick, except: usize, peri: Scalar, apo: Scalar) -> Res<bool> {
+    let host = ctx.dolls[d as usize].unit.mu;
+    let mut bulk = true;
+    for &j in &ctx.sources[d as usize] {
+        if j == except {
+            continue;
+        }
+        let s = source(ctx, j, t)?;
+        // The bands' gap: zero when they overlap.
+        let gap = if peri.sub(s.apo)?.is_positive() {
+            peri.sub(s.apo)?
+        } else if s.peri.sub(apo)?.is_positive() {
+            s.peri.sub(apo)?
+        } else {
+            Scalar::ZERO
+        };
+        let hill = s.axis.mul(cbrt(s.gm.div(host.mul(Scalar::integer(3))?)?)?)?;
+        let clear = hill.mul(Scalar::integer(BULK_HILL))?;
+        if !gap.sub(clear)?.is_positive() {
+            bulk = false;
+        }
+    }
+    Ok(bulk)
+}
