+/// Counters for the two exact searches ([`next_impact`], [`next_exit`]), read by the kick bench:
+/// how many searches ran, how many exact predicate probes they paid, and the worst probe count of
+/// any one search (the tail decides whether a probe policy is adoptable, not the mean). Both
+/// policies count the same things, endpoint checks included.
+pub mod searches {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    pub struct Tally {
+        pub searches: AtomicU64,
+        pub probes: AtomicU64,
+        pub worst: AtomicU64,
+    }
+    impl Tally {
+        const fn new() -> Self {
+            Self { searches: AtomicU64::new(0), probes: AtomicU64::new(0), worst: AtomicU64::new(0) }
+        }
+        pub fn search(&self) {
+            self.searches.fetch_add(1, Ordering::Relaxed);
+        }
+        pub fn probe(&self) {
+            self.probes.fetch_add(1, Ordering::Relaxed);
+        }
+        pub fn worst(&self, run: u64) {
+            self.worst.fetch_max(run, Ordering::Relaxed);
+        }
+    }
+    pub static IMPACT: Tally = Tally::new();
+    pub static EXIT: Tally = Tally::new();
+
+    /// `(impact, exit)` as `(searches, probes, worst)`.
+    pub fn snapshot() -> [(u64, u64, u64); 2] {
+        let r = |t: &Tally| (t.searches.load(Ordering::Relaxed), t.probes.load(Ordering::Relaxed), t.worst.load(Ordering::Relaxed));
+        [r(&IMPACT), r(&EXIT)]
+    }
+}
+/// The false-position estimate of where the level is crossed between the anchor probes `(a, d_a)`
+/// and `(b, d_b)` given as signed distances to the level, clamped strictly inside the live
+/// bracket `[lo, hi]` (any interior probe keeps the invariant; a non-finite estimate falls back
+/// to the midpoint). Only where to look: the exact predicate decides what is kept.
+fn false_position(a: i64, b: i64, lo: i64, hi: i64, d_a: f64, d_b: f64) -> i64 {
+    let g = d_a / (d_a - d_b);
+    let t = a as f64 + g * (b - a) as f64;
+    if t.is_finite() {
+        (t.floor() as i64).clamp(lo + 1, hi - 1)
+    } else {
+        lo + (hi - lo) / 2
+    }
+}
