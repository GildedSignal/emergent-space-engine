+/// Counters for the two exact searches ([`next_impact`], [`next_exit`]), read by the kick bench:
+/// how many searches ran, how many exact predicate probes they paid, and the worst probe count of
+/// any one search (the tail decides whether a probe policy is adoptable, not the mean). Both
+/// policies count the same things, endpoint checks included.
+pub mod searches {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    pub struct Tally {
+        pub searches: AtomicU64,
+        pub probes: AtomicU64,
+        pub worst: AtomicU64,
+    }
+    impl Tally {
+        const fn new() -> Self {
+            Self { searches: AtomicU64::new(0), probes: AtomicU64::new(0), worst: AtomicU64::new(0) }
+        }
+        pub fn search(&self) {
+            self.searches.fetch_add(1, Ordering::Relaxed);
+        }
+        pub fn probe(&self) {
+            self.probes.fetch_add(1, Ordering::Relaxed);
+        }
+        pub fn worst(&self, run: u64) {
+            self.worst.fetch_max(run, Ordering::Relaxed);
+        }
+    }
+    pub static IMPACT: Tally = Tally::new();
+    pub static EXIT: Tally = Tally::new();
+
+    /// `(impact, exit)` as `(searches, probes, worst)`.
+    pub fn snapshot() -> [(u64, u64, u64); 2] {
+        let r = |t: &Tally| (t.searches.load(Ordering::Relaxed), t.probes.load(Ordering::Relaxed), t.worst.load(Ordering::Relaxed));
+        [r(&IMPACT), r(&EXIT)]
+    }
+}
+/// The false-position estimate of where the level is crossed between the anchor probes `(a, d_a)`
+/// and `(b, d_b)` given as signed distances to the level, clamped strictly inside the live
+/// bracket `[lo, hi]` (any interior probe keeps the invariant; a non-finite estimate falls back
+/// to the midpoint). Only where to look: the exact predicate decides what is kept.
+fn false_position(a: i64, b: i64, lo: i64, hi: i64, d_a: f64, d_b: f64) -> i64 {
+    let g = d_a / (d_a - d_b);
+    let t = a as f64 + g * (b - a) as f64;
+    if t.is_finite() {
+        (t.floor() as i64).clamp(lo + 1, hi - 1)
+    } else {
+        lo + (hi - lo) / 2
+    }
+}
+
+/// The inverse-quadratic crossing estimate through the three newest probes `(t, d)` (signed
+/// distances to the level): the quadratic in `d` through the points, read at `d = 0`. The
+/// radius branch falls with curvature (it flattens toward the periapsis), so every straight
+/// chord lands short and crawls while a quadratic tracks the curve; `None` unless the estimate
+/// is finite and lands strictly inside the live bracket (a wild extrapolation is not a probe
+/// worth taking; the anchors' false position takes over). Only where to look: the exact
+/// predicate decides what is kept.
+fn iqi(newest: (i64, f64), middle: (i64, f64), oldest: (i64, f64), lo: i64, hi: i64) -> Option<i64> {
+    let ((tn, dn), (tm, dm), (to, d_old)) = (newest, middle, oldest);
+    // Lagrange weights of `d = 0` against the three probe distances.
+    let w = |di: f64, dj: f64, dk: f64| dj * dk / ((di - dj) * (di - dk));
+    let t = tn as f64 * w(dn, dm, d_old) + tm as f64 * w(dm, dn, d_old) + to as f64 * w(d_old, dn, dm);
+    (t.is_finite() && t >= lo as f64 && t <= hi as f64).then(|| t.floor() as i64).filter(|&t| t > lo && t < hi)
+}
+
+/// The crossing estimate from the branch's own shape: the radius is flat — quadratic — at the
+/// bracket's turning end (the periapsis of a fall, the apoapsis of a rise), where value
+/// differences are quantization noise rather than slope, so a straight secant crawls a tick at a
+/// time. With the vertex value `d_v` at `v` and one probe `(t, d)`, `d(s) = d_v + B·(v − s)²`
+/// puts the level at `v − (v − t)·sqrt(−d_v/(d − d_v))`: the square-root scaling a flat branch
+/// asks for. `None` on any degeneracy (the secant or the midpoint then places the probe).
+fn flat_branch(v: i64, d_v: f64, t: i64, d: f64) -> Option<i64> {
+    let x = (v - t) as f64 * (-d_v / (d - d_v)).sqrt();
+    (x.is_finite() && x >= 1.0).then(|| v - x as i64)
+}
