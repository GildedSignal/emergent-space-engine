+/// Which probe policy the exact searches use (`ES_FP`): `0`/unset — the shipped midpoint
+/// bisection, verbatim; `1` — a plain secant (false position) through the newest anchors;
+/// `2` — Anderson–Björck (the retained anchor's stored distance scales by the ratio the
+/// probe distances actually decayed); `3` — that plus the crossing estimate from an inverse
+/// quadratic through the three newest probes and a crawl bail (two consecutive probes that
+/// cut less than half force one midpoint); `4` — Illinois (the scaling fixed at one half).
+/// The float places the probe, the integer predicate decides what is kept, so the first
+/// crossing found is the bisection's — only the count of exact readouts changes.
+fn probe_policy() -> u8 {
+    static P: std::sync::LazyLock<u8> = std::sync::LazyLock::new(|| {
+        std::env::var("ES_FP").ok().and_then(|v| (!v.is_empty() && v != "0").then(|| v.parse().unwrap_or(1))).unwrap_or(0)
+    });
+    *P
+}
+
+/// `ES_FP_TRACE`: one line per probe of the impact search (the instrument that named the crawl).
+fn trace_probes() -> bool {
+    static T: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var_os("ES_FP_TRACE").is_some());
+    *T
+}
