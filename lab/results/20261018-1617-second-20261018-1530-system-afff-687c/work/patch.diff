+        };
+        let viol = K_VIOL.iter().map(|a| a.load(Ordering::Relaxed).to_string()).collect::<Vec<_>>().join("/");
+        let k16 = K16_VIOL.load(Ordering::Relaxed);
+        format!(
+            "scan_census: scans={scans} bail={bail} cand_total={cand} cand_mean={:.1} answered={answered} empty={empty} hits={hits} rank_along={} rank_near={} rank_swept={} sweep_pollute={} max_rank_swept={} max_rank_near={} euc_gt15={} euc_gt15_sweep_le15={} sweep_gt15_euc_le15={} max_answer={} big_answer={} win_dens_mean={:.1} win_dens_max={} enter_mean={:.1} leave_mean={:.1} churn_max={} pairs={} hit_miss_gt_near={} mcheck kviol_a={} kviol_k16={k16}",
+            if scans > 0 { cand as f64 / scans as f64 } else { 0.0 },
+            hist(&RANK_ALONG),
+            hist(&RANK_NEAR),
+            hist(&RANK_SWEPT),
+            hist(&SWEEP_POLLUTE),
+            MAX_RANK_SWEPT.load(Ordering::Relaxed),
+            MAX_RANK_NEAR.load(Ordering::Relaxed),
+            EUC_GT15.load(Ordering::Relaxed),
+            EUC_GT15_SWEEP_LE15.load(Ordering::Relaxed),
+            SWEEP_GT15_EUC_LE15.load(Ordering::Relaxed),
+            MAX_ANSWER.load(Ordering::Relaxed),
+            BIG_ANSWER.load(Ordering::Relaxed),
+            if answered > 0 { WIN_DENS_SUM.load(Ordering::Relaxed) as f64 / answered as f64 } else { 0.0 },
+            WIN_DENS_MAX.load(Ordering::Relaxed),
+            if PAIRS.load(Ordering::Relaxed) > 0 { ENTER.load(Ordering::Relaxed) as f64 / PAIRS.load(Ordering::Relaxed) as f64 } else { 0.0 },
+            if PAIRS.load(Ordering::Relaxed) > 0 { LEAVE.load(Ordering::Relaxed) as f64 / PAIRS.load(Ordering::Relaxed) as f64 } else { 0.0 },
+            CHURN_MAX.load(Ordering::Relaxed),
+            PAIRS.load(Ordering::Relaxed),
+            HIT_MISS_GT_NEAR.load(Ordering::Relaxed),
+            viol
+        )
+    }
+}
