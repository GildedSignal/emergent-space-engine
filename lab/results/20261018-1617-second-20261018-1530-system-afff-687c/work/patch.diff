+/// A print-only census of the player-neighbourhood scan (the system-lens run 20261018-1530, extended by the second-author run
+/// 20261018-1617): what the walk walks, what the answer yields, and whether the answer is rank-local in the SWEPT metric with a
+/// density-triggered k. No canonical state reads or writes; the floats never touch a law outcome.
+pub mod census {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    pub static SCANS: AtomicU64 = AtomicU64::new(0);
+    /// Scans whose radial filter bailed (the walk then reads every body).
+    pub static BAIL: AtomicU64 = AtomicU64::new(0);
+    pub static CAND: AtomicU64 = AtomicU64::new(0);
+    /// Distinct scans whose answer was computed at least once.
+    pub static ANSWERED: AtomicU64 = AtomicU64::new(0);
+    pub static EMPTY: AtomicU64 = AtomicU64::new(0);
+    pub static HITS: AtomicU64 = AtomicU64::new(0);
+    /// The rank histogram of found encounters among the walked candidates: bucket r is "rank r" (r < 16), bucket 16 is "rank > 15".
+    pub static RANK_ALONG: [AtomicU64; 17] = [const { AtomicU64::new(0) }; 17];
+    pub static RANK_NEAR: [AtomicU64; 17] = [const { AtomicU64::new(0) }; 17];
+
+    // ---- the second-author extension: the swept metric, its pollution, and the density-triggered k rule ----
+    /// Rank in the SWEPT metric (miss distance of the relative segment over the interval): buckets 0..=15 exact, then one
+    /// bucket per doubling (16: 16-31, 17: 32-63, ..., 22: 1024-2047, 23: >= 2048).
+    pub static RANK_SWEPT: [AtomicU64; 24] = [const { AtomicU64::new(0) }; 24];
+    /// Of the candidates that precede a hit in the swept metric, how many are NOT approaching (the receders that pollute the
+    /// swept rank): same buckets.
+    pub static SWEEP_POLLUTE: [AtomicU64; 24] = [const { AtomicU64::new(0) }; 24];
+    pub static MAX_RANK_SWEPT: AtomicU64 = AtomicU64::new(0);
+    pub static MAX_RANK_NEAR: AtomicU64 = AtomicU64::new(0);
+    /// Hits beyond at-t Euclidean rank 15 (the original claim's failure class), and of those, how many the swept metric
+    /// pulls back inside rank 16; and hits beyond swept rank 15 while inside Euclid rank 16 (the metric switch's cost).
+    pub static EUC_GT15: AtomicU64 = AtomicU64::new(0);
+    pub static EUC_GT15_SWEEP_LE15: AtomicU64 = AtomicU64::new(0);
+    pub static SWEEP_GT15_EUC_LE15: AtomicU64 = AtomicU64::new(0);
+    /// The answer's own size: the worst hit count on one answered scan, and how many answered scans answer more than 16.
+    pub static MAX_ANSWER: AtomicU64 = AtomicU64::new(0);
+    pub static BIG_ANSWER: AtomicU64 = AtomicU64::new(0);
+    /// The window's realized density (candidates whose swept miss is inside the encounter radius, approaching or not):
+    /// summed per answered scan (mean = this / answered) and the worst.
+    pub static WIN_DENS_SUM: AtomicU64 = AtomicU64::new(0);
+    pub static WIN_DENS_MAX: AtomicU64 = AtomicU64::new(0);
+    /// The density-trigger rule: k = max(16, ceil(alpha * mu_prev)), mu_prev the previous answered scan's hit count (the
+    /// stored record's size as an event-maintained aggregate would see it). Hits at swept rank >= k are violations.
+    pub static K_VIOL: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+    /// The same rule with k = 16 fixed (the original claim, the negative control).
+    pub static K16_VIOL: AtomicU64 = AtomicU64::new(0);
+    pub static LAST_MU: AtomicU64 = AtomicU64::new(0);
+    pub const ALPHAS: [f64; 3] = [1.25, 2.0, 4.0];
+    /// The record's churn: between consecutive ANSWERED scans, how many body ids enter / leave the swept window
+    /// (the membership a stored record must touch). PAIRS counts the consecutive pairs compared.
+    pub static ENTER: AtomicU64 = AtomicU64::new(0);
+    pub static LEAVE: AtomicU64 = AtomicU64::new(0);
+    pub static PAIRS: AtomicU64 = AtomicU64::new(0);
+    pub static CHURN_MAX: AtomicU64 = AtomicU64::new(0);
+    pub static LAST_WIN: std::sync::Mutex<Option<Vec<usize>>> = std::sync::Mutex::new(None);
