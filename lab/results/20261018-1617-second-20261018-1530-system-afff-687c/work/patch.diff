+    /// integer law decided the hit; a nonzero count means the census floats disagree with the law).
+    pub static HIT_MISS_GT_NEAR: AtomicU64 = AtomicU64::new(0);
+
+    pub fn bucket(rank: usize) -> usize {
+        rank.min(16)
+    }
+
+    /// Buckets 0..=15 exact, then one per doubling, capped at 23 (>= 2048).
+    pub fn bucket24(rank: usize) -> usize {
+        if rank < 16 {
+            rank
+        } else if rank < 2048 {
+            12 + (rank as u32).ilog2() as usize
+        } else {
+            23
+        }
+    }
+
+    pub fn report() -> String {
+        let (scans, bail, cand, answered, empty, hits) = (
+            SCANS.load(Ordering::Relaxed),
+            BAIL.load(Ordering::Relaxed),
+            CAND.load(Ordering::Relaxed),
