@@ -0,0 +1,399 @@
+//! Lab probe 20261018-1237-dynamics-9dbb (dynamics lens, topic order-boundary):
+//! the seam map's attractor. The graded record (b9c8) measured the crossing walk at
+//! depth 256 and read "bounded, not compounding" from d256/d64 ~ 1.03 — but its own
+//! data has dr_rel = 0 on all 864 chains: the sampled radius is an exact invariant,
+//! so the position drift is bounded by geometry (a point on a circle of exactly
+//! preserved radius cannot leave the diameter). The unbounded degree of freedom is
+//! the shape column k (and the orientation column w). This probe records the full
+//! per-crossing series (k, p, w, cw, radius) at depth 1024/4096/8192 and asks:
+//!   (1) is the radius invariant exact at depth for every e class?
+//!   (2) does k diffuse (MSD ~ n^alpha, alpha->1), mean-revert, or absorb into cycles?
+//!   (3) does the full column state (k, p, w, cw) ever repeat (omega-limit census)?
+//!   (4) twins: w0 + 1 ulp — trajectory divergence vs band-statistics agreement.
+//!   (5) held-out retrograde (cw=true) arms, never run before.
+//!
+//! Cycle (unchanged from b9c8's seam_cycle.rs, itself shipped pub APIs only):
+//! columns -> Orbit::compile -> state at phase -> cartesian (doll word)
+//! -> [in_tube_units: to_tube(x).fixed(0), shipped bind.rs mirror]
+//! -> Rebinding::from_state -> columns'; residual dropped (demote-at-commit).
+
+use emergent_space::binding::{cartesian, IntegerState, Rebinding};
+use emergent_space::orbit::{Orbit, OrbitKey};
+use emergent_space::scaled::Scalar;
+use emergent_universe::world::Unit;
+use std::collections::HashMap;
+use std::time::Instant;
+
+type R<T> = std::result::Result<T, emergent_space::Error>;
+
+/// The shipped `in_tube_units` (crates/universe/src/bind.rs:252-258), mirrored from pub APIs.
+fn in_tube(st: IntegerState, unit: &Unit) -> R<IntegerState> {
+    if unit.unity {
+        return Ok(st);
+    }
+    let q = |p: i64| -> R<i64> {
+        let s = unit
+            .to_tube(Scalar::raw(p as i128, 0)?)
+            .map_err(|_| emergent_space::Error::Range)?;
+        let fixed = s.fixed(0)?;
+        i64::try_from(fixed).map_err(|_| emergent_space::Error::Range)
+    };
+    Ok(IntegerState { position: [q(st.position[0])?, q(st.position[1])?], ..st })
+}
+
+fn k_q48(k: u64, e: i16) -> Option<i128> {
+    let shift = e as i32;
+    if shift >= 0 {
+        (k as i128).checked_shl(shift as u32)
+    } else if shift <= -64 {
+        None
+    } else {
+        Some((k as i128) >> (-shift) as u32)
+    }
+}
+
+fn key_q48(k: &OrbitKey) -> Option<i128> {
+    k_q48(k.k, k.k_exponent)
+}
+
+fn scalar_parts(s: Scalar) -> (i128, i16) {
+    (s.significand() as i128, s.exponent())
+}
+
+fn isqrt128(v: u128) -> u128 {
+    if v == 0 {
+        return 0;
+    }
+    let mut x = 1u128 << ((128 - v.leading_zeros() + 1) / 2);
+    loop {
+        let y = (x + v / x) >> 1;
+        if y >= x {
+            break;
+        }
+        x = y;
+    }
+    x
+}
+
+fn pos_radius(p: &[i64; 2]) -> u128 {
+    let x = p[0] as i128;
+    let y = p[1] as i128;
+    isqrt128((x.wrapping_mul(x) + y.wrapping_mul(y)) as u128)
+}
+
+const HUGE: i128 = i128::MIN / 2;
+
+/// The full column state at one crossing; PartialEq over it is the omega-limit probe.
+#[derive(Clone, PartialEq, Eq, Hash)]
+struct Col {
+    k: i128, // fit's shape word in Q48 ulps; HUGE = overflow sentinel
+    p: (i128, i16),
+    w: u32,
+    cw: bool,
+}
+
+struct ChainOut {
+    cfg: String,
+    refused: Option<(usize, String)>,
+    steps: usize,
+    /// first repeat of the full column state: (at step, cycle length) or None
+    col_cycle: Option<(usize, usize)>,
+    /// first repeat of the OrbitKey alone: (at step, cycle length) or None
+    key_cycle: Option<(usize, usize)>,
+    /// max |r_n - r_0| in tube quanta (P1: exact invariant => 0)
+    dr_quanta: u128,
+    /// per-crossing series, tab-separated text: n  k  p_sig  p_exp  w  cw  r
+    series: String,
+}
+
+fn run_chain(
+    pexp: i32,
+    eq48: u64,
+    phi_num: i128,
+    w0: u32,
+    cw0: bool,
+    shift: i16,
+    unit: &Unit,
+    depth: usize,
+    tag: &str,
+) -> ChainOut {
+    let cfg = format!(
+        "p16e{pexp}_e{eq48}_phi{phi_num}o8_w{w0:x}_cw{cw0}_s{shift}_mu{}_d{depth}_{tag}",
+        if unit.unity { "1" } else { "x" }
+    );
+    let mut out = ChainOut {
+        cfg: cfg.clone(),
+        refused: None,
+        steps: 0,
+        col_cycle: None,
+        key_cycle: None,
+        dr_quanta: 0,
+        series: String::new(),
+    };
+    let key0 = match OrbitKey::bound(Scalar::integer(16).scale(pexp).unwrap(), eq48) {
+        Ok(k) => k,
+        Err(e) => {
+            out.refused = Some((0, format!("bound:{e:?}")));
+            return out;
+        }
+    };
+    let orbit0 = match Orbit::compile(key0) {
+        Ok(o) => o,
+        Err(e) => {
+            out.refused = Some((0, format!("compile:{e:?}")));
+            return out;
+        }
+    };
+    let per = match orbit0.period() {
+        Ok(p) => p,
+        Err(e) => {
+            out.refused = Some((0, format!("period:{e:?}")));
+            return out;
+        }
+    };
+    let t0 = match per.mul(Scalar::raw(phi_num, -3).unwrap()) {
+        Ok(t) => t,
+        Err(e) => {
+            out.refused = Some((0, format!("time:{e:?}")));
+            return out;
+        }
+    };
+    let st0 = match orbit0.state(t0) {
+        Ok(s) => s,
+        Err(e) => {
+            out.refused = Some((0, format!("state:{e:?}")));
+            return out;
+        }
+    };
+    let r_for_word = if unit.unity {
+        st0.radius
+    } else {
+        match unit.to_doll(st0.radius) {
+            Ok(r) => r,
+            Err(_) => {
+                out.refused = Some((0, "to_doll(word)".into()));
+                return out;
+            }
+        }
+    };
+    let units = (
+        r_for_word.exponent() - 60 + shift,
+        st0.transverse_velocity.abs().exponent() - 60 + shift,
+    );
+
+    let mut key = key0;
+    let mut w = w0;
+    let mut cw = cw0;
+    let mut seen_col: HashMap<Col, usize> = HashMap::new();
+    let mut seen_key: HashMap<OrbitKey, usize> = HashMap::new();
+    let mut r0: Option<u128> = None;
+
+    for n in 0..depth {
+        let orbit = match Orbit::compile(key) {
+            Ok(o) => o,
+            Err(e) => {
+                out.refused = Some((n, format!("compile:{e:?}")));
+                break;
+            }
+        };
+        // The compact t column is a phase; time is re-derived from the current key's period.
+        let t = match orbit.period().and_then(|p| p.mul(Scalar::raw(phi_num, -3).unwrap())) {
+            Ok(t) => t,
+            Err(e) => {
+                out.refused = Some((n, format!("time:{e:?}")));
+                break;
+            }
+        };
+        let mut st = match orbit.state(t) {
+            Ok(s) => s,
+            Err(e) => {
+                out.refused = Some((n, format!("state:{e:?}")));
+                break;
+            }
+        };
+        if !unit.unity {
+            st.radius = match unit.to_doll(st.radius) {
+                Ok(r) => r,
+                Err(_) => {
+                    out.refused = Some((n, "to_doll".into()));
+                    break;
+                }
+            };
+        }
+        let s = match cartesian(st, w, cw, units) {
+            Ok(s) => s,
+            Err(e) => {
+                out.refused = Some((n, format!("cartesian:{e:?}")));
+                break;
+            }
+        };
+        let s = match in_tube(s, unit) {
+            Ok(s) => s,
+            Err(e) => {
+                out.refused = Some((n, format!("in_tube:{e:?}")));
+                break;
+            }
+        };
+        let fit = match Rebinding::from_state(s, t, None) {
+            Ok(f) => f,
+            Err(e) => {
+                out.refused = Some((n, format!("fit:{e:?}")));
+                break;
+            }
+        };
+        let nk = match fit.trajectory.key() {
+            Some(k) => k,
+            None => {
+                out.refused = Some((n, "fit:Plunge".into()));
+                break;
+            }
+        };
+        let col = Col {
+            k: key_q48(&nk).unwrap_or(HUGE),
+            p: scalar_parts(nk.periapsis),
+            w: fit.periapsis_angle,
+            cw: fit.clockwise,
+        };
+        let res = fit.residual;
+        let res_pos = res.position[0].abs().max(res.position[1].abs());
+        let res_vel = res.velocity[0].abs().max(res.velocity[1].abs());
+        let r = pos_radius(&s.position);
+        if let Some(r0v) = r0 {
+            out.dr_quanta = out.dr_quanta.max(r.abs_diff(r0v));
+        } else {
+            r0 = Some(r);
+        }
+        out.series.push_str(&format!(
+            "{n}\t{}\t{}\t{}\t{}\t{}\t{r}\t{res_pos}\t{res_vel}\n",
+            col.k, (col.p).0, (col.p).1, col.w, col.cw as u8
+        ));
+        if out.key_cycle.is_none() {
+            if let Some(first) = seen_key.get(&nk) {
+                out.key_cycle = Some((n, n - first));
+            } else {
+                seen_key.insert(nk, n);
+            }
+        }
+        if out.col_cycle.is_none() {
+            if let Some(first) = seen_col.get(&col) {
+                out.col_cycle = Some((n, n - first));
+            } else {
+                seen_col.insert(col, n);
+            }
+        }
+        out.steps += 1;
+        key = nk;
+        w = fit.periapsis_angle;
+        cw = fit.clockwise;
+    }
+    out
+}
+
+fn main() {
+    let outdir = std::env::args().nth(1).expect("usage: seam_walk <outdir> [smoke]");
+    let smoke = std::env::args().nth(2).as_deref() == Some("smoke");
+        let o = |v: Option<(usize, usize)>, which: usize| -> String {
+            match (v, which) {
+                (Some(x), 0) => x.0.to_string(),
+                (Some(x), _) => x.1.to_string(),
+                (None, _) => "null".into(),
+            }
+        };
+    let unit_one = Unit::ONE;
+    let unit_mu = Unit::of(Scalar::raw(0x14_7AE1, -20).unwrap()).unwrap();
+    let q48 = 1u64 << 48;
+
+    // Determinism control: one chain run twice, series must be bit-identical.
+    {
+        let a = run_chain(17, q48 / 2, 3, 0x2000_0000, false, 0, &unit_one, 1, "ctl");
+        let b = run_chain(17, q48 / 2, 3, 0x2000_0000, false, 0, &unit_one, 1, "ctl");
+        println!("determinism rerun identical series: {}", a.series == b.series && a.steps == b.steps);
+    }
+
+    let depth_grid = if smoke { 64 } else { 1024 };
+    let depth_deep = if smoke { 128 } else { 4096 };
+    let depth_twin = if smoke { 256 } else { 8192 };
+
+    let mut jobs: Vec<(i32, u64, i128, u32, bool, i16, bool, usize, &'static str)> = Vec::new();
+    // Grid: 3 scales x 4 shapes x 2 phases x 2 dolls, unity words (shift 0).
+    for &pexp in &[-1i32, 17, 30] {
+        for &eq48 in &[0u64, q48 / 1000, q48 / 2, q48 - q48 / 100] {
+            for &phi in &[3i128, 5] {
+                for mu in [true, false] {
+                    jobs.push((pexp, eq48, phi, 0x2000_0000, false, 0, mu, depth_grid, "grid"));
+                }
+            }
+        }
+    }
+    // Deep arms: the strong-walker classes (one per shape class) + the record-holder family.
+    for &(pexp, eq48, phi) in &[
+        (17i32, q48 / 2, 3i128),
+        (17, q48 / 1000, 3),
+        (-1, 0, 3),
+        (30, q48 - q48 / 100, 5),
+    ] {
+        jobs.push((pexp, eq48, phi, 0x2000_0000, false, 0, true, depth_deep, "deep"));
+    }
+    // Twins: same config, w0 vs w0+1 ulp (trajectory divergence vs band statistics).
+    jobs.push((17, q48 / 2, 3, 0x2000_0000, false, 0, true, depth_twin, "twinA"));
+    jobs.push((17, q48 / 2, 3, 0x2000_0001, false, 0, true, depth_twin, "twinB"));
+    // Held-out retrograde arms (cw=true): never run in the record.
+    jobs.push((17, q48 / 2, 5, 0x2000_0000, true, 0, true, depth_grid, "retro"));
+    jobs.push((-1, q48 / 10, 1, 0x2000_0000, true, 0, true, depth_grid, "retro"));
+    jobs.push((30, q48 / 1000, 3, 0x2000_0000, true, 0, false, depth_grid, "retro"));
+
+    let mut index = String::from("cfg\tsteps\trefused\tcol_cycle_at\tcol_cycle_len\tkey_cycle_at\tkey_cycle_len\tdr_quanta\tfile\n");
+    let mut summary = String::new();
+    for (pexp, eq48, phi, w0, cw0, shift, unity, depth, tag) in jobs {
+        let unit = if unity { &unit_one } else { &unit_mu };
+        let now = Instant::now();
+        let r = run_chain(pexp, eq48, phi, w0, cw0, shift, unit, depth, tag);
+        let el = now.elapsed().as_millis();
+        let cfg_name = r.cfg.clone();
+        let fname = format!("{}_{}.tsv", tag, cfg_name).replace('/', "_");
+        std::fs::write(format!("{outdir}/{fname}"), &r.series).unwrap();
+        let refused = r
+            .refused
+            .as_ref()
+            .map(|(n, s)| format!("{n} {}", s.replace(['\t', '\n'], " ")))
+            .unwrap_or_else(|| "None".into());
+        index.push_str(&format!(
+            "{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\n",
+            r.cfg,
+            r.steps,
+            refused,
+            o(r.col_cycle, 0),
+            o(r.col_cycle, 1),
+            o(r.key_cycle, 0),
+            o(r.key_cycle, 1),
+            r.dr_quanta,
+            fname,
+        ));
+        summary.push_str(&format!(
+            "{} steps={} refused={} col_cycle={:?} key_cycle={:?} dr_quanta={} {el}ms\n",
+            r.cfg, r.steps, refused, r.col_cycle, r.key_cycle, r.dr_quanta
+        ));
+        if tag == "twinB" || tag == "twinA" {
+            println!("{tag}: {} steps={} dr={} colcyc={:?}", r.cfg, r.steps, r.dr_quanta, r.col_cycle);
+        }
+    }
+    std::fs::write(format!("{outdir}/index.tsv"), index).unwrap();
+    std::fs::write(format!("{outdir}/summary.txt"), summary).unwrap();
+    println!("jobs done. see {outdir}/index.tsv");
+
+    // Cost line for continuity with the record.
+    let key = OrbitKey::bound(Scalar::integer(16).scale(18).unwrap(), q48 / 10).unwrap();
+    let orbit = Orbit::compile(key).unwrap();
+    let t = orbit.period().unwrap().mul(Scalar::raw(3, -3).unwrap()).unwrap();
+    let st = orbit.state(t).unwrap();
+    let units = (st.radius.exponent() - 60, st.transverse_velocity.abs().exponent() - 60);
+    let s = cartesian(st, 0x2000_0000, false, units).unwrap();
+    let now = Instant::now();
+    for _ in 0..1000 {
+        let orbit = Orbit::compile(key).unwrap();
+        let st = orbit.state(t).unwrap();
+        let s = cartesian(st, 0x2000_0000, false, units).unwrap();
+        let _ = Rebinding::from_state(s, t, None).unwrap();
+    }
+    println!("cost: full crossing = {:.1} ns", now.elapsed().as_nanos() as f64 / 1000.0);
+}
