+/// The counters so far (empty when the split was never on).
+pub fn split_text() -> String {
+    use std::sync::atomic::Ordering;
+    let ns: Vec<u64> = SPLIT.iter().map(|a| a.load(Ordering::Relaxed)).collect();
+    let total: u64 = ns[..4].iter().sum();
+    let sh = |i: usize| if total > 0 { ns[i] as f64 / total as f64 } else { 0.0 };
+    let field_share = if ns[5] > 0 { ns[4] as f64 / ns[5] as f64 } else { 0.0 };
+    let f64_of = |a: &std::sync::atomic::AtomicU64| f64::from_bits(a.load(Ordering::Relaxed));
+    format!(
+        "ns observer_setup={} bodies_crossings={} fleets={} view_build={} field_in_partial={} partial_total={} | gather_shares obs={:.3} bodies={:.3} fleets={:.3} build={:.3} | field_share_of_partial={:.3} | sources_tube_ns={} field_arith_ns={} | shared first={} reuse={} max_mid_spread_ticks={} max_dp_root_units={:.3e} max_dv_doll_units={:.3e}",
+        ns[0], ns[1], ns[2], ns[3], ns[4], ns[5], sh(0), sh(1), sh(2), sh(3), field_share, ns[6], ns[7], ns[8], ns[9],
+        MID_SPREAD.load(Ordering::Relaxed), f64_of(&MAX_DP), f64_of(&MAX_DV)
+    )
+}
