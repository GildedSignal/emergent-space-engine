+/// Lab instrumentation (env `ES_VIEW_SPLIT=1`, set by the bench): where the gather's nanoseconds go,
+/// accumulated across frames. Buckets: 0 observer setup, 1 bodies' crossings, 2 fleets, 3 the view
+/// build, 4 the field evaluation inside a partial readout, 5 partial readouts total (view and engine),
+/// 6 the sources' tube reads (`ctx.secondaries`), 7 the field arithmetic (`force::field`), 8/9 counts
+/// of shared first touches / reuses.
+static SPLIT_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static SPLIT: [std::sync::atomic::AtomicU64; 10] = [const { std::sync::atomic::AtomicU64::new(0) }; 10];
+/// The lever's honest costs: how far a reuse's read tick sits from the shared one (ticks), and the
+/// display delta it induces (position in root units, velocity in the doll's).
+static MID_SPREAD: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static MAX_DP: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static MAX_DV: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Turn the gather's split counters on (before the first frame).
+pub fn set_split(v: bool) {
+    SPLIT_ON.store(v, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn split_on() -> bool {
+    SPLIT_ON.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub(crate) fn add_split(i: usize, ns: u64) {
+    SPLIT[i].fetch_add(ns, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// The named lever, checked 9 October: one shared read of a doll's field sources per frame instead of
+/// one per emitter per Newton step (`partial` is the view's read layer; the engine's kicks read their
+/// own). Env `ES_SHARED_FIELD`: 1 shares (the display changes, the outcomes cannot), 2 also measures
+/// the display delta against the per-step read while the canonical path still drives the view. Unset
+/// is the shipped behaviour.
+static FIELD_SHARE: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+static FIELD_EPOCH: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+
+pub fn set_field_share(v: u8) {
+    FIELD_SHARE.store(v, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn field_share() -> u8 {
+    FIELD_SHARE.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+thread_local! {
+    static SHARED_SOURCES: std::cell::RefCell<std::collections::HashMap<u16, (u64, Tick, Vec<(usize, crate::force::Secondary)>)>> =
+        std::cell::RefCell::new(std::collections::HashMap::new());
+}
+
+/// A new frame of the gather: the shared sources go stale (the tubes have moved on).
+pub(crate) fn begin_field_frame() {
+    if field_share() != 0 {
+        FIELD_EPOCH.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+/// The doll's sources this frame, read at the first tick asked for and shared since (`except` still
+/// skips the emitter itself, so a source never pulls on its own partial step).
+pub(crate) fn shared_secondaries(ctx: &crate::ctx::Ctx, d: u16, t: Tick, except: usize) -> crate::num::Res<Vec<crate::force::Secondary>> {
+    use std::sync::atomic::Ordering;
+    let epoch = FIELD_EPOCH.load(Ordering::Relaxed);
+    let hit = SHARED_SOURCES.with(|m| {
+        let m = m.borrow_mut();
+        match m.get(&d) {
+            Some((e, t0, v)) if *e == epoch => {
+                MID_SPREAD.fetch_max(t0.abs_diff(t), Ordering::Relaxed);
+                add_split(9, 1);
+                Some(v.clone())
+            }
+            _ => None,
+        }
+    });
+    let all = match hit {
+        Some(v) => v,
+        None => {
+            let t6 = split_on().then(std::time::Instant::now);
+            let v: crate::num::Res<Vec<_>> = ctx.sources[d as usize]
+                .iter()
+                .map(|&j| {
+                    let (pos, vel) = ctx.state_of(j, t)?;
+                    Ok((j, crate::force::Secondary { gm: ctx.info[j].gm, pos, vel, edge: ctx.info[j].soi }))
+                })
+                .collect();
+            if let Some(t) = t6 {
+                add_split(6, t.elapsed().as_nanos() as u64);
+            }
+            let v = v?;
+            SHARED_SOURCES.with(|m| {
+                m.borrow_mut().insert(d, (epoch, t, v.clone()));
+            });
+            add_split(8, 1);
+            v
+        }
+    };
+    Ok(all.into_iter().filter(|(j, _)| *j != except).map(|(_, s)| s).collect())
+}
+
+/// Note the display delta the shared read induces (mode 2): the stepped state with per-step sources
+/// against the shared ones, `p` in root units, `v` in the doll's.
+pub(crate) fn note_step_delta(shift: i16, a: (V2, V2), b: (V2, V2)) {
+    use std::sync::atomic::Ordering;
+    let k = 2f64.powi(-(shift as i32));
+    let dp = ((to_f64(a.0[0]) - to_f64(b.0[0])).abs() * k).hypot((to_f64(a.0[1]) - to_f64(b.0[1])).abs() * k);
+    let dv = (to_f64(a.1[0]) - to_f64(b.1[0])).abs().hypot((to_f64(a.1[1]) - to_f64(b.1[1])).abs());
+    MAX_DP.fetch_max(dp.to_bits(), Ordering::Relaxed);
+    MAX_DV.fetch_max(dv.to_bits(), Ordering::Relaxed);
+}
