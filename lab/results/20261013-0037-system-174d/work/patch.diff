+/// The probe's dv magnitudes in velocity quanta (measurement only; the law's own quantize is untouched).
+fn tide_quanta(dv: &V2, exp: i16) -> i64 {
+    dv.iter().map(|s| s.fixed(-(exp as i32)).unwrap_or(0).abs() as i64).max().unwrap_or(0)
+}
+
+/// The burn's dv alone: the post-burn velocity minus the pre-kick velocity plus the tide's part.
+fn burn_quanta(v: &V2, v2: &V2, exp: i16) -> i64 {
+    (0..2)
+        .map(|c| v2[c].sub(v[c]).map(|d| d.fixed(-(exp as i32)).unwrap_or(0).abs() as i64).unwrap_or(0))
+        .max()
+        .unwrap_or(0)
+}
