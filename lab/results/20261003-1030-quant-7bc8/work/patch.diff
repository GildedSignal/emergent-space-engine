+//! Stage accounting for the bind path (the kick's latency budget, quant lens).
+//! Relaxed atomics around an armed flag: when disarmed the cost is one load and
+//! a branch. It never touches a value the law computes; outcomes are unchanged.
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::time::Instant;
+
+/// 0 fit_key, 1 trajectory build (compile), 2 shape quadrature inside `Orbit::compile`,
+/// 3 orientation (at_radius/angle/phase), 4 residual, 5 `from_state` total.
+pub const STAGES: usize = 6;
+
+static ARMED: AtomicBool = AtomicBool::new(false);
+static NS: [AtomicU64; STAGES] = [
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+];
+static CALLS: [AtomicU64; STAGES] = [
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+];
+static EXACT_HITS: AtomicU64 = AtomicU64::new(0);
+static EXACT_MISSES: AtomicU64 = AtomicU64::new(0);
+static MEMO_HITS: AtomicU64 = AtomicU64::new(0);
+static MEMO_MISSES: AtomicU64 = AtomicU64::new(0);
+
+#[inline]
+pub fn armed() -> bool {
+    ARMED.load(Ordering::Relaxed)
+}
+
+pub fn arm(on: bool) {
+    ARMED.store(on, Ordering::Relaxed);
+}
+
+/// Run `f`, charging its wall time to stage `idx` when armed.
+#[inline]
+pub fn stage<R>(idx: usize, f: impl FnOnce() -> R) -> R {
+    if !armed() {
+        return f();
+    }
+    let t0 = Instant::now();
+    let out = f();
+    NS[idx].fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    CALLS[idx].fetch_add(1, Ordering::Relaxed);
+    out
+}
+
+#[inline]
+pub fn intern_exact(hit: bool) {
+    if !armed() {
+        return;
+    }
+    if hit {
+        EXACT_HITS.fetch_add(1, Ordering::Relaxed);
+    } else {
+        EXACT_MISSES.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+#[inline]
+pub fn memo_recurrence(hit: bool) {
+    if !armed() {
+        return;
+    }
+    if hit {
+        MEMO_HITS.fetch_add(1, Ordering::Relaxed);
+    } else {
+        MEMO_MISSES.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Read and reset everything (the caller takes deltas around its own windows).
+pub fn take() -> ([u64; STAGES], [u64; STAGES], u64, u64, u64, u64) {
+    let mut ns = [0u64; STAGES];
+    let mut calls = [0u64; STAGES];
+    for i in 0..STAGES {
+        ns[i] = NS[i].swap(0, Ordering::Relaxed);
+        calls[i] = CALLS[i].swap(0, Ordering::Relaxed);
+    }
+    (
+        ns,
+        calls,
+        EXACT_HITS.swap(0, Ordering::Relaxed),
+        EXACT_MISSES.swap(0, Ordering::Relaxed),
+        MEMO_HITS.swap(0, Ordering::Relaxed),
+        MEMO_MISSES.swap(0, Ordering::Relaxed),
+    )
+}
