+/// Rough resident bytes of one compiled trajectory (knots, crossings, tails; an estimate,
+pub(crate) fn entry_bytes(t: &Trajectory) -> u64 {
+    match t {
+        Trajectory::Cycle(c) => {
+            let s = c.shape();
+            64 + (s.knots().len() as u64) * (std::mem::size_of::<emergent_space::orbit::Knot>() as u64)
+                + (s.crossings().len() as u64) * 8
+                + 16
+        }
+        Trajectory::Passage(_) => 2048,
+        Trajectory::Plunge(_) => 512,
+    }
+}
+
+impl Drop for Entry {
+    fn drop(&mut self) {
+        census::dropped(self as *const Entry as usize, entry_bytes(&self.trajectory));
+    }
+}
