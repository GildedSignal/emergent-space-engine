+    /// The derivative of this shape's knot sums w.r.t. k (the weak path's only table
+    /// parameter), stored with the cycle: per knot and component, the Q62 derivative
+    /// aligned to that component's own exponent, so one update is a single i128
+    /// multiply-add per component. The jet of docs/law.md ("a kick updates the cycle
+    /// by a multiply-add"), with the re-anchor rule measured by lab 20261006-0346:
+    /// first order in k, so the error grows as C·drift², C ≈ 1.9.
+    pub(crate) fn jet_table(&self) -> Result<Vec<[i128; 5]>> {
+        if self.key.null || self.q != 0 || self.k < ONE / 2 {
+            return Err(Error::Range); // strong shapes anchor; the jet is weak-only
+        }
+        let f_floor = f(self.floor)?;
+        let f2 = f_floor.mul(f_floor)?;
+        let f3 = f2.mul(f_floor)?;
+        let t = self.t_numerator;
+        // d(√k/floor²)/dk = 1/(2√k·floor²) − 4√k/floor³.
+        let cf0_dot = Scalar::ONE
+            .div(t.add(t)?)?
+            .div(f2)?
+            .sub(Scalar::integer(4).mul(t)?.div(f3)?)?;
+        let mut d = vec![[0i128; 5]; self.knots.len()];
+        let mut acc = [0i128; 5]; // cumulative Q62 derivative sums, panel by panel
+        fn raw62(v: i128) -> Result<Scalar> {
+            Scalar::raw(v, -123)
+        }
+        for w in 1..self.knots.len() {
+            let lo = self.knots[w - 1].psi as i128;
+            let hi = self.knots[w].psi as i128;
+            let (sum, ds) = self.weak_quad_jet(lo, hi)?;
+            // Components 1 and 2 share base = sum1·cf0; 3 and 4 carry clock_factor[0].
+            let cf = self.clock_factor[0];
+            let base_dot = raw62(ds[1])?.mul(cf)?.add(raw62(sum[1])?.mul(cf0_dot)?)?;
+            let c3 = raw62(ds[2])?.mul(cf)?.add(raw62(sum[2])?.mul(cf0_dot)?)?;
+            let c4 = raw62(ds[3])?.mul(cf)?.add(raw62(sum[3])?.mul(cf0_dot)?)?;
+            let panel = [raw62(ds[0])?, base_dot.clone(), base_dot, c3, c4];
+            for c in 0..5 {
+                acc[c] = acc[c].checked_add(panel[c].fixed(62)?).ok_or(Error::Range)?;
+            }
+            for c in 0..5 {
+                // acc[c] is the derivative in Q62; the target significand counts ulps
+                // of 2^(e-62), so the aligned mantissa is acc·2^-e.
+                let target = self.knots[w].sum.0[c];
+                let mantissa = if target.significand() == 0 {
+                    0
+                } else {
+                    let shift = -(target.exponent() as i32);
+                    if shift >= 0 && shift <= 120 {
+                        acc[c] << shift
+                    } else if shift < 0 && -shift <= 120 {
+                        acc[c] >> -shift
+                    } else {
+                        0
+                    }
+                };
+                d[w][c] = mantissa;
+            }
+        }
+        Ok(d)
+    }
+
+    /// One jet update: the cycle's sums move to first order at `k1` (Q48), every
+    /// component one exact-rounded i128 multiply-add, plus the shape's scalar
+    /// constants recomputed exactly at `k1`. The psi grid stays the anchor's (a
+    /// quadrature node choice, not a law constant). Refuses when the update would
+    /// overflow a significand: the caller re-anchors.
+    pub(crate) fn jet_update(&self, d: &[[i128; 5]], k1: u64) -> Result<OrbitShape> {
+        let mut shape = Self::new(ShapeKey { k: k1, compactness: Scalar::ZERO, null: false })?;
+        let dk = ((k1 as i128) << 14) - ((self.key.k as i128) << 14);
+        shape.knots = Vec::with_capacity(self.knots.len());
+        for (w, knot) in self.knots.iter().enumerate() {
+            let mut sum = knot.sum;
+            if w > 0 {
+                for c in 0..5 {
+                    let term = d[w][c].checked_mul(dk).ok_or(Error::Range)? >> 62;
+                    sum.0[c] = sum.0[c].plus_significand(term)?;
+                }
+            }
+            shape.knots.push(Knot { psi: knot.psi, sum });
+        }
+        shape.crossings = self.crossings.clone();
+        Ok(shape)
+    }
+
+    /// The weak panel quadrature's raw sums and their k-derivatives (Q62, same
+    /// -123 alignment as [`weak_quad`]). Analytic derivatives of each node's
+    /// closed form: exact integers, no differencing.
+    fn weak_quad_jet(&self, lo: i128, hi: i128) -> Result<([i128; 4], [i128; 4])> {
+        let h = hi - lo;
+        let mid = lo + h / 2;
+        let mut sum = [0i128; 4];
+        let mut ds = [0i128; 4];
+        let term = self.weak_tau_term.fixed(62)?;
+        // term = (3k² + η²)/(2k) ⇒ dterm/dk = (4k² − 1)/(2k²), Q62.
+        let kk = product(self.k, self.k);
+        let term_dot = crate::num::div_word(((4 * kk - ONE) as u128) << 62, (2 * kk) as u64) as i128;
+        for j in 0..2 {
+            let dx = (X[j] * h) >> 63;
+            let w = (W[j] * h) >> 63;
+            for psi in [mid - dx, mid + dx] {
+                let c = cos(psi);
+                let ac = product(ONE - self.k, c);
+                let x = self.k + ac;
+                let excess = 3 * self.k + ac;
+                let ratio = crate::num::div_word((self.floor as u128) << 62, x as u64) as i128;
+                let rtau = product(ratio, ratio);
+                // dk-derivatives (Q62): ẋ = 1 − c, ėxcess = 3 − c, d(floor/x)/dk = (2x − floor·ẋ)/x.
+                let x_dot = ONE - c;
+                let excess_dot = 3 * ONE - c;
+                let a = product(2 * ONE, x) - product(self.floor, x_dot);
+                let ratio_dot = crate::num::div_word((a.max(0) as u128) << 62, x as u64) as i128;
+                let rtau_dot = product(2 * ratio, ratio_dot);
+                sum[0] += w * excess;
+                sum[1] += w * rtau;
+                sum[2] += w * product(rtau, 3 * x);
+                sum[3] += w * product(rtau, excess - term);
+                ds[0] += w * excess_dot;
+                ds[1] += w * rtau_dot;
+                ds[2] += w * (product(rtau_dot, 3 * x) + product(rtau, 3 * x_dot));
+                ds[3] += w * (product(rtau_dot, excess - term) + product(rtau, excess_dot - term_dot));
+            }
+        }
+        Ok((sum, ds))
+    }
 }
 
