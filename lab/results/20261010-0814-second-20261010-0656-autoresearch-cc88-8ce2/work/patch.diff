+/// The re-anchored jet's cadence on this workload (lab 20261010-0814, E2): per body,
+/// the drift a kick adds to the compiled cycle's shape parameter k, accumulated since
+/// the last exact compile; a re-anchor is due when it reaches `theta` (docs/law.md,
+/// error C·drift² with floor 1e-6, C ≈ 1.9 ⇒ theta ≈ 7.3e-4). Pure measurement: no
+/// law runs here, only the keys the shipped rebinds already asked for.
+#[derive(Default)]
+struct JetCadence {
+    theta: f64,
+    /// Per body: (last weak-shape k, drift accumulated since its exact compile).
+    bodies: std::collections::HashMap<usize, (u64, f64)>,
+    kicks: u64,
+    anchors: u64,
+    dk_rel: Vec<f64>,
+}
+impl JetCadence {
+    fn note(&mut self, i: usize, key: &emergent_space::orbit::OrbitKey) {
+        let Ok(shape) = ShapeKey::for_orbit(*key) else { self.bodies.remove(&i); self.anchors += 1; return };
+        let weak = shape.compactness.is_zero(); // the table depends on k alone
+        if !weak {
+            self.bodies.remove(&i); // strong shape: the jet anchors, not updates
+            self.anchors += 1;
+            return;
+        }
+        match self.bodies.get_mut(&i) {
+            Some((k_prev, drift)) => {
+                let (a, b) = (*k_prev, key.k);
+                let dk = (a.max(b) - a.min(b)) as f64 / b as f64;
+                self.dk_rel.push(dk);
+                self.kicks += 1;
+                *k_prev = b;
+                *drift += dk;
+                if *drift >= self.theta {
+                    self.anchors += 1;
+                    *drift = 0.0;
+                }
+            }
+            None => {
+                self.bodies.insert(i, (key.k, 0.0));
+                self.anchors += 1;
+            }
+        }
+    }
+    fn json(&self) -> serde_json::Value {
+        let mut samples = self.dk_rel.clone();
+        percentiles(&mut samples);
+        let mean_anchor_gap = if self.anchors == 0 { 0.0 } else { self.kicks as f64 / self.anchors as f64 };
+        json!({
+            "theta": self.theta, "kicks_between_anchors_mean": mean_anchor_gap,
+            "anchors": self.anchors, "kicks": self.kicks,
+            "compiles_per_kick_amortized": if self.kicks == 0 { f64::NAN } else { self.anchors as f64 / self.kicks as f64 },
+            "dk_rel_per_kick": samples,
+        })
+    }
+}
+
 fn percentiles(samples: &mut [f64]) -> serde_json::Value {
     samples.sort_by(f64::total_cmp);
-    let at = |p: f64| samples.get(((samples.len().saturating_sub(1)) as f64 * p).ceil() as usize).copied();
+    let at = |p: f64| samples.get(((samples.len().saturating_sub(1) as f64 * p).ceil() as usize)).copied();
     json!({"median": at(0.5), "p99": at(0.99), "samples": samples.len()})
 }
 
