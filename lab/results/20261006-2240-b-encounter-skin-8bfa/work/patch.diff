index 0000000..63cb35c
--- /dev/null
+++ b/crates/encounters/src/bin/skin.rs
@@ -0,0 +1,301 @@
+//! The slack-skin measurements (each run ≤ 60 s): `sweep <case> <eps> <kappa> [s_frac]`.
+//!
+//! Per segment: kicks, then each mode's events, then the independent truth (phase-reanchored
+//! copies, conservative advancement over every radially overlapping pair — r8's truth
+//! construction, dense in time), then the matchup. One JSON object per line.
+
+use emergent_encounters::belt::{make_belt, Rng, Spec};
+use emergent_encounters::kepler::{Body, TICKS};
+use emergent_encounters::kepler::rel;
+use emergent_encounters::pairs::{eps_u, norm, radial_pairs};
+use emergent_encounters::skin::{Mode, Skin, SEG};
+use emergent_encounters::truth::{truth_pair, TruthStats};
+use std::f64::consts::TAU;
+use std::time::Instant;
+
+/// Match tolerance in time units (the crate's verify uses 1e-3).
+const TOL: f64 = 1e-3;
+/// r8 v4's dip quantum: a minimum below ρ is an encounter only if the distance rises by at
+/// least δ = 1e-6·ρ on both flanks (h at 1e-5 time units resolves real minima with dip
+/// ~(v·h)²/2d >> δ while sub-δ terraces drop out).
+const DIP: f64 = 1e-6;
+
+fn schedule(n: usize, segments: usize, kappa: f64, eps: f64, seed: u64) -> Vec<Vec<(usize, f64)>> {
+    let mut r = Rng(seed);
+    let whole = kappa.floor() as usize;
+    let frac = kappa - kappa.floor();
+    (0..segments)
+        .map(|_| {
+            let mut v = Vec::new();
+            for i in 0..n {
+                let mut count = whole + (r.f64() < frac) as usize;
+                while count > 0 {
+                    count -= 1;
+                    let sign = if r.f64() < 0.5 { -1.0 } else { 1.0 };
+                    v.push((i, eps * sign));
+                }
+            }
+            v
+        })
+        .collect()
+}
+
+fn make_case(name: &str, seed: u64) -> (Vec<Body>, f64, f64) {
+    let (sp, orbits) = match name {
+        "belt" => (
+            Spec { name: "belt".into(), n: 1500, sigma_e: 1e-2, rho: 1e-4, a_lo: 1.0, a_hi: 1.5, keys: 0, seed, orbits: 0.0 },
+            16.0,
+        ),
+        "ring" => (
+            Spec { name: "ring".into(), n: 300, sigma_e: 0.025, rho: 3e-3, a_lo: 1.0, a_hi: 1.0025, keys: 0, seed, orbits: 10.0 },
+            10.0,
+        ),
+        "fleet" => {
+            let mut r = Rng(seed);
+            let bodies = (0..400)
+                .map(|_| {
+                    let a = 1.0 + 0.01 * r.f64();
+                    let e = (3e-4 * (-2.0 * (1.0 - r.f64()).ln()).sqrt()).min(0.5);
+                    let pom = 0.2 * (r.f64() - 0.5) * TAU;
+                    let lam = 0.1 * (r.f64() - 0.5) * TAU;
+                    Body::new(a, e, pom, lam)
+                })
+                .collect();
+            return (bodies, 1e-3, 10.0);
+        }
+        _ => panic!("unknown case (belt|ring|fleet)"),
+    };
+    (make_belt(&sp), sp.rho, orbits)
+}
+
+fn median_eps_u(b: &[Body], rho: f64) -> f64 {
+    let mut v: Vec<f64> = b.iter().map(|x| eps_u(x, x, rho)).collect();
+    v.sort_by(|a, c| a.total_cmp(c));
+    v[v.len() / 2]
+}
+
+/// r8 v4's dip quantum. Unused here: this harness matches at TOL = 1e-3 time units (the
+/// crate's `verify` convention), which already merges what a dip-quantum split would separate;
+/// the fixed-h flank test instead drops the ring's real slow encounters (rise ~ (v h)²/2d).
+#[allow(dead_code)]
+fn dip_filter(bi: &Body, bj: &Body, rho: f64, ev: &[(f64, f64)]) -> Vec<(f64, f64)> {
+    ev.iter()
+        .filter(|&&(t, d)| {
+            let h = 1e-5;
+            let (ra, _, _) = rel(bi, bj, t - h, true);
+            let (rb, _, _) = rel(bi, bj, t + h, true);
+            let rise = (norm(ra) - d).min(norm(rb) - d);
+            rise >= DIP * rho || rise <= 0.0
+        })
+        .copied()
+        .collect()
+}
+
+/// Independent dense truth for one segment: phase-reanchored copies, conservative advancement
+/// over every radially overlapping pair (r8's construction).
+fn segment_truth(b: &[Body], rho: f64, t_a: f64, out: &mut Vec<(u32, u32, f64, f64)>) {
+    let shifted: Vec<Body> = b
+        .iter()
+        .map(|x| {
+            let lam = x.mean_anomaly(t_a) + x.pom;
+            Body::new(x.a, x.e, x.pom, lam)
+        })
+        .collect();
+    let pairs = radial_pairs(&shifted, rho);
+    let mut st = TruthStats::default();
+    for &(i, j) in &pairs {
+        let mut v = Vec::new();
+        truth_pair(&shifted[i as usize], &shifted[j as usize], rho, SEG, &mut v, &mut st);
+        for &(t, d) in &v {
+            out.push((i, j, t + t_a, d));
+        }
+    }
+}
+
+/// Per (segment, pair) matchup: (missed, false, truth_n) plus details of the first misses.
+fn compare(
+    truth: &[(usize, u32, u32, f64, f64)],
+    other: &[(usize, u32, u32, f64, f64)],
+) -> (u64, u64, u64, Vec<(usize, u32, u32, f64)>) {
+    let mut by_pair: std::collections::HashMap<(usize, u32, u32), Vec<f64>> = std::collections::HashMap::new();
+    for &(sg, i, j, t, _) in other {
+        by_pair.entry((sg, i, j)).or_default().push(t);
+    }
+    let mut tby: std::collections::HashMap<(usize, u32, u32), Vec<f64>> = std::collections::HashMap::new();
+    for &(sg, i, j, t, _) in truth {
+        tby.entry((sg, i, j)).or_default().push(t);
+    }
+    let mut missed = 0u64;
+    let mut det = Vec::new();
+    for &(sg, i, j, t, _) in truth {
+        if !by_pair.get(&(sg, i, j)).is_some_and(|v| v.iter().any(|&x| (x - t).abs() < TOL)) {
+            missed += 1;
+            if det.len() < 8 {
+                det.push((sg, i, j, t));
+            }
+        }
+    }
+    let mut false_ = 0u64;
+    for &(sg, i, j, t, _) in other {
+        if !tby.get(&(sg, i, j)).is_some_and(|v| v.iter().any(|&x| (x - t).abs() < TOL)) {
+            false_ += 1;
+        }
+    }
+    (missed, false_, truth.len() as u64, det)
+}
+
+struct RunResult {
+    events: Vec<(usize, u32, u32, f64, f64)>,
+    c: emergent_encounters::skin::Counters,
+    wall: f64,
+}
+
+fn run(
+    bodies: &[Body],
+    rho: f64,
+    orbits: f64,
+    mode: Mode,
+    s: f64,
+    eps: f64,
+    kappa: f64,
+    seed: u64,
+) -> RunResult {
+    let segments = (orbits * TAU / SEG).round() as usize;
+    let sched = schedule(bodies.len(), segments, kappa, eps, seed);
+    let mut w = Skin::new(bodies.to_vec(), rho, s, mode);
+    let reach_extra = 4.0 * eps * (kappa + 1.0);
+    let wall = Instant::now();
+    w.initial_scan();
+    let mut all_events = Vec::new();
+    for (sg, seg_kicks) in sched.iter().enumerate() {
+        let t_a = sg as f64 * SEG;
+        let mut ev = Vec::new();
+        w.advance(t_a, t_a + SEG, seg_kicks, reach_extra, &mut ev);
+        for &(i, j, t, d) in &ev {
+            all_events.push((sg, i, j, t, d));
+        }
+    }
+    RunResult { events: all_events, c: w.c, wall: wall.elapsed().as_secs_f64() }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    // sweep <case> <eps> <kappa> [s_frac]
+    let case = args[1].clone();
+    let eps: f64 = args[2].parse().unwrap();
+    let kappa: f64 = args[3].parse().unwrap();
+    let s_frac: f64 = args.get(4).map(|x| x.parse().unwrap()).unwrap_or(4.0);
+    let seed = 20261006u64;
+    let (bodies, rho, orbits) = make_case(&case, seed);
+    let s = s_frac * median_eps_u(&bodies, rho);
+    let segments = (orbits * TAU / SEG).round() as usize;
+    let sched = schedule(bodies.len(), segments, kappa, eps, seed);
+
+    // The truth, once, driven by the same kick schedule; events tagged with their segment.
+    let t0 = Instant::now();
+    let mut truth: Vec<(usize, u32, u32, f64, f64)> = Vec::new();
+    let mut cur = bodies.clone();
+    for (sg, seg_kicks) in sched.iter().enumerate() {
+        let t_a = sg as f64 * SEG;
+        for &(i, frac) in seg_kicks {
+            let old = cur[i];
+            let lam = old.mean_anomaly(t_a) + old.pom;
+            let a_new = old.a * (1.0 + frac);
+            let n_new = a_new.powf(-1.5);
+            cur[i] = Body::new(a_new, old.e, old.pom, lam - n_new * t_a);
+        }
+        let mut seg_ev = Vec::new();
+        segment_truth(&cur, rho, t_a, &mut seg_ev);
+        for &(i, j, t, d) in &seg_ev {
+            truth.push((sg, i, j, t, d));
+        }
+    }
+    let truth_s = t0.elapsed().as_secs_f64();
+
+
+    let kicks_total: u64 = sched.iter().map(|v| v.len() as u64).sum();
+    for (mode, s_val) in [(Mode::Always, 0.0), (Mode::Skin, s)] {
+        let r = run(&bodies, rho, orbits, mode, s_val, eps, kappa, seed);
+        let (missed, false_e, truth_n, det) = compare(&truth, &r.events);
+        let c = &r.c;
+        let kf = c.kicks.max(1) as f64;
+        println!(
+            "{{\"case\":\"{}\",\"mode\":\"{}\",\"eps\":{:.0e},\"kappa\":{},\"s_frac\":{},\"s\":{:.3e},\"kicks\":{},\"truth_n\":{},\"missed\":{},\"false\":{},\
+\"seg_events\":{},\"setups_per_kick\":{:.2},\"setup_new\":{:.2},\"trig\":{:.2},\"sat\":{:.2},\"tang\":{:.2},\"scans_per_kick\":{:.4},\"cone_per_kick\":{:.2},\
+\"checks_per_kick\":{:.2},\"evals_per_kick\":{:.0},\"false_cand_frac\":{:.4},\"wall_s\":{:.1}}}",
+            case,
+            if mode == Mode::Always { "always" } else { "skin" },
+            eps,
+            kappa,
+            s_frac,
+            s_val,
+            c.kicks,
+            truth_n,
+            missed,
+            false_e,
+            r.events.len(),
+            c.setups as f64 / kf,
+            c.setup_new as f64 / kf,
+            c.trig_resets as f64 / kf,
+            c.sat_resets as f64 / kf,
+            c.tangency_resets as f64 / kf,
+            c.scans as f64 / kf,
+            c.cone_tests as f64 / kf,
+            c.st.checks_total() as f64 / kf,
+            c.st.evals as f64 / kf,
+            c.false_cand as f64 / c.cert_samples.max(1) as f64,
+            r.wall
+        );
+        if missed > 0 && mode == Mode::Skin {
+            // Diagnose the first miss per segment: was the encounter's offset outside the
+            // widened window, or inside it (then the check interval is the culprit)?
+            let mut skin_w = Skin::new(bodies.to_vec(), rho, s, Mode::Skin);
+            let rex = 4.0 * eps * (kappa + 1.0);
+            skin_w.initial_scan();
+            for (sg, seg_kicks) in sched.iter().enumerate() {
+                let t_a = sg as f64 * SEG;
+                let mut ev = Vec::new();
+                skin_w.advance(t_a, t_a + SEG, seg_kicks, rex, &mut ev);
+                for &(msg, i, j, t_true) in &det {
+                    if msg != sg {
+                        continue;
+                    }
+                    println!("{{\"diag\":\"at_miss\",\"seg\":{},\"i\":{},\"j\":{},\"t_true\":{:.4},\"n_certs\":{},\"has\":{}}}", msg, i, j, t_true, skin_w.certs.len(), skin_w.certs.contains_key(&(i.min(j), j.max(i))));
+                    let bi = skin_w.b[i as usize];
+                    let bj = skin_w.b[j as usize];
+                    let cert = match skin_w.certs.get(&(i.min(j), j.max(i))) {
+                        Some(c) => c,
+                        None => {
+                            println!("{{\"diag\":\"no cert at miss\"}}");
+                            continue;
+                        }
+                    };
+                    // The library's own widened sections, against the true offset.
+                    let widened = skin_w.widened(cert, i.min(j), j.max(i), t_a + SEG);
+                    let tt = t_true * TICKS;
+                    for (si, sec) in cert.secs.iter().enumerate() {
+                        let pj = bj.period as f64;
+                        let pi = bi.period as f64;
+                        let tp_j = sec.tj as f64 + ((tt - sec.tj as f64) / pj).round() * pj;
+                        let tp_i = sec.ti as f64 + ((tt - sec.ti as f64) / pi).round() * pi;
+                        let s_star = tp_i - tp_j;
+                        let drift = (skin_w.dbin[i as usize] - cert.b0[0]) + (skin_w.dbin[j as usize] - cert.b0[1]);
+                        let wl = match &widened { Some(v) => (v[si].w1, v[si].w2), None => (-1, -1) };
+                        println!(
+                            "{{\"diag\":\"lib\",\"seg\":{},\"i\":{},\"j\":{},\"kind\":\"{}\",\"s_star_ticks\":{:.3e},\"stored_w\":[{},{}],\"drift\":{:.2e},\"g\":{:.2e},\"q\":{:.2e},\"caps\":[{:.2e},{:.2e},{:.2e},{:.2e}],\"widened_ok\":{},\"w_lib\":[{},{}]",
+                            sg, i, j, emergent_encounters::method::kind_name(sec.kind), s_star, sec.w1, sec.w2,
+                            drift, cert.g, cert.q, sec.di.0, sec.di.1, sec.dj.0, sec.dj.1, widened.is_some(), wl.0, wl.1
+                        );
+                    }
+                    let mut fresh_ev = Vec::new();
+                    let mut st = emergent_encounters::method::Stats::default();
+                    emergent_encounters::method::pair_events(&bi, &bj, rho, 1.1, t_a, t_a + SEG, &mut st, &mut fresh_ev);
+                    let found = fresh_ev.iter().any(|&(t, _)| (t - t_true).abs() < TOL);
+                    println!("{{\"diag\":\"fresh_finds\":{}}}", found);
+                }
+            }
+        }
+    }
+    println!("{{\"case\":\"{}\",\"eps\":{:.0e},\"kappa\":{},\"truth_s\":{:.1},\"segments\":{},\"kicks\":{}}}", case, eps, kappa, truth_s, segments, kicks_total);
+    let _ = (TOL, DIP);
+}
