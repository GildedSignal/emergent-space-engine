+// Lab instrumentation (run 20261018-2040-second-20261018-1617-spacex-37c1-3ac3). The contact
+// root's closed form (20261018-0722-scout-6362) on this operator: at a resolve instant where
+// the receding gate holds (d·w ≥ 0), the pair's first-touch separation direction is
+// n = P − √Δ·w (scaled by |w|²), with P = |w|²·d − (d·w)·w an integer vector, w·P = 0 exact,
+// |P|² = |w|²·(|w|²|d|² − (d·w)²) and Δ = |w|²·reach² − (|w|²|d|² − (d·w)²) ≥ 0 iff the
+// linear back-projection comes within reach (then |n| = |w|²·reach exactly and w·n = −√Δ·|w|²
+// < 0: the root normal is an approaching normal). √Δ is the only irrational; quantized to
+// k ≤ 20 fractional bits it costs one u128 isqrt. The oracle keeps 48 bits in big integers.
+
+/// Δ of the touch quadratic: ≥ 0 iff the pair's linear back-projection from (d, w) comes
+/// within `reach` (its closest approach |d*|² = (|w|²|d|² − (d·w)²)/|w|² satisfies
+/// |d*|² ≤ reach²). None when w = 0 or a product leaves i128.
+pub fn root_disc(d: [i128; 2], w: [i128; 2], reach: i128) -> Option<i128> {
+    let r = w[0].checked_mul(w[0])?.checked_add(w[1].checked_mul(w[1])?)?;
+    if r == 0 {
+        return None;
+    }
+    let dd = d[0].checked_mul(d[0])?.checked_add(d[1].checked_mul(d[1])?)?;
+    let dw = d[0].checked_mul(w[0])?.checked_add(d[1].checked_mul(w[1])?)?;
+    let disc = r.checked_mul(dd)?.checked_sub(dw.checked_mul(dw)?)?;
+    r.checked_mul(reach.checked_mul(reach)?)?.checked_sub(disc)
+}
+
+/// The quantized root normal n_q = (P << k) − S·w with S = ⌊2^k·√Δ⌋, k the widest
+/// quantization whose isqrt input fits u128 (≤ `kmax`). Direction of the first-touch
+/// separation; any positive scale is a valid reflection normal for [`targets`].
+/// None when Δ < 0 (no root) or w = 0.
+pub fn root_normal(d: [i128; 2], w: [i128; 2], reach: i128, kmax: u32) -> Option<[i128; 2]> {
+    let r = w[0].checked_mul(w[0])?.checked_add(w[1].checked_mul(w[1])?)?;
+    let delta = root_disc(d, w, reach)?;
+    if delta < 0 {
+        return None;
+    }
+    let dw = d[0] * w[0] + d[1] * w[1];
+    let bits = 128 - (delta as u128).leading_zeros();
+    let k = kmax.min((126 - bits) / 2);
+    let s = ((delta as u128) << (2 * k) as u32).isqrt() as i128;
+    let p = [r * d[0] - dw * w[0], r * d[1] - dw * w[1]];
+    Some([(p[0] << k) - s * w[0], (p[1] << k) - s * w[1]])
+}
+
+/// The oracle's root normal: √Δ to 48 fractional bits in big integers (one Newton isqrt),
+/// so its direction error is 2^-48-class against the rule's 2^-20. Same scale licence.
+pub fn root_normal_exact(d: [i128; 2], w: [i128; 2], reach: i128) -> Option<[i128; 2]> {
+    fn isqrt(n: num_bigint::BigUint) -> num_bigint::BigUint {
+        if n == num_bigint::BigUint::from(0u32) {
+            return n;
+        }
+        let mut x = num_bigint::BigUint::from(1u32) << ((n.bits() + 1) / 2);
+        loop {
+            let y = (&x + &n / &x) >> 1;
+            if y >= x {
+                return x;
+            }
+            x = y;
+        }
+    }
+    let r = w[0].checked_mul(w[0])?.checked_add(w[1].checked_mul(w[1])?)?;
+    let delta = root_disc(d, w, reach)?;
+    if delta < 0 {
+        return None;
+    }
+    let dw = d[0] * w[0] + d[1] * w[1];
+    let s = isqrt(num_bigint::BigUint::from(delta as u128) << 96);
+    let s48 = i128::try_from(s).expect("2^48·√Δ of an i128 Δ fits i128");
+    let p = [r * d[0] - dw * w[0], r * d[1] - dw * w[1]];
+    Some([(p[0] << 48) - s48 * w[0], (p[1] << 48) - s48 * w[1]])
+}
 
