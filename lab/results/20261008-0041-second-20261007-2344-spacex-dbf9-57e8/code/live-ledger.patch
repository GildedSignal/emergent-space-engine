@@ -0,0 +1,196 @@
+//! H_live: the live distinguishing information the universe gains per unit of simulated time
+//! (docs/plane.md, "Measured on the whole"). This, not the body count, decides whether a billion
+//! bodies fit: bodies are stored as generators (tubes), and a body only costs live memory for the
+//! distinctions it has accumulated off its birth generator.
+//!
+//! **The measure is a storage bound, exact and integer.** A body's canonical state is its binding;
+//! its birth binding is the program it was launched on. The live bits of a body are the bits of a
+//! minimal delta encoding of its current binding against its birth binding, field by field:
+//!
+//! - the memo key (quantized E and L): `1 + 32` bits when it moved (the law's own key width,
+//!   docs/law.md "Populations");
+//! - the periapsis angle: `1 + bitlen(min(|Δ|, 2³²−|Δ|))` when it moved (a Q32 turn: the delta is
+//!   circular);
+//! - the periapsis time: `1 + bitlen(|Δ|)` when it moved.
+//!
+//! Every rebind is charged once, as the actual old→new delta of the body it belongs to (the 5 Oct
+//! lesson: distinct events, never re-timed ones). **Created** is the positive part of the change of
+//! a body's live bits, **reabsorbed** the negative part (a body whose bits reach zero sits again on
+//! its birth generator: its scar is deletable). A doll change is a re-expression, not a physical
+//! distinction: the ledger is carried across it (the accumulated bits stay), the new birth anchor is
+//! the re-expressed binding, and the event charges the one flag bit that says "re-expressed".
+//!
+//! The channels: kicks (physical), handoffs (representation), decisions (the player, the only
+//! wildcard: a decision word costs its 8 bits when it *changes*), other (opens and boundaries).
+//! Fleet battles (frame members, not tubes) and sub-quantum residuals (re-derived at every rebind,
+//! bounded) are outside this ledger: see the dossier for the gap.
+//!
+//! Nothing here feeds an outcome: the ledger is a pure read at the point a record is applied, so
+//! digests are unchanged.
+use crate::bind::Binding;
+use emergent_space::orbit::OrbitKey;
+use emergent_space::orbit::Scalar;
+
+pub const KICK: usize = 0;
+pub const HANDOFF: usize = 1;
+pub const DECISION: usize = 2;
+pub const OTHER: usize = 3;
+
+/// The compared fields of one binding.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+struct Fields {
+    doll: u16,
+    key: OrbitKey,
+    angle: u32,
+    time: i64,
+}
+
+impl Default for Fields {
+    fn default() -> Self {
+        Self { doll: 0, key: OrbitKey { periapsis: Scalar::ZERO, k: 1, null: false }, angle: 0, time: 0 }
+    }
+}
+
+impl Fields {
+    fn of(b: &Binding) -> Self {
+        Self {
+            doll: b.doll,
+            key: b.entry.trajectory.key(),
+            angle: b.tube.periapsis_angle,
+            time: b.tube.periapsis_time.get() as i64,
+        }
+    }
+}
+
+/// The bits of a minimal delta encoding of `f` given `g` (same doll; see the module doc).
+fn enc(f: &Fields, g: &Fields) -> u64 {
+    let mut bits = 0u64;
+    if f.key != g.key {
+        bits += 1 + 32;
+    }
+    if f.angle != g.angle {
+        let d = f.angle.wrapping_sub(g.angle).min(g.angle.wrapping_sub(f.angle));
+        bits += 1 + u32::BITS as u64 - d.leading_zeros() as u64;
+    }
+    if f.time != g.time {
+        bits += 1 + (f.time.wrapping_sub(g.time).unsigned_abs() as u64).ilog2() as u64 + 1;
+    }
+    bits
+}
+
+/// One body's ledger entry.
+#[derive(Clone, Copy, Default)]
+struct Body {
+    present: bool,
+    birth: Fields,
+    last: Fields,
+    live: u64,
+}
+
+/// The universe's H_live ledger. All counters are exact integers.
+#[derive(Default)]
+pub struct Live {
+    bodies: Vec<Body>,
+    /// Created and reabsorbed bits, per channel.
+    pub created: [u64; 4],
+    pub reabsorbed: [u64; 4],
+    /// Σ live bits over bodies (bodies at their birth generator contribute zero).
+    pub live_now: u64,
+    /// Rebinds seen (an apply of a body record), and kick rebinds whose tube fields did not move
+    /// at all (the kick was swallowed by the tube's own resolution).
+    pub rebinds: u64,
+    pub swallowed: u64,
+    /// Decision words seen and distinct (the wildcard's own bits: 8 per distinct word).
+    pub words: u64,
+    pub words_distinct: u64,
+    last_word: Option<u8>,
+}
+
+impl Live {
+    /// Charge one applied record against body `i`'s ledger. `ch` is the channel.
+    pub fn note(&mut self, i: usize, ch: usize, b: &Binding) {
+        let f = Fields::of(b);
+        if i >= self.bodies.len() {
+            self.bodies.resize(i + 1, Body::default());
+        }
+        let body = &mut self.bodies[i];
+        if !body.present {
+            body.present = true;
+            body.birth = f;
+            body.last = f;
+            return;
+        }
+        self.rebinds += 1;
+        if ch == KICK && f.key == body.last.key && f.angle == body.last.angle && f.time == body.last.time {
+            self.swallowed += 1;
+        }
+        let before = body.live;
+        let after = if f.doll != body.last.doll {
+            // A re-expression: the physical ledger carries (one flag bit), the anchor is new.
+            body.birth = f;
+            body.live + 1
+        } else {
+            enc(&f, &body.birth)
+        };
+        if after > before {
+            self.created[ch] += after - before;
+        } else {
+            self.reabsorbed[ch] += before - after;
+        }
+        self.live_now = (self.live_now as i128 + after as i128 - before as i128) as u64;
+        body.live = after;
+        body.last = f;
+    }
+
+    /// A decision word: the player's own bits (8 when the word changes, none when it repeats).
+    pub fn decision(&mut self, word: u8) {
+        self.words += 1;
+        if self.last_word != Some(word) {
+            self.words_distinct += 1;
+            self.created[DECISION] += 8;
+            self.live_now += 8;
+        }
+        self.last_word = Some(word);
+    }
+
+    /// Bodies tracked, and how many sit exactly on their birth generator (scar deletable).
+    pub fn tracked(&self) -> (u64, u64) {
+        let (mut n, mut zero) = (0u64, 0u64);
+        for b in &self.bodies {
+            if b.present {
+                n += 1;
+                zero += (b.live == 0) as u64;
+            }
+        }
+        (n, zero)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn key(k: i64) -> OrbitKey {
+        OrbitKey { periapsis: Scalar::integer(k), k: 1 << 47, null: false }
+    }
+
+    fn f(doll: u16, k: i64, angle: u32, time: i64) -> Fields {
+        Fields { doll, key: key(k), angle, time }
+    }
+
+    #[test]
+    fn enc_is_zero_on_the_generator_and_grows_with_the_delta() {
+        let g = f(0, 10, 100, 1000);
+        assert_eq!(enc(&g, &g), 0);
+        assert_eq!(enc(&f(0, 11, 100, 1000), &g), 33, "a moved key is the flag plus the law's 32-bit key width");
+        assert_eq!(enc(&f(0, 10, 101, 1000), &g), 2, "an angle delta of 1 costs a flag and one bit");
+        assert!(enc(&f(0, 10, 100, 2000), &g) > enc(&f(0, 10, 100, 1001), &g));
+        assert_eq!(enc(&f(0, 11, 200, 1), &g), enc(&f(0, 11, 100, 1000), &g) + enc(&f(0, 10, 200, 1), &g));
+    }
+
+    #[test]
+    fn the_circular_angle_takes_the_short_way_round() {
+        let g = f(0, 10, 1, 0);
+        assert_eq!(enc(&f(0, 10, u32::MAX, 0), &g), 3, "2³²−1 turns is 1 step the other way: a flag and two bits");
+    }
+}
