diff --git a/crates/universe/tests/h_live.rs b/crates/universe/tests/h_live.rs
new file mode 100644
index 0000000..31a3ac0
--- /dev/null
+++ b/crates/universe/tests/h_live.rs
@@ -0,0 +1,67 @@
+//! The H_live ledger (docs/plane.md, "Distinctions created per game-second"): an exact integer
+//! account of the live distinguishing information, and a function of the canonical event stream
+//! alone (never of the budget or the threads). Every test finishes within 60 s.
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::{Budget, Config};
+
+const MEMBERS: u64 = 24;
+const HORIZON: i64 = 400_000_000; // about 33 minutes of game time
+const INPUTS: [(i64, u8); 4] = [(50_000_000, 1), (52_000_000, 0), (300_000_000, 9), (302_000_000, 0)];
+
+fn run(budget: Budget, step: i64) -> (emergent_universe::universe::Universe, String) {
+    let mut p = plane(Config::default(), 7, Order::Sparse, 1, MEMBERS).unwrap();
+    let mut next = 0;
+    while p.u.now < HORIZON {
+        let mut target = (p.u.now + step).min(HORIZON);
+        if let Some(&(t, _)) = INPUTS.get(next) {
+            target = target.min(t.max(p.u.now + 1));
+        }
+        let a = p.u.advance(target, budget);
+        p.u.now = a.horizon.max(p.u.now);
+        if let Some(&(t, keys)) = INPUTS.get(next) {
+            if p.u.now >= t {
+                p.u.input(t, keys).unwrap();
+                next += 1;
+            }
+        }
+        if a.events == 0 && a.overflow {
+            p.u.settle(target);
+        }
+    }
+    p.u.settle(HORIZON);
+    let d = p.u.digest();
+    (p.u, d)
+}
+
+#[test]
+fn the_ledger_balances_exactly_and_sees_the_stream() {
+    let (u, _) = run(Budget::unlimited(), 20_000_000);
+    let created: u64 = u.live.created.iter().sum();
+    let reabsorbed: u64 = u.live.reabsorbed.iter().sum();
+    assert!(u.live.rebinds > 0, "the ledger must see rebinds");
+    assert!(created > 0, "the ledger must see distinctions created");
+    assert_eq!(
+        created - reabsorbed,
+        u.live.live_now,
+        "created minus reabsorbed is exactly the live bits now (the ledger balances)"
+    );
+    let (tracked, on_generator) = u.live.tracked();
+    assert!(tracked > 0 && tracked <= u.n_bodies() as u64);
+    assert!(on_generator <= tracked);
+    println!(
+        "rebinds {}, swallowed {}, created {created}, reabsorbed {reabsorbed}, live {}, tracked {tracked} (on generator {on_generator})",
+        u.live.rebinds, u.live.swallowed, u.live.live_now
+    );
+}
+
+#[test]
+fn the_ledger_is_a_function_of_the_canonical_stream() {
+    let reference = run(Budget::unlimited(), 20_000_000);
+    let budgeted = run(Budget::events(37), 3_000_000);
+    assert_eq!(reference.1, budgeted.1, "one input log, one seed, one cut: one digest");
+    assert_eq!(reference.0.live.live_now, budgeted.0.live.live_now);
+    assert_eq!(reference.0.live.created, budgeted.0.live.created);
+    assert_eq!(reference.0.live.reabsorbed, budgeted.0.live.reabsorbed);
+    assert_eq!(reference.0.live.swallowed, budgeted.0.live.swallowed);
+}
