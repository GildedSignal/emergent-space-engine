+//! Inversion experiment (run 20261011-2235): is the phase-neighbour certificate's rank claim
+//! horizon-stable? Measures, per scene: the λ(0)-rank of every encounter the shipped method finds
+//! (rank0), the λ-rank at the encounter itself (rank_at, the trivial-adjacency control), closed-form
+//! conjunction volumes (the swap channel a re-certifying certificate must pay), and the eager/lazy
+//! pair counts (the deferral saving the gold reported as "replaces the quadratic tier").
+//!
+//! One JSON object per line on stdout. λ(t) = mean_anomaly(t) + ϖ, from the crate's integer clock.
+
+use emergent_encounters::belt::{make_belt, Rng, Spec};
+use emergent_encounters::kepler::Body;
+use emergent_encounters::method::{pair_events, Stats};
+use emergent_encounters::pairs::{cone_pairs, sections};
+use emergent_encounters::par_chunks;
+use std::f64::consts::TAU;
+use std::time::Instant;
+
+const THREADS: usize = 4;
+const SAFETY: f64 = 1.1;
+
+fn lam(b: &Body, t: f64) -> f64 {
+    b.mean_anomaly(t) + b.pom
+}
+
+/// Bodies strictly between i and j on the short arc of the circular λ order at time t.
+fn rank_between(b: &[Body], i: u32, j: u32, t: f64) -> usize {
+    let (li, lj) = (lam(&b[i as usize], t), lam(&b[j as usize], t));
+    let (lo, hi) = if li <= lj { (li, lj) } else { (lj, li) };
+    let w = hi - lo;
+    let (lo, w) = if w < TAU - w { (lo, w) } else { (hi, TAU - w) };
+    b.iter()
+        .enumerate()
+        .filter(|&(k, _)| k != i as usize && k != j as usize)
+        .filter(|&(_, x)| {
+            let l = lam(x, t);
+            let d = (l - lo).rem_euclid(TAU);
+            d > 0.0 && d < w
+        })
+        .count()
+}
+
+/// Conjunctions of pair (i, j) in [0, t_end]: crossings of Δλ ≡ 0 (mod 2π).
+fn conj_count(bi: &Body, bj: &Body, t_end: f64) -> u64 {
+    let dn = bi.n - bj.n;
+    if dn.abs() < 1e-14 {
+        return 0;
+    }
+    let x = (lam(bi, 0.0) - lam(bj, 0.0)).rem_euclid(TAU);
+    let s = if dn > 0.0 { TAU - x } else { x };
+    let swept = dn.abs() * t_end;
+    if swept < s {
+        0
+    } else {
+        1 + ((swept - s) / TAU).floor() as u64
+    }
+}
+
+struct Scene {
+    name: String,
+    b: Vec<Body>,
+    rho: f64,
+    orbits: f64,
+    /// Cross-group marker: body class (0 = ring A, 1 = stream B), for the split metrics.
+    class: Vec<u8>,
+}
+
+fn ring_scene(name: &str, n: usize, sigma_e: f64, rho: f64, da: f64, orbits: f64, seed: u64) -> Scene {
+    let sp = Spec {
+        name: name.into(),
+        n,
+        sigma_e,
+        rho,
+        a_lo: 1.0,
+        a_hi: 1.0 + da,
+        keys: 0,
+        seed,
+        orbits: 0.0,
+    };
+    Scene { name: name.into(), b: make_belt(&sp), rho, orbits, class: vec![0; n] }
+}
+
+/// A fleet ring (A) plus an eccentric crossing stream (B) on a = 1.3, e ≈ 0.25.
+fn cross_scene(name: &str, na: usize, nb: usize, rho: f64, orbits: f64, seed: u64) -> Scene {
+    let a = ring_scene("A", na, 3e-4, rho, 1e-4, orbits, seed);
+    let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15));
+    let mut b = a.b;
+    let mut class = vec![0u8; na];
+    for _ in 0..nb {
+        let au = 1.3 + 1e-4 * rng.f64();
+        let u = rng.f64();
+        let e = 0.25 + 3e-4 * (-2.0 * (1.0 - u).ln()).sqrt();
+        b.push(Body::new(au, e, TAU * rng.f64(), TAU * rng.f64()));
+        class.push(1);
+    }
+    Scene { name: name.into(), b, rho, orbits, class }
+}
+
+fn run(s: Scene) {
+    let t_all = Instant::now();
+    let n = s.b.len();
+    let t_end = s.orbits * TAU;
+    let cclass = |i: u32, j: u32| -> usize {
+        match (s.class[i as usize], s.class[j as usize]) {
+            (0, 0) => 0,
+            (1, 1) => 3,
+            _ => 2,
+        }
+    };
+
+    // Eager tier: the cone candidate set (what the quadratic tier sets up).
+    let t0 = Instant::now();
+    let cs = cone_pairs(&s.b, s.rho);
+    let cone_s = t0.elapsed().as_secs_f64();
+    let eager = cs.pairs.len() as u64;
+
+    // Section kinds over the eager set (the eager setup cost object).
+    let (mut kinds, mut none, mut sec_evals) = ([0u64; 3], 0u64, 0u64);
+    for &(i, j) in &cs.pairs {
+        let v = sections(&s.b[i as usize], &s.b[j as usize], s.rho, SAFETY, &mut sec_evals);
+        if v.is_empty() {
+            none += 1;
+        } else {
+            for sec in v {
+                kinds[sec.kind as usize] += 1;
+            }
+        }
+    }
+
+    // The shipped method's encounters over the eager set.
+    let t1 = Instant::now();
+    let parts = par_chunks(cs.pairs.len(), 256, THREADS, |r| {
+        let mut st = Stats::default();
+        let mut tmp = Vec::new();
+        let mut ev = Vec::new();
+        for &(i, j) in &cs.pairs[r] {
+            tmp.clear();
+            pair_events(&s.b[i as usize], &s.b[j as usize], s.rho, SAFETY, 0.0, t_end, &mut st, &mut tmp);
+            ev.extend(tmp.iter().map(|&(t, _)| (i, j, t)));
+        }
+        (ev, st)
+    });
+    let mut enc: Vec<(u32, u32, f64)> = Vec::new();
+    let mut mst = Stats::default();
+    for (e, st) in parts {
+        enc.extend(e);
+        mst.add(&st);
+    }
+    let meth_s = t1.elapsed().as_secs_f64();
+
+    // Rank coverage and class splits. by_class[c] = (enc, cov4, conj, lazy); c: 0=AA 2=AB 3=BB.
+    let mut by_class: Vec<(u64, u64, u64, u64)> = vec![(0, 0, 0, 0); 4];
+    let (mut max_r0, mut max_rat, mut cov4) = (0usize, 0usize, 0u64);
+    let mut r0s: Vec<usize> = Vec::with_capacity(enc.len());
+    for &(i, j, t) in &enc {
+        let r0 = rank_between(&s.b, i, j, 0.0);
+        r0s.push(r0);
+        let rat = rank_between(&s.b, i, j, t);
+        max_r0 = max_r0.max(r0);
+        max_rat = max_rat.max(rat);
+        cov4 += (r0 <= 4) as u64;
+        let c = cclass(i, j);
+        by_class[c].0 += 1;
+        by_class[c].1 += (r0 <= 4) as u64;
+    }
+    r0s.sort_unstable();
+    let p95r = if r0s.is_empty() { 0 } else { r0s[r0s.len() * 95 / 100] };
+    let mean_r0 = if r0s.is_empty() { 0.0 } else { r0s.iter().sum::<usize>() as f64 / r0s.len() as f64 };
+
+    // Conjunction volumes: over the eager set (the swap channel inside the candidate tier) and over
+    // all pairs (a global rank-sort certificate's channel), split by class pair.
+    let (mut conj_eager, mut lazy_eager) = (0u64, 0u64);
+    for &(i, j) in &cs.pairs {
+        let k = conj_count(&s.b[i as usize], &s.b[j as usize], t_end);
+        conj_eager += k;
+        lazy_eager += (k >= 1) as u64;
+    }
+    let (mut conj_all, mut lazy_all) = (0u64, 0u64);
+    for i in 0..n {
+        for j in (i + 1)..n {
+            let k = conj_count(&s.b[i], &s.b[j], t_end);
+            conj_all += k;
+            lazy_all += (k >= 1) as u64;
+            let c = cclass(i as u32, j as u32);
+            by_class[c].2 += k;
+            by_class[c].3 += (k >= 1) as u64;
+        }
+    }
+
+    let enc_n = enc.len().max(1) as f64;
+    println!(
+        "{{\"scene\":\"{}\",\"n\":{},\"rho\":{},\"orbits\":{},\"eager_pairs\":{},\"cone_scanned\":{},\"cone_s\":{:.3},\"sec_cross\":{},\"sec_wide\":{},\"sec_full\":{},\"sec_none\":{},\"sec_evals\":{},\
+\"enc\":{},\"meth_s\":{:.2},\"max_rank0\":{},\"p95_rank0\":{},\"mean_rank0\":{:.2},\"max_rank_at\":{},\"cov_k4\":{:.4},\
+\"conj_eager\":{},\"lazy_eager\":{},\"conj_all\":{},\"lazy_all\":{},\
+\"eager_per_enc\":{:.1},\"lazy_eager_per_enc\":{:.2},\"lazy_all_per_enc\":{:.2},\"conj_all_per_enc\":{:.2},\"deferral_saving\":{:.1},\
+\"checks\":{},\"queries\":{},\"qsteps\":{},\"meth_evals\":{},\
+\"enc_aa\":{},\"cov4_aa\":{},\"conj_aa\":{},\"lazy_aa\":{},\"enc_ab\":{},\"cov4_ab\":{},\"conj_ab\":{},\"lazy_ab\":{},\"enc_bb\":{},\"cov4_bb\":{},\"conj_bb\":{},\"lazy_bb\":{},\"wall_s\":{:.1}}}",
+        s.name, n, s.rho, s.orbits, eager, cs.scanned, cone_s, kinds[0], kinds[1], kinds[2], none, sec_evals,
+        enc.len(), meth_s, max_r0, p95r, mean_r0, max_rat, cov4 as f64 / enc_n,
+        conj_eager, lazy_eager, conj_all, lazy_all,
+        eager as f64 / enc_n, lazy_eager as f64 / enc_n, lazy_all as f64 / enc_n, conj_all as f64 / enc_n,
+        eager as f64 / lazy_eager.max(1) as f64,
+        mst.checks_total(), mst.queries, mst.qsteps, mst.evals,
+        by_class[0].0, by_class[0].1, by_class[0].2, by_class[0].3,
+        by_class[2].0, by_class[2].1, by_class[2].2, by_class[2].3,
+        by_class[3].0, by_class[3].1, by_class[3].2, by_class[3].3,
+        t_all.elapsed().as_secs_f64()
+    );
+}
+
+fn main() {
+    let s = 20261010u64; // matches verify set c's "coorbital" seed
+    for &orb in &[50.0, 200.0, 1000.0, 5000.0] {
+        run(ring_scene(&format!("gold-{orb:.0}"), 300, 3e-4, 1e-3, 1e-4, orb, s));
+    }
+    for &da in &[3e-4, 1e-3, 3e-3, 1e-2] {
+        run(ring_scene(&format!("spread-{da:e}"), 300, 3e-4, 1e-3, da, 200.0, s + 1));
+    }
+    run(ring_scene("hot", 300, 3e-2, 1e-3, 1e-4, 200.0, s + 2));
+    run(cross_scene("cross", 150, 150, 1e-3, 200.0, s + 3));
+}
