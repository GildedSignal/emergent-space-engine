+fn main() {
+    let s = 20261010u64;
+    let sc = ring_scene("gold-5000", 300, 3e-4, 1e-3, 1e-4, 5000.0, s);
+    let t_end = sc.orbits * std::f64::consts::TAU;
+    let cs = cone_pairs(&sc.b, sc.rho);
+    let parts = par_chunks(cs.pairs.len(), 256, THREADS, |r| {
+        let mut st = Stats::default();
+        let mut tmp = Vec::new();
+        let mut ev = Vec::new();
+        for &(i, j) in &cs.pairs[r] {
+            tmp.clear();
+            pair_events(&sc.b[i as usize], &sc.b[j as usize], sc.rho, SAFETY, 0.0, t_end, &mut st, &mut tmp);
+            let n_ev = tmp.len() as u64;
+            if n_ev > 0 {
+                ev.push((i, j, n_ev, tmp[0].0));
+            }
+        }
+        ev
+    });
+    let mut pairs: Vec<(u32, u32, u64, f64)> = parts.into_iter().flatten().collect();
+    pairs.sort_by_key(|x| std::cmp::Reverse(x.2));
+    let total: u64 = pairs.iter().map(|x| x.2).sum();
+    eprintln!("pairs_with_enc={} total_enc={}", pairs.len(), total);
+    let top: f64 = pairs.iter().take(40).map(|x| x.2).sum::<u64>() as f64;
+    eprintln!("top40_share={:.3}", top / total as f64);
+    for &(i, j, n_ev, t0) in pairs.iter().take(15) {
+        let (bi, bj) = (&sc.b[i as usize], &sc.b[j as usize]);
+        let dl0 = (lam(bi, 0.0) - lam(bj, 0.0)).rem_euclid(std::f64::consts::TAU);
+        let r0 = rank_between(&sc.b, i, j, 0.0);
+        eprintln!("i={} j={} enc={} first={:.1} dn={:e} dlam0={:.4} rank0={} ai={:.6} aj={:.6} ei={:e} ej={:e}",
+            i, j, n_ev, t0, bi.n - bj.n, dl0, r0, bi.a, bj.a, bi.e, bj.e);
+    }
+    // histogram of encounters per pair, log bins
+    let mut bins = [0u64; 8];
+    for &(_, _, n_ev, _) in &pairs {
+        let b = if n_ev <= 1 {0} else if n_ev <= 4 {1} else if n_ev <= 16 {2} else if n_ev <= 64 {3}
+                else if n_ev <= 256 {4} else if n_ev <= 1024 {5} else if n_ev <= 4096 {6} else {7};
+        bins[b] += 1;
+    }
+    eprintln!("bins(1,4,16,64,256,1024,4096,+)={:?}", bins);
+    // enc-weighted mean rank0 restricted to pairs with <= 16 enc (the conjunction-driven ones)
+    let (mut s_r, mut c_r) = (0u64, 0u64);
+    for &(i, j, n_ev, _) in &pairs {
+        if n_ev <= 16 {
+            s_r += rank_between(&sc.b, i, j, 0.0) as u64 * n_ev;
+            c_r += n_ev;
+        }
+    }
+    eprintln!("conjunction_driven_enc={} their_mean_rank0={:.2}", c_r, s_r as f64 / c_r.max(1) as f64);
+}
