+//! Dump knot psis and compare float cumulative integrals to shipped increments.
+use emergent_space::orbit::{Orbit, OrbitKey, Scalar};
+
+fn decode(x: Scalar) -> f64 {
+    x.significand() as f64 * 2f64.powi(x.exponent() as i32 - 62)
+}
+fn encode(x: f64) -> Scalar {
+    let e = x.log2().floor() as i32;
+    Scalar::raw((x * 2f64.powi(60 - e)).round() as i128, e - 60).unwrap()
+}
+
+fn main() {
+    let (p, e) = (8.0, 0.1);
+    let ok = OrbitKey::bound(encode(p), (e * 2f64.powi(48)).round() as u64).unwrap();
+    let o = Orbit::compile(ok).unwrap();
+    let k = ok.k as f64 / 2f64.powi(48);
+    let q = 1.0 / p;
+    let node = |psi: f64| {
+        let x = k + (1.0 - k) * psi.cos();
+        let a = 4.0 * k + 2.0 * x;
+        let root = (1.0 - q * a).sqrt();
+        a / (root * (1.0 + root))
+    };
+    let cum = |end: f64| {
+        let n = 40000;
+        let h = end / n as f64;
+        let mut s = 0.0;
+        for i in 0..n {
+            s += node((i as f64 + 0.5) * h);
+        }
+        s * h
+    };
+    println!("last knot psi raw = {}", o.shape().knots().last().unwrap().psi);
+    println!("PI Q61            = {}", 7244019458077122842u64);
+    for kn in o.shape().knots().iter() {
+        let psi61 = kn.psi as f64 / 2f64.powi(61);
+        let psi62 = kn.psi as f64 / 2f64.powi(62);
+        println!(
+            "psi={:>20} asQ61={:.6} asQ62={:.6} Iphi61={:.6} Iphi62={:.6}",
+            kn.psi, psi61, psi62, cum(psi61), cum(psi62)
+        );
+    }
+    // t-channel cumulative at knots via the public crossing_time, last vs period.
+    println!("crossing_time(last)={} period={}", decode(o.crossing_time(o.shape().knots().len() - 1).unwrap()), decode(o.period().unwrap()));
+    println!("advance={}  q*Iphi(pi)={}", decode(o.advance().unwrap()), q * cum(std::f64::consts::PI));
+}
diff --git a/crates/space/examples/panel_floor.rs b/crates/space/examples/panel_floor.rs
