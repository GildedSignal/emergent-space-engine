+//! The formation crowd beside a belt (604c's pair): what the player's scan costs when the universe
+//! holds a 10⁴ belt in another doll and `form` fleet ships on the player's own circle in the
+//! player's doll. Flies real frames and prints one `probe:` line (build, frames, engine ms p50/p99,
+//! the digest at the canonical cut, kicks/encounters/contacts) so arms are comparable bit for bit;
+//! the scan census (`SCAN_CENSUS`, print-only in `encounter.rs`) reports bails/walks when set.
+//!
+//! cargo run --release -p emergent-universe --example formprobe [-- <form> [<extra> [<game seconds> [<rtf>]]]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_formation;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let form: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(200);
+    let extra: usize = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(10_000);
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(6.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let cut = (seconds * rtf / TICK_SECONDS) as i64;
+    let t0 = std::time::Instant::now();
+    let mut p = plane_formation(Config::default(), 1, Order::Sparse, 1, 48, extra, form).expect("the plane");
+    let build_s = t0.elapsed().as_secs_f64();
+    let bodies = p.u.n_bodies();
+    let mut ms: Vec<f64> = Vec::new();
+    let t_all = std::time::Instant::now();
+    while p.u.now < cut && ms.len() < 400_000 {
+        let start = std::time::Instant::now();
+        p.u.frame_to(1.0 / 60.0, rtf, Budget::events(25), cut);
+        ms.push(start.elapsed().as_secs_f64() * 1e3);
+    }
+    let wall_s = t_all.elapsed().as_secs_f64();
+    p.u.settle(cut);
+    ms.sort_by(|a, b| a.total_cmp(b));
+    println!(
+        "probe: form={form} extra={extra} bodies={bodies} game_s={:.1} rtf={rtf} build_s={:.2} wall_s={:.2} frames={} p50_ms={:.2} p99_ms={:.2} digest={} kicks={} encounters={} contacts={}",
+        seconds, build_s, wall_s, ms.len(), pct(&ms, 0.5), pct(&ms, 0.99),
+        p.u.digest(), p.u.stats.kicks, p.u.stats.encounters, p.u.contacts
+    );
+}
