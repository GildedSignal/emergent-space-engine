+/// `SCAN_CENSUS` (print-only): who the scan's candidate walk reads and keeps. Cumulative counters, printed every 64
+/// captures; the last line before exit holds the totals.
+mod census {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    pub static CAPTURES: AtomicU64 = AtomicU64::new(0);
+    pub static BAILS: AtomicU64 = AtomicU64::new(0);
+    /// Bodies the fallback walk visits on bails (`0..bodies.len()`).
+    pub static FB_WALK: AtomicU64 = AtomicU64::new(0);
+    /// Reads thrown away by the doll test (`other.doll != me.doll`, after the `binding_at` read).
+    pub static DOLL_DISCARD: AtomicU64 = AtomicU64::new(0);
+    pub static FB_CAND: AtomicU64 = AtomicU64::new(0);
+    pub static FILT: AtomicU64 = AtomicU64::new(0);
+    pub static FILT_WALK: AtomicU64 = AtomicU64::new(0);
+    pub static FILT_CAND: AtomicU64 = AtomicU64::new(0);
+    pub static NS: AtomicU64 = AtomicU64::new(0);
+
+    pub fn on() -> bool {
+        static V: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("SCAN_CENSUS").is_ok());
+        *V
+    }
+
+    fn line() {
+        let g = |c: &AtomicU64| c.load(Ordering::Relaxed);
+        println!(
+            "scan_census: captures={} bails={} fb_walk={} doll_discard={} fb_cand={} filt={} filt_walk={} filt_cand={} capture_ms={:.1}",
+            g(&CAPTURES), g(&BAILS), g(&FB_WALK), g(&DOLL_DISCARD), g(&FB_CAND), g(&FILT), g(&FILT_WALK), g(&FILT_CAND),
+            g(&NS) as f64 / 1e6
+        );
+    }
+
+    pub fn note(capture_ns: u64, bail: bool, walk: u64, doll_discards: u64, cand: u64) {
+        let n = CAPTURES.fetch_add(1, Ordering::Relaxed) + 1;
+        NS.fetch_add(capture_ns, Ordering::Relaxed);
+        if bail {
+            BAILS.fetch_add(1, Ordering::Relaxed);
+            FB_WALK.fetch_add(walk, Ordering::Relaxed);
+            FB_CAND.fetch_add(cand, Ordering::Relaxed);
+        } else {
+            FILT.fetch_add(1, Ordering::Relaxed);
+            FILT_WALK.fetch_add(walk, Ordering::Relaxed);
+            FILT_CAND.fetch_add(cand, Ordering::Relaxed);
+        }
+        DOLL_DISCARD.fetch_add(doll_discards, Ordering::Relaxed);
+        if n % 64 == 0 {
+            line();
+        }
+    }
+}
 fn integers(a: V2, q_exp: i32) -> Res<[i128; 2]> {
     Ok([a[0].fixed(-q_exp)?, a[1].fixed(-q_exp)?])
 }
