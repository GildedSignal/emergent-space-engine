+/// Linux: VmRSS now and VmHWM (the peak) from /proc/self/status, in bytes.
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut kv = (0u64, 0u64);
+    for line in status.lines() {
+        let Some((k, v)) = line.split_once(':') else { continue };
+        let to_kb = || v.trim().split_whitespace().next().and_then(|n| n.parse::<u64>().ok()).map(|kb| kb * 1024);
+        match k {
+            "VmRSS" => kv.0 = to_kb().unwrap_or(0),
+            "VmHWM" => kv.1 = to_kb().unwrap_or(0),
+            _ => {}
+        }
+    }
+    kv
+}
