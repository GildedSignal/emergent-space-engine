@@ -0,0 +1,38 @@
+//! One belt body: exact vs served-from-cell components (debug for the census).
+use emergent_space::orbit::{MemoCode, Orbit, OrbitKey, Scalar};
+use emergent_universe::scenario::{ladder_locals, ladder_ship};
+
+fn main() {
+    let seed = 1u64;
+    let extra = 10_000u64;
+    let locals = ladder_locals(extra);
+    for k in [locals, locals + 1, locals + 500, locals + 5000] {
+        let (spec, _) = ladder_ship(seed, k, extra, 1).expect("ship");
+        let key = OrbitKey::bound(spec.periapsis, spec.e_q48).expect("key");
+        let code = MemoCode::encode(key).expect("code");
+        let rk = MemoCode::decode(code).expect("decode");
+        let om = Orbit::compile(key).expect("o");
+        let or = Orbit::compile(rk).expect("or");
+        let pm = key.periapsis;
+        let pr = rk.periapsis;
+        let p48 = |x: Scalar| (x.significand() as f64) * 2f64.powi(x.exponent() as i32 - 62);
+        println!(
+            "k={k} e_q48=0x{:x} p_m={:e} p_r={:e} km=0x{:x} kr=0x{:x} P_m={:e} P_r={:e} A_m={:e} A_r={:e} knots {}/{} weak_ids {:x} {:x}",
+            spec.e_q48,
+            p48(pm), p48(pr),
+            key.k, rk.k,
+            p48(om.period().unwrap()), p48(or.period().unwrap()),
+            p48(om.advance().unwrap()), p48(or.advance().unwrap()),
+            om.shape().knots().len(), or.shape().knots().len(),
+            code.bits() & 0x1ffff, MemoCode::encode(rk).unwrap().bits() & 0x1ffff,
+        );
+        let ratio = pm.div(pr).unwrap();
+        let scale = ratio.mul(ratio.sqrt().unwrap()).unwrap();
+        let ps = or.period().unwrap().mul(scale).unwrap();
+        println!(
+            "  served P={:e} rel_dp={:e}",
+            p48(ps),
+            p48(ps.sub(om.period().unwrap()).unwrap().abs().div(om.period().unwrap()).unwrap())
+        );
+    }
+}
