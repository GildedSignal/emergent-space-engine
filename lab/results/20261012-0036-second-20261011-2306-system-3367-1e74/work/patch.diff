+/// Per-kick measurements of one population (ships made with the plane, fleet leavers, the player).
+#[derive(Default)]
+struct Pop {
+    whole: Vec<f64>,
+    from_state: Vec<f64>,
+    compile: Vec<f64>,
+    implied_jet: Vec<f64>,
+    share: Vec<f64>,
