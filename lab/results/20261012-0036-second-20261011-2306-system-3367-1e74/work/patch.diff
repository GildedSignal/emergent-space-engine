+
 fn percentiles(samples: &mut [f64]) -> serde_json::Value {
     samples.sort_by(f64::total_cmp);
     let at = |p: f64| samples.get(((samples.len().saturating_sub(1)) as f64 * p).ceil() as usize).copied();
     json!({"median": at(0.5), "p99": at(0.99), "samples": samples.len()})
 }
 
+impl Pop {
+    fn json(&self) -> serde_json::Value {
+        json!({
+            "kick_us": percentiles(&mut self.whole.clone()),
+            "rebind_us_from_state": percentiles(&mut self.from_state.clone()),
+            "compile_us_alone": percentiles(&mut self.compile.clone()),
+            "implied_jet_kick_us": percentiles(&mut self.implied_jet.clone()),
+            "rebind_share_of_whole": percentiles(&mut self.share.clone()),
+        })
+    }
+}
