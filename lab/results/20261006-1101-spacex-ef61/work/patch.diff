+//! Lab-only stage accounting for the kick path (run 20261006-1101): 8 slots of
+//! nanoseconds and counts, thread-local. Timers change timing, never outcomes.
+use std::{cell::Cell, time::Instant};
+thread_local! { static NS: Cell<[u128; 12]> = const { Cell::new([0; 12]) }; }
+thread_local! { static N: Cell<[u64; 12]> = const { Cell::new([0; 12]) }; }
+pub fn stage<T>(i: usize, f: impl FnOnce() -> T) -> T {
+    let start = Instant::now();
+    let result = f();
+    NS.with(|s| {
+        let mut v = s.get();
+        v[i] += start.elapsed().as_nanos();
+        s.set(v);
+    });
+    N.with(|s| {
+        let mut v = s.get();
+        v[i] += 1;
+        s.set(v);
+    });
+    result
+}
+pub fn tally(i: usize, k: u64) {
+    N.with(|s| {
+        let mut v = s.get();
+        v[i] += k;
+        s.set(v);
+    });
+}
+/// Nanoseconds and counts per slot on this thread; resets the counters.
+pub fn take() -> ([u128; 12], [u64; 12]) {
+    (NS.with(|s| s.replace([0; 12])), N.with(|s| s.replace([0; 12])))
+}
