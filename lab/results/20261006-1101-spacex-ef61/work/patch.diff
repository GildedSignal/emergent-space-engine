+/// Mean µs and call counts per stage slot, per replayed kick. Slots: 0 readout, 1 forces,
+/// 2 quantize+ramp, 3 fit_key, 4 compile (cycle or passage), 5 at_radius+residual,
+/// 6 bind whole (rebind), 7 passage tail panels (tally), 8 cycle knots (tally).
+fn stage_json((ns, n): &([u128; 12], [u64; 12]), kicks: usize) -> serde_json::Value {
+    const NAMES: [&str; 12] = ["readout", "forces", "quantize", "fit_key", "compile", "residual", "bind_whole", "tail_panels", "cycle_knots", "", "", ""];
+    let k = kicks.max(1) as f64;
+    let m: serde_json::Map<String, serde_json::Value> = NAMES
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| ns[*i] > 0 || n[*i] > 0)
+        .map(|(i, name)| {
+            let v = if matches!(i, 7 | 8) {
+                json!({ "mean_per_kick": n[i] as f64 / k, "total": n[i] })
+            } else {
+                json!({ "mean_us": ns[i] as f64 / 1e3 / k, "calls_per_kick": n[i] as f64 / k })
+            };
+            (name.to_string(), v)
+        })
+        .collect();
+    json!(m)
+}
