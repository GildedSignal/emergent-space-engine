+/// Controls: (a) a state born inside the star's surface dies on its first item (the death channel's
+/// positive control); (b) the same state's oracle osculating q reads its true periapsis; (c) the
+/// tolerance pair of the oracle arm.
+#[test]
+#[ignore]
+fn trojan_dive_control() {
+    let scene = JUPITER;
+    let to_root = 1.0 / (1.0 - scene.mu);
+    let s_star = 471_000.0 * (1.0 - scene.mu);
+    // (a) A tangential circular orbit at 0.9·S_star from the star: inside the plane's surface.
+    let r0 = 0.9 * s_star;
+    let v0 = ((1.0 - scene.mu) / r0).sqrt();
+    let (sp, sv) = scene.star(0.0);
+    let ship = [r0 + sp[0], sp[1], sv[0], v0 + sv[1]];
+    let mut out = String::new();
+    if let Some((mut u, id)) = build_scene(&scene, ship, 7) {
+        u.settle(1);
+        out += &format!(
+            "control dive: inside-star ship alive={} lost={} channel terminal={} periapsis={} star={} planet={} edge={} planfail={}\n",
+            u.bodies().alive(id),
+            u.stats.lost,
+            u.stats.lost_terminal,
+            u.stats.lost_periapsis,
+            u.stats.lost_star_kick,
+            u.stats.lost_planet_kick,
+            u.stats.lost_edge,
+            u.stats.lost_plan_fail
+        );
+    } else {
+        out += "control dive: inside-star ship refused at build (its own verdict)\n";
+    }
+    // (b) The oracle reads the same orbit's elements (the pipeline control).
+    if let Some(st) = reference(&scene, ship, &[0.0, scene.period() / 8.0], RTOL) {
+        let (a, e, q) = elements(&scene, scene.period() / 8.0, &st[1]).expect("elements");
+        out += &format!("control elements: a/sep={a:.6} e={e:.6} q/S={:.4}\n", q / s_star);
+    }
+    // (c) The tolerance pair on one mid-band IC (the full P/8 grid over 8 P).
+    let ship2 = ic(&scene, 1.05 * band(&scene), 60f64.to_radians());
+    let p = scene.period();
+    let grid: Vec<f64> = (0..=64).map(|k| k as f64 * p / 8.0).collect();
+    for rtol in [1e-12, 1e-13] {
+        if let Some(st) = reference(&scene, ship2, &grid, rtol) {
+            let qs: Vec<f64> = [0usize, 32, 64].iter().map(|&k| elements(&scene, grid[k], &st[k]).map_or(f64::NAN, |(_, _, q)| q)).collect();
+            out += &format!("control rtol={rtol:.0e}: q/S at 0,4,8 P: {:.4} {:.4} {:.4}\n", qs[0] / s_star, qs[1] / s_star, qs[2] / s_star);
+        }
+    }
+    let _ = to_root;
+    eprint!("{out}");
+    std::fs::write(std::env::var("TROJAN_CONTROL").unwrap_or_else(|_| "/tmp/dive-control.txt".into()), out).expect("write control");
+}
