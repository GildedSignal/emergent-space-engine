+#[test]
+#[ignore]
+fn trojan_dive() {
+    let scene = JUPITER;
+    let out_path = std::env::var("TROJAN_OUT").expect("TROJAN_OUT=<file> for the JSONL results");
+    let arm = std::env::var("TROJAN_ARM").unwrap_or_else(|_| "plane".into());
+    let workers: usize = std::env::var("TROJAN_WORKERS").ok().and_then(|w| w.parse().ok()).unwrap_or(6);
+    let periods: f64 = std::env::var("TROJAN_PERIODS").ok().and_then(|p| p.parse().ok()).unwrap_or(512.0);
+    let step: i32 = std::env::var("TROJAN_STEP").ok().and_then(|s| s.parse().ok()).unwrap_or(7);
+    let rtol: f64 = std::env::var("TROJAN_RTOL").ok().and_then(|r| r.parse().ok()).unwrap_or(RTOL);
+    let crit = criticals(&scene);
+    let dus: Vec<f64> = [0.35f64, 0.6, 0.85, 1.05, 1.25, 1.45].iter().flat_map(|&u| [u, -u]).collect();
+    let phis: Vec<f64> = (0..12).map(|k| (15.0 + 30.0 * k as f64).to_radians()).collect();
+    // The windowed oracle pass: TROJAN_WIN_FILE holds one {"du","phi_deg","epoch_P"} per dead ship.
+    let mut wins: std::collections::HashMap<(i64, i64), f64> = std::collections::HashMap::new();
+    if let Some(s) = std::env::var("TROJAN_WIN_FILE").ok().and_then(|p| std::fs::read_to_string(p).ok()) {
+        for l in s.lines() {
+            if let Ok(v) = serde_json::from_str::<serde_json::Value>(l) {
+                let du = v["du"].as_f64().unwrap_or(1e9);
+                let phi = v["phi_deg"].as_f64().unwrap_or(1e9);
+                wins.insert(((du * 1e4) as i64, (phi * 1e4) as i64), v["epoch_P"].as_f64().unwrap_or(f64::NAN));
+            }
+        }
+    }
+    let mut jobs: Vec<(f64, f64)> = if wins.is_empty() {
+        phis.iter().flat_map(|&phi| dus.iter().map(move |&du| (du, phi))).collect()
+    } else {
+        phis.iter().flat_map(|&phi| dus.iter().map(move |&du| (du, phi))).filter(|&(du, phi)| wins.contains_key(&((du * 1e4) as i64, (phi.to_degrees() * 1e4) as i64))).collect()
+    };
+    if !wins.is_empty() {
+        jobs.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap().then(a.1.partial_cmp(&b.1).unwrap()));
+    }
+    eprintln!(
+        "dive: arm={} ships={} horizon={}P step={} rtol={} workers={} jl1={:.6e} jl2={:.6e} jl3={:.6e}",
+        arm,
+        jobs.len(),
+        periods,
+        step,
+        rtol,
+        workers,
+        crit.0,
+        crit.1,
+        crit.2
+    );
+    let t0 = std::time::Instant::now();
+    let (tx, rx) = std::sync::mpsc::channel::<String>();
+    let next = std::sync::atomic::AtomicUsize::new(0);
+    let (arm_ref, jobs_ref, next_ref, wins_ref) = (arm.as_str(), jobs.as_slice(), &next, &wins);
+    std::thread::scope(|scope| {
+        let senders: Vec<_> = (0..workers).map(|_| tx.clone()).collect();
+        for s in senders {
+            scope.spawn(move || loop {
+                let i = next_ref.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                if i >= jobs_ref.len() {
+                    break;
+                }
+                let (du, phi) = jobs_ref[i];
+                let win = wins_ref.get(&((du * 1e4) as i64, (phi.to_degrees() * 1e4) as i64)).copied();
+                let l = match arm_ref {
+                    "plane" => plane_line(&scene, du, phi.to_degrees(), step, periods),
+                    "oracle" => oracle_line(&scene, du, phi.to_degrees(), periods, rtol, win),
+                    "analytic" => analytic_line(&scene, du, phi.to_degrees(), crit),
+                    _ => panic!("TROJAN_ARM must be plane, oracle or analytic"),
+                };
+                if let Err(e) = s.send(l) {
+                    eprintln!("dive: worker send failed: {e}");
+                    break;
+                }
+            });
+        }
+        drop(tx);
+        let mut file = std::fs::File::create(&out_path).expect("create TROJAN_OUT");
+        let mut n = 0usize;
+        while let Ok(l) = rx.recv() {
+            writeln!(file, "{l}").expect("write result line");
+            n += 1;
+        }
+        assert_eq!(n, jobs.len(), "every ship must leave one line");
+    });
+    eprintln!("dive: arm {} done in {:.1}s -> {}", arm, t0.elapsed().as_secs_f64(), out_path);
+}
