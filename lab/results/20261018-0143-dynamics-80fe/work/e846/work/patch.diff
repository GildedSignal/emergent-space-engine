+//! Lab probe (chaos-shadowing open direction 4): decide the plane's 48 co-orbital deaths —
+//! real star-crossing periapsis of a diverged trajectory, or spurious planned terminal.
+//!
+//! The prior run (20261015-0128-dynamics-b9be) left the 48 deaths unattributed: every traced loss
+//! is fault-free, refusal-free, handoff-free, and both the oracle and the plane's own sampled
+//! trajectory stay far from both surfaces at P/8 and P/256 grids. But grid sampling is blind to
+//! exactly the geometry that decides this: a perihelion passage at q ≈ the star's surface dwells
+//! below 2q for ~P/10⁵, so no fixed grid sees it. This probe reads the geometry the grids cannot:
+//!
+//! - **osculating elements** q(t) = a(1−e) from heliocentric E, L at every P/8 sample (computed,
+//!   not sampled — q is exact from any point of the orbit, however fast the passage);
+//! - **the Jacobi constant** J(t) of plane and oracle states, and the rotating-frame neck
+//!   criticals J(L1), J(L2), J(L3) of the scene;
+//! - **a flood fill of the allowed region {U_eff ≥ J}** from each IC: the smallest star and
+//!   planet distance the exact dynamics can ever reach (a zero-velocity confinement certificate);
+//! - **a census of the engine's Lost branches** (new `Resolved::Lost*` variants, stats-only,
+//!   outcome-free): planned terminal vs periapsis check vs kick-time surface vs planet vs edge.
+//!
+//! Arms (TROJAN_OUT=<file>, TROJAN_ARM=plane|oracle|analytic|control):
+//! ```text
+//! TROJAN_OUT=/tmp/d.jsonl TROJAN_ARM=plane cargo test --release -p xtask trojan_dive -- --ignored --nocapture
+//! ```
+#![cfg(test)]
+
+use super::plane::build_scene;
+use super::restricted::{reference, Restricted, JUPITER, RTOL};
+use std::io::Write as _;
+
+/// The 1:1 co-orbital band's half width in a/sep (as trojan.rs).
+fn band(scene: &Restricted) -> f64 {
+    (8.0 * scene.mu / 3.0).sqrt()
+}
+
+/// A circular heliocentric orbit of radius a = sep·(1+du) at synodic angle `phi` from the planet
+/// (as trojan.rs).
+fn ic(scene: &Restricted, du: f64, phi: f64) -> [f64; 4] {
+    let a = scene.sep * (1.0 + du);
+    let (sp, sv) = scene.star(0.0);
+    let v = ((1.0 - scene.mu) / a).sqrt();
+    let (s, c) = phi.sin_cos();
+    [a * c + sp[0], a * s + sp[1], -v * s + sv[0], v * c + sv[1]]
+}
+
+/// Osculating (a/sep, e, q) from the heliocentric energy and angular momentum. Works bound and
+/// unbound (q = a(1−e) is the periapsis in both); None for the exactly-parabolic E = 0.
+fn elements(scene: &Restricted, t: f64, ship: &[f64; 4]) -> Option<(f64, f64, f64)> {
+    let (e0, l) = scene.heliocentric(t, ship);
+    let mu = 1.0 - scene.mu;
+    if e0 == 0.0 {
+        return None;
+    }
+    let a = -mu / (2.0 * e0);
+    let e = (1.0 + 2.0 * e0 * l * l / (mu * mu)).max(0.0).sqrt();
+    let q = a * (1.0 - e);
+    Some((a / scene.sep, e, q))
+}
+
+/// The rotating-frame effective potential 2(1−μ)/r₁ + 2μ/r₂ + Ω²(x²+y²): the allowed region of the
+/// exact dynamics at Jacobi constant J is {U_eff ≥ J}.
+fn u_eff(scene: &Restricted, x: f64, y: f64) -> f64 {
+    let (s, p) = (-scene.mu * scene.sep, scene.sep * (1.0 - scene.mu));
+    let r1 = ((x - s) * (x - s) + y * y).sqrt();
+    let r2 = ((x - p) * (x - p) + y * y).sqrt();
+    2.0 * (1.0 - scene.mu) / r1 + 2.0 * scene.mu / r2 + scene.omega() * scene.omega() * (x * x + y * y)
+}
+
+/// The three collinear necks' critical values J(L1) (star–planet), J(L2) (beyond the planet),
+/// J(L3) (beyond the star): local minima of U_eff along the rotating x-axis (golden section).
+fn criticals(scene: &Restricted) -> (f64, f64, f64) {
+    let (s, p) = (-scene.mu * scene.sep, scene.sep * (1.0 - scene.mu));
+    let minimum = |mut lo: f64, mut hi: f64| {
+        // Golden-section on U_eff (the local minimum inside the bracket: each neck is a dip of
+        // the allowed region's boundary along the axis).
+        let phi = 0.618_033_988_749_894_9;
+        let (mut a, mut b) = (lo + (hi - lo) * (1.0 - phi), lo + (hi - lo) * phi);
+        let (mut fa, mut fb) = (u_eff(scene, a, 0.0), u_eff(scene, b, 0.0));
+        for _ in 0..200 {
+            if fa < fb {
+                hi = b;
+                (b, fb) = (a, fa);
+                a = lo + (hi - lo) * (1.0 - phi);
+                fa = u_eff(scene, a, 0.0);
+            } else {
+                lo = a;
+                (a, fa) = (b, fb);
+                b = lo + (hi - lo) * phi;
+                fb = u_eff(scene, b, 0.0);
+            }
+        }
+        0.5 * (fa + fb)
+    };
+    let jl1 = minimum(s + 1e3, p - 1e3);
+    let jl2 = minimum(p + 1e3, 6.0 * scene.sep);
+    let jl3 = minimum(-6.0 * scene.sep, s - 1e3);
+    (jl1, jl2, jl3)
+}
+
+/// The smallest star and planet distances the exact dynamics can EVER reach from `ship`: a flood
+/// fill of {U_eff ≥ J(ship)} on a polar grid about the star, started at the ship's cell. The grid's
+/// resolution is the certificate's (r cells of S/8 near the star, 0.5° in angle).
+fn confinement(scene: &Restricted, ship: &[f64; 4], s_star: f64) -> (f64, f64, usize) {
+    let j = scene.jacobi(0.0, ship);
+    let r_hi = 4.0 * scene.sep;
+    let nr = 360usize;
+    let na = 720usize;
+    let (dr, da) = (r_hi / nr as f64, std::f64::consts::TAU / na as f64);
+    // Allowed cells; cell (i, k) is the annulus sector at r = (i + 0.5)·dr, angle k·da.
+    let idx = |i: usize, k: usize| i * na + (k % na);
+    let mut allowed = vec![false; nr * na];
+    let (mut ri0, mut k0) = (nr, na);
+    let (x0, y0) = (ship[0], ship[1]);
+    let r0 = x0.hypot(y0);
+    let a0 = y0.atan2(x0);
+    for i in 0..nr {
+        let r = (i as f64 + 0.5) * dr;
+        for k in 0..na {
+            let th = k as f64 * da;
+            let (x, y) = (r * th.cos(), r * th.sin());
+            allowed[idx(i, k)] = u_eff(scene, x, y) >= j;
+            if (r - r0).abs() < dr && (th - a0.rem_euclid(std::f64::consts::TAU)).abs() < da {
+                (ri0, k0) = (i, k);
+            }
+        }
+    }
+    if ri0 == nr {
+        return (f64::INFINITY, f64::INFINITY, 0);
+    }
+    // Flood fill from the ship's cell (4-connected in (i, k), angle wrapping).
+    let mut seen = vec![false; nr * na];
+    let mut stack = vec![idx(ri0, k0)];
+    seen[stack[0]] = true;
+    let mut touches_edge = false;
+    while let Some(c) = stack.pop() {
+        let (i, k) = (c / na, c % na);
+        if i + 1 == nr {
+            touches_edge = true;
+        }
+        for (di, dk) in [(1usize, 0usize, ), (0, 1)] {
+            for sgn in [1i64, -1] {
+                let (ii, kk) = if di == 1 {
+                    (i as i64 + sgn, k as i64)
+                } else {
+                    (i as i64, k as i64 + sgn)
+                };
+                if ii < 0 || ii >= nr as i64 {
+                    continue;
+                }
+                let n = idx(ii as usize, kk.rem_euclid(na as i64) as usize);
+                if allowed[n] && !seen[n] {
+                    seen[n] = true;
+                    stack.push(n);
+                }
+            }
+        }
+    }
+    // The smallest star distance on the reached component; and the smallest planet distance there.
+    let (ps, pp) = (-scene.mu * scene.sep, scene.sep * (1.0 - scene.mu));
+    let (mut r_star, mut r_planet) = (f64::INFINITY, f64::INFINITY);
+    let mut reached = 0usize;
+    for i in 0..nr {
+        let r = (i as f64 + 0.5) * dr;
+        for k in 0..na {
+            let c = idx(i, k);
+            if !seen[c] {
+                continue;
+            }
+            reached += 1;
+            let th = k as f64 * da;
+            let (x, y) = (r * th.cos(), r * th.sin());
+            r_star = r_star.min(r);
+            r_planet = r_planet.min(((x - pp) * (x - pp) + (y - 0.0) * (y - 0.0)).sqrt());
+            let _ = ps;
+        }
+    }
+    (r_star / s_star, r_planet / scene.planet_radius, reached)
+}
+
+/// One (du, phi) ship of the ensemble, run through the shipped plane with per-sample elements and
+/// a refined death epoch. Returns the JSONL line. `phi` is in degrees (the ensemble label).
+fn plane_line(scene: &Restricted, du: f64, phi: f64, step: i32, periods: f64) -> String {
+    let to_root = 1.0 / (1.0 - scene.mu);
+    let p = scene.period();
+    let n = (periods * 8.0) as usize;
+    let times: Vec<f64> = (0..=n).map(|k| k as f64 * p / 8.0).collect();
+    let ship = ic(scene, du * band(scene), phi.to_radians());
+    let mut series: Vec<(f64, f64, f64, f64)> = Vec::new(); // (t/P, J, q/S_star, e)
+    let s_star = 471_000.0 * (1.0 - scene.mu);
+    let mut run = |ts: &[f64]| -> Option<(Vec<[f64; 4]>, emergent_universe::universe::Stats)> {
+        let (mut u, id) = build_scene(&scene, ship, step)?;
+        let mut states = Vec::with_capacity(ts.len());
+        for &t in ts {
+            let tick = (t * to_root).round() as i64;
+            u.settle(tick);
+            if !u.bodies().alive(id) {
+                return Some((states, u.stats));
+            }
+            let (pos, vel) = emergent_universe::observe::root_state(&u.ctx(), id, tick).ok()?;
+            let (sp, sv) = scene.star(t);
+            states.push([pos[0] / to_root + sp[0], pos[1] / to_root + sp[1], vel[0] + sv[0], vel[1] + sv[1]]);
+        }
+        Some((states, u.stats))
+    };
+    let (states, stats) = match run(&times) {
+        Some((s, st)) => (s, st),
+        None => return format!(r#"{{"du":{du},"phi_deg":{phi},"dead":null,"why":"build_or_read"}}"#),
+    };
+    let dead = states.len() < times.len();
+    for (t, st) in times.iter().zip(&states) {
+        let (_, e, q) = elements(scene, *t, st).unwrap_or((f64::NAN, f64::NAN, f64::NAN));
+        series.push((t / p, scene.jacobi(*t, st), q / s_star, e));
+    }
+    // Refine the death epoch to P/64 inside the bracketing P/8 interval, and keep the finer last state.
+    let mut epoch = if dead { times[states.len().saturating_sub(1)] / p } else { f64::INFINITY };
+    let mut last = states.last().copied();
+    if dead {
+        let lo = times[states.len().saturating_sub(1)];
+        let sub: Vec<f64> = (1..=8).map(|k| lo + k as f64 * p / 64.0).collect();
+        if let Some((sts, _)) = run(&sub) {
+            epoch = (if sts.is_empty() { lo + p / 64.0 } else { sub[sts.len() - 1] }) / p;
+            if let Some(st) = sts.last() {
+                last = Some(*st);
+            }
+        }
+    }
+    let js: Vec<f64> = series.iter().map(|x| x.1).filter(|x| x.is_finite()).collect();
+    let j_ref = js.first().copied().unwrap_or(f64::NAN);
+    let (j_last, q0, e0) = last.map_or((f64::NAN, f64::NAN, f64::NAN), |st| {
+        let t = if dead { epoch * p } else { times[states.len() - 1] };
+        let (_, e, q) = elements(scene, t, &st).unwrap_or((f64::NAN, f64::NAN, f64::NAN));
+        (scene.jacobi(t, &st), q / s_star, e)
+    });
+    let channel = |s: &emergent_universe::universe::Stats| -> &'static str {
+        if s.lost_terminal > 0 {
+            "terminal"
+        } else if s.lost_periapsis > 0 {
+            "periapsis"
+        } else if s.lost_star_kick > 0 {
+            "star_kick"
+        } else if s.lost_planet_kick > 0 {
+            "planet_kick"
+        } else if s.lost_edge > 0 {
+            "edge"
+        } else if s.lost_plan_fail > 0 {
+            "plan_fail"
+        } else if s.lost > 0 {
+            "handout"
+        } else {
+            "none"
+        }
+    };
+    let mut s = format!(
+        r#"{{"du":{du},"phi_deg":{phi},"dead":{},"epoch_P":{:.4},"channel":"{}","lost":{},"refused":{},"kicks":{},"handoffs":{},"j_last_rel":{:.3e},"q_last_over_S":{:.4},"e_last":{:.5},"j_min_rel":{:.3e},"j_max_rel":{:.3e},"q_min_over_S":{:.4},"series":["#,
+        dead,
+        epoch,
+        channel(&stats),
+        stats.lost,
+        stats.refused,
+        stats.kicks,
+        stats.handoffs,
+        (j_last - j_ref) / j_ref.abs(),
+        q0,
+        e0,
+        (js.iter().copied().fold(f64::INFINITY, f64::min) - j_ref) / j_ref.abs(),
+        (js.iter().copied().fold(f64::NEG_INFINITY, f64::max) - j_ref) / j_ref.abs(),
+        series.iter().filter(|x| x.2.is_finite()).map(|x| x.2).fold(f64::INFINITY, f64::min),
+    );
+    for (i, (t, j, q, e)) in series.iter().enumerate() {
+        if i > 0 {
+            s.push(',');
+        }
+        s.push_str(&format!(r#"[{t:.4},{j:.9e},{q:.5},{e:.5}]"#));
+    }
+    s.push_str("]}");
+    s
+}
+
+/// One (du, phi) ship through the float oracle: osculating q(t) and J(t) at P/8 (plus a dense P/64
+/// window around a given death epoch, when `win` is set), all as computed elements.
+fn oracle_line(scene: &Restricted, du: f64, phi: f64, periods: f64, rtol: f64, win: Option<f64>) -> String {
+    let p = scene.period();
+    let s_star = 471_000.0 * (1.0 - scene.mu);
+    let n = (periods * 8.0) as usize;
+    let times: Vec<f64> = (0..=n).map(|k| k as f64 * p / 8.0).collect();
+    let ship = ic(scene, du * band(scene), phi.to_radians());
+    let Some(states) = reference(scene, ship, &times, rtol) else {
+        return format!(r#"{{"du":{du},"phi_deg":{phi:.1},"gave_up":true}}"#);
+    };
+    // The periapsis-resolved closest approach to the planet (the judge's own `tracking`
+    // integrator: every radial turn bisected), over the whole horizon in one pass.
+    let mut it = super::restricted::Integrator::new(scene, super::restricted::Model::Full, rtol, ship).tracking();
+    let mut closest = f64::NAN;
+    for &t in &times {
+        if it.advance(t).is_none() {
+            break;
+        }
+    }
+    closest = it.closest();
+    let mut j_dev = 0.0f64;
+    let mut q_min = f64::INFINITY;
+    let mut q_min_t = f64::NAN;
+    let mut j0 = f64::NAN;
+    for (k, (t, st)) in times.iter().zip(&states).enumerate() {
+        let j = scene.jacobi(*t, st);
+        let q = elements(scene, *t, st).map_or(f64::NAN, |(_, _, q)| q);
+        if k == 0 {
+            j0 = j;
+        }
+        j_dev = j_dev.max((j - j0).abs());
+        if q < q_min {
+            (q_min, q_min_t) = (q, *t / p);
+        }
+    }
+    // The dense window (P/64, ±2 P) around the plane's death epoch, when given: osculating q and
+    // the planet distance on the grid, plus the window's periapsis-resolved planet minimum.
+    let mut win_series: Vec<(f64, f64, f64, f64)> = Vec::new();
+    let mut win_closest = f64::NAN;
+    if let Some(td) = win {
+        let t_lo = (td - 2.0).max(0.0) * p;
+        let t_hi = (td + 2.0) * p;
+        let wt: Vec<f64> = {
+            let mut v = Vec::new();
+            let mut t = t_lo;
+            while t <= t_hi {
+                v.push(t);
+                t += p / 64.0;
+            }
+            v
+        };
+        if let Some(ws) = reference(scene, ship, &wt, rtol) {
+            for (t, st) in wt.iter().zip(&ws) {
+                let q = elements(scene, *t, st).map_or(f64::NAN, |(_, _, q)| q);
+                win_series.push((*t / p, scene.jacobi(*t, st), q / s_star, scene.planet_distance(*t, st) / scene.planet_radius));
+            }
+        }
+        let mut wit = super::restricted::Integrator::new(scene, super::restricted::Model::Full, rtol, ship).tracking();
+        if wit.advance(t_lo).is_some() {
+            let _ = wit.advance(t_hi);
+            win_closest = wit.closest();
+        }
+    }
+    let mut s = format!(
+        r#"{{"du":{du},"phi_deg":{phi:.1},"j0":{:.9e},"j_dev_rel":{:.2e},"q_min_over_S":{:.5},"q_min_t_P":{:.2},"closest_Rp":{:.4},"win_closest_Rp":{:.4},"win":["#,
+        j0,
+        j_dev / j0.abs(),
+        q_min / s_star,
+        q_min_t,
+        closest / scene.planet_radius,
+        win_closest / scene.planet_radius,
+    );
+    for (i, (t, j, q, rp)) in win_series.iter().enumerate() {
+        if i > 0 {
+            s.push(',');
+        }
+        s.push_str(&format!(r#"[{t:.4},{j:.9e},{q:.5},{rp:.3}]"#));
+    }
+    s.push_str("]}");
+    s
+}
+
+/// The analytic arm: J₀, the neck criticals, and the flood-fill confinement per IC.
+fn analytic_line(scene: &Restricted, du: f64, phi: f64, (jl1, jl2, jl3): (f64, f64, f64)) -> String {
+    let s_star = 471_000.0 * (1.0 - scene.mu);
+    let ship = ic(scene, du * band(scene), phi.to_radians());
+    let j0 = scene.jacobi(0.0, &ship);
+    let (r_star, r_planet, cells) = confinement(scene, &ship, s_star);
+    format!(
+        r#"{{"du":{du},"phi_deg":{:.1},"j0":{:.9e},"jl1":{:.9e},"jl2":{:.9e},"jl3":{:.9e},"dj1_rel":{:.3e},"zvc_r_star_over_S":{:.4},"zvc_r_planet_over_Rp":{:.4},"cells":{}}}"#,
+        phi.to_degrees(),
+        j0,
+        jl1,
+        jl2,
+        jl3,
+        (j0 - jl1) / jl1.abs(),
+        r_star,
+        r_planet,
+        cells
+    )
+}
