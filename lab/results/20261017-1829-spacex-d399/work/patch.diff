+++ b/crates/space/src/fitprof.rs
@@ -0,0 +1,140 @@
+//! Stage counters for the fit path (`Rebinding::from_state`, `bind_surface`), lab run
+//! 20261017-1829-spacex-d399. Off by default: every `add`/`count` pays one relaxed load
+//! and returns; no arithmetic of the law is touched, so digests are identical with this
+//! module present (verified by `ladder_digest`). The delete arm (`FIT_NODECODED`) is the
+//! one switch that changes behaviour, and only when it is armed.
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::LazyLock;
+use std::time::Instant;
+
+pub const FIT_KEY: usize = 0;
+pub const COMPILE: usize = 1;
+pub const AT_RADIUS: usize = 2;
+pub const DECODED: usize = 3;
+pub const RES_BET: usize = 4;
+pub const OUTB_AT: usize = 5;
+pub const BIND_DECODE: usize = 6;
+pub const TURN_RES: usize = 7;
+pub const N: usize = 8;
+
+pub const NAMES: [&str; N] = [
+    "from_state: fit_key (cubic inverse)",
+    "from_state: compile (shape quadrature)",
+    "from_state: at_radius (radius cut + 1 quad + read)",
+    "from_state: decoded_event (time->psi Newton + read + cartesian)",
+    "from_state: residual_between",
+    "outbound_at (every time->psi Newton solve)",
+    "bind_in: decode (tube replay at the binding tick)",
+    "bind_in: turn + residual",
+];
+
+pub const C_QUAD: usize = 0;
+pub const C_NODE: usize = 1;
+pub const C_OUTB: usize = 2;
+pub const C_ITERS: usize = 3;
+pub const CN: usize = 4;
+pub const CNAMES: [&str; CN] = [
+    "quad() evaluations",
+    "node() evaluations (isqrt + reciprocal)",
+    "outbound_at() calls",
+    "outbound_at Newton iterations",
+];
+
+const Z: AtomicU64 = AtomicU64::new(0);
+static NS: [AtomicU64; N] = [Z; N];
+static CALLS: [AtomicU64; N] = [Z; N];
+static COUNTS: [AtomicU64; CN] = [Z; CN];
+static ON: AtomicBool = AtomicBool::new(false);
+
+#[inline]
+pub fn t() -> Instant {
+    Instant::now()
+}
+
+#[inline]
+pub fn on() -> bool {
+    ON.load(Ordering::Relaxed)
+}
+
+pub fn set_on(v: bool) {
+    ON.store(v, Ordering::Relaxed);
+}
+
+
+/// Times `outbound_at` across its early returns.
+pub struct Guard(Instant);
+impl Drop for Guard {
+    fn drop(&mut self) {
+        add(OUTB_AT, self.0);
+    }
+}
+pub fn guard() -> Guard {
+    Guard(t())
+}
+#[inline]
+pub fn add(stage: usize, since: Instant) {
+    if !on() {
+        return;
+    }
+    NS[stage].fetch_add(since.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    CALLS[stage].fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn count(idx: usize) {
+    if !on() {
+        return;
+    }
+    COUNTS[idx].fetch_add(1, Ordering::Relaxed);
+}
+
+/// The lab's delete arm: skip the fit residual's `decoded_event` (the flown path,
+/// `bind_in`, computes its own residual from its own `decode` and never reads
+/// `fit.residual`). Armed by `FIT_NODECODED=1` or `set_skip`.
+static SKIP_ENV: LazyLock<bool> = LazyLock::new(|| std::env::var("FIT_NODECODED").is_ok());
+static SKIP_SET: AtomicBool = AtomicBool::new(false);
+static SKIP_VAL: AtomicBool = AtomicBool::new(false);
+
+#[inline]
+pub fn skip_decoded() -> bool {
+    if SKIP_SET.load(Ordering::Relaxed) {
+        return SKIP_VAL.load(Ordering::Relaxed);
+    }
+    *SKIP_ENV
+}
+
+pub fn set_skip(v: bool) {
+    SKIP_VAL.store(v, Ordering::Relaxed);
+    SKIP_SET.store(true, Ordering::Relaxed);
+}
+
+pub fn report() {
+    for i in 0..N {
+        let ns = NS[i].load(Ordering::Relaxed);
+        let calls = CALLS[i].load(Ordering::Relaxed);
+        if calls == 0 {
+            continue;
+        }
+        println!(
+            "{:<58} {:>9.3} us/call {:>8} calls {:>9.3} ms total",
+            NAMES[i],
+            ns as f64 / calls as f64 / 1000.0,
+            calls,
+            ns as f64 / 1e6
+        );
+    }
+    for i in 0..CN {
+        println!("{:<40} {:>10}", CNAMES[i], COUNTS[i].load(Ordering::Relaxed));
+    }
+}
+
+pub fn reset() {
+    for i in 0..N {
+        NS[i].store(0, Ordering::Relaxed);
+        CALLS[i].store(0, Ordering::Relaxed);
+    }
+    for c in COUNTS.iter() {
+        c.store(0, Ordering::Relaxed);
+    }
+}
