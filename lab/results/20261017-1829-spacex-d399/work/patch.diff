@@ -0,0 +1,87 @@
+//! The belt kick's fit, timed stage by stage on flown inputs (lab run
+//! 20261017-1829-spacex-d399). Phase 1 flies the ladder's `N=3000 belt crossing`
+//! (the read-stream page's regime) with `FITCAP=1` and captures every `bind_surface`
+//! input; phase 2 replays the captured inputs through `bind_surface` K times per arm,
+//! printing the stage table and per-call totals for the shipped arm and the delete arm
+//! (`fit.residual`'s `decoded_event` skipped: the flown path computes its own residual).
+//!
+//! cargo run --release -p emergent-universe --example fitbench
+
+use emergent_space::fitprof;
+use emergent_universe::bind::bind_surface;
+use emergent_universe::fitcap::{self, Cap};
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+fn stats(name: &str, us: &mut Vec<f64>) {
+    us.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let q = |p: f64| us[((us.len() as f64 - 1.0) * p) as usize];
+    println!(
+        "{:<26} n={:<6} p50={:7.3}us p90={:7.3}us p99={:7.3}us max={:7.3}us mean={:7.3}us",
+        name,
+        us.len(),
+        q(0.50),
+        q(0.90),
+        q(0.99),
+        us[us.len() - 1],
+        us.iter().sum::<f64>() / us.len() as f64
+    );
+}
+
+fn replay(caps: &[Cap], passes: usize, label: &str) -> Vec<f64> {
+    fitprof::reset();
+    let mut us = Vec::with_capacity(caps.len() * passes);
+    for _ in 0..passes {
+        for c in caps {
+            let t0 = Instant::now();
+            let _ = bind_surface(c.exact, c.t, c.clock_exp, c.edge, c.unit, c.surface);
+            us.push(t0.elapsed().as_secs_f64() * 1e6);
+        }
+    }
+    println!("=== {label}");
+    stats("bind_surface total", &mut us.clone());
+    fitprof::report();
+    us
+}
+
+fn main() {
+    // Phase 1: fly the ladder's belt crossing and capture the flown fit inputs.
+    fitcap::arm();
+    let (n, rtf, wall) = (3000usize, 3000.0f64, 8.0f64);
+    let cut = (wall * rtf / TICK_SECONDS) as i64;
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 4, 48, n).unwrap();
+    let t0 = Instant::now();
+    p.u.schedule((1.0 * rtf / TICK_SECONDS) as i64, word(1, 10)).unwrap();
+    p.u.schedule((4.0 * rtf / TICK_SECONDS) as i64, word(0, 10)).unwrap();
+    for _ in 0..400_000 {
+        if p.u.now >= cut {
+            break;
+        }
+    }
+    p.u.settle(cut);
+    println!(
+        "flight: N={n} belt crossing, {} game-s, {} s wall, kicks {}, digest {}",
+        p.u.now,
+        t0.elapsed().as_secs_f64(),
+        p.u.stats.kicks,
+        &p.u.digest()[..16]
+    );
+    let caps = fitcap::take();
+    fitcap::disarm();
+    println!("captured {} bind_surface inputs", caps.len());
+
+    // Phase 2: replay, shipped arm then delete arm, same captured inputs.
+    fitprof::set_on(true);
+    fitprof::set_skip(false);
+    let _ = replay(&caps, 3, "SHIPPED (fit.residual computed)");
+    fitprof::set_skip(true);
+    let a = replay(&caps, 3, "DELETE ARM (decoded_event skipped)");
+    fitprof::set_skip(false);
+    let b = replay(&caps, 1, "SHIPPED again (drift check)");
+    let (da, db) = (a.iter().sum::<f64>() / a.len() as f64, b.iter().sum::<f64>() / b.len() as f64);
+    println!("drift check: shipped {:.3} -> {:.3} us/call", da, db);
+}
