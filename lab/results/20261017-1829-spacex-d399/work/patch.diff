diff --git a/crates/universe/src/fitcap.rs b/crates/universe/src/fitcap.rs
new file mode 100644
index 00000000..3cc77c03
--- /dev/null
+++ b/crates/universe/src/fitcap.rs
@@ -0,0 +1,46 @@
+//! Capture of flown `bind_surface` inputs for the lab's fit bench (run
+//! 20261017-1829-spacex-d399). Off unless `FITCAP=1`: one relaxed load per call.
+//! The captured inputs replay bit-exactly through `bind_surface` (all arguments are
+//! `Copy` integers/scalars; nothing else enters the fit).
+
+use crate::world::Unit;
+use emergent_space::binding::IntegerState;
+use emergent_space::orbit::Scalar;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{LazyLock, Mutex};
+
+pub struct Cap {
+    pub exact: IntegerState,
+    pub t: i64,
+    pub clock_exp: i16,
+    pub edge: Option<Scalar>,
+    pub unit: Unit,
+    pub surface: Option<Scalar>,
+}
+pub fn disarm() {
+    ON.store(false, Ordering::Relaxed);
+}
+
+const MAX: usize = 24_576;
+static CAPS: LazyLock<Mutex<Vec<Cap>>> = LazyLock::new(|| Mutex::new(Vec::new()));
+static ON: AtomicBool = AtomicBool::new(false);
+static ENV: LazyLock<bool> = LazyLock::new(|| std::env::var("FITCAP").is_ok());
+
+pub fn arm() {
+    ON.store(true, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn maybe_capture(exact: IntegerState, t: i64, clock_exp: i16, edge: Option<Scalar>, unit: Unit, surface: Option<Scalar>) {
+    if !ON.load(Ordering::Relaxed) && !*ENV {
+        return;
+    }
+    let mut g = CAPS.lock().unwrap();
+    if g.len() < MAX {
+        g.push(Cap { exact, t, clock_exp, edge, unit, surface });
+    }
+}
+
+pub fn take() -> Vec<Cap> {
+    std::mem::take(&mut *CAPS.lock().unwrap())
+}
