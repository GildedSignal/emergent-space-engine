+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{LazyLock, Mutex};
+
+// ---- lab prototype: the shape memo the design specifies (law.md "compiled once per key"),
+// wired into the rebind path. Bit-identical: the compile is pure and the memo returns the
+// same Arc<OrbitShape> a fresh compile would build. Eviction policy left to the owner.
+static SHAPE_MEMO: LazyLock<Mutex<crate::orbit::ShapeMemo>> =
+    LazyLock::new(|| Mutex::new(crate::orbit::ShapeMemo::default()));
+pub static MEMO_HITS: AtomicU64 = AtomicU64::new(0);
+
+
+#[derive(Default)]
+pub struct RebindDiag {
+    pub calls: AtomicU64,
+    pub fit_ns: AtomicU64,
+    pub compile_ns: AtomicU64,
+    /// consecutive rebinds with the exact same shape inputs (k, periapsis)
+    pub same_shape_exact: AtomicU64,
+    /// consecutive rebinds inside the same 44-bit memo cell
+    pub same_cell: AtomicU64,
+    pub dk_max: AtomicU64,
+    pub dk_sum: AtomicU64,
+}
+pub static REBIND_DIAG: RebindDiag = RebindDiag {
+    calls: AtomicU64::new(0),
+    fit_ns: AtomicU64::new(0),
+    compile_ns: AtomicU64::new(0),
+    same_shape_exact: AtomicU64::new(0),
+    same_cell: AtomicU64::new(0),
+    dk_max: AtomicU64::new(0),
+    dk_sum: AtomicU64::new(0),
+};
+thread_local! {
+    static LAST_KEY: std::cell::RefCell<Option<OrbitKey>> = std::cell::RefCell::new(None);
+}
+pub fn rebind_diag_report() -> String {
+    let d = &REBIND_DIAG;
+    let c = d.calls.load(Ordering::Relaxed).max(1);
+    format!(
+        "rebinds {} | fit {:.1} us avg | compile {:.1} us avg | same exact shape {} | same memo cell {} | dk max {} avg {:.2} | shape-memo hits {}",
+        d.calls.load(Ordering::Relaxed),
+        d.fit_ns.load(Ordering::Relaxed) as f64 / c as f64 / 1e3,
+        d.compile_ns.load(Ordering::Relaxed) as f64 / c as f64 / 1e3,
+        d.same_shape_exact.load(Ordering::Relaxed),
+        d.same_cell.load(Ordering::Relaxed),
+        d.dk_max.load(Ordering::Relaxed),
+        d.dk_sum.load(Ordering::Relaxed) as f64 / c as f64,
+        MEMO_HITS.load(Ordering::Relaxed),
+    )
+}
 
