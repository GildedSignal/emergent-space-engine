+// The idiot-index bench: digests at canonical cuts, per-item cost, and the frame tail,
+// for the lazy position-cache probe (`apply`'s per-event `root_state_raw` refresh).
+// Usage: `idiot [A_HORIZON_TICKS]` — scenarios A (seed 1, Sparse, 48), B (seed 7, Dense, 200), C (600 frames, rtf 100).
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+fn pct(sorted: &[f64], q: f64) -> f64 {
+    sorted[((sorted.len() as f64 - 1.0) * q) as usize]
+}
+
+fn main() {
+    let ha: i64 = std::env::args().nth(1).map(|s| s.parse().unwrap()).unwrap_or(30_000_000_000);
+    // A: the bench's own scenario, settle to a canonical cut.
+    let t0 = Instant::now();
+    let mut a = plane(Config::default(), 1, Order::Sparse, 1, 48).unwrap();
+    let t_build = t0.elapsed();
+    let t0 = Instant::now();
+    a.u.settle(ha);
+    let t_run = t0.elapsed();
+    let s = &a.u.stats;
+    let ev = s.kicks + s.opens + s.boundaries + s.handoffs;
+    println!(
+        "A seed1 Sparse 48: digest {} build {:.2}s run {:.2}s items {} ({:.1} us/item, kicks {} opens {} bounds {} handoffs {})",
+        a.u.digest(),
+        t_build.as_secs_f64(),
+        t_run.as_secs_f64(),
+        ev,
+        t_run.as_secs_f64() * 1e6 / ev.max(1) as f64,
+        s.kicks, s.opens, s.boundaries, s.handoffs
+    );
+    // B: held out — different seed, order and fleet size.
+    let mut b = plane(Config::default(), 7, Order::Sparse, 1, 200).unwrap();
+    let t_build = t0.elapsed();
+    let t0 = Instant::now();
+    b.u.settle(ha.min(3_000_000_000));
+    let s = &b.u.stats;
+    let ev = s.kicks + s.opens + s.boundaries + s.handoffs;
+    println!(
+        "B seed7 Sparse 200: digest {} build {:.2}s run {:.2}s items {} ({:.1} us/item, kicks {} opens {} bounds {} handoffs {})",
+        b.u.digest(),
+        t_build.as_secs_f64(),
+        t_run.as_secs_f64(),
+        ev,
+        t_run.as_secs_f64() * 1e6 / ev.max(1) as f64,
+        s.kicks, s.opens, s.boundaries, s.handoffs
+    );
+    // C: the frame tail at 200 members, rtf 100, 600 frames.
+    let mut c = plane(Config::default(), 7, Order::Sparse, 1, 200).unwrap();
+    let mut ms: Vec<f64> = Vec::new();
+    for _ in 0..600 {
+        let want = (100.0f64 / 60.0 / TICK_SECONDS) as i64;
+        let target = c.u.now + want.max(1);
+        let fr = Instant::now();
+        let adv = c.u.advance(target, Budget::unlimited());
+        c.u.now = adv.horizon.max(c.u.now);
+        ms.push(fr.elapsed().as_secs_f64() * 1e3);
+    }
+    c.u.settle(c.u.now);
+    ms.sort_by(|x, y| x.total_cmp(y));
+    println!(
+        "C frames ms: p50 {:.2} p95 {:.2} p99 {:.2} max {:.2} over16.7 {} over33 {} | digest {}",
+        pct(&ms, 0.5), pct(&ms, 0.95), pct(&ms, 0.99), ms[599],
+        ms.iter().filter(|&&m| m > 16.7).count(),
+        ms.iter().filter(|&&m| m > 33.0).count(),
+        c.u.digest()
+    );
+}
