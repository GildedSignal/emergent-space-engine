+//! The quant lens: the candidate cone as integer arithmetic over packed Binet records.
+//!
+//! Today's tier scans a U-sorted order and pays, per scanned body, a float hypot plus a pair
+//! tolerance (`eps_u`) that reads two 88-byte `Body` records at random. Quantizing (U, V, W) onto a
+//! per-doll integer grid makes the cone test integer squares with no sqrt, and the scan a
+//! sequential stream over 12 bytes per body (SoA u32/i32/i32).
+//!
+//! Safety: floor-quantization puts each integer difference within one quantum of the true one, so
+//! accepting when `du < k` or `(du - k)^2 < dv^2 + dw^2 >> -shift` with `k = E + 1 + sqrt(2)/c`
+//! (E = eps_max in quanta, c = the V-grid's quantum in U-quanta) accepts everything the float cone
+//! accepts: a provable superset. Misses can only be implementation bugs, which is what the checks
+//! count. All decisions are integers; floats only build the grid.
+
+use crate::belt::{make_belt, Rng, Spec};
+use crate::kepler::Body;
+use crate::pairs::{cone_pairs, is_candidate, radial_pairs};
+use crate::par_chunks;
+use crate::truth::{truth_pair, TruthStats};
+use std::collections::HashSet;
+use std::time::Instant;
+
+const THREADS: usize = 4;
+const CLAMP: f64 = (1u32 << 30) as f64;
+
+/// Globals of one doll's belt, gathered in a first pass (streaming-friendly).
+pub struct Globals {
+    umin: f64,
+    umax: f64,
+    vmax: f64,
+    rmin_g: f64,
+    rmax_g: f64,
+    emax: f64,
+    pmin: f64,
+    epmax: f64,
+}
+
+impl Globals {
+    pub fn from_bodies(b: &[Body]) -> Self {
+        let mut g = Globals {
+            umin: f64::INFINITY,
+            umax: f64::NEG_INFINITY,
+            vmax: 0.0,
+            rmin_g: f64::INFINITY,
+            rmax_g: 0.0,
+            emax: 0.0,
+            pmin: f64::INFINITY,
+            epmax: 0.0,
+        };
+        for x in b {
+            g.accum(x);
+        }
+        g
+    }
+
+    fn accum(&mut self, x: &Body) {
+        let t = x.binet();
+        self.umin = self.umin.min(t[0]);
+        self.umax = self.umax.max(t[0]);
+        self.vmax = self.vmax.max(t[1].abs()).max(t[2].abs());
+        self.rmin_g = self.rmin_g.min(x.rmin());
+        self.rmax_g = self.rmax_g.max(x.rmax());
+        self.emax = self.emax.max(x.e);
+        self.pmin = self.pmin.min(x.p);
+        self.epmax = self.epmax.max(x.e / x.p);
+    }
+
+    fn eps_max(&self, rho: f64) -> f64 {
+        1.5 * rho * (1.0 + self.rmax_g * self.rmax_g * self.emax / (self.pmin * self.rmin_g))
+            / (self.rmin_g * self.rmin_g)
+    }
+}
+
+pub struct Packed {
+    pub u: Vec<u32>,
+    pub v: Vec<i32>,
+    pub w: Vec<i32>,
+    /// Per-body scan half-range in U quanta (quantized outward).
+    pub reach: Vec<u32>,
+    /// Slack in quanta. Negative on narrow-span dolls; still a superset.
+    pub k: i64,
+    /// 2^(2*(bv - bits)) as a (non-positive) shift on the V/W side.
+    pub shift: i32,
+    pub bits: u32,
+    pub orig: Vec<u32>,
+    /// Float SoA in the same sorted slot order (empty in the knee build).
+    pub uf: Vec<f64>,
+    pub vf: Vec<f64>,
+    pub wf: Vec<f64>,
+    pub eps_max: f64,
+    pub e_max: f64,
+    pub quanta: f64,
+}
+
+/// The integer hit test for one pair, slot order (u[j] >= u[i]).
+#[inline(always)]
+fn hit_int(u: &[u32], v: &[i32], w: &[i32], i: usize, j: usize, k: i64, shift: i32) -> bool {
+    let du = (u[j] - u[i]) as i64;
+    if du < k {
+        return true;
+    }
+    let t = (du - k) as u64;
+    let dv = (v[j] as i64 - v[i] as i64) as u64;
+    let dw = (w[j] as i64 - w[i] as i64) as u64;
+    let rs = dv * dv + dw * dw;
+    let rs = if shift == 0 {
+        rs
+    } else {
+        // c < 1: scale the V/W side up, rounding up, so the test only widens.
+        (rs + (1u64 << (-shift as u32)) - 1) >> (-shift as u32)
+    };
+    t * t < rs
+}
+
+pub fn pack_from_globals(
+    b: &[Body],
+    g: &Globals,
+    rho: f64,
+    bits: u32,
+    with_float: bool,
+) -> Packed {
+    // Absolute power-of-two scales: the U quantum is 2^-bits in u units, so the V/W quantum in
+    // U quanta, c = 2^(bv - bits), is exactly a power of two and the shift is exact.
+    let su = (1u64 << bits) as f64;
+    let cap = (CLAMP / g.vmax.max(1e-12)).log2().floor();
+    let bv = (bits as f64).min(cap).max(1.0) as u32;
+    let sv = (1u64 << bv) as f64;
+    let c = sv / su; // <= 1, power of two
+    let eps_max = g.eps_max(rho);
+    let e_q = eps_max * su;
+    let k = if e_q < 4.0 {
+        // Degenerate: the tolerance is sub-quantum; accept everything scanned (still a superset).
+        i64::MAX / 4
+    } else {
+        ((e_q + 1.0 + 2f64.sqrt() / c).floor() as i64).max(-(1i64 << 31))
+    };
+    let shift = 2 * (bv as i32 - bits as i32); // <= 0
+    let n = b.len();
+    let r_add = g.epmax + eps_max;
+    let mut u = Vec::with_capacity(n);
+    let mut v = Vec::with_capacity(n);
+    let mut w = Vec::with_capacity(n);
+    let mut reach = Vec::with_capacity(n);
+    for x in b {
+        let t = x.binet();
+        u.push((((t[0] - g.umin) * su).floor().clamp(0.0, su - 1.0)) as u32);
+        v.push(((t[1] * sv).floor().clamp(-CLAMP, CLAMP - 1.0)) as i32);
+        w.push(((t[2] * sv).floor().clamp(-CLAMP, CLAMP - 1.0)) as i32);
+        reach.push(((((x.e / x.p + r_add) * su).ceil() as u64) + 2).min(u32::MAX as u64) as u32);
+    }
+    let mut perm: Vec<u32> = (0..n as u32).collect();
+    perm.sort_unstable_by_key(|&i| u[i as usize]);
+    let (uf, vf, wf) = if with_float {
+        let mut fu = vec![0.0f64; n];
+        let mut fv = vec![0.0f64; n];
+        let mut fw = vec![0.0f64; n];
+        for (i, x) in b.iter().enumerate() {
+            let t = x.binet();
+            fu[i] = t[0];
+            fv[i] = t[1];
+            fw[i] = t[2];
+        }
+        (
+            perm.iter().map(|&i| fu[i as usize]).collect(),
+            perm.iter().map(|&i| fv[i as usize]).collect(),
+            perm.iter().map(|&i| fw[i as usize]).collect(),
+        )
+    } else {
+        (Vec::new(), Vec::new(), Vec::new())
+    };
+    Packed {
+        u: perm.iter().map(|&i| u[i as usize]).collect(),
+        v: perm.iter().map(|&i| v[i as usize]).collect(),
+        w: perm.iter().map(|&i| w[i as usize]).collect(),
+        reach: perm.iter().map(|&i| reach[i as usize]).collect(),
+        k,
+        shift,
+        bits,
+        orig: perm,
+        uf,
+        vf,
+        wf,
+        eps_max,
+        e_max: g.epmax,
+        quanta: 1.0 / su,
+    }
+}
+
+pub fn build(b: &[Body], rho: f64, bits: u32) -> Packed {
+    pack_from_globals(b, &Globals::from_bodies(b), rho, bits, true)
+}
+/// Evenly spaced original body ids (stable across packings).
+fn sample_orig(n: usize, m: usize) -> Vec<u32> {
+    let m = m.min(n).max(1);
+    (0..m).map(|t| (t * n / m) as u32).collect()
+}
+
+fn slot_of(orig: &[u32]) -> Vec<u32> {
+    let mut s = vec![0u32; orig.len()];
+    for (slot, &o) in orig.iter().enumerate() {
+        s[o as usize] = slot as u32;
+    }
+    s
+}
+
+/// Integer scan over slots: (scanned, hits, seconds).
+pub fn scan_int(p: &Packed, slots: &[usize]) -> (u64, u64, f64) {
+    let t0 = Instant::now();
+    let mut scanned = 0u64;
+    let mut hits = 0u64;
+    let (u, v, w) = (&p.u, &p.v, &p.w);
+    for &i in slots {
+        let ui = u[i];
+
+        let bound = (ui as u64 + p.reach[i] as u64).min(u32::MAX as u64) as u32;
+        let hi = u.partition_point(|&x| x <= bound);
+        let mut h = 0u64;
+        for j in i + 1..hi {
+            if hit_int(u, v, w, i, j, p.k, p.shift) {
+                h += 1;
+            }
+        }
+        scanned += (hi - i - 1) as u64;
+        hits += h;
+    }
+    (scanned, hits, t0.elapsed().as_secs_f64())
+}
+
+/// Today's exact float path: a U-sorted (f64, u32) order plus per-pair eps_u through random `Body`
+/// reads. `order` (sorted by U, tie by id) and `opos` (orig id -> position) are built once by the
+/// caller, as the shipped tier maintains its order persistently.
+pub fn scan_body(
+    b: &[Body],
+    p: &Packed,
+    order: &[(f64, u32)],
+    opos: &[u32],
+    sample: &[u32],
+    rho: f64,
+) -> (u64, u64, f64) {
+    let t0 = Instant::now();
+    let mut scanned = 0u64;
+    let mut hits = 0u64;
+    for &o in sample {
+        let k = opos[o as usize] as usize;
+        let bi = &b[o as usize];
+        let reach = bi.e / bi.p + p.e_max + p.eps_max;
+        let u = order[k].0;
+        let hi = order.partition_point(|z| z.0 <= u + reach);
+        let mut h = 0u64;
+        for j in k + 1..hi {
+            let oj = order[j].1;
+            if is_candidate(bi, &b[oj as usize], rho) {
+                h += 1;
+            }
+        }
+        scanned += (hi - k - 1) as u64;
+        hits += h;
+    }
+    (scanned, hits, t0.elapsed().as_secs_f64())
+}
+
+/// Float packed (SoA f64, global eps) over the integer range: isolates arithmetic from layout.
+pub fn scan_fpack(p: &Packed, slots: &[usize]) -> (u64, u64, f64) {
+    let t0 = Instant::now();
+    let (u, v, w) = (&p.uf, &p.vf, &p.wf);
+    let eps = p.eps_max;
+    let mut scanned = 0u64;
+    let mut hits = 0u64;
+    for &i in slots {
+        let ui = u[i];
+        let vi = v[i];
+        let wi = w[i];
+        let bound = (p.u[i] as u64 + p.reach[i] as u64).min(u32::MAX as u64) as u32;
+        let hi = p.u.partition_point(|&x| x <= bound);
+        let mut h = 0u64;
+        for j in i + 1..hi {
+            let du = u[j] - ui;
+            let dv = v[j] - vi;
+            let dw = w[j] - wi;
+            if du - dv.hypot(dw) < eps {
+                h += 1;
+            }
+        }
+        scanned += (hi - i - 1) as u64;
+        hits += h;
+    }
+    (scanned, hits, t0.elapsed().as_secs_f64())
+}
+
+/// Joint correctness pass over the integer range: counts per predicate, and integer misses
+/// against today's exact float pair test.
+pub fn scan_checks(
+    b: &[Body],
+    p: &Packed,
+    sample: &[u32],
+    rho: f64,
+) -> (u64, u64, u64, u64, u64) {
+    let so = slot_of(&p.orig);
+    let mut scanned = 0u64;
+    let mut f_pair = 0u64;
+    let mut f_glob = 0u64;
+    let mut int_hits = 0u64;
+    let mut misses = 0u64;
+    for &o in sample {
+        let i = so[o as usize] as usize;
+        let bi = &b[o as usize];
+        let bound = (p.u[i] as u64 + p.reach[i] as u64).min(u32::MAX as u64) as u32;
+        let hi = p.u.partition_point(|&x| x <= bound);
+        for j in i + 1..hi {
+            let oj = p.orig[j] as usize;
+            scanned += 1;
+            let fp = is_candidate(bi, &b[oj], rho);
+            let fg = p.uf[j] - p.uf[i] - (p.vf[i] - p.vf[j]).hypot(p.wf[i] - p.wf[j]) < p.eps_max;
+            let it = hit_int(&p.u, &p.v, &p.w, i, j, p.k, p.shift);
+            f_pair += fp as u64;
+            f_glob += fg as u64;
+            int_hits += it as u64;
+            misses += (fp && !it) as u64;
+        }
+    }
+    (scanned, f_pair, f_glob, int_hits, misses)
+}
+
+/// Full-sweep integer candidate pairs (original ids), for the truth anchor.
+pub fn sweep_int_pairs(p: &Packed) -> Vec<(u32, u32)> {
+    let mut out = Vec::new();
+    let n = p.u.len();
+    for i in 0..n {
+        let bound = (p.u[i] as u64 + p.reach[i] as u64).min(u32::MAX as u64) as u32;
+        let hi = p.u.partition_point(|&x| x <= bound);
+        for j in i + 1..hi {
+            if hit_int(&p.u, &p.v, &p.w, i, j, p.k, p.shift) {
+                let (a, b) = (p.orig[i], p.orig[j]);
+                out.push((a.min(b), a.max(b)));
+            }
+        }
+    }
+    out
+}
+
+/// Streaming belt generator: the same rng call order as `make_belt`, one body at a time.
+fn stream_bodies(s: &Spec) -> impl Iterator<Item = Body> + '_ {
+    let mut rng = Rng(s.seed);
+    let spec = s.clone();
+    (0..s.n).map(move |_| {
+        let a = if spec.keys > 1 {
+            let k = (rng.next_u64() % spec.keys as u64) as f64;
+            spec.a_lo + (spec.a_hi - spec.a_lo) * k / (spec.keys - 1) as f64
+        } else {
+            spec.a_lo + (spec.a_hi - spec.a_lo) * rng.f64()
+        };
+        let u = rng.f64();
+        let e = (spec.sigma_e * (-2.0 * (1.0 - u).ln()).sqrt()).min(0.5);
+        let pom = std::f64::consts::TAU * rng.f64();
+        let lam = std::f64::consts::TAU * rng.f64();
+        Body::new(a, e, pom, lam)
+    })
+}
