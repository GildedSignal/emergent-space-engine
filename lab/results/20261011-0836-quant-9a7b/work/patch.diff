+pub fn dispatch(args: &[String]) {
+    match args.get(0).map(|s| s.as_str()) {
+        Some("growth") => growth(
+            args[1].parse().unwrap(),
+            args[2].parse().unwrap(),
+            args[3].parse().unwrap(),
+            args[4].parse().unwrap(),
+            args[5].parse().unwrap(),
+            args[6].parse().unwrap(),
+            args[7].parse().unwrap(),
+        ),
+        Some("speed") => speed(
+            args[1].parse().unwrap(),
+            args[2].parse().unwrap(),
+            args[3].parse().unwrap(),
+            args[4].parse().unwrap(),
+            args[5].parse().unwrap(),
+            args[6].parse().unwrap(),
+            args[7].parse().unwrap(),
+        ),
+        Some("knee") => knee(
+            args[1]
+                .split(',')
+                .map(|x| x.parse().unwrap())
+                .collect(),
+            args[2].parse().unwrap(),
+            args[3].parse().unwrap(),
+        ),
+        _ => eprintln!(
+            "usage: quant growth <n> <sigma_e> <rho> <keys> <seed> <m> <orbits> | \
+             quant speed <n> <sigma_e> <rho> <keys> <seed> <m> <reps> | \
+             quant knee <n,csv> <m> <reps>"
+        ),
+    }
+}
+
+fn spec_of(n: usize, sigma_e: f64, rho: f64, keys: usize, seed: u64, orbits: f64) -> Spec {
+    Spec {
+        name: "quant".into(),
+        n,
+        sigma_e,
+        rho,
+        a_lo: 1.0,
+        a_hi: 1.5,
+        keys,
+        seed,
+        orbits,
+    }
+}
+
+/// Work and safety vs the float cone; at n <= 4000 also the truth anchor (real encounters).
+fn growth(n: usize, sigma_e: f64, rho: f64, keys: usize, seed: u64, m: usize, orbits: f64) {
+    let s = spec_of(n, sigma_e, rho, keys, seed, orbits);
+    let b = make_belt(&s);
+    let sample = sample_orig(n, m);
+    let mut line = format!(
+        "{{\"cmd\":\"growth\",\"n\":{n},\"sigma_e\":{sigma_e:e},\"rho\":{rho:e},\"keys\":{keys},\"seed\":{seed},\"m\":{},",
+        sample.len()
+    );
+    for bits in [16u32, 20, 24, 28, 30] {
+        let p = build(&b, rho, bits);
+        let (scanned, f_pair, f_glob, int_hits, misses) = scan_checks(&b, &p, &sample, rho);
+        line.push_str(&format!(
+            "\"b{bits}\":{{\"scanned\":{scanned},\"f_pair\":{f_pair},\"f_glob\":{f_glob},\"int\":{int_hits},\"miss\":{misses},\"growth\":{:.4}}},",
+            int_hits as f64 / f_pair.max(1) as f64
+        ));
+    }
+    // Truth anchor at small n: every real encounter's pair must be an integer candidate.
+    if n <= 4000 {
+        let p30 = build(&b, rho, 30);
+        let int_pairs: HashSet<(u32, u32)> = sweep_int_pairs(&p30).into_iter().collect();
+        let cone = cone_pairs(&b, rho);
+        let float_pairs: HashSet<(u32, u32)> = cone.pairs.iter().copied().collect();
+        let mut float_missing = 0u64;
+        for qp in &float_pairs {
+            if !int_pairs.contains(qp) {
+                float_missing += 1;
+            }
+        }
+        let radial = radial_pairs(&b, rho);
+        let t_end = orbits * std::f64::consts::TAU;
+        let parts = par_chunks(radial.len(), 256, THREADS, |r| {
+            let mut out: Vec<(u32, u32, f64, f64)> = Vec::new();
+            let mut st = TruthStats::default();
+            let mut tmp = Vec::new();
+            for &(i, j) in &radial[r] {
+                tmp.clear();
+                truth_pair(&b[i as usize], &b[j as usize], rho, t_end, &mut tmp, &mut st);
+                out.extend(tmp.iter().map(|&(t, d)| (i, j, t, d)));
+            }
+            (out, st)
+        });
+        let mut enc = 0u64;
+        let mut enc_in_int = 0u64;
+        let mut enc_in_float = 0u64;
+        let mut covered: HashSet<(u32, u32)> = HashSet::new();
+        for part in &parts {
+            for &(i, j, _t, _d) in &part.0 {
+                if covered.insert((i, j)) {
+                    enc += 1;
+                    enc_in_int += int_pairs.contains(&(i, j)) as u64;
+                    enc_in_float += float_pairs.contains(&(i, j)) as u64;
+                }
+            }
+        }
+        line.push_str(&format!(
+            "\"anchor\":{{\"orbits\":{orbits},\"enc_pairs\":{enc},\"enc_in_int\":{enc_in_int},\"enc_in_float\":{enc_in_float},\"float_pairs\":{},\"int_pairs\":{},\"float_missing_from_int\":{float_missing}}},",
+            float_pairs.len(),
+            int_pairs.len()
+        ));
+    }
+    line.pop();
+    line.push('}');
+    println!("{line}");
+}
+
+/// Timing of the three hot paths on the same sample (min of reps).
+fn speed(n: usize, sigma_e: f64, rho: f64, keys: usize, seed: u64, m: usize, reps: usize) {
+    let s = spec_of(n, sigma_e, rho, keys, seed, 0.0);
+    let b = make_belt(&s);
+    let p = build(&b, rho, 30);
+    let sample = sample_orig(n, m);
+    let so = slot_of(&p.orig);
+    let slots: Vec<usize> = sample.iter().map(|&o| so[o as usize] as usize).collect();
+
+    let mut best_int = f64::INFINITY;
+    let mut int_sc = 0;
+    let mut int_hit = 0;
+    for _ in 0..reps {
+        let (sc, h, t) = scan_int(&p, &slots);
+        int_sc = sc;
+        int_hit = h;
+        best_int = best_int.min(t);
+    }
+    let mut best_fp = f64::INFINITY;
+    let mut fp_sc = 0;
+    let mut fp_hit = 0;
+    for _ in 0..reps {
+        let (sc, h, t) = scan_fpack(&p, &slots);
+        fp_sc = sc;
+        fp_hit = h;
+        best_fp = best_fp.min(t);
+    }
+    // The float order, built once (the shipped tier maintains it persistently).
+    let mut order: Vec<(f64, u32)> =
+        b.iter().enumerate().map(|(i, x)| (x.binet()[0], i as u32)).collect();
+    order.sort_by(|x, y| x.0.total_cmp(&y.0).then(x.1.cmp(&y.1)));
+    let mut opos = vec![0u32; n];
+    for (k, &(_, o)) in order.iter().enumerate() {
+        opos[o as usize] = k as u32;
+    }
+    let mut best_bd = f64::INFINITY;
+    let mut bd_sc = 0;
+    let mut bd_hit = 0;
+    for _ in 0..reps {
+        let (sc, h, t) = scan_body(&b, &p, &order, &opos, &sample, rho);
+        bd_sc = sc;
+        bd_hit = h;
+        best_bd = best_bd.min(t);
+    }
+    let ns = |t: f64, sc: u64| t * 1e9 / sc.max(1) as f64;
+    println!(
+        "{{\"cmd\":\"speed\",\"n\":{n},\"sigma_e\":{sigma_e:e},\"rho\":{rho:e},\"keys\":{keys},\"seed\":{seed},\"m\":{},\
+         \"int\":{{\"scanned\":{int_sc},\"hits\":{int_hit},\"s\":{:.4},\"ns_per_scanned\":{:.3}}},\
+         \"fpack\":{{\"scanned\":{fp_sc},\"hits\":{fp_hit},\"s\":{:.4},\"ns_per_scanned\":{:.3}}},\
+         \"body\":{{\"scanned\":{bd_sc},\"hits\":{bd_hit},\"s\":{:.4},\"ns_per_scanned\":{:.3}}},\
+         \"speedup_int_vs_body\":{:.2},\"speedup_int_vs_fpack\":{:.2}}}",
+        sample.len(),
+        best_int, ns(best_int, int_sc),
+        best_fp, ns(best_fp, fp_sc),
+        best_bd, ns(best_bd, bd_sc),
+        ns(best_bd, bd_sc) / ns(best_int, int_sc),
+        ns(best_fp, fp_sc) / ns(best_int, int_sc),
+    );
+}
+
+/// Integer-only capacity curve: streaming build (no Body kept), timing to large n.
+fn knee(ns: Vec<usize>, m: usize, reps: usize) {
+    // Self-check: the streaming generator matches make_belt body for body.
+    {
+        let s = spec_of(100_000, 1e-2, 1e-4, 0, 424_242, 0.0);
+        let vb = make_belt(&s);
+        let vs: Vec<Body> = stream_bodies(&s).collect();
+        assert_eq!(vb.len(), vs.len());
+        for (x, y) in vb.iter().zip(vs.iter()) {
+            let (a, b) = (x.binet(), y.binet());
+            assert_eq!(a[0].to_bits(), b[0].to_bits(), "stream mismatch");
+            assert_eq!(a[1].to_bits(), b[1].to_bits());
+            assert_eq!(a[2].to_bits(), b[2].to_bits());
+        }
+    }
+    println!("{{\"cmd\":\"knee\",\"selfcheck\":\"stream==make_belt ok\"}}");
+    for n in ns {
+        let s = spec_of(n, 1e-2, 1e-4, 0, 424_242, 0.0);
+        let t0 = Instant::now();
+        let mut g = Globals {
+            umin: f64::INFINITY,
+            umax: f64::NEG_INFINITY,
+            vmax: 0.0,
+            rmin_g: f64::INFINITY,
+            rmax_g: 0.0,
+            emax: 0.0,
+            pmin: f64::INFINITY,
+            epmax: 0.0,
+        };
+        for x in stream_bodies(&s) {
+            g.accum(&x);
+        }
+        let rho = 1e-4;
+        let bits = 30u32;
+        let cap = (CLAMP / g.vmax.max(1e-12)).log2().floor();
+        let su = (1u64 << bits) as f64;
+        let bv = (bits as f64).min(cap).max(1.0) as u32;
+        let sv = (1u64 << bv) as f64;
+        let c = sv / su;
+        let eps_max = g.eps_max(rho);
+        let e_q = eps_max * su;
+        let k = if e_q < 4.0 {
+            i64::MAX / 4
+        } else {
+            ((e_q + 1.0 + 2f64.sqrt() / c).floor() as i64).max(-(1i64 << 31))
+        };
+        let shift = 2 * (bv as i32 - bits as i32);
+        let r_add = g.epmax + eps_max;
+        let mut u: Vec<u32> = Vec::with_capacity(n);
+        let mut v: Vec<i32> = Vec::with_capacity(n);
+        let mut w: Vec<i32> = Vec::with_capacity(n);
+        let mut reach: Vec<u32> = Vec::with_capacity(n);
+        for x in stream_bodies(&s) {
+            let t = x.binet();
+            u.push((((t[0] - g.umin) * su).floor().clamp(0.0, (1u64 << bits) as f64 - 1.0)) as u32);
+            v.push(((t[1] * sv).floor().clamp(-CLAMP, CLAMP - 1.0)) as i32);
+            w.push(((t[2] * sv).floor().clamp(-CLAMP, CLAMP - 1.0)) as i32);
+            reach.push(((((x.e / x.p + r_add) * su).ceil() as u64) + 2).min(u32::MAX as u64) as u32);
+        }
+        let mut perm: Vec<u32> = (0..n as u32).collect();
+        perm.sort_unstable_by_key(|&i| u[i as usize]);
+        let p = Packed {
+            u: perm.iter().map(|&i| u[i as usize]).collect(),
+            v: perm.iter().map(|&i| v[i as usize]).collect(),
+            w: perm.iter().map(|&i| w[i as usize]).collect(),
+            reach: perm.iter().map(|&i| reach[i as usize]).collect(),
+            k,
+            shift,
+            bits,
+            orig: perm,
+            uf: Vec::new(),
+            vf: Vec::new(),
+            wf: Vec::new(),
+            eps_max,
+            e_max: g.epmax,
+            quanta: 1.0 / su,
+        };
+        drop(u);
+        drop(v);
+        drop(w);
+        drop(reach);
+        let build_s = t0.elapsed().as_secs_f64();
+        let slots: Vec<usize> = {
+            let mm = m.min(n).max(1);
+            (0..mm).map(|t| t * n / mm).collect()
+        };
+        let mut best = f64::INFINITY;
+        let mut scanned = 0u64;
+        let mut hits = 0u64;
+        for _ in 0..reps {
+            let (sc, h, t) = scan_int(&p, &slots);
+            scanned = sc;
+            hits = h;
+            best = best.min(t);
+        }
+        let per_body = scanned as f64 / slots.len() as f64;
+        println!(
+            "{{\"cmd\":\"knee\",\"n\":{n},\"m\":{},\"build_s\":{:.3},\"scan_s\":{:.4},\"scanned\":{scanned},\"hits\":{hits},\
+             \"scanned_per_body\":{per_body:.0},\"ns_per_scanned\":{:.3},\"quanta\":{:.3e},\"k\":{k},\"shift\":{shift}}}",
+            slots.len(),
+            build_s,
+            best,
+            best * 1e9 / scanned.max(1) as f64,
+            p.quanta
+        );
+    }
+}
