+//! The burn-cadence probe (lab run 20261013-1428-system-2964): the player's held burns flown the
+//! way the page flies them (paced frames, 12 ms budget, rtf 100), under three arms of the same
+//! binary selected by `ES_BURN_CADENCE` (`ship` = shipped bits, the default when unset; `fine` =
+//! 16× finer burn sampling, the reference; `off` = the clamp deleted, the field's/clock's own step
+//! carries the burn).
+//!
+//! Decisions are scheduled at FIXED canonical ticks (only the changes, as the session logs them),
+//! so every arm sees the same decision ticks: readout differences between arms are the cadence
+//! law's, not the wall's. Per flight: player items and decisions per frame (the burst), the worst
+//! frame's CPU, the readout grid every 4th frame (presented tick, ramped root state, the burn owed
+//! there), the end state at a fixed canonical cut (settle + digest), refusals, and the impact
+//! warning's lead.
+//!
+//! cargo run --release -p emergent-universe --example burn_cadence [-- <wall seconds per flight> [<only flights whose name contains>]]]
+use emergent_universe::observe::{held_thrust, root_state};
+use emergent_universe::scenario::plane;
+use emergent_universe::step::{counters, Counters};
+use emergent_universe::view::{gather_cached, ViewCache, TICK_SECONDS};
+use emergent_universe::{Budget, Config};
+use std::io::Write as _;
+use emergent_universe::thrust::word;
+use std::time::{Duration, Instant};
+/// One flight: a name and the decision changes at fixed game-seconds (the burn holds from game-s 100).
+fn flights(seconds: f64) -> Vec<(String, Vec<(f64, u8, u8)>)> {
+    let _ = seconds;
+    vec![
+        ("coast".into(), vec![]),
+        ("forward L8".into(), vec![(100.0, 1, 8)]),
+        ("forward L12".into(), vec![(100.0, 1, 12)]),
+        ("forward L15".into(), vec![(100.0, 1, 15)]),
+        ("reverse L8".into(), vec![(100.0, 2, 8)]),
+        ("turn then burn L8".into(), vec![(100.0, 4, 8), (164.0, 0, 8), (200.0, 1, 8)]),
+    ]
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let seconds: f64 = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(8.0);
+    let seed: u64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let only = args.get(2).cloned().unwrap_or_default();
+    let arm = std::env::var("ES_BURN_CADENCE").unwrap_or_else(|_| "ship(unset)".into());
+    let frames = (seconds * 60.0) as usize;
+    let grid = std::fs::File::create(format!("burn_cadence_{arm}_{seed}.tsv", arm = arm.replace("(unset)", "unset"))).unwrap();
+    let mut grid = std::io::BufWriter::new(grid);
+    writeln!(grid, "flight\tt\tx0\tx1\tv0\tv1\tdv0\tdv1").unwrap();
+    println!("arm {arm}, rtf 100, {seconds} s wall per flight ({frames} frames), decisions at fixed ticks");
+    println!(
+        "{:<20} {:>8} {:>8} {:>8} {:>9} {:>9} {:>9} {:>9} {:>8} {:>10} {:>10}  {} {}",
+        "flight", "pitems", "pburst", "decide", "items", "rebinds", "worst ms", "lag s", "refusal", "alive", "end |x| AU", "end |v|/c", "digest"
+    );
+    for (name, changes) in flights(seconds).into_iter().filter(|(n, _)| n.contains(&only)) {
+        let mut p = plane(Config::default(), seed, emergent_universe::fleet::Order::Sparse, 1, 48).unwrap();
+        let mut cache = ViewCache::default();
+        let player = p.player;
+        // Schedule every decision change at its fixed canonical tick before the first frame.
+        for (g, keys, level) in &changes {
+            p.u.schedule((g / TICK_SECONDS) as i64, word(*keys, *level)).unwrap();
+        }
+        let limit = ((seconds * 100.0) / TICK_SECONDS) as i64; // rtf 100: the canonical cut every arm settles at
+        let (mut worst, mut lag, mut burst, mut items, mut decides, mut pburst, mut pitems) =
+            (Duration::ZERO, 0f64, 0u64, 0u64, 0u64, 0u64, 0u64);
+        let mut pevents = p.u.rec(player).events;
+        let (mut rebinds, mut warned) = (0u64, None);
+        let mut lost_at = None;
+        let _ = counters();
+        for f in 0..frames {
+            let start = Instant::now();
+            let frame = p.u.frame_to(1.0 / 60.0, 100.0, Budget { events: u64::MAX, until: Some(start + Duration::from_millis(12)) }, limit);
+            worst = worst.max(start.elapsed());
+            lag = lag.max((frame.target - frame.presented) as f64 * TICK_SECONDS);
+            let c: Counters = counters();
+            burst = burst.max(c.kick + c.boundary + c.open + c.crash + c.decide);
+            items += c.kick + c.boundary + c.open + c.crash;
+            decides += c.decide;
+            rebinds += c.rebind;
+            let rec = p.u.rec(player);
+            let dp = rec.events - pevents;
+            pevents = rec.events;
+            pburst = pburst.max(dp);
+            pitems += dp;
+            if !rec.alive {
+                lost_at = Some(frame.presented);
+                break;
+            }
+            if f % 4 == 0 {
+                let t = frame.presented.max(rec.b.event_time);
+                if let Ok((x, v)) = root_state(&p.u.ctx(), player, t) {
+                    let dv = held_thrust(&p.u.ctx(), &rec, t).ok().flatten().map(|(_, d)| d).unwrap_or([0.0; 2]);
+                    writeln!(grid, "{name}\t{t}\t{:.9e}\t{:.9e}\t{:.9e}\t{:.9e}\t{:.9e}\t{:.9e}", x[0], x[1], v[0], v[1], dv[0], dv[1]).unwrap();
+                }
+            }
+            if warned.is_none() && gather_cached(&p.u, &p.names, &mut cache).is_some_and(|v| v.impact.is_some()) {
+                warned = Some(frame.presented);
+            }
+        }
+        p.u.settle(limit);
+        let rec = p.u.rec(player);
+        let (ex, ev) = root_state(&p.u.ctx(), player, rec.b.event_time).unwrap_or(([0.0; 2], [0.0; 2]));
+        let au = (ex[0] * ex[0] + ex[1] * ex[1]).sqrt() * TICK_SECONDS / 499.004784;
+        let vc = (ev[0] * ev[0] + ev[1] * ev[1]).sqrt();
+        let warn = match (warned, lost_at) {
+            (Some(w), Some(l)) => format!("{:.0}s lead", (l - w) as f64 * TICK_SECONDS),
+            (Some(_), None) => "warned, alive".into(),
+            _ => "-".into(),
+        };
+        let end = if rec.alive {
+            rec.fault.map(|f| format!("fault {f:?}")).unwrap_or_default()
+        } else {
+            gather_cached(&p.u, &p.names, &mut cache)
+                .and_then(|v| v.loss)
+                .unwrap_or_else(|| format!("lost at {}", lost_at.unwrap_or(0)))
+        };
+        println!(
+            "{:<20} {:>8} {:>8} {:>8} {:>9} {:>9} {:>9.2} {:>9.3} {:>9} {:>8} {:>10.4} {:>10.6}  {} {}",
+            name, pitems, pburst, decides, items, rebinds, worst.as_secs_f64() * 1e3, lag, rec.refusals, rec.alive, au, vc, p.u.digest(), format!("{warn} {end}")
+        );
+    }
+}
