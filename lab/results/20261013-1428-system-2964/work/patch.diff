+// ---- probe counters (lab run 20261013-1428-system-2964; counting only, never an outcome) ------------------
+
+/// Per-thread counters of what resolution did (the lab's burn-cadence probe reads them between
+#[derive(Clone, Copy, Default, Debug)]
+pub struct Counters {
+    pub kick: u64,
+    pub boundary: u64,
+    pub open: u64,
+    pub crash: u64,
+    pub decide: u64,
+    pub rebind: u64,
+    pub lost: u64,
+}
+
+impl Counters {
+    const EMPTY: Self = Self { kick: 0, boundary: 0, open: 0, crash: 0, decide: 0, rebind: 0, lost: 0 };
+}
+
+thread_local! {
+    static COUNTERS: std::cell::Cell<Counters> = const { std::cell::Cell::new(Counters::EMPTY) };
+}
+
+/// Take (and reset) this thread's counters.
+pub fn counters() -> Counters {
+    COUNTERS.with(|c| c.replace(Counters::default()))
+}
+
+fn bump(f: impl FnOnce(&mut Counters)) {
+    COUNTERS.with(|c| {
+        let mut n = c.get();
+        f(&mut n);
+        c.set(n);
+    });
+}
+
