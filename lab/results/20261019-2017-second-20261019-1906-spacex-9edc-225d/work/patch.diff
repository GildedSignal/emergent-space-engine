diff --git a/crates/universe/src/news.rs b/crates/universe/src/news.rs
new file mode 100644
index 00000000..a2503859
--- /dev/null
+++ b/crates/universe/src/news.rs
@@ -0,0 +1,238 @@
+//! Print-only census of the kick rebind's news (env `ES_KICK_NEWS`): does a fired kick's
+//! re-fit reproduce the standing compiled orbit (same `OrbitKey`), or mint a new one?
+//! Counters only; the shipped path is untouched when the flag is off.
+//!
+//! The second-author extension (20261019-2017-…-225d): the census is split by MINT KIND —
+//! birth binds (`add_body`/`add_body_state`/fleet births/retunes) vs kick rebinds vs other
+//! rebinds (handoffs) — and a shadow refcount of live intern keys (the `(doll, mu, clockwise,
+//! OrbitKey)` tuple `crates/space`'s own catalogue interns by; the plane's fork has no lookup)
+//! counts every mint that lands on a key another live binding already holds: the exact hit a
+//! key-dedup insert would score. Dead bodies keep their key (the shipped catalogue releases
+//! nothing on death — efd4's corpse retention), so the shadow mirrors shipped standing stock.
+
+use crate::bind::Entry;
+use emergent_space::orbit::{OrbitKey, Scalar};
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Mutex;
+
+pub static C: [AtomicU64; 24] = [
+    AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+    AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+    AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+    AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+    AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+    AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+];
+pub const CLOCK_FIRED: usize = 0;
+pub const CLOCK_SAME: usize = 1;
+pub const CLOCK_FLIP: usize = 2;
+pub const CLOCK_PLUNGE: usize = 3;
+pub const BELT_FIRED: usize = 4;
+pub const BELT_SAME: usize = 5;
+pub const BELT_FLIP: usize = 6;
+pub const TUBE_FIRED: usize = 7;
+pub const TUBE_SAME: usize = 8;
+pub const TUBE_FLIP: usize = 9;
+pub const CAT_INSERTS: usize = 10;
+pub const CAT_HIT: usize = 11;
+pub const SELF_OK: usize = 12;
+/// A clock kick whose quantized dv rounded to zero (carried): planned, not fired, no rebind.
+pub const CLOCK_NOTFIRED: usize = 13;
+pub const TUBE_NOTFIRED: usize = 14;
+pub const BIRTH_MINTS: usize = 15;
+pub const BIRTH_CROSS: usize = 16;
+pub const APPLY_INSERTS: usize = 17;
+/// `apply`-path inserts that were fired kicks (clock or tube).
+pub const APPLY_KICK: usize = 18;
+/// Kick mints whose key another live binding already held (the intern's hit).
+pub const CROSS_KICK: usize = 19;
+/// Non-kick rebind mints (handoffs, captures) whose key another live binding already held.
+pub const CROSS_OTHER: usize = 20;
+pub const RETUNE_MINTS: usize = 21;
+pub const HANDOFF_MINTS: usize = 22;
+static ON: AtomicBool = AtomicBool::new(false);
+static INIT: AtomicBool = AtomicBool::new(false);
+
+/// The intern key: what `crates/space`'s catalogue dedups by, plus the doll.
+type Key = (u16, bool, Scalar, Option<OrbitKey>);
+
+fn key_of(doll: u16, e: &Entry) -> Key {
+    (doll, e.clockwise, e.unit.mu, e.trajectory.key())
+}
+
+/// Live holders per intern key (`Some` only when the census is on).
+static SHADOW: Mutex<Option<HashMap<Key, u32>>> = Mutex::new(None);
+fn enter(doll: u16, e: &Entry) -> bool {
+    // Returns whether another live binding already held this key (the intern's hit).
+    // (No parking_lot in this tree; the guard is recovered, never unwrapped: nothing panics holding it.)
+    let mut g = SHADOW.lock().unwrap_or_else(|p| p.into_inner());
+    let Some(m) = g.as_mut() else { return false };
+    let k = key_of(doll, e);
+    let held = m.get(&k).copied().unwrap_or(0) > 0;
+    *m.entry(k).or_insert(0) += 1;
+    held
+}
+
+fn leave(doll: u16, e: &Entry) {
+    let mut g = SHADOW.lock().unwrap_or_else(|p| p.into_inner());
+    if let Some(m) = g.as_mut() {
+        let k = key_of(doll, e);
+        if let Some(n) = m.get_mut(&k) {
+            *n -= 1;
+            if *n == 0 {
+                m.remove(&k);
+            }
+        }
+    }
+}
+
+
+pub fn on() -> bool {
+    if !INIT.swap(true, Ordering::Relaxed) {
+        ON.store(std::env::var("ES_KICK_NEWS").is_ok(), Ordering::Relaxed);
+        if ON.load(Ordering::Relaxed) {
+            *SHADOW.lock().unwrap_or_else(|p| p.into_inner()) = Some(HashMap::new());
+        }
+    }
+    ON.load(Ordering::Relaxed)
+}
+
+/// Force the flag's initialisation before a scene is built, so birth mints are counted
+/// (`on()` alone is lazy: nothing calls it during genesis otherwise).
+pub fn warmup() {
+    let _ = on();
+}
+
+/// `true` when the two entries are the same compiled orbit for the catalogue's purposes
+/// (same key, same sense; the anchor in `Tube` is per-binding news either way).
+fn same_entry(old: &Entry, new: &Entry) -> Option<bool> {
+    match (old.trajectory.key(), new.trajectory.key()) {
+        (Some(a), Some(b)) => Some(a == b && old.clockwise == new.clockwise),
+        (None, None) => None, // a plunge carries no key; counted separately
+        _ => Some(false),
+    }
+}
+
+/// Census one fired kick's rebind: `old` is the standing binding's entry, `new` the
+/// re-fit's, `belt` whether the body sits in the belt's radial band.
+fn note(slot_fired: usize, slot_same: usize, slot_flip: usize, old: &Entry, new: &Entry, belt: bool) {
+    let _ = belt;
+    C[slot_fired].fetch_add(1, Ordering::Relaxed);
+    match same_entry(old, new) {
+        Some(true) => {
+            C[slot_same].fetch_add(1, Ordering::Relaxed);
+        }
+        Some(false) => {
+            C[slot_flip].fetch_add(1, Ordering::Relaxed);
+        }
+        None => {
+            C[CLOCK_PLUNGE].fetch_add(1, Ordering::Relaxed);
+        }
+    }
+}
+
+/// The clock path (`kick_clock`): doll-0 ships and the player; `belt` splits the band.
+pub fn kick_clock_entry(old: &Entry, new: &Entry, belt: bool) {
+    if !on() {
+        return;
+    }
+    if belt {
+        note(BELT_FIRED, BELT_SAME, BELT_FLIP, old, new, belt);
+    } else {
+        note(CLOCK_FIRED, CLOCK_SAME, CLOCK_FLIP, old, new, belt);
+    }
+}
+
+/// The tube path (`kick`): bodies of the deeper dolls.
+pub fn kick_tube_entry(old: &Entry, new: &Entry) {
+    if !on() {
+        return;
+    }
+    note(TUBE_FIRED, TUBE_SAME, TUBE_FLIP, old, new, false);
+}
+
+/// A planned kick that did not fire (its quantized dv is zero: the carry holds it).
+pub fn kick_carried(clock: bool) {
+    if on() {
+        C[if clock { CLOCK_NOTFIRED } else { TUBE_NOTFIRED }].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// A mint at a rebind applied by the universe (`Work::rebind`'s new entry): `kick` says which
+/// kind resolved it. The retired pre-rebind binding has already left the shadow, so a hit here
+/// is a key held by ANOTHER live body — the intern's exact question.
+pub fn apply_insert(kick: bool, doll: u16, e: &Entry) {
+    if !on() {
+        return;
+    }
+    C[APPLY_INSERTS].fetch_add(1, Ordering::Relaxed);
+    if kick {
+        C[APPLY_KICK].fetch_add(1, Ordering::Relaxed);
+        if enter(doll, e) {
+            C[CROSS_KICK].fetch_add(1, Ordering::Relaxed);
+        }
+    } else {
+        C[HANDOFF_MINTS].fetch_add(1, Ordering::Relaxed);
+        if enter(doll, e) {
+            C[CROSS_OTHER].fetch_add(1, Ordering::Relaxed);
+        }
+    }
+}
+
+/// The pre-rebind binding leaves the live-intern shadow (its slot is released by `apply`).
+pub fn retire(doll: u16, e: &Entry) {
+    if on() {
+        leave(doll, e);
+    }
+}
+
+/// A birth mint (`add_body` from a spec, `add_body_state` from a state, a fleet's program
+/// birth): no binding to replace; a hit is the co-orbital case efd4 priced standing.
+pub fn birth(doll: u16, e: &Entry) {
+    if !on() {
+        return;
+    }
+    C[BIRTH_MINTS].fetch_add(1, Ordering::Relaxed);
+    if enter(doll, e) {
+        C[BIRTH_CROSS].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// A retune mint (`add_doll` recompiles a host's tube about host+gm): replaces the old key.
+pub fn retune(doll: u16, e: &Entry) {
+    if !on() {
+        return;
+    }
+    C[RETUNE_MINTS].fetch_add(1, Ordering::Relaxed);
+    let _ = enter(doll, e);
+}
+
+pub fn cat_insert() {
+    if on() {
+        C[CAT_INSERTS].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+pub fn snapshot() -> [u64; 24] {
+    let mut out = [0u64; 24];
+    for (i, c) in C.iter().enumerate() {
+        out[i] = c.load(Ordering::Relaxed);
+    }
+    out
+}
+
+/// Distinct intern keys held by live bindings now (the intern's standing stock).
+pub fn shadow_keys() -> usize {
+    SHADOW.lock().unwrap_or_else(|p| p.into_inner()).as_ref().map_or(0, |m| m.len())
+}
+
+/// Instrument control: the comparison's `true` branch must be reachable (an entry equals
+/// itself). Counted once, on the first censused kick.
