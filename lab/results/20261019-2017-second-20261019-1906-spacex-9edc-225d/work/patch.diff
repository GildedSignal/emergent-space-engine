+++ b/crates/universe/examples/form_news.rs
@@ -0,0 +1,114 @@
+//! The co-orbital formation's mint census — the checker's named experiment for 9edc: efd4's
+//! 512-ship one-orbit formation (one exact (E, L), 512 phases), rebuilt to SURVIVE (ships at
+//! 1 AU, the 2^-10 planet at 0.39 AU: ~22 Hill radii clear, ~29 game-s synodic period beyond
+//! the window), flown with the kick-news census. What it measures that the record lacks:
+//! birth mints vs kick mints (efd4 priced the standing stock; the mint stream was never
+//! split), the self-comparison at each fired kick (9edc's census, now on the formation), and
+//! the shadow-intern cross-hit — a mint whose `(doll, mu, sense, OrbitKey)` another live
+//! binding already holds, the exact question a key-dedup insert asks. The dial is the
+//! shipped `Config::step_log2` (the Δs octave de7b flew; `ES_STEP_LOG2`, 7 = shipped): each
+//! octave coarsens Δs 2×, so each fired kick carries 2× the tide and the fleet's keys spread
+//! 2× wider per mint. Controls: `ES_SCATTER=1` (512 distinct orbits, the intern's null) and
+//! `ES_KICK_NEWS` unset (the census reads zero; the shipped path).
+//!
+//! cargo run --release -p emergent-universe --example form_news [-- <F> <game_s> <rtf>]
+use emergent_universe::news;
+use emergent_universe::scenario::{restricted_with, AU};
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::Budget;
+use std::collections::HashSet;
+use std::time::{Duration, Instant};
+
+/// Live bindings, distinct intern keys among them, and the catalogue's live slots (efd4's census).
+fn census(u: &emergent_universe::Universe) -> (usize, usize, usize) {
+    let mut keys = HashSet::new();
+    let mut plunges = 0usize;
+    let mut live = 0usize;
+    for i in 0..u.n_bodies() {
+        let rec = u.rec(i);
+        if !rec.alive {
+            continue;
+        }
+        live += 1;
+        if let Some(k) = rec.b.entry.trajectory.key() {
+            keys.insert((rec.b.doll, rec.b.entry.unit.mu, rec.b.entry.clockwise, k));
+        } else {
+            plunges += 1;
+        }
+    }
+    (live, keys.len() + plunges, u.catalogue_live())
+}
+
+fn line(tag: &str, u: &emergent_universe::Universe) {
+    let nk = news::snapshot();
+    let (live, distinct, standing) = census(u);
+    let ships = u.n_bodies().saturating_sub(2); // star is the doll centre, not a body: planet + F ships
+    println!(
+        "form: {tag} now={:.0}gs live={live} dead={} standing={standing} distinct={distinct} | fired={} same={} flip={} plunge={} notfired={} | birth={} birth_cross={} apply={} apply_kick={} cross_kick={} cross_other={} retune={} shadow_keys={} self_ok={}",
+        u.now as f64 * TICK_SECONDS,
+        u.n_bodies() - live,
+        nk[news::CLOCK_FIRED] + nk[news::BELT_FIRED] + nk[news::TUBE_FIRED],
+        nk[news::CLOCK_SAME] + nk[news::BELT_SAME] + nk[news::TUBE_SAME],
+        nk[news::CLOCK_FLIP] + nk[news::BELT_FLIP] + nk[news::TUBE_FLIP],
+        nk[news::CLOCK_PLUNGE],
+        nk[news::CLOCK_NOTFIRED] + nk[news::TUBE_NOTFIRED],
+        nk[news::BIRTH_MINTS], nk[news::BIRTH_CROSS], nk[news::APPLY_INSERTS], nk[news::APPLY_KICK],
+        nk[news::CROSS_KICK], nk[news::CROSS_OTHER], nk[news::RETUNE_MINTS], news::shadow_keys(), nk[news::SELF_OK],
+    );
+    let _ = ships;
+    let _ = (std::mem::size_of::<emergent_universe::bind::Binding>(), std::mem::size_of::<emergent_universe::bind::Entry>(), std::mem::size_of::<emergent_universe::body::Segment>());
+}
+
+fn main() {
+    let t0 = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let f: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(512);
+    let game_s: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(500_000.0);
+    let rtf: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(8_000.0);
+    let step_log2: i32 = std::env::var("ES_STEP_LOG2").ok().and_then(|s| s.parse().ok()).unwrap_or(7);
+    let scatter = std::env::var("ES_SCATTER").is_ok_and(|v| v != "0");
+    news::warmup();
+    // One circular orbit at 1 AU for the whole fleet (efd4's formation, kept clear of every
+    // surface), or F distinct orbits 2^-8.4 apart (the belt's shape) for the scatter control.
+    let ships: Vec<(i64, u32)> = (0..f as u32)
+        .map(|k| {
+            if scatter {
+                (AU as i64 + (k as i64) * 300_000, k * (u32::MAX / f as u32).max(1))
+            } else {
+                (AU, k * (u32::MAX / f as u32).max(1))
+            }
+        })
+        .collect();
+    let mut w = restricted_with(-10, 39_507_000, 47_400, &ships, 1, emergent_universe::Config { step_log2, ..Default::default() }).unwrap();
+    let build = t0.elapsed();
+    println!(
+        "form: scene f={f} scatter={scatter} step_log2={step_log2} game_s={game_s:.0} rtf={rtf} build={build:?} ({:.0} ns/ship) sizes binding={} entry={} segment={}",
+        build.as_nanos() as f64 / f as f64,
+        std::mem::size_of::<emergent_universe::bind::Binding>(),
+        std::mem::size_of::<emergent_universe::bind::Entry>(),
+        std::mem::size_of::<emergent_universe::body::Segment>()
+    );
+    line("genesis", &w.u);
+    let mut scans: Vec<f64> = [0.6f64, 1.6, 2.6].to_vec(); // just after the fleet's 1st, 2nd, 3rd kick crests
+    let cut = (game_s / TICK_SECONDS) as i64;
+    let interval = 32_970.0 * 2f64.powi(step_log2 - 7); // the planet's doll grid at this octave
+    scans.sort_by(|a, b| b.partial_cmp(a).unwrap());
+    let mut next = scans.pop();
+    while w.u.now < cut {
+        if t0.elapsed() > Duration::from_secs(50) {
+            println!("form: wall guard at {:.0} gs", w.u.now as f64 * TICK_SECONDS);
+            break;
+        }
+        let _ = w.u.frame_to(1.0 / 60.0, rtf, Budget::unlimited(), cut);
+        if let Some(s) = next.filter(|s| w.u.now as f64 * TICK_SECONDS >= s * interval) {
+            line(&format!("scan@{s:.1}iv"), &w.u);
+            next = scans.pop();
+        }
+    }
+    w.u.settle(cut);
+    line("end", &w.u);
+    println!(
+        "form: stats kicks={} boundaries={} handoffs={} lost={} refused={} digest={}",
+        w.u.stats.kicks, w.u.stats.boundaries, w.u.stats.handoffs, w.u.stats.lost, w.u.stats.refused, w.u.digest()
+    );
+}
