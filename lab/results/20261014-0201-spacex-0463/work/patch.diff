+// The census (a lab probe, `ES_CENSUS`): observation only, never a decision, so it cannot move a bit.
+static CENSUS: std::sync::Mutex<Vec<(Tick, usize, u8)>> = std::sync::Mutex::new(Vec::new());
+static CENSUS_ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("ES_CENSUS").is_ok());
+fn census_on() -> bool {
+    *CENSUS_ON
+}
+/// The resolved items' `(tick, body, kind)` as they were applied, taken and cleared by a lab probe (`ES_CENSUS`).
+pub fn take_census() -> Vec<(Tick, usize, u8)> {
+    std::mem::take(&mut *CENSUS.lock().unwrap_or_else(|e| e.into_inner()))
+}
