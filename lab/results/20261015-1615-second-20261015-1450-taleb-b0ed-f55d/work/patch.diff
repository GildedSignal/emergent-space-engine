+
+fn note_promotion(took: std::time::Duration) {
+    use std::sync::atomic::Ordering::Relaxed;
+    PROMOTIONS.fetch_add(1, Relaxed);
+    PROMOTION_NS.fetch_add(took.as_nanos() as u64, Relaxed);
+    let ns = u32::try_from(took.as_nanos()).unwrap_or(u32::MAX);
+    if let Ok(mut g) = SAMPLES.lock() {
+        if g.len() < 5_000_000 {
+            g.push(ns);
+        }
+    }
