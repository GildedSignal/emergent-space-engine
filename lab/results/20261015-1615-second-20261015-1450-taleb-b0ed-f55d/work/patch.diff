+/// The seam behind `ES_LAZY_ENTRY` (off by default; the plane is shipped verbatim): a binding's
+/// compiled trajectory is a cache of the exact key it was compiled from (PRINCIPLES 6: store the
+/// generator, not the generated), so a kick-settled binding may hold only the key and re-mint the
+/// entry on touch. [`EntrySlot::Live`] is the shipped state; [`EntrySlot::Demoted`] holds the
+/// exact key, the sense and the unit, and never took a catalogue slot (`tube.key` is `u32::MAX`,
+/// which [`Catalogue::release`] ignores).
+#[derive(Clone, Debug)]
+pub enum EntrySlot {
+    Live(Arc<Entry>),
+    /// The compiled trajectory is gone (with its catalogue slot): the exact key, sense and unit.
+    /// `cache` is the retention rule (`ES_RETAIN=1`): the first read after the kick mints the
+    /// entry and keeps it here; reads until the next kick hit the cache; the next kick's settle
+    /// drops the whole slot (a fresh `Demoted`), so the minted entry lives exactly one kick
+    /// interval. It is cloned cold (a clone is a fresh demotion) and never holds the compiled
+    /// trajectory when retention is off.
+    Demoted { key: OrbitKey, clockwise: bool, unit: Unit, cache: RetainCache },
+}
+
+/// The demoted slot's retained entry (see [`EntrySlot::Demoted`]). The cache is shared by
+/// every clone of the slot (the store's `get` clones records), so a mint by any reader is
+/// seen by the next reader until the binding's next kick settles a fresh (cold) slot. The
+/// count of live retained entries is `retain_counters().1` (distinct caches, not copies).
+#[derive(Default)]
+pub struct RetainCache(std::sync::Arc<RetainInner>);
+
+/// `filled` guards kick-anchored admission (`ES_RETAIN_ONCE=1`): only the first fill of a
+/// kick interval registers with the ring, so eviction pressure never exceeds the demotion
+/// rate (a miss after eviction compiles and drops instead of re-filling).
+struct RetainInner(std::sync::Mutex<Option<Arc<Entry>>>, std::sync::atomic::AtomicBool);
+
+impl Default for RetainInner {
+    fn default() -> Self {
+        RetainInner(std::sync::Mutex::new(None), std::sync::atomic::AtomicBool::new(false))
+    }
+}
+
+impl Clone for RetainCache {
+    fn clone(&self) -> Self {
+        RetainCache(std::sync::Arc::clone(&self.0))
+    }
+}
+
+impl std::fmt::Debug for RetainCache {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("RetainCache")
+    }
+}
+
+impl Drop for RetainCache {
+    fn drop(&mut self) {
+        // Only the last copy of a filled cache counts as one retained entry dropped.
+        if std::sync::Arc::strong_count(&self.0) == 1
+            && self.0.0.lock().unwrap_or_else(|e| e.into_inner()).take().is_some()
+        {
+            RETAINED_NOW.fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+}
+
+impl EntrySlot {
+    /// The entry, re-minted from the key when demoted (one pure `Orbit::compile`: a promotion).
+    #[track_caller]
+    pub fn entry(&self) -> Res<Arc<Entry>> {
+        let who = std::panic::Location::caller();
+        match self {
+            EntrySlot::Live(e) => Ok(e.clone()),
+            EntrySlot::Demoted { key, clockwise, unit, cache } => {
+                // The retention rule (`ES_RETAIN=1`, the record's named fix): the first read of
+                // this kick interval mints and keeps; the rest hit the cache; the next kick's
+                // settle drops the slot (with the cache). Off: as flown in the record (mint per
+                if retain_on() {
+                    let mut g = cache.0.0.lock().unwrap_or_else(|e| e.into_inner());
+                    if let Some(e) = g.as_ref() {
+                        RETAIN_HITS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                        note_hit_who(who);
+                        return Ok(e.clone());
+                    }
+                    // Kick-anchored admission (`ES_RETAIN_ONCE=1`): a miss after this interval's
+                    // first fill was evicted compiles and drops instead of re-filling, so the
+                    // ring's eviction pressure never exceeds the demotion rate.
+                    if retain_once() && cache.0.1.swap(true, std::sync::atomic::Ordering::AcqRel) {
+                        drop(g);
+                        let t0 = std::time::Instant::now();
+                        let orbit = Orbit::compile(*key)?;
+                        let e = Arc::new(Entry { trajectory: Trajectory::Cycle(orbit), clockwise: *clockwise, unit: *unit });
+                        note_promotion(t0.elapsed());
+                        note_mint_who(who);
+                        return Ok(e);
+                    }
+                    let t0 = std::time::Instant::now();
+                    let orbit = Orbit::compile(*key)?;
+                    let e = Arc::new(Entry { trajectory: Trajectory::Cycle(orbit), clockwise: *clockwise, unit: *unit });
+                    note_promotion(t0.elapsed());
+                    note_mint_who(who);
+                    RETAINED_NOW.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                    *g = Some(e.clone());
+                    drop(g);
+                    retain_register(cache);
+                    return Ok(e);
+                }
+                let t0 = std::time::Instant::now();
+                let orbit = Orbit::compile(*key)?;
+                let e = Arc::new(Entry { trajectory: Trajectory::Cycle(orbit), clockwise: *clockwise, unit: *unit });
+                note_promotion(t0.elapsed());
+                note_mint_who(who);
+                Ok(e)
+            }
+        }
+    }
+    /// The doll-mass unit of the entry, without minting anything.
+    pub fn unit(&self) -> Unit {
+        match self { EntrySlot::Live(e) => e.unit, EntrySlot::Demoted { unit, .. } => *unit }
+    }
+    /// The trajectory's exact key if it has one (a demoted slot is its key), without minting.
+    pub fn key(&self) -> Option<OrbitKey> {
+        match self {
+            EntrySlot::Live(e) => e.trajectory.key(),
+            EntrySlot::Demoted { key, .. } => Some(*key),
+        }
+    }
+    pub fn is_cycle(&self) -> bool {
+        match self { EntrySlot::Live(e) => matches!(e.trajectory, Trajectory::Cycle(_)), EntrySlot::Demoted { .. } => true }
+    }
+}
