+/// Demotions and promotions since start: counts, total compile ns, p50/p99/max in ns (0 when none).
+pub fn lazy_counters() -> (u64, u64, u64, u32, u32, u32) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let Ok(s) = SAMPLES.lock() else { return (0, 0, 0, 0, 0, 0) };
+    let mut s = s.clone();
+    s.sort_unstable();
+    let q = |p: f64| s.get(((s.len().max(1) - 1) as f64 * p).round() as usize).copied().unwrap_or(0);
+    (
+        DEMOTIONS.load(Relaxed),
+        PROMOTIONS.load(Relaxed),
+        PROMOTION_NS.load(Relaxed),
+        q(0.5),
+        q(0.99),
+        s.last().copied().unwrap_or(0),
+    )
+}
