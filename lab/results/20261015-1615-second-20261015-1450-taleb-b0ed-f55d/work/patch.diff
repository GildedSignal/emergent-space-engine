+/// The bounded rule (`ES_RETAIN_MAX=<entries>`, with `ES_RETAIN=1`): the retained set is
+/// capped FIFO — a fill past the cap evicts the oldest mint. Unset/0 = the unbounded rule,
+/// verbatim. FIFO is an upper bound on re-mints against any recency-aware policy, so a
+/// pass here bounds adoption from above.
+fn retain_max() -> usize {
+    static MAX: std::sync::LazyLock<usize> = std::sync::LazyLock::new(|| {
+        std::env::var("ES_RETAIN_MAX").ok().and_then(|v| v.parse().ok()).unwrap_or(0)
+    });
+    *MAX
+}
+
+static RETAIN_RING: std::sync::LazyLock<std::sync::Mutex<std::collections::VecDeque<RetainCache>>> =
+    std::sync::LazyLock::new(|| std::sync::Mutex::new(std::collections::VecDeque::new()));
+static RETAIN_EVICT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Register one filled cache with the bounded rule, evicting oldest fills past the cap
+/// (stale empties drain first). Called with no slot lock held, so the only lock order is
+/// ring → inner; nobody takes the ring while holding an inner. Eviction takes the inner
+/// itself, so the ring's copy later drops empty and the `Drop` accounting stays exact.
+fn retain_register(cache: &RetainCache) {
+    let cap = retain_max();
+    if cap == 0 {
+        return;
+    }
+    let Ok(mut ring) = RETAIN_RING.lock() else { return };
+    ring.push_back(RetainCache::clone(cache));
+    while ring.len() > cap {
+        match ring.pop_front() {
+            Some(old) => {
+                if old.0.0.lock().unwrap_or_else(|e| e.into_inner()).take().is_some() {
+                    RETAINED_NOW.fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
+                    RETAIN_EVICT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                }
+            }
+            None => break,
+        }
+    }
+}
+
+/// The bounded rule's counters: (evictions of live fills, the cap; 0 = unbounded).
+pub fn retain_bound_counters() -> (u64, usize) {
+    (RETAIN_EVICT.load(std::sync::atomic::Ordering::Relaxed), retain_max())
+}
