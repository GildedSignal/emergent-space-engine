+    /// (lab 20261016-0023-scout-1652) The history stack against the prune's own light-cone window:
+    /// for every body holding retained history, `(index, alive, history_len, the age of the newest
+    /// retired binding past the current binding's birth, the keep window `2·light distance + 2²⁶`,
+    /// `bytes_of`), all in ticks where dimensional.
+    pub fn history_window(&self) -> Vec<(usize, bool, usize, i128, i128, usize)> {
+        (0..self.bodies.len())
+            .filter(|&i| self.bodies.history_len(i) > 0)
+            .map(|i| {
+                let age = (self.now as i128 - self.bodies.rec(i).b.event_time as i128).max(0);
+                let keep = 2 * self.light_distance(i) as i128 + (1 << 26);
+                (i, self.bodies.rec(i).alive, self.bodies.history_len(i), age, keep, self.bodies.bytes_of(i))
+            })
+            .collect()
+    }
+
+    /// (lab 20261016-0023-scout-1652) The retired-read instrument: `(serves, deepest past read into
+    /// a retired era, ticks)`, cumulative since process start.
+    pub fn retired_reads(&self) -> (u64, i128) {
+        use std::sync::atomic::Ordering;
+        (crate::body::RETIRED_SERVES.load(Ordering::Relaxed), crate::body::RETIRED_MAX_DEPTH.load(Ordering::Relaxed) as i128)
+    }
+
+    /// (lab 20261016-0023-scout-1652) The oldest segment age ever served (`now − until`, ticks), and
+    /// sets the reader's `now` for the instrument (`i64::MIN` disables).
+    pub fn retired_age_at_serve(&self) -> i128 {
+        crate::body::RETIRED_MAX_AGE_AT_SERVE.load(std::sync::atomic::Ordering::Relaxed) as i128
+    }
+
+    pub fn set_reader_now(&self, on: bool) {
+        crate::body::READER_NOW.store(if on { self.now } else { i64::MIN }, std::sync::atomic::Ordering::Relaxed);
+    }
