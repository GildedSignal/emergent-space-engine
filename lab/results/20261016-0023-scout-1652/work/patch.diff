+//! (lab 20261016-0023-scout-1652) The history stack against its own light-cone window.
+//!
+//! The ladder belt scene (`scenario::plane_extra`), flown past the first kick wave (13,051–14,534
+//! game-s). At each cut, every body holding retained history is censused: the age of its newest
+//! retired binding against the prune's own keep window (`2·light distance + 2²⁶` ticks) — the
+//! window that already certifies a binding forgettable for every segment but the last — plus the
+//! retired-read instrument (how deep any read ever went into a retired era).
+//!
+//! cargo run --release -p emergent-universe --example history_window [-- <N> <rtf> <cut game-s>...]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn rss_mb() -> f64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines()
+                .find(|l| l.starts_with("VmRSS:"))
+                .and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<f64>().ok()))
+        })
+        .map(|kb| kb / 1024.0)
+        .unwrap_or(0.0)
+}
+
+fn pct(v: &[f64], q: f64) -> f64 {
+    if v.is_empty() {
+        0.0
+    } else {
+        v[((v.len() - 1) as f64 * q).round() as usize]
+    }
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(10_000);
+    let rtf: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(1_500.0);
+    let mut cuts: Vec<f64> = args[3..].iter().filter_map(|s| s.parse().ok()).collect();
+    if cuts.is_empty() {
+        cuts = vec![15_000.0, 20_000.0, 32_000.0, 48_000.0];
+    }
+    cuts.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let bodies = p.u.n_bodies();
+    println!("scene: {bodies} bodies (N={n}), rtf {rtf}, cuts {:?} game-s, rss {:.0} MB after build", cuts, rss_mb());
+    // A warmup half second (the fleet's opening exodus), like the ladder's stats window.
+    for _ in 0..30 {
+        let _ = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(Instant::now() + Duration::from_millis(50)) }, i64::MAX);
+    }
+    let t0 = p.u.now;
+    let mut next = 0usize;
+    loop {
+        if t_start.elapsed() > Duration::from_secs(55) {
+            println!("TRUNCATED");
+            break;
+        }
+        let game_s = (p.u.now - t0) as f64 * TICK_SECONDS;
+        while next < cuts.len() && game_s >= cuts[next] {
+            let rows = p.u.history_window();
+            let (serves, depth) = p.u.retired_reads();
+            let with = rows.len();
+            let total_segs: usize = rows.iter().map(|r| r.2).sum();
+            let in_win = rows.iter().filter(|r| r.3 <= r.4).count();
+            let pinned = rows.iter().filter(|r| r.3 > r.4).count();
+            let dead_with = rows.iter().filter(|r| !r.1).count();
+            let multi = rows.iter().filter(|r| r.2 > 1).count();
+            let bytes_with: usize = rows.iter().map(|r| r.5).sum();
+            let mut ages: Vec<f64> = rows.iter().map(|r| r.3 as f64 * TICK_SECONDS).collect();
+            ages.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            let mut keeps: Vec<f64> = rows.iter().map(|r| r.4 as f64 * TICK_SECONDS).collect();
+            keeps.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            // The view is the one real reader of the past: one cold gather before the census, so
+            // the read instrument sees the page's own retarded reads at this cut.
+            let (serves0, depth0) = p.u.retired_reads();
+            p.u.set_reader_now(true);
+            let tg = Instant::now();
+            let mut cache = emergent_universe::view::ViewCache::default();
+            let seen = emergent_universe::view::gather_cached(&p.u, &p.names, &mut cache).map_or(0, |v| v.seen.len());
+            let view_ms = tg.elapsed().as_secs_f64() * 1e3;
+            let (serves, depth) = p.u.retired_reads();
+            let age_at_serve_s = p.u.retired_age_at_serve() as f64 * TICK_SECONDS;
+            println!(
+                "cut game_s={:.0} bodies={} with_hist={} ({:.3}/body; segs {:.3}/body; len>1 {}) dead_with={} | IN_WINDOW {} ({:.1}%) PINNED_PAST {} ({:.1}%) | age_s p50={:.0} p90={:.0} max={:.0} | keep_s min={:.0} p50={:.0} max={:.0} | bytes_of(hist bodies)={:.0} B each, whole-store {} B/body | retired_serves {}->{} max_depth_s {:.1}->{:.1} (view {:.0} ms, {} seen) | rss {:.0} MB",
+                game_s, bodies, with, with as f64 / bodies as f64, total_segs as f64 / bodies as f64, multi, dead_with,
+                in_win, 100.0 * in_win as f64 / with.max(1) as f64,
+                pinned, 100.0 * pinned as f64 / with.max(1) as f64,
+                pct(&ages, 0.5), pct(&ages, 0.9), ages.last().copied().unwrap_or(0.0),
+                pct(&keeps, 0.0), pct(&keeps, 0.5), keeps.last().copied().unwrap_or(0.0),
+                bytes_with as f64 / with.max(1) as f64, p.u.bytes_per_body(),
+                serves0, serves, depth0 as f64 * TICK_SECONDS, depth as f64 * TICK_SECONDS, view_ms, seen, rss_mb(),
+            );
+            println!("   serve_ages: max age-at-serve {:.1} s (against keep min/p50/max above)", age_at_serve_s);
+            next += 1;
+        }
+        if next >= cuts.len() {
+            break;
+        }
+        let _ = p.u.frame_to(1.0 / 30.0, rtf, Budget { events: u64::MAX, until: Some(Instant::now() + Duration::from_millis(50)) }, i64::MAX);
+    }
+    let (serves, depth) = p.u.retired_reads();
+    println!("end: retired_serves={} max_depth_s={:.1} wall {:.1} s", serves, depth as f64 * TICK_SECONDS, t_start.elapsed().as_secs_f64());
+}
