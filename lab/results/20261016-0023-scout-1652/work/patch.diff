+/// (lab 20261016-0023-scout-1652) Read instrument: how many retired-segment serves happened, and
+/// the deepest past read ever served (`until − t`, ticks). Relaxed order: a census, not a law.
+pub static RETIRED_SERVES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static RETIRED_MAX_DEPTH: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(0);
+/// The reader's `now` while gathering (set by the instrument), and the oldest segment age at serve.
+pub static READER_NOW: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(i64::MIN);
+pub static RETIRED_MAX_AGE_AT_SERVE: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(0);
