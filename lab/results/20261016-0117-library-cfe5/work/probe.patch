+//! The birth plan pass's probe (lab 20261016-0117): how `Universe::start`'s replan pass is
+//! spent, and what a birth-only hoist of `Ctx::secondaries` (exact inside `start`, where no
+//! binding changes) deletes from it. Eight flights: N in {10^4, 10^5} x seeds {1, 7} x hoist
+//! {off, on}, each printing the pass's meters and the universe digest (identical across the
+//! hoist arms: the memo returns byte-identical states).
+//!
+//! cargo build --release -p emergent-universe --example sec_probe
+//! ES_BIRTH_SPLIT=1 ES_SEC_HOIST=0 <target>/release/examples/sec_probe 10000 1
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::universe::secprof;
+use emergent_universe::Config;
+
+fn main() {
+    let n: usize = std::env::args().nth(1).unwrap().parse().unwrap();
+    let seed: u64 = std::env::args().nth(2).unwrap().parse().unwrap();
+    let t0 = std::time::Instant::now();
+    let p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed();
+    let bodies = p.u.n_bodies();
+    println!(
+        "n {} seed {} bodies {} build_s {:.1} {}",
+        n,
+        seed,
+        bodies,
+        build.as_secs_f64(),
+        secprof::report(bodies, &p.u.digest())
+    );
+}
