+
+// ---- the birth pass's probe (lab 20261016-0117) --------------------------------------------------
+
+/// Thread-local meters for `Universe::start`'s replan pass (the birth plan pass), read by
+/// `examples/sec_probe`: the pass itself, the `Ctx::secondaries` reads inside it (time, calls,
+/// and the hoist's memo), `plan_terminal` and `project`. The hoist memo is exact only inside
+/// `start`, where no binding changes: it is armed there (when `ES_SEC_HOIST` says so) and
+/// disarmed on the way out, and its key normalises `except` to a source of the doll or none.
+pub mod secprof {
+    use crate::force::Secondary;
+    use crate::num::Tick;
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    use std::rc::Rc;
+    use std::time::Duration;
+
+    /// The meters of one flight (the probe is single-threaded: the plane is built on one thread).
+    #[derive(Default)]
+    pub struct Meters {
+        pub pass: Duration,
+        pub sec: Duration,
+        pub sec_calls: u64,
+        pub term: Duration,
+        pub term_calls: u64,
+        pub proj: Duration,
+        pub proj_calls: u64,
+        armed: bool,
+        keys: u64,
+        memo: RefCell<HashMap<(u16, Tick, usize), Rc<Vec<Secondary>>>>,
+    }
+
+    thread_local! {
+        static M: RefCell<Meters> = RefCell::new(Meters::default());
+    }
+
+    fn with<R>(f: impl FnOnce(&mut Meters) -> R) -> R {
+        M.with(|m| f(&mut m.borrow_mut()))
+    }
+
+    /// Arm (or disarm) the hoist for the pass about to run; arming resets its memo and key count,
+    /// disarming only empties the memo (the count is read after the pass).
+    pub fn arm_hoist(on: bool) {
+        with(|m| {
+            m.armed = on && std::env::var("ES_SEC_HOIST").is_ok_and(|v| v != "0");
+            m.memo.get_mut().clear();
+            if on {
+                m.keys = 0;
+            }
+        });
+    }
+
+    pub fn armed() -> bool {
+        with(|m| m.armed)
+    }
+
+    pub fn memo_get(d: u16, t: Tick, norm: usize) -> Option<Rc<Vec<Secondary>>> {
+        with(|m| m.memo.get_mut().get(&(d, t, norm)).cloned())
+    }
+
+    pub fn memo_put(d: u16, t: Tick, norm: usize, v: Vec<Secondary>) {
+        with(|m| {
+            let Meters { memo, keys, .. } = m;
+            let map = memo.get_mut();
+            if !map.contains_key(&(d, t, norm)) {
+                *keys += 1;
+                map.insert((d, t, norm), Rc::new(v));
+            }
+        });
+    }
+
+    pub fn add_pass(d: Duration) {
+        with(|m| m.pass += d);
+    }
+    pub fn add_sec(d: Duration) {
+        with(|m| {
+            m.sec += d;
+            m.sec_calls += 1;
+        });
+    }
+    pub fn add_term(d: Duration) {
+        with(|m| {
+            m.term += d;
+            m.term_calls += 1;
+        });
+    }
+    pub fn add_proj(d: Duration) {
+        with(|m| {
+            m.proj += d;
+            m.proj_calls += 1;
+        });
+    }
+
+    /// One flight's meters as a line (µs per body against `bodies`, the digest at the end).
+    pub fn report(bodies: usize, digest: &str) -> String {
+        with(|m| {
+            let us = |d: Duration| d.as_secs_f64() * 1e6 / bodies as f64;
+            format!(
+                "pass_us_per_body {:.2} sec_us_per_body {:.2} sec_share_pct {:.1} \
+                 term_us_per_body {:.3} proj_us_per_body {:.2} sec_calls {} term_calls {} \
+                 proj_calls {} memo_keys {} digest {}",
+                us(m.pass),
+                us(m.sec),
+                100.0 * m.sec.as_secs_f64() / m.pass.as_secs_f64(),
+                us(m.term),
+                us(m.proj),
+                m.sec_calls,
+                m.term_calls,
+                m.proj_calls,
+                m.keys,
+                digest
+            )
+        })
+    }
+}
