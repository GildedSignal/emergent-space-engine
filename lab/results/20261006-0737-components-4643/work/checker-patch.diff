+//! Dormancy experiment (components lens, run 20261006-0737): a pair's next in-window passage as a
+//! calendar wake, exact checks only when the wake fires, re-derivation (not re-enumeration) on a
+//! kick. `split` accounts one re-certification's work by passage recency; `stream` runs a Poisson
+//! kick stream and compares eager full-horizon enumeration against deferred wakes, per segment.
+
+use emergent_encounters::belt::{make_belt, Spec};
+use emergent_encounters::dioph::first_hit;
+use emergent_encounters::kepler::{Body, TICKS};
+use emergent_encounters::method::{pair_events, Stats};
+use emergent_encounters::pairs::{check, eps_u, is_candidate, sections, Kind, Section, Sorted};
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::f64::consts::{PI, TAU};
+use std::time::Instant;
+
+const SAFETY: f64 = 1.1;
+
+fn spec(name: &str, n: usize, sigma_e: f64, rho: f64, seed: u64) -> Spec {
+    Spec { name: name.into(), n, sigma_e, rho, a_lo: 1.0, a_hi: 1.5, keys: 0, seed, orbits: 0.0 }
+}
+
+fn ticks_up(x: f64) -> i64 {
+    (x * TICKS).ceil() as i64
+}
+
+struct Prep {
+    base: i128,
+    c0: i128,
+    d: i128,
+    w1: i128,
+    w: i128,
+    pi: i128,
+    pj: i128,
+}
+
+fn prep(bi: &Body, bj: &Body, sec: &Section, t0: f64) -> Prep {
+    let ti = sec.ti as i128;
+    let tj = sec.tj as i128;
+    let pi = bi.period as i128;
+    let pj = bj.period as i128;
+    let ext = ((sec.dj.0.max(sec.dj.1) + sec.di.0.max(sec.di.1)) * TICKS) as i128 + pj;
+    let t0t = (t0 * TICKS) as i128;
+    let base = tj + (t0t - ext - tj).div_euclid(pj) * pj;
+    let w1 = sec.w1 as i128;
+    let w = (w1 + sec.w2 as i128).clamp(0, pi - 1);
+    let c0 = (ti - base + w1).rem_euclid(pi);
+    let d = (pi - pj.rem_euclid(pi)).rem_euclid(pi);
+    Prep { base, c0, d, w1, w, pi, pj }
+}
+
+/// First in-window passage at or after ~t0: (qsteps, passage tick, l).
+fn wake_first(p: &Prep) -> (u64, Option<(i128, i128)>) {
+    let mut q = 0u64;
+    match first_hit(p.c0 as u128, p.d as u128, p.pi as u128, 0, p.w as u128, &mut q) {
+        None => (q, None),
+        Some(k) => {
+            let l = k as i128;
+            (q, Some((p.base + l * p.pj, l)))
+        }
+    }
+}
+
+/// Walk passages while tick <= t1t, invoking f(s, tick); returns qsteps.
+fn walk<F: FnMut(f64, i128)>(p: &Prep, t1t: i128, mut f: F) -> u64 {
+    let mut q = 0u64;
+    let mut l: i128 = 0;
+    loop {
+        let c = (p.c0 - l * p.pj).rem_euclid(p.pi);
+        let k = match first_hit(c as u128, p.d as u128, p.pi as u128, 0, p.w as u128, &mut q) {
+            None => break,
+            Some(k) => k as i128,
+        };
+        l += k;
+        if p.base + l * p.pj > t1t {
+            break;
+        }
+        let s = ((p.c0 - l * p.pj).rem_euclid(p.pi) - p.w1) as f64 / TICKS;
+        f(s, p.base + l * p.pj);
+        l += 1;
+    }
+    q
+}
+
+/// Analytic cap sections: the arc-duration window, zero exact evaluations at setup.
+fn cap_sections(bi: &Body, bj: &Body, rho: f64) -> (Vec<Section>, bool) {
+    let (a, b) = (bi.binet(), bj.binet());
+    let du = a[0] - b[0];
+    let dv = a[1] - b[1];
+    let dw = a[2] - b[2];
+    let r = dv.hypot(dw);
+    let eps = eps_u(bi, bj, rho);
+    if du.abs() - r >= eps {
+        return (Vec::new(), false);
+    }
+    if r < 1e-300 {
+        return (Vec::new(), true); // Full pair: skipped in the analytic variant
+    }
+    let th0 = dw.atan2(dv);
+    let c_lo = (-eps - du) / r;
+    let c_hi = (eps - du) / r;
+    let phi1 = c_hi.min(1.0).acos();
+    let phi2 = c_lo.max(-1.0).acos();
+    let arcs = if c_hi >= 1.0 && c_lo <= -1.0 {
+        return (Vec::new(), true);
+    } else if c_hi >= 1.0 {
+        vec![(th0, phi2, phi2)]
+    } else if c_lo <= -1.0 {
+        vec![(th0 + PI, PI - phi1, PI - phi1)]
+    } else {
+        let phx = (-du / r).clamp(-1.0, 1.0).acos();
+        vec![(th0 + phx, phx - phi1, phi2 - phx), (th0 - phx, phi2 - phx, phx - phi1)]
+    };
+    let out = arcs
+        .into_iter()
+        .map(|(c, dm, dp)| {
+            let th = c.rem_euclid(TAU);
+            let di = (bi.travel(th - dm, th), bi.travel(th, th + dp));
+            let dj = (bj.travel(th - dm, th), bj.travel(th, th + dp));
+            let cap = (dj.0 + di.1, dj.1 + di.0);
+            Section {
+                kind: Kind::Wide,
+                theta: th,
+                ti: bi.passage_tick(th),
+                tj: bj.passage_tick(th),
+                w1: ticks_up(cap.0),
+                w2: ticks_up(cap.1),
+                di,
+                dj,
+            }
+        })
+        .collect();
+    (out, false)
+}
+
+fn kicked_body(old: &Body, eps: f64, tk: f64) -> Body {
+    let lam_k = old.mean_anomaly(tk) + old.pom;
+    let a_new = old.a * (1.0 + eps);
+    let n_new = a_new.powf(-1.5);
+    Body::new(a_new, old.e, old.pom, lam_k - n_new * tk)
+}
+
+fn qtile(mut v: Vec<f64>, f: f64) -> f64 {
+    v.sort_by(|x, y| x.total_cmp(y));
+    v[((v.len() as f64 - 1.0) * f) as usize]
+}
+
+/// Exp 1: one re-certification's work, split by passage recency.
+fn split(n: usize, sigma: f64, rho: f64) {
+    let sp = spec("dormant", n, sigma, rho, 20261050);
+    let b = make_belt(&sp);
+    let sorted = Sorted::new(&b, sp.rho);
+    let t0 = 10.0 * TAU;
+    let horizon = 1000.0 * TAU;
+    let nk = 100;
+    let eps = 1e-5;
+    let kicked: Vec<usize> = (0..nk).map(|q| (q * 97 + 13) % sp.n).collect();
+    let (mut pairs, mut e_setup, mut q_wake, mut q_all) = (0u64, 0u64, 0u64, 0u64);
+    let mut e_check = [0u64; 4];
+    let mut props = [0u64; 4];
+    let mut wakes: Vec<f64> = Vec::new();
+    let (mut cap_props, mut cap_q, mut full_pairs) = (0u64, 0u64, 0u64);
+    let mut cap_wakes: Vec<f64> = Vec::new();
+    let mut us_eager = 0.0f64;
+    let mut us_wake = 0.0f64;
+    for &i in &kicked {
+        let new = kicked_body(&b[i], eps, t0);
+        let (lo, hi) = sorted.range(new.binet()[0], sorted.reach(&new));
+        for &(_, j) in &sorted.order[lo..hi] {
+            if j as usize == i || !is_candidate(&new, &b[j as usize], sp.rho) {
+                continue;
+            }
+            pairs += 1;
+            let bj = &b[j as usize];
+            let t = Instant::now();
+            let mut e0 = 0u64;
+            let secs = sections(&new, bj, sp.rho, SAFETY, &mut e0);
+            e_setup += e0;
+            for sec in &secs {
+                let p = prep(&new, bj, sec, t0);
+                let (q, w) = wake_first(&p);
+                q_wake += q;
+                if let Some((tick, _)) = w {
+                    wakes.push((tick as f64 - t0 * TICKS) / TICKS / TAU);
+                }
+                let t1t = ((t0 + horizon) * TICKS) as i128;
+                q_all += walk(&p, t1t, |s, tick| {
+                    let orbits = (tick as f64 - t0 * TICKS) / TICKS / TAU;
+                    let bkt = if orbits < 1.0 {
+                        0
+                    } else if orbits < 10.0 {
+                        1
+                    } else if orbits < 100.0 {
+                        2
+                    } else {
+                        3
+                    };
+                    props[bkt] += 1;
+                    let mut found = Vec::new();
+                    let mut e = 0u64;
+                    check(&new, bj, sec, tick as f64 / TICKS, s, sp.rho, &mut found, &mut e);
+                    e_check[bkt] += e;
+                });
+            }
+            us_eager += t.elapsed().as_secs_f64() * 1e6;
+            let t = Instant::now();
+            for sec in &secs {
+                let p = prep(&new, bj, sec, t0);
+                let _ = wake_first(&p);
+            }
+            us_wake += t.elapsed().as_secs_f64() * 1e6;
+            let (caps, full) = cap_sections(&new, bj, sp.rho);
+            full_pairs += full as u64;
+            for sec in &caps {
+                let p = prep(&new, bj, sec, t0);
+                let (q, w) = wake_first(&p);
+                cap_q += q;
+                if let Some((tick, _)) = w {
+                    cap_wakes.push((tick as f64 - t0 * TICKS) / TICKS / TAU);
+                }
+                let t1t = ((t0 + horizon) * TICKS) as i128;
+                cap_props += walk(&p, t1t, |_s, _tick| ());
+            }
+        }
+    }
+    let sum = e_check.iter().sum::<u64>();
+    println!(
+        "{{\"exp\":\"dormant-split\",\"n\":{},\"sigma_e\":{},\"rho\":{},\"eps\":{:e},\"kicked\":{},\"pairs\":{},\"e_setup\":{},\"e_check_total\":{},\"e_check_lt1\":{},\"e_check_lt10\":{},\"e_check_lt100\":{},\"e_check_ge100\":{},\"props_total\":{},\"props_ge100\":{},\"q_wake\":{},\"q_all\":{},\"wake_orbits_p50\":{:.1},\"wake_orbits_p90\":{:.1},\"wake_gt10_frac\":{:.3},\"wake_gt100_frac\":{:.3},\"cap_props\":{},\"cap_q\":{},\"cap_wake_gt10_frac\":{:.3},\"full_pairs\":{},\"us_eager_per_kick\":{:.0},\"us_wake_path_per_kick\":{:.0}}}",
+        sp.n, sp.sigma_e, sp.rho, eps, nk, pairs, e_setup, sum, e_check[0], e_check[1], e_check[2], e_check[3],
+        props.iter().sum::<u64>(), props[3], q_wake, q_all,
+        qtile(wakes.clone(), 0.5), qtile(wakes.clone(), 0.9),
+        wakes.iter().filter(|x| **x > 10.0).count() as f64 / wakes.len().max(1) as f64,
+        wakes.iter().filter(|x| **x > 100.0).count() as f64 / wakes.len().max(1) as f64,
+        cap_props, cap_q,
+        cap_wakes.iter().filter(|x| **x > 10.0).count() as f64 / cap_wakes.len().max(1) as f64,
+        full_pairs, us_eager / nk as f64, us_wake / nk as f64
+    );
+}
+
+struct SplitMix(u64);
+impl SplitMix {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);
+        z ^ (z >> 31)
+    }
+    fn unit(&mut self) -> f64 {
+        (self.next() >> 11) as f64 / (1u64 << 53) as f64
+    }
+}
+
+type Evs = HashSet<(u32, u32, u64)>;
+
+/// Exp 2: a Poisson kick stream; eager full-horizon enumeration vs deferred wakes.
+fn stream(n: usize, sigma: f64, rho: f64, tau: f64, t_end: f64, seed: u64) {
+    let sp = spec("dormant-stream", n, sigma, rho, seed);
+    let b0 = make_belt(&sp);
+    let sorted = Sorted::new(&b0, sp.rho);
+    let horizon = 1000.0 * TAU;
+    let mut rng = SplitMix(seed ^ 0x5DEECE66D);
+    let mut kick_bodies: Vec<Vec<f64>> = vec![Vec::new(); n];
+    let mut kicks: BTreeMap<i128, Vec<(usize, f64)>> = BTreeMap::new();
+    for bi in 0..n {
+        let mut t = -rng.unit().ln() * tau;
+        while t < t_end {
+            let eps = 10f64.powf(-7.0 + 4.0 * rng.unit());
+            kick_bodies[bi].push(t);
+            kicks.entry((t * TICKS) as i128).or_default().push((bi, eps));
+            t += -rng.unit().ln() * tau;
+        }
+    }
+    let next_kick = |bi: usize, t: f64| -> f64 {
+        let ks = &kick_bodies[bi];
+        match ks.partition_point(|&x| x <= t + 1e-9) {
+            k if k < ks.len() => ks[k],
+            _ => t_end,
+        }
+    };
+    // Body states at each kick, in time order.
+    let mut cur: Vec<Body> = b0.clone();
+    let mut kick_list: Vec<(i128, f64, usize, Body)> = Vec::new();
+    for (&tick, es) in &kicks {
+        for &(bi, eps) in es {
+            let t = tick as f64 / TICKS;
+            cur[bi] = kicked_body(&cur[bi], eps, t);
+            kick_list.push((tick, t, bi, cur[bi]));
+        }
+    }
+    let boundary = |i: usize, j: usize, t: f64| -> f64 { next_kick(i, t).min(next_kick(j, t)).min(t_end) };
+    // The body's state at time t (elements change only at kicks).
+    let cur_at = |bi: usize, t: f64| -> Body {
+        let mut body = b0[bi];
+        for &(_, tk, kbi, new) in &kick_list {
+            if tk > t + 1e-9 {
+                break;
+            }
+            if kbi == bi {
+                body = new;
+            }
+        }
+        body
+    };
+
+    // Eager: per kick, full-horizon enumeration, events filtered to the pair's current segment.
+    let mut ev_eager: Evs = HashSet::new();
+    let (mut e_eager, mut q_eager, mut ck_eager) = (0u64, 0u64, 0u64);
+    let t = Instant::now();
+    for &(_, tk, bi, new) in &kick_list {
+        let (lo, hi) = sorted.range(new.binet()[0], sorted.reach(&new));
+        for &(_, j) in &sorted.order[lo..hi] {
+            let j = j as usize;
+            let bj = cur_at(j, tk);
+            if j == bi || !is_candidate(&new, &bj, sp.rho) {
+                continue;
+            }
+            let bend = boundary(bi, j, tk);
+            let mut st = Stats::default();
+            let mut v = Vec::new();
+            pair_events(&new, &bj, sp.rho, SAFETY, tk, tk + horizon, &mut st, &mut v);
+            e_eager += st.evals;
+            q_eager += st.qsteps;
+            ck_eager += st.checks_total();
+            for (te, _d) in v {
+                if te < bend {
+                    ev_eager.insert((bi as u32, j as u32, (te * 1e6) as u64));
+                }
+            }
+        }
+    }
+    let us_eager = t.elapsed().as_secs_f64() * 1e6;
+
+    // Deferred: wakes on a calendar; checks only at fires; kicks re-derive.
+    #[derive(Clone)]
+    struct SecState {
+        sec: Section,
+        base: i128,
+        l: i128,
+        wake: i128,
+    }
+    let mut calendar: BTreeMap<i128, Vec<(u32, u32)>> = BTreeMap::new();
+    let mut store: HashMap<(u32, u32), Vec<SecState>> = HashMap::new();
+    let mut pairs_by_body: Vec<HashSet<(u32, u32)>> = vec![HashSet::new(); n];
+    let mut ev_def: Evs = HashSet::new();
+    let (mut e_def, mut q_def, mut ck_def, mut fires, mut rederive) = (0u64, 0u64, 0u64, 0u64, 0u64);
+    let end_t = (t_end * TICKS) as i128;
+    let t = Instant::now();
+    let mut bodies: Vec<Body> = b0.clone();
+    let mut kick_iter = kick_list.iter().peekable();
+    loop {
+        let next_kick_tick = kick_iter.peek().map(|k| k.0);
+        let next_wake_tick = calendar.range(..=end_t).next().map(|(k, _)| *k);
+        let do_kick = match (next_kick_tick, next_wake_tick) {
+            (Some(k), Some(w)) => k <= w,
+            (Some(_), None) => true,
+            (None, Some(_)) => false,
+            (None, None) => break,
+        };
+        if do_kick {
+            let &(_, tk, bi, new) = kick_iter.next().unwrap();
+            bodies[bi] = new;
+            for key in pairs_by_body[bi].drain() {
+                store.remove(&key);
+            }
+            // Calendar entries of removed pairs are skipped at fire time (stale check below).
+            let (lo, hi) = sorted.range(new.binet()[0], sorted.reach(&new));
+            for &(_, j) in &sorted.order[lo..hi] {
+                let j = j as usize;
+                if j == bi {
+                    continue;
+                }
+                let key = (bi.min(j) as u32, bi.max(j) as u32);
+                if !is_candidate(&new, &bodies[j], sp.rho) {
+                    continue;
+                }
+                rederive += 1;
+                let mut e0 = 0u64;
+                let secs = sections(&new, &bodies[j], sp.rho, SAFETY, &mut e0);
+                e_def += e0;
+                let mut sts: Vec<SecState> = Vec::new();
+                for sec in secs {
+                    let p = prep(&new, &bodies[j], &sec, tk);
+                    let (qq, w) = wake_first(&p);
+                    q_def += qq;
+                    if let Some((tick, l)) = w {
+                        if tick <= end_t {
+                            sts.push(SecState { sec, base: p.base, l, wake: tick });
+                        }
+                    }
+                }
+                if sts.is_empty() {
+                    store.remove(&key);
+                } else {
+                    let wk = sts.iter().map(|s| s.wake).min().unwrap();
+                    calendar.entry(wk).or_default().push(key);
+                    store.insert(key, sts);
+                }
+                pairs_by_body[key.0 as usize].insert(key);
+                pairs_by_body[key.1 as usize].insert(key);
+            }
+        } else {
+            let (wt, mut keys) = calendar.pop_first().unwrap();
+            let tk = wt as f64 / TICKS;
+            for key in keys.drain(..) {
+                let Some(sts) = store.get_mut(&key) else { continue };
+                if sts.iter().map(|s| s.wake).min() != Some(wt) {
+                    continue; // stale entry
+                }
+                fires += 1;
+                let (i, j) = (key.0 as usize, key.1 as usize);
+                let bend = boundary(i, j, tk);
+                let mut next_min: Option<i128> = None;
+                for st in sts.iter_mut() {
+                    if st.wake != wt {
+                        next_min = Some(match next_min {
+                            None => st.wake,
+                            Some(m) => m.min(st.wake),
+                        });
+                        continue;
+                    }
+                    let bi = &bodies[i];
+                    let bj = &bodies[j];
+                    let pi = bi.period as i128;
+                    let pj = bj.period as i128;
+                    let w1 = st.sec.w1 as i128;
+                    let w = (w1 + st.sec.w2 as i128).clamp(0, pi - 1);
+                    let c0 = (st.sec.ti as i128 - st.base + w1).rem_euclid(pi);
+                    let s = ((c0 - st.l * pj).rem_euclid(pi) - w1) as f64 / TICKS;
+                    ck_def += 1;
+                    let mut found = Vec::new();
+                    let mut e = 0u64;
+                    check(bi, bj, &st.sec, tk, s, sp.rho, &mut found, &mut e);
+                    e_def += e;
+                    for (te, _d) in found {
+                        if te < bend {
+                            ev_def.insert((key.0, key.1, (te * 1e6) as u64));
+                        }
+                    }
+                    // Advance this section's schedule.
+                    st.l += 1;
+                    let c = (c0 - st.l * pj).rem_euclid(pi);
+                    let d = (pi - pj.rem_euclid(pi)).rem_euclid(pi);
+                    let mut qq = 0u64;
+                    match first_hit(c as u128, d as u128, pi as u128, 0, w as u128, &mut qq) {
+                        None => st.wake = end_t + 1,
+                        Some(k) => {
+                            st.l += k as i128;
+                            st.wake = st.base + st.l * pj;
+                        }
+                    }
+                    q_def += qq;
+                    if st.wake <= end_t {
+                        next_min = Some(match next_min {
+                            None => st.wake,
+                            Some(m) => m.min(st.wake),
+                        });
+                    }
+                }
+                match next_min {
+                    Some(m) if m <= end_t => calendar.entry(m).or_default().push(key),
+                    _ => {
+                        store.remove(&key);
+                    }
+                }
+            }
+        }
+    }
+    let us_def = t.elapsed().as_secs_f64() * 1e6;
+    let misses = ev_eager.difference(&ev_def).count();
+    let extras = ev_def.difference(&ev_eager).count();
+    println!(
+        "{{\"exp\":\"dormant-stream\",\"n\":{},\"sigma_e\":{},\"rho\":{},\"tau_orbits\":{:.0},\"t_end_orbits\":{:.0},\"kicks\":{},\"rederivations\":{},\"fires\":{},\"e_eager\":{},\"e_def\":{},\"eval_ratio\":{:.1},\"q_eager\":{},\"q_def\":{},\"checks_eager\":{},\"checks_def\":{},\"us_eager\":{:.0},\"us_def\":{:.0},\"us_ratio\":{:.1},\"events\":{},\"misses\":{},\"extras\":{}}}",
+        sp.n, sp.sigma_e, sp.rho, tau / TAU, t_end / TAU, kick_list.len(), rederive, fires,
+        e_eager, e_def, e_eager as f64 / e_def.max(1) as f64, q_eager, q_def, ck_eager, ck_def,
+        us_eager, us_def, us_eager / us_def.max(1.0), ev_eager.len(), misses, extras
+    );
+}
