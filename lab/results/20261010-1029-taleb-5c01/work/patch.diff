+/// Belt scenarios: uniform control, a-clumps of width w, and a fleet formation in a sea.
+fn scenario(tag: &str) {
+    let mut rng = Rng(7);
+    let n = 2000usize;
+    let mut b = Vec::with_capacity(n);
+    let mut flags = Vec::with_capacity(n);
+    let (f, w) = match tag {
+        "uniform" => (0.0f64, 0.0f64),
+        t => {
+            let w: f64 = t.strip_prefix("clump:").unwrap().parse().unwrap();
+            (0.25, w)
+        }
+    };
+    for _ in 0..n {
+        let in_clump = f > 0.0 && (rng.next_u64() % 4 == 0);
+        let a = if in_clump {
+            1.0 + (2.0 * rng.f64() - 1.0) * w * 0.5
+        } else {
+            0.9 + 0.2 * rng.f64()
+        };
+        let e = rayleigh(&mut rng, 0.05, 0.5);
+        b.push(Body::new(a, e, TAU * rng.f64(), TAU * rng.f64()));
+        flags.push(in_clump);
+    }
+    let t0 = Instant::now();
+    let cs = cone_pairs(&b, RHO);
+    let scan_us = t0.elapsed().as_micros();
+    let mut deg = vec![0u64; n];
+    let (mut cc, mut cx, mut ss) = (Vec::new(), Vec::new(), Vec::new());
+    for &(i, j) in &cs.pairs {
+        deg[i as usize] += 1;
+        deg[j as usize] += 1;
+        match (flags[i as usize], flags[j as usize]) {
+            (true, true) => cc.push((i, j)),
+            (false, false) => ss.push((i, j)),
+            _ => cx.push((i, j)),
+        }
+    }
+    let mut d_clump: Vec<u64> = (0..n).filter(|&k| flags[k]).map(|k| deg[k]).collect();
+    let mut d_sea: Vec<u64> = (0..n).filter(|&k| !flags[k]).map(|k| deg[k]).collect();
+    println!("{{\"scenario\":\"{}\",\"n\":{},\"pairs\":{},\"scanned\":{},\"scan_us\":{},\"deg_clump\":{{\"p50\":{},\"p90\":{},\"p99\":{},\"max\":{}}},\"deg_sea\":{{\"p50\":{},\"p90\":{},\"p99\":{},\"max\":{}}},\"classes\":[",
+        tag, n, cs.pairs.len(), cs.scanned, scan_us,
+        pct_u64(&mut d_clump, 0.5), pct_u64(&mut d_clump, 0.9), pct_u64(&mut d_clump, 0.99), pct_u64(&mut d_clump, 1.0),
+        pct_u64(&mut d_sea, 0.5), pct_u64(&mut d_sea, 0.9), pct_u64(&mut d_sea, 0.99), pct_u64(&mut d_sea, 1.0));
+    print_class(&class_run(&b, &cc, "clump-clump", 2500));
+    println!(",");
+    print_class(&class_run(&b, &cx, "clump-sea", 2500));
+    println!(",");
+    print_class(&class_run(&b, &ss, "sea-sea", 2500));
+    println!("]}}");
+}
+
+/// A fleet formation: near-identical a, tiny e, clustered apsides, lambda uniform or bunched.
+fn fleet(nc: usize, a_hw: f64, sig_lam: f64, seed: u64) -> Vec<Body> {
+    let mut rng = Rng(seed);
+    let pom0 = TAU * rng.f64();
+    let lam0 = TAU * rng.f64();
+    (0..nc)
+        .map(|_| {
+            let a = 1.0 + (2.0 * rng.f64() - 1.0) * a_hw;
+            let e = rayleigh(&mut rng, 0.001, 0.01);
+            let pom = pom0 + (2.0 * rng.f64() - 1.0) * 0.1;
+            let lam = if sig_lam <= 0.0 {
+                TAU * rng.f64()
+            } else {
+                let (u1, u2) = (rng.f64(), rng.f64());
+                let z = (-2.0 * (1e-12 + u1).ln()).sqrt() * (TAU * u2).cos();
+                lam0 + sig_lam * z
+            };
+            Body::new(a, e, pom, lam)
+        })
+        .collect()
+}
+
+/// The fleet scenario: degree concentration and section economics inside a formation.
+fn fleet_scenario(nc: usize, a_hw: f64, sig_lam: f64, seed: u64) {
+    let fl = fleet(nc, a_hw, sig_lam, seed);
+    let mut rng = Rng(seed ^ 0x5a5a);
+    let mut b = fl.clone();
+    let mut flags = vec![true; nc];
+    for _ in 0..3600 {
+        b.push(Body::new(0.9 + 0.2 * rng.f64(), rayleigh(&mut rng, 0.05, 0.5), TAU * rng.f64(), TAU * rng.f64()));
+        flags.push(false);
+    }
+    let t0 = Instant::now();
+    let cs = cone_pairs(&b, RHO);
+    let scan_us = t0.elapsed().as_micros();
+    let mut deg = vec![0u64; b.len()];
+    let (mut ff, mut fx) = (Vec::new(), Vec::new());
+    for &(i, j) in &cs.pairs {
+        deg[i as usize] += 1;
+        deg[j as usize] += 1;
+        if flags[i as usize] && flags[j as usize] {
+            ff.push((i, j));
+        } else if flags[i as usize] || flags[j as usize] {
+            fx.push((i, j));
+        }
+    }
+    let mut d_fl: Vec<u64> = (0..nc).map(|k| deg[k]).collect();
+    let mut d_sea: Vec<u64> = (nc..b.len()).map(|k| deg[k]).collect();
+    println!("{{\"scenario\":\"fleet\",\"nc\":{},\"a_hw\":{},\"sig_lam\":{},\"n\":{},\"pairs\":{},\"scanned\":{},\"scan_us\":{},\"deg_fleet\":{{\"p50\":{},\"p99\":{},\"max\":{}}},\"deg_sea\":{{\"p50\":{},\"max\":{}}},\"classes\":[",
+        nc, a_hw, sig_lam, b.len(), cs.pairs.len(), cs.scanned, scan_us,
+        pct_u64(&mut d_fl, 0.5), pct_u64(&mut d_fl, 0.99), pct_u64(&mut d_fl, 1.0),
+        pct_u64(&mut d_sea, 0.5), pct_u64(&mut d_sea, 1.0));
+    print_class(&class_run(&b, &ff, "fleet-fleet", 2500));
+    println!(",");
+    print_class(&class_run(&b, &fx, "fleet-sea", 2500));
+    println!("]}}");
+}
+
+fn pos_of(b: &Body, t: f64) -> [f64; 2] {
+    let st = b.state_at_mean(b.mean_anomaly(t));
+    [st[0], st[1]]
+}
+
+fn rank_of(v: &[(f64, usize)], other: usize) -> u64 {
+    let dj = v.iter().find(|x| x.1 == other).map(|x| x.0).unwrap_or(f64::INFINITY);
+    v.iter().filter(|x| x.1 != other && x.0 < dj).count() as u64
+}
+
+/// Brute-force sub-rho encounters of a fleet, and the partner's distance-rank at closest approach.
+fn rank_probe(nc: usize, a_hw: f64, sig_lam: f64, seed: u64, orbits: f64, method_too: bool) {
+    let fl = fleet(nc, a_hw, sig_lam, seed);
+    let dt = 2e-5;
+    let steps = (orbits * TAU / dt) as usize;
+    let nb = 32768usize;
+    let binsz = TAU / nb as f64; // ~ 2 rho in arc at r ~ 1
+    let mut head = vec![-1i64; nb];
+    let mut nxt = vec![-1i64; nc];
+    let mut pos = vec![[0.0f64; 2]; nc];
+    let mut best: HashMap<(u32, u32), (f64, f64)> = HashMap::new(); // pair -> (d, t)
+    let t0 = Instant::now();
+    for s in 0..steps {
+        let t = s as f64 * dt;
+        let mut occupied: Vec<usize> = Vec::with_capacity(nc);
+        for i in 0..nc {
+            let m = fl[i].mean_anomaly(t);
+            let lam = (m + fl[i].pom).rem_euclid(TAU);
+            let st = fl[i].state_at_mean(m);
+            pos[i] = [st[0], st[1]];
+            let bin = ((lam / binsz) as usize).min(nb - 1);
+            if head[bin] < 0 {
+                occupied.push(bin);
+            }
+            nxt[i] = head[bin];
+            head[bin] = i as i64;
+        }
+        for &bin in &occupied {
+            // same-bin pairs
+            let mut p = head[bin];
+            while p >= 0 {
+                let mut q = nxt[p as usize];
+                while q >= 0 {
+                    record(&pos, p as usize, q as usize, t, &mut best);
+                    q = nxt[q as usize];
+                }
+                p = nxt[p as usize];
+            }
+            // forward-adjacent bin pairs
+            let nb2 = (bin + 1) % nb;
+            let mut p = head[bin];
+            while p >= 0 {
+                let mut q = head[nb2];
+                while q >= 0 {
+                    record(&pos, p as usize, q as usize, t, &mut best);
+                    q = nxt[q as usize];
+                }
+                p = nxt[p as usize];
+            }
+        }
+        for &bin in &occupied {
+            head[bin] = -1;
+        }
+    }
+    let brute_us = t0.elapsed().as_micros();
+    // partner rank at closest approach, both directions, min
+    let (mut r1, mut r2, mut r4, mut r8, mut rmax, mut tot) = (0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
+    let mut dmin_all = f64::INFINITY;
+    let mut keys: Vec<_> = best.keys().copied().collect();
+    keys.sort_unstable();
+    for &(i, j) in &keys {
+        let (d, t) = best[&(i, j)];
+        tot += 1;
+        dmin_all = dmin_all.min(d);
+        let (pi_, pj_) = (pos_of(&fl[i as usize], t), pos_of(&fl[j as usize], t));
+        let mut vi = Vec::with_capacity(nc);
+        let mut vj = Vec::with_capacity(nc);
+        for k in 0..nc {
+            let p = pos_of(&fl[k], t);
+            vi.push(((p[0] - pi_[0]).hypot(p[1] - pi_[1]), k));
+            vj.push(((p[0] - pj_[0]).hypot(p[1] - pj_[1]), k));
+        }
+        let r = rank_of(&vi, j as usize).min(rank_of(&vj, i as usize));
+        r1 += (r <= 1) as u64;
+        r2 += (r <= 2) as u64;
+        r4 += (r <= 4) as u64;
+        r8 += (r <= 8) as u64;
+        rmax = rmax.max(r);
+    }
+    // the pairwise method on the same fleet, for misses and cost
+    let mut mm = HashMap::<(u32, u32), u64>::new();
+    let mut st = Stats::default();
+    let mut out = Vec::new();
+    let t1 = Instant::now();
+    if method_too {
+        let cs = cone_pairs(&fl, RHO);
+        for &(i, j) in &cs.pairs {
+            let (bi, bj) = (&fl[i as usize], &fl[j as usize]);
+            let mut ev = 0u64;
+            for sec in sections(bi, bj, RHO, SAFETY, &mut ev) {
+                out.clear();
+                run_section(bi, bj, &sec, RHO, 0.0, orbits * TAU, &mut st, &mut out);
+                if !out.is_empty() {
+                    *mm.entry((i, j)).or_insert(0) += out.len() as u64;
+                }
+            }
+            st.evals += ev;
+        }
+    }
+    // Adjudicate disputed pairs by dense unbiased sampling of the true distance.
+    let mut disp: Vec<(u32, u32)> = Vec::new();
+    for k in keys.iter().filter(|k| !mm.contains_key(k)) {
+        disp.push(*k);
+    }
+    for k in mm.keys().filter(|k| !best.contains_key(k)) {
+        disp.push(*k);
+    }
+    disp.sort_unstable();
+    disp.truncate(300);
+    let nsamp = 150_000;
+    let (mut miss_true, mut extra_true, mut extra_false) = (0u64, 0u64, 0u64);
+    let (mut adj_rmax, mut adj_r4) = (0u64, 0u64);
+    let cone_pairs_list = cone_pairs(&fl, RHO).pairs;
+    let cone_set: std::collections::HashSet<(u32, u32)> = cone_pairs_list.iter().copied().collect();
+    let mut samples = Vec::new();
+    for &(i, j) in &disp {
+        let (bi, bj) = (&fl[i as usize], &fl[j as usize]);
+        let mut dmin = f64::INFINITY;
+        let mut tmin = 0.0;
+        for s in 0..nsamp {
+            let t = orbits * TAU * s as f64 / nsamp as f64;
+            let pi = bi.state_at_mean(bi.mean_anomaly(t));
+            let pj = bj.state_at_mean(bj.mean_anomaly(t));
+            let d = (pi[0] - pj[0]).hypot(pi[1] - pj[1]);
+            if d < dmin {
+                dmin = d;
+                tmin = t;
+            }
+        }
+        let was_missed = !mm.contains_key(&(i, j));
+        if was_missed && dmin < RHO {
+            miss_true += 1;
+        }
+        if !was_missed && dmin < RHO {
+            extra_true += 1;
+        }
+        if !was_missed && dmin >= RHO {
+            extra_false += 1;
+        }
+        // distance-rank of the partner at the adjudicated closest approach
+        let (pi, pj) = (pos_of(&fl[i as usize], tmin), pos_of(&fl[j as usize], tmin));
+        let mut vi = Vec::with_capacity(nc);
+        let mut vj = Vec::with_capacity(nc);
+        for k in 0..nc {
+            let p = pos_of(&fl[k], tmin);
+            vi.push(((p[0] - pi[0]).hypot(p[1] - pi[1]), k));
+            vj.push(((p[0] - pj[0]).hypot(p[1] - pj[1]), k));
+        }
+        let r = rank_of(&vi, j as usize).min(rank_of(&vj, i as usize));
+        adj_rmax = adj_rmax.max(r);
+        adj_r4 += (r <= 4) as u64;
+        if samples.len() < 250 {
+            samples.push(format!("{{\"pair\":[{},{}],\"missed\":{},\"cone\":{},\"d_min\":{:.3e},\"rank\":{}}}", i, j, was_missed, cone_set.contains(&(i, j)), dmin, r));
+        }
+    }
+    if !disp.is_empty() {
+        println!("{{\"adjudicate\":{{\"disputed\":{},\"missed_true_sub_rho\":{},\"extra_true_sub_rho\":{},\"extra_false\":{},\"rank_max\":{},\"rank_le_4\":{},\"samples\":[{}]}}}}",
+            disp.len(), miss_true, extra_true, extra_false, adj_rmax, adj_r4, samples.join(","));
+    }
+    let meth_us = t1.elapsed().as_micros();
+    let missed = keys.iter().filter(|k| !mm.contains_key(k)).count();
+    let extra = mm.keys().filter(|k| !best.contains_key(k)).count();
+    println!(
+        "{{\"rank_probe\":{{\"nc\":{},\"a_hw\":{},\"sig_lam\":{},\"orbits\":{},\"encounters\":{},\"r_le_1\":{},\"r_le_2\":{},\"r_le_4\":{},\"r_le_8\":{},\"r_max\":{},\"d_min\":{},\"brute_us\":{},\"method\":{{\"pairs\":{},\"missed\":{},\"extra\":{},\"hits\":{},\"evals\":{},\"us\":{}}}}}",
+        nc, a_hw, sig_lam, orbits, tot, r1, r2, r4, r8, rmax, dmin_all, brute_us,
+        mm.len(), missed, extra, mm.values().sum::<u64>(), st.evals, meth_us);
+}
+
+fn record(pos: &[[f64; 2]], i: usize, j: usize, t: f64, best: &mut HashMap<(u32, u32), (f64, f64)>) {
+    let d = (pos[i][0] - pos[j][0]).hypot(pos[i][1] - pos[j][1]);
+    if d < RHO {
+        let e = best.entry((i.min(j) as u32, i.max(j) as u32)).or_insert((f64::INFINITY, t));
+        if d < e.0 {
+            *e = (d, t);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// missmap: where does the shipped pairwise tier silently drop real encounters?
+// Truth = uniform-in-time grid (no binning, no cones), refine below 4*rho.
+// ---------------------------------------------------------------------------
+
+fn fleet2(nc: usize, a_hw: f64, sig_e: f64, sig_lam: f64, seed: u64, debris: (usize, f64)) -> Vec<Body> {
+    let mut rng = Rng(seed);
+    let pom0 = TAU * rng.f64();
+    let lam0 = TAU * rng.f64();
+    let ecap = (10.0 * sig_e).max(0.01).min(0.06);
+    let mut v: Vec<Body> = (0..nc)
+        .map(|_| {
+            let a = 1.0 + (2.0 * rng.f64() - 1.0) * a_hw;
+            let e = rayleigh(&mut rng, sig_e, ecap);
+            let pom = pom0 + (2.0 * rng.f64() - 1.0) * 0.1;
+            let lam = if sig_lam <= 0.0 {
+                TAU * rng.f64()
+            } else {
+                let (u1, u2) = (rng.f64(), rng.f64());
+                let z = (-2.0 * (1e-12 + u1).ln()).sqrt() * (TAU * u2).cos();
+                lam0 + sig_lam * z
+            };
+            Body::new(a, e, pom, lam)
+        })
+        .collect();
+    let (dn, de) = debris;
+    for _ in 0..dn {
+        let a = 1.0 + (2.0 * rng.f64() - 1.0) * a_hw;
+        let e = rayleigh(&mut rng, de, 3.0 * de);
+        v.push(Body::new(a, e, TAU * rng.f64(), TAU * rng.f64()));
+    }
+    v
+}
+
+fn dist_at(bi: &Body, bj: &Body, t: f64) -> f64 {
+    let si = bi.state_at_mean(bi.mean_anomaly(t));
+    let sj = bj.state_at_mean(bj.mean_anomaly(t));
+    (si[0] - sj[0]).hypot(si[1] - sj[1])
+}
+
+fn refine_pair(bi: &Body, bj: &Body, t0: f64, t1: f64) -> (f64, f64) {
+    let k = 2048;
+    let mut best = f64::INFINITY;
+    let mut bt = t0;
+    for q in 0..=k {
+        let t = t0 + (t1 - t0) * q as f64 / k as f64;
+        let d = dist_at(bi, bj, t);
+        if d < best {
+            best = d;
+            bt = t;
+        }
+    }
+    let step = (t1 - t0) / k as f64;
+    let (mut a, mut b) = ((bt - step).max(t0), (bt + step).min(t1));
+    let phi = 0.6180339887498949;
+    let (mut c, mut d) = (b - phi * (b - a), a + phi * (b - a));
+    let (mut fc, mut fd) = (dist_at(bi, bj, c), dist_at(bi, bj, d));
+    for _ in 0..80 {
+        if fc < fd {
+            b = d;
+            d = c;
+            fd = fc;
+            c = b - phi * (b - a);
+            fc = dist_at(bi, bj, c);
+        } else {
+            a = c;
+            c = d;
+            fc = fd;
+            d = a + phi * (b - a);
+            fd = dist_at(bi, bj, d);
+        }
+    }
+    let m = 0.5 * (a + b);
+    let dm = dist_at(bi, bj, m);
+    if dm < best {
+        (dm, m)
+    } else {
+        (best, bt)
+    }
+}
+
+/// Uniform-grid truth; returns ((i,j) -> (dmin, t*)) for pairs whose true min < rho.
+fn truth_grid(fl: &[Body], orbits: f64, rho: f64) -> (Vec<((u32, u32), f64, f64)>, f64, f64) {
+    let t_end = orbits * TAU;
+    let ns = (4096.0 * orbits) as usize;
+    let dt = t_end / ns as f64;
+    let n = fl.len();
+    let t0 = Instant::now();
+    let mut gx = vec![0.0f64; n * ns];
+    let mut gy = vec![0.0f64; n * ns];
+    for i in 0..n {
+        let b = &fl[i];
+        for s in 0..ns {
+            let st = b.state_at_mean(b.mean_anomaly(s as f64 * dt));
+            gx[i * ns + s] = st[0];
+            gy[i * ns + s] = st[1];
+        }
+    }
+    let mut out = Vec::new();
+    let gate = 4.0 * rho;
+    for i in 0..n {
+        for j in (i + 1)..n {
+            let (xi, yi) = (&gx[i * ns..(i + 1) * ns], &gy[i * ns..(i + 1) * ns]);
+            let (xj, yj) = (&gx[j * ns..(j + 1) * ns], &gy[j * ns..(j + 1) * ns]);
+            let mut best = f64::INFINITY;
+            let mut arg = 0usize;
+            for s in 0..ns {
+                let dx = xi[s] - xj[s];
+                let dy = yi[s] - yj[s];
+                let d2 = dx * dx + dy * dy;
+                if d2 < best {
+                    best = d2;
+                    arg = s;
+                }
+            }
+            if best.sqrt() >= gate {
+                continue;
+            }
+            let t0r = ((arg as f64 - 3.0) * dt).max(0.0);
+            let t1r = ((arg as f64 + 3.0) * dt).min(t_end);
+            let (d, t) = refine_pair(&fl[i], &fl[j], t0r, t1r);
+            if d < rho {
+                out.push(((i as u32, j as u32), d, t));
+            }
+        }
+    }
+    let dur = t0.elapsed().as_secs_f64();
+    (out, t_end, dur)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn missmap(nc: usize, a_hw: f64, sig_e: f64, rho: f64, sig_lam: f64, seed: u64, orbits: f64, debris: (usize, f64)) {
+    let fl = fleet2(nc, a_hw, sig_e, sig_lam, seed, debris);
+    let (truth, t_end, brute_s) = truth_grid(&fl, orbits, rho);
+    let t0 = Instant::now();
+    let cone = cone_pairs(&fl, rho);
+    let cone_set: std::collections::HashSet<(u32, u32)> = cone.pairs.iter().copied().collect();
+    let mut mm: HashMap<(u32, u32), u64> = HashMap::new();
+    let mut kind_hist = [0u64; 3];
+    let mut st = Stats::default();
+    let mut setup_evals = 0u64;
+    let mut outv = Vec::new();
+    let mut secs_of: HashMap<(u32, u32), Vec<Section>> = HashMap::new();
+    for &(i, j) in &cone.pairs {
+        let (bi, bj) = (&fl[i as usize], &fl[j as usize]);
+        let mut ev = 0u64;
+        let secs = sections(bi, bj, rho, 1.1, &mut ev);
+        setup_evals += ev;
+        for sec in &secs {
+            kind_hist[sec.kind as usize] += 1;
+        }
+        for sec in &secs {
+            outv.clear();
+            run_section(bi, bj, sec, rho, 0.0, t_end, &mut st, &mut outv);
+            if !outv.is_empty() {
+                *mm.entry((i, j)).or_insert(0) += outv.len() as u64;
+            }
+        }
+        secs_of.insert((i, j), secs);
+    }
+    let method_s = t0.elapsed().as_secs_f64();
+    let truth_set: std::collections::HashSet<(u32, u32)> = truth.iter().map(|(k, _, _)| *k).collect();
+
+    // verify method-only pairs densely (instrument independence check)
+    let mut extra_true = 0u64;
+    let mut extra_false = 0u64;
+    for k in mm.keys() {
+        if !truth_set.contains(k) {
+            let (bi, bj) = (&fl[k.0 as usize], &fl[k.1 as usize]);
+            let (mut dmin, mut tmin) = (f64::INFINITY, 0.0);
+            for s in 0..100_000 {
+                let t = t_end * s as f64 / 100_000.0;
+                let d = dist_at(bi, bj, t);
+                if d < dmin {
+                    dmin = d;
+                    tmin = t;
+                }
+            }
+            if dmin < rho {
+                let (d2, _) = refine_pair(bi, bj, (tmin - 1e-3).max(0.0), (tmin + 1e-3).min(t_end));
+                if d2 < rho {
+                    extra_true += 1;
+                } else {
+                    extra_false += 1;
+                }
+            } else {
+                extra_false += 1;
+            }
+        }
+    }
+
+    // attribute every true pair the method missed
+    let mut verdicts: HashMap<&'static str, u64> = HashMap::new();
+    let mut det = Vec::new();
+    let mut r1_missed = Vec::new();
+    let mut win_over: Vec<f64> = Vec::new();
+    let mut win_side = (0u64, 0u64);
+    let mut r1_caught = Vec::new();
+    let mut miss_debris = 0u64;
+    let mut true_debris = 0u64;
+    for &((i, j), d, t) in &truth {
+        let (bi, bj) = (&fl[i as usize], &fl[j as usize]);
+        let involves_debris = i as usize >= nc || j as usize >= nc;
+        if involves_debris {
+            true_debris += 1;
+        }
+        let r1 = 0.5 * (bi.a + bj.a) * (bi.e + bj.e) / rho;
+        if mm.contains_key(&(i, j)) {
+            r1_caught.push(r1);
+            continue;
+        }
+        if involves_debris {
+            miss_debris += 1;
+        }
+        r1_missed.push(r1);
+        let verdict = if !cone_set.contains(&(i, j)) {
+            "cone"
+        } else {
+            let secs = secs_of.get(&(i, j)).cloned().unwrap_or_default();
+            if secs.is_empty() {
+                "dropped"
+            } else {
+                let ts = t * TICKS;
+                let (pi, pj) = (bi.period as f64, bj.period as f64);
+                let (mut any_arc, mut any_win, mut s_true, mut w, mut kinds) = (false, false, 0.0, (0.0, 0.0), String::new());
+                for sec in &secs {
+                    let l = ((ts - sec.tj as f64) / pj).round();
+                    let tjc = sec.tj as f64 + l * pj;
+                    let m = ((ts - sec.ti as f64) / pi).round();
+                    let ti_abs = sec.ti as f64 + m * pi;
+                    let in_j = sec.kind == Kind::Full || (ts >= tjc - sec.dj.0 * TICKS && ts <= tjc + sec.dj.1 * TICKS);
+                    let in_i = sec.kind == Kind::Full || (ts >= ti_abs - sec.di.0 * TICKS && ts <= ti_abs + sec.di.1 * TICKS);
+                    let s = ti_abs - tjc;
+                    let win = s >= sec.w1 as f64 && s <= sec.w2 as f64;
+                    if in_j && in_i {
+                        any_arc = true;
+                        if win {
+                            any_win = true;
+                            s_true = s;
+                            w = (sec.w1 as f64, sec.w2 as f64);
+                        }
+                        if !win && s != 0.0 {
+                            win_over.push(s.abs() / ((sec.w1 as f64 + sec.w2 as f64).max(1.0)));
+                            if s < 0.0 { win_side.0 += 1; } else { win_side.1 += 1; }
+                        }
+                    }
+                    kinds.push(match sec.kind {
+                        Kind::Cross => 'C',
+                        Kind::Wide => 'W',
+                        Kind::Full => 'F',
+                    });
+                }
+                if !any_arc {
+                    "arc"
+                } else if !any_win {
+                    "window"
+                } else {
+                    let _ = (s_true, w);
+                    "check"
+                }
+            }
+        };
+        *verdicts.entry(verdict).or_insert(0) += 1;
+        // geometry numbers for the guard
+        let (vi, vj) = (bi.state_at_mean(bi.mean_anomaly(t)), bj.state_at_mean(bj.mean_anomaly(t)));
+        let dv = (vi[2] - vj[2]).hypot(vi[3] - vj[3]);
+        let dj = secs_of
+            .get(&(i, j))
+            .and_then(|s| s.first())
+            .map(|s| s.dj.0 + s.dj.1)
+            .unwrap_or(0.0);
+        let r3 = if dv > 0.0 && dj > 0.0 { rho / (dv * dj / 32.0) } else { f64::NAN };
+        if det.len() < 60 {
+            det.push(format!(
+                "{{\"pair\":[{},{}],\"d\":{:.3e},\"v\":\"{}\",\"kinds\":\"{}\",\"R1\":{:.2},\"R3\":{:.2e},\"dv\":{:.2e},\"da\":{:.1e},\"esum\":{:.1e},\"el_i\":[{:.17e},{:.17e},{:.17e},{},{}],\"el_j\":[{:.17e},{:.17e},{:.17e},{},{}]}}",
+                i, j, d, verdict,
+                secs_of.get(&(i, j)).map(|s| s.iter().map(|x| match x.kind { Kind::Cross => 'C', Kind::Wide => 'W', Kind::Full => 'F' }).collect::<String>()).unwrap_or_default(),
+                0.5 * (bi.a + bj.a) * (bi.e + bj.e) / rho, r3, dv, (bi.a - bj.a).abs(), bi.e + bj.e,
+                bi.a, bi.e, bi.pom, bi.period, bi.tp,
+                bj.a, bj.e, bj.pom, bj.period, bj.tp
+            ));
+        }
+    }
+    let hist = |v: &Vec<f64>| -> String {
+        let mut bins = [0u64; 10];
+        for x in v {
+            let b = (x.log10().floor() as i64).clamp(-2, 7) as usize;
+            bins[b + 2] += 1;
+        }
+    bins.iter().map(|c| c.to_string()).collect::<Vec<_>>().join(",")
+    };
+    let mut line = String::new();
+    line.push_str(&format!(
+        "{{\"missmap\":{{\"nc\":{},\"a_hw\":{},\"sig_e\":{},\"rho\":{},\"sig_lam\":{},\"seed\":{},\"orbits\":{},\"debris\":[{},{}],",
+        nc, a_hw, sig_e, rho, sig_lam, seed, orbits, debris.0, debris.1
+    ));
+    line.push_str(&format!("\"cone_pairs\":{},\"true\":{},\"method\":{},\"missed\":{},", cone.pairs.len(), truth.len(), mm.len(), truth.iter().filter(|(k, _, _)| !mm.contains_key(k)).count()));
+    let vs: Vec<String> = verdicts.iter().map(|(k, c)| format!("\"{}\":{}", k, c)).collect();
+    line.push_str(&format!("\"method_only\":{{\"true\":{},\"false\":{}}},", extra_true, extra_false));
+    line.push_str(&format!("\"kinds\":{{\"C\":{},\"W\":{},\"F\":{}}},", kind_hist[0], kind_hist[1], kind_hist[2]));
+    line.push_str(&format!("\"setup_evals\":{},", setup_evals));
+    line.push_str(&format!("\"verdicts\":{{{}}},", vs.join(",")));
+    line.push_str(&format!("\"true_debris\":{},\"miss_debris\":{},", true_debris, miss_debris));
+    line.push_str(&format!("\"R1_missed\":[{}],\"R1_caught\":[{}],", hist(&r1_missed), hist(&r1_caught)));
+    line.push_str(&format!("\"detail\":[{}],", det.join(",")));
+    win_over.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let wo = if win_over.is_empty() { String::from("null") } else { format!("{{\"n\":{},\"p50\":{:.2},\"p90\":{:.2},\"max\":{:.2}}}", win_over.len(), win_over[win_over.len() / 2], win_over[(9 * win_over.len()) / 10], win_over[win_over.len() - 1]) };
+    line.push_str(&format!("\"win_over\":{},\"win_side_neg\":{},\"win_side_pos\":{},", wo, win_side.0, win_side.1));
+    line.push_str(&format!("\"s\":{{\"truth\":{:.2},\"method\":{:.2}}}}}}}", brute_s, method_s));
+    println!("{}", line);
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let which = args.get(1).map(|s| s.as_str()).unwrap_or("all");
+    match which {
+        "belts" | "all" => {
+            scenario("uniform");
+            scenario("clump:0.02");
+            scenario("clump:0.002");
+            scenario("clump:0.0002");
+            scenario("clump:0.00002");
+        }
+        _ => {}
+    }
+    match which {
+        "fleet" | "all" => {
+            fleet_scenario(400, 1e-5, 0.0, 11);
+        }
+        _ => {}
+    }
+    match which {
+        "ranks" | "all" => {
+            rank_probe(200, 1e-3, 0.0, 21, 1.0, true);
+            rank_probe(800, 1e-3, 0.0, 22, 0.5, false);
+            rank_probe(200, 3e-3, 0.0, 23, 1.0, false);
+            rank_probe(200, 1e-5, 0.05, 24, 1.0, false);
+            rank_probe(200, 1e-3, 0.05, 25, 1.0, false);
+        }
+        _ => {}
+    }
+    match which {
+        "ranks2" => {
+            ranks2();
+        }
+        "adj" => {
+            rank_probe(200, 1e-5, 0.01, 27, 1.0, true);
+        }
+        "missmap" => {
+            let a = |k: usize| -> f64 { args[k].parse().unwrap() };
+            let u = |k: usize| -> usize { args[k].parse().unwrap() };
+            let debris = if args.len() > 10 { (u(9), a(10)) } else { (0, 0.0) };
+            missmap(u(2), a(3), a(4), a(5), a(6), a(7) as u64, a(8), debris);
+        }
+        _ => {}
+    }
+}
+
+fn ranks2() {
+    rank_probe(200, 1e-5, 0.02, 26, 1.0, true);
+    rank_probe(200, 1e-5, 0.01, 27, 1.0, true);
+    rank_probe(200, 1e-3, 0.02, 28, 1.0, true);
+}
