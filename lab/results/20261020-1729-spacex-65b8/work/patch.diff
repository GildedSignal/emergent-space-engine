+fn median(samples: &mut Vec<f64>) -> f64 {
+    if samples.is_empty() {
+        return f64::NAN;
+    }
+    samples.sort_by(f64::total_cmp);
+    samples[(samples.len() - 1) / 2]
+}
+
+/// One run, two instruments: 1991's phase walk and 624a's panel landings, split by
+/// whether the expensive node() arithmetic ran (`quad`) or only a precomputed `.sum`
+/// word was read (`probe`).
+fn census_json(rows: &[Row], reuse: u32, pops: &HashMap<u64, u8>) -> serde_json::Value {
+    let mut out = json!({"ptr_reuse": reuse, "mints": rows.len()});
+    for (kind, name) in [(census::CYCLE, "cycles"), (census::PASSAGE, "passages")] {
+        for (pop, pname) in [(0u8, "made"), (1u8, "leavers")] {
+            let sel: Vec<&Row> = rows
+                .iter()
+                .filter(|r| r.kind == kind && pops.get(&r.id) == Some(&pop))
+                .collect();
+            if sel.is_empty() {
+                continue;
+            }
+            let knots: u64 = sel.iter().map(|r| r.knots as u64 + r.tail as u64).sum();
+            let mut quad = Vec::new();
+            let mut probes = Vec::new();
+            let mut both = Vec::new();
+            let mut walk = Vec::new();
+            let mut reads = Vec::new();
+            let mut per_knot = Vec::new();
+            for r in &sel {
+                let n = (r.knots as f64).max(1.0);
+                quad.push(r.quad_panels as f64 / n);
+                probes.push(r.probe_panels as f64 / n);
+                both.push((r.quad_panels + r.probe_panels) as f64 / n);
+                if r.quad_calls > 0 {
+                    walk.push((r.psi_max - r.psi_min) as f64 / r.span as f64);
+                }
+                reads.push(r.reads as f64);
+                per_knot.push(n);
+            }
+            let never_quad = sel.iter().filter(|r| r.quad_panels == 0 && r.tail_quad == 0).count();
+            let never_any = sel
+                .iter()
+                .filter(|r| r.quad_panels == 0 && r.probe_panels == 0 && r.tail_quad == 0 && r.tail_probe == 0)
+                .count();
+            out[format!("{}/{}", name, pname)] = json!({
+                "mints": sel.len(), "knots": knots,
+                "median_knots": median(&mut per_knot),
+                "quad_frac_median": median(&mut quad), "quad_frac_max": quad.iter().copied().fold(0.0, f64::max),
+                "probe_frac_median": median(&mut probes),
+                "panels_frac_median": median(&mut both),
+                "walk_frac_median": median(&mut walk),
+                "reads_median": median(&mut reads),
+                "never_quad": never_quad, "never_any_panel_or_tail": never_any,
+                "tail_quad_total": sel.iter().map(|r| r.tail_quad).sum::<u32>(),
+                "tail_probe_total": sel.iter().map(|r| r.tail_probe).sum::<u32>(),
+            });
+        }
+    }
+    // Cadence bins over closed rows (all classes): does a longer-lived mint walk more?
+    let mut bins = serde_json::Map::new();
+    let edges = [
+        ("lt_1_over_64", 0.0f64, 1.0 / 64.0),
+        ("1_64_to_1_16", 1.0 / 64.0, 1.0 / 16.0),
+        ("1_16_to_1_4", 1.0 / 16.0, 1.0 / 4.0),
+        ("1_4_to_1", 1.0 / 4.0, 1.0),
+        ("ge_1", 1.0, f64::INFINITY),
+    ];
+    for (name, lo, hi) in edges {
+        let sel: Vec<&Row> = rows
+            .iter()
+            .filter(|r| r.closed && r.interval_over_period >= lo && r.interval_over_period < hi)
+            .collect();
+        if sel.is_empty() {
+            continue;
+        }
+        let mut walk = Vec::new();
+        let mut quad = Vec::new();
+        for r in &sel {
+            if r.quad_calls > 0 {
+                walk.push((r.psi_max - r.psi_min) as f64 / r.span as f64);
+            }
+            quad.push(r.quad_panels as f64 / (r.knots as f64).max(1.0));
+        }
+        bins.insert(
+            name.into(),
+            json!({"mints": sel.len(), "walk_median": median(&mut walk), "quad_median": median(&mut quad)}),
+        );
+    }
+    let unclosed = rows.iter().filter(|r| !r.closed).count();
+    out["cadence_bins_interval_over_period"] = serde_json::Value::Object(bins);
+    out["unclosed"] = json!(unclosed);
+    // The biggest mints (the tail the page argues about).
+    let mut top: Vec<&Row> = rows.iter().collect();
+    top.sort_by_key(|r| r.knots);
+    out["top_by_knots"] = top
+        .iter()
+        .rev()
+        .take(10)
+        .map(|r| {
+            json!({
+                "id": r.id, "kind": r.kind, "knots": r.knots, "tail": r.tail,
+                "quad_panels": r.quad_panels, "probe_panels": r.probe_panels,
+                "tail_quad": r.tail_quad, "reads": r.reads,
+                "walk_frac": if r.quad_calls > 0 { (r.psi_max - r.psi_min) as f64 / r.span as f64 } else { f64::NAN },
+                "interval_over_period": r.interval_over_period, "closed": r.closed,
+            })
+        })
+        .collect::<Vec<_>>()
+        .into();
+    out
+}
