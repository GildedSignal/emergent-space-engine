+++ b/crates/space/src/census.rs
@@ -0,0 +1,228 @@
+//! Print-only census of knot-panel consumption per minted shape (run 20261020-1729-spacex-65b8).
+//!
+//! Adjudicates the mint-knots page's two headline numbers by measuring, in ONE binary and
+//! ONE run, the two quantities earlier runs published separately:
+//! - panels whose quadrature arithmetic actually runs post-mint (`quad`), against
+//! - panels whose precomputed `.sum` word is only read (`probe`: bisection mids, table reads),
+//! plus the psi spread of post-mint quadrature (1991's "walk") and each row's cadence
+//! (next-kick interval / period, closed from the bench loop).
+//! No engine behaviour depends on this module; it is enabled explicitly by the bench.
+
+pub const CYCLE: u8 = 0;
+pub const PASSAGE: u8 = 1;
+
+#[derive(Clone, Debug)]
+pub struct Row {
+    pub id: u64,
+    pub kind: u8,
+    pub knots: u32,
+    pub tail: u32,
+    pub span: u64,
+    pub quad_panels: u32,
+    pub probe_panels: u32,
+    pub tail_quad: u32,
+    pub tail_probe: u32,
+    pub quad_calls: u32,
+    pub reads: u32,
+    pub psi_min: u64,
+    pub psi_max: u64,
+    pub closed: bool,
+    pub interval_over_period: f64,
+}
+
+struct Rec {
+    quad_panels: std::collections::BTreeSet<u32>,
+    probe_panels: std::collections::BTreeSet<u32>,
+    tail_quad: u32,
+    tail_probe: u32,
+    quad_calls: u32,
+    reads: u32,
+    psi_min: u64,
+    psi_max: u64,
+}
+
+#[derive(Default)]
+struct State {
+    enabled: bool,
+    depth: u32,
+    next_id: u64,
+    recs: Vec<Rec>,
+    rows: Vec<Row>,
+    by_ptr: std::collections::HashMap<(u8, usize), u64>,
+    reuse: u32,
+}
+
+thread_local! {
+    static S: std::cell::RefCell<State> = std::cell::RefCell::new(State::default());
+}
+
+pub fn enable() {
+    S.with(|s| s.borrow_mut().enabled = true);
+}
+
+/// Enter a compile: all quadrature below this depth is mint-time (the eager build itself).
+pub fn begin() {
+    S.with(|s| {
+        let mut s = s.borrow_mut();
+        if s.enabled {
+            s.depth += 1;
+        }
+    });
+}
+
+pub fn end_mint(kind: u8, ptr: usize, knots: u32, tail: u32, span: u64) -> u64 {
+    S.with(|s| {
+        let mut s = s.borrow_mut();
+        if !s.enabled {
+            return u64::MAX;
+        }
+        s.depth = s.depth.saturating_sub(1);
+        let id = s.next_id;
+        s.next_id += 1;
+        // A freed shape's address can be re-minted under the other kind: the dead
+        // mapping must not keep stealing this address's reads.
+        s.by_ptr.remove(&(1 - kind, ptr));
+        if s.by_ptr.insert((kind, ptr), id).is_some() {
+            s.reuse += 1;
+        }
+
+        s.recs.push(Rec {
+            quad_panels: Default::default(),
+            probe_panels: Default::default(),
+            tail_quad: 0,
+            tail_probe: 0,
+            quad_calls: 0,
+            reads: 0,
+            psi_min: u64::MAX,
+            psi_max: 0,
+        });
+        s.rows.push(Row {
+            id,
+            kind,
+            knots,
+            tail,
+            span: span.max(1),
+            quad_panels: 0,
+            probe_panels: 0,
+            tail_quad: 0,
+            tail_probe: 0,
+            quad_calls: 0,
+            reads: 0,
+            psi_min: u64::MAX,
+            psi_max: 0,
+            closed: false,
+            interval_over_period: f64::NAN,
+        });
+        id
+    })
+}
+
+#[inline]
+fn with_row(ptr: usize, quad: Option<(u32, u64)>, probe: Option<u32>, tail_quad: bool, tail_probe: bool) {
+    S.with(|s| {
+        let mut s = s.borrow_mut();
+        if !s.enabled || s.depth > 0 || s.rows.is_empty() {
+            return;
+        }
+        let id = match s.by_ptr.get(&(CYCLE, ptr)).or_else(|| s.by_ptr.get(&(PASSAGE, ptr))) {
+            Some(&id) => id,
+            None => return,
+        };
+        let i = id as usize;
+        if i >= s.recs.len() || i >= s.rows.len() {
+            return;
+        }
+        let mut st = &mut *s;
+        let (rec, row) = (&mut st.recs[i], &mut st.rows[i]);
+        row.reads += 1;
+        if tail_quad || tail_probe {
+            if tail_quad {
+                rec.tail_quad += 1;
+                row.tail_quad += 1;
+            } else {
+                rec.tail_probe += 1;
+                row.tail_probe += 1;
+            }
+            return;
+        }
+        if let Some(panel) = probe {
+            rec.probe_panels.insert(panel);
+        }
+        if let Some((panel, psi)) = quad {
+            rec.quad_panels.insert(panel);
+            rec.quad_calls += 1;
+            row.quad_calls += 1;
+            rec.psi_min = rec.psi_min.min(psi);
+            rec.psi_max = rec.psi_max.max(psi);
+        }
+    })
+}
+
+/// A compile failed: undo the depth so later reads still count.
+pub fn abort() {
+    S.with(|s| {
+        let mut s = s.borrow_mut();
+        if s.enabled {
+            s.depth = s.depth.saturating_sub(1);
+        }
+    });
+}
+
+/// Quadrature ran post-mint inside `panel`, at phase `psi` (the expensive `node` arithmetic).
+#[inline]
+pub fn quad(ptr: usize, panel: usize, psi: i128) {
+    with_row(ptr, Some((panel as u32, psi as u64)), None, false, false);
+}
+
+/// A precomputed `.sum` word was read at `panel` (bisection mid, table read, totals).
+#[inline]
+pub fn probe(ptr: usize, panel: usize) {
+    with_row(ptr, None, Some(panel as u32), false, false);
+}
+
+/// A passage tail panel's quadrature ran (`quad`) or its entry was only partitioned.
+#[inline]
+pub fn tail(ptr: usize, quad: bool) {
+    with_row(ptr, None, None, quad, !quad);
+}
+
+pub fn close(id: u64, interval_over_period: f64) {
+    S.with(|s| {
+        let mut s = s.borrow_mut();
+        if !s.enabled || id == u64::MAX {
+            return;
+        }
+        let row = match s.rows.get_mut(id as usize) {
+            Some(row) => row,
+            None => return,
+        };
+        row.closed = true;
+        row.interval_over_period = interval_over_period;
+    });
+}
+
+pub fn id_of(kind: u8, ptr: usize) -> u64 {
+    S.with(|s| s.borrow().by_ptr.get(&(kind, ptr)).copied().unwrap_or(u64::MAX))
+}
+
+/// Finalize counters into the rows (call once, after the run). Returns (rows, ptr-reuse events, mints).
+pub fn seal() -> (Vec<Row>, u32, u64) {
+    S.with(|s| {
+        let mut s = s.borrow_mut();
+        let mut st = &mut *s;
+        for (rec, row) in st.recs.iter_mut().zip(st.rows.iter_mut()) {
+            row.quad_panels = rec.quad_panels.len() as u32;
+            row.probe_panels = rec.probe_panels.len() as u32;
+            if rec.psi_max >= rec.psi_min {
+                row.psi_min = rec.psi_min;
+                row.psi_max = rec.psi_max;
+            } else {
+                row.psi_min = 0;
+                row.psi_max = 0;
+            }
+        }
+        let reuse = s.reuse;
+        let total = s.next_id;
+        (s.rows.clone(), reuse, total)
+    })
+}
