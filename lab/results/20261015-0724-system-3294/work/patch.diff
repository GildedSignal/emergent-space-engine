@@ -0,0 +1,110 @@
+//! Digest-neutral counters for the kick census (lab run 20261015-0724-system-3294). Nothing here
+//! reads back into the law: every function is a write to a counter, and no behaviour branches on it.
+//!
+//! The question: what does a kick of the metronome actually carry? Each kick quantizes its impulse
+//! against the velocity word and fires (rebinds) only when at least one unit flips; the sub-quantum
+//! part is carried (sigma-delta). The census counts, per kind and doll, kick events, fires, the
+//! fired impulse's size in word units (log2 buckets), and the tick and body of every fire (the
+//! phase structure of the stream: the standing wave train).
+use crate::body::Kind;
+use crate::num::Tick;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Mutex;
+
+/// (kind as u8, root as u8) -> index. Planet 0, Moon 1, Ship 2, Player 3; root doll is `doll == 0`
+/// (the plane's star doll).
+fn slot(kind: Kind, root: bool) -> usize {
+    2 * (match kind {
+        Kind::Planet => 0,
+        Kind::Moon => 1,
+        Kind::Ship => 2,
+        Kind::Player => 3,
+    }) + root as usize
+}
+
+pub const NAMES: [&str; 8] = [
+    "planet/child", "planet/root", "moon/child", "moon/root", "ship/child", "ship/root", "player/child", "player/root",
+];
+
+static KICKS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+static FIRED: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+/// Fires by floor(log2(|dvq| in word units)), per slot: bucket 0 is |dvq| = 1, 7 is >= 128.
+static DV: [[AtomicU64; 8]; 8] = [const { [const { AtomicU64::new(0) }; 8] }; 8];
+/// The non-clock (SyMBA-level) kick path, for completeness.
+static NC_KICKS: AtomicU64 = AtomicU64::new(0);
+static NC_FIRED: AtomicU64 = AtomicU64::new(0);
+
+/// Every fire's (tick, body id), the phase structure of the stream. Capped; a full cap is reported.
+static TRAIN: Mutex<Option<Vec<(Tick, u64)>>> = Mutex::new(None);
+pub const TRAIN_CAP: usize = 4_000_000;
+
+/// One kick event: whether it fired, and the impulse in word units when it did.
+pub fn kick(kind: Kind, root: bool, fired: bool, dv_units: u64, t: Tick, id: usize) {
+    let s = slot(kind, root);
+    KICKS[s].fetch_add(1, Ordering::Relaxed);
+    if !fired {
+        return;
+    }
+    FIRED[s].fetch_add(1, Ordering::Relaxed);
+    if dv_units > 0 {
+        let b = (64 - dv_units.leading_zeros() - 1).min(7) as usize; // floor(log2)
+        DV[s][b].fetch_add(1, Ordering::Relaxed);
+    }
+    if let Ok(mut g) = TRAIN.lock() {
+        if let Some(v) = g.as_mut() {
+            if v.len() < TRAIN_CAP {
+                v.push((t, id as u64));
+            }
+        }
+    }
+}
+
+/// One kick event of the non-clock path (the levelled changeover). Recorded in the same per-kind
+/// arrays (kicks, fires, impulse buckets, train); the levelled count is kept separately so the two
+/// paths stay distinguishable in the report.
+pub fn kick_levelled(kind: Kind, root: bool, fired: bool, dv_units: u64, t: Tick, id: usize) {
+    NC_KICKS.fetch_add(1, Ordering::Relaxed);
+    kick(kind, root, fired, dv_units, t, id);
+    if fired {
+        NC_FIRED.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// The tick of every fire, for the train histogram (empty before any flight).
+pub fn train() -> Vec<(Tick, u64)> {
+    TRAIN.lock().map(|g| g.as_ref().cloned().unwrap_or_default()).unwrap_or_default()
+}
+
+/// One line a script can parse.
+pub fn line() -> String {
+    let mut s = String::from("census:");
+    for i in 0..8 {
+        let (k, f) = (KICKS[i].load(Ordering::Relaxed), FIRED[i].load(Ordering::Relaxed));
+        if k == 0 {
+            continue;
+        }
+        let buckets: Vec<u64> = DV[i].iter().map(|a| a.load(Ordering::Relaxed)).collect();
+        s.push_str(&format!(
+            " {} kicks={} fired={} fire_rate={:.3e} dv_log2={:?}",
+            NAMES[i], k, f, f as f64 / k as f64, buckets
+        ));
+    }
+    s.push_str(&format!(" levelled kicks={} fired={}", NC_KICKS.load(Ordering::Relaxed), NC_FIRED.load(Ordering::Relaxed)));
+    s
+}
+
+/// Reset (the example builds once; this keeps re-runs in one process honest).
+pub fn reset() {
+    for i in 0..8 {
+        KICKS[i].store(0, Ordering::Relaxed);
+        FIRED[i].store(0, Ordering::Relaxed);
+        for b in 0..8 {
+            DV[i][b].store(0, Ordering::Relaxed);
+        }
+    }
+    NC_KICKS.store(0, Ordering::Relaxed);
+    NC_FIRED.store(0, Ordering::Relaxed);
+    if let Ok(mut g) = TRAIN.lock() {
+        *g = Some(Vec::new());
+    }
+}
