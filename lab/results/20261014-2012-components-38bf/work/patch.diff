 const FRAME_TAIL_NS: u64 = 50_000;
 
+/// The most ship items one player-item pull resolves (`ES_PULL_CAP`, read once; unset: unbounded, the shipped behaviour).
+fn pull_cap() -> u64 {
+    static CAP: std::sync::LazyLock<u64> = std::sync::LazyLock::new(|| {
+        std::env::var("ES_PULL_CAP").ok().and_then(|s| s.parse().ok()).unwrap_or(u64::MAX)
+    });
+    *CAP
+}
+
