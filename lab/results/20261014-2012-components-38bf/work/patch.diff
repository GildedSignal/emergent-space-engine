+//! The input seam inside a kick wave: what one player decision costs when it lands in one
+//! (20261014-2012-components-38bf). The wave is the belt's first kicks (all bodies born at tick 0:
+//! game 13,377-14,473 s at N=2×10⁵, seed 1; `belt_first` measures it), and the player burning at L8
+//! from frame 60 is in the root doll by then, so every one of its items pulls the due ships
+//! (`pull_ships`). `ES_PULL_CAP` (engine patch) bounds that pull; this bench flies the wave three
+//! ways with the cap on: `plain` (no further input), `one` (one no-op decision — the same word the
+//! burn already holds — at the wave's p50, game 14,072 s), `held` (that no-op decision every frame
+//! of the p01-p99 window: the adversarial upper bound; the shipped page calls `input` only on a key
+//! change, `session.rs:118`). A no-op decision must move no bit: `plain` vs `one`/`held` compare the
+//! physics counters (the digest also hashes the input log, so it cannot be compared directly), and
+//! `plain` with and without the cap must give one digest (the cap is default-neutral).
+//!
+//! cargo run --release -p emergent-universe --example wave_input [-- <N> <plain|one|held> [wall s [rtf [budget ms]]]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+/// The wave's arrival window at N=2×10⁵, seed 1 (taleb-6138's `belt_first`: p01, p50, p99), game seconds.
+const WIN: (f64, f64, f64) = (13_377.0, 14_072.0, 14_473.0);
+/// The flight's canonical cut, game seconds: past the wave, before the second (26-29 k s).
+const CUT_S: f64 = 16_000.0;
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(200_000);
+    let mode = args.get(2).cloned().unwrap_or_else(|| "plain".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(175.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms: f64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(12.0);
+    let frames = (seconds * 60.0) as usize;
+    let cut = (CUT_S / TICK_SECONDS) as i64;
+    let cap = std::env::var("ES_PULL_CAP").unwrap_or_else(|_| "unset".into());
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    println!("N={n} mode={mode} rtf={rtf} budget={budget_ms} ms cap={cap} cut={CUT_S:.0} game-s; build {:.1} s", t0.elapsed().as_secs_f64());
+    let mut rows: Vec<(usize, f64, u64, f64)> = Vec::new(); // frame, engine ms, events, lag game-s
+    let mut ins: Vec<(usize, f64, u64)> = Vec::new(); // frame, input ms, events resolved inside
+    let mut fired = false;
+    let mut doll_at: Vec<(usize, u16)> = Vec::new();
+    let mut held_max = 0usize;
+    let s0;
+    {
+        let t = p.u.now;
+        p.u.input(t, word(1, 8)).unwrap(); // the burn, as the ladder flies it
+        s0 = p.u.stats;
+    }
+    for f in 0..frames {
+        let game_s = p.u.now as f64 * TICK_SECONDS;
+        if std::env::var("WI_DEBUG").is_ok() && f % 10 == 0 {
+            println!("[dbg f={f} game_s={game_s:.0}]");
+        }
+        // the decision under test: the same word the burn already holds (a no-op), inside the wave
+        let want = match mode.as_str() {
+            "one" => !fired && game_s >= WIN.1,
+            "held" => (WIN.0..=WIN.2).contains(&game_s),
+            _ => false,
+        };
+        if want {
+            fired = true;
+            let before = p.u.stats.events();
+            let t = Instant::now();
+            let r = p.u.input(p.u.now, word(1, 8));
+            ins.push((f, t.elapsed().as_secs_f64() * 1e3, p.u.stats.events() - before));
+            if let Err(e) = r {
+                println!("input refused at frame {f}: {e:?}");
+                break;
+            }
+        }
+        let start = Instant::now();
+        let frame = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)) }, cut);
+        rows.push((f, start.elapsed().as_secs_f64() * 1e3, frame.events, (frame.target - frame.presented) as f64 * TICK_SECONDS));
+        held_max = held_max.max(p.u.held_scans());
+        let rec = p.u.rec(p.player);
+        if doll_at.last().map(|d| d.1) != Some(rec.b.doll) {
+            doll_at.push((f, rec.b.doll));
+        }
+        if !rec.alive {
+            println!("player lost at frame {f}");
+            break;
+        }
+        if p.u.now >= cut {
+            break;
+        }
+    }
+    let settle = Instant::now();
+    p.u.settle(cut);
+    let s1 = p.u.stats;
+    let digest = p.u.digest();
+    let mut ms: Vec<f64> = rows.iter().map(|r| r.1).collect();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let over = rows.iter().filter(|r| r.1 > budget_ms).count();
+    let lag = rows.iter().map(|r| r.3).fold(0.0, f64::max);
+    let imax = ins.iter().enumerate().max_by(|a, b| a.1 .1.total_cmp(&b.1 .1));
+    println!(
+        "frames {} (settled at cut in {:.1} s): engine ms p50 {:.3} p90 {:.3} p99 {:.3} max {:.3}; over {budget_ms} ms: {over}; worst lag {lag:.3} game-s; scans held max {held_max}",
+        rows.len(), settle.elapsed().as_secs_f64(), pct(&ms, 0.5), pct(&ms, 0.9), pct(&ms, 0.99), pct(&ms, 1.0)
+    );
+    println!(
+        "inputs: {} calls, p50 {:.3} ms, max {:.3} ms (frame {}), events inside one: max {}; total {:.1} ms",
+        ins.len(),
+        if ins.is_empty() { 0.0 } else { { let mut v: Vec<f64> = ins.iter().map(|i| i.1).collect(); v.sort_by(|a, b| a.partial_cmp(b).unwrap()); pct(&v, 0.5) } },
+        imax.as_ref().map_or(0.0, |(_, i)| i.1),
+        imax.as_ref().map_or(usize::MAX, |(_, i)| i.0),
+        ins.iter().map(|i| i.2).max().unwrap_or(0),
+        ins.iter().map(|i| i.1).sum::<f64>(),
+    );
+    println!(
+        "physics: kicks {} events {} encounters {} decisions {} refused {}; player alive {}, doll {:?}",
+        s1.kicks - s0.kicks,
+        s1.events() - s0.events(),
+        s1.encounters - s0.encounters,
+        s1.decisions - s0.decisions,
+        s1.refused - s0.refused,
+        p.u.rec(p.player).alive,
+        p.u.rec(p.player).b.doll
+    );
+    println!("doll trace (frame, doll): {doll_at:?}");
+    let mut worst: Vec<_> = rows.clone();
+    worst.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
+    println!("worst frames (frame, ms, events, lag): {}", worst.iter().take(6).map(|r| format!("({},{:.2},{},{:.2})", r.0, r.1, r.2, r.3)).collect::<Vec<_>>().join(" "));
+    println!("digest {digest}");
+    println!(
+        "waveinput: n={n} mode={mode} cap={cap} frames={} over={over} max_ms={:.3} p99_ms={:.3} lag_s={lag:.3} inputs={} input_max_ms={:.3} input_max_events={} kicks={} events={} encounters={} decisions={} digest={digest} wall_s={:.1}",
+        rows.len(), pct(&ms, 1.0), pct(&ms, 0.99), ins.len(), imax.as_ref().map_or(0.0, |(_, i)| i.1), ins.iter().map(|i| i.2).max().unwrap_or(0), s1.kicks - s0.kicks, s1.events() - s0.events(), s1.encounters - s0.encounters, s1.decisions - s0.decisions, t_start.elapsed().as_secs_f64()
+    );
+}
