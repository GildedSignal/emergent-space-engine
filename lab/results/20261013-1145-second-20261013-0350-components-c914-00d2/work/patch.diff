+++ b/crates/space/examples/div_bench.rs
@@ -0,0 +1,361 @@
+//! Division-floor and compile-cost probe (run 20261013-0350-components-c914).
+//!
+//! ```text
+//! cargo run --release -p emergent-space --example div_bench [-- div|compile|all]
+//! ```
+//!
+//! `div` micro-times exact wide division variants on the operand shapes
+//! `fast_quad` actually produces (dividend < 2^127, divisor in [2^20, 2^62],
+//! quotient fitting u64): the compiler's soft routine, x86 `divq`, and an
+//! exact multiply-only Newton reciprocal. `compile` times `Orbit::compile` on
+//! a tuned and a held-out (seeded) key grid and prints a checksum of the
+//! compiled increments so two builds can be compared bit for bit. With
+//! ES_DIV_HACK / ES_SQRT_HACK / ES_COS_HACK set (the patched tree's env-gated
+//! probes) one arithmetic ingredient of `fast_quad` is replaced by a cheap
+//! stand-in; timing only, never bits.
+use emergent_space::orbit::{Orbit, OrbitKey, Scalar};
+use std::time::Instant;
+
+struct Lcg(u64);
+impl Lcg {
+    fn next(&mut self) -> u64 {
+        self.0 = self
+            .0
+            .wrapping_mul(6364136223846793005)
+            .wrapping_add(1442695040888963407);
+        self.0
+    }
+}
+
+/// Exact floor(n/d) for d != 0, any n: two-limb, u64 divisor.
+/// The x86-64 arm is one `div` instruction when the high limb is below d
+/// (the quotient then fits 64 bits), else one u64 division plus that.
+#[inline(never)]
+fn div_asm(mut n: u128, d: u64) -> u128 {
+    let mut hi = (n >> 64) as u64;
+    if hi == 0 {
+        return (n as u64 / d) as u128;
+    }
+    let mut q_hi = 0u64;
+    if hi >= d {
+        q_hi = hi / d;
+        let rem = hi % d;
+        n = ((rem as u128) << 64) | (n as u64 as u128);
+        hi = (n >> 64) as u64;
+    }
+    debug_assert!(hi < d);
+    let lo = n as u64;
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        let q: u64;
+        let r: u64;
+        std::arch::asm!(
+            "div {d}",
+            inlateout("rax") lo => q,
+            inlateout("rdx") hi => r,
+            d = in(reg) d,
+            options(nostack)
+        );
+        let _ = r;
+        ((q_hi as u128) << 64) | q as u128
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    {
+        const B: u64 = 1 << 32;
+        let shift = d.leading_zeros();
+        let v = (d as u128) << shift;
+        let u = n << shift;
+        let (v1, v0) = ((v >> 32) as u64, (v as u64) & (B - 1));
+        let (u1, u0) = ((u >> 64) as u64, u as u64);
+        let digit = |upper: u64, lower: u64| -> u64 {
+            let mut q = upper / v1;
+            let mut r = upper % v1;
+            while q >= B || q * v0 > (r << 32) + lower {
+                q -= 1;
+                r += v1;
+                if r >= B {
+                    break;
+                }
+            }
+            q
+        };
+        let q1 = digit(u1, u0 >> 32);
+        let rem = (u1 << 32)
+            .wrapping_add(u0 >> 32)
+            .wrapping_sub(q1.wrapping_mul(v as u64));
+        let q0 = digit(rem, u0 & (B - 1));
+        ((q_hi as u128) << 64) | (((q1 << 32) + q0) as u128)
+    }
+}
+
+fn pairs_4096() -> Vec<(u128, u64)> {
+    // Operand shapes from fast_quad: n < 2^127 with high limb below d, d in [2^20, 2^62].
+    let mut lcg = Lcg(0x853c49e6748fea9b);
+    let mut pairs = Vec::with_capacity(1 << 12);
+    for _ in 0..1 << 12 {
+        let d = (lcg.next() % (1u64 << 62)) | (1 << 20);
+        let lo = lcg.next();
+        let hi = lcg.next() % d;
+        pairs.push(((hi as u128) << 64 | lo as u128, d));
+    }
+    pairs
+}
+fn bench_div() {
+    let pairs = pairs_4096();
+    let total = 2000u64 * pairs.len() as u64;
+    // Quotient-chained operands: each division's inputs depend on the previous
+    // quotient, so nothing can be unrolled, hoisted or constant-folded.
+    let step = |n: &mut u128, d: &mut u64, q: u128| {
+        *n = n.wrapping_mul(0x100000001b3).wrapping_add(q) | 1;
+        *d = (d.wrapping_mul(6364136223846793005) ^ (q as u64) >> 23) % (1u64 << 62) | (1 << 20);
+    };
+    let mut sink = 0u128;
+    let t = Instant::now();
+    {
+        let (mut n, mut d) = pairs[0];
+        for _ in 0..total {
+            let q = n / d as u128;
+            sink ^= q;
+            step(&mut n, &mut d, q);
+        }
+    }
+    let u128_per = t.elapsed().as_nanos() as f64 / total as f64;
+    let mut sink2 = 0u128;
+    let t = Instant::now();
+    {
+        let (mut n, mut d) = pairs[0];
+        for _ in 0..total {
+            let q = div_asm(n, d);
+            sink2 ^= q;
+            step(&mut n, &mut d, q);
+        }
+    }
+    let asm_per = t.elapsed().as_nanos() as f64 / total as f64;
+    let mut sink3 = 0i128;
+    let t = Instant::now();
+    {
+        let (mut n, mut d) = pairs[0];
+        for _ in 0..total {
+            let q = (n as i128) / (d as i128);
+            sink3 ^= q as i128 & 1;
+            step(&mut n, &mut d, q as u128);
+        }
+    }
+    let i128_per = t.elapsed().as_nanos() as f64 / total as f64;
+    let mut bad = 0u64;
+    for &(n, d) in &pairs {
+        if div_asm(n, d) != n / d as u128 {
+            bad = 1;
+        }
+    }
+    println!("div u128/u128 : {:.2} ns", u128_per);
+    println!("div i128/i128 : {:.2} ns", i128_per);
+    println!("div asm/divq  : {:.2} ns  (mismatches: {})", asm_per, bad);
+    println!("sinks {} {} {}", sink & 1, sink2 & 1, sink3 & 1);
+}
+
+// Exact floor(n/d) via multiply-only reciprocal, for d in [2^20, 2^63):
+// m = ceil(2^128/d) from an f64 seed pushed above, refined by integer Newton
+// steps with delta = d*m - 2^128 tracked exactly, pinned at ceil, then
+// q^ = floor(m*n / 2^128), provably in {q, q+1}; one correction closes it.
+fn mul_hi(a: u128, b: u128) -> u128 {
+    // floor(a*b / 2^128) exactly, from the 256-bit product's high half.
+    const M: u128 = u64::MAX as u128;
+    let (a1, a0, b1, b0) = (a >> 64, a & M, b >> 64, b & M);
+    let p00 = a0 * b0;
+    let p01 = a0 * b1;
+    let p10 = a1 * b0;
+    let p11 = a1 * b1;
+    let mid = (p00 >> 64) + (p01 & M) + (p10 & M);
+    p11 + (p01 >> 64) + (p10 >> 64) + (mid >> 64)
+}
+// Exact d*m - 2^128 (None when negative), from the 192-bit product's limbs.
+fn dm_excess(d: u64, m: u128) -> Option<u128> {
+    let hi = (d as u128) * (m >> 64);
+    let lo = (d as u128).wrapping_mul(m & u64::MAX as u128);
+    // d*m = hi*2^64 + lo (exact). Compare against 2^128 limbwise.
+    if hi > (1u128 << 64) {
+        Some(((hi - (1u128 << 64)) << 64).wrapping_add(lo))
+    } else if hi == (1u128 << 64) {
+        Some(lo)
+    } else {
+        let need = ((1u128 << 64) - hi) << 64;
+        if lo >= need {
+            Some(lo - need)
+        } else {
+            None
+        }
+    }
+}
+fn div_newton(n: u128, d: u64) -> u128 {
+    // Seed: 2^128/d in f64 (power-of-two numerator: only 1/d rounds), pushed up
+    // twice and padded by 2^16 so m starts ABOVE ceil(2^128/d) by <= ~2^16 + 2^13,
+    // keeping the excess below ~2^78 and every limb shift inside u128.
+    let mut m = {
+        let mut x = f64::from_bits(0x47F0000000000000) / d as f64;
+        x = x.next_up().next_up();
+        (x as u128).saturating_add(1 << 16)
+    };
+    for _ in 0..3 {
+        let Some(delta) = dm_excess(d, m) else {
+            break; // below the target: the pins below finish the job
+        };
+        if delta >> 127 != 0 {
+            break;
+        }
+        let step = mul_hi(m, delta) + 1;
+        if step == 0 || step >= m {
+            break;
+        }
+        m -= step;
+    }
+    // Pin m = ceil(2^128/d) exactly: d*m >= 2^128 and d*(m-1) < 2^128.
+    for _ in 0..64 {
+        if m <= 1 || dm_excess(d, m - 1).is_none() {
+            break;
+        }
+        m -= 1;
+    }
+    for _ in 0..64 {
+        if dm_excess(d, m).is_some() {
+            break;
+        }
+        m += 1;
+    }
+    let mut q = mul_hi(m, n);
+    if q > 0 && q.wrapping_mul(d as u128) > n {
+        q -= 1;
+    }
+    q
+}
+
+fn bench_newton() {
+    let pairs = pairs_4096();
+    let adv: Vec<(u128, u64)> = vec![
+        (u128::MAX, (1 << 62) - 1),
+        ((1u128 << 126) - 1, (1 << 20) | 1),
+        (((1u128 << 62) - 1) << 64 | u64::MAX as u128, (1 << 62) - 1),
+        ((1u128 << 120) | 12345, (1 << 40) + (1 << 21) + 3),
+        (u128::MAX - 1, (1 << 61) + (1 << 60)),
+        (1u128 << 104, (1 << 42) + 1),
+        (((1u128 << 62) - 1) << 62, (1 << 60) + 7),
+        (u128::MAX, 3),
+        ((1u128 << 100) - 5, 5),
+    ];
+    let mut bad = 0u64;
+    for &(n, d) in pairs.iter().chain(adv.iter()) {
+        let got = div_newton(n, d);
+        let want = n / d as u128;
+        if got != want {
+            bad += 1;
+            if bad < 5 {
+                println!("MISMATCH n={:032x} d={:016x} got {:032x} want {:032x}", n, d, got, want);
+            }
+        }
+    }
+    let total = 2000u64 * pairs.len() as u64;
+    let mut sink = 0u128;
+    let t = Instant::now();
+    {
+        let (mut n, mut d) = pairs[0];
+        for _ in 0..total {
+            let q = div_newton(n, d);
+            sink ^= q;
+            n = n.wrapping_mul(0x100000001b3).wrapping_add(q) | 1;
+            d = (d.wrapping_mul(6364136223846793005) ^ (q as u64) >> 23) % (1u64 << 62) | (1 << 20);
+        }
+    }
+    let per = t.elapsed().as_nanos() as f64 / total as f64;
+    println!(
+        "div newton    : {:.2} ns  (mismatches: {} of {})",
+        per,
+        bad,
+        pairs.len() + adv.len()
+    );
+    let _ = sink & 1;
+}
+
+fn bench_compile(which: &str) {
+    let unit: u64 = 1 << 48;
+    let mut keys = Vec::new();
+    if which == "tuned" {
+        for radius_exp in -4i32..=20 {
+            for &e in &[0.02f64, 0.1, 0.3, 0.5, 0.7, 0.9, 0.94, 0.97, 0.99] {
+                let p = Scalar::integer(16).scale(radius_exp).expect("scale in range");
+                if let Ok(key) = OrbitKey::bound(p, (e * unit as f64) as u64) {
+                    keys.push(key);
+                }
+            }
+        }
+    } else {
+        // Held-out grid: seeded uniform eccentricity and octave, mantissa varied.
+        let mut lcg = Lcg(0xda3e39cb94b95bdb);
+        for _ in 0..250 {
+            let e_q48 = (1u64 << 44) + lcg.next() % ((0.985 * unit as f64) as u64 - (1 << 44));
+            let radius_exp = -6 + (lcg.next() % 31) as i32;
+            let mantissa = 8 + lcg.next() % 17;
+            let p = Scalar::integer(mantissa as i64)
+                .scale(radius_exp)
+                .expect("scale");
+            if let Ok(key) = OrbitKey::bound(p, e_q48) {
+                keys.push(key);
+            }
+        }
+    }
+    let mut times = Vec::new();
+    let mut checksum: u128 = 0;
+    let mut ok = 0u64;
+    let mut refused = 0u64;
+    let mut panels: u64 = 0;
+    for &key in &keys {
+        let t = Instant::now();
+        let orbit = match Orbit::compile(key) {
+            Ok(o) => o,
+            Err(_) => {
+                refused += 1;
+                continue;
+            }
+        };
+        times.push(t.elapsed().as_nanos() as u64);
+        ok += 1;
+        panels += orbit.shape().knots().len().saturating_sub(1) as u64;
+        let period = orbit.period().expect("period");
+        let advance = orbit.advance().expect("advance");
+        checksum = checksum
+            .rotate_left(7)
+            ^ (period.significand() as u128)
+            ^ ((period.exponent() as u128) << 96)
+            ^ (advance.significand() as u128).rotate_left(29)
+            ^ ((advance.exponent() as u128) << 109);
+    }
+    times.sort();
+    let n = times.len();
+    let median = times[n / 2] as f64 / 1000.0;
+    let p90 = times[(n as f64 * 0.90) as usize] as f64 / 1000.0;
+    let total: f64 = times.iter().sum::<u64>() as f64 / 1000.0;
+    let per_node = if panels > 0 {
+        total * 1000.0 / (4.0 * panels as f64)
+    } else {
+        0.0
+    };
+    println!(
+        "compile[{}] ok={} refused={} panels={} median {:.2} us  p90 {:.2} us  total {:.1} us  per-node {:.1} ns",
+        which, ok, refused, panels, median, p90, total, per_node
+    );
+    println!("checksum[{}] {:032x}", which, checksum);
+}
+
+fn main() {
+    let mode = std::env::args().nth(1).unwrap_or_else(|| "all".into());
+    if let Ok(load) = std::fs::read_to_string("/proc/loadavg") {
+        println!("loadavg {}", load.trim());
+    }
+    if mode == "div" || mode == "all" {
+        bench_div();
+        bench_newton();
+    }
+    if mode == "compile" || mode == "all" {
+        bench_compile("tuned");
+        bench_compile("heldout");
+    }
+}
