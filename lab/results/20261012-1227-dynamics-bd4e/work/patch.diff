+    /// Lab run 20261012-1227-dynamics-bd4e (dynamics lens), probe not a gate: the error TYPE of the
+    /// signed Jacobi trace. `beta` is the slope of ln D(tau) vs ln tau over the top decade of lags,
+    /// D(tau) = mean_k (e_{k+tau} − e_k)²: a bounded error saturates (beta → 0), a random walk
+    /// gives 1, a ballistic drift 2. `z` is the t-statistic of the mean increment over the second
+    /// half: z > 3 says the increments carry a systematic sign (drift), not only dispersion.
+    fn error_type(e: &[f64]) -> (f64, f64) {
+        let n = e.len();
+        let mut pts = Vec::new();
+        let mut tau = 2.0f64;
+        while (tau as usize) <= n / 2 {
+            let g = tau as usize;
+            let d = (0..n - g).map(|k| (e[k + g] - e[k]).powi(2)).sum::<f64>() / (n - g) as f64;
+            if d > 0.0 {
+                pts.push(((g as f64).ln(), 0.5 * d.ln()));
+            }
+            tau *= 1.3;
+        }
+        let top = ((n / 20) as f64).ln();
+        let beta = slope_of(&pts.iter().filter(|p| p.0 >= top).copied().collect::<Vec<_>>());
+        let h: Vec<f64> = e[n / 2..].windows(2).map(|w| w[1] - w[0]).collect();
+        let (m, mean) = (h.len() as f64, h.iter().sum::<f64>() / h.len() as f64);
+        let sd = (h.iter().map(|x| (x - mean).powi(2)).sum::<f64>() / (m - 1.0)).sqrt();
+        (beta, if sd > 0.0 { mean.abs() * m.sqrt() / sd } else { 0.0 })
+    }
