+    /// The slope of a least-squares line through `pts`, NaN if it has none.
+    fn slope_of(pts: &[(f64, f64)]) -> f64 {
+        if pts.len() < 3 {
+            return f64::NAN;
+        }
+        let m = pts.len() as f64;
+        let (mx, my) = (pts.iter().map(|p| p.0).sum::<f64>() / m, pts.iter().map(|p| p.1).sum::<f64>() / m);
+        let sxx = pts.iter().map(|p| (p.0 - mx).powi(2)).sum::<f64>();
+        if sxx <= 0.0 { f64::NAN } else { pts.iter().map(|p| (p.0 - mx) * (p.1 - my)).sum::<f64>() / sxx }
+    }
