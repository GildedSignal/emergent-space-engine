++/// The seam behind `ES_LAZY_ENTRY` (off by default; the plane is shipped verbatim): a binding's
++/// compiled trajectory is a cache of the exact key it was compiled from (PRINCIPLES 6: store the
++/// generator, not the generated), so a kick-settled binding may hold only the key and re-mint the
++/// entry on touch. [`EntrySlot::Live`] is the shipped state; [`EntrySlot::Demoted`] holds the
++/// exact key, the sense and the unit, and never took a catalogue slot (`tube.key` is `u32::MAX`,
++/// which [`Catalogue::release`] ignores).
++#[derive(Clone, Debug)]
++pub enum EntrySlot {
++    Live(Arc<Entry>),
++    /// The compiled trajectory is gone (with its catalogue slot): the exact key, sense and unit.
++    Demoted { key: OrbitKey, clockwise: bool, unit: Unit },
++}
++
++impl EntrySlot {
++    /// The entry, re-minted from the key when demoted (one pure `Orbit::compile`: a promotion).
++    pub fn entry(&self) -> Res<Arc<Entry>> {
++        match self {
++            EntrySlot::Live(e) => Ok(e.clone()),
++            EntrySlot::Demoted { key, clockwise, unit } => {
++                let t0 = std::time::Instant::now();
++                let orbit = Orbit::compile(*key)?;
++                let e = Arc::new(Entry { trajectory: Trajectory::Cycle(orbit), clockwise: *clockwise, unit: *unit });
++                note_promotion(t0.elapsed());
++                Ok(e)
++            }
++        }
++    }
++    /// The doll-mass unit of the entry, without minting anything.
++    pub fn unit(&self) -> Unit {
++        match self { EntrySlot::Live(e) => e.unit, EntrySlot::Demoted { unit, .. } => *unit }
++    }
++    /// The trajectory's exact key if it has one (a demoted slot is its key), without minting.
++    pub fn key(&self) -> Option<OrbitKey> {
++        match self {
++            EntrySlot::Live(e) => e.trajectory.key(),
++            EntrySlot::Demoted { key, .. } => Some(*key),
++        }
++    }
++    pub fn is_cycle(&self) -> bool {
++        match self { EntrySlot::Live(e) => matches!(e.trajectory, Trajectory::Cycle(_)), EntrySlot::Demoted { .. } => true }
++    }
++}
