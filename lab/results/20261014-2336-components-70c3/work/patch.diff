+/// Linux lab boxes: VmRSS/VmHWM under-report versus the footprint (no compressed pages); stated in the run's domain.
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let read = |key: &str| -> u64 {
+        std::fs::read_to_string("/proc/self/status")
+            .unwrap_or_default()
+            .lines()
+            .find(|l| l.starts_with(key))
+            .and_then(|l| {
+                l[(key.len() + 1)..]
+                    .split_whitespace()
+                    .next()
+                    .and_then(|v| v.parse::<u64>().ok())
+            })
+            .unwrap_or(0)
+            * 1024
+    };
+    (read("VmRSS:"), read("VmHWM:"))
+}
