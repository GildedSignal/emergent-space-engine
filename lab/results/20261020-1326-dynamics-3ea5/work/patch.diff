+                            if rr <= r_sub {
+                                in_band[i] = 4;
+                                n_sub += 1;
+                            }
+                        }
+                    }
+                }
+            }
+            let km = mo.k[0].abs().max(mo.k[1].abs());
+            if km > maxk_seen {
+                maxk_seen = km;
+            }
+        }
+        step.kick(&dks).expect("gravity kick within the law's ranges");
+        if t % stride == 0 {
+            let (mut ct_tot, mut ct_near_m, mut ct_zone_m, mut ct_sub_m) = (0u64, 0u64, 0u64, 0u64);
+            let (mut cl_zone, mut cl_sub) = (0u64, 0u64);
+            for i in 0..nb {
+                let dc = ct[i] - ct_prev[i];
+                let dl = cl[i] - cl_prev[i];
+                ct_tot += dc;
+                if in_band[i] >= 1 {
+                    ct_near_m += dc;
+                }
+                if in_band[i] >= 2 {
+                    ct_zone_m += dc;
+                    cl_zone += dl;
+                    zone_strides[i] += 1;
+                }
+                if in_band[i] >= 4 {
+                    ct_sub_m += dc;
+                    cl_sub += dl;
+                    sub_strides[i] += 1;
+                    if first_sub[i] == 0 {
+                        first_sub[i] = t;
+                    }
+                    last_sub[i] = t;
+                }
+                ct_prev[i] = ct[i];
+                cl_prev[i] = cl[i];
+            }
+            cbuf.push_str(&format!(
+                "{t} {n_live} {esc} {n_near} {n_zone} {n_q1} {n_sub} {ct_tot} {ct_near_m} {ct_zone_m} {ct_sub_m} {cl_zone} {cl_sub} {ke_near} {sr2_near} {ke_all} {maxk_seen}\n"
+            ));
+        }
+        if t == 49152 || t == 98304 {
+            ck.push_str(&format!(
+                "# ck{t} contacts={} walls={} digest={}\n",
+                step.log().contacts,
+                step.log().walls,
+                step.log().digest()
+            ));
+            eprintln!("{ck}");
+        }
+        if t % 8192 == 0 {
+            eprintln!("t={t} contacts={c} esc={esc} n_sub={n_sub} n_zone={n_zone}");
+        }
+    }
+    let log = step.log();
+    let mut head = format!(
+        "# scene=coretail n={n} m={m} seed={seed} horizon={horizon} thermal={thermal} stride={stride} pass={pass} q={Q} mu={MU} law=RelativisticV1 r_near=20q r_zone=2.1q r_q1=1q r_sub=0.5q r_esc=250q dk_cap={}\n# contacts={} walls={} digest={}\n",
+        DK_CAP, log.contacts, log.walls, log.digest()
+    );
+    head.push_str(&ck);
+    let mut bbuf = String::with_capacity(96 * nb);
+    bbuf.push_str("# id ring dead_t unbound_t first_clamp_t cl_total ct_total min_r_raw sub_strides first_sub last_sub zone_strides\n");
+    for i in 0..nb {
+        bbuf.push_str(&format!(
+            "{} {} {} {} {} {} {} {} {} {} {} {}\n",
+            i as u64 + 1,
+            ring_of[i],
+            dead_t[i],
+            unbound_t[i],
+            first_clamp_t[i],
+            cl[i],
+            ct[i],
+            min_r[i],
+            sub_strides[i],
+            first_sub[i],
+            last_sub[i],
+            zone_strides[i]
+        ));
+    }
+    std::fs::write(format!("{out}.head"), &head).expect("write head");
+    std::fs::write(format!("{out}.core.tsv"), &cbuf).expect("write core");
+    std::fs::write(format!("{out}.events.tsv"), &ebuf).expect("write events");
+    std::fs::write(format!("{out}.body.tsv"), &bbuf).expect("write body");
+    eprintln!("{head}");
+}
