+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+// Lab instrument 20261018-1237-components-271c: a division-free exact isqrt arm
+// (bit-identical by construction: floor(sqrt) is unique) plus census counters,
+// both inert unless switched on. Shipped paths are untouched when the flag is off.
+static ISQRT_FAST: AtomicBool = AtomicBool::new(false);
+static CENSUS: AtomicBool = AtomicBool::new(false);
+pub static CENSUS_FAST_NODES: AtomicU64 = AtomicU64::new(0);
+pub static CENSUS_SLOW_NODES: AtomicU64 = AtomicU64::new(0);
+pub static CENSUS_WEAK_NODES: AtomicU64 = AtomicU64::new(0);
+pub static CENSUS_WORD_NODES: AtomicU64 = AtomicU64::new(0);
+pub static CENSUS_WIDE_ISQRT: AtomicU64 = AtomicU64::new(0);
+pub static CENSUS_WIDE_ITERS: AtomicU64 = AtomicU64::new(0);
+pub static CENSUS_U64_ISQRT: AtomicU64 = AtomicU64::new(0);
+
+pub fn set_isqrt_fast(on: bool) {
+    ISQRT_FAST.store(on, Ordering::Relaxed);
+}
+pub fn isqrt_fast_enabled() -> bool {
+    ISQRT_FAST.load(Ordering::Relaxed)
+}
+pub fn set_census(on: bool) {
+    CENSUS.store(on, Ordering::Relaxed);
+}
+fn census() -> bool {
+    CENSUS.load(Ordering::Relaxed)
+}
+
+/// floor(sqrt(x)) with one hardware division per Newton step instead of the
+/// shipped `u128/128` software division chain: f64 seed of the full operand,
+/// two steps (the seed's ~2^-52 squares away), then exact floor correction.
+/// Any implementation of floor is interchangeable: bit-identical by construction.
+pub fn isqrt_mul(x: u128) -> u128 {
+    if x < 2 {
+        return x;
+    }
+ // Past the largest u64 square the floor is u64::MAX itself.
+    if x >= (u64::MAX as u128) * (u64::MAX as u128) {
+        return u64::MAX as u128;
+    }
+    // Seed from above: f64 sqrt has ~2^-52 relative error, y <= 2^64 - 1 here.
+    let mut y = (x as f64).sqrt() as u128 + 2;
+    for _ in 0..2 {
+        // x/y fits u64: y ~ sqrt(x) > x >> 64 for every x < 2^128.
+        let q = div_word(x, y as u64) as u128;
+        y = (y + q) >> 1;
+    }
+    while y > 0 && y.checked_mul(y).map_or(true, |s| s > x) {
+        y -= 1;
+    }
+    while let Some(y1) = y.checked_add(1) {
+        match y1.checked_mul(y1) {
+            Some(s) if s <= x => y = y1,
+            _ => break,
+        }
+    }
+    y
+}
+
+/// floor(sqrt(x)) for u64 without std's Newton division: f64 seed (error < 1
+/// unit at 32 output bits) plus exact bounded floor correction.
+pub fn isqrt_u64_mul(x: u64) -> u64 {
+    if x < 2 {
+        return x;
+    }
+    let mut y = (x as f64).sqrt() as u64;
+    while y > 0 && (y as u128) * (y as u128) > x as u128 {
+        y -= 1;
+    }
+    while ((y + 1) as u128) * ((y + 1) as u128) <= x as u128 {
+        y += 1;
+    }
+    y
+}
 
