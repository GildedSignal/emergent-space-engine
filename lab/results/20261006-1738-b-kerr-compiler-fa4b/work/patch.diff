+#[test]
+fn penrose_split_conservES_and_gains_inside() {
+    let chi = q(0.9);
+    let r = q(1.7); // between the horizon and 2: the canonical Penrose case
+    let (alpha, omega, sg) = spin::zamo(chi, r).unwrap();
+    let vphi = q(0.6);
+    let gamma = Scalar::ONE.div(Scalar::ONE.sub(vphi.mul(vphi).unwrap()).unwrap().sqrt().unwrap()).unwrap();
+    let l0 = sg.mul(gamma).unwrap().mul(vphi).unwrap();
+    let e0 = alpha.mul(gamma).unwrap().add(omega.mul(l0).unwrap()).unwrap();
+    let [(ef, lf), (eb, lb)] = spin::split(chi, e0, l0, r).unwrap();
+    // E and L conserved: the fragments' sum is the body within the truncation of a few
+    // products (the gate allows 8 f64 rounding errors; this is far below that)
+    let (se, sl) = (d(ef) + d(eb), d(lf) + d(lb));
+    assert!((se - d(e0)).abs() < 1e-15 * d(e0).abs().max(1.0), "E conserved");
+    assert!((sl - d(l0)).abs() < 1e-15 * d(l0).abs().max(1.0), "L conserved");
+    assert!(d(ef) > d(e0), "the forward photon gains energy inside the ergosphere");
+    assert!(eb.significand() < 0, "the backward photon carries negative energy");
+    // outside the ergosphere nothing is gained
+    let (alpha, omega, sg) = spin::zamo(chi, q(4.0)).unwrap();
+    let l0 = sg.mul(gamma).unwrap().mul(vphi).unwrap();
+    let e0 = alpha.mul(gamma).unwrap().add(omega.mul(l0).unwrap()).unwrap();
+    let [(ef, _), (eb, _)] = spin::split(chi, e0, l0, q(4.0)).unwrap();
+    assert!(d(ef) < d(e0) && eb.significand() > 0);
+}
