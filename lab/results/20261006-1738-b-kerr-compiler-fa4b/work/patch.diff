+#[test]
+fn tube_rates_match_the_golden_state() {
+    // (χ=0.9, r=1.6, ZAMO v_φ = 0.6): golden.json holds the metric-level values.
+    let chi = q(0.9);
+    let (en, l, r, phi, tau) = (
+        q(0.64923609601104023244),
+        q(1.5700816061593741249),
+        q(1.6),
+        0.31315147462340208397,
+        0.15756272576315260103,
+    );
+    let (got_phi, got_tau) = spin::tube_rates(chi, en, l, r).unwrap();
+    assert!(rel(d(got_phi), phi) < 1e-9, "dphi/dt {}", d(got_phi));
+    assert!(rel(d(got_tau), tau) < 1e-9, "dtau/dt {}", d(got_tau));
+}
