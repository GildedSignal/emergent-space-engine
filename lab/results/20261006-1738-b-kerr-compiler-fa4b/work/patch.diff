+    // integrands from the metric-level derivation (gen_tables.py, golden.json)
+    let cases: [(f64, f64, f64, bool, f64, f64, f64); 5] = [
+        (0.9, 12.0, 0.3, true, 1.4777954755323006901, 371.84451442085488255, 327.97325336738407569),
+        (0.9, 12.0, 0.3, false, 5.1026048434532484233, 504.68056388255611768, 438.13403411011579701),
+        (0.5, 30.0, 0.6, true, 0.64346138839525514626, 2150.2643696013297092, 2079.0452916600879194),
+        (0.998, 3.2, 0.5, true, 7.5194238333352368900, 113.71833862243670081, 69.045629769430708535),
+        (0.998, 14.0, 0.1, false, 3.6085582402507649815, 513.69115534307821783, 453.26208895003877874),
