+        assert!(rel(d(c.advance), adv) < 5e-6, "advance chi={chi} p={p} e={e} pro={pro}: {} vs {adv}", d(c.advance));
+        assert!(rel(d(c.period), per) < 5e-6, "period chi={chi} p={p} e={e} pro={pro}");
+        assert!(rel(d(c.proper_period), tau) < 5e-6, "proper period chi={chi} p={p} e={e} pro={pro}");
