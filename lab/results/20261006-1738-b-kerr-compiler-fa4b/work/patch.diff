+#[test]
+fn fates_follow_the_root_structure() {
+    let chi = q(0.9);
+    // a stable bound orbit is Bound; below its angular momentum at the same energy, Plunge
+    let (en, l) = spin::bound_constants(chi, q(12.0), q(0.3), true).unwrap();
+    assert_eq!(spin::fate(chi, en, l).unwrap(), Fate::Bound);
+    assert_eq!(spin::fate(chi, en, Scalar::ONE.mul(l).unwrap().mul(q(0.5)).unwrap()).unwrap(), Fate::Plunge);
+    // E = 1 from infinity: captured below the marginally bound L of the sense, scattered above
+    let lmb = 2.0 * (1.0 + (1.0 - 0.9f64).sqrt());
+    assert_eq!(spin::fate(chi, Scalar::ONE, q(0.9 * lmb)).unwrap(), Fate::Captured);
+    assert_eq!(spin::fate(chi, Scalar::ONE, q(1.1 * lmb)).unwrap(), Fate::Scattered);
+    assert_eq!(spin::fate(chi, Scalar::ONE, q(-0.9 * lmb)).unwrap(), Fate::Captured);
+    // light: the critical belt of each sense, b_c = a + s·r_ph^{3/2}
+    for (s, pro) in [(1.0, true), (-1.0, false)] {
+        let rph = d(spin::photon_orbit(chi, pro).unwrap());
+        let bc = 0.9 + s * rph.powf(1.5);
+        assert_eq!(spin::photon_fate(chi, q(0.97 * bc)).unwrap(), Fate::Captured, "s={s}");
+        assert_eq!(spin::photon_fate(chi, q(1.03 * bc)).unwrap(), Fate::Scattered, "s={s}");
+    }
+}
