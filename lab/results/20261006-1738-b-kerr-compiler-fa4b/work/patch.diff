+#[test]
+fn clocks_match_the_closed_forms() {
+    let chi = q(0.9);
+    // the static clock is spin-independent and refuses the ergosphere
+    for r in [1.5, 2.0, 6.0, 1e4] {
+        let got = spin::static_rate(q(r));
+        if r > 2.0 {
+            let want = (1.0 - 2.0 / r).sqrt();
+            assert!(rel(d(got.unwrap()), want) < 1e-12, "static r={r}");
+        } else {
+            assert!(got.is_none(), "static r={r}");
+        }
+    }
+    // ZAMO lapse α = √(r²Δ/A) at a few radii
+    for r in [2.05, 3.0, 30.0, 1e4] {
+        let want = {
+            let (rr, a): (f64, f64) = (r, 0.9);
+            let delta = rr * rr - 2.0 * rr + a * a;
+            ((rr * rr * delta) / ((rr * rr + a * a).powi(2) - a * a * delta)).sqrt()
+        };
+        assert!(rel(d(spin::zamo_rate(chi, q(r)).unwrap()), want) < 1e-12, "zamo r={r}");
+    }
+    assert!(spin::zamo_rate(chi, q(1.4)).is_none()); // inside the horizon (r+ = 1.4359)
+}
