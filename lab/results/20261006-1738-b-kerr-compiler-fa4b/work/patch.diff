+#[test]
+fn weak_field_odd_part_is_eight_pi_lense_thirring() {
+    // The odd-in-sense part of the advance at large p approaches −8πχ(M/p)^{3/2}: this settles
+    // the coefficient the reference run measured at −8.05 ± 0.1 and could not derive.
+    let chi = 0.5;
+    let e = 0.6;
+    let p = 1600.0;
+    let pro = {
+        let (en, l) = spin::bound_constants(q(chi), q(p), q(e), true).unwrap();
+        d(spin::cycle(q(chi), en, l).unwrap().advance)
+    };
+    let retro = {
+        let (en, l) = spin::bound_constants(q(chi), q(p), q(e), false).unwrap();
+        d(spin::cycle(q(chi), en, l).unwrap().advance)
+    };
+    let odd = (pro - retro) / 2.0;
+    let want = -8.0 * std::f64::consts::PI * chi / p.powi(3).sqrt();
+    assert!(rel(odd, want) < 0.02, "LT odd part {odd} vs {want}");
+}
