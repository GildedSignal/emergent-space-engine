+#[test]
+fn frame_dragging_turns_retrograde_tubes_forward() {
+    // A tube inside the ergosphere with L < 0 still has dφ/dt > 0 (B19 criterion 3).
+    let chi = q(0.9);
+    let r = q(1.5); // inside r = 2
+    let (alpha, omega, sg) = spin::zamo(chi, r).unwrap();
+    let vphi = q(-0.5);
+    let gamma = Scalar::ONE.div(Scalar::ONE.sub(vphi.mul(vphi).unwrap()).unwrap().sqrt().unwrap()).unwrap();
+    let l = sg.mul(gamma).unwrap().mul(vphi).unwrap();
+    let en = alpha.mul(gamma).unwrap().add(omega.mul(l).unwrap()).unwrap();
+    assert!(l.significand() < 0);
+    let (phi_rate, clock_rate) = spin::tube_rates(chi, en, l, r).unwrap();
+    assert!(phi_rate.significand() > 0, "dphi/dt > 0 inside the ergosphere");
+    assert!(clock_rate.significand() > 0);
+    // and the forged same constants far outside are refused
+    assert!(spin::tube_rates(chi, en, l, q(6.0)).is_err());
