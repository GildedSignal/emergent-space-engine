+//! Tests of the rotating-hole module (`crates::space::kerr`) against independently generated
+//! references: BPT closed forms (ISCO, photon orbit) at 50 digits, golden geodesic vectors
+//! (mpmath, metric-level derivation, `lab/results/20261006-1738-b-kerr-compiler-fa4b/gen_tables.py`),
+//! the weak-field Lense–Thirring odd part, and structural physics (frame dragging, the Penrose
+//! split's exact conservation, capture belts). Floats appear here and nowhere else.
+use emergent_space::kerr::{self as spin, Fate};
+use emergent_space::scaled::Scalar;
+
+fn q(x: f64) -> Scalar {
+    // the test boundary: round to the module's own grid, as the adapter does
+    let exponent = x.abs().log2().floor() as i32;
+    Scalar::raw((x * 2f64.powi(60 - exponent)).round() as i128, exponent - 60).unwrap()
+}
+fn d(x: Scalar) -> f64 {
+    x.significand() as f64 * 2f64.powi(x.exponent() as i32 - 62)
+}
+fn rel(a: f64, b: f64) -> f64 {
+    ((a - b) / b).abs()
+}
+
+#[test]
+fn isco_matches_bardeen_press_teukolsky() {
+    // (χ, prograde ISCO, retrograde ISCO), generated at 50 digits from BPT (2.21)
+    let cases = [
+        (0.5, 4.2330025295308256773, 7.5545847145123584417),
+        (0.9, 2.3208830417618872468, 8.7173522796064893159),
+        (0.998, 1.2369706551751842902, 8.9943744548035688010),
+    ];
+    for (chi, pro, retro) in cases {
+        assert!(rel(d(spin::isco(q(chi), true).unwrap()), pro) < 1e-9, "isco pro chi={chi}");
+        assert!(rel(d(spin::isco(q(chi), false).unwrap()), retro) < 1e-9, "isco retro chi={chi}");
+    }
+    assert!(rel(d(spin::isco(q(0.0), true).unwrap()), 6.0) < 1e-9);
+}
+
+#[test]
+fn photon_orbits_match_bpt() {
+    // (χ, prograde r_ph, retrograde r_ph), from BPT (2.18) at 50 digits
+    let cases = [
+        (0.5, 2.3472963553338606977, 3.5320888862379560704),
+        (0.9, 1.5578546274233828031, 3.9102679391030367260),
+        (0.998, 1.0739092576799517017, 3.9982218928479460127),
+    ];
+    for (chi, pro, retro) in cases {
+        assert!(rel(d(spin::photon_orbit(q(chi), true).unwrap()), pro) < 1e-9, "r_ph pro chi={chi}");
+        assert!(rel(d(spin::photon_orbit(q(chi), false).unwrap()), retro) < 1e-9, "r_ph retro chi={chi}");
+    }
+}
