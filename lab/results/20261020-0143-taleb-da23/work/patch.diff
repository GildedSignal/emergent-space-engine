+++ b/crates/allocator/examples/exposure.rs
@@ -0,0 +1,112 @@
+//! Exposure sweep for the finality assert (`alloc.rs`: "would revise its published tick"):
+//! the game's own scene shapes on the shipped frames harness, unsabotaged.
+//! One draw per process; a firing assert panics and the process exits non-zero.
+//!
+//!     cargo run -p emergent-allocator --release --offline --example exposure -- <class> <seed> [rate] [min_region]
+//!
+//! Classes: gas | battle | streams | quiet  (all `Law::Relativistic`, sabotage off).
+use emergent_allocator::{scenes, Allocator, Config, Factory, FrameConfig};
+use emergent_lattice::chronon::Chronon;
+use emergent_lattice::law::Response;
+use emergent_lattice::worlds;
+use std::sync::Arc;
+
+fn factory() -> Factory<Chronon> {
+    Arc::new(|w| Chronon::new(w, false).expect("a region's world is a valid world"))
+}
+
+fn main() {
+    let a = std::env::args().collect::<Vec<_>>();
+    let class = a.get(1).expect("class: gas|battle|streams|quiet").clone();
+    let seed: u64 = a.get(2).expect("seed").parse().unwrap();
+    let rate: f64 = a.get(3).map(|s| s.parse().unwrap()).unwrap_or(600.0);
+    let n_gas: u64 = a.get(5).map(|s| s.parse().unwrap()).unwrap_or(8192);
+    let min_region: usize = a.get(4).map(|s| s.parse().unwrap()).unwrap_or(32);
+    let margin: f64 = a.get(6).map(|s| s.parse().unwrap()).unwrap_or(2.0);
+    let fleets: u64 = a.get(7).map(|s| s.parse().unwrap()).unwrap_or(12);
+    let gn: u64 = a.get(8).map(|s| s.parse().unwrap()).unwrap_or(4352);
+    let seconds: f64 = a.get(9).map(|s| s.parse().unwrap()).unwrap_or(4.5);
+    let gate: u8 = a.get(10).map(|s| s.parse().unwrap()).unwrap_or(0);
+    let q = 256;
+    let mut parts: Vec<_>;
+    let observer;
+    match class.as_str() {
+        // The churn class (the ratchet page's selfchurn): ONE dense slow gas cluster.
+        "gas" => {
+            parts = vec![scenes::loose_gas(n_gas, q, 2, seed, 1, [0, 0])];
+            let b = &parts[0].bodies.iter().map(|b| b.x).collect::<Vec<_>>();
+            let lo = b.iter().map(|p| p[0]).min().unwrap();
+            let hi = b.iter().map(|p| p[0]).max().unwrap();
+            observer = [(lo + hi) / 2, (lo + hi) / 2];
+        }
+        // The game's faction battle: lattice `worlds::galaxy` (power-law fleets of bouncers,
+        // bulk drift up to Q/4, dispersion Q/16, never overlapping at genesis, + 256 stream).
+        "battle" => {
+            let g = worlds::galaxy(gn, fleets, 11, q, seed).expect("galaxy scene in range");
+            let n = g.bodies.len();
+            let c = g.bodies.iter().fold(([i64::MAX, i64::MAX], [i64::MIN, i64::MIN]), |(lo, hi), b| {
+                ([lo[0].min(b.x[0]), lo[1].min(b.x[1])], [hi[0].max(b.x[0]), hi[1].max(b.x[1])])
+            });
+            observer = [(c.0[0] + c.1[0]) / 2, (c.0[1] + c.1[1]) / 2];
+            parts = vec![scenes::world(&g, g.bodies.clone())];
+            eprintln!("battle: {n} bodies, {fleets} power-law fleets (galaxy {gn})");
+        }
+        // Sustained ballistic crossing traffic (the belt's shape): 4 lanes x 4 clumps of Pass
+        // discs, lanes at opposing drifts, NO contact response change in the whole scene.
+        "streams" => {
+            parts = Vec::new();
+            let mut id = 1u64;
+            for lane in 0..4i64 {
+                let drift = if lane % 2 == 0 { q / 4 } else { -q / 8 };
+                for c in 0..4i64 {
+                    let w = worlds::random(96, 300, q, 1, seed + 100 * lane as u64 + c as u64, Response::Pass);
+                    let off = [c * 900 + lane * 200, lane * 1200];
+                    parts.push(scenes::world(&w, scenes::place(&w, id, off, 1, 1, [drift, 0])));
+                    id += 1000;
+                }
+            }
+            observer = [1650 * q, 1800 * q];
+        }
+        // Negative control: sparse Pass islands, far apart, no contacts, no crossings.
+        "quiet" => {
+            parts = Vec::new();
+            for i in 0..8u64 {
+                let w = worlds::random(48, 4000, q, 1, seed + i, Response::Pass);
+                let off = [(i % 4) as i64 * 6000, (i / 4) as i64 * 6000];
+                parts.push(scenes::world(&w, scenes::place(&w, 1 + 1000 * i, off, 1, 1, [0, 0])));
+            }
+            observer = [9000 * q, 3000 * q];
+        }
+        // The belt's shape: a wide grid of churny clusters (bounce discs, internal
+        // velocities /den) spaced with light slack: internal churn + sustained crossings.
+        "clumps" => {
+            parts = scenes::galaxy(q, 3, 3, 256, 1800, 8, seed);
+            observer = [2 * 1800 * q, 2 * 1800 * q];
+        }
+        _ => panic!("unknown class {class}"),
+    }
+    let bodies: usize = parts.iter().map(|w| w.bodies.len()).sum();
+    let parts = scenes::with_law(parts, emergent_lattice::law::Law::Relativistic);
+    let cfg = Config {
+        p_workers: 2,
+        e_workers: 2,
+        sabotage: None,
+        speed_margin: margin,
+        min_region,
+        observer,
+        view_radius: 400 * q,
+        stride_gate: gate == 1,
+        ..Config::default()
+    };
+    let mut al = Allocator::new(parts, factory(), cfg).expect("scene");
+    // stride_gate arm (10th arg): 1 grows finality's reach boxes by one stride's light
+    // travel, blocking finality past live stride starts (the finality-assert fix under test).
+    let rep = al.run_frames(&FrameConfig { hz: 240.0, seconds, rate, ahead_seconds: 0.3, record: false });
+    let f = rep.frames.as_ref().expect("frame report");
+    let r = &rep.regions;
+    eprintln!(
+        "done {class} seed {seed} rate {rate} min_region {min_region} gate {gate}: {bodies} bodies | present {:.0} | rollbacks {} merges {} splits {} regions {}->{} | deadline misses {} | final lead max {:.0} | violations {}",
+        rep.sim.present_end, r.rollbacks, r.merges, r.splits, r.initial, r.last, f.deadline_misses,
+        f.final_lead_chronons.max, rep.finality.hard_speed_violations
+    );
+}
diff --git a/crates/allocator/examples/finpol.rs b/crates/allocator/examples/finpol.rs
new file mode 100644
index 00000000..b7ecd5d7
--- /dev/null
+++ b/crates/allocator/examples/finpol.rs
@@ -0,0 +1,123 @@
+//! Adjudicates the wiki conflict on `allocator-ratchet`: is the shipped finality assert
+//! (`alloc.rs:1451`) a property of the frame harness on any *churn* scene (b966:
+//! 14/35 draws at the keeping-up rate, reproduced three windows) or an artifact of one
+//! scene family (5d87: 18/18 frames arms survive on the wave family; batch-only grid
+//! defect)? This instrument separates the two variables the disputed runs confound —
+//! internal velocity spread (split-then-reclash churn) and bulk approach — and adds the
+//! arms neither ran in frames: on-grid chunks, window 32, min_region 32, churn dose.
+//!
+//! Scenes: `selfchurn` (ONE loose gas cluster, internal spread only, no approach),
+//! `crossing` (two churn clusters on perpendicular paths meeting mid-run), `wave`
+//! (zero-spread Pass slabs head-on: a planned merge, no churn — 5d87's class),
+//! `drift` (b966's scene, for continuity). Modes: frames | chunks | batch.
+//!
+//!     cargo run -p emergent-allocator --release --offline --example finpol -- \
+//!         <scene> <mode> [n] [seconds|horizon] [chunk] [rate] [vmax] [seed]
+use emergent_allocator::{scenes, Allocator, Config, Factory, FrameConfig, Report};
+use emergent_lattice::{chronon::Chronon, law::{Law, Response, World}, worlds};
+use std::sync::Arc;
+
+fn gas(q: i64, n: u64, vmax: i64, seed: u64, id: u64, off: [i64; 2]) -> World {
+    scenes::loose_gas(n, q, vmax, seed, id, off)
+}
+
+/// Two uniform-velocity Pass slabs closing head-on: they merge where they meet and
+/// nothing ever scatters — bulk motion and a real planned merge with zero churn.
+fn wave(q: i64, n: u64, seed: u64) -> Vec<World> {
+    let v = q / 8;
+    (0..2)
+        .map(|i| {
+            let w = worlds::random(n, 300, q, 1, seed + 50 + i, Response::Pass);
+            let off = if i == 0 { [-120, 0] } else { [120, 0] };
+            let drift = if i == 0 { [v, 0] } else { [-v, 0] };
+            scenes::world(&w, scenes::place(&w, 1_000_000 + 1000 * i as u64, off, 0, 1, drift))
+        })
+        .collect()
+}
+
+fn build(scene: &str, q: i64, n: u64, vmax: i64, seed: u64) -> Vec<World> {
+    match scene {
+        "selfchurn" => vec![gas(q, 2 * n, vmax, seed, 1, [0, 0])],
+        "crossing" => {
+            // Two churn clusters on perpendicular paths meeting near the origin mid-run
+            // (4000 units at q/16 per chronon ≈ chronon 250 per axis).
+            let mk = |seed: u64, id: u64, axis: usize, sign: i64| -> World {
+                let g = gas(q, n, vmax, seed, id, [0, 0]);
+                let mut b = g.bodies.clone();
+                b.iter_mut().for_each(|x| {
+                    x.x[axis] += sign * 4000 * q;
+                    x.k[axis] -= sign * q / 16;
+                });
+                scenes::world(&g, b)
+            };
+            vec![mk(seed, 1, 0, -1), mk(seed + 1, n + 1, 1, -1)]
+        }
+        "wave" => wave(q, n, seed),
+        "drift" => {
+            let speed = q / 8;
+            let mut ws = vec![gas(q, n, vmax, seed, 1, [-140, 0]), gas(q, n, vmax, seed + 1, n + 1, [140, 0])];
+            ws[0].bodies.iter_mut().for_each(|b| b.k[0] += speed);
+            ws[1].bodies.iter_mut().for_each(|b| b.k[0] -= speed);
+            ws
+        }
+        _ => panic!("scene must be selfchurn | crossing | wave | drift"),
+    }
+}
+
+fn row(tag: &str, r: &Report) {
+    println!(
+        "| {tag:<34} | {:>5.1}s | rb {:>3} | merges {:>4} | avoided {:>5} | regions {:>5} | E {:>5.0} | present/s {:>6.1} | frontier {:>5} | wasted {:>7} |",
+        r.wall_seconds, r.regions.rollbacks, r.regions.merges, r.regions.merges_avoided,
+        r.regions.last, r.regions.speed_escalation, r.sim.present_chronons_per_wall_second,
+        r.finality.frontier, r.regions.wasted_ops,
+    );
+}
+
+fn main() {
+    let q = 256i64;
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let scene = a.first().cloned().unwrap_or("selfchurn".into());
+    let mode = a.get(1).cloned().unwrap_or("frames".into());
+    let n: u64 = a.get(2).and_then(|s| s.parse().ok()).unwrap_or(120);
+    let hs: f64 = a.get(3).and_then(|s| s.parse().ok()).unwrap_or(6.0);
+    let chunk: i64 = a.get(4).and_then(|s| s.parse().ok()).unwrap_or(128);
+    let rate: f64 = a.get(5).and_then(|s| s.parse().ok()).unwrap_or(600.0);
+    let vmax: i64 = a.get(6).and_then(|s| s.parse().ok()).unwrap_or(8);
+    let seed: u64 = a.get(7).and_then(|s| s.parse().ok()).unwrap_or(11);
+    let window: i64 = std::env::var("FINPOL_WINDOW").ok().and_then(|s| s.parse().ok()).unwrap_or(16);
+    let min_region: i64 = std::env::var("FINPOL_MINREGION").ok().and_then(|s| s.parse().ok()).unwrap_or(1);
+
+    let ws = scenes::with_law(build(&scene, q, n, vmax, seed), Law::Relativistic);
+    let factory: Factory<Chronon> = Arc::new(|w| Chronon::new(w, false).expect("valid region world"));
+    let cfg = Config {
+        p_workers: 3, e_workers: 4, min_region: min_region.max(0) as usize, speed_margin: 0.5,
+        window, observer: [0, 0], view_radius: 300 * 256,
+        ..Config::default()
+    };
+    let mut al = Allocator::new(ws, factory, cfg).expect("scene");
+    let tag = format!("{scene}/{mode} n{n} r{rate} v{vmax} s{seed} w{window} m{min_region}");
+    match mode.as_str() {
+        "frames" => {
+            let r = al.run_frames(&FrameConfig { hz: 120.0, seconds: hs, rate, ahead_seconds: 0.25, record: false });
+            row(&tag, &r);
+            let f = r.frames.as_ref().expect("frames report");
+            println!("frames: {} drawn, misses {}, accel drops {}", f.frames, f.deadline_misses, f.acceleration_drops);
+        }
+        "chunks" => {
+            let horizon = hs as i64;
+            let mut tick = 0i64;
+            loop {
+                let next = (tick + chunk).min(horizon);
+                let r = al.run_to(next);
+                println!("chunk->{next}: frontier {}, rb {}, regions {}", r.finality.frontier, r.regions.rollbacks, r.regions.last);
+                tick = next;
+                if tick >= horizon { break; }
+            }
+        }
+        "batch" => {
+            let r = al.run_to(hs as i64);
+            row(&tag, &r);
+        }
+        _ => panic!("mode must be frames | chunks | batch"),
+    }
+}
