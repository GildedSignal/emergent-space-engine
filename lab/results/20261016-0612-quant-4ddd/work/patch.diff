+/// Linux port (print-only: this box has no `proc_pid_rusage`; the footprint columns are the M1's instrument).
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let read = |k: &str| std::fs::read_to_string("/proc/self/status").ok().and_then(|s| {
+        s.lines().find(|l| l.starts_with(k)).and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+    });
+    (read("VmRSS").map_or(0, |v| v * 1024), read("VmHWM").map_or(0, |v| v * 1024))
+}
