+// ---- lab probe 20261012-0036-quant-115e: per-stage timing only; no semantics change ---------------
+struct UProf {
+    ev: Vec<(u64, u8)>,
+    apply: Vec<(u64, u8)>,
+    root_ns: u64,
+    root_n: u64,
+    rekey_ns: u64,
+    rekey_n: u64,
+    rq_ns: u64,
+    rq_n: u64,
+}
+std::thread_local! {
+    static UPROF: std::cell::RefCell<UProf> = const {
+        std::cell::RefCell::new(UProf { ev: Vec::new(), apply: Vec::new(), root_ns: 0, root_n: 0, rekey_ns: 0, rekey_n: 0, rq_ns: 0, rq_n: 0 })
+    };
+}
+
+/// Lab probe: (per-item `step::process` ns by What code, per-item `apply` ns by What code,
+/// root_state ns, root_state calls, rekey ns, rekey calls, requeue ns, requeue calls).
+/// What codes: 1 Crash, 2 Boundary, 16+l Kick(l), 32+l Open(l).
+pub fn prof_take()
+-> (Vec<(u64, u8)>, Vec<(u64, u8)>, u64, u64, u64, u64, u64, u64) {
+    UPROF.with(|p| {
+        let mut p = p.borrow_mut();
+        (
+            std::mem::take(&mut p.ev),
+            std::mem::take(&mut p.apply),
+            std::mem::replace(&mut p.root_ns, 0),
+            std::mem::replace(&mut p.root_n, 0),
+            std::mem::replace(&mut p.rekey_ns, 0),
+            std::mem::replace(&mut p.rekey_n, 0),
+            std::mem::replace(&mut p.rq_ns, 0),
+            std::mem::replace(&mut p.rq_n, 0),
+        )
+    })
+}
