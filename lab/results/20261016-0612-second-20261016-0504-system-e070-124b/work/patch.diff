+static TRACE: std::sync::Mutex<Vec<(i64, usize, u16, u8)>> = std::sync::Mutex::new(Vec::new());
+fn trace_on() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("ES_TRACE").is_ok());
+    *ON
+}
+pub fn trace_take() -> Vec<(i64, usize, u16, u8)> {
+    std::mem::take(&mut *TRACE.lock().unwrap())
