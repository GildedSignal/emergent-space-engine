+//! Discriminator: at the sweep's refusal points, does `OrbitKey::from_invariants` + `Passage`/`Orbit`
+//! compile also refuse (key->compile path), or only `from_state` (state->key arithmetic)?
+use emergent_space::binding::{IntegerState, Rebinding, Trajectory};
+use emergent_space::orbit::Scalar;
+use emergent_universe::num::to_f64;
+
+fn state(p: f64, e: f64) -> IntegerState {
+    let f = 1.0 - 2.0 / p;
+    let vt = (f - f * f / (e * e)).sqrt();
+    IntegerState {
+        position: [p as i64, 0],
+        velocity: [0, (vt * 2f64.powi(40)) as i64],
+        length_exponent: 0,
+        velocity_exponent: -40,
+    }
+}
+
+fn main() {
+    // the jagged refusal rows plus neighbouring ok rows
+    let cases = [
+        (2.0f64, 4e8f64, true), (2.0, 6.32e8, false),
+        (5.0, 4e8, true), (5.0, 1e9, false),
+        (31.62, 4e8, true), (31.62, 3e8, false),
+        (100.0, 4e8, true), (100.0, 1.58e8, false),
+        (1e4, 3e8, true), (1e4, 4e8, false),
+        (1e6, 3e8, true), (1e6, 4e8, false),
+        (1.1, 2e9, true), (1.1, 1e9, false),
+        (1.5, 1e9, true), (1.5, 6.32e8, false),
+    ];
+    let zero = Scalar::raw(0, 0).unwrap();
+    for &(e, p, refused) in &cases {
+        let st = state(p, e);
+        let from_state = match Rebinding::from_state(st, zero, None) {
+            Ok(f) => format!("OK(k={:.4e})", f.trajectory.key().k as f64 / 2f64.powi(48)),
+            Err(err) => format!("{err:?}"),
+        };
+        let f = 1.0 - 2.0 / p;
+        let l2 = p * p * (e * e - f) / f;
+        let be = Scalar::raw(((e - 1.0) * 2f64.powi(40)) as i128, -40).unwrap();
+        let ang = Scalar::raw((l2.sqrt() * 2f64.powi(40)) as i128, -40).unwrap();
+        let inv = match emergent_space::orbit::OrbitKey::from_invariants(be, ang) {
+            Ok(k) => {
+                let peri = to_f64(k.periapsis);
+                let ke = k.k as f64 / 2f64.powi(48);
+                let compiled = match emergent_space::orbit::Passage::compile(k, Scalar::integer(p as i64)) {
+                    Ok(_) => "compiled".to_string(),
+                    Err(err) => format!("{err:?}"),
+                };
+                format!("OK(peri={peri:.3e} k={ke:.4e}) {compiled}")
+            }
+            Err(err) => format!("{err:?}"),
+        };
+        println!("E={e:<9} p={p:<9.3e} sweep_expectedly_refused={refused}\n  from_state: {from_state}\n  from_invariants: {inv}");
+    }
+}
