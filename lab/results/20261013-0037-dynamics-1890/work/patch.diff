+//! Debug: why does from_state refuse ordinary states? Try vr=0 (exact periapsis) vs slightly
+//! off-periapsis inbound states, and compare with OrbitKey::from_invariants.
+use emergent_space::binding::{IntegerState, Rebinding};
+use emergent_space::orbit::Scalar;
+use emergent_universe::num::to_f64;
+
+fn state(p: f64, e: f64, vr_frac: f64) -> IntegerState {
+    let f = 1.0 - 2.0 / p;
+    let vt0sq = f - f * f / (e * e);
+    let vr = -vr_frac * vt0sq.sqrt();
+    let vtsq = vt0sq - vr * vr / f;
+    let vt = vtsq.sqrt();
+    IntegerState {
+        position: [p as i64, 0],
+        velocity: [(vr * 2f64.powi(40)) as i64, (vt * 2f64.powi(40)) as i64],
+        length_exponent: 0,
+        velocity_exponent: -40,
+    }
+}
+
+fn main() {
+    let zero = Scalar::raw(0, 0).unwrap();
+    for &(e, p) in &[(1.1f64, 100.0), (1.5, 1e3), (3.0, 1e5), (1.0001, 1e4)] {
+        for &frac in &[0.0f64, 0.01, 0.1] {
+            let st = state(p, e, frac);
+            match Rebinding::from_state(st, zero, None) {
+                Ok(fit) => {
+                    let key = fit.trajectory.key();
+                    println!("E={e} p={p:.0} vr_frac={frac}: OK peri={} k={:.6e}", to_f64(key.periapsis), key.k as f64 / 2f64.powi(48));
+                }
+                Err(err) => println!("E={e} p={p:.0} vr_frac={frac}: {err:?}"),
+            }
+        }
+        // invariants path for comparison
+        let f = 1.0 - 2.0 / p;
+        let l2 = p * p * (e * e - f) / f;
+        let be = Scalar::raw(((e - 1.0) * 2f64.powi(40)) as i128, -40).unwrap();
+        let ang = Scalar::raw((l2.sqrt() * 2f64.powi(40)) as i128, -40).unwrap();
+        match emergent_space::orbit::OrbitKey::from_invariants(be, ang) {
+            Ok(k) => println!("  from_invariants: peri={} k={:.6e}", to_f64(k.periapsis), k.k as f64 / 2f64.powi(48)),
+            Err(err) => println!("  from_invariants: {err:?}"),
+        }
+    }
+}
