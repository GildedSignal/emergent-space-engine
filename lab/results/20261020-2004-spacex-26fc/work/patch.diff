+/// [`state_rate`] for one emitter, with the lab clamp (`ES_VIEW_CLAMP=1`): when the probe `t` falls
+/// below what the body's (or its doll chain's) retained history can still read, evaluate at the
+/// oldest readable tick instead of failing — the probe was below the crossing anyway
+/// (`lab/wiki/history-demand` od 2). Off, it is `state_rate` verbatim (bit for bit).
+fn eval_maybe_clamped(ctx: &Ctx, i: usize, t: Tick, clamped: bool) -> Option<([f64; 2], [f64; 2], f64)> {
+    match state_rate(ctx, i, t) {
+        Ok(s) => Some(s),
+        Err(_) if clamped => {
+            let mut probe = t;
+            for _ in 0..8 {
+                let floor = chain_floor(ctx, i)?;
+                if floor <= probe {
+                    return None; // the failure is not a below-history probe: keep the shipped answer
+                }
+                probe = floor;
+                if let Ok(s) = state_rate(ctx, i, probe) {
+                    return Some(s);
+                }
+            }
+            None
+        }
+        Err(_) => None,
+    }
+}
+
+/// The oldest tick at which body `i`'s whole doll chain can still be read: the largest
+/// oldest-retained event-time up the chain (a probe below any level's floor fails the whole read).
+fn chain_floor(ctx: &Ctx, i: usize) -> Option<Tick> {
+    let mut floor: Option<Tick> = None;
+    let mut cur = i;
+    for _ in 0..8 {
+        let b = ctx.bodies.bindings_of(cur).first().cloned()?;
+        floor = Some(match floor {
+            None => b.event_time,
+            Some(g) => g.max(b.event_time),
+        });
+        cur = ctx.dolls[b.doll as usize].centre?;
+    }
+    floor
+}
