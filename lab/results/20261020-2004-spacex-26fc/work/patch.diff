+//! The keep probe, id-attributed: `lab/wiki/history-demand` od 2 — the 2 emitters the shipped view
+//! loses at every mid-flight gather, attributed (dead bodies skipped by design, or crossings
+//! dropped by a failed search), and the `ES_VIEW_CLAMP=1` fix (on `eval → None`, clamp the probe to
+//! the oldest retained binding) flown beside the shipped arm. Scene and loop are `keep_probe`'s
+//! (the shipped ladder scene, 12 ms engine budget, 60 fps at a real-time factor, one
+//! `gather_cached` every `every` frames). Instruments: per-gather completeness with **per-id
+//! attribution** (alive-but-missing is the certificate that matters), the `binding_at` census,
+//! retained segments and depth, RSS, the engine digest and a strict hash of the whole view.
+//! The `drop ...` lines on stdout are the in-view census: every emitter that left a gather, why.
+//!
+//! cargo run --release -p emergent-universe --example keep_probe2 [-- <N> <coast|burn> [<wall s> [<rtf> [<gather every F frames>]]]]
+
+use emergent_universe::body::{keepcensus, BodyStore};
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::{gather_cached, View, ViewCache, TICK_SECONDS};
+use emergent_universe::{Budget, Config};
+use std::collections::{HashMap, HashSet};
+use std::time::{Duration, Instant};
+
+fn rss_mb() -> f64 {
+    std::fs::read_to_string("/proc/self/statm").ok().and_then(|s| s.split_whitespace().nth(1).and_then(|p| p.parse::<u64>().ok()).map(|p| p as f64 * 4096.0 / 1e6)).unwrap_or(0.0)
+}
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    if sorted.is_empty() { return 0.0; }
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+/// A strict hash of everything a player would see: every seen row's identity, direction, distance,
+/// colour shift, age and closing — equal views hash equal, any lost or shifted emitter differs.
+fn view_hash(v: &View) -> String {
+    let mut h = blake3::Hasher::new();
+    for s in &v.seen {
+        h.update(format!("{} {:.9e} {:.9e} {:.9e} {:.9e} {:.9e} {:.9e} {:.9e}\n", s.id, s.direction[0], s.direction[1], s.light_seconds, s.shift, s.age, s.closing, s.angular_radius).as_bytes());
+    }
+    format!("{:.16}", h.finalize())
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(10000);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(5.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(6000.0);
+    let every: usize = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(2).max(1);
+    let burn = flight == "burn";
+    let frames = (seconds * 60.0) as usize;
+    let legs = std::env::var("ES_KEEP_LEGS").unwrap_or_else(|_| "2".into());
+    let clamp = std::env::var("ES_VIEW_CLAMP").unwrap_or_else(|_| "0".into());
+    keepcensus::ON.store(true, std::sync::atomic::Ordering::Relaxed);
+    emergent_universe::view::dropcensus::ON.store(true, std::sync::atomic::Ordering::Relaxed);
+
+    let rss0 = rss_mb();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let bodies = p.u.n_bodies();
+    let mut cache = ViewCache::default();
+    let (mut gathers, mut seen_max, mut worst_seen, mut losses) = (0usize, 0usize, usize::MAX, 0usize);
+    let mut first_loss: Option<(usize, usize, usize)> = None;
+    let mut max_ids: HashSet<usize> = HashSet::new();
+    let mut miss_count: HashMap<usize, usize> = HashMap::new();
+    let mut alive_missing_gathers = 0usize;
+    let mut alive_missing_ids: HashSet<usize> = HashSet::new();
+    let (mut g_calls, mut g_nones) = (0u64, 0u64);
+    let mut g_ms: Vec<f64> = Vec::new();
+    let mut g_reads: Vec<f64> = Vec::new();
+    let mut truncated = false;
+    let t_first = p.u.now;
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs(50) {
+            truncated = true;
+            break;
+        }
+        if f == 60 && burn {
+            let t = p.u.now;
+            let _ = p.u.input(t, word(1, 8));
+        }
+        let start = Instant::now();
+        let _ = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_micros(12_000)) }, i64::MAX);
+        if f >= 60 && (f - 60) % every == 0 {
+            let (c0, n0, _, _) = keepcensus::read();
+            let tg = Instant::now();
+            let v = gather_cached(&p.u, &p.names, &mut cache);
+            let ms = tg.elapsed().as_secs_f64() * 1e3;
+            let (c1, n1, _, _) = keepcensus::read();
+            g_calls += c1 - c0;
+            g_nones += n1 - n0;
+            g_ms.push(ms);
+            if let Some(v) = &v {
+                let ids: HashSet<usize> = v.seen.iter().map(|s| s.id).collect();
+                let seen = ids.len();
+                if seen > seen_max {
+                    seen_max = seen;
+                    max_ids = ids.clone();
+                }
+                if seen < worst_seen {
+                    worst_seen = seen;
+                }
+                // Attribution: every id the fullest view had that this one lacks, split by whether
+                // the body is still alive (a search drop) or dead (skipped by design).
+                let mut alive_miss_here = 0usize;
+                for id in max_ids.difference(&ids) {
+                    *miss_count.entry(*id).or_insert(0) += 1;
+                    if *id < bodies && p.u.bodies().alive(*id) {
+                        alive_miss_here += 1;
+                        alive_missing_ids.insert(*id);
+                    }
+                }
+                if alive_miss_here > 0 {
+                    alive_missing_gathers += 1;
+                }
+                if seen < seen_max {
+                    losses += 1;
+                    first_loss.get_or_insert((f, seen, seen_max));
+                }
+                g_reads.push(cache.readouts as f64);
+                gathers += 1;
+            } else {
+                losses += 1;
+                first_loss.get_or_insert((f, 0, seen_max));
+            }
+        }
+        if !p.u.rec(p.player).alive {
+            break;
+        }
+    }
+    let final_view = gather_cached(&p.u, &p.names, &mut cache);
+    let (final_seen, hash) = final_view.as_ref().map_or((0, String::new()), |v| (v.seen.len(), view_hash(v)));
+    let game_s = (p.u.now - t_first) as f64 * TICK_SECONDS;
+    let mut segs = 0usize;
+    let mut depth: Vec<f64> = Vec::new();
+    for i in 0..bodies {
+        let b = p.u.bodies().bindings_of(i);
+        segs += b.len();
+        if let Some(first) = b.first() {
+            depth.push((p.u.now - first.event_time) as f64 * TICK_SECONDS);
+        }
+    }
+    depth.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    // Facts for every id that was ever missing: alive, kind of miss (persistent vs transient), the
+    // retained history under it. Fleet ids (>= 1_000_000) are listed with their member identity.
+    let mut miss_facts: Vec<String> = Vec::new();
+    let mut persistent: Vec<(usize, usize)> = miss_count.iter().map(|(k, v)| (*k, *v)).collect();
+    persistent.sort_by_key(|(k, _)| *k);
+    for (id, count) in &persistent {
+        if *id < bodies {
+            let bs = p.u.bodies();
+            let floor = bs.bindings_of(*id).first().map(|b| b.event_time).unwrap_or_else(|| bs.event_time(*id));
+            miss_facts.push(format!(
+                "id {id}: missing {count}/{gathers} gathers, alive {}, event_time {:.0} gs back, floor {:.0} gs back, hist {}",
+                bs.alive(*id), (p.u.now - bs.event_time(*id)) as f64 * TICK_SECONDS, (p.u.now - floor) as f64 * TICK_SECONDS, bs.history_len(*id)
+            ));
+        } else {
+            miss_facts.push(format!("id {id} (fleet {}): missing {count}/{gathers} gathers", id - 1_000_000));
+        }
+    }
+    let (calls, nones, min_t, none_min_t) = keepcensus::read();
+    let (e_calls, e_nones) = (calls - g_calls, nones - g_nones);
+    let gs = |t: i64| if t == i64::MAX { f64::NAN } else { (p.u.now - t) as f64 * TICK_SECONDS };
+    let mut ms = g_ms.clone();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    println!(
+        "keep_probe2 legs={legs} clamp={clamp} N={n} ({bodies} bodies) {flight} rtf={rtf} every={every} seconds={seconds}; frames ran, game {game_s:.0} s, truncated={truncated}, digest {:.12}",
+        p.u.digest()
+    );
+    println!(
+        "view: gathers {gathers}, seen max {seen_max} worst {worst_seen} final {final_seen}, losses {losses} (first: {first_loss:?}); gather ms p50 {:.2} p99 {:.2} max {:.2}; readouts/gather p50 {:.0} max {:.0}; viewhash {hash}",
+        pct(&ms, 0.5), pct(&ms, 0.99), pct(&ms, 1.0), pct(&g_reads, 0.5), pct(&g_reads, 1.0)
+    );
+    println!(
+        "attr: {gathers} gathers, alive-missing in {alive_missing_gathers} (ids {:?}); {} ids ever missing: {}",
+        alive_missing_ids.iter().copied().collect::<Vec<_>>(),
+        miss_count.len(),
+        miss_facts.join(" | ")
+    );
+    println!(
+        "census: binding_at calls {calls} (gather {g_calls}, engine {e_calls}), nones {nones} (gather {g_nones}, engine {e_nones}); deepest request {:.0} gs back, deepest none {:.0} gs back",
+        gs(min_t), gs(none_min_t)
+    );
+    println!(
+        "memory: rss {rss0:.0} -> {:.0} MB; segments {segs} ({:.2}/body, {:.2}/live-body); retained depth p50 {:.0} s p99 {:.0} s max {:.0} s; dashboard bytes/body {}",
+        rss_mb(), segs as f64 / bodies as f64, segs as f64 / depth.len().max(1) as f64, pct(&depth, 0.5), pct(&depth, 0.99), pct(&depth, 1.0), p.u.bytes_per_body()
+    );
+}
