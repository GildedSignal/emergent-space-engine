+/// A lab census of [`BodyStore::binding_at`] (print-only, off unless turned on): calls, the `None`
+/// returns (history pruned under a reader's feet), and the deepest tick requested (`lab/wiki/history-demand`).
+pub mod keepcensus {
+    use std::sync::atomic::{AtomicBool, AtomicI64, AtomicU64, Ordering};
+
+    pub static ON: AtomicBool = AtomicBool::new(false);
+    static CALLS: AtomicU64 = AtomicU64::new(0);
+    static NONES: AtomicU64 = AtomicU64::new(0);
+    static MIN_T: AtomicI64 = AtomicI64::new(i64::MAX);
+    static NONE_MIN_T: AtomicI64 = AtomicI64::new(i64::MAX);
+
+    pub fn reset() {
+        CALLS.store(0, Ordering::Relaxed);
+        NONES.store(0, Ordering::Relaxed);
+        MIN_T.store(i64::MAX, Ordering::Relaxed);
+        NONE_MIN_T.store(i64::MAX, Ordering::Relaxed);
+    }
+
+    /// `(calls, nones, the deepest tick requested, the deepest tick that returned None)`.
+    pub fn read() -> (u64, u64, i64, i64) {
+        (CALLS.load(Ordering::Relaxed), NONES.load(Ordering::Relaxed), MIN_T.load(Ordering::Relaxed), NONE_MIN_T.load(Ordering::Relaxed))
+    }
+
+    pub(crate) fn call(t: crate::num::Tick, missed: bool) {
+        CALLS.fetch_add(1, Ordering::Relaxed);
+        MIN_T.fetch_min(t, Ordering::Relaxed);
+        if missed {
+            NONES.fetch_add(1, Ordering::Relaxed);
+            NONE_MIN_T.fetch_min(t, Ordering::Relaxed);
+        }
+    }
+}
