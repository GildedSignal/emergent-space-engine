+/// A lab census of the two ways an emitter can leave a gather: found dead (skipped by design at the
+/// top of the body loop) or dropped by a failed crossing search (`eval` → `None`). One line per
+/// event, print-only, off unless turned on (`lab/wiki/history-demand` od 2: attribution).
+pub mod dropcensus {
+    use std::sync::atomic::AtomicBool;
+    pub static ON: AtomicBool = AtomicBool::new(false);
+
+    fn gs(t: crate::num::Tick) -> String {
+        format!("{:.0} gs", t as f64 * crate::view::TICK_SECONDS)
+    }
+    pub(crate) fn dead(i: usize, kind: crate::body::Kind, from: Option<(u16, u16)>, event_time: crate::num::Tick) {
+        println!("drop dead id={i} kind={kind:?} from={from:?} event_time={:.0} gs", event_time as f64 * crate::view::TICK_SECONDS);
+    }
+    pub(crate) fn none(i: usize, kind: crate::body::Kind, floor: crate::num::Tick, guess: crate::num::Tick, t_now: crate::num::Tick, event_time: crate::num::Tick) {
+        let back = |t: crate::num::Tick| gs(t_now - t);
+        println!("drop none id={i} kind={kind:?} floor={} guess={} event_time={}", back(floor), back(guess), back(event_time));
+    }
+}
