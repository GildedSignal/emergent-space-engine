+/// Linux port (lab 20261016-1120-components-cdf0): VmRSS now and VmHWM (peak resident) from /proc/self/status.
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let (mut now, mut peak) = (0u64, 0u64);
+    if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+        for line in s.lines() {
+            let kb = |v: &str| v.trim().trim_end_matches("kB").trim().parse::<u64>().unwrap_or(0) * 1024;
+            if let Some(v) = line.strip_prefix("VmRSS:") {
+                now = kb(v);
+            } else if let Some(v) = line.strip_prefix("VmHWM:") {
+                peak = kb(v);
+            }
+        }
+    }
+    (now, peak)
+}
