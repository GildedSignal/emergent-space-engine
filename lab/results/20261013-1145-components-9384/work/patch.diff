         return x;
     }
-    // Start at or above the root: the root of the top 64 bits (u64 Newton), plus one, rescaled.
-    let shift = (128 - x.leading_zeros()).saturating_sub(64).div_ceil(2) * 2;
-    let top = (x >> shift) as u64;
-    let mut y = top.isqrt() as u128 + 1;
-    y <<= shift / 2;
-    // Newton from above decreases monotonically to floor(sqrt(x)).
-    loop {
-        let z = (y + x / y) >> 1;
-        if z >= y {
-            return y;
-        }
-        y = z;
+    // The float square root is correctly rounded, so the seed sits within a relative
+    // 2^-51 of the root; one integer Newton step (the exact floor division) lands within
+    // one of floor(sqrt(x)), and the square fix-ups below close it exactly, so the
+    // returned bits are the floor whatever the seed does.
+    let mut y = ((x as f64).sqrt() as u128).max(1);
+    if y > 1 {
+        y = (y + x / y) >> 1;
+    }
+    while y.checked_mul(y).is_some_and(|s| s > x) {
+        y -= 1;
+    }
+    let mut s = y + 1;
+    while s.checked_mul(s).is_some_and(|t| t <= x) {
+        y = s;
+        s += 1;
     }
+    y
 }
 
