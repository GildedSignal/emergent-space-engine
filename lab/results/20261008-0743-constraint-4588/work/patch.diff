diff --git a/crates/universe/examples/constraint_view.rs b/crates/universe/examples/constraint_view.rs
new file mode 100644
index 0000000..13721ef
--- /dev/null
+++ b/crates/universe/examples/constraint_view.rs
@@ -0,0 +1,99 @@
+// The constraint run's instrument: the bench's exact loop (canonical burn script, wall-budgeted
+// engine, cached gather) with per-frame gather wall ms, readouts, seen and kicks — plus a second
+// arm whose ViewCache is dropped every frame (every crossing found from the present, guess = now).
+// `constraint_view [SECONDS] [RTF] [SEED] [ENGINE_MS] [MEMBERS] [CACHE: warm|cold]`
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::view::{gather_cached, ViewCache, TICK_SECONDS};
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+fn script(frame: usize) -> u8 {
+    let slot = frame / 240;
+    if frame % 240 < 20 {
+        [1, 9, 2, 4, 1, 1 | 4, 2, 8][slot % 8]
+    } else {
+        0
+    }
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let seconds: f64 = a.first().map(|s| s.parse().unwrap()).unwrap_or(20.0);
+    let rtf: f64 = a.get(1).map(|s| s.parse().unwrap()).unwrap_or(100.0);
+    let seed: u64 = a.get(2).map(|s| s.parse().unwrap()).unwrap_or(1);
+    let engine_ms: f64 = a.get(3).map(|s| s.parse().unwrap()).unwrap_or(5.0);
+    let members: u64 = a.get(4).map(|s| s.parse().unwrap()).unwrap_or(48);
+    let cold = a.get(5).map(|s| s == "cold").unwrap_or(false);
+    let mut p = plane(Config::default(), seed, Order::Sparse, 1, members).unwrap();
+    let frames = (seconds * 60.0) as usize;
+    let per_frame = rtf / 60.0 / TICK_SECONDS;
+    let (mut log, mut word) = (Vec::new(), 0u8);
+    for n in 1..=frames {
+        let w = emergent_universe::thrust::word(script(n), 0);
+        if w != word {
+            word = w;
+            log.push((((n - 1) as f64 * per_frame).round() as i64, w));
+        }
+    }
+    for &(t, k) in &log {
+        p.u.schedule(t, k).unwrap();
+    }
+    let cut = (frames as f64 * rtf / 60.0 / TICK_SECONDS).round() as i64;
+    let mut cache = ViewCache::default();
+    let mut prev: std::collections::HashMap<usize, ([f64; 2], f64)> = std::collections::HashMap::new();
+    let (mut quiet_all, mut quiet_bodies, mut quiet_fleet, mut frames_used) = (0u64, 0u64, 0u64, 0u64);
+    let (mut tot_all, mut tot_bodies, mut tot_fleet) = (0u64, 0u64, 0u64);
+    let mut last = Instant::now();
+    let mut rows: Vec<(f64, f64, u64, usize, u64, bool)> = Vec::new();
+    for _ in 0..frames {
+        let dt = last.elapsed().as_secs_f64().min(0.1);
+        last = Instant::now();
+        let t0 = Instant::now();
+        let fr = p.u.frame_to(1.0 / 60.0, rtf, Budget::wall(engine_ms), cut);
+        let eng = t0.elapsed().as_secs_f64() * 1e3;
+        let kicks = p.u.stats.kicks;
+        if cold {
+            cache = ViewCache::default();
+        }
+        let t1 = Instant::now();
+        let v = gather_cached(&p.u, &p.names, &mut cache).unwrap();
+        rows.push((t1.elapsed().as_secs_f64() * 1e3, eng, cache.readouts, v.seen.len(), kicks, fr.overflow));
+        if !prev.is_empty() {
+            let (mut qa, mut qb, mut qf) = (0u64, 0u64, 0u64);
+            for s in &v.seen {
+                let Some((d0, s0)) = prev.get(&s.id) else { continue };
+                let ang = (s.direction[0] * d0[0] + s.direction[1] * d0[1]).clamp(-1.0, 1.0).acos().to_degrees();
+                let shr = (s.shift - s0).abs() / s.shift.abs().max(1e-12);
+                if ang < 0.05 && shr < 1e-3 {
+                    qa += 1;
+                    if s.kind == 4 { qf += 1 } else { qb += 1 }
+                }
+            }
+            let (na, nb) = (v.seen.len() as u64, v.seen.iter().filter(|s| s.kind != 4).count() as u64);
+            quiet_all += qa; quiet_bodies += qb; quiet_fleet += qf;
+            tot_all += na; tot_bodies += nb; tot_fleet += na - nb;
+            frames_used += 1;
+        }
+        prev = v.seen.iter().map(|s| (s.id, (s.direction, s.shift))).collect();
+    }
+    let mut g: Vec<f64> = rows.iter().map(|r| r.0).collect();
+    g.sort_by(f64::total_cmp);
+    let n = g.len();
+    println!("members {members} cache {}: gather ms p50 {:.3} p90 {:.3} p99 {:.3} max {:.3}", if cold { "cold" } else { "warm" }, g[n / 2], g[n * 9 / 10], g[n * 99 / 100], g[n - 1]);
+    let reads: u64 = rows.iter().map(|r| r.2).sum();
+    let seen: u64 = rows.iter().map(|r| r.3 as u64).sum();
+    if frames_used > 0 {
+        println!("coherence at 60 Hz (angle < 0.05 deg AND |d shift|/shift < 1e-3 vs previous frame):");
+        println!("  quiet rows: all {:.1}% ({}/{}), bodies {:.1}% ({}/{}), fleet {:.1}% ({}/{}) over {} frames",
+            100.0 * quiet_all as f64 / tot_all as f64, quiet_all, tot_all,
+            100.0 * quiet_bodies as f64 / tot_bodies as f64, quiet_bodies, tot_bodies,
+            100.0 * quiet_fleet as f64 / tot_fleet.max(1) as f64, quiet_fleet, tot_fleet, frames_used);
+    }
+    let mut idx: Vec<usize> = (0..n).collect();
+    idx.sort_by(|&a, &b| rows[b].0.total_cmp(&rows[a].0));
+    for &i in idx.iter().take(5) {
+        let r = rows[i];
+        println!("  frame {i:>5}: gather {:7.3} ms ({} readouts, {} seen) engine {:6.2} ms overflow {}", r.0, r.2, r.3, r.1, r.5);
+    }
+}
