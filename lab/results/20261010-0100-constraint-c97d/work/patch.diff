+//! Lab-only measure (constraint lens, run 20261010-0100): per-gather counts, so the readout path's
+//! scaling with bodies-in-view is a measurement, not an inference. Deleted with the run's patch.
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static GATHERS: AtomicU64 = AtomicU64::new(0);
+static BODIES: AtomicU64 = AtomicU64::new(0);
+static SEEN: AtomicU64 = AtomicU64::new(0);
+static READS: AtomicU64 = AtomicU64::new(0);
+thread_local! {
+    static LAST_SEEN: Cell<u64> = const { Cell::new(0) };
+}
+
+pub fn record_gather(n_bodies: usize, seen: usize, reads: u64) {
+    GATHERS.fetch_add(1, Ordering::Relaxed);
+    BODIES.fetch_add(n_bodies as u64, Ordering::Relaxed);
+    SEEN.fetch_add(seen as u64, Ordering::Relaxed);
+    READS.fetch_add(reads, Ordering::Relaxed);
+    LAST_SEEN.set(seen as u64);
+}
+
+pub fn last_seen() -> u64 {
+    LAST_SEEN.get()
+}
+
+pub fn report() -> (u64, u64, u64, u64) {
+    (
+        GATHERS.load(Ordering::Relaxed),
+        BODIES.load(Ordering::Relaxed),
+        SEEN.load(Ordering::Relaxed),
+        READS.load(Ordering::Relaxed),
+    )
+}
