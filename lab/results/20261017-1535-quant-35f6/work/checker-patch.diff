+/// The `(j, t)` memo of [`Ctx::state_of`] (the read stream's direction 1): bindings change only at
+/// a body's own writes, so a value read at `(j, t)` stays valid until `j` is written again — every
+/// write bumps `j`'s generation, and a hit is served only when the generation still matches.
+/// Off (`ES_SEC_MEMO` unset) the path is the engine's own; `ES_SEC_CENSUS=1` recomputes every
+/// value anyway and only counts (calls, hits, stale keys, value conflicts), so both arms are
+/// observation.
+pub struct SecMemo {
+    on: bool,
+    census: bool,
+    inner: std::sync::Mutex<SecInner>,
+}
+
+struct SecInner {
+    gen: Vec<u32>,
+    map: std::collections::HashMap<(usize, Tick), (u32, (V2, V2))>,
+    calls: u64,
+    hits: u64,
+    stale: u64,
+    conflicts: u64,
+    clears: u64,
+}
+
+impl SecMemo {
+    pub(crate) fn from_env() -> Self {
+        Self {
+            on: std::env::var("ES_SEC_MEMO").is_ok(),
+            census: std::env::var("ES_SEC_CENSUS").is_ok(),
+            inner: std::sync::Mutex::new(SecInner { gen: Vec::new(), map: std::collections::HashMap::new(), calls: 0, hits: 0, stale: 0, conflicts: 0, clears: 0 }),
+        }
+    }
+
+    fn active(&self) -> bool {
+        self.on || self.census
+    }
+
+    /// The memo's answer for `(j, t)`, if it is fresh.
+    fn get(&self, j: usize, t: Tick) -> Option<(V2, V2)> {
+        let mut s = self.inner.lock().unwrap();
+        s.calls += 1;
+        let g = *s.gen.get(j).unwrap_or(&0);
+        match s.map.get(&(j, t)) {
+            Some(&(kg, v)) if kg == g => {
+                s.hits += 1;
+                Some(v)
+            }
+            Some(_) => {
+                s.stale += 1;
+                None
+            }
+            None => None,
+        }
+    }
+
+    /// Store `(j, t)` (in census mode a hit that recomputes a different value was already counted).
+    fn put(&self, j: usize, t: Tick, v: (V2, V2)) {
+        let mut s = self.inner.lock().unwrap();
+        if s.gen.len() <= j {
+            s.gen.resize(j + 1, 0);
+        }
+        let g = *s.gen.get(j).unwrap_or(&0);
+        if s.map.len() >= (1 << 20) {
+            s.map.clear();
+            s.clears += 1;
+        }
+        s.map.insert((j, t), (g, v));
+    }
+
+    /// A census hit whose recomputed value differs from the stored one: the one number that would
+    /// kill the memo as wired.
+    fn conflict(&self) {
+        self.inner.lock().unwrap().conflicts += 1;
+    }
+
+    /// Every write to body `j` (the universe's apply and rebind paths).
+    pub fn bump(&self, j: usize) {
+        let mut s = self.inner.lock().unwrap();
+        if s.gen.len() <= j {
+            s.gen.resize(j + 1, 0);
+        }
+        s.gen[j] = s.gen[j].wrapping_add(1);
+    }
+
+    /// One line for the dossier: the census and the memo's own account.
+    pub fn stats(&self) -> String {
+        let s = self.inner.lock().unwrap();
+        format!(
+            "sec_memo: on={} census={} calls={} hits={} stale={} conflicts={} map={} clears={} (repeat={:.3})",
+            self.on,
+            self.census,
+            s.calls,
+            s.hits,
+            s.stale,
+            s.conflicts,
+            s.map.len(),
+            s.clears,
+            if s.calls > 0 { s.hits as f64 / s.calls as f64 } else { 0.0 },
+        )
+    }
+}
