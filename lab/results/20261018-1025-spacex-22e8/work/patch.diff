diff --git a/crates/universe/src/census.rs b/crates/universe/src/census.rs
new file mode 100644
index 00000000..0673d919
--- /dev/null
+++ b/crates/universe/src/census.rs
@@ -0,0 +1,107 @@
+//! Print-only census of the store's read paths (lab run 20261018-1025-spacex-22e8).
+//! Counters and bit slabs only: no behaviour change, digests unaffected.
+//! A decode is attributed to the last body `binding_at` served on this thread;
+//! flights are single-threaded (threads = 1), so the attribution is exact there.
+//! Decodes with no `binding_at` on the thread count as `direct` (the mint/refit path).
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{LazyLock, RwLock};
+
+pub struct Census {
+    pub bind_cur: AtomicU64,
+    pub bind_hist: AtomicU64,
+    pub decodes: AtomicU64,
+    pub decodes_direct: AtomicU64,
+    slab: RwLock<Vec<u8>>, // per body: bit0 cloned-current, bit1 cloned-history, bit2 decoded
+}
+
+static C: LazyLock<Census> = LazyLock::new(|| Census {
+    bind_cur: AtomicU64::new(0),
+    bind_hist: AtomicU64::new(0),
+    decodes: AtomicU64::new(0),
+    decodes_direct: AtomicU64::new(0),
+    slab: RwLock::new(Vec::new()),
+});
+
+fn c() -> &'static Census {
+    &C
+}
+
+thread_local! {
+    static LAST: Cell<i64> = const { Cell::new(-1) };
+}
+
+pub fn note_binding(i: usize, hist: bool) {
+    let c = c();
+    if hist {
+        c.bind_hist.fetch_add(1, Ordering::Relaxed);
+    } else {
+        c.bind_cur.fetch_add(1, Ordering::Relaxed);
+    }
+    LAST.with(|l| l.set(i as i64));
+    let mut s = c.slab.write().unwrap();
+    if s.len() <= i {
+        s.resize(i + 1, 0);
+    }
+    s[i] |= if hist { 2 } else { 1 };
+}
+
+pub fn note_decode() {
+    let c = c();
+    let last = LAST.with(|l| l.get());
+    if last < 0 {
+        c.decodes_direct.fetch_add(1, Ordering::Relaxed);
+        return;
+    }
+    c.decodes.fetch_add(1, Ordering::Relaxed);
+    let mut s = c.slab.write().unwrap();
+    let i = last as usize;
+    if s.len() <= i {
+        s.resize(i + 1, 0);
+    }
+    s[i] |= 4;
+}
+
+/// Reset the decode counters and decoded marks (to measure a second phase, e.g. the view
+/// gather, without the flight's reads). Clone/hist marks stay (they are per-phase too, so
+/// the caller dumps first).
+pub fn reset_phase() {
+    let c = c();
+    c.decodes.store(0, Ordering::Relaxed);
+    c.decodes_direct.store(0, Ordering::Relaxed);
+    c.bind_cur.store(0, Ordering::Relaxed);
+    c.bind_hist.store(0, Ordering::Relaxed);
+    let mut s = c.slab.write().unwrap();
+    for b in s.iter_mut() {
+        *b = *b & 1 | (*b & 2); // keep ever-cloned marks, drop decoded and phase counts below
+    }
+    LAST.with(|l| l.set(-1));
+}
+
+fn popcount(slab: &[u8], bit: u8) -> usize {
+    slab.iter().filter(|b| *b & bit != 0).count()
+}
+
+/// One census line: call counts, distinct-body marks. `ever` bits are over all phases;
+/// the counters are since the last `reset_phase`.
+pub fn dump(label: &str) -> String {
+    let c = c();
+    let s = c.slab.read().unwrap();
+    format!(
+        "census[{label}] bind_cur={} bind_hist={} decodes={} decodes_direct={} distinct_cloned_cur={} distinct_cloned_hist={} distinct_decoded_ever={} slab_bodies={}",
+        c.bind_cur.load(Ordering::Relaxed),
+        c.bind_hist.load(Ordering::Relaxed),
+        c.decodes.load(Ordering::Relaxed),
+        c.decodes_direct.load(Ordering::Relaxed),
+        popcount(&s, 1),
+        popcount(&s, 2),
+        popcount(&s, 4),
+        s.len()
+    )
+}
+
+/// Which bodies were ever decoded (bit4) — for per-class attribution by the probe.
+pub fn decoded_set() -> Vec<bool> {
+    let s = c().slab.read().unwrap();
+    s.iter().map(|b| b & 4 != 0).collect()
+}
