 pub const ENGINE_BUDGET_MS: f64 = 5.0;
 
+/// The frame-budget discipline (the allocator question, principle 12): what the engine's per-frame cap
+/// is, and whether idle frames run the presented time ahead of the wall clock.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Policy {
+    /// The plane today: one fixed wall cap, no work-ahead.
+    Fixed,
+    /// AIMD cap in [1, 13] ms: grown on overflow (persistent lateness), shrunk after clean frames or
+    /// when a frame's wall time nears the deadline (CoDel's lesson: control the lateness, protect the
+    /// deadline).
+    Aimd,
+    /// Work-ahead: while frames have unspent budget the target runs ahead of the wall clock by up to
+    /// `LEAD_S` of presented (game) time — pro-audio's lookahead buffer — so a later burst presents
+    /// already-resolved state instead of dipping the real-time factor.
+    Ahead,
+    Both,
+}
+
+impl Policy {
+    pub fn adaptive(self) -> bool {
+        matches!(self, Policy::Aimd | Policy::Both)
+    }
+    pub fn ahead(self) -> bool {
+        matches!(self, Policy::Ahead | Policy::Both)
+    }
+    pub fn name(self) -> &'static str {
+        match self {
+            Policy::Fixed => "fixed",
+            Policy::Aimd => "aimd",
+            Policy::Ahead => "ahead",
+            Policy::Both => "aimd+ahead",
+        }
+    }
+}
+
+/// The most presented (game) time the work-ahead policy may lead the wall clock by (three presented
+/// frames): bursts shorter than this are absorbed as latency, not as dips.
+pub const LEAD_S: f64 = 0.050;
+
