     pub fn reconstruct(&self) -> Result<IntegerState> {
         self.residual.reconstruct(self.decoded_event()?)
     }
+    /// Lab probe (20261004-0555-taleb-b41e): the memo-quantized twin of [`Rebinding::from_state`].
+    /// Compiles the trajectory from the 12-bit `memo_key` (orbit.rs), so bindings whose quantized
+    /// (E, L) agree share one compiled cycle; the residual carries the difference, exactly.
+    /// Returns the fit and whether the memo key was used (the exact key is the fallback when
+    /// quantization is not representable there).
+    pub fn from_state_memo(state: IntegerState, event_time: Scalar, passage_edge: Option<Scalar>) -> Result<(Self, bool)> {
+        let (key, r, clockwise, incoming) = fit_key(state, false)?;
+        let (memo, shared) = match key.memo_key() {
+            Ok(m) if m.periodic() == key.periodic() => (m, true),
+            _ => (key, false),
+        };
+        let trajectory = if memo.periodic() {
+            Trajectory::Cycle(Orbit::compile(memo)?)
+        } else {
+            Trajectory::Passage(Passage::compile(memo, passage_edge.unwrap_or(r.scale(1)?))?)
+        };
+        let (mut offset, mut sample) = trajectory.at_radius(r)?;
+        if incoming {
+            offset = offset.negate();
+            sample.reflect();
+        }
+        let (p, _) = state.components()?;
+        let at = angle(p[0], p[1])?;
+        let orientation = (at - if clockwise { -phase(sample)? } else { phase(sample)? }).rem_euclid(2 * PI);
+        let periapsis_angle = ((orientation << 32) / (2 * PI)) as u32;
+        let mut fit = Self {
+            trajectory,
+            periapsis_time: event_time.sub(offset)?,
+            periapsis_angle,
+            clockwise,
+            residual: Residual { position: [0; 2], velocity: [0; 2] },
+            event_time,
+            units: (state.length_exponent, state.velocity_exponent),
+        };
+        fit.residual = Residual::between(state, fit.decoded_event()?);
+        Ok((fit, shared))
+    }
 }
 
