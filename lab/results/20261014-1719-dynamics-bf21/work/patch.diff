index 00000000..e05526ac
--- /dev/null
+++ b/crates/universe/examples/wave_flight.rs
@@ -0,0 +1,81 @@
+//! One flight through the belt's first-kick wave, with the canonical digest at a fixed cut: the
+//! certificate that holding the player's scan (ES_PULL_CAP) changes no bit. Prints the frame
+//! profile (p50/p99/worst, frames over budget, worst lag) and `digest=<hex>` at the end.
+//!
+//! cargo run --release -p emergent-universe --example wave_flight [-- <N> <coast|burn> <wall s> <rtf> <budget ms>]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[(((sorted.len() - 1) as f64 * p).round()) as usize]
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let n: usize = a.get(1).and_then(|s| s.parse().ok()).unwrap_or(200_000);
+    let burn = a.get(2).map(|s| s == "burn").unwrap_or(true);
+    let seconds: f64 = a.get(3).and_then(|s| s.parse().ok()).unwrap_or(160.0);
+    let rtf: f64 = a.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms: f64 = a.get(5).and_then(|s| s.parse().ok()).unwrap_or(12.0);
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let start = p.u.now;
+    let end = start + (seconds * rtf / TICK_SECONDS) as i64;
+    let mut rows: Vec<(usize, f64, u64, f64)> = Vec::new();
+    let mut held_max = 0usize;
+    let mut alive = true;
+    let frames = (seconds * 60.0) as usize;
+    for f in 0..frames {
+        if f == 60 && burn {
+            let t = p.u.now;
+            let _ = p.u.input(t, word(1, 8));
+        }
+        let s = Instant::now();
+        let fr = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(s + Duration::from_micros((budget_ms * 1e3) as u64)) }, end);
+        rows.push((f, s.elapsed().as_secs_f64() * 1e3, fr.events, (fr.target - fr.presented) as f64 * TICK_SECONDS));
+        held_max = held_max.max(p.u.held_scans());
+        if !p.u.rec(p.player).alive {
+            alive = false;
+            break;
+        }
+        if p.u.now >= end {
+            break;
+        }
+    }
+    let flown = rows.len();
+    let held_at_end = p.u.held_scans();
+    // The canonical cut: everything below `end` resolved, then the digest.
+    let t1 = Instant::now();
+    p.u.settle(end);
+    let settle_s = t1.elapsed().as_secs_f64();
+    let digest = p.u.digest();
+    let mut late: Vec<f64> = rows.iter().skip(60).map(|r| r.1).collect();
+    late.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let over = rows.iter().skip(60).filter(|r| r.1 > budget_ms).count();
+    let lag = rows.iter().skip(60).map(|r| r.3).fold(0.0, f64::max);
+    let mut ev: Vec<f64> = rows.iter().skip(60).map(|r| r.2 as f64).collect();
+    ev.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let mut worst: Vec<_> = rows.iter().skip(60).collect();
+    worst.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
+    println!(
+        "flight N={n} {} {seconds} s rtf {rtf} budget {budget_ms} ms: build {build:.1} s, frames {flown}, engine ms p50 {:.2} p99 {:.2} max {:.2}; over: {over}; worst lag {lag:.2} s; events/frame p50 {:.0} max {:.0}; scans held max {held_max}, at end {held_at_end}; settle {settle_s:.1} s; encounters {}, kicks {}; alive(player) {alive}",
+        if burn { "burn" } else { "coast" },
+        pct(&late, 0.5),
+        pct(&late, 0.99),
+        pct(&late, 1.0),
+        pct(&ev, 0.5),
+        pct(&ev, 1.0),
+        p.u.stats.encounters,
+        p.u.stats.kicks,
+    );
+    println!(
+        "worst frames (frame, ms, events, lag s): {}",
+        worst.iter().take(6).map(|r| format!("({},{:.1},{},{:.2})", r.0, r.1, r.2, r.3)).collect::<Vec<_>>().join(" ")
+    );
+    println!("digest={digest}");
+}
