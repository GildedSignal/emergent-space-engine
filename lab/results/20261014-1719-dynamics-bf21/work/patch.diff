+//! The belt's kick wave train: the anatomy of the first wave (birth plans, steps, anchors) and the
+//! recurrence (the items that follow it, read after a settle past the first wave). The belt's bodies
+//! are born at tick 0 with one Δs each; this measures when their kicks arrive and whether the arrival
+//! is a one-shot shock or a train.
+//!
+//! cargo run --release -p emergent-universe --example wave_train [-- <N> [<game s to settle>]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::{ladder_locals, plane_extra};
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::Config;
+use std::collections::BTreeMap;
+
+fn game_s(t: i64) -> f64 {
+    t as f64 * TICK_SECONDS
+}
+
+fn q(v: &mut Vec<f64>, p: f64) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[((v.len() - 1) as f64 * p) as usize]
+}
+
+fn main() {
+    let n: usize = std::env::args().nth(1).and_then(|s| s.parse().ok()).unwrap_or(100_000);
+    let to_s: f64 = std::env::args().nth(2).and_then(|s| s.parse().ok()).unwrap_or(20_500.0);
+    let t0 = std::time::Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let locals = ladder_locals(n as u64) as usize;
+    let base = p.player - n;
+    // The birth anatomy: the belt's first item, its kind, the step each body runs on.
+    let (mut first, steps, whats) = {
+        let (mut first, mut steps, mut whats) = (Vec::new(), BTreeMap::new(), BTreeMap::new());
+        for k in locals..n {
+            let r = p.u.rec(base + k);
+            if let Some(it) = r.plan.first() {
+                first.push(game_s(it.t));
+                *whats.entry(format!("{:?}", it.what)).or_insert(0u64) += 1;
+            }
+            *steps.entry(r.step).or_insert(0u64) += 1;
+        }
+        (first, steps, whats)
+    };
+    println!(
+        "birth: build {build:.1} s; belt {} bodies, first item game s: min {:.0} p01 {:.0} p50 {:.0} p99 {:.0} max {:.0}; kinds {:?}",
+        first.len(),
+        q(&mut first, 0.0),
+        q(&mut first, 0.01),
+        q(&mut first, 0.5),
+        q(&mut first, 0.99),
+        q(&mut first, 1.0),
+        whats
+    );
+    println!(
+        "steps (ticks, log2, game s, share): {}",
+        steps
+            .iter()
+            .map(|(s, c)| format!("({},{},{:.0},{:.3})", s, 63 - s.leading_zeros(), game_s(*s), *c as f64 / n as f64))
+            .collect::<Vec<_>>()
+            .join(" ")
+    );
+    // The recurrence: settle past the first wave, then read every belt body's next item and the gap
+    // since the binding it now sits on.
+    let horizon = (to_s / TICK_SECONDS) as i64;
+    let t1 = std::time::Instant::now();
+    p.u.settle(horizon);
+    let settle = t1.elapsed().as_secs_f64();
+    let (mut second, mut gaps) = (Vec::new(), Vec::new());
+    let mut gap_census: BTreeMap<i64, u64> = BTreeMap::new();
+    for k in locals..n {
+        let r = p.u.rec(base + k);
+        if let Some(it) = r.plan.first() {
+            second.push(game_s(it.t));
+            let gap = it.t - r.b.event_time;
+            gaps.push(game_s(gap));
+            *gap_census.entry(gap).or_insert(0u64) += 1;
+        }
+    }
+    println!(
+        "after a settle to {:.0} game s ({settle:.1} s wall, {} events): next item game s: min {:.0} p01 {:.0} p50 {:.0} p99 {:.0} max {:.0}; gap since the binding: p01 {:.0} p50 {:.0} p99 {:.0}",
+        to_s,
+        p.u.stats.events(),
+        q(&mut second, 0.0),
+        q(&mut second, 0.01),
+        q(&mut second, 0.5),
+        q(&mut second, 0.99),
+        q(&mut second, 1.0),
+        q(&mut gaps, 0.01),
+        q(&mut gaps, 0.5),
+        q(&mut gaps, 0.99),
+    );
+    println!(
+        "gap census (game s: share): {}",
+        gap_census
+            .iter()
+            .map(|(g, c)| format!("({:.0}:{:.3})", game_s(*g), *c as f64 / gaps.len().max(1) as f64))
+            .collect::<Vec<_>>()
+            .join(" ")
+    );
+}
