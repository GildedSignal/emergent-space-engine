diff --git a/xtask/src/galaxy/tests.rs b/xtask/src/galaxy/tests.rs
index 4430562..ab55dd4 100644
--- a/xtask/src/galaxy/tests.rs
+++ b/xtask/src/galaxy/tests.rs
@@ -187,3 +187,28 @@ fn the_view_query_refuses_what_it_cannot_draw() {
         assert!(view_of(bad).is_err(), "{bad}");
     }
 }
+
+#[test]
+fn magic_division_matches_hardware() {
+    let s = scene(1000, 100_000, 3, 1000, 2);
+    let mut bad = 0u64;
+    let mut seen = 0u64;
+    for rec in &s.keys {
+        let (d, m, l) = (rec.period, rec.dmagic(), rec.dshift());
+        let seed = 0x9E37_79B9_7F4A_7C15u64.wrapping_mul(d);
+        let mut e = seed;
+        for _ in 0..2000 {
+            seen += 1;
+            let q = (((e as u128 * m as u128) >> 64) as u64) >> l;
+            let mut r = e.wrapping_sub(q.wrapping_mul(d));
+            let mut q = q;
+            if r >= d { q += 1; r -= d; }
+            if q != e / d || r != e % d {
+                bad += 1;
+                if bad < 4 { eprintln!("BAD d={d} m={m} l={l} e={e}: got q={q} r={r}, want {}/{}", e, e / d); }
+            }
+            e = e.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        }
+    }
+    assert_eq!(bad, 0, "{bad} of {seen} divisions wrong");
+}
