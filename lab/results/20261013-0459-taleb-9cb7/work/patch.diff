+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::{fleet::Order, Budget, Config};
+use std::time::{Duration, Instant};
+fn main() {
+    let tl: i32 = std::env::args().nth(1).and_then(|s| s.parse().ok()).unwrap_or(-29);
+    let capped: bool = std::env::args().nth(2).map(|s| s == "cap").unwrap_or(false);
+    let mut cfg = Config::default();
+    cfg.turn_log2 = tl;
+    let mut p = plane(cfg, 1, Order::Sparse, 1, 48).unwrap();
+    let pl = p.player;
+    let _ = p.u.input(p.u.now, word(8, 15));
+    let deadline = Instant::now() + Duration::from_secs(3);
+    for i in 0..40 {
+        let tgt = p.u.now + (1 << 21);
+        if capped {
+            loop {
+                let a = p.u.advance(tgt, Budget { events: u64::MAX, until: Some(deadline) });
+                if a.events == 0 || Instant::now() >= deadline { break; }
+            }
+        } else {
+            loop {
+                let a = p.u.advance(tgt, Budget::unlimited());
+                if a.events == 0 { break; }
+            }
+        }
+        p.u.now = p.u.now.max(tgt);
+        let r = p.u.rec(pl);
+        println!("i={i} t={} head={} step={} ev={} keys={:?}", p.u.now, r.thrust.map(|t| t.heading).unwrap_or(0), r.step, r.events, r.thrust.map(|t| t.keys));
+    }
+}
