+//! The scout's falsifier for frame-cost open direction 1: are deadlines really schedule-only?
+//!
+//! Arms:
+//!   cost <members> [frames]   — quiet-frame engine cost, rekey on vs off (the fixed tier's size).
+//!   digest <seed> [members]   — digest at one canonical cut under shipped / never / lazy rekey,
+//!                               with the per-frame presented trace (the vacuity check).
+//!   leak <seed> [rtf]         — session-style key logging (input at `now`) vs grid-quantized
+//!                               schedule, across 30/60/144 Hz pacings, digests at one cut.
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::universe::Universe;
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+const GAME_S: f64 = 4.925_490_947e-6; // view::TICK_SECONDS
+
+fn median(v: &mut Vec<u64>) -> u64 {
+    v.sort_unstable();
+    v[v.len() / 2]
+}
+
+/// Frame at `hz` presentation to `cut`, rekeying only when the player's committed event time moved
+/// (the lazy arm's hook), then settle everything below the cut.
+fn run_to_cut(u: &mut Universe, player: usize, cut: i64, hz: f64, lazy: bool, starve: u64) -> (u64, Vec<(i64, u64)>, u64, Vec<(i128, i64)>) {
+    let mut presented = Vec::new();
+    let mut fronts = Vec::new();
+    let mut events = 0u64;
+    let mut frames = 0u64;
+    let mut last_et = u.rec(player).b.event_time;
+    while u.now < cut && frames < 400_000 {
+        if lazy {
+            let et = u.rec(player).b.event_time;
+            if et != last_et {
+                u.rekey();
+                last_et = et;
+            }
+        }
+        let b = if starve > 0 { Budget::events(starve) } else { Budget::wall(5.0) };
+        let f = u.frame_to(1.0 / hz, 1.0, b, cut);
+        presented.push((f.presented, f.events as u64));
+        if let Some((d, e)) = u.queue_front() {
+            fronts.push((d, e as i64));
+        }
+        events += f.events as u64;
+        frames += 1;
+    }
+    u.settle(cut);
+    (frames, presented, events, fronts)
+}
+
+fn cost(members: u64, frames: usize) {
+    for on in [true, false] {
+        let mut p = plane(Config::default(), 1, Order::Sparse, 1, members).unwrap();
+        p.u.rekey_on_advance = on;
+        let mut ns: Vec<u64> = Vec::with_capacity(frames);
+        let mut events = 0u64;
+        for _ in 0..frames {
+            let t = Instant::now();
+            let f = p.u.frame_to(1.0 / 60.0, 1.0, Budget::wall(5.0), i64::MAX);
+            ns.push(t.elapsed().as_nanos() as u64);
+            events += f.events as u64;
+        }
+        let mut sorted = ns.clone();
+        sorted.sort_unstable();
+        let (n, med, p95) = (p.u.n_bodies() as f64, median(&mut ns), sorted[(sorted.len() * 95) / 100]);
+        let med_per_body = med as f64 / n.max(1.0);
+        println!(
+            "cost members={members} rekey_on={on} bodies={} median_ns={} p95_ns={} events={events} median_ns_per_body={:.1}",
+            p.u.n_bodies(),
+            med,
+            p95,
+            med_per_body,
+        );
+    }
+}
+
+fn digest(seed: u64, members: u64, starve: u64, secs: f64) {
+    let cut = (secs / GAME_S) as i64;
+    for arm in ["shipped", "never", "lazy"] {
+        let mut p = plane(Config::default(), seed, Order::Sparse, 1, members).unwrap();
+        // Scripted decisions at canonical ticks: burn, release, reverse, release (a moving player).
+        let s = (1.0 / GAME_S) as i64;
+        p.u.schedule(1 * s, 0b0000_0001).unwrap();
+        p.u.schedule(3 * s, 0).unwrap();
+        p.u.schedule(5 * s, 0b0000_0010).unwrap();
+        p.u.schedule(7 * s, 0).unwrap();
+        match arm {
+            "shipped" => {} // rekey_on_advance = true, the shipped default
+            "never" => p.u.rekey_on_advance = false,
+            "lazy" => {
+                p.u.rekey_on_advance = false;
+                p.u.rekey(); // start from the shipped observer once
+            }
+            _ => unreachable!(),
+        }
+        let (frames, presented, events, fronts) = run_to_cut(&mut p.u, p.player, cut, 60.0, arm == "lazy", starve);
+        // The trace fingerprint: where each frame's presented tick landed.
+        let mut tr = blake3::Hasher::new();
+        for (t, e) in &presented {
+            tr.update(&t.to_le_bytes());
+            tr.update(&e.to_le_bytes());
+        }
+        let mut fr = blake3::Hasher::new();
+        for (d, e) in &fronts {
+            fr.update(&d.to_le_bytes());
+            fr.update(&e.to_le_bytes());
+        }
+        let front_trace = fr.finalize().to_hex().to_string()[..16].to_string();
+        println!(
+            "digest seed={seed} members={members} starve={starve} secs={secs} arm={arm} digest={} frames={} events={} trace={:?} front_trace={front_trace} fronts={} encounters={} contacts={} kicks={} refusals={} lost={}",
+            p.u.digest(),
+            frames,
+            events,
+            tr.finalize().to_hex().to_string()[..16].to_string(),
+            fronts.len(),
+            p.u.stats.encounters,
+            p.u.contacts,
+            p.u.stats.kicks,
+            p.u.stats.refused,
+            p.u.stats.lost,
+        );
+    }
+}
+
+fn pop(n: usize, frames: usize) {
+    // A synthetic population of individual bodies (the fixed tier's regime), no player.
+    let (mu_log2, sep) = (-10i32, 527_000_000i64);
+    let ships: Vec<(i64, u32)> = (0..n)
+        .map(|i| ((sep as f64 * (1.0 + 0.02 * ((i % 50) as f64))) as i64, (i as u32).wrapping_mul(0x9E37_79B9)))
+        .collect();
+    for on in [true, false] {
+        let mut w = emergent_universe::scenario::restricted(mu_log2, sep, 49_000, &ships, 1).unwrap();
+        w.u.rekey_on_advance = on;
+        w.u.settle(1); // let the initial items resolve so the probe measures the steady frame
+        let mut ns: Vec<u64> = Vec::with_capacity(frames);
+        let mut events = 0u64;
+        for _ in 0..frames {
+            let t = Instant::now();
+            let f = w.u.frame_to(1.0 / 60.0, 1.0, Budget::wall(5.0), i64::MAX);
+            ns.push(t.elapsed().as_nanos() as u64);
+            events += f.events as u64;
+        }
+        let mut sorted = ns.clone();
+        sorted.sort_unstable();
+        let nb = w.u.n_bodies() as f64;
+        let (med, p95) = (median(&mut ns), sorted[(sorted.len() * 95) / 100]);
+        println!(
+            "pop n={n} rekey_on={on} bodies={} median_ns={med} p95_ns={p95} events={events} median_ns_per_body={:.2}",
+            w.u.n_bodies(),
+            med as f64 / nb.max(1.0),
+        );
+    }
+}
+
+fn leak(seed: u64, rtf: f64) {
+    // The same wall timeline of key flips, three presentation rates.
+    let flips = [(0.20, 0b0000_0001u8), (0.60, 0), (1.00, 0b0000_0010), (1.40, 0)];
+    let wall = 2.0; // wall seconds of flight
+    let cut = (wall * rtf / GAME_S) as i64;
+    for hz in [30.0, 60.0, 144.0] {
+        for mode in ["raw", "grid"] {
+            let mut p = plane(Config::default(), seed, Order::Sparse, 1, 48).unwrap();
+            // grid ≥ the slowest pacing's per-frame game-time advance (rtf/30 s)
+            let q0 = ((rtf / 30.0) / GAME_S).ceil() as i64;
+            let q = 1i64 << (usize::BITS - q0.max(1).leading_zeros());
+            let mut i = 0u64;
+            let mut next_flip = 0usize;
+            while (i as f64) / hz < wall && p.u.now < cut {
+                let t = i as f64 / hz;
+                // each wall flip fires exactly once, at the first frame past its wall time
+                while next_flip < flips.len() && t + 1e-9 >= flips[next_flip].0 {
+                    let (w, k) = flips[next_flip];
+                    match mode {
+                        // exactly what xtask's session.rs does: the decision is logged at `now`,
+                        // the presented tick — which depends on the pacing
+                        "raw" => p.u.input(p.u.now, k).unwrap(),
+                        // the fix shape: the decision tick derives from the wall timeline (the
+                        // same for every pacing), snapped up to a canonical grid of q ticks
+                        "grid" => {
+                            let ticks = (w * rtf / GAME_S) as i64;
+                            p.u.schedule((((ticks + q - 1) / q) * q).max(1), k).unwrap();
+                        }
+                        _ => unreachable!(),
+                    }
+                    next_flip += 1;
+                }
+                p.u.frame_to(1.0 / hz, rtf, Budget::wall(5.0), cut);
+                i += 1;
+            }
+            p.u.settle(cut);
+            println!(
+                "leak seed={seed} rtf={rtf} hz={hz} mode={mode} digest={} inputs={} encounters={} contacts={} grid_ticks={}",
+                p.u.digest(),
+                p.u.inputs.len(),
+                p.u.stats.encounters,
+                p.u.contacts,
+                q
+            );
+        }
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    match args[1].as_str() {
+        "pop" => pop(args.get(2).and_then(|s| s.parse().ok()).unwrap_or(1000), args.get(3).and_then(|s| s.parse().ok()).unwrap_or(300)),
+        "cost" => cost(args.get(2).and_then(|s| s.parse().ok()).unwrap_or(48), args.get(3).and_then(|s| s.parse().ok()).unwrap_or(600)),
+        "digest" => digest(args.get(2).and_then(|s| s.parse().ok()).unwrap_or(1), args.get(3).and_then(|s| s.parse().ok()).unwrap_or(48), args.get(4).and_then(|s| s.parse().ok()).unwrap_or(0), args.get(5).and_then(|s| s.parse().ok()).unwrap_or(8.0)),
+        "leak" => leak(args.get(2).and_then(|s| s.parse().ok()).unwrap_or(1), args.get(3).and_then(|s| s.parse().ok()).unwrap_or(100.0)),
+        _ => eprintln!("usage: rekey_scout cost|digest|leak …"),
+    }
+}
