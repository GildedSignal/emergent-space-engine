+//! r5's budget axis, allocator arm (lab/results/20261017-1447-second-20261017-1330-redteam-68e7-506c):
+//! the sparse queue's own slack-ordered schedule under a compute budget, sabotage and
+//! competing load. `Allocator` hosts `EventCore` regions (r5's sparse order) and slices
+//! them into units of one starved budget; the union of every region's world and the merged
+//! log must equal one `Chronon` over the whole scene — the licence the allocator's own
+//! invariance suite claims for the dense order, here executed for the sparse one.
+//!
+//! Matrix per scene: workers {1, 8} × sabotage off/on × fixed budgets {1 event, calibrated},
+//! plus a loaded cell (3 spinning hogs, calibrated budget, sabotage on: the calibration
+//! measures a slower box, so the unit budgets shrink and the schedule churns — the bits must
+//! not notice). Rows go to `$R5S_OUT/r5sa.json`; metrics.py assembles metrics.json.
+use emergent_allocator::{scenes, Allocator, Config, Factory, Report};
+use emergent_lattice::{chronon::Chronon, law::World, Stepper, Tick};
+use emergent_lattice_event::EventCore;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+
+fn factory() -> Factory<EventCore> {
+    Arc::new(|w| EventCore::new(w, false).expect("a region's world is a valid world"))
+}
+
+fn reference(scene: &[World], t: Tick) -> (String, String, u64) {
+    let mut c = Chronon::new(scenes::union(scene), false).unwrap();
+    c.run_to(t);
+    (c.world().digest(), c.log().digest().clone(), c.log().contacts)
+}
+
+fn run(scene: &[World], t: Tick, cfg: Config) -> ((String, String, u64), Report) {
+    let mut a = Allocator::new(scene.to_vec(), factory(), cfg).unwrap();
+    let rep = a.run_to(t);
+    let (world, log) = (a.world(), a.log());
+    let contacts = log.contacts;
+    ((world.digest(), log.digest().clone(), contacts), rep)
+}
+fn workers(n: usize) -> (usize, usize) {
+    (n.min(4), n.saturating_sub(4))
+}
+
+struct Hogs {
+    stop: Arc<AtomicBool>,
+    handles: Vec<std::thread::JoinHandle<()>>,
+}
+
+impl Hogs {
+    fn spawn(n: usize) -> Self {
+        let stop = Arc::new(AtomicBool::new(false));
+        let handles = (0..n)
+            .map(|_| {
+                let s = stop.clone();
+                std::thread::spawn(move || while !s.load(Ordering::Relaxed) { std::hint::spin_loop(); })
+            })
+            .collect();
+        Hogs { stop, handles }
+    }
+}
+
+impl Drop for Hogs {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::SeqCst);
+        for h in self.handles.drain(..) {
+            let _ = h.join();
+        }
+    }
+}
+
+/// One scene through the matrix; `out` collects the jsonl lines.
+fn matrix(out: &mut String, name: &str, scene: &[World], t: Tick) {
+    let expected = reference(scene, t);
+    let mut cell = |tag: &str, cfg: Config, hogs: usize| {
+        let nw = cfg.p_workers + cfg.e_workers;
+        let (got, rep) = if hogs > 0 {
+            let h = Hogs::spawn(hogs);
+            let r = run(scene, t, cfg);
+            drop(h);
+            r
+        } else {
+            run(scene, t, cfg)
+        };
+        let identical = got == expected;
+        let r = &rep.regions;
+        out.push_str(&format!(
+            "{{\"scene\":\"{name}\",\"config\":\"alloc-sparse-starved\",\"cell\":\"{tag}\",\"identical\":{identical},\"contacts\":{},\"units\":{},\"rollbacks\":{},\"merges\":{},\"splits\":{},\"over_budget\":{},\"workers\":{nw},\"secs\":{:.3}}}\n",
+            got.2, rep.units.count, r.rollbacks, r.merges, r.splits, rep.units.over_budget_units, rep.wall_seconds
+        ));
+        println!(
+            "{name} {tag}: identical {identical} contacts {} units {} rollbacks {} merges {} splits {} over_budget {} {:.0} ms",
+            got.2, rep.units.count, r.rollbacks, r.merges, r.splits, rep.units.over_budget_units, rep.wall_seconds * 1e3
+        );
+        identical
+    };
+    for n in [1usize, 8] {
+        for sabotage in [None, Some(0xBAD5EEDu64)] {
+            for budget in [Some(1u64), None] {
+                let (p, e) = workers(n);
+                let cfg = Config { p_workers: p, e_workers: e, fixed_budget: budget, sabotage, ..Config::default() };
+                let tag = format!("w{n}-sab{}-b{}", sabotage.is_some(), budget.map(|b| b.to_string()).unwrap_or_else(|| "cal".into()));
+                cell(&tag, cfg, 0);
+            }
+        }
+    }
+    // Loaded: calibrated budgets re-measured on a contended box, sabotage on, 8 workers.
+    let (p, e) = workers(8);
+    let cfg = Config { p_workers: p, e_workers: e, fixed_budget: None, sabotage: Some(0xBAD5EED), ..Config::default() };
+    cell("w8-sab1-bcal-LOADED3", cfg, 3);
+}
+
+fn write(name: &str, out: &str) {
+    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .and_then(|p| p.parent())
+        .unwrap()
+        .join(std::env::var("R5S_OUT").unwrap_or_else(|_| "lab/results/20261017-1447-second-20261017-1330-redteam-68e7-506c/rows".into()));
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(format!("{}/r5sa-{}.json", dir.display(), name), out).unwrap();
+}
+
+#[test]
+fn islands() {
+    // Four islands, two Pass clusters closing head-on: regions merge while starved.
+    let mut out = String::new();
+    matrix(&mut out, "islands1", &scenes::islands(256, 1), 1200);
+    write("islands1", &out);
+}
+
+#[test]
+fn galaxy() {
+    // Nine clusters on a grid, two drifting together.
+    let mut out = String::new();
+    matrix(&mut out, "galaxy", &scenes::galaxy(256, 3, 3, 40, 450, 1, 11), 800);
+    write("galaxy", &out);
+}
+
+#[test]
+fn islands_deep_starvation() {
+    // A second islands draw, held out (predictions.md P5): registered before the run.
+    let mut out = String::new();
+    matrix(&mut out, "islands2", &scenes::islands(256, 2), 900);
+    write("islands2", &out);
+}
