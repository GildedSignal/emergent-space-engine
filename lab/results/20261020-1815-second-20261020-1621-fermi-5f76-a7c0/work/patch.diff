+/// Print-only allocation-scope instrument (off = shipped: `enter`/`exit` return without touching
+/// anything unless `ES_ALLOC_SCOPE=1`). Marks the code as running inside the frame's top-level
+/// item of class `c` (0 = the frame's base, everything an item does not do); a counting
+/// `GlobalAlloc` in an example reads the depth and the outermost class, so allocation bytes are
+/// attributed to the fired item's own scope, never through budget-coupled windows. Nested items
+/// (the player's pull of due ships) stay inside the outermost item's scope.
+pub mod alloc_scope {
+    use std::cell::Cell;
+    thread_local! {
+        static DEPTH: Cell<u32> = const { Cell::new(0) };
+        static CLASS: Cell<u32> = const { Cell::new(0) };
+    }
+    fn on() -> bool {
+        static ON: std::sync::LazyLock<bool> =
+            std::sync::LazyLock::new(|| std::env::var("ES_ALLOC_SCOPE").as_deref() == Ok("1"));
+        *ON
+    }
+    /// Enter the fired item of class `c` (planet, moon, ship, player, fleet).
+    pub fn enter(c: usize) {
+        if !on() {
+            return;
+        }
+        DEPTH.with(|d| {
+            if d.get() == 0 {
+                CLASS.with(|k| k.set(1 + c as u32));
+            }
+            d.set(d.get() + 1);
+        });
+    }
+    pub fn exit() {
+        if !on() {
+            return;
+        }
+        DEPTH.with(|d| d.set(d.get() - 1));
+    }
+    /// The outermost scope (0 = frame base): what an allocator attributes the current call to.
+    pub fn scope() -> u32 {
+        if DEPTH.with(|d| d.get()) == 0 {
+            0
+        } else {
+            CLASS.with(|k| k.get())
+        }
+    }
+}
