+/// readout count of this call lands in `cache.readouts`. Each row comes with the body it was read from
+/// (`None` for the star and the fleet's own members): a member handed out to a doll is a body, and its
+/// row carries the fleet-member id, not the body index.
+pub fn gather_rows(u: &Universe, names: &[String], cache: &mut ViewCache, due: &[usize]) -> Option<(Head, Vec<(Option<usize>, Seen)>)> {
