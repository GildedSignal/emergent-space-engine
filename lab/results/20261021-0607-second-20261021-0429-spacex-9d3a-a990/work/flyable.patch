+//! The row-set deletion (2df1's policy) wired into the flyable frame: the wire carries only the rows
+//! that could move what the player sees, so the frame's view half stops being Θ(N).
+//!
+//! All client-visible state, no physics of its own: `gather_rows` (the shipped crossings) reads exactly
+//! the bodies whose drawn pixel could have crossed half a display pixel since their last read (a timing
+//! wheel of dues, drift-measured, ×4 slack), plus the star and fleet marker rows and the panel band the
+//! page always prints. The quantum lives in the row's own frame, not the server's tick (PRINCIPLES #28:
+//! the view is an instrument — the quantum is the pixel). Ported from 2df1's `flyframe2` example, with
+//! the session's rtf (game seconds per presented frame) in the drift bound, and the delta JSON shaped
+//! like [`super::session`]'s `view_json` (header every frame, `rows` that moved, `gone` ids).
+//!
+//! The audit is the instrument's control: the shipped `gather_cached` on the same frame, compared
+//! pixel-for-pixel against what the client would draw from its held rows (the page's own draw
+//! conditions), plus the panel's printed values. It runs after the frame is timed and is reported
+//! separately, never charged to a channel.
+use emergent_universe::view::{gather_rows, Seen, ViewCache};
+use emergent_universe::view::Head;
+use serde_json::{json, Value};
+use std::collections::HashMap;
+
+const W: f64 = 1920.0;
+const H: f64 = 1080.0;
+const CX: f64 = W / 2.0;
+const CY: f64 = H / 2.0;
+/// The map: the page's fitted view (fitLog holds the nearest kind ≤ 3 row at 0.33·R pixels, R = 432).
+const FIT_FRACTION: f64 = 0.33 * 432.0;
+const MARGIN: f64 = 20.0;
+const WHEEL: usize = 1 << 15;
+const DUE_CAP: u64 = 1 << 14;
+
+fn map_px_at(offset: [f64; 2], s: f64) -> (f64, f64) {
+    (CX + offset[0] * s, CY + offset[1] * s)
+}
+
+fn on_canvas(px: (f64, f64)) -> bool {
+    px.0 >= -MARGIN && px.0 <= W + MARGIN && px.1 >= -MARGIN && px.1 <= H + MARGIN
+}
+
+fn gap_to_canvas(px: (f64, f64)) -> f64 {
+    let dx = if px.0 < 0.0 { -px.0 } else if px.0 > W { px.0 - W } else { 0.0 };
+    let dy = if px.1 < 0.0 { -px.1 } else if px.1 > H { px.1 - H } else { 0.0 };
+    (dx * dx + dy * dy).sqrt()
+}
+
+/// The sky polar (radius, angle) of a row: heading-free, so the client derives rotation.
+fn sky_pol(direction: [f64; 2], light_seconds: f64) -> (f64, f64) {
+    let r_sky = 0.45 * W.min(H);
+    let (lo, hi) = (-5.0f64, 3.6f64);
+    let x = ((light_seconds.max(1e-6).log10() - lo) / (hi - lo)).clamp(0.0, 1.0);
+    (r_sky * x, direction[1].atan2(direction[0]))
+}
+
+fn wire_id_of(seen_id: usize) -> u64 {
+    if seen_id == usize::MAX {
+        u64::MAX
+    } else if seen_id >= 1_000_000 {
+        (1u64 << 40) + seen_id as u64
+    } else {
+        seen_id as u64
+    }
+}
+
+struct RowState {
+    wire_id: u64,
+    kind: u8,
+    light_seconds: f64,
+    offset: [f64; 2],
+    closing: f64,
+    shift: f64,
+    served: bool,
+    /// The pixel the client draws on the map from its held row (its quantum anchor).
+    map_anchor: (i64, i64),
+    /// The last exact readout's map pixel (drift is measured between reads).
+    read_px: (f64, f64),
+    sky_read: (f64, f64),
+    due: u64,
+    last_read: u64,
+    map_drift: f64,
+    sky_drift: f64,
+    interval: u64,
+    in_band: bool,
+}
+
+#[derive(Clone)]
+struct Held {
+    light_seconds: f64,
+    offset: [f64; 2],
+    closing: f64,
+    shift: f64,
+    map_anchor: (i64, i64),
+    #[allow(dead_code)]
+    sky_pol: (f64, f64),
+    #[allow(dead_code)]
+    kind: u8,
+}
+
+/// What one frame's gather phase produced (the JSON phase builds from it).
+pub struct FrameOut {
+    pub head: Head,
+    /// Indices into the gather's return list that the wire carries.
+    pub served: Vec<usize>,
+    pub gone: Vec<u64>,
+    pub readouts: u64,
+}
+
+pub struct RowSet {
+    rows: Vec<Option<RowState>>,
+    wheel: Vec<Vec<u32>>,
+    always: Vec<usize>,
+    band: Vec<usize>,
+    held: HashMap<u64, Held>,
+    /// The map's scale, as log10 of pixels per light-second (the page's fitted zoom at the fill).
+    view_log: f64,
+    rtf: f64,
+    /// The fill (one full read, the page's own first-frame cost), ms.
+    pub fill_ms: f64,
+    pub fill_rows: usize,
+    pub served_total: u64,
+    pub served_max: usize,
+    pub readouts_total: u64,
+    pub gone_total: u64,
+    pub frames: u64,
+    wire_bytes: Vec<usize>,
+    // The audit (2df1's): violations of the display exactness against the shipped gather.
+    pub audit_frames: u64,
+    pub audit_drawn: u64,
+    pub viol_px: u64,
+    pub viol_miss: u64,
+    pub viol_ghost: u64,
+    pub viol_panel: u64,
+}
+
+impl RowSet {
+    /// The fill: every body read once (the first full read, the page's own first-frame cost), the
+    /// fitted zoom taken from it, every row's first due set. `cache` is the frame's own view memo.
+    pub fn fill(u: &emergent_universe::Universe, names: &[String], cache: &mut ViewCache, rtf: f64) -> crate::Result<Self> {
+        let t = std::time::Instant::now();
+        let all: Vec<usize> = (0..u.n_bodies()).collect();
+        let (_head, seen) = gather_rows(u, names, cache, &all).ok_or("no view: the player is unreadable")?;
+        let near = seen.iter().filter(|(_, s)| s.kind <= 3).map(|(_, s)| s.light_seconds).fold(f64::INFINITY, f64::min);
+        let mut d = Self {
+            rows: Vec::with_capacity(u.n_bodies()),
+            wheel: vec![Vec::new(); WHEEL],
+            always: Vec::new(),
+            band: Vec::new(),
+            held: HashMap::new(),
+            view_log: (FIT_FRACTION / near.max(1e-6)).log10(),
+            rtf,
+            fill_ms: 0.0,
+            fill_rows: seen.len(),
+            served_total: 0,
+            served_max: 0,
+            readouts_total: 0,
+            gone_total: 0,
+            frames: 0,
+            wire_bytes: Vec::new(),
+            audit_frames: 0,
+            audit_drawn: 0,
+            viol_px: 0,
+            viol_miss: 0,
+            viol_ghost: 0,
+            viol_panel: 0,
+        };
+        for _ in 0..u.n_bodies() {
+            d.rows.push(None);
+        }
+        for (bi, s) in &seen {
+            if let Some(i) = bi {
+                d.absorb(*i, s, 0);
+            }
+        }
+        for i in 0..d.rows.len() {
+            if d.rows[i].as_ref().is_some_and(|r| r.kind <= 2) {
+                d.always.push(i);
+            }
+        }
+        d.reband();
+        d.fill_ms = t.elapsed().as_secs_f64() * 1e3;
+        Ok(d)
+    }
+
+    fn s(&self) -> f64 {
+        10f64.powf(self.view_log)
+    }
+
+    /// The next due from observed drift and the gap to the canvas: when half a display pixel (or the
+    /// margin) could have been crossed. The ×4 slack is acceleration and arrival-rate room.
+    fn due_from(&mut self, i: usize, f: u64) -> u64 {
+        let r = self.rows[i].as_ref().unwrap();
+        let map_d = r.map_drift * 4.0;
+        let sky_d = r.sky_drift * 4.0;
+        let gap = gap_to_canvas(r.read_px);
+        let backoff = r.interval.saturating_mul(4).max(1) as f64;
+        let mut q = backoff;
+        let mut frozen = true;
+        if map_d <= 0.0 && sky_d <= 0.0 {
+            let gap_ls = if self.s() > 0.0 { gap / self.s() } else { f64::INFINITY };
+            let dt_frame = 1.0 / 60.0 * self.rtf;
+            q = q.min((gap_ls / dt_frame).ceil().max(1.0));
+        }
+        if gap > 0.0 && r.kind >= 3 {
+            if map_d > 0.0 {
+                q = q.min(gap / map_d);
+                frozen = false;
+            }
+        } else if map_d > 0.0 {
+            q = q.min(0.5 / map_d);
+            frozen = false;
+        }
+        if r.kind <= 2 && sky_d > 0.0 {
+            q = q.min(0.5 / sky_d);
+            frozen = false;
+        }
+        let jitter = if frozen { 1 + (i.wrapping_mul(2654435761) % 7) as u64 } else { 0 };
+        let q = (q.floor().max(1.0) as u64).saturating_add(jitter).min(DUE_CAP);
+        self.rows[i].as_mut().unwrap().interval = q;
+        f + q
+    }
+
+    fn reslot(&mut self, i: usize, due: u64) {
+        if due != self.rows[i].as_ref().unwrap().due {
+            self.rows[i].as_mut().unwrap().due = due;
+            self.wheel[(due as usize) % WHEEL].push(i as u32);
+        }
+    }
+
+    /// The panel band: the nearest bodies by cached distance (the page prints the nearest 8; the band
+    /// keeps a 2× slack and 16 rows so membership changes never miss a read).
+    fn reband(&mut self) {
+        let mut best: Vec<(f64, usize)> = Vec::new();
+        for (i, ro) in self.rows.iter().enumerate() {
+            let Some(r) = ro else { continue };
+            if r.kind == 4 {
+                continue;
+            }
+            if best.len() < 16 {
+                best.push((r.light_seconds, i));
+                best.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap());
+            } else if r.light_seconds < best[15].0 {
+                best[15] = (r.light_seconds, i);
+                best.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap());
+            }
+        }
+        let cut = if best.is_empty() { f64::INFINITY } else { best[best.len() - 1].0 * 2.0 + 1e-9 };
+        self.band = self.rows.iter().enumerate().filter_map(|(i, ro)| {
+            let r = ro.as_ref()?;
+            (r.kind != 4 && r.light_seconds <= cut).then_some(i)
+        }).collect();
+        for ro in self.rows.iter_mut() {
+            if let Some(r) = ro.as_mut() {
+                r.in_band = false;
+            }
+        }
+        for &i in &self.band {
+            if let Some(r) = self.rows[i].as_mut() {
+                r.in_band = true;
+            }
+        }
+    }
+
+    /// The fill's absorption of a body row: it becomes a RowState (the served decision applies at once).
+    fn absorb(&mut self, idx: usize, s: &Seen, f: u64) {
+        let wid = wire_id_of(s.id);
+        let map_px = map_px_at(s.offset, self.s());
+        let on = on_canvas(map_px);
+        let serve = s.kind <= 2 || on;
+        let pol = sky_pol(s.direction, s.light_seconds);
+        let r = RowState {
+            wire_id: wid,
+            kind: s.kind,
+            light_seconds: s.light_seconds,
+            offset: s.offset,
+            closing: s.closing,
+            shift: s.shift,
+            served: serve,
+            map_anchor: (map_px.0.round() as i64, map_px.1.round() as i64),
+            read_px: map_px,
+            sky_read: pol,
+            due: f + 1 + (idx.wrapping_mul(2654435761) % 7) as u64,
+            last_read: f,
+            map_drift: 0.0,
+            sky_drift: 0.0,
+            interval: 1,
+            in_band: false,
+        };
+        if serve {
+            self.held.insert(wid, Held { light_seconds: r.light_seconds, offset: r.offset, closing: r.closing, shift: r.shift, map_anchor: r.map_anchor, sky_pol: pol, kind: r.kind });
+        }
+        let due = r.due;
+        self.rows[idx] = Some(r);
+        self.wheel[(due as usize) % WHEEL].push(idx as u32);
+    }
+
+    /// One frame's gather half: who is due (the wheel, the markers, the band, the newborns), the read
+    /// itself, and the serve decisions. The JSON half ([`RowSet::delta_json`]) builds the wire from
+    /// the returned indices; the session times the two halves as its own dashboard channels.
+    pub fn gather_half(&mut self, u: &emergent_universe::Universe, names: &[String], cache: &mut ViewCache) -> crate::Result<(Vec<(Option<usize>, Seen)>, FrameOut)> {
+        let f = self.frames;
+        // Births and deaths: the count grew (or the slow death sweep) pays one alive-check per body;
+        // the engine's own event feed would say so at once — the sweep stands in for it.
+        let nb_now = u.n_bodies();
+        let grew = nb_now > self.rows.len();
+        while self.rows.len() < nb_now {
+            self.rows.push(None);
+        }
+        let mut newborns: Vec<usize> = Vec::new();
+        let mut pending_gone: Vec<u64> = Vec::new();
+        if grew || f % 240 == 0 {
+            for i in 0..nb_now {
+                let alive = u.bodies().alive(i);
+                match (self.rows[i].is_some(), alive) {
+                    (false, true) => newborns.push(i),
+                    (true, false) => {
+                        if let Some(r) = self.rows[i].as_ref().filter(|r| r.served) {
+                            pending_gone.push(r.wire_id);
+                        }
+                        self.rows[i] = None;
+                    }
+                    _ => {}
+                }
+            }
+        }
+        // Who is due: the wheel's slot, the marker rows, the panel band, the newborns.
+        let slot = std::mem::take(&mut self.wheel[(f % WHEEL as u64) as usize]);
+        let mut due: Vec<usize> = Vec::with_capacity(64);
+        for i in slot {
+            let i = i as usize;
+            if self.rows[i].as_ref().is_some_and(|r| r.due <= f) {
+                due.push(i);
+            }
+        }
+        for &i in self.always.iter().chain(self.band.iter()) {
+            if self.rows[i].is_some() {
+                due.push(i);
+            }
+        }
+        due.extend(newborns.drain(..));
+        due.sort_unstable();
+        due.dedup();
+        let (head, seen) = gather_rows(u, names, cache, &due).ok_or("no view: the player is unreadable")?;
+        // The nearest fleet row is printed even off-canvas.
+        let mut nearest_fleet: Option<u64> = None;
+        let mut best_ls = f64::INFINITY;
+        for (_, s) in &seen {
+            if s.kind == 4 && s.light_seconds < best_ls {
+                best_ls = s.light_seconds;
+                nearest_fleet = Some(wire_id_of(s.id));
+            }
+        }
+        let mut served: Vec<usize> = Vec::new();
+        let mut gone: Vec<u64> = pending_gone;
+        for (k, (bi, s)) in seen.iter().enumerate() {
+            match bi {
+                Some(i) => {
+                    if self.rows[*i].is_none() {
+                        self.absorb(*i, s, f);
+                        if self.rows[*i].as_ref().is_some_and(|r| r.served) {
+                            served.push(k);
+                        }
+                    } else if self.absorb_row(*i, s, f, nearest_fleet == Some(wire_id_of(s.id)), &mut gone) {
+                        served.push(k);
+                    }
+                }
+                None => {
+                    // The star's and the fleets' rows (read every frame): the same canvas test decides the wire.
+                    let wid = wire_id_of(s.id);
+                    let pol = sky_pol(s.direction, s.light_seconds);
+                    let map_px = map_px_at(s.offset, self.s());
+                    let on = on_canvas(map_px);
+                    let do_serve = if s.kind <= 2 || nearest_fleet == Some(wid) {
+                        true
+                    } else {
+                        match self.held.get(&wid) {
+                            None => on,
+                            Some(h) => on && (map_px.0.round() as i64, map_px.1.round() as i64) != h.map_anchor,
+                        }
+                    };
+                    let was_served = self.held.contains_key(&wid);
+                    if do_serve {
+                        self.held.insert(wid, Held { light_seconds: s.light_seconds, offset: s.offset, closing: s.closing, shift: s.shift, map_anchor: (map_px.0.round() as i64, map_px.1.round() as i64), sky_pol: pol, kind: s.kind });
+                        served.push(k);
+                    } else if was_served && !on {
+                        gone.push(wid);
+                        self.held.remove(&wid);
+                    }
+                }
+            }
+        }
+        // Rows that were due but produced nothing are gone (unreadable or lost).
+        for &i in &due {
+            if let Some(r) = self.rows[i].as_ref() {
+                if r.last_read < f && r.served {
+                    gone.push(r.wire_id);
+                    self.held.remove(&r.wire_id);
+                    self.rows[i].as_mut().unwrap().served = false;
+                }
+            }
+        }
+        if f % 60 == 59 {
+            self.reband();
+        }
+        let readouts = cache.readouts;
+        self.frames += 1;
+        self.readouts_total += readouts;
+        self.served_total += served.len() as u64;
+        self.served_max = self.served_max.max(served.len());
+        self.gone_total += gone.len() as u64;
+        Ok((seen, FrameOut { head, served, gone, readouts }))
+    }
+
+    /// A due body row: the drift update, the serve decision (half a pixel at the client), the re-due.
+    fn absorb_row(&mut self, i: usize, s: &Seen, f: u64, force_serve: bool, gone: &mut Vec<u64>) -> bool {
+        let wid = wire_id_of(s.id);
+        let pol = sky_pol(s.direction, s.light_seconds);
+        let map_px = map_px_at(s.offset, self.s());
+        let on = on_canvas(map_px);
+        let r = self.rows[i].as_mut().unwrap();
+        let df = (f - r.last_read).max(1) as f64;
+        let map_drift = (((map_px.0 - r.read_px.0).powi(2) + (map_px.1 - r.read_px.1).powi(2)).sqrt() / df).max(r.map_drift * 0.5);
+        let dr = (pol.0 - r.sky_read.0).abs();
+        let dth = (pol.1 - r.sky_read.1).abs().min(std::f64::consts::TAU - (pol.1 - r.sky_read.1).abs()) * pol.0;
+        let sky_drift = (dr.max(dth) / df).max(r.sky_drift * 0.5);
+        r.light_seconds = s.light_seconds;
+        r.offset = s.offset;
+        r.closing = s.closing;
+        r.shift = s.shift;
+        r.read_px = map_px;
+        r.sky_read = pol;
+        r.last_read = f;
+        r.map_drift = map_drift;
+        r.sky_drift = sky_drift;
+        let was = r.served;
+        let do_serve = if r.kind <= 2 || force_serve || r.in_band {
+            true
+        } else if on {
+            !was || (map_px.0.round() as i64, map_px.1.round() as i64) != self.held.get(&wid).map(|h| h.map_anchor).unwrap_or((i64::MIN, i64::MIN))
+        } else {
+            false
+        };
+        let mut serve = false;
+        if do_serve {
+            r.served = true;
+            r.map_anchor = (map_px.0.round() as i64, map_px.1.round() as i64);
+            let rr = self.rows[i].as_ref().unwrap();
+            self.held.insert(wid, Held { light_seconds: rr.light_seconds, offset: rr.offset, closing: rr.closing, shift: rr.shift, map_anchor: rr.map_anchor, sky_pol: pol, kind: rr.kind });
+            serve = true;
+        } else if was && !on {
+            self.rows[i].as_mut().unwrap().served = false;
+            gone.push(wid);
+            self.held.remove(&wid);
+        }
+        let due = self.due_from(i, f);
+        self.reslot(i, due);
+        serve
+    }
+
+    /// The delta wire: the header every frame, the rows that moved, the ids that left.
+    pub fn delta_json(&mut self, seen: &[(Option<usize>, Seen)], out: &FrameOut, keys: u8) -> Value {
+        let rows: Vec<_> = out.served.iter().map(|&k| {
+            let s = &seen[k].1;
+            json!({"id": wire_id_of(s.id), "name": s.name, "kind": s.kind, "direction": s.direction, "light_seconds": s.light_seconds,
+                   "offset": s.offset, "closing": s.closing, "color": s.color, "shift": s.shift})
+        }).collect();
+        let h = &out.head;
+        json!({
+            "tick": h.t_now, "coordinate": h.t_now as f64 * emergent_universe::view::TICK_SECONDS, "proper": h.proper, "rate": h.rate_obs,
+            "beta": h.vo, "doll_rate": h.doll_rate, "doll_beta": h.doll_beta,
+            "position": [h.xo[0] * emergent_universe::view::TICK_SECONDS, h.xo[1] * emergent_universe::view::TICK_SECONDS],
+            "heading": [h.heading.cos(), h.heading.sin()], "level": 0, "burning": false, "keys": keys, "alive": true,
+            "loss": Option::<String>::None, "refusals": 0,
+            "rows": rows, "gone": out.gone,
+        })
+    }
+
+    pub fn note_wire(&mut self, bytes: usize) {
+        self.wire_bytes.push(bytes);
+    }
+
+    pub fn wire_kb_median(&self) -> f64 {
+        if self.wire_bytes.is_empty() {
+            return 0.0;
+        }
+        let mut s = self.wire_bytes.clone();
+        s.sort_unstable();
+        s[s.len() / 2] as f64 / 1e3
+    }
+
+    /// The audit: the shipped gather's rows against what the client draws from its held rows (the
+    /// page's own draw conditions), plus the panel the page prints. One pixel of disagreement is a
+    /// violation; a drawn row with no held row is a miss; a held on-canvas row the exact does not draw
+    /// is a ghost.
+    pub fn audit(&mut self, exact: &emergent_universe::view::View) {
+        self.audit_frames += 1;
+        let s = self.s();
+        for e in &exact.seen {
+            let wid = wire_id_of(e.id);
+            let map_px = map_px_at(e.offset, s);
+            let draws = e.kind <= 2 || on_canvas(map_px);
+            let h = self.held.get(&wid);
+            if draws {
+                self.audit_drawn += 1;
+                match h {
+                    None => self.viol_miss += 1,
+                    Some(h) => {
+                        let ex = (map_px.0.round() as i64, map_px.1.round() as i64);
+                        if ex != h.map_anchor {
+                            self.viol_px += 1;
+                        }
+                    }
+                }
+            } else if let Some(h) = h {
+                let hp = map_px_at(h.offset, s);
+                if on_canvas(hp) && e.kind > 2 {
+                    self.viol_ghost += 1;
+                }
+            }
+        }
+        let mut panel: Vec<&Seen> = exact.seen.iter().filter(|e| e.kind != 4).collect();
+        panel.sort_by(|a, b| a.light_seconds.partial_cmp(&b.light_seconds).unwrap());
+        for e in panel.iter().take(8) {
+            match self.held.get(&wire_id_of(e.id)) {
+                None => self.viol_panel += 1,
+                Some(h) => {
+                    let bad = (h.light_seconds - e.light_seconds).abs() > 1e-4 * e.light_seconds.abs() + 1e-12
+                        || (h.closing - e.closing).abs() > 1e-4 * e.closing.abs() + 1e-12
