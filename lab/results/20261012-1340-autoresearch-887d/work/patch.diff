diff --git a/crates/universe/examples/bench_kick.rs b/crates/universe/examples/bench_kick.rs
new file mode 100644
index 00000000..e3e4bc7e
--- /dev/null
+++ b/crates/universe/examples/bench_kick.rs
@@ -0,0 +1,45 @@
+//! Autoresearch bench (run 20261012-1340): the plane's restricted scene through the public API.
+//! Scalar metric: ns per kick event. Behaviour constraint: `Universe::digest()` at a fixed horizon
+//! (canonical, cache- and schedule-independent) plus the crate's test suite.
+//! Usage: bench_kick [ships] [periods] [step_log2]
+use emergent_universe::scenario::{restricted_with, STAR_RADIUS};
+use emergent_universe::world::Mass;
+
+fn main() {
+    let n: usize = std::env::args().nth(1).and_then(|x| x.parse().ok()).unwrap_or(64);
+    let periods: f64 = std::env::args().nth(2).and_then(|x| x.parse().ok()).unwrap_or(2.0);
+    let step_log2: i32 = std::env::args().nth(3).and_then(|x| x.parse().ok()).unwrap_or(7);
+
+    // A Jupiter-class planet (1/1023 of the star) at 0.2 AU; ships on circular orbits spread
+    // from inside to outside that radius, deterministic angles (Q32 turns).
+    let sep: i64 = 20_000_000;
+    let inner = sep / 4;
+    let ships: Vec<(i64, u32)> = (0..n)
+        .map(|i| {
+            let r = inner + (i as i64) * (sep / 2) / (n.max(1) as i64);
+            (r, (i as u32).wrapping_mul(2_940_901))
+        })
+        .collect();
+    let cfg = emergent_universe::Config { step_log2, ..emergent_universe::Config::default() };
+    let mut r = restricted_with(Mass::ratio(1, 1023).expect("mass"), sep, STAR_RADIUS / 100, &ships, 1, cfg).expect("scene");
+    // GM of the star is 1 root^3/tick^2 (the sun's GM/c^2 is one root unit), so T = 2π a^{3/2}.
+    let planet_period = 2.0 * std::f64::consts::PI * (sep as f64).powf(1.5);
+    let horizon = (periods * planet_period) as i64;
+
+    let t0 = std::time::Instant::now();
+    r.u.settle(horizon);
+    let wall = t0.elapsed();
+    let s = &r.u.stats;
+    let events = s.events();
+    println!(
+        "ships={n} periods={periods} step_log2={step_log2} wall_s={:.3} kicks={} events={} boundaries={} handoffs={} opens={} refused={} lost={}",
+        wall.as_secs_f64(), s.kicks, events, s.boundaries, s.handoffs, s.opens, s.refused, s.lost
+    );
+    println!(
+        "ns_per_kick={:.1} ns_per_event={:.1}",
+        wall.as_nanos() as f64 / s.kicks.max(1) as f64,
+        wall.as_nanos() as f64 / events.max(1) as f64
+    );
+    println!("items_by_kind={:?}", s.items);
+    println!("digest={}", r.u.digest());
+}
