+//! H_live probe (lab run 20261009-0819-taleb-1a92): the tail of distinction creation.
+//! Uses only shipped machinery: make_belt + truth_pair (exact local minima of pair distance).
+//! Emits the raw event stream (CSV: i,j,t,d) plus a determinism hash of the sorted stream.
+//! `intruder` replaces body n-1 by an e=0.9 orbit crossing the whole belt.
+
+use emergent_encounters::belt::{make_belt, Spec};
+use emergent_encounters::kepler::Body;
+use emergent_encounters::par_chunks;
+use emergent_encounters::truth::{truth_pair, TruthStats};
+use std::io::Write;
+
+const THREADS: usize = 4;
+
+fn fnv(data: &[(u32, u32, f64, f64)]) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut feed = |x: u64| {
+        for b in x.to_le_bytes() {
+            h ^= b as u64;
+            h = h.wrapping_mul(0x1000_0000_01b3);
+        }
+    };
+    for &(i, j, t, d) in data {
+        feed(i as u64);
+        feed(j as u64);
+        feed(t.to_bits() as u64);
+        feed(d.to_bits() as u64);
+    }
+    h
+}
+
+/// Pairs whose Kepler orbits can come within rho: radial apses overlap.
+fn overlapping(b: &[Body], rho: f64) -> Vec<(u32, u32)> {
+    let mut pairs = Vec::new();
+    for i in 0..b.len() {
+        for j in (i + 1)..b.len() {
+            if b[i].rmax() + rho >= b[j].rmin() && b[j].rmax() + rho >= b[i].rmin() {
+                pairs.push((i as u32, j as u32));
+            }
+        }
+    }
+    pairs
+}
+
+fn run(s: &Spec, intruder: bool) -> (Vec<(u32, u32, f64, f64)>, u64, TruthStats, usize) {
+    let mut b = make_belt(s);
+    if intruder {
+        let a = 0.5 * (s.a_lo + s.a_hi);
+        b[s.n - 1] = Body::new(a, 0.9, 0.0, 0.0);
+    }
+    let pairs = overlapping(&b, s.rho);
+    let t_end = s.orbits * std::f64::consts::TAU;
+    let collect = |chunk: usize| -> (Vec<(u32, u32, f64, f64)>, TruthStats) {
+        let parts = par_chunks(pairs.len(), chunk, THREADS, |r| {
+            let mut out = Vec::new();
+            let mut st = TruthStats::default();
+            let mut tmp = Vec::new();
+            for &(i, j) in &pairs[r] {
+                tmp.clear();
+                truth_pair(&b[i as usize], &b[j as usize], s.rho, t_end, &mut tmp, &mut st);
+                out.extend(tmp.iter().map(|&(t, d)| (i, j, t, d)));
+            }
+            (out, st)
+        });
+        let mut all = Vec::new();
+        let mut st = TruthStats::default();
+        for (mut o, s2) in parts {
+            all.append(&mut o);
+            st.add(&s2);
+        }
+        all.sort_by(|x, y| {
+            x.2.partial_cmp(&y.2)
+                .unwrap()
+                .then_with(|| x.0.cmp(&y.0))
+                .then_with(|| x.1.cmp(&y.1))
+        });
+        (all, st)
+    };
+    let (ev, st) = collect(256);
+    let (ev2, _) = collect(1024); // determinism control: different parallel decomposition
+    (ev.clone(), fnv(&ev2), st, pairs.len())
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    // name n sigma_e rho a_lo a_hi orbits seed [intruder]
+    let s = Spec {
+        name: a[1].clone(),
+        n: a[2].parse().unwrap(),
+        sigma_e: a[3].parse().unwrap(),
+        rho: a[4].parse().unwrap(),
+        a_lo: a[5].parse().unwrap(),
+        a_hi: a[6].parse().unwrap(),
+        keys: 0,
+        seed: a[8].parse().unwrap(),
+        orbits: a[7].parse().unwrap(),
+    };
+    let intruder = a.len() > 9 && a[9] == "intruder";
+    let t0 = std::time::Instant::now();
+    let (ev, hash, st, npairs) = run(&s, intruder);
+    let dt = t0.elapsed().as_secs_f64();
+    // Distinctness control: per pair, strictly increasing times.
+    let mut dup = 0u64;
+    for w in ev.windows(2) {
+        if w[0].0 == w[1].0 && w[0].1 == w[1].1 && !(w[1].2 > w[0].2) {
+            dup += 1;
+        }
+    }
+    let out_path = a.get(10).cloned().unwrap_or_else(|| format!("{}.csv", s.name));
+    let mut f = std::fs::File::create(&out_path).unwrap();
+    for &(i, j, t, d) in &ev {
+        writeln!(f, "{},{},{},{}", i, j, t, d).unwrap();
+    }
+    println!(
+        "{{\"name\":\"{}\",\"n\":{},\"orbits\":{},\"rho\":{},\"npairs\":{},\"events\":{},\"steps\":{},\"evals\":{},\"fine\":{},\"dup_times\":{},\"hash2\":\"{:016x}\",\"seconds\":{:.2}}}",
+        s.name, s.n, s.orbits, s.rho, npairs, ev.len(), st.steps, st.evals, st.fine, dup, hash, dt
+    );
+}
