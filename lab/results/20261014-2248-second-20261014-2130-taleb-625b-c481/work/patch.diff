new file mode 100644
index 00000000..70c2c9de
--- /dev/null
+++ b/crates/universe/examples/band_site.rs
@@ -0,0 +1,253 @@
+//! The run's instrument: the per-site counters on the scan path (`scanmem`) flown on the record's arms. The
+//! checker's named experiment — "instrument capture/the held-answer store with a per-site counter and fly the kill
+//! arm once; the transit arm" — answered here: which site accounts for the in-band retention (the candidates
+//! vectors' standing bytes vs RSS), whether the drain ever answers under burn (created vs answered), what the scan
+//! holds at each radius (the probe sweep: the transit's integrand), and the live switch as a player crosses the
+//! belt's inner edge (the transit arm).
+//!
+//! Frames of 1/60 s at rtf, a wall budget, `input(word(keys, level))` at frame 60 — the record's loop. RSS is read
+//! every frame from /proc/self/statm; past `ES_RSS_LIMIT_MB` (default 1800) the flight stops itself and says so
+//! (the box kills at 2 GB; the record's kill is exit 137 — the same death, caught one step early so the counters
+//! survive).
+//!
+//! cargo run --release -p emergent-universe --features prof --example band_site -- \
+//!   ctrl   <home|band> <seed> <N> <s> <keys> <level> [budget ms=12] [rtf=100]
+//!   probe  <r_au> <seed> <N> <s> <keys> <level> [budget ms=12] [rtf=100]
+//!   cross  <a_au> <seed> <N> <s> <keys> <level> <e> <r0_au> [budget ms=12] [rtf=100]
+use emergent_universe::bind::Binding;
+use emergent_universe::scenario::{plane_extra, plane_extra_band, plane_extra_ecc, Plane, AU};
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{scanmem, Budget, Config};
+use std::time::{Duration, Instant};
+
+fn rss_mb() -> f64 {
+    std::fs::read_to_string("/proc/self/statm")
+        .ok()
+        .and_then(|s| s.split_whitespace().nth(1).and_then(|r| r.parse::<u64>().ok()))
+        .map_or(0.0, |p| p as f64 * 4096.0 / 1e6)
+}
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+/// The mean-anomaly fraction (the phase, as a fraction of the period) that puts a body of semi-major axis `a` and
+/// eccentricity `e` at radius `r0` at tick 0, outbound: solve `E` from `r`, then `M = E − e·sinE`.
+fn phase_for(a: f64, e: f64, r0: f64) -> (f64, f64) {
+    let mut ee = ((1.0 - r0 / a) / e).acos(); // outbound: E in (0, pi)
+    for _ in 0..80 {
+        ee -= (a * (1.0 - e * ee.cos()) - r0) / (a * e * ee.sin());
+    }
+    let m = ee - e * ee.sin();
+    (m / std::f64::consts::TAU, m)
+}
+
+/// The predicted radius at game time `t_s` (ballistic; the burn drifts it — the measured candidates are the truth).
+fn r_at(a: f64, e: f64, m0: f64, t_s: f64) -> f64 {
+    let n = 1.0 / a.powi(3).sqrt(); // rad per year
+    let mut m = (m0 + n * (t_s / 3.156e7)) % std::f64::consts::TAU;
+    if m > std::f64::consts::PI {
+        m -= std::f64::consts::TAU;
+    }
+    let mut ee = m + e * m.sin();
+    for _ in 0..80 {
+        ee -= (ee - e * ee.sin() - m) / (1.0 - e * ee.cos());
+    }
+    a * (1.0 - e * ee.cos())
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let mode = args.get(1).cloned().unwrap_or_else(|| "ctrl".into());
+    let place = args.get(2).cloned().unwrap_or_else(|| "home".into());
+    let seed: u64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let n: usize = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100_000);
+    let seconds: f64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(160.0);
+    let keys: u8 = args.get(6).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let level: u8 = args.get(7).and_then(|s| s.parse().ok()).unwrap_or(8);
+    let mut ix = 8;
+    let mut a_au = 0.0;
+    let mut e_orb = 0.0;
+    let mut r0_au = 0.0;
+    let p: Plane = match mode.as_str() {
+        "ctrl" => {
+            ix = 8;
+            if place == "band" {
+                plane_extra_band(Config::default(), seed, emergent_universe::fleet::Order::Sparse, 1, 48, n, (5 * AU as u64) << 7).unwrap()
+            } else {
+                plane_extra(Config::default(), seed, emergent_universe::fleet::Order::Sparse, 1, 48, n).unwrap()
+            }
+        }
+        "probe" => {
+            let r: f64 = place.parse().unwrap_or(2.5);
+            ix = 8;
+            a_au = r;
+            r0_au = r;
+            plane_extra_ecc(Config::default(), seed, emergent_universe::fleet::Order::Sparse, 1, 48, n, r, 0.0, 0.0).unwrap()
+        }
+        "cross" => {
+            a_au = place.parse().unwrap_or(2.0);
+            e_orb = args.get(8).and_then(|s| s.parse().ok()).unwrap_or(0.95);
+            r0_au = args.get(9).and_then(|s| s.parse().ok()).unwrap_or(1.9992);
+            ix = 10;
+            let (phase, _) = phase_for(a_au, e_orb, r0_au);
+            plane_extra_ecc(Config::default(), seed, emergent_universe::fleet::Order::Sparse, 1, 48, n, a_au * (1.0 - e_orb), e_orb, phase).unwrap()
+        }
+        _ => panic!("modes: ctrl <home|band>, probe <r_au>, cross <a> <e> <r0>"),
+    };
+    let budget_ms: f64 = args.get(ix).and_then(|s| s.parse().ok()).unwrap_or(12.0);
+    let rtf: f64 = args.get(ix + 1).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let limit_mb: f64 = std::env::var("ES_RSS_LIMIT_MB").ok().and_then(|s| s.parse().ok()).unwrap_or(1800.0);
+    let frames = (seconds * 60.0) as usize;
+    let mut p = p;
+    println!(
+        "mode {} seed {} N {} ({} bodies), {} s at rtf {}, keys {} level {} from 1 s, budget {} ms, rss limit {:.0} MB, player doll {}, item {} b/binding {}",
+        mode,
+        seed,
+        n,
+        p.u.n_bodies(),
+        seconds,
+        rtf,
+        keys,
+        level,
+        budget_ms,
+        limit_mb,
+        p.u.rec(p.player).b.doll,
+        std::mem::size_of::<(usize, Binding, emergent_space::orbit::Scalar)>(),
+        std::mem::size_of::<Binding>()
+    );
+    let m0 = if mode == "cross" { phase_for(a_au, e_orb, r0_au).1 } else { 0.0 };
+    if mode == "cross" {
+        println!(
+            "cross: a {} AU e {} r0 {} AU (predicted r at 5k/10k/15k game-s: {:.4} {:.4} {:.4})",
+            a_au,
+            e_orb,
+            r0_au,
+            r_at(a_au, e_orb, m0, 5e3),
+            r_at(a_au, e_orb, m0, 1e4),
+            r_at(a_au, e_orb, m0, 1.5e4)
+        );
+    }
+    let mut rows: Vec<(usize, f64, u64, f64)> = Vec::new(); // frame, ms, events, rss
+    let mut doll = p.u.rec(p.player).b.doll;
+    let mut transitions: Vec<(usize, u16)> = vec![(0, doll)];
+    let mut total = Duration::ZERO;
+    let mut limited = None;
+    for f in 0..frames {
+        if f == 60 && keys != 0 {
+            let _ = p.u.input(p.u.now, word(keys, level));
+        }
+        let s0 = p.u.stats;
+        let start = Instant::now();
+        let frame = p.u.frame_to(1.0 / 60.0, rtf, Budget::wall(budget_ms), i64::MAX);
+        let took = start.elapsed();
+        total += took;
+        let s1 = p.u.stats;
+        let rss = rss_mb();
+        rows.push((f, took.as_secs_f64() * 1e3, frame.events, rss));
+        if rss > limit_mb {
+            limited = Some(f);
+            break;
+        }
+        let d = p.u.rec(p.player).b.doll;
+        if d != doll {
+            doll = d;
+            transitions.push((f, d));
+        }
+        if !p.u.rec(p.player).alive {
+            println!("the player was lost at frame {f}");
+            break;
+        }
+        if (f + 1) % 50 == 0 {
+            let r_now = match p.u.rec(p.player).b.cartesian(p.u.now) {
+                Ok((x, _)) => {
+                    let (x0, x1) = (emergent_universe::num::to_f64(x[0]), emergent_universe::num::to_f64(x[1]));
+                    ((x0 * x0 + x1 * x1).sqrt() / AU as f64)
+                }
+                Err(_) => 0.0,
+            };
+            let c = scanmem::snapshot();
+            println!(
+                "w{:>5} t={:>7.0}s r={:.4} rss={:>7.1}MB held={:>5} standing={:>8.1}MB created={:>4} answered={:>4} reused={:>3} cand/scan={:>6.0} cap_ms={:>7.2} ans_ms={:>7.2} player_us={:>8}",
+                f + 1,
+                p.u.now as f64 * TICK_SECONDS,
+                if mode == "cross" || mode == "probe" { r_now } else { 0.0 },
+                rss,
+                p.u.held_scans(),
+                c[4] as f64 / 1e6,
+                c[0],
+                c[2],
+                c[1],
+                if c[0] > 0 { c[3] as f64 / c[0] as f64 } else { 0.0 },
+                if c[7] > 0 { c[6] as f64 / c[7] as f64 / 1e6 } else { 0.0 },
+                if c[9] > 0 { c[8] as f64 / c[9] as f64 / 1e6 } else { 0.0 },
+                (s1.cost_ns[3] - s0.cost_ns[3]) / 1000
+            );
+        }
+    }
+    let late: Vec<_> = rows.iter().filter(|r| r.0 >= 60).collect();
+    let mut ms: Vec<f64> = late.iter().map(|r| r.1).collect();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let mut ev: Vec<f64> = late.iter().map(|r| r.2 as f64).collect();
+    ev.sort_by(|a, b| a.partial_cmp(&b).unwrap());
+    println!(
+        "frames after 1 s: {}  ms p50 {:.3} p99 {:.3} max {:.3} mean {:.3}   events p50 {} p99 {} max {}   over budget {}   kicks so far {}",
+        late.len(),
+        if late.is_empty() { 0.0 } else { pct(&ms, 0.5) },
+        if late.is_empty() { 0.0 } else { pct(&ms, 0.99) },
+        if late.is_empty() { 0.0 } else { pct(&ms, 1.0) },
+        if late.is_empty() { 0.0 } else { ms.iter().sum::<f64>() / late.len() as f64 },
+        if late.is_empty() { 0 } else { pct(&ev, 0.5) as u64 },
+        if late.is_empty() { 0 } else { pct(&ev, 0.99) as u64 },
+        if late.is_empty() { 0 } else { pct(&ev, 1.0) as u64 },
+        late.iter().filter(|r| r.1 > budget_ms).count(),
+        p.u.stats.kicks
+    );
+    println!("player doll transitions (frame, doll): {:?}", transitions);
+    let c = scanmem::snapshot();
+    println!(
+        "scanmem final: created {} reused {} answered {} cand_n {} standing {:.1} MB cap {:.1} ms/call ans {:.1} ms/call",
+        c[0],
+        c[1],
+        c[2],
+        c[3],
+        c[4] as f64 / 1e6,
+        if c[7] > 0 { c[6] as f64 / c[7] as f64 / 1e6 } else { 0.0 },
+        if c[9] > 0 { c[8] as f64 / c[9] as f64 / 1e6 } else { 0.0 }
+    );
+    println!("radial window: walk_all {} windowed {}", scanmem::walk_all(), scanmem::windowed());
+    if let Some(f) = limited {
+        println!(
+            "SELF-LIMITED at frame {} (rss {:.0} MB > {:.0}): the flight does not complete — the record's kill (exit 137), caught one step early so the counters survive. No digest (nothing canonical to compare).",
+            f,
+            rss_mb(),
+            limit_mb
+        );
+        println!("total engine wall {:.3} s", total.as_secs_f64());
+        return;
+    }
+    let cut = (seconds * rtf / TICK_SECONDS) as i64;
+    let reached = p.u.now;
+    let t0 = Instant::now();
+    p.u.settle(cut);
+    println!(
+        "cut {} (reached {} before settle, settle {:.1} s): digest {}, kicks {}, encounters {}, contacts {}",
+        cut,
+        reached,
+        t0.elapsed().as_secs_f64(),
+        &p.u.digest()[..32],
+        p.u.stats.kicks,
+        p.u.stats.encounters,
+        p.u.contacts
+    );
+    let c = scanmem::snapshot();
+    println!(
+        "scanmem after settle: created {} reused {} answered {} standing {:.1} MB (drained: everything answered, the heap returns)",
+        c[0],
+        c[1],
+        c[2],
+        c[4] as f64 / 1e6
+    );
+    println!("total engine wall {:.3} s", total.as_secs_f64());
+}
