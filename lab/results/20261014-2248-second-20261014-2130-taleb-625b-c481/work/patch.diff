diff --git a/crates/universe/src/scanmem.rs b/crates/universe/src/scanmem.rs
new file mode 100644
index 00000000..fc23a583
--- /dev/null
+++ b/crates/universe/src/scanmem.rs
@@ -0,0 +1,90 @@
+//! Per-site counters on the scan path (the lab's instrument for the in-band retention, run 20261014-2248): which
+//! site accounts for the memory a held scan holds. Counters only — no outcome depends on them (relaxed atomics,
+//! single-threaded universe), so every digest is unchanged. Read with [`snapshot`].
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// Scans minted (a fresh `Scan` allocated: its inputs differ from the last one's).
+pub fn scans_created() -> u64 {
+    CREATED.load(Ordering::Relaxed)
+}
+/// Scans answered by the last-scan cache instead (no new memory).
+pub fn scans_reused() -> u64 {
+    REUSED.load(Ordering::Relaxed)
+}
+/// Held scans answered (`Held::answer` computed or re-read).
+pub fn scans_answered() -> u64 {
+    ANSWERED.load(Ordering::Relaxed)
+}
+/// Sum of `candidates.len()` over minted scans.
+pub fn candidates_n() -> u64 {
+    CAND_N.load(Ordering::Relaxed)
+}
+/// Heap bytes the minted scans' `candidates` vectors allocated, less what dropped scans returned.
+pub fn standing_bytes() -> u64 {
+    CREATED_B.load(Ordering::Relaxed).saturating_sub(DROPPED_B.load(Ordering::Relaxed))
+}
+/// Total `candidates` heap bytes minted (never decremented).
+pub fn created_bytes() -> u64 {
+    CREATED_B.load(Ordering::Relaxed)
+}
+/// Capture (`Encounters::capture`) total ns and calls.
+pub fn capture_ns() -> (u64, u64) {
+    (CAP_NS.load(Ordering::Relaxed), CAP_CALLS.load(Ordering::Relaxed))
+}
+/// Answer (`Held::answer`) total ns and calls.
+pub fn answer_ns() -> (u64, u64) {
+    (ANS_NS.load(Ordering::Relaxed), ANS_CALLS.load(Ordering::Relaxed))
+}
+/// Everything at a glance.
+pub fn snapshot() -> [u64; 10] {
+    [scans_created(), scans_reused(), scans_answered(), candidates_n(), standing_bytes(), created_bytes(), capture_ns().0, capture_ns().1, answer_ns().0, answer_ns().1]
+}
+pub const NAMES: [&str; 10] = ["created", "reused", "answered", "cand_n", "standing_b", "created_b", "cap_ns", "cap_calls", "ans_ns", "ans_calls"];
+
+static CREATED: AtomicU64 = AtomicU64::new(0);
+static REUSED: AtomicU64 = AtomicU64::new(0);
+static ANSWERED: AtomicU64 = AtomicU64::new(0);
+static CAND_N: AtomicU64 = AtomicU64::new(0);
+static CREATED_B: AtomicU64 = AtomicU64::new(0);
+static DROPPED_B: AtomicU64 = AtomicU64::new(0);
+static CAP_NS: AtomicU64 = AtomicU64::new(0);
+static CAP_CALLS: AtomicU64 = AtomicU64::new(0);
+static ANS_NS: AtomicU64 = AtomicU64::new(0);
+static ANS_CALLS: AtomicU64 = AtomicU64::new(0);
+static WALK_ALL: AtomicU64 = AtomicU64::new(0);
+static WINDOWED: AtomicU64 = AtomicU64::new(0);
+
+
+pub(crate) fn note_reuse() {
+    REUSED.fetch_add(1, Ordering::Relaxed);
+}
+pub(crate) fn note_answer(ns: u64) {
+    ANSWERED.fetch_add(1, Ordering::Relaxed);
+    ANS_NS.fetch_add(ns, Ordering::Relaxed);
+    ANS_CALLS.fetch_add(1, Ordering::Relaxed);
+}
+pub(crate) fn note_created(bytes: u64, n: u64, ns: u64) {
+    CREATED.fetch_add(1, Ordering::Relaxed);
+    CREATED_B.fetch_add(bytes, Ordering::Relaxed);
+    CAND_N.fetch_add(n, Ordering::Relaxed);
+    CAP_NS.fetch_add(ns, Ordering::Relaxed);
+    CAP_CALLS.fetch_add(1, Ordering::Relaxed);
+}
+pub(crate) fn note_dropped(bytes: u64) {
+    DROPPED_B.fetch_add(bytes, Ordering::Relaxed);
+}
+/// Captures whose radial window was dropped (`candidates` returned None: the caller read every body of the doll).
+pub fn walk_all() -> u64 {
+    WALK_ALL.load(Ordering::Relaxed)
+}
+/// Captures served from the radial window's list.
+pub fn windowed() -> u64 {
+    WINDOWED.load(Ordering::Relaxed)
+}
+pub(crate) fn note_window(all: bool) {
+    if all {
+        WALK_ALL.fetch_add(1, Ordering::Relaxed);
+    } else {
+        WINDOWED.fetch_add(1, Ordering::Relaxed);
+    }
+}
