+//! Run 20261021-1551 (second author on 20261021-1443-system-9b03): the news-fed scan window, flown.
+//!
+//! The original run measured the walk's information (1.2–11.4% of the walked bindings change); this run wires
+//! the window (`SCAN_NEWSFED=1`, `encounter.rs`: a kept candidate is proved identical to a full rebuild's
+//! through `(event_time, alive, binding_until)`, so the digest is the shipped one) and flies it against the
+//! shipped rebuild on the same flight, with the belt-desync dial (`BELT_DESYNC=D`, `step.rs`: every ship's
+//! clock cadence × D — ddeb's classes in their cheapest decisive form).
+//!
+//! No wall budget inside a frame (`until: None`): the flight is deterministic, so the digest is comparable
+//! between the two scan implementations run for run.
+//!
+//! cargo run --release -p emergent-universe --example scannews2 [-- <N> <coast|burn> [<wall s> [<rtf>]]]
+use emergent_universe::encounter::{s2_enabled, s2_summary};
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(30_000);
+    let burn = args.get(2).map_or(false, |s| s == "burn");
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(6.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let frames = (seconds * 60.0) as usize;
+    let desync = std::env::var("BELT_DESYNC").unwrap_or_else(|_| "1".into());
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let kicks0 = p.u.stats.kicks;
+    let t0 = Instant::now();
+    for f in 0..frames {
+        if f == 60 && burn {
+            let t = p.u.now;
+            let _ = p.u.input(t, word(1, 8));
+        }
+        let _ = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: None }, i64::MAX);
+    }
+    let wall = t0.elapsed().as_secs_f64();
+    p.u.flush_scans();
+    let held = p.u.held_scans();
+    let digest = p.u.digest();
+    let game_s = p.u.now as f64 * emergent_universe::view::TICK_SECONDS;
+    let mode = if s2_enabled() { "newsfed" } else { "shipped" };
+    println!(
+        "scannews2 N={n} burn={burn} scan={mode} desync={desync} frames={frames} wall={wall:.1}s build={build:.1}s game_s={game_s:.0} kicks={} encounters={} contacts={} held_left={held} digest={digest:?}",
+        p.u.stats.kicks - kicks0,
+        p.u.stats.encounters,
+        p.u.contacts,
+    );
+    s2_summary();
+}
