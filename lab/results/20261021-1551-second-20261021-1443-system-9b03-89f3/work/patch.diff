+        eprintln!(
+            "SCAN2 scans={s} near/scan={:.1} cands/scan={:.1} reread/scan={:.2} kept/scan={:.1} walk_work={:.4} memo={memo} fallback={fb} capture={:.1}us radial={:.1}us",
+            near as f64 / s as f64,
+            c as f64 / s as f64,
+            r as f64 / s as f64,
+            k as f64 / s as f64,
+            r as f64 / near.max(1) as f64,
+            ns as f64 / s as f64 / 1e3,
+            nsr as f64 / s as f64 / 1e3,
+        );
+    }
+}
