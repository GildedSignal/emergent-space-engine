static orthonormal Riemann (sign convention check):
  R_trtr = -2*M/r**3
  R_tthtth = M/r**3
  R_tphtph = M/r**3
  R_rthrth = -M/r**3
  R_rphrph = -M/r**3
  R_thphthph = 2*M/r**3
conventions OK: R_trtr=-2M/r^3 etc.

--- orthonormality checks ---
u.u       = (-2*E**2*M*r + 2*E**2*r**2 - 4*M**2*epsilon + 4*M*epsilon*r - epsilon*r**2)/(4*M**2 - 4*M*r + r**2)   (want -eps)
l1.l1     = 1
l2p.l2p   = 1
l3p.l3p   = r*(-2*E**2*M + 2*E**2*r + 2*M*epsilon - epsilon*r)/(4*M**2 - 4*M*r + r**2)
u.l1..l3p = 0 0 2*E*sqrt(r)*(-E**2*M*r + E**2*r**2 - 2*M**2*epsilon + 3*M*epsilon*r - epsilon*r**2)/((4*M**2 - 4*M*r + r**2)*sqrt(E**2*r + 2*M*epsilon - epsilon*r))
l2p.l3p   = 0   (want 0)

--- boosted-frame tidal tensor C^B_{ab} = R_{a 0 b 0} ---
B11 = M*(3*L**2 + epsilon*r**2)/r**5
B22 = M*(-3*E**2*L**2 + E**2*epsilon*r**2 + 2*M*epsilon**2*r - epsilon**2*r**2)/(r**4*(E**2*r + 2*M*epsilon - epsilon*r))
B33 = -M*epsilon**2*(2*E**2*r**3 + 6*L**2*M - 3*L**2*r + 4*M*epsilon*r**2 - 2*epsilon*r**3)/(r**5*(E**2*r + 2*M*epsilon - epsilon*r))
B23 = -3*E*L*M*epsilon*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3)/(r**(9/2)*(E**2*r + 2*M*epsilon - epsilon*r))
B12 = 0
B13 = 0
trace: M*epsilon*(-2*E**2*epsilon*r**3 + 2*E**2*r**3 - 6*L**2*M*epsilon + 6*L**2*M + 3*L**2*epsilon*r - 3*L**2*r - 4*M*epsilon**2*r**2 + 4*M*epsilon*r**2 + 2*epsilon**2*r**3 - 2*epsilon*r**3)/(r**5*(E**2*r + 2*M*epsilon - epsilon*r))  (want 0)

--- rotation rate omega23 = g(grad_u l2p, l3p) ---
omega23 = E*L*(-4*E**4*M**2*r**(13/2) + 2*E**4*M**2*r**5*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) + 2*E**4*M*r**(15/2) + 4*E**2*L**2*M**3*r**(7/2) - 4*E**2*L**2*M**3*r**2*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) - 8*E**2*L**2*M**2*r**(9/2) + 8*E**2*L**2*M**2*r**3*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) + 5*E**2*L**2*M*r**(11/2) - 5*E**2*L**2*M*r**4*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) - E**2*L**2*r**(13/2) + E**2*L**2*r**5*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) - 12*E**2*M**3*epsilon*r**(11/2) + 8*E**2*M**3*epsilon*r**4*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) + 12*E**2*M**2*epsilon*r**(13/2) - 4*E**2*M**2*epsilon*r**5*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) - 3*E**2*M*epsilon*r**(15/2) + 8*L**2*M**4*epsilon*r**(5/2) - 8*L**2*M**4*epsilon*r*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) - 20*L**2*M**3*epsilon*r**(7/2) + 20*L**2*M**3*epsilon*r**2*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) + 18*L**2*M**2*epsilon*r**(9/2) - 18*L**2*M**2*epsilon*r**3*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) - 7*L**2*M*epsilon*r**(11/2) + 7*L**2*M*epsilon*r**4*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) + L**2*epsilon*r**(13/2) - L**2*epsilon*r**5*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) - 8*M**4*epsilon**2*r**(9/2) + 8*M**4*epsilon**2*r**3*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) + 12*M**3*epsilon**2*r**(11/2) - 8*M**3*epsilon**2*r**4*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) - 6*M**2*epsilon**2*r**(13/2) + 2*M**2*epsilon**2*r**5*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3) + M*epsilon**2*r**(15/2))/(r**5*(-2*M + r)**2*(E**2*r + 2*M*epsilon - epsilon*r)**2*sqrt(E**2*r**3 + 2*L**2*M - L**2*r + 2*M*epsilon*r**2 - epsilon*r**3))
g(grad_u l2p, l2p) = (-L**2*r*(r**(3/2)*(M*epsilon*(2*M - r) - (4*M - r)*(E**2*r + epsilon*(2*M - r))) + (3*M - r)*(E**2*r + epsilon*(2*M - r))*sqrt(E**2*r**3 + (L**2 + epsilon*r**2)*(2*M - r))) + r**(5/2)*(M*epsilon*(E**2*r**3 + (L**2 + epsilon*r**2)*(2*M - r)) - (E**2*r + epsilon*(2*M - r))*(E**2*r**3 + (L**2 + epsilon*r**2)*(2*M - r)) - (E**2*r + epsilon*(2*M - r))*(L**2*(2*M - r) + M*(L**2 + epsilon*r**2))) + r*(E**2*r + epsilon*(2*M - r))*sqrt(E**2*r**3 + (L**2 + epsilon*r**2)*(2*M - r))*(E**2*r**3 + L**2*(2*M - r) + (L**2 + epsilon*r**2)*(2*M - r)))/(r**(11/2)*(E**2*r + epsilon*(2*M - r))**2)  (want 0)
g(grad_u l2p, l1)  = L*sqrt(E**2*r**3 + (L**2 + epsilon*r**2)*(2*M - r))*sin(2*theta)/(2*r**3*sqrt(E**2*r + epsilon*(2*M - r)))  (want 0)
