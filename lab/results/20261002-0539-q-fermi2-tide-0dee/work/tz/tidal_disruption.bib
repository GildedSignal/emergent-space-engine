@Article{Meent2019,
  author        = {van de Meent, Maarten},
  journal       = {Classical and Quantum Gravity},
  title         = {Analytic solutions for parallel transport along generic bound geodesics in kerr spacetime},
  year          = {2019},
  issn          = {1361-6382},
  month         = jun,
  number        = {14},
  pages         = {145007},
  volume        = {37},
  abstract      = {We provide analytical closed form solutions for the parallel transport along a bound geodesic in Kerr spacetime. This can be considered the lowest order approximation for the motion a spinning black hole in an extreme mass-ratio inspiral. As an illustration of the usefulness of our new found expressions we scope out the locations of spin-spin resonances in quasi-circular EMRIs. All solutions are given as functions of Mino time, which facilitates the decoupling of the equations of motion. To help physical interpretation, we also provide an analytical expression for the proper time along a geodesic as a function of Mino time.},
  archiveprefix = {arXiv},
  copyright     = {arXiv.org perpetual, non-exclusive license},
  doi           = {10/g5p9zx},
  file          = {:Meent2019 - Analytic Solutions for Parallel Transport along Generic Bound Geodesics in Kerr Spacetime.pdf:PDF},
  groups        = {Orbital dynamics},
  keywords      = {General Relativity and Quantum Cosmology (gr-qc), FOS: Physical sciences},
  primaryclass  = {gr-qc},
  priority      = {prio3},
  publisher     = {IOP Publishing},
}

