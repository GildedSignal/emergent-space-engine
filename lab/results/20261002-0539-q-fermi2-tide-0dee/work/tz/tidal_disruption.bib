@Article{Mummery2019,
  author        = {Mummery, Andrew and Balbus, Steven A.},
  journal       = {Monthly Notices of the Royal Astronomical Society},
  title         = {The spectral evolution of disc dominated tidal disruption events},
  year          = {2019},
  issn          = {1365-2966},
  month         = jan,
  number        = {4},
  pages         = {5655--5674},
  volume        = {492},
  abstract      = {We perform a detailed numerical and analytical study of the properties of observed light curves from relativistic thin discs, focussing on observational bands most appropriate for comparison with tidal disruption events (TDEs). We make use of asymptotic expansion techniques applied to the spectral emission integral, using time dependent disc temperature profiles appropriate for solutions of the relativistic thin disc equation. Rather than a power law associated with bolometric disc emission \$L \sim t^{-n}\$, the observed X-ray flux from disc-dominated TDEs will typically have the form of a power law multiplied by an exponential (see eq. 91). While precise details are somewhat dependent on the nature of the ISCO stress and disc-observer orientational angle, the general form of the time-dependent flux is robust and insensitive to the exact disc temperature profile. We present numerical fits to the UV and X-ray light curves of ASASSN-14li, a particularly well observed TDE. This modelling incorporates strong gravity optics. The full 900 days of ASASSN-14li X-ray observations are very well fit by a simple relativistic disc model, significantly improving upon previous work. The same underlying model also fits the final 1000 days of ASASSN-14li observations in three different UV bandpasses. Finally, we demonstrate that the analytic formulae reproduce the properties of full numerical modelling at both UV and X-ray wavelengths with great fidelity.},
  archiveprefix = {arXiv},
  copyright     = {arXiv.org perpetual, non-exclusive license},
  doi           = {10/g576ds},
  file          = {:Mummery2019 - The Spectral Evolution of Disc Dominated Tidal Disruption Events.pdf:PDF},
  groups        = {Spectrum},
  keywords      = {High Energy Astrophysical Phenomena (astro-ph.HE), FOS: Physical sciences},
  primaryclass  = {astro-ph.HE},
  publisher     = {Oxford University Press (OUP)},
}

@Article{Mummery2019a,
  author        = {Mummery, Andrew and Balbus, Steven A.},
  journal       = {Monthly Notices of the Royal Astronomical Society},
  title         = {Evolution of relativistic thin discs with a finite isco stress: i. Stalled accretion},
  year          = {2019},
  issn          = {1365-2966},
  month         = aug,
  number        = {1},
  pages         = {132--142},
  volume        = {489},
  abstract      = {We present solutions to the relativistic thin disc evolutionary equation using an \${\alpha}\$-model for the turbulent stress tensor. Solutions with a finite stress at the innermost stable circular orbit (ISCO) give rise to bolometric light curves with a shallow power law time dependence, in good agreement with those observed in tidal disruption events. A self-similar model based on electron scattering opacity, for example, yields a power law index of \$-11/14\$, as opposed to \$-19/16\$ for the case of zero ISCO stress. These solutions correspond to an extended period of relaxation of the evolving disc which, like the light curves they produce, is not sustainable indefinitely. Cumulative departures from the approximation of exact circular orbits cause the power law index to evolve slowly with time, leading eventually to the steeper fall-off associated with traditional zero ISCO stress models. These modified solutions are discussed in detail in a companion paper.},
  archiveprefix = {arXiv},
  copyright     = {arXiv.org perpetual, non-exclusive license},
  doi           = {10/g576dt},
  file          = {:Mummery2019a - Evolution of Relativistic Thin Discs with a Finite Isco Stress_ I. Stalled Accretion.pdf:PDF},
  groups        = {Spectrum},
  keywords      = {High Energy Astrophysical Phenomena (astro-ph.HE), FOS: Physical sciences},
  primaryclass  = {astro-ph.HE},
  publisher     = {Oxford University Press (OUP)},
}

@Article{Mummery2019b,
  author        = {Mummery, Andrew and Balbus, Steven A.},
  journal       = {Monthly Notices of the Royal Astronomical Society},
  title         = {Evolution of relativistic thin discs with a finite isco stress: ii. Late time behaviour},
  year          = {2019},
  issn          = {1365-2966},
  month         = aug,
  number        = {1},
  pages         = {143--152},
  volume        = {489},
  abstract      = {We present solutions to the relativistic thin disc evolutionary equation using a modified description of the mean fluid flow within the disc. The model takes into account the effects of sub-circular velocities in the innermost disc regions, and resolves otherwise unsustainable behaviour present in simple finite ISCO stress disc models. We show that the behaviour of a relativistic thin disc evolving with a finite ISCO stress is comprised of three distinct stages which join the ordinarily distinct finite and vanishing ISCO stress solutions into a fully continuous model parameterisation. The most important prediction of our model is the existence of an intermediate stage of "stalled accretion", controlled by a single dimensionless parameter. The hallmarks of this evolutionary phase appear to have been seen in GRMHD simulations as well as in the late time X-ray observations of tidal disruption events, but dedicated simulations and extended observations are needed for a deeper understanding.},
  archiveprefix = {arXiv},
  copyright     = {arXiv.org perpetual, non-exclusive license},
  doi           = {10/g5t2h4},
  file          = {:Mummery2019b - Evolution of Relativistic Thin Discs with a Finite Isco Stress_ Ii. Late Time Behaviour.pdf:PDF},
  groups        = {Spectrum},
  keywords      = {High Energy Astrophysical Phenomena (astro-ph.HE), FOS: Physical sciences},
  primaryclass  = {astro-ph.HE},
  publisher     = {Oxford University Press (OUP)},
}

