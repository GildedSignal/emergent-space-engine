@Article{Liu2022,
  author        = {Liu, Jiayi and Chen, Songbai and Jing, Jiliang},
  journal       = {Chinese Physics C},
  title         = {Tidal effects of dark matter halo around a galactic black hole},
  year          = {2022},
  issn          = {2058-6132},
  month         = oct,
  number        = {10},
  pages         = {105104},
  volume        = {46},
  abstract      = {We have investigated the tidal forces and geodesic deviation motion in the spacetime of a black hole in the galaxy with dark matter halo. Our results show that the tidal force and geodesic deviation motion depend on the dark matter halo mass and the typical lengthscale of galaxy. The effect of the typical lengthscale of galaxy on tidal force is opposite to that of dark matter mass. For the radial tidal force, with the increasing mass of dark matter, it increases in the region far from the black hole, but decreases in the region near black hole. For the angular tidal force, its absolute value of angular tidal force monotonously increases with the dark matter halo mass. Especially, the angular tidal force also depends on the particle's energy and the effects of dark matter become more distinct for the test particle with high energy, which is different from those in the usual static black hole spacetimes. We also present the change of geodesic deviation vector with the dark matter halo mass and the typical lengthscale of galaxy under two kinds of initial conditions.},
  archiveprefix = {arXiv},
  copyright     = {arXiv.org perpetual, non-exclusive license},
  doi           = {10/g5p9zs},
  file          = {:Liu2022 - Tidal Effects of Dark Matter Halo around a Galactic Black Hole.pdf:PDF},
  groups        = {Tidal force},
  keywords      = {General Relativity and Quantum Cosmology (gr-qc), FOS: Physical sciences},
  primaryclass  = {gr-qc},
  publisher     = {IOP Publishing},
}

