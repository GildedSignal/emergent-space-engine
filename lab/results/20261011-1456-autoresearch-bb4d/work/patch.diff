+/// Lab run 20261011-1456: cross-crate phase accounting for the kick resolver. Zero-cost when
+/// `enabled()` is false (it is toggled by the measurement harness only).
+pub mod lab {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    pub const N: usize = 12;
+    static ON: AtomicBool = AtomicBool::new(false);
+    static NS: [AtomicU64; N] = [
+        AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+        AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+    ];
+    pub fn enable(on: bool) {
+        ON.store(on, Ordering::Relaxed);
+    }
+    pub fn enabled() -> bool {
+        ON.load(Ordering::Relaxed)
+    }
+    #[inline]
+    pub fn add(i: usize, nanos: u64) {
+        if enabled() {
+            NS[i].fetch_add(nanos, Ordering::Relaxed);
+        }
+    }
+    /// Time `f` into phase `i` when enabled; the result is passed through untouched.
+    #[inline]
+    pub fn phase<T>(i: usize, f: impl FnOnce() -> T) -> T {
+        if !enabled() {
+            return f();
+        }
+        let t = std::time::Instant::now();
+        let r = f();
+        add(i, t.elapsed().as_nanos() as u64);
+        r
+    }
+    pub fn read() -> [u64; N] {
+        std::array::from_fn(|i| NS[i].load(Ordering::Relaxed))
+    }
+}
 
