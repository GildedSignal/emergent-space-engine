diff --git a/crates/universe/src/census.rs b/crates/universe/src/census.rs
new file mode 100644
index 00000000..e95ab79b
--- /dev/null
+++ b/crates/universe/src/census.rs
@@ -0,0 +1,129 @@
+//! Print-only census of compiled trajectories: compiles (counted and timed in `crates/space`)
+//! against reads, per binding generation, attributed to the reader that caused them.
+//! Lab instrument (`lab/results/20261017-0739-spacex-4ea0`): counters only, no law path touched,
+//! digests unchanged. The question (kick-jet open direction 2): how many reads does one
+//! generation of a compiled table serve between its mint and its replacement, and by whom —
+//! the quantity that decides whether compile-on-read deletes the kick's compile term or
+//! merely moves it onto the view's per-frame path.
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::panic::Location;
+use std::sync::atomic::{AtomicU32, AtomicU64, Ordering};
+use std::sync::{LazyLock, Mutex};
+
+pub const ENGINE: u8 = 0;
+pub const VIEW: u8 = 1;
+pub const OBSERVE: u8 = 2;
+pub const SECONDARIES: u8 = 3;
+pub const STEP: u8 = 4;
+pub const DASH: u8 = 5;
+pub const CHAIN: u8 = 6;
+pub const BIRTH: u8 = 7;
+pub const OTHER: u8 = 8;
+pub const NCLASS: usize = 9;
+pub const NAMES: [&str; NCLASS] = [
+    "engine-default", "view", "observe", "secondaries", "step", "dash", "chain", "birth-read", "other",
+];
+
+pub const SPEC: usize = 0;
+pub const REBIND: usize = 1;
+
+static NEXT_ID: AtomicU32 = AtomicU32::new(1);
+pub static MINTS: [AtomicU64; 2] = [AtomicU64::new(0), AtomicU64::new(0)];
+pub static READS: [AtomicU64; NCLASS] = [const { AtomicU64::new(0) }; NCLASS];
+
+thread_local! {
+    static READER: Cell<u8> = const { Cell::new(ENGINE) };
+}
+
+pub fn classify(loc: &Location<'_>) -> u8 {
+    let f = loc.file();
+    if f.ends_with("view.rs") { VIEW }
+    else if f.ends_with("observe.rs") { OBSERVE }
+    else if f.ends_with("ctx.rs") { SECONDARIES }
+    else if f.ends_with("step.rs") { STEP }
+    else if f.ends_with("dash.rs") { DASH }
+    else if f.ends_with("bind.rs") { CHAIN }
+    else { OTHER }
+}
+
+pub fn mint_id(origin: usize) -> u32 {
+    MINTS[origin].fetch_add(1, Ordering::Relaxed);
+    let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+    if let Ok(mut p) = per_generation().lock() {
+        p.entry(id).or_insert((origin as u8, u8::MAX, 0));
+    }
+    id
+}
+
+pub fn set_reader(c: u8) {
+    READER.with(|r| r.set(c));
+}
+
+fn per_generation() -> &'static Mutex<HashMap<u32, (u8, u8, u64)>> {
+    static P: LazyLock<Mutex<HashMap<u32, (u8, u8, u64)>>> =
+        LazyLock::new(|| Mutex::new(HashMap::new()));
+    &P
+}
+
+/// One decode of one generation (a shape read through the binding): counted and attributed.
+pub fn note_read(id: u32) {
+    let c = READER.with(|r| r.get());
+    READS[c as usize].fetch_add(1, Ordering::Relaxed);
+    if let Ok(mut p) = per_generation().lock() {
+        let e = p.entry(id).or_insert((u8::MAX, c, 0));
+        if e.1 == u8::MAX { e.1 = c; }
+        e.2 += 1;
+    }
+}
+
+pub fn report() {
+    let (shape_reads, compiles, compile_ns) = emergent_space::orbit::census_counts();
+    let mints: Vec<u64> = MINTS.iter().map(|m| m.load(Ordering::Relaxed)).collect();
+    let reads: Vec<u64> = READS.iter().map(|m| m.load(Ordering::Relaxed)).collect();
+    let mut per: Vec<(u32, (u8, u8, u64))> = per_generation().lock().map(|p| p.iter().map(|(k, v)| (*k, *v)).collect()).unwrap_or_default();
+    let attributed: u64 = reads.iter().sum();
+    per.sort_by_key(|(_, v)| v.2);
+    let n_read_gens = per.len() as u64;
+    let total_gens: u64 = mints.iter().sum();
+    let reads_of_read: Vec<u64> = per.iter().map(|(_, v)| v.2).collect();
+    let at = |q: f64| -> u64 {
+        if reads_of_read.is_empty() { return 0; }
+        reads_of_read[(((reads_of_read.len() as f64) - 1.0) * q).round() as usize]
+    };
+    // Never-read generations, split by which class first read the ones that were read.
+    let mut first: [u64; NCLASS] = [0; NCLASS];
+    for (_, v) in &per { if v.1 != u8::MAX { first[v.1 as usize] += 1; } }
+    // reads split by generation origin (0=spec birth, 1=rebind) and never-read by origin
+    let mut reads_origin = [0u64; 2];
+    let mut gens_origin = [0u64; 2];
+    let mut never_origin = [0u64; 2];
+    for (_, v) in &per {
+        let o = (v.0 == 1) as usize;
+        gens_origin[o] += 1;
+        reads_origin[o] += v.2;
+        if v.2 == 0 { never_origin[o] += 1; }
+    }
+    println!(
+        "[shapecensus] shape_reads_total(space,includes engine-internal)={} attributed(decode)={} compiles{{orbit_bound={},passage={}}} compile_ms{{orbit_bound={:.3},passage={:.3}}}",
+        shape_reads, attributed, compiles[0], compiles[1], compile_ns[0] as f64 / 1e6, compile_ns[1] as f64 / 1e6
+    );
+    println!(
+        "[shapecensus] generations: spec={} rebind={} total={} read={} never_read={} reads_per_gen_all={:.2} reads_per_gen_read={:.2} p50={} p99={} max={}",
+        mints[SPEC], mints[REBIND], total_gens, n_read_gens, total_gens - n_read_gens,
+        attributed as f64 / total_gens.max(1) as f64,
+        attributed as f64 / n_read_gens.max(1) as f64,
+        at(0.5), at(0.99), reads_of_read.last().copied().unwrap_or(0)
+    );
+    let names = NAMES;
+    let reads_s: Vec<String> = reads.iter().enumerate().map(|(i, r)| format!("{}={}", names[i], r)).collect();
+    let first_s: Vec<String> = first.iter().enumerate().filter(|(i, v)| **v > 0).map(|(i, v)| format!("{}={}", names[i], v)).collect();
+    println!("[shapecensus] reads_by_class: {}", reads_s.join(" "));
+    println!("[shapecensus] first_reader_of_read_generations: {}", first_s.join(" "));
+    println!(
+        "[shapecensus] by_origin: spec{{gens={} read={} never={} reads={}}} rebind{{gens={} read={} never={} reads={}}} reads_per_rebind_gen={:.2}",
+        mints[SPEC], gens_origin[0], never_origin[0], reads_origin[0],
+        mints[REBIND], gens_origin[1], never_origin[1], reads_origin[1],
+        reads_origin[1] as f64 / gens_origin[1].max(1) as f64
+    );
+}
