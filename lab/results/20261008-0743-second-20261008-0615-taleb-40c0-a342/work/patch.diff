@@ -0,0 +1,71 @@
+//! The live loop's decision log is canonical (lab runs 20261008-0615 and 20261008-0743): the same
+//! physical key timeline writes the same ticks and the same history whatever the frame rate, the
+//! budget (load) or the thread count. AGENTS.md Truth: "Canonical outcomes are exact and
+//! independent of cache, partition, observation, schedule and hardware."
+use emergent_universe::fleet::Order;
+use emergent_universe::num::Tick;
+use emergent_universe::scenario::plane;
+use emergent_universe::universe::{Budget, Universe};
+use emergent_universe::Config;
+
+/// One flight of the shipped loop's shape (`xtask` `session.rs::step`): a fixed key timeline at
+/// wall moments, every change logged through [`Universe::input_frame`], frames at `fps`, optionally
+/// starved (a budget that bites: the load-only form).
+fn play(seed: u64, threads: usize, fps: f64, starve: bool, rtf: f64, cut: Tick) -> (String, Vec<Tick>) {
+    let mut u: Universe = plane(Config::default(), seed, Order::Sparse, threads, 1024).expect("scene").u;
+    let (wall_changes, keys_at) = ([0.5f64, 1.7, 3.2], [0x01u8, 0x11, 0x00]);
+    let (mut held, mut wall_t, mut guard) = (None, 0.0f64, 0u64);
+    let dt = 1.0 / fps;
+    let budget = if starve { Budget::events(2) } else { Budget::unlimited() };
+    while u.now < cut && guard < 1_000_000 {
+        guard += 1;
+        for (i, w) in wall_changes.iter().enumerate() {
+            if wall_t < *w && wall_t + dt >= *w && held != Some(keys_at[i]) {
+                u.input_frame(keys_at[i], rtf).expect("decision in the past");
+                held = Some(keys_at[i]);
+            }
+        }
+        wall_t += dt;
+        let f = u.frame_to(dt, rtf, budget, cut);
+        if f.events == 0 && f.presented >= cut {
+            break;
+        }
+    }
+    u.settle(cut);
+    (u.digest(), u.inputs.iter().map(|&(t, _)| t).collect())
+}
+
+/// Same pace, same history: within one time factor the frame rate, the load (a budget that bites)
+/// and the thread count cannot move the logged ticks or the digest at the cut.
+#[test]
+fn decision_log_survives_frame_rate_budget_and_threads() {
+    let cut = 80_000_000;
+    let paths = [
+        ("60 Hz", 1, 60.0, false),
+        ("30 Hz", 1, 30.0, false),
+        ("144 Hz", 1, 144.0, false),
+        ("60 Hz starved (load-only, the ruin form)", 1, 60.0, true),
+        ("60 Hz starved, 8 threads", 8, 60.0, true),
+    ];
+    let mut want: Option<(String, Vec<Tick>)> = None;
+    for &(name, thr, fps, starve) in &paths {
+        let got = play(11, thr, fps, starve, 100.0, cut);
+        match &want {
+            None => want = Some(got),
+            Some(w) => assert!(w == &got, "{name}: diverged\n  want {w:?}\n  got  {got:?}"),
+        }
+    }
+    let (digest, ticks) = want.expect("paths");
+    assert_eq!(ticks, vec![10151272, 35529452, 65983268], "ticks are the decision-quantum multiples");
+    assert_eq!(digest, "e1da531e2da1079a8a597db44f197a1c3f4608be3ffe389d8fd12008ca613b67");
+}
+
+/// The shipped default pace holds the same property (a different quantum grid, so its own digest).
+#[test]
+fn decision_log_survives_load_at_real_time_pace() {
+    let cut = 80_000_000;
+    let rich = play(11, 1, 60.0, false, 1.0, cut);
+    let starved = play(11, 1, 60.0, true, 1.0, cut);
+    assert_eq!(rich, starved, "same fps, different load: one history");
+    assert_eq!(rich.1, vec![101512, 355292, 659828], "ticks are the decision-quantum multiples");
+}
