+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    for line in status.lines() {
+        if let Some(v) = line.strip_prefix("VmRSS:") {
+            now = v.trim().split_whitespace().next().and_then(|k| k.parse().ok()).unwrap_or(0) * 1024;
+        } else if let Some(v) = line.strip_prefix("VmHWM:") {
+            peak = v.trim().split_whitespace().next().and_then(|k| k.parse().ok()).unwrap_or(0) * 1024;
+        }
+    }
+    (now, peak)
+}
