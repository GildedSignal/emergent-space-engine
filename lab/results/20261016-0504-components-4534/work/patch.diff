+/// The locals' stagger (lab 20261016-0504-components-4534): 0 = shipped (unset or "0"), 1 = begin-only
+/// (each secondary-doll ship's first plan begins at a hash-spread tick, the block-step grid untouched),
+/// 2 = grid-translate (each such ship's block-step grid is translated by a per-body dyadic offset).
+pub(crate) fn stagger_loc() -> u8 {
+    static MODE: std::sync::LazyLock<u8> = std::sync::LazyLock::new(|| {
+        std::env::var("ES_STAGGER_LOC").ok().and_then(|s| s.parse().ok()).unwrap_or(0)
+    });
+    *MODE
+}
