+
+/// A per-body dyadic offset, uniform on `[0, step)`: the block-step grid translated by `o`.
+fn stagger_off(i: usize, step: i64) -> Tick {
+    let mut h = (i as u64 ^ 0x9E3779B97F4A7C15).wrapping_mul(0xBF58476D1CE4E5B9);
+    h ^= h >> 27;
+    h = h.wrapping_mul(0x94D049BB133111EB);
+    (h as i64).rem_euclid(step)
+}
+
+/// `aligned` on the body's own translated grid (mode 2): the same block steps and stub rule,
+/// anchored at the body's phase instead of tick 0.
+fn aligned_off(step: i64, t: Tick, off: Tick) -> i64 {
+    let rel = (t - off).rem_euclid(step);
+    if rel == 0 {
+        return step;
+    }
+    let stub = step - rel;
+    if stub < MIN_STEP {
+        stub + step
+    } else {
+        stub
+    }
+}
