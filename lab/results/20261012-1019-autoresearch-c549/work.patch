new file mode 100644
index 00000000..54a68568
--- /dev/null
+++ b/crates/universe/examples/kick_probe.rs
@@ -0,0 +1,48 @@
+// Probe harness for the kick path: pure resolve µs and whole-universe µs/item, with the digest as
+// the behaviour lock (the lab run 20261012-1019-autoresearch-c549; loop identical to cost_split.rs).
+// A-tune is the tuning case; B/C/D are held out (never tuned on).
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::{body::What, step, Config};
+use std::time::Instant;
+
+fn probe(name: &str, cfg: Config, seed: u64, order: Order, fleets: usize, fleet_n: u64) {
+    let mut p = plane(cfg, seed, order, fleets, fleet_n).unwrap();
+    let ship = p.ships[14];
+    let n = 3000;
+    let ctx = p.u.ctx();
+    let rec = p.u.rec(ship);
+    let t0 = Instant::now();
+    let mut kicks = 0;
+    for _ in 0..n {
+        let mut r = rec.clone();
+        while !matches!(r.plan.first().map(|i| i.what), Some(What::Kick(0))) {
+            r.plan.remove(0);
+        }
+        let u = step::process(&ctx, ship, r);
+        kicks += matches!(u.kind, step::Resolved::Kick) as u32;
+        std::hint::black_box(&u);
+    }
+    let pure = t0.elapsed().as_secs_f64() * 1e6 / n as f64;
+    drop(ctx);
+    let h = 30_000_000_000i64;
+    let t0 = Instant::now();
+    p.u.settle(h);
+    let el = t0.elapsed();
+    let s = p.u.stats;
+    let ev = s.kicks + s.opens + s.boundaries;
+    let whole = el.as_secs_f64() * 1e6 / ev as f64;
+    println!(
+        "{name} pure_kick {pure:.2} us ({kicks}/{n}) whole {whole:.2} us/item ({ev} items, {el:.2?}) bytes/body {} digest {}",
+        p.u.bytes_per_body(),
+        p.u.digest()
+    );
+}
+
+fn main() {
+    let d = Config::default();
+    probe("A-tune", d, 1, Order::Sparse, 1, 8);
+    probe("B-held", d, 1, Order::Dense, 3, 8);
+    probe("C-held", d, 5, Order::Sparse, 2, 12);
+    probe("D-held", Config { step_log2: 6, ..d }, 2, Order::Sparse, 1, 8);
+}
