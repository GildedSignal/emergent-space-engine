+#[inline]
+pub(crate) fn add_ns(counter: &AtomicU64, t0: Instant) {
+    if TIMERS_ARMED.load(Ordering::Relaxed) {
+        counter.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+}
