+/// One source of a doll, read once at one tick: **both projections of the same readout** — the Cartesian
+/// state the forces read ([`Ctx::secondaries`], [`Ctx::tide`]) and the elements the clock reads
+/// ([`ext::constants`](crate::ext::constants)' `source`): `(gm, semi-major axis, period)`, or the refusal
+/// the live path would return (`Err`), replayed bit for bit. A pass that reads every body against the same
+/// sources at the same tick (a birth pass, a same-epoch kick batch) reads them once, not once per body.
+#[derive(Clone, Debug)]
+pub struct PlanetsAt {
+    /// The tick the table was read at; a read at any other tick misses (and falls back to the live path).
+    pub tick: Tick,
+    /// Per doll, in `sources[d]`'s order: the source's id and its Cartesian state as a secondary.
+    pub per_doll: Vec<Vec<(usize, Secondary)>>,
+    /// The clock's projection of the same readouts: `(j, Ok((gm, axis, period)) | Err(reason))`.
+    pub elems: Vec<(usize, Res<(Scalar, Scalar, Scalar)>)>,
+    /// Per doll: the parent's tide — its mass and the centre's position, in the doll's units.
+    pub tide: Vec<Option<(Scalar, V2)>>,
+    /// Per doll: the centre's state (position, velocity) in the parent's units.
+    pub centre: Vec<Option<Res<(V2, V2)>>>,
+}
+
+impl PlanetsAt {
+    /// Read every doll's sources at `t` once, through the same live paths the per-body reads use
+    /// (the table is built before it is armed, so these are the shipped reads verbatim).
+    pub fn build(ctx: &Ctx, t: Tick) -> PlanetsAt {
+        let per_doll = ctx
+            .sources
+            .iter()
+            .map(|src| {
+                src.iter()
+                    .filter_map(|&j| {
+                        let (pos, vel) = ctx.state_of(j, t).ok()?;
+                        Some((j, Secondary { gm: ctx.info[j].gm, pos, vel, edge: ctx.info[j].soi }))
+                    })
+                    .collect()
+            })
+            .collect();
+        let elems = ctx
+            .sources
+            .iter()
+            .flatten()
+            .map(|&j| (j, crate::ext::source_live(ctx, j, t).map(|s| (s.gm, s.axis, s.period))))
+            .collect();
+        let tide = (0..ctx.dolls.len())
+            .map(|d| ctx.tide_live(d as u16, t).ok().flatten())
+            .collect();
+        let centre = (0..ctx.dolls.len())
+            .map(|d| (d != 0).then(|| ctx.centre_live(d as u16, t)))
+            .collect();
+        PlanetsAt { tick: t, per_doll, elems, tide, centre }
+    }
+
+    /// The element projection of source `j` at `self.tick`, if this table holds it.
+    pub fn elem(&self, j: usize, t: Tick) -> Option<Res<(Scalar, Scalar, Scalar)>> {
+        (self.tick == t).then(|| self.elems.iter().find(|&&(k, _)| k == j).map_or(Err(crate::num::Error::Refused("not a source")), |(_, r)| *r))
+    }
+}
