+fn env_on(name: &str) -> bool {
+    matches!(std::env::var(name).as_deref(), Ok(v) if !v.is_empty() && v != "0" && v != "off")
+}
+/// Whether the birth timers print (`ES_BIRTH_SPLIT`).
+pub fn split_on() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| env_on("ES_BIRTH_SPLIT"));
+    *ON
+}
+/// Whether the shared planets readout is armed (`ES_PLANETS_AT_T`); off is the shipped path verbatim.
+pub fn memo_on() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| env_on("ES_PLANETS_AT_T"));
+    *ON
+}
