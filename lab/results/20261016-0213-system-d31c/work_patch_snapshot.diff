+/// relaxed load). `""`/`0`/`off` mean off.
+pub static TIMERS_ARMED: AtomicBool = AtomicBool::new(false);
+pub static T_CONSTANTS: AtomicU64 = AtomicU64::new(0);
+pub static T_PROJECT: AtomicU64 = AtomicU64::new(0);
