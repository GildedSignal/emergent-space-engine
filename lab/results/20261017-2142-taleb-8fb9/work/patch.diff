+//! 20261017-2142-taleb-8fb9: does a period/phase-quantized belt (the compact store's own form: shared
+//! (anchor, full) means shared fire ticks) re-create a standing comb on the shipped chained clock, or does
+//! the per-fire step drift shear it apart? One flight of the ladder population (`scenario::plane_extra`,
+//! the draw quantized by ES_BELT_A_SHIFT / ES_BELT_PHASE_SHIFT before `ladder_ship` sees it), advanced one
+//! rtf-100 frame at a time with an unlimited budget (the true dues, never deferred), recording every
+//! frame's event count and wall ms. Fire windows of WINDOW ticks each: the genesis train is window 0,
+//! steady state is the later windows.
+//!
+//! cargo run --release -p emergent-universe --example belt_comb [-- <N> <windows> <seed>]
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::{Budget, Config};
+use emergent_universe::fleet::Order;
+use std::time::Instant;
+
+const WINDOW: i64 = 6_000_000_000; // ticks per fire window (one belt period is 4.3-5.9e9)
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize].min(sorted[sorted.len() - 1])
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(50_000);
+    let windows: usize = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(5);
+    let seed: u64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let (qa, qp) = (
+        std::env::var("ES_BELT_A_SHIFT").ok().and_then(|s| s.parse::<u32>().ok()).unwrap_or(0),
+        std::env::var("ES_BELT_PHASE_SHIFT").ok().and_then(|s| s.parse::<u32>().ok()).unwrap_or(0),
+    );
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let bodies = p.u.n_bodies();
+    println!(
+        "comb: n={n} bodies={bodies} seed={seed} a_shift={qa} phase_shift={qp} windows={windows} build_s={build:.2} wall_start_s={:.1}",
+        t0.elapsed().as_secs_f64()
+    );
+    let mut rows: Vec<(i64, u64, f64)> = Vec::new(); // window, events, wall ms
+    let mut total_events = 0u64;
+    let horizon = WINDOW * windows as i64;
+    let mut t_prev = p.u.now;
+    while p.u.now < horizon {
+        let start = Instant::now();
+        let f = p.u.frame_to(1.0 / 60.0, 100.0, Budget::unlimited(), i64::MAX);
+        let took = start.elapsed().as_secs_f64() * 1e3;
+        let w = (p.u.now - 1).max(0) / WINDOW; // the frame that contains this frame's dues
+        rows.push((w, f.events, took));
+        total_events += f.events;
+        if p.u.now == t_prev {
+            break; // no progress: nothing more is due
+        }
+        t_prev = p.u.now;
+    }
+    let mut worst: Vec<(i64, u64, f64)> = rows.clone();
+    worst.sort_by(|a, b| b.1.cmp(&a.1));
+    println!(
+        "comb: frames={} events_total={total_events} events_per_frame_mean={:.2}",
+        rows.len(),
+        total_events as f64 / rows.len().max(1) as f64
+    );
+    for w in 0..windows as i64 {
+        let mut ev: Vec<f64> = rows.iter().filter(|r| r.0 == w).map(|r| r.1 as f64).collect();
+        let mut ms: Vec<f64> = rows.iter().filter(|r| r.0 == w).map(|r| r.2).collect();
+        if ev.is_empty() {
+            println!("comb: w={w} frames=0");
+            continue;
+        }
+        ev.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let sum: f64 = ev.iter().sum();
+        let (ge100, ge400) = (
+            ev.iter().filter(|e| **e >= 100.0).count(),
+            ev.iter().filter(|e| **e >= 400.0).count(),
+        );
+        println!(
+            "comb: w={w} frames={} ev_mean={:.2} ev_p99={:.0} ev_max={:.0} ev_sum={:.0} ev_ge100={ge100} ev_ge400={ge400} ms_p50={:.3} ms_p99={:.3} ms_max={:.3}",
+            ev.len(),
+            sum / ev.len() as f64,
+            pct(&ev, 0.99),
+            ev[ev.len() - 1],
+            sum,
+            pct(&ms, 0.5),
+            pct(&ms, 0.99),
+            ms[ms.len() - 1],
+        );
+    }
+    println!(
+        "comb: worst10={}",
+        worst.iter().take(10).map(|r| format!("(w{},{}ev,{:.2}ms)", r.0, r.1, r.2)).collect::<Vec<_>>().join(" ")
+    );
+    println!("comb: wall_total_s={:.1}", t0.elapsed().as_secs_f64());
+}
