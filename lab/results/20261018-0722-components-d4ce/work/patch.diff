+//! Compile-cost probe for the fast-path quadrature: times `Orbit::compile` per key on a
+//! strong-field (p, e) grid and reports panels (knots) with ns/compile and ns/panel, so a
+//! patch to `fast_quad`'s per-node arithmetic shows as a per-panel delta. Print-only.
+//! cargo run --release -p emergent-space --example strong_compile_probe
+use emergent_space::orbit::{Orbit, OrbitKey, Scalar};
+use std::time::Instant;
+
+fn to_scalar(x: f64) -> Option<Scalar> {
+    if x == 0.0 {
+        return Some(Scalar::ZERO);
+    }
+    if !x.is_finite() || x.abs() < 1e-290 {
+        return None;
+    }
+    let bits = x.abs().to_bits();
+    let exp = ((bits >> 52) & 0x7ff) as i32 - 1023;
+    let man = ((bits & ((1 << 52) - 1)) | (1 << 52)) as i128;
+    Scalar::raw(if x < 0.0 { -man } else { man }, exp - 52).ok()
+}
+
+fn main() {
+    let ps = [6.6f64, 7.0, 8.0, 10.0, 12.0, 20.0, 50.0, 200.0, 1000.0, 1e4, 1e5, 1e6];
+    let es = [0.0f64, 0.3, 0.5, 0.7, 0.9, 0.99, 0.999, 0.9999, 0.99999];
+    println!("p,e,panels,ns_compile,ns_panel");
+    for &p in &ps {
+        for &e in &es {
+            let key = match OrbitKey::bound(
+                to_scalar(p).unwrap(),
+                (e * (1u64 << 48) as f64) as u64,
+            ) {
+                Ok(k) => k,
+                Err(_) => {
+                    println!("{p},{e},refused,,");
+                    continue;
+                }
+            };
+            let mut panels = 0usize;
+            let mut ok = true;
+            for _ in 0..3 {
+                match Orbit::compile(key) {
+                    Ok(o) => panels = o.shape().knots().len(),
+                    Err(_) => ok = false,
+                }
+            }
+            if !ok || panels == 0 {
+                println!("{p},{e},compile_err,,");
+                continue;
+            }
+            // adaptive reps: aim >= 60 ms per sample, 5 samples, median
+            let mut reps = 20usize;
+            loop {
+                let t0 = Instant::now();
+                for _ in 0..reps {
+                    std::hint::black_box(Orbit::compile(std::hint::black_box(key)).is_ok());
+                }
+                if t0.elapsed().as_secs_f64() >= 0.06 || reps >= 1 << 22 {
+                    break;
+                }
+                reps *= 2;
+            }
+            let mut samples = [0f64; 5];
+            for s in samples.iter_mut() {
+                let t0 = Instant::now();
+                for _ in 0..reps {
+                    std::hint::black_box(Orbit::compile(std::hint::black_box(key)).is_ok());
+                }
+                *s = t0.elapsed().as_secs_f64() / reps as f64 * 1e9;
+            }
+            samples.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            let ns = samples[2];
+            println!("{p},{e},{},{}", panels.saturating_sub(1), ns as u64);
+        }
+    }
+}
