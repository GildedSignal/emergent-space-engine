+//! The crash-tick search probe (this run's patch): the cost and the readout count of `next_impact`
+//! on the battle arms, with the verified Kepler guess off (`ES_IMP_GUESS` unset) or on. One line per
+//! arm: the wall of the frames, the digest at the canonical cut (the identity control: on and off
+use emergent_universe::step::{imp_reset, IMP, IMP_NS};
+
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+/// (name, seed, members, rtf, game seconds): the 14 October battle arms of the frame-cost page.
+fn arms() -> Vec<(&'static str, u64, u64, f64, f64)> {
+    vec![
+        ("battle m4000 s3", 3, 4000, 1.0, 8.0),
+        ("battle m1500 s3", 3, 1500, 1.0, 8.0),
+        ("battle m4000 s7", 7, 4000, 1.0, 8.0),
+        ("battle m1500 s11", 11, 1500, 1.0, 8.0),
+        ("flying m400 s3", 3, 400, 100.0, 8.0),
+        ("handout m16000 s3", 3, 16000, 1.0, 8.0),
+    ]
+}
+
+fn run(seed: u64, members: u64, rtf: f64, seconds: f64) -> (f64, String, u64, u64) {
+    let cut = (seconds * rtf / TICK_SECONDS) as i64;
+    let mut p = plane(Config::default(), seed, Order::Sparse, 1, members).unwrap();
+    imp_reset();
+    let t0 = Instant::now();
+    for _ in 0..400_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        p.u.frame_to(1.0 / 60.0, rtf, Budget::unlimited(), cut);
+    }
+    let wall = t0.elapsed().as_secs_f64();
+    p.u.settle(cut);
+
+    (
+        wall,
+        p.u.digest(),
+        p.u.stats.kicks,
+        p.u.stats.encounters,
+    )
+    // counters read by the caller before the next arm resets them
+}
+
+fn main() {
+    let only = std::env::args().nth(1).unwrap_or_default();
+    let g = |i: usize| IMP[i].load(std::sync::atomic::Ordering::Relaxed);
+    let hist = |name: &str, bins: &[std::sync::atomic::AtomicU64]| {
+        let counts: Vec<(usize, u64)> = bins
+            .iter()
+            .enumerate()
+            .map(|(b, c)| (b, c.load(std::sync::atomic::Ordering::Relaxed)))
+            .filter(|&(_, c)| c > 0)
+            .collect();
+        let total: u64 = counts.iter().map(|&(_, c)| c).sum();
+        if total > 0 {
+            let p50 = counts.iter().try_fold((0u64, None), |(acc, mut med), &(b, c)| {
+                if med.is_none() && acc + c > total / 2 {
+                    med = Some(b);
+                }
+                Ok::<_, ()>((acc + c, med))
+            });
+            let (_, p50) = p50.unwrap();
+            println!("  miss-{name}: n {total}, p50 bin {} (ticks), bins {}", p50.map(|b| format!("2^{b}")).unwrap_or("-".into()), counts.iter().map(|(b, c)| format!("{b}:{c}")).collect::<Vec<_>>().join(" "));
+        }
+    };
+    for (name, seed, members, rtf, seconds) in arms().into_iter().filter(|a| a.0.contains(&only)) {
+        let (wall, digest, kicks, encounters) = run(seed, members, rtf, seconds);
+        let (calls, searches, cyc, pas, m_tries, m_hits, w_tries, w_hits, reads) =
+            (g(0), g(3), g(4), g(5), g(6), g(7), g(10), g(11), g(9));
+        println!(
+            "{:<18} wall {:6.2} s | digest {} | kicks {:>5} | imp calls {:>6} searches {:>6} (cyc {:>5} pas {:>4}) reads {:>7} ({:.2}/search) | model {}/{} hits, warm {}/{} hits, bisect-finished {}",
+            name,
+            wall,
+            &digest[..16],
+            kicks,
+            calls,
+            searches,
+            cyc,
+            pas,
+            reads,
+            if searches > 0 { reads as f64 / searches as f64 } else { 0.0 },
+            m_hits,
+            m_tries,
+            w_hits,
+            w_tries,
+            g(13),
+        );
+        println!("  predicate: {} us total, {:.2} us/search ({:.1} ns/read)", IMP_NS.load(std::sync::atomic::Ordering::Relaxed) as f64 / 1e3, IMP_NS.load(std::sync::atomic::Ordering::Relaxed) as f64 / 1e3 / searches as f64, IMP_NS.load(std::sync::atomic::Ordering::Relaxed) as f64 / reads as f64);
+        println!("  warm arm: no hint {}, hint outside bracket {}", g(14), g(15));
+        hist("model", &emergent_universe::step::IMP_MISS_MODEL);
+        hist("warm", &emergent_universe::step::IMP_MISS_WARM);
+    }
+}
