+    std::sync::atomic::AtomicU64::new(0), // 4 of them on a cycle
+    std::sync::atomic::AtomicU64::new(0), // 5 of them on a passage
+    std::sync::atomic::AtomicU64::new(0), // 6 model guesses tried
+    std::sync::atomic::AtomicU64::new(0), // 7 model first-guess hits
+    std::sync::atomic::AtomicU64::new(0), // 8 predicate evaluations inside the model guess
+    std::sync::atomic::AtomicU64::new(0), // 9 predicate evaluations, all callers
+    std::sync::atomic::AtomicU64::new(0), // 10 warm hints tried
+    std::sync::atomic::AtomicU64::new(0), // 11 warm first-guess hits
+    std::sync::atomic::AtomicU64::new(0), // 12 predicate evaluations inside the warm hint
+    std::sync::atomic::AtomicU64::new(0), // 13 searches the bisection finished (no guess returned)
+    std::sync::atomic::AtomicU64::new(0), // 14 warm arm on with no hint at all
+    std::sync::atomic::AtomicU64::new(0), // 15 warm arm on, hint outside (lo, hi]
+];
+pub static IMP_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static IMP_MISS_MODEL: [std::sync::atomic::AtomicU64; 48] = [const { std::sync::atomic::AtomicU64::new(0) }; 48];
+pub static IMP_MISS_WARM: [std::sync::atomic::AtomicU64; 48] = [const { std::sync::atomic::AtomicU64::new(0) }; 48];
+
+/// Zero the probe counters (the harness runs one arm per process).
+
+pub fn imp_reset() {
+    for c in IMP.iter().chain(IMP_MISS_MODEL.iter()).chain(IMP_MISS_WARM.iter()) {
+        c.store(0, std::sync::atomic::Ordering::Relaxed);
+    }
+    IMP_NS.store(0, std::sync::atomic::Ordering::Relaxed);
+}
+
+fn imp_guess_on() -> bool {
+    static G: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var_os("ES_IMP_GUESS").is_some());
+    *G
+}
+
+fn imp_warm_on() -> bool {
+    static W: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var_os("ES_IMP_WARM").is_some());
+    *W
+}
+
+/// A float view of a scalar, for the guess weights only (never for an outcome).
+fn s_f64(x: Scalar) -> f64 {
+    x.significand() as f64 * 2f64.powi(x.exponent() as i32 - 62)
+}
