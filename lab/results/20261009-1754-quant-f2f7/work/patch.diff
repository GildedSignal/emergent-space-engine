index 0000000..8a02745
--- /dev/null
+++ b/crates/universe/examples/kick_budget.rs
@@ -0,0 +1,249 @@
+//! Run 20261009-1754-quant-f2f7: the plane's per-event cost, decomposed and budgeted.
+//! Sizes, hot/cold pure resolve, whole-universe per event vs N, allocations per event,
+//! and the ns/event budget at 10^9 bodies from the scene's own measured cadence.
+use emergent_space::orbit::Scalar;
+use emergent_universe::body::{Item, What};
+use emergent_universe::scenario::restricted;
+use emergent_universe::step::{self, Resolved};
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::hint::black_box;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+// ---- counting allocator (K3) ------------------------------------------------------------------------
+static ALLOCS: AtomicU64 = AtomicU64::new(0);
+static DEALLOCS: AtomicU64 = AtomicU64::new(0);
+static BYTES: AtomicU64 = AtomicU64::new(0);
+struct Counting;
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+        ALLOCS.fetch_add(1, Relaxed);
+        BYTES.fetch_add(l.size() as u64, Relaxed);
+        System.alloc(l)
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+        DEALLOCS.fetch_add(1, Relaxed);
+        System.dealloc(p, l)
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: Layout, n: usize) -> *mut u8 {
+        ALLOCS.fetch_add(1, Relaxed);
+        BYTES.fetch_add(n as u64, Relaxed);
+        System.realloc(p, l, n)
+    }
+    unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
+        ALLOCS.fetch_add(1, Relaxed);
+        BYTES.fetch_add(l.size() as u64, Relaxed);
+        System.alloc_zeroed(l)
+    }
+}
+#[global_allocator]
+static A: Counting = Counting;
+
+fn pct(samples: &mut Vec<f64>) -> (f64, f64, f64) {
+    samples.sort_by(f64::total_cmp);
+    let at = |p: f64| samples.get(((samples.len().saturating_sub(1)) as f64 * p).ceil() as usize).copied().unwrap_or(f64::NAN);
+    (at(0.5), at(0.99), samples.len() as f64)
+}
+
+#[cfg(target_arch = "x86_64")]
+fn flush_bytes(p: *const u8, len: usize) {
+    let mut a = p as usize & !63;
+    let end = (p as usize + len + 63) & !63;
+    while a < end {
+        unsafe { core::arch::x86_64::_mm_clflush(a as *const u8) };
+        a += 64;
+    }
+}
+
+/// The Jacobi scene recipe from tests/motion.rs: ships at sep ± hill*(1.5+1.5*rnd), random angle.
+fn make(n: u32) -> emergent_universe::scenario::Restricted {
+    let (mu_log2, sep) = (-10i32, 527_000_000i64);
+    let hill = sep as f64 * (2f64.powi(mu_log2) / 3.0).cbrt();
+    let mut seed = 0x9E3779B97F4A7C15u64;
+    let mut rnd = || {
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        (seed >> 11) as f64 / (1u64 << 53) as f64
+    };
+    let ships: Vec<(i64, u32)> = (0..n)
+        .map(|i| {
+            let r = sep as f64 + if i % 2 == 0 { 1.0 } else { -1.0 } * hill * (1.5 + 1.5 * rnd());
+            (r as i64, (rnd() * (1u64 << 32) as f64) as u32)
+        })
+        .collect();
+    restricted(mu_log2, sep, 49_000, &ships, 1).unwrap()
+}
+
+/// Per-event cost of settling a fresh scene to `h` ticks, whole universe, single thread.
+fn sweep(n: u32, h: i64) {
+    let t0 = Instant::now();
+    let mut w = make(n);
+    let build_s = t0.elapsed().as_secs_f64();
+    let a0 = (ALLOCS.load(Relaxed), BYTES.load(Relaxed));
+    let t1 = Instant::now();
+    w.u.settle(h);
+    let wall = t1.elapsed().as_secs_f64();
+    let a1 = (ALLOCS.load(Relaxed), BYTES.load(Relaxed));
+    let s = &w.u.stats;
+    let ev = s.kicks + s.opens + s.boundaries;
+    let per = if ev > 0 { wall * 1e9 / ev as f64 } else { f64::NAN };
+    let ship_per = if s.items[2] > 0 { s.cost_ns[2] as f64 / s.items[2] as f64 } else { f64::NAN };
+    println!(
+        "N={n:>6} build={build_s:5.2}s settle={wall:6.3}s events={ev:>7} (kicks {} opens {} bnd {} | ship-class {}) per_event_all={per:8.0}ns per_event_ship={ship_per:8.0}ns allocs/event={:.2} bytes/event={:.0} bytes_of_body~{:.0}",
+        s.kicks, s.opens, s.boundaries, s.items[2],
+        (a1.0 - a0.0) as f64 / ev.max(1) as f64,
+        (a1.1 - a0.1) as f64 / ev.max(1) as f64,
+        w.u.rec(w.ships[0]).plan.capacity() as f64,
+    );
+    let rate = ev as f64 / (n as f64 * h as f64); // events per body per tick
+    println!("        cadence: {:.3e} events/body/tick  ({:.3} events per body per game-second)", rate, rate * 203_252.0);
+}
+
+fn main() {
+    // ---- sizes (M0) -----------------------------------------------------------------------------------
+    println!("sizes: BodyRec={} Item={} Segment={} Binding={} Entry={} Scalar={} calendar_slot={}",
+        std::mem::size_of::<emergent_universe::body::BodyRec>(),
+        std::mem::size_of::<Item>(),
+        std::mem::size_of::<emergent_universe::body::Segment>(),
+        std::mem::size_of::<emergent_universe::bind::Binding>(),
+        std::mem::size_of::<emergent_universe::bind::Entry>(),
+        std::mem::size_of::<Scalar>(),
+        2 * std::mem::size_of::<Scalar>() + 4,
+    );
+
+    // ---- whole-universe N sweep (M2, K3, K4) -----------------------------------------------------------
+    let horizon = 2_500_000_000_000i64;
+    for n in [16u32, 1024, 8192, 65536] {
+        sweep(n, horizon);
+    }
+
+    // ---- pure resolve: hot / pool-cold / clflush-cold (M1, K2) -----------------------------------------
+    let n_pool = 16384u32;
+    let t0 = Instant::now();
+    let mut w = make(n_pool);
+    println!("pool scene: {} ships built in {:.2}s", n_pool, t0.elapsed().as_secs_f64());
+    let ctx = w.u.ctx();
+    let pool: Vec<(usize, emergent_universe::body::BodyRec)> = w.ships.iter().map(|&i| (i, w.u.rec(i))).collect();
+
+    // the loop body cost_split uses: clone record, strip to the first Kick(0), resolve it
+    let one_kick = |id: usize, rec: &emergent_universe::body::BodyRec| -> Resolved {
+        let mut r = rec.clone();
+        let mut guard = 0;
+        while !matches!(r.plan.first().map(|i| i.what), Some(What::Kick(0))) {
+            r.plan.remove(0);
+            guard += 1;
+            if r.plan.is_empty() || guard > 64 {
+                return Resolved::Lost; // no kick item in this record's plan
+            }
+        }
+        let u = step::process(&ctx, id, r);
+        black_box(&u);
+        u.kind
+    };
+
+    // clone alone, hot
+    {
+        let mut s = Vec::new();
+        for _ in 0..2000 {
+            let t = Instant::now();
+            black_box(pool[0].1.clone());
+            s.push(t.elapsed().as_secs_f64() * 1e9);
+        }
+        let (p50, p99, n) = pct(&mut s);
+        println!("clone_alone_hot: p50={p50:.0}ns p99={p99:.0}ns n={n:.0}");
+    }
+    // hot: one record, many iterations
+    {
+        let mut s = Vec::new();
+        let mut kinds = (0u32, 0u32);
+        for _ in 0..2000 {
+            let t = Instant::now();
+            let k = one_kick(pool[0].0, &pool[0].1);
+            s.push(t.elapsed().as_secs_f64() * 1e9);
+            kinds.0 += (k == Resolved::Kick) as u32;
+            kinds.1 += 1;
+        }
+        let (p50, p99, n) = pct(&mut s);
+        println!("pure_hot: p50={p50:.0}ns p99={p99:.0}ns n={n:.0} kicks={}/{}", kinds.0, kinds.1);
+    }
+    // pool-cold: cycle every record once (working set > L3), two passes
+    for pass in 1..=2u32 {
+        let mut s = Vec::new();
+        let mut kinds = 0u32;
+        let t = Instant::now();
+        for (id, rec) in pool.iter() {
+            let t1 = Instant::now();
+            let k = one_kick(*id, rec);
+            s.push(t1.elapsed().as_secs_f64() * 1e9);
+            kinds += (k == Resolved::Kick) as u32;
+        }
+        let (p50, p99, n) = pct(&mut s);
+        println!("pure_pool_cold pass{pass}: p50={p50:.0}ns p99={p99:.0}ns n={n:.0} kicks={kinds} pass_wall={:.3}s", t.elapsed().as_secs_f64());
+    }
+    // clflush-cold: flush record + plan buffer before each resolve
+    #[cfg(target_arch = "x86_64")]
+    {
+        let mut s = Vec::new();
+        let mut kinds = 0u32;
+        for (id, rec) in pool.iter().take(4096) {
+            flush_bytes(rec as *const _ as *const u8, std::mem::size_of_val(rec));
+            if !rec.plan.is_empty() {
+                flush_bytes(rec.plan.as_ptr() as *const u8, rec.plan.len() * std::mem::size_of::<Item>());
+            }
+            let t1 = Instant::now();
+            let k = one_kick(*id, rec);
+            s.push(t1.elapsed().as_secs_f64() * 1e9);
+            kinds += (k == Resolved::Kick) as u32;
+        }
+        let (p50, p99, n) = pct(&mut s);
+        println!("pure_clflush_cold: p50={p50:.0}ns p99={p99:.0}ns n={n:.0} kicks={kinds}");
+    }
+
+    // ---- stage timers, hot (M3) ------------------------------------------------------------------------
+    {
+        let (id, rec) = &pool[0];
+        let t = rec.b.event_time + 1000;
+        let mut timeit = |name: &str, f: &mut dyn FnMut()| {
+            let mut s = Vec::new();
+            for _ in 0..1000 {
+                let t0 = Instant::now();
+                f();
+                s.push(t0.elapsed().as_secs_f64() * 1e9);
+            }
+            let (p50, _, _) = pct(&mut s);
+            println!("stage {name}: p50={p50:.0}ns");
+        };
+        timeit("readout", &mut || { black_box(rec.b.readout(t).unwrap()); });
+        timeit("secondaries", &mut || { black_box(ctx.secondaries(rec.b.doll, t, *id).unwrap()); });
+        timeit("tide", &mut || { black_box(ctx.tide(rec.b.doll, t).unwrap()); });
+        timeit("root_state", &mut || { black_box(emergent_universe::observe::root_state(&ctx, *id, t).unwrap()); });
+    }
+    drop(ctx);
+
+    // ---- budget (B1): measured cadence + analytic regimes ------------------------------------------------
+    // root unit = GM_sun/c^2 = 1.477 km -> tick = GM_sun/c^3 = 4.925 us -> 203,252 ticks per game-second.
+    let tps = 203_252.0f64;
+    let rtf = 100.0f64;
+    let cores = 4.0f64;
+    println!("budget: allowed ns/event = cores*1e9/(N * rate_per_tick * {tps:.0} * rtf={rtf:.0}), rtf from Julien's flight view (--rtf 100)");
+    let regimes: [(&str, f64); 3] = [
+        ("this_scene P~7.6e13t", 4.0 / 7.6e13), // ~2 kicks + 2 boundaries per 2.5e12-tick horizon, measured below
+        ("belt_1AU P=6.42e12t", 64.0 / 6.42e12),
+        ("low_moon P=6.4e10t", 64.0 / 6.4e10),
+    ];
+    for (name, rate) in regimes {
+        for n in [1e6f64, 1e9f64] {
+            let allowed = cores * 1e9 / (n * rate * tps * rtf);
+            println!("  {name} N={n:.0e}: allowed {allowed:10.0} ns/event");
+        }
+    }
+    // measured cadence from the largest sweep scene:
+    let mut w = make(8192);
+    w.u.settle(horizon);
+    let s = &w.u.stats;
+    let ev = (s.kicks + s.opens + s.boundaries) as f64;
+    let rate = ev / (8192.0 * horizon as f64);
+    println!("  measured scene cadence: {rate:.3e}/body/tick -> at N=1e9 allowed {:.0} ns/event; N_max at 1000ns/event = {:.2e}",
+        cores * 1e9 / (1e9 * rate * tps * rtf),
+        cores * 1e9 / (rate * tps * rtf * 1000.0));
+    println!("machine: {:?}", std::env::consts::ARCH);
+}
