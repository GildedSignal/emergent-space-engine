+/// The significant bits of one integer of a binding's remainder: what stating it costs a
+/// distinguisher that already knows the tube it was measured against (magnitude bits and a sign;
+/// zero is free — it is the fitted body's own case).
+fn int_bits(v: i128) -> u64 {
+    if v == 0 {
+        0
+    } else {
+        (128 - v.unsigned_abs().leading_zeros() + 1) as u64
+    }
+}
+
+/// The live distinguishing information (docs/plane.md, "Distinctions created per game-second"):
+/// what the generators cannot re-derive. A body on its compiled tube holds none; the bits are the
+/// binding's remainder — what the last fit discarded, live until the next rebinding reabsorbs it —
+/// and the player's decision words, which no law derives. Read-only: sampling it moves no state.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct LiveBits {
+    /// Remainder bits held by live bodies (the four integers of each residual, significant bits).
+    pub residual: u64,
+    /// Live bodies holding a nonzero remainder.
+    pub carried: usize,
+    /// Decision words in the input log, eight bits each.
+    pub decisions: u64,
+}
+impl LiveBits {
+    pub fn bits(&self) -> u64 {
+        self.residual + self.decisions
+    }
+}
