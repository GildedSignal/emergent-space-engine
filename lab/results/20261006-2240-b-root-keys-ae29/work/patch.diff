+    /// The root image of a doll event (docs/law.md, "Handoffs are Lorentz" and "Ties"): the doll's
+    /// tick plus the doll chain's simultaneity shears, in ticks of the root clock. At each edge, from
+    /// the event's doll up to the root, the event's position `x` (in the child's units) becomes the
+    /// parent's, the centre's velocity `w` at `t` — read from its committed tube — makes the
+    /// [`Frame`](crate::lorentz::Frame), and its time shear is `sinh(η)·x̂_axis`: `γ·(w·x)`, the
+    /// relativity of simultaneity the plane builder found at the spheres' edges (15–1,400 ticks).
+    /// The clock's own rate is not touched: a doll's tick is the parent's convention at its centre
+    /// (world.rs), so the centre's own events keep their ticks, a centre at rest leaves every tick
+    /// where it was, and a slow doll's image is its tick to within the shear. The position is carried
+    /// up the chain by the centre's position at `t` (Galilean: the boost's spatial part is `O(β²)`,
+    /// below a tick at every speed a game doll moves at the depths the game has; a deeper chain
+    /// composes the time shears exactly). The root doll's events are their own image: no work.
+    pub fn root_offset(&self, doll: u16, t: Tick, x: V2) -> Res<Tick> {
+        /// Fractional tick bits the chain's shears are accumulated at; one rounding at the end.
+        const BITS: i32 = 64;
+        let mut off = 0i128; // ticks at `2^-BITS`
+        let mut x = x;
+        let mut d = doll;
+        while let Some(p) = self.dolls[d as usize].parent {
+            let (child, parent) = (&self.dolls[d as usize], &self.dolls[p as usize]);
+            let centre = child.centre.expect("a child doll has a centre");
+            let k = pow2(parent.shift as i32 - child.shift as i32); // child units → parent units
+            let Ok((cp, w)) = self.state_of(centre, t) else { break };
+            if let Some(frame) = crate::lorentz::Frame::of(w)? {
+                let xp = scale2(x, k)?;
+                let word = |v: Scalar| -> Res<i128> { Ok(v.fixed(BITS)?) };
+                // The shear, in the parent's time units at `2^-BITS`; a parent time unit is
+                // `2^-parent.shift` ticks (one tick is `2^parent.shift` of them).
+                let shear = frame.shear_time([word(xp[0])?, word(xp[1])?])?;
+                let shift = parent.shift as u32;
+                off = off
+                    .checked_add(if shift >= 127 { shear } else { shear >> shift })
+                    .ok_or(crate::num::Error::Refused("the root image left the word"))?;
+                x = xp;
+            } else {
+                x = scale2(x, k)?;
+            }
+            x = add2(x, cp)?;
+            d = p;
+        }
+        let half = 1i128 << 63;
+        let rounded = if off >= 0 { (off + half) >> 64 } else { -((-off + half) >> 64) };
+        i64::try_from(rounded).map_err(|_| crate::num::Error::Refused("the root image left the tick word"))
+    }
 }
