+/// Print-only fit-key census (env `FIT_CENSUS=1`): the sharing of `from_state`'s compile
+/// keys on flown inputs, at three levels — the exact `ShapeKey`, the 44-bit `MemoCode`,
+/// and the memo's actual shape-class key (`MemoCode::shape_bits`: 17 bits on the weak
+/// branch). Counts only; it never touches a decision, a value or the digest.
+mod fit_census {
+    use crate::orbit::{MemoCode, OrbitKey, ShapeKey};
+    use std::cell::RefCell;
+    use std::collections::HashMap;
 
+    #[derive(Default)]
+    struct State {
+        cycles: u64,
+        passages: u64,
+        quant_err: u64,
+        exact: HashMap<ShapeKey, u32>,
+        quant: HashMap<u64, u32>,
+        shape: HashMap<u64, u32>,
+    }
+    thread_local! {
+        static GUARD: Print = Print;
+        static STATE: RefCell<State> = RefCell::new(State::default());
+    }
+
+    pub fn on() -> bool {
+        static ON: std::sync::LazyLock<bool> =
+            std::sync::LazyLock::new(|| std::env::var_os("FIT_CENSUS").is_some());
+        *ON
+    }
+
+    struct Print;
+    impl Drop for Print {
+        fn drop(&mut self) {
+            let _ = STATE.try_with(|s| {
+                let s = s.borrow();
+                let hit = |d: usize| 1.0 - d as f64 / s.cycles.max(1) as f64;
+                eprintln!(
+                    "FITCENSUS end cycles={} passages={} quant_err={} distinct exact={} (hit {:.4}) quant={} (hit {:.4}) shape={} (hit {:.4}) shape_bytes={}",
+                    s.cycles, s.passages, s.quant_err,
+                    s.exact.len(), hit(s.exact.len()),
+                    s.quant.len(), hit(s.quant.len()),
+                    s.shape.len(), hit(s.shape.len()),
+                    std::mem::size_of::<crate::orbit::OrbitShape>(),
+                );
+                let mut top: Vec<u32> = s.shape.values().copied().collect();
+                top.sort_unstable_by(|a, b| b.cmp(a));
+                top.truncate(10);
+                eprintln!("FITCENSUS shape top10 multiplicities {top:?}");
+            });
+        }
+    }
+
+    pub fn record(key: OrbitKey) {
+        let _ = GUARD.try_with(|_| {});
+        let _ = STATE.try_with(|s| {
+            let mut s = s.borrow_mut();
+            if !key.periodic() {
+                s.passages += 1;
+                return;
+            }
+            s.cycles += 1;
+            if let Ok(sk) = ShapeKey::for_orbit(key) {
+                *s.exact.entry(sk).or_default() += 1;
+            }
+            match MemoCode::encode(key) {
+                Ok(code) => {
+                    *s.quant.entry(code.bits()).or_default() += 1;
+                    if let Ok(sb) = code.shape_bits() {
+                        *s.shape.entry(sb).or_default() += 1;
+                    }
+                }
+                Err(_) => s.quant_err += 1,
+            }
+            if s.cycles.is_power_of_two() || s.cycles % 32768 == 0 {
+                eprintln!(
+                    "FITCENSUS at {} cycles: distinct exact={} quant={} shape={}",
+                    s.cycles, s.exact.len(), s.quant.len(), s.shape.len()
+                );
+            }
+        });
+    }
+
+    /// Totals on this thread, for the instrumented example to print at its own end.
+    pub fn totals() -> Option<(u64, u64, u64, usize, usize, usize)> {
+        STATE.try_with(|s| {
+            let s = s.borrow();
+            (s.cycles, s.passages, s.quant_err, s.exact.len(), s.quant.len(), s.shape.len())
+        })
+        .ok()
+    }
+}
