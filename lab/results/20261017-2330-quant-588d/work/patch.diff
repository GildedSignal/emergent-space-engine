+/// Linux stand-in: resident bytes now and the high-water mark from /proc (no compressed pages on this box).
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    for line in status.lines() {
+        let kb = || line.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()).map(|v| v * 1024);
+        if line.starts_with("VmRSS:") {
+            now = kb().unwrap_or(0);
+        } else if line.starts_with("VmHWM:") {
+            peak = kb().unwrap_or(0);
+        }
+    }
+    (now, peak)
+}
