+/// Linux stand-in: resident set now and its high-water mark (the lab's GitHub machines; disclosed in every run that uses it).
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let read = |f: &str| -> u64 {
+        std::fs::read_to_string("/proc/self/status")
+            .ok()
+            .and_then(|s| {
+                s.lines()
+                    .find(|l| l.starts_with(f))
+                    .and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+            })
+            .unwrap_or(0)
+            .saturating_mul(1024)
+    };
+    (read("VmRSS:"), read("VmHWM:"))
+}
