+        exact_keys.len(),
+        shape_keys.len(),
+        hist.len(),
+        hits as f64 / keys.len().max(1) as f64,
+        nonperiodic
+    );
+    // Exact ShapeMemo reproduction anchor (588d): repeats ~ 0.
+    let mut sm = ShapeMemo::default();
+    for k in keys.iter().take(keys.len()) {
+        let _ = sm.get(*k);
+    }
+    println!("census exact_shapememo_hits={} of {} (expect ~0)", sm.hits, keys.len());
+
+    // ---- class representative shapes (first-seen key per class) ----
+    let mut rep_shape: HashMap<u64, Arc<emergent_space::orbit::OrbitShape>> = HashMap::new();
+    for (k, b) in keys.iter().zip(&class_of) {
+        if *b != u64::MAX && !rep_shape.contains_key(b) {
+            if let Ok(s) = probe_bound(*k) {
+                rep_shape.insert(*b, s);
+            }
+        }
+    }
+    println!("census rep_shapes_built={}", rep_shape.len());
+
