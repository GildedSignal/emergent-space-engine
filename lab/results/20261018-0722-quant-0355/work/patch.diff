+    let (mut dp_w, mut dtau_w, mut dadv_w) = (Vec::new(), Vec::new(), Vec::new());
+    let mut pred = Vec::new();
+    let mut c_ok = 0usize;
+    let mut c_err = 0usize;
+    let mut wrong_bits: Vec<u64> = Vec::new();
+    for (k, b) in keys.iter().zip(&class_of) {
+        let a = Orbit::compile(*k).unwrap();
+        let ia = inc(&a);
+        if *b != u64::MAX {
+            if let Some(s) = rep_shape.get(b) {
+                match Orbit::probe_from_shape(*k, s.clone()) {
+                    Ok(c) => {
+                        let ic = inc(&c);
+                        dp_c.push((ic.period - ia.period).abs() / ia.period);
+                        dtau_c.push((ic.tau - ia.tau).abs() / ia.tau);
+                        dadv_c.push((ic.advance - ia.advance).abs() / (ia.advance.abs() + 1e-300));
