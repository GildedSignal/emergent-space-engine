+    /// Capture the exact key stream (32 B/key: k, k_exp, peri sig/exp, null, gap) for offline
+    /// bench replay. Enabled only by ES_KEYCAP=<path>; writes never touch computation.
+    fn capture(key: OrbitKey) {
+        use std::io::Write;
+        thread_local! {
+            static CAP: std::cell::RefCell<Option<Option<std::fs::File>>> =
+                std::cell::RefCell::new(None);
+        }
+        CAP.with_borrow_mut(|slot| {
+            if slot.is_none() {
+                *slot = Some(std::env::var("ES_KEYCAP").ok().and_then(|p| {
+                    std::fs::OpenOptions::new().create(true).append(true).open(p).ok()
+                }));
+            }
+            if let Some(f) = slot.as_mut().and_then(|o| o.as_mut()) {
+                let mut b = [0u8; 32];
+                b[0..8].copy_from_slice(&key.k.to_le_bytes());
+                b[8..10].copy_from_slice(&key.k_exponent.to_le_bytes());
+                b[10..18].copy_from_slice(&key.periapsis.significand().to_le_bytes());
+                b[18..20].copy_from_slice(&key.periapsis.exponent().to_le_bytes());
+                b[20] = key.null as u8;
+                if let Some(g) = key.gap {
+                    b[21] = 1;
+                    b[22..30].copy_from_slice(&g.significand().to_le_bytes());
+                    b[30..32].copy_from_slice(&g.exponent().to_le_bytes());
+                }
+                let _ = f.write_all(&b);
+            }
+        });
+    }
