+    let mut t_bound = vec![0f64; rounds];
+    let mut t_hit_c = vec![0f64; rounds];
+    let mut t_hit_b = vec![0f64; rounds];
+    PROBE_RELAXED.store(true, std::sync::atomic::Ordering::Relaxed);
+    let mut sink = 0u64;
+    for r in 0..rounds {
+        let t0 = Instant::now();
+        for k in &keys {
+            if let Ok(o) = Orbit::compile(*k) {
+                sink += o.period().unwrap().significand() as u64;
+            }
+        }
+        t_compile[r] = t0.elapsed().as_secs_f64() / keys.len() as f64 * 1e9;
+        let t0 = Instant::now();
+        for (k, b) in keys.iter().zip(&class_of) {
+            if let Some(s) = rep_shape.get(b) {
+                if let Ok(o) = Orbit::probe_from_shape(*k, s.clone()) {
+                    sink += o.period().unwrap().significand() as u64;
+                }
+            }
+        }
+        t_hit_c[r] = t0.elapsed().as_secs_f64() / keys.len() as f64 * 1e9;
+        let t0 = Instant::now();
+        for k in &keys {
+            if let Ok(o) = qm.get(*k) {
+                sink += o.period().unwrap().significand() as u64;
+            }
+        }
+        t_hit_b[r] = t0.elapsed().as_secs_f64() / keys.len() as f64 * 1e9;
+        let t0 = Instant::now();
+        for k in &keys {
+            if let Ok(s) = probe_bound(*k) {
