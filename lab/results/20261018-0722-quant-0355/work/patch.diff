+                        let krf = scalar_f64(kr.shape().unwrap());
+                        let kk = (kf + krf) / 2.0;
+                        let sens = 3.0 * kk / (2.0 * kk - 1.0);
+                        pred.push(sens * (kf - krf).abs() / kf);
+                        c_ok += 1;
+                    }
+                    Err(_) => c_err += 1,
+                }
+            }
+            if let Some(s) = wrong_for(b, &rep_shape) {
+                if let Ok(w) = Orbit::probe_from_shape(*k, s.clone()) {
+                    let iw = inc(&w);
+                    dp_w.push((iw.period - ia.period).abs() / ia.period);
+                    dtau_w.push((iw.tau - ia.tau).abs() / ia.tau);
+                    dadv_w.push((iw.advance - ia.advance).abs() / (ia.advance.abs() + 1e-300));
+                }
+            }
+        }
+        if let Ok(q) = qm.get(*k) {
+            let ib = inc(&q);
+            dp_b.push((ib.period - ia.period).abs() / ia.period);
+            dtau_b.push((ib.tau - ia.tau).abs() / ia.tau);
+            dadv_b.push((ib.advance - ia.advance).abs() / (ia.advance.abs() + 1e-300));
+        }
+    }
+    PROBE_RELAXED.store(false, std::sync::atomic::Ordering::Relaxed);
+    wrong_bits = vec![]; // silence
+    let _ = wrong_bits;
+    println!(
+        "exactness C(exact key+class shape) n={} errs={} period p50={:.3e} p99={:.3e} max={:.3e} tau p50={:.3e} adv p50={:.3e} med/pred={:.2}",
+        c_ok,
+        c_err,
+        pct(dp_c.clone(), 0.5),
+        pct(dp_c.clone(), 0.99),
+        dp_c.iter().cloned().fold(0./0., f64::max),
+        pct(dtau_c.clone(), 0.5),
+        pct(dadv_c.clone(), 0.5),
+        pct(dp_c.clone(), 0.5) / pct(pred.clone(), 0.5)
+    );
+    println!(
+        "exactness B(quantized key, shipped arm) n={} period p50={:.3e} p99={:.3e} tau p50={:.3e} adv p50={:.3e}",
+        dp_b.len(),
+        pct(dp_b.clone(), 0.5),
+        pct(dp_b.clone(), 0.99),
+        pct(dtau_b.clone(), 0.5),
+        pct(dadv_b.clone(), 0.5)
+    );
+    if !dp_w.is_empty() {
+        println!(
+            "exactness NEGATIVE(wrong-class shape) n={} period p50={:.3e} max={:.3e} tau p50={:.3e}",
+            dp_w.len(),
+            pct(dp_w.clone(), 0.5),
+            dp_w.iter().cloned().fold(0./0., f64::max),
+            pct(dtau_w.clone(), 0.5)
+        );
+    }
+    println!(
+        "exactness pred(class k-quantum x 3k/(2k-1)) p50={:.3e} p99={:.3e}",
+        pct(pred.clone(), 0.5),
+        pct(pred.clone(), 0.99)
+    );
+}
