+/// The state of a jet-carried binding at `t` (lab run 20261011-1814): the frozen tube's readout plus
+/// the carried kicks — `dv` as a velocity step, `dx + dv·(t − anchor)` as the position ramp — folded
+/// back into the readout's own integer words. Exact integer arithmetic; the exponents are the frozen
+/// binding's, so the fold is a plain word add.
+pub fn jet_state(b: &Binding, jet: Option<JetCarry>, t: Tick) -> Res<IntegerState> {
+    let mut st = b.readout(t)?;
+    let Some(j) = jet else { return Ok(st) };
+    let dt = time_of(t.saturating_sub(j.anchor), b.clock_exp)?;
+    for c in 0..2 {
+        let dv = j.dv[c].fixed(-(st.velocity_exponent as i32))?;
+        let dx = j.dx[c].add(j.dv[c].mul(dt)?)?.fixed(-(st.length_exponent as i32))?;
+        st.velocity[c] = i64::try_from(st.velocity[c] as i128 + dv).map_err(|_| Error::Refused("jet outside the word"))?;
+        st.position[c] = i64::try_from(st.position[c] as i128 + dx).map_err(|_| Error::Refused("jet outside the word"))?;
+    }
+    Ok(st)
+}
 
