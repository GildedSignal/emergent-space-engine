+// The jet's trigger, honestly (lab run 20261011-1814, second author on 20261011-1729-system-2c68).
+//
+// The first probe's shadow recompiled by reading the shipped exact path — the one thing an
+// implementation cannot do. Here the jet is the crate's own kick path (`Config::jet_bound_log2`):
+// kicks are carried against the frozen binding, the rebind fires when the CARRIED OFFSET (the carry
+// itself, maintained anyway) crosses 2^θ of the body's distance, and each kick's acceleration is
+// read at the carried state, so the feedback is in. This probe drives one body's events against a
+// frozen universe (the old protocol) and measures against the shipped jet-off path on the same
+// frozen context: kicks per rebind, and the true error at every kick — the baseline read at the
+// JET's own tick through the shipped reader's convention (its binding's tube plus the pending
+// kick's ramp, `observe::credit`), so a desynchronized kick schedule is not read as error.
+// Floats are measurement only; the law's decisions are the crate's own integers.
+use emergent_space::orbit::Scalar;
+use emergent_universe::bind::Binding;
+use emergent_universe::body::What;
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::step::{self, Resolved};
+use emergent_universe::Config;
+
+fn to_f(x: Scalar) -> f64 {
+    emergent_universe::num::to_f64(x)
+}
+
+struct Driven {
+    refused: u64,
+    series: Vec<(i64, [f64; 2], f64)>, // (tick, x, r) of the true state at each resolved kick
+    bindings: Vec<Binding>,            // the binding each kick left (the baseline's reader path)
+    ticks: Vec<i64>,
+    intervals: Vec<usize>,             // resolved kicks per rebind (rebinds close intervals)
+    offsets: Vec<f64>,                 // the carry's position offset at each kick, doll units
+}
+
+/// Drive `id`'s events for `n` resolved kicks (jet per `cfg`), against a frozen universe.
+fn drive(ctx: &emergent_universe::ctx::Ctx, mut rec: emergent_universe::body::BodyRec, id: usize, n: usize) -> Driven {
+    let mut d = Driven { refused: 0, series: Vec::new(), bindings: Vec::new(), ticks: Vec::new(), intervals: Vec::new(), offsets: Vec::new() };
+    let mut since = 0usize;
+    while d.series.len() < n {
+        let Some(it) = rec.plan.first().copied() else { break };
+        let is_kick = matches!(it.what, What::Kick(_));
+        let t = it.t;
+        let u = step::process(&ctx, id, rec.clone());
+        let rebound = !u.retired.is_empty();
+        rec = u.rec;
+        if !rec.alive {
+            break;
+        }
+        if matches!(u.kind, Resolved::Refused) {
+            d.refused += 1;
+        }
+        let resolved_kick = is_kick && matches!(u.kind, Resolved::Kick);
+        if resolved_kick {
+            since += 1;
+        }
+        if rebound {
+            d.intervals.push(since);
+            since = 0;
+        }
+        if !resolved_kick {
+            continue;
+        }
+        let st = step::jet_state(&rec.b, rec.jet, t).unwrap();
+        let (x, _) = emergent_universe::bind::scalars(&st).unwrap();
+        let (xf, r) = (to_f(x[0]), to_f(x[0]) * to_f(x[0]) + to_f(x[1]) * to_f(x[1]));
+        d.series.push((t, [xf, to_f(x[1])], r.sqrt()));
+        d.bindings.push(rec.b.clone());
+        d.ticks.push(t);
+        let off = rec
+            .jet
+            .map(|j| {
+                let dt = to_f(emergent_universe::num::time_of(t.saturating_sub(j.anchor), rec.b.clock_exp).unwrap());
+                let (a, b) = (to_f(j.dx[0]) + to_f(j.dv[0]) * dt, to_f(j.dx[1]) + to_f(j.dv[1]) * dt);
+                (a * a + b * b).sqrt()
+            })
+            .unwrap_or(0.0);
+        d.offsets.push(off);
+    }
+    if since > 0 {
+        d.intervals.push(since);
+    }
+    d
+}
+
+/// The baseline's state at tick `t`, the way the shipped reader completes it between kicks: the
+/// binding's tube plus the pending kick's ramp (`observe::credit`), other bodies from the context.
+fn baseline_at(ctx: &emergent_universe::ctx::Ctx, id: usize, base: &Driven, t: i64) -> Option<[f64; 2]> {
+    // the last baseline kick at or before t (its binding holds from its tick to the next)
+    let mut j = base.bindings.len();
+    while j > 0 && base.ticks[j - 1] > t {
+        j -= 1;
+    }
+    if j == 0 {
+        return None;
+    }
+    let b = &base.bindings[j - 1];
+    let (p, _) = b.cartesian(t).ok()?;
+    let (dx, _) = emergent_universe::observe::credit(ctx.bodies, id, t, b).ok()?;
+    Some([to_f(p[0]) + to_f(dx[0]), to_f(p[1]) + to_f(dx[1])])
+}
+
+fn run(name: &str, id_of: &dyn Fn(&emergent_universe::scenario::Plane) -> usize, theta_log2: i32, n: usize, seed: u64) {
+    let base_cfg = Config { jet_bound_log2: 0, ..Config::default() };
+    let jet_cfg = Config { jet_bound_log2: theta_log2, ..Config::default() };
+    let mut p0 = plane(base_cfg, seed, Order::Sparse, 1, 8).unwrap();
+    let id = id_of(&p0);
+    let ctx0 = p0.u.ctx();
+    let base = drive(&ctx0, p0.u.rec(id), id, n);
+    let mut p1 = plane(jet_cfg, seed, Order::Sparse, 1, 8).unwrap();
+    let ctx1 = p1.u.ctx();
+    let jet = drive(&ctx1, p1.u.rec(id), id, n);
+    let m = base.series.len().min(jet.series.len());
+    let debug = std::env::var_os("JET_DEBUG").is_some();
+    let mut max_err = 0.0f64;
+    let mut c_max = 0.0f64;
+    let mut cmp = 0usize;
+    for i in 0..m {
+        let t = jet.ticks[i];
+        let Some(xb) = baseline_at(&ctx0, id, &base, t) else { continue };
+        cmp += 1;
+        let e = ((jet.series[i].1[0] - xb[0]).powi(2) + (jet.series[i].1[1] - xb[1]).powi(2)).sqrt() / base.series[i].2;
+        if debug && i < 75 {
+            let per = match &jet.bindings[i].entry.trajectory { emergent_space::binding::Trajectory::Cycle(c) => c.period().unwrap(), emergent_space::binding::Trajectory::Passage(p) => p.duration().unwrap() };
+            let t_doll = to_f(jet.bindings[i].to_doll(per).unwrap());
+            let ratio = jet.offsets[i] * 1.0 / (jet.series[i].2 * t_doll) * (t as f64);
+            println!("  kick {i} t {t} err {e:.3e} offset_rel {:.3e} T_doll {t_doll:.3e} ratio {ratio:.3e}", jet.offsets[i] / base.series[i].2);
+        }
+        max_err = max_err.max(e);
+        if jet.offsets[i] > 0.0 {
+            c_max = c_max.max(e / (jet.offsets[i] / base.series[i].2).powi(2));
+        }
+    }
+    let refused = jet.refused;
+    let mut sorted = jet.intervals.clone();
+    sorted.sort_unstable();
+    let med = sorted.get(sorted.len() / 2).copied().unwrap_or(0);
+    let p10 = sorted.get(sorted.len() / 10).copied().unwrap_or(0);
+    println!(
+        "{name:<11} seed {seed} theta 2^{theta_log2}: kicks {m} rebinds {} median-interval {med} p10 {p10} max-rel-err {max_err:.2e} (over {cmp} kicks) C=err/offset^2 max {c_max:.2e} refusals {refused}",
+        jet.intervals.len()
+    );
+}
+
+fn main() {
+    let n: usize = std::env::args().nth(1).and_then(|v| v.parse().ok()).unwrap_or(3000);
+    let thetas: Vec<i32> = std::env::args().nth(2).map(|v| v.split(',').filter_map(|x| x.parse().ok()).collect()).unwrap_or_else(|| vec![-20]);
+    let seeds: Vec<u64> = std::env::args().nth(3).map(|v| v.split(',').filter_map(|x| x.parse().ok()).collect()).unwrap_or_else(|| vec![1]);
+    // The checker's corrected identities: ships[i] is body id i+4 (0-3 are Cinder/Home/Giant/Moon).
+    let cases: [(&str, Option<usize>); 4] = [("Orbiter 3", Some(14)), ("Hauler 2", Some(1)), ("Hauler 7", Some(6)), ("Home", None)];
+    for &seed in &seeds {
+        for &th in &thetas {
+            for (name, idx) in &cases {
+                match idx {
+                    Some(i) => run(name, &|p: &emergent_universe::scenario::Plane| p.ships[*i], th, n, seed),
+                    None => run(name, &|_| 1, th, n, seed),
+                }
+            }
+            println!();
+        }
+    }
+}
