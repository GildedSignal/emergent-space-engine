+// ==== lab probe 20261017-2038-components-3570: print-only census of boundary/kick events (env BOUND_PROBE).
+// No behaviour change: reads state the resolver already computed and writes one line per event.
+use std::sync::atomic::{AtomicU64, Ordering as AOrd};
+pub fn probe_on() -> bool {
+    static P: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("BOUND_PROBE").is_ok());
+    *P
+}
+pub static PROBE_EVENTS: AtomicU64 = AtomicU64::new(0);
+thread_local! {
+    static PROBE_NOTE: std::cell::Cell<[i64; 6]> = const { std::cell::Cell::new([99; 6]) };
+}
+/// ceil(log2(a/b)) as the smallest k with a <= b·2^k; 99 when undefined.
+fn p2_class(a: Scalar, b: Scalar) -> i64 {
+    if a.is_zero() || b.is_zero() {
+        return 99;
+    }
+    for k in -60i64..=60 {
+        if let Ok(s) = b.scale(k as i32) {
+            if a <= s {
+                return k;
+            }
+        }
+    }
+    99
+}
+fn traj_class(t: &Trajectory) -> i64 {
+    match t {
+        Trajectory::Cycle(_) => 0,
+        Trajectory::Passage(_) => 1,
+        Trajectory::Plunge(_) => 2,
+        _ => 3,
+    }
+}
+fn kind_class(k: Kind) -> i64 {
+    match k {
+        Kind::Ship => 0,
+        Kind::Player => 1,
+        Kind::Planet => 2,
+        Kind::Moon => 3,
+    }
+}
+fn probe_note(b: &Binding, kind: Kind, r: Scalar, surface: Scalar, edge: Scalar) {
+    PROBE_NOTE.with(|c| {
+        c.set([
+            p2_class(r, surface),
+            p2_class(r, edge),
+            traj_class(&b.entry.trajectory),
+            kind_class(kind),
+            b.doll as i64,
+            0,
+        ])
+    });
+}
 
