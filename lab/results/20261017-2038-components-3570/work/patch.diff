+// lab patch 20261017-2038-components-3570: the Linux port of the same reading (VmRSS and
+// VmHWM from /proc/self/status; the M1's compressed pages have no Linux counterpart).
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let text = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    for line in text.lines() {
+        if let Some(v) = line.strip_prefix("VmRSS:") {
+            now = v.trim().trim_end_matches(" kB").parse().unwrap_or(0) * 1024;
+        }
+        if let Some(v) = line.strip_prefix("VmHWM:") {
+            peak = v.trim().trim_end_matches(" kB").parse().unwrap_or(0) * 1024;
+        }
+    }
+    (now, peak)
+}
