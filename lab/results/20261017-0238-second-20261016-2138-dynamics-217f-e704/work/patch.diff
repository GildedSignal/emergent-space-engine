+/// ES_DECAY (lab run 20261016-2138-dynamics-217f): halve the global speed escalation at every
+/// sync grid, mirroring the rollback's doubling. ES_LOCAL (lab run
+/// 20261017-0238-second-20261016-2138-dynamics-217f-e704): the escalation becomes per region —
+/// a rollback doubles only the clashing lineages, the decay halves each region at the same
+/// grids. Both off (default) = shipped behaviour verbatim.
+fn decay_on() -> bool {
+    static D: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var("ES_DECAY").is_ok_and(|v| !v.is_empty() && v != "0"));
+    *D
+}
+
+fn local_on() -> bool {
+    static L: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var("ES_LOCAL").is_ok_and(|v| !v.is_empty() && v != "0"));
+    *L
+}
