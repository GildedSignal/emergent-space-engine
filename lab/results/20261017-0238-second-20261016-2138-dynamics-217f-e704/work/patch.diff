+//! The rollback ratchet's tax, priced where the player feels it (lab run
+//! 20261017-0238-second-20261016-2138-dynamics-217f-e704, the checker's named gold experiment).
+//! Scales the original run's Newtonian conflict battery (a Fermi cannon per cell aimed at a
+//! quiet cluster, staggered ignitions) to >= 10^4 bodies and many regions, then compares three
+//! controller arms — shipped (one-way global ratchet), ES_DECAY (global decay mirror),
+//! ES_LOCAL (per-region escalation) — in batch (staged `run_to`) and in the frame harness
+//! (`run_frames`), public API only. One RESULT line per run; the arm comes from the environment.
+//!
+//!     cargo run -p emergent-allocator --release --offline --example tax -- \
+//!         batch <cells> <per> <stagger> <stages> <step> <seed>
+//!         frames <cells> <per> <stagger> <seconds> <seed> <rate> <hz>
+use emergent_allocator::{scenes, Allocator, Config, Factory, FrameConfig, Report};
+use emergent_lattice::{chronon::Chronon, law::Law};
+use std::sync::Arc;
+
+/// The original run's `battery`, parameterised: `cells` cells 8000 units apart along x, each a
+/// Fermi cannon (light body between two m=16384 bouncers closing at q/32; cell i ignites at
+/// ~stagger·i chronons) plus a quiet `per`-body cluster at the cell centre. Clusters keep the
+/// original density (8 bodies per ±q box): the box half-width scales as sqrt(per/8)·q.
+fn battery(q: i64, cells: i64, per: u64, stagger: i64, law: Law) -> Vec<emergent_lattice::law::World> {
+    use emergent_lattice::law::{Body, Response, World};
+    let template = World::new(q, None, vec![]).expect("empty template");
+    let mk = |bodies: Vec<Body>| World { bodies, container: None, ..template.clone() };
+    let (vh, cell) = (q / 32, 8000);
+    let spread = (((per as f64) / 8.0).sqrt().ceil() as i64).max(1) * q;
+    let mut out = Vec::new();
+    let stride_id = per + 100;
+    for i in 0..cells {
+        let c = i * cell * q;
+        let d = 576 + vh * stagger * i;
+        out.push(mk(vec![
+            Body::new(1 + stride_id * i as u64, [c, 0], [0, 0], 1, q / 4, Response::Bounce),
+            Body::new(2 + stride_id * i as u64, [c - d, 0], [vh, 0], 1 << 14, 2 * q, Response::Bounce),
+            Body::new(3 + stride_id * i as u64, [c + d, 0], [-vh, 0], 1 << 14, 2 * q, Response::Bounce),
+        ]));
+        let mut rng = emergent_lattice::worlds::Rng(7 + 13 * i as u64);
+        let t: Vec<Body> = (0..per)
+            .map(|j| {
+                Body::new(
+                    100 + stride_id * i as u64 + j,
+                    [c + rng.range(-spread, spread), rng.range(-spread, spread)],
+                    [rng.range(-2, 2), rng.range(-2, 2)],
+                    1,
+                    q / 4,
+                    Response::Bounce,
+                )
+            })
+            .collect();
+        out.push(mk(t));
+    }
+    scenes::with_law(out, law)
+}
+
+fn arm() -> &'static str {
+    match (
+        std::env::var("ES_DECAY").is_ok_and(|v| !v.is_empty() && v != "0"),
+        std::env::var("ES_LOCAL").is_ok_and(|v| !v.is_empty() && v != "0"),
+    ) {
+        (false, false) => "shipped",
+        (true, false) => "decay",
+        (false, true) => "local",
+        _ => "both",
+    }
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let mode = a.first().cloned().unwrap_or_else(|| "batch".into());
+    let (cells, per, stagger): (i64, u64, i64) = (
+        a.get(1).and_then(|s| s.parse().ok()).unwrap_or(128),
+        a.get(2).and_then(|s| s.parse().ok()).unwrap_or(8),
+        a.get(3).and_then(|s| s.parse().ok()).unwrap_or(30),
+    );
+    let seed: u64 = a.get(6).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let q = 256;
+    let law = if std::env::var("TAX_LAW").is_ok_and(|v| v == "relativistic") { Law::Relativistic } else { Law::Newtonian };
+    let worlds = battery(q, cells, per, stagger, law);
+    let bodies: usize = worlds.iter().map(|w| w.bodies.len()).sum();
+    let cfg = Config {
+        speed_margin: std::env::var("TAX_MARGIN").ok().and_then(|v| v.parse().ok()).unwrap_or(2.0),
+        min_region: std::env::var("TAX_MIN_REGION").ok().and_then(|v| v.parse().ok()).unwrap_or(1),
+        observer: [0, 0],
+        view_radius: 0,
+        ..Config::default()
+    };
+    let factory: Factory<Chronon> = Arc::new(|w| Chronon::new(w, false).expect("valid region world"));
+    let workers = format!("{}+{}", cfg.p_workers, cfg.e_workers);
+    let mut alloc = Allocator::new(worlds, factory, cfg).expect("scene");
+    eprintln!(
+        "tax {mode} cells={cells} per={per} stagger={stagger} seed={seed}: {bodies} bodies, {} initial regions, arm={} workers {workers}",
+        alloc.regions(),
+        arm()
+    );
+    let stages = a.get(4).and_then(|s| s.parse().ok()).unwrap_or(10);
+    let step = a.get(5).and_then(|s| s.parse().ok()).unwrap_or(4000);
+    let stages_tsv = std::env::var("TAX_STAGES").is_ok_and(|v| !v.is_empty() && v != "0");
+    match mode.as_str() {
+        "batch" => {
+            if stages_tsv {
+                println!("stage\ttick\twall_ms\tregions\trollbacks\tescal\tescal_max\tmerges\tsplits\tavoided\twasted\tchr_per_s");
+            }
+            // run_to resets its counters each call: accumulate across stages for the summary.
+            let (mut rollbacks, mut rolled, mut wasted, mut merges, mut splits, mut avoided, mut promises) =
+                (0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
+            let (mut wall_ms, mut last) = (0u128, None);
+            for s in 1..=stages {
+                let target = (s as i64) * step;
+                let t0 = std::time::Instant::now();
+                let r: Report = alloc.run_to(target);
+                let w = t0.elapsed().as_millis();
+                wall_ms += w;
+                let reg = &r.regions;
+                rollbacks += reg.rollbacks;
+                rolled += reg.rolled_back_regions;
+                wasted += reg.wasted_ops;
+                merges += reg.merges;
+                splits += reg.splits;
+                avoided += reg.merges_avoided;
+                promises += reg.promises_exceeded;
+                if stages_tsv {
+                    println!(
+                        "{s}\t{target}\t{w}\t{}\t{rollbacks}\t{:.1}\t{:.1}\t{merges}\t{splits}\t{avoided}\t{wasted}\t{:.0}",
+                        alloc.regions(),
+                        reg.speed_escalation,
+                        reg.speed_escalation_max,
+                        r.sim.region_chronons_per_wall_second
+                    );
+                }
+                last = Some(r);
+            }
+            let r = last.expect("at least one stage");
+            let chronons = stages as u128 * step as u128;
+            let (d1, d2) = alloc.outcome();
+            println!(
+                "RESULT mode=batch arm={} cells={} per={} stagger={} seed={} bodies={} stages={} horizon={} wall_ms={} rollbacks={} rolled_reg={} wasted={} merges={} splits={} avoided={} promises={} escal={:.1} escal_max={:.1} regions={} chr_per_s={:.0} digest={} {}",
+                arm(),
+                cells,
+                per,
+                stagger,
+                seed,
+                bodies,
+                stages,
+                stages * step,
+                wall_ms,
+                rollbacks,
+                rolled,
+                wasted,
+                merges,
+                splits,
+                avoided,
+                promises,
+                r.regions.speed_escalation,
+                r.regions.speed_escalation_max,
+                alloc.regions(),
+                chronons as f64 / (wall_ms.max(1) as f64 / 1e3),
+                d1,
+                d2
+            );
+        }
+        "frames" => {
+            let seconds: f64 = a.get(5).and_then(|s| s.parse().ok()).unwrap_or(3.0);
+            let rate: f64 = a.get(7).and_then(|s| s.parse().ok()).unwrap_or(2000.0);
+            let hz: f64 = a.get(8).and_then(|s| s.parse().ok()).unwrap_or(60.0);
+            let r = alloc.run_frames(&FrameConfig { hz, seconds, rate, ahead_seconds: 0.25, record: false });
+            let f = r.frames.as_ref().expect("frames report");
+            println!(
+                "RESULT mode=frames arm={} cells={} per={} stagger={} seed={} bodies={} hz={} rate={} seconds={} frames={} deadline_misses={} small_misses={} accel_drops={} present_per_s={:.1} buffer_p50={:.1} buffer_p99={:.1} frontier={} rollbacks={} wasted={} merges={} avoided={} escal={:.1} escal_max={:.1} regions={}",
+                arm(),
+                cells,
+                per,
+                stagger,
+                seed,
+                bodies,
+                hz,
+                rate,
+                seconds,
+                f.frames,
+                f.deadline_misses,
+                f.small_deadline_misses,
+                f.acceleration_drops,
+                r.sim.present_chronons_per_wall_second,
+                f.buffer_chronons.p50,
+                f.buffer_chronons.p99,
+                r.finality.frontier,
+                r.regions.rollbacks,
+                r.regions.wasted_ops,
+                r.regions.merges,
+                r.regions.merges_avoided,
+                r.regions.speed_escalation,
+                r.regions.speed_escalation_max,
+                alloc.regions()
+            );
+        }
+        other => panic!("unknown mode {other}"),
+    }
+}
