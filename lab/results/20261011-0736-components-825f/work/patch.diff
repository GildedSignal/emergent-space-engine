+// ---- the allocator's trace (measurement only: it changes when work happens, never what) ----
+
+/// One resolved item of a frame's advance.
+#[derive(Clone, Copy, Debug)]
+pub struct ItemTrace {
+    pub entity: usize,
+    /// `B` a body's item, `H` a hand-out made a body, `F` a fleet's battle slice.
+    pub kind: char,
+    pub tick: Tick,
+    pub deadline: Tick,
+    pub cost_ns: u64,
+}
+
+/// One call to [`Universe::advance`]: a frame's engine work, item by item.
+#[derive(Clone, Debug, Default)]
+pub struct AdvanceTrace {
+    pub target: Tick,
+    pub now0: Tick,
+    /// The deadline recompute (`rekey`): O(entities) per frame, the allocator's own bookkeeping.
+    pub rekey_ns: u64,
+    pub wall_ns: u64,
+    pub events: u64,
+    pub overflow: bool,
+    pub items: Vec<ItemTrace>,
+}
+
+fn alloc_trace_on() -> bool {
+    static ON: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var("ES_ALLOC_TRACE").is_ok_and(|v| !v.is_empty()));
+    *ON
+}
+
+static ALLOC_TRACE: std::sync::Mutex<Vec<AdvanceTrace>> = std::sync::Mutex::new(Vec::new());
+
+/// Take the accumulated advance traces (empty when tracing is off). The frames' own calls only;
+/// a later `settle` (a digest at a canonical cut) accumulates and is dropped.
+pub fn take_alloc_trace() -> Vec<AdvanceTrace> {
+    std::mem::take(&mut *ALLOC_TRACE.lock().unwrap())
+}
