--- /dev/null
+++ b/crates/universe/src/isearch.rs
@@ -0,0 +1,179 @@
+//! The crash-tick search's instrument: per-search readout counts, bracket widths, and the
+//! crossing's displacement from the retired tube's tick (the hint) — the return map of the kick
+//! stream that decides which warm start wins. Pure bookkeeping: thread-local ping counts and
+//! atomics, no engine state touched, so it never moves a digest and every arm pays it alike.
+//! An errored search (`?` propagation) leaves its pings unrecorded; refusals are rare and the
+//! histogram is an instrument, not a certificate.
+
+use crate::num::Tick;
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+pub const BINS: usize = 64;
+
+/// The bin of `v`: bin 0 holds exactly 0, bin k (k ≥ 1) holds [2^(k-1), 2^k).
+#[inline]
+pub fn lbin(v: u64) -> usize {
+    if v == 0 { 0 } else { ((u64::BITS - v.leading_zeros()) as usize).min(BINS - 1) }
+}
+thread_local! {
+    static PINGS: Cell<u32> = const { Cell::new(0) };
+}
+
+/// One `inside` predicate evaluation: exactly the readouts a search spends.
+#[inline(always)]
+pub fn ping() {
+    PINGS.with(|p| p.set(p.get().wrapping_add(1)));
+}
+
+#[inline]
+fn take_pings() -> u32 {
+    PINGS.with(|p| p.replace(0))
+}
+
+/// The warm-start strategy this process runs: 0 the shipped cold bisection, 1 the guess
+/// (20261014-1010-quant-036c: settle in two readouts or narrow one step), 2 the gallop
+/// (20261014-1010-second-…-0b85: one side reading, doubling steps to the sign change).
+/// Env `ES_WSTRAT`, read once; unset is the shipped search verbatim.
+pub fn strategy() -> u8 {
+    use std::sync::LazyLock;
+    static S: LazyLock<u8> = LazyLock::new(|| match std::env::var("ES_WSTRAT").as_deref() {
+        Ok("guess") => 1,
+        Ok("gallop") => 2,
+        _ => 0,
+    });
+    *S
+}
+
+pub struct Stat {
+    /// `next_impact` entries from every caller (view included).
+    pub calls: AtomicU64,
+    /// Entries from the plan site (`plan_terminal`: kicks and hand-outs), the recorded population.
+    pub site: AtomicU64,
+    /// Site entries carrying the retired tube's crash tick.
+    pub hinted: AtomicU64,
+    /// Exits before any bracket (a plunge's terminal tick; already inside at `after`).
+    pub early: AtomicU64,
+    /// `Ok(None)` returns (no crossing).
+    pub none: AtomicU64,
+    /// Searches that ran a bracket.
+    pub searched: AtomicU64,
+    /// Guess-strategy two-readout settles (the crossing did not move: displacement 0).
+    pub settled: AtomicU64,
+    /// Gallop-strategy bracket-edge hits (the cold width was paid after all).
+    pub fallback: AtomicU64,
+    /// Readouts per searched call.
+    pub readouts: [AtomicU64; BINS],
+    pub readout_sum: AtomicU64,
+    /// |found − hint| per hinted, searched call.
+    pub displ: [AtomicU64; BINS],
+    pub displ_sum: AtomicU64,
+    /// The cold bracket's width hi − lo per searched call.
+    pub width: [AtomicU64; BINS],
+}
+
+pub static STAT: Stat = Stat {
+    calls: AtomicU64::new(0),
+    site: AtomicU64::new(0),
+    hinted: AtomicU64::new(0),
+    early: AtomicU64::new(0),
+    none: AtomicU64::new(0),
+    searched: AtomicU64::new(0),
+    settled: AtomicU64::new(0),
+    fallback: AtomicU64::new(0),
+    readouts: [const { AtomicU64::new(0) }; BINS],
+    readout_sum: AtomicU64::new(0),
+    displ: [const { AtomicU64::new(0) }; BINS],
+    displ_sum: AtomicU64::new(0),
+    width: [const { AtomicU64::new(0) }; BINS],
+};
+
+/// An exit before the bracket: nothing to histogram, pings still consumed.
+pub fn note_early(site: bool) {
+    take_pings();
+    if site {
+        STAT.early.fetch_add(1, Relaxed);
+    }
+}
+
+/// A `None` exit.
+pub fn note_none(site: bool) {
+    take_pings();
+    if site {
+        STAT.none.fetch_add(1, Relaxed);
+    }
+}
+
+/// A bracket search began: its cold width, before any strategy ran.
+pub fn mark_search(site: bool, width: u64) {
+    if !site {
+        return;
+    }
+    STAT.searched.fetch_add(1, Relaxed);
+    STAT.width[lbin(width)].fetch_add(1, Relaxed);
+}
+
+/// A bracket search ended: its readouts (consumed), the crossing's displacement from the hint,
+/// and the strategy outcomes (a two-readout settle; a gallop that reached the bracket's edge).
+pub fn end_search(site: bool, hint: Option<Tick>, found: Option<Tick>, settled: bool, fallback: bool) {
+    let p = take_pings() as u64;
+    if !site {
+        return;
+    }
+    STAT.readouts[lbin(p)].fetch_add(1, Relaxed);
+    STAT.readout_sum.fetch_add(p, Relaxed);
+    if settled {
+        STAT.settled.fetch_add(1, Relaxed);
+    }
+    if fallback {
+        STAT.fallback.fetch_add(1, Relaxed);
+    }
+    if let (Some(h), Some(f)) = (hint, found) {
+        let d = (f - h).unsigned_abs();
+        STAT.displ[lbin(d)].fetch_add(1, Relaxed);
+        STAT.displ_sum.fetch_add(d, Relaxed);
+    }
+}
+/// A plain read-and-reset snapshot for the bench to print.
+pub struct Snap {
+    pub strategy: u8,
+    pub calls: u64,
+    pub site: u64,
+    pub hinted: u64,
+    pub early: u64,
+    pub none: u64,
+    pub searched: u64,
+    pub settled: u64,
+    pub fallback: u64,
+    pub readouts: [u64; BINS],
+    pub readout_sum: u64,
+    pub displ: [u64; BINS],
+    pub displ_sum: u64,
+    pub width: [u64; BINS],
+}
+
+pub fn take() -> Snap {
+    fn arr(a: &[AtomicU64; BINS]) -> [u64; BINS] {
+        let mut o = [0; BINS];
+        for (o, a) in o.iter_mut().zip(a) {
+            *o = a.swap(0, Relaxed);
+        }
+        o
+    }
+    Snap {
+        strategy: strategy(),
+        calls: STAT.calls.swap(0, Relaxed),
+        site: STAT.site.swap(0, Relaxed),
+        hinted: STAT.hinted.swap(0, Relaxed),
+        early: STAT.early.swap(0, Relaxed),
+        none: STAT.none.swap(0, Relaxed),
+        searched: STAT.searched.swap(0, Relaxed),
+        settled: STAT.settled.swap(0, Relaxed),
+        fallback: STAT.fallback.swap(0, Relaxed),
+        readouts: arr(&STAT.readouts),
+        readout_sum: STAT.readout_sum.swap(0, Relaxed),
+        displ: arr(&STAT.displ),
+        displ_sum: STAT.displ_sum.swap(0, Relaxed),
+        width: arr(&STAT.width),
+    }
+}
