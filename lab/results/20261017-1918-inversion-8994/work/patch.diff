diff --git a/crates/universe/examples/wave.rs b/crates/universe/examples/wave.rs
new file mode 100644
index 00000000..b4f70f2c
--- /dev/null
+++ b/crates/universe/examples/wave.rs
@@ -0,0 +1,145 @@
+//! The first belt comb: the ladder population flown PAST its first wave of items, budget-free.
+//! The N-ladder's gate (N1) flies 20 s of page time at rtf 100 = 2,000 game-s; the belt's bodies are
+//! all born at tick 0 with one Δs, so their first items arrive as one wave near h = interval/2
+//! (p50 ≈ 14,071 game-s, `belt_first`) — 7× past the gate's window. This probe drains every frame
+//! with no engine budget (`Budget::unlimited`), so each frame's wall is the true work the shipped
+//! 12-ms letter would have to amortize; the letter's test is the worst rolling 60-frame (one wall
+//! second) mean engine-ms: above 12 ms the budgeted engine falls behind without bound.
+//!
+//! cargo run --release -p emergent-universe --example wave [-- <N> [<horizon_game_s> [<rtf>]]]
+
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn hwm_kb() -> u64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines()
+                .find(|l| l.starts_with("VmHWM:"))
+                .and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse().ok()))
+        })
+        .unwrap_or(0)
+}
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    if sorted.is_empty() {
+        return 0.0;
+    }
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let horizon_s: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(45000.0);
+    let rtf: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(0.0);
+    let frames = (horizon_s * 60.0 / rtf) as usize;
+    let guard_s = 300.0;
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let bodies = p.u.n_bodies();
+    println!(
+        "wave: n={n} ({bodies} bodies) coast budget-free rtf {rtf} horizon {horizon_s:.0} game-s = {frames} frames; build {build:.2} s, VmHWM {:.0} MB",
+        hwm_kb() as f64 / 1024.0
+    );
+    let mut rows: Vec<(usize, f64, u64, f64)> = Vec::new(); // frame, engine ms, events, game s presented
+    let mut late_stats: Option<(emergent_universe::universe::Stats, i64)> = None;
+    let mut last_stats = p.u.stats;
+    let mut truncated = false;
+    let mut max_lag = 0.0f64;
+    let mut ran = 0usize;
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs_f64(guard_s) {
+            truncated = true;
+            break;
+        }
+        if f == 60 {
+            late_stats = Some((p.u.stats, p.u.now));
+        }
+        let start = Instant::now();
+        let budget = if budget_ms > 0.0 {
+            Budget { events: u64::MAX, until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)) }
+        } else {
+            Budget::unlimited()
+        };
+        let frame = p.u.frame_to(1.0 / 60.0, rtf, budget, i64::MAX);
+        let took = start.elapsed().as_secs_f64() * 1e3;
+        max_lag = max_lag.max((frame.target - frame.presented) as f64 * TICK_SECONDS);
+        rows.push((f, took, frame.events, p.u.now as f64 * TICK_SECONDS));
+        last_stats = p.u.stats;
+        ran += 1;
+        if !p.u.rec(p.player).alive {
+            break;
+        }
+    }
+    let late: Vec<_> = rows.iter().filter(|r| r.0 >= 60).collect();
+    let mut ms: Vec<f64> = late.iter().map(|r| r.1).collect();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let mut ev: Vec<f64> = late.iter().map(|r| r.2 as f64).collect();
+    ev.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let over12 = late.iter().filter(|r| r.1 > 12.0).count();
+    // the letter's test: worst rolling 60-frame (one wall second at 60 fps) mean engine ms
+    let mut best_w = (0usize, 0.0f64, 0.0f64); // start frame, mean ms, game s at its middle
+    for w in late.windows(60) {
+        let m = w.iter().map(|r| r.1).sum::<f64>() / 60.0;
+        if m > best_w.1 {
+            let mid = w[30].3;
+            best_w = (w[0].0, m, mid);
+        }
+    }
+    // buckets of 500 game-s: mean / max engine ms and max events
+    use std::collections::BTreeMap;
+    let bucket_gs = 500.0f64;
+    let mut buckets: BTreeMap<i64, (f64, f64, u64, usize)> = BTreeMap::new(); // game-s bucket -> (sum ms, max ms, max ev, frames)
+    let mut out: Vec<String> = Vec::new();
+    for r in &late {
+        let b = (r.3 / bucket_gs).floor() as i64;
+        let e = buckets.entry(b).or_insert((0.0, 0.0, 0, 0));
+        e.0 += r.1;
+        e.1 = e.1.max(r.1);
+        e.2 = e.2.max(r.2);
+        e.3 += 1;
+    }
+    for (b, (sum, mx, mxe, cnt)) in &buckets {
+        if sum / *cnt as f64 > 1.0 || *mx > 5.0 {
+            out.push(format!("  [{:>6.0}-{:<6.0} gs] mean {:>6.2} ms  max {:>7.2} ms  maxev {:>5}  ({} frames)", b * bucket_gs as i64, (b + 1) * bucket_gs as i64, sum / *cnt as f64, mx, mxe, cnt));
+        }
+    }
+    let (s0, _) = late_stats.unwrap_or((p.u.stats, p.u.now));
+    let game_s = (p.u.now as i64 - late_stats.as_ref().map(|s| s.1).unwrap_or(p.u.now)) as f64 * TICK_SECONDS;
+    let (kicks, evs) = (last_stats.kicks - s0.kicks, last_stats.events() - s0.events());
+    let mut refusals = 0u64;
+    let mut dead = 0usize;
+    for i in 0..bodies {
+        let r = p.u.rec(i);
+        refusals += r.refusals;
+        dead += (!r.alive) as usize;
+    }
+    println!(
+        "frames {} (truncated {truncated}), wall {:.1} s, game {game_s:.0} s; engine ms p50 {:.3} p99 {:.3} max {:.3}; frames over 12 ms {over12}; events/frame p50 {} p99 {} max {}",
+        late.len(), t_start.elapsed().as_secs_f64(), pct(&ms, 0.5), pct(&ms, 0.99), pct(&ms, 1.0), pct(&ev, 0.5), pct(&ev, 0.99), pct(&ev, 1.0)
+    );
+    println!(
+        "LETTER: worst rolling 1-s mean engine {:.2} ms at frame {} (~game-s {:.0} of presented); 12-ms budget {} there",
+        best_w.1, best_w.0, best_w.2, if best_w.1 <= 12.0 { "HOLDS" } else { "FALLS BEHIND" }
+    );
+    println!("kicks {kicks} ({:.3e}/b/game-s), events {evs} ({:.3e}/b/game-s); refusals {refusals}, dead {dead}; VmHWM {:.0} MB", kicks as f64 / bodies as f64 / game_s, evs as f64 / bodies as f64 / game_s, hwm_kb() as f64 / 1024.0);
+    let mut worst: Vec<_> = late.clone();
+    worst.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
+    println!(
+        "worst frames (frame, ms, events, game-s): {}",
+        worst.iter().take(6).map(|r| format!("({},{:.2},{},{:.0})", r.0, r.1, r.2, r.3)).collect::<Vec<_>>().join(" ")
+    );
+    println!("buckets (mean>1 ms or max>5 ms):\n{}", out.join("\n"));
+    println!(
+        "waveline: n={n} bodies={bodies} frames={ran} truncated={truncated} build_s={build:.2} p50_ms={:.3} p99_ms={:.3} max_ms={:.3} over12={over12} worst60_ms={:.2} worst60_at_gs={:.0} kicks={kicks} events={evs} refusals={refusals} dead={dead} max_lag_gs={max_lag:.0} hwm_mb={:.0}",
+        pct(&ms, 0.5), pct(&ms, 0.99), pct(&ms, 1.0), best_w.1, best_w.2, hwm_kb() as f64 / 1024.0
+    );
+}
