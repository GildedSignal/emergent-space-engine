diff --git a/xtask/src/universe/skyserv.rs b/xtask/src/universe/skyserv.rs
new file mode 100644
index 00000000..f28aeb0e
--- /dev/null
+++ b/xtask/src/universe/skyserv.rs
@@ -0,0 +1,72 @@
+//! The sky-record flight (lab run 20261018-2155-second-20261018-2040-system-cc75-e6c9): the checker's
+//! named experiment for cc75. Flies the N ladder (`plane_extra`, the original run's scene) with the
+//! shipped oracle gather (`gather_cached`) beside the sky-record server (`view::sky_server`): the
+//! near tier walked fresh, far rows served from cell membership maintained at predicted crossings.
+//! Every frame prints one SKYSERV line (costs, wire, audit); every 10th frame the engine digest is
+//! taken before and after the server ran (it must not move). `--serve 0` is the control flight: the
+//! same engine frames and oracle gathers, no server — the end digests must match `--serve 1`.
+use crate::Result;
+use emergent_universe::scenario::{plane_extra, Plane};
+use emergent_universe::view::{gather_cached, sky_server, SkyRow, ViewCache};
+use emergent_universe::{Budget, Config};
+use serde_json::json;
+use std::time::Instant;
+
+fn row_json(s: &emergent_universe::view::Seen, count: u32) -> serde_json::Value {
+    let mut v = json!({
+        "name": s.name, "kind": s.kind, "direction": s.direction, "light_seconds": s.light_seconds,
+        "offset": s.offset, "closing": s.closing, "color": s.color, "shift": s.shift,
+    });
+    if count > 1 {
+        v["count"] = json!(count);
+    }
+    v
+}
+
+fn wire_len(rows: &[SkyRow]) -> usize {
+    serde_json::to_string(&rows.iter().map(|r| row_json(&r.seen, r.count)).collect::<Vec<_>>()).map(|t| t.len()).unwrap_or(0)
+}
+
+fn oracle_wire_len(seen: &[emergent_universe::view::Seen]) -> usize {
+    serde_json::to_string(&seen.iter().map(|s| row_json(s, 1)).collect::<Vec<_>>()).map(|t| t.len()).unwrap_or(0)
+}
+
+pub(crate) fn run(k: usize, frames: usize, seed: u64, floor: f64, serve: bool, margin: f64) -> Result<u8> {
+    let Plane { mut u, names, .. } = plane_extra(Config::default(), seed, emergent_universe::fleet::Order::Sparse, 1, 48, k)
+        .map_err(|e| format!("the plane: {e:?}"))?;
+    let mut names = names;
+    names.resize(u.n_bodies(), String::new());
+    u.start().map_err(|e| format!("start: {e:?}"))?;
+    let mut ocache = ViewCache::default();
+    let mut srv = serve.then(|| sky_server(floor, 100.0, margin));
+    let t0 = Instant::now();
+    for n in 0..frames {
+        u.frame_to(1.0 / 60.0, 100.0, Budget { events: u64::MAX, until: None }, i64::MAX);
+        let tg = Instant::now();
+        let view = gather_cached(&u, &names, &mut ocache).expect("the view");
+        let oracle_ms = tg.elapsed().as_secs_f64() * 1e3;
+        let full_b = oracle_wire_len(&view.seen);
+        if let Some(srv) = srv.as_mut() {
+            let digest_probe = n % 10 == 0;
+            let d0 = digest_probe.then(|| u.digest());
+            let (rows, f) = srv.serve(&u, &names, &view);
+            let d1 = digest_probe.then(|| u.digest());
+            let digest_ok = match (d0, d1) {
+                (Some(a), Some(b)) => a == b,
+                _ => true,
+            };
+            let served_b = wire_len(&rows);
+            println!(
+                "SKYSERV k={k} f={} cold={} near={} fleet={} due={} churn={} tier={} cells={} served={} sing={} full_B={full_b} served_B={served_b} oracle_ms={oracle_ms:.2} near_ms={:.2} due_ms={:.2} serve_ms={:.2} total_ms={:.2} wrong_cell={} cells_wrong={} missing={} extra={} tier_err={} px_max={:.3e} dlum_p50={:.3e} dlum_max={:.3e} near_dmax={:.3e} near_dls={:.3e} near_dsh={:.3e} sums_ops={} sums_drift={:.2e} digest={}",
+                f.frame, f.cold as u8, f.near_rows, f.fleet_rows, f.due, f.churn, f.tier_moves, f.cells, f.served_rows, f.singletons,
+                f.near_ms, f.due_ms, f.serve_ms, f.total_ms, f.wrong_cell, f.cells_wrong, f.missing, f.extra, f.tier_err,
+                f.px_max, f.dlum_p50, f.dlum_max, f.near_dmax, f.near_dls, f.near_dshift, f.sums_ops, f.sums_drift, digest_ok as u8
+            );
+        } else {
+            println!("SKYSERV k={k} f={} control near=0 due=0 full_B={full_b} oracle_ms={oracle_ms:.2} digest=1", n + 1);
+        }
+    }
+    let d = u.digest();
+    println!("SKYSERV-END k={k} frames={frames} seed={seed} floor={floor} serve={} margin={margin} wall_s={:.2} digest={d}", serve as u8, t0.elapsed().as_secs_f64());
+    Ok(0)
+}
