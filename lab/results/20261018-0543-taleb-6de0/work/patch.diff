+//! The runaway-tail instrument (lab run 20261018-0543-taleb-6de0).
+//!
+//! Runs the shipped plane through its public API only, on the judge's restricted scene
+//! (a star and a planet of mass ratio mu on a circle, miniature-units ICs defined in
+//! judge units exactly as xtask/src/behave/restricted.rs writes them), one (du, phi)
+//! co-orbital IC at a time, to a horizon in planet periods under an event cap, printing
+//! one JSON line. The IC grid samples the 1:1 co-orbital band edge: a circular
+//! heliocentric orbit at a = sep + du*Hill(mu), phase phi from the planet. With
+//! KICK_TRACE set, crates/universe/src/trace.rs writes the per-kick series.
+//!
+//! `tail MU DU PHI PERIODS CAP [CHUNK]` — CAP is the event budget (the run is reported
+//! capped=true when it is spent before the horizon); CHUNK is events per advance call
+//! (default 20000; chunking preserves the canonical bits, universe.rs docs).
+use emergent_universe::num::from_f64;
+use emergent_universe::scenario::{AU, STAR_RADIUS};
+use emergent_universe::world::Mass;
+use emergent_universe::{Budget, Config, Kind, OrbitSpec, Universe};
+use std::f64::consts::TAU;
+
+/// The judge's scene (restricted.rs, float64 at the boundary only).
+struct Scene {
+    mu: f64,
+    sep: f64,
+    planet_radius: f64,
+}
+impl Scene {
+    fn omega(&self) -> f64 {
+        self.sep.powf(-1.5)
+    }
+    fn period(&self) -> f64 {
+        TAU * self.sep.powf(1.5)
+    }
+    fn hill(&self) -> f64 {
+        self.sep * (self.mu / 3.0).cbrt()
+    }
+    fn star(&self) -> ([f64; 2], [f64; 2]) {
+        let (s, c) = (0.0f64.sin(), 1.0f64);
+        let (r, v) = (self.sep * self.mu, self.sep * self.mu * self.omega());
+        ([-r * c, -r * s], [v * s, -v * c])
+    }
+}
+
+/// The scene as a universe: a copy of behave::plane::build_scene (crate-public there),
+/// at the default cadence, one thread: deterministic and canonical.
+fn build(scene: &Scene, ship: [f64; 4]) -> Option<(Universe, usize)> {
+    let mu = scene.mu;
+    let to_root = 1.0 / (1.0 - mu);
+    let mass = Mass::of(from_f64(mu / (1.0 - mu))).ok()?;
+    let cfg = Config::default();
+    let mut u = Universe::new(
+        from_f64(STAR_RADIUS as f64 * (scene.sep * to_root / AU as f64).min(1.0)),
+        cfg,
+    );
+    u.threads = 1;
+    let planet = u
+        .add_body(
+            Kind::Planet,
+            OrbitSpec { doll: 0, periapsis: from_f64(scene.sep * to_root), e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+            from_f64(0.0),
+        )
+        .ok()?;
+    let surface = from_f64(scene.planet_radius * to_root).scale(-mass.octave).ok()?;
+    u.add_doll("planet", planet, mass, surface).ok()?;
+    let (sp, sv) = scene.star();
+    let id = u
+        .add_body_state(
+            Kind::Ship,
+            0,
+            [from_f64((ship[0] - sp[0]) * to_root), from_f64((ship[1] - sp[1]) * to_root)],
+            [from_f64(ship[2] - sv[0]), from_f64(ship[3] - sv[1])],
+            from_f64(0.0),
+        )
+        .ok()?;
+    u.start().ok()?;
+    Some((u, id))
+}
+
+fn main() {
+    let a: Vec<f64> = std::env::args().skip(1).take(6).filter_map(|x| x.parse().ok()).collect();
+    if a.len() < 5 {
+        eprintln!("tail MU DU PHI PERIODS CAP [CHUNK]");
+        std::process::exit(2);
+    }
+    emergent_universe::trace::init();
+    let (mu, du, phi, periods, cap) = (a[0], a[1], a[2], a[3], a[4] as u64);
+    let chunk = a.get(5).copied().unwrap_or(20000.0) as u64;
+    let scene = Scene { mu, sep: 5.27e8, planet_radius: 4.84e4 };
+    // The IC: circular heliocentric orbit at sep + du*Hill, phi ahead of the planet.
+    let sma = scene.sep + du * scene.hill();
+    let (sin, cos) = phi.to_radians().sin_cos();
+    let vcirc = ((1.0 - mu) / sma).sqrt();
+    let (sp, sv) = scene.star();
+    let ship = [sma * cos + sp[0], sma * sin + sp[1], -vcirc * sin + sv[0], vcirc * cos + sv[1]];
+
+    let (mut u, id) = match build(&scene, ship) {
+        Some(x) => x,
+        None => {
+            println!("{{\"mu\":{mu},\"du\":{du},\"phi\":{phi},\"refused\":true}}");
+            return;
+        }
+    };
+    let p_ticks = (scene.period() / (1.0 - mu)) as i64; // planet period in root ticks
+    let horizon = (p_ticks as f64 * periods) as i64;
+    let quarter = (p_ticks / 4).max(1);
+    let mut target = 0i64;
+    let mut spent = 0u64;
+    let mut capped = false;
+    let mut cps: Vec<String> = Vec::new();
+    let mut alive = true;
+    let t0 = std::time::Instant::now();
+    while target < horizon {
+        target = (target + quarter).min(horizon);
+        // settle to `target` in budget chunks; stop at the cap.
+        loop {
+            let adv = u.advance(target, Budget::events(chunk));
+            spent += adv.events;
+            if spent > cap {
+                capped = true;
+                break;
+            }
+            if adv.events == 0 {
+                break;
+            }
+        }
+        cps.push(format!(
+            "[{:.4},{},{},{}]",
+            target as f64 / p_ticks as f64,
+            u.stats.kicks,
+            u.stats.events(),
+            u.bodies().alive(id)
+        ));
+        if capped || !u.bodies().alive(id) {
+            alive = u.bodies().alive(id);
+            break;
+        }
+    }
+    println!(
+        "{{\"mu\":{mu},\"du\":{du},\"phi\":{phi},\"periods\":{periods},\"cap\":{cap},\"kicks\":{},\"events\":{},\"handoffs\":{},\"capped\":{capped},\"alive\":{alive},\"secs\":{:.3},\"cp\":[{}]}}",
+        u.stats.kicks,
+        u.stats.events(),
+        u.stats.handoffs,
+        t0.elapsed().as_secs_f64(),
+        cps.join(",")
+    );
+}
