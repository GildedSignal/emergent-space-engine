@@ -0,0 +1,70 @@
+//! An optional per-kick telemetry tap for lab instruments (run 20261018-0543-taleb-6de0).
+//!
+//! Off by default and outside every outcome: `KICK_TRACE=<path>` opens the sink,
+//! `KICK_TRACE_EVERY=<n>` keeps one line in every n clock kicks (1 unless set). When the
+//! sink is off the hook is one relaxed atomic load. The line is the state the kick leaves,
+//! the sources that kicked it, and the interval to the next kick — the series an
+//! instrument needs to tell a physical capture cascade (interval tracks the local orbital
+//! period) from an event storm (interval collapses with no short period behind it).
+use std::cell::RefCell;
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+use crate::num::{to_f64, Tick};
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static SEEN: AtomicU64 = AtomicU64::new(0);
+
+thread_local! {
+    static SINK: RefCell<Option<(std::fs::File, u64)>> = const { RefCell::new(None) };
+}
+
+/// Open the sink if `KICK_TRACE` is set; call once from the instrument's main (the
+/// thread that runs the universe).
+pub fn init() {
+    if let Some(path) = std::env::var_os("KICK_TRACE") {
+        let every = std::env::var("KICK_TRACE_EVERY")
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .unwrap_or(1)
+            .max(1);
+        if let Ok(f) = std::fs::File::create(&path) {
+            SINK.with(|s| *s.borrow_mut() = Some((f, every)));
+            ENABLED.store(true, Ordering::Relaxed);
+        }
+    }
+}
+
+/// Whether the hook should gather (checked before any borrow).
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// One clock kick: `t` (doll ticks), the doll, the position the kick leaves, the
+/// secondaries (gm, position) at `t`, and `full`, the interval planned to the next kick.
+pub fn kick(
+    t: Tick,
+    d: u16,
+    x: &[emergent_space::orbit::Scalar; 2],
+    v: &[emergent_space::orbit::Scalar; 2],
+    y: Option<emergent_space::orbit::Scalar>,
+    secs: &[crate::force::Secondary],
+    full: i64,
+) {
+    let n = SEEN.fetch_add(1, Ordering::Relaxed);
+    SINK.with(|cell| {
+        let mut guard = cell.borrow_mut();
+        let Some((f, every)) = guard.as_mut() else { return };
+        if n % *every != 0 {
+            return;
+        }
+        let _ = write!(f, "{t} {d} {:.9e} {:.9e} {}", to_f64(x[0]), to_f64(x[1]), secs.len());
+        if let Some(y) = y {
+            let _ = write!(f, " {:.9e} {:.9e}", to_f64(y), to_f64(v[0]).hypot(to_f64(v[1])));
+        }
+        for s in secs.iter().take(3) {
+            let _ = write!(f, " {:.9e} {:.9e} {:.9e}", to_f64(s.gm), to_f64(s.pos[0]), to_f64(s.pos[1]));
+        }
+        let _ = writeln!(f, " {full}");
+    });
+}
