+
+/// Timing counters for the rebind path (measurement only; never affects outcomes).
+pub mod prof {
+    use std::cell::RefCell;
+
+    pub const SLOT_NAMES: [&str; 8] = [
+        "fit_key",
+        "compile_cycle",
+        "compile_passage",
+        "at_radius_and_tail",
+        "u_readout",
+        "u_sources",
+        "u_force_quant",
+        "u_tau_book",
+    ];
+
+    thread_local! {
+        static NS: RefCell<[u64; 8]> = const { RefCell::new([0; 8]) };
+        static CALLS: RefCell<[u64; 8]> = const { RefCell::new([0; 8]) };
+    }
+
+    pub fn add(slot: usize, ns: u64) {
+        NS.with(|n| {
+            let mut b = n.borrow_mut();
+            b[slot] = b[slot].saturating_add(ns);
+        });
+        CALLS.with(|c| c.borrow_mut()[slot] += 1);
+    }
+
+    /// Take (and reset) the counters: `(slot name, total ns, calls)`.
+    pub fn take() -> Vec<(String, u64, u64)> {
+        let ns = NS.with(|n| std::mem::take(&mut *n.borrow_mut()));
+        let calls = CALLS.with(|c| std::mem::take(&mut *c.borrow_mut()));
+        ns.iter()
+            .zip(calls)
+            .enumerate()
+            .map(|(i, (ns, calls))| (SLOT_NAMES[i].to_string(), *ns, calls))
+            .collect()
+    }
+}
