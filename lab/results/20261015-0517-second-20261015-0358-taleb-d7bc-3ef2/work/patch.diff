@@ -0,0 +1,110 @@
+//! The band seam with the phase tier: the same flight as `scan_cap`, digested on the canonical instrument
+//! (the checker's settle-at-cut: `frame_to` stops a margin before the cut tick, `settle(cut_tick)` resolves
+//! the horizon exactly there, then `digest`), because the shipped digest-at-presented wobbles with the wall
+//! schedule. One line every 5 s of wall time; at the cut, the digest and the flight's counters.
+//!
+//! `ES_SCAN_PHASE` bounds the scan's candidate set in angle (`crate::radial`'s phase tier: a pair the exact
+//! predicate could find must be within `reach` at the scan's tick, so its chord bounds the angle gap; the
+//! radial hull of an eccentric belt ship says nothing about where it is now, which is why the shipped walk
+//! reads the whole retention in-band). `ES_PHASE_AUDIT` recomputes the shipped walk's answer on every bounded
+//! capture and compares, pair for pair: the soundness control.
+//!
+//! cargo run --release -p emergent-universe --example scan_phase -- <extra> <burn level> [seed] [cut game-s] [rtf] [band 1|0]
+
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::{plane_extra, plane_extra_band};
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn rss_mb() -> u64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines()
+                .find(|l| l.starts_with("VmRSS:"))
+                .and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+        })
+        .map_or(0, |kb| kb / 1024)
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let extra: usize = args[1].parse().unwrap();
+    let level: u8 = args[2].parse().unwrap();
+    let seed: u64 = args.get(3).map(|s| s.parse().unwrap()).unwrap_or(1);
+    let cut: f64 = args.get(4).map(|s| s.parse().unwrap()).unwrap_or(16_000.0);
+    let rtf: f64 = args.get(5).map(|s| s.parse().unwrap()).unwrap_or(100.0);
+    let band: bool = args.get(6).map(|s| s != "0").unwrap_or(true);
+    let phase = std::env::var("ES_SCAN_PHASE").unwrap_or_else(|_| "off".into());
+    let audit = std::env::var("ES_PHASE_AUDIT").unwrap_or_else(|_| "off".into());
+    let cap = std::env::var("ES_SCAN_STANDING").unwrap_or_else(|_| "off".into());
+    let margin: i64 = std::env::var("ES_CANON_MARGIN").ok().and_then(|v| v.parse().ok()).unwrap_or(120);
+    let (t0, mut p) = (Instant::now(), if band {
+        plane_extra_band(Config::default(), seed, Order::Sparse, 1, 48, extra).unwrap()
+    } else {
+        plane_extra(Config::default(), seed, Order::Sparse, 1, 48, extra).unwrap()
+    });
+    println!(
+        "built in {:.2}s: {} bodies, band {band}, seed {seed}, L{level} held burn, rtf {rtf}, 12 ms budget, cut {cut} game-s, phase {phase}, audit {audit}, cap {cap}, margin {margin}",
+        t0.elapsed().as_secs_f64(),
+        p.u.n_bodies()
+    );
+    let cut_tick = (cut / TICK_SECONDS) as i64;
+    let mut sent = false;
+    let (mut frames, mut over, mut worst, mut lag) = (0u64, 0u64, Duration::ZERO, 0f64);
+    let (mut last_line, mut peak_rss, mut peak_standing, mut peak_held) = (0f64, 0u64, 0u64, 0usize);
+    let t0 = Instant::now();
+    loop {
+        // The burn is one held decision at one tick; no view gather in flight (a per-frame gather in-band is
+        // its own unmeasured cost, as the run before this one records).
+        if !sent && frames as f64 / 60.0 >= 1.0 {
+            let _ = p.u.input(p.u.now, word(1, level));
+            sent = true;
+        }
+        let start = Instant::now();
+        let frame = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_millis(12)) }, i64::MAX);
+        let dt = start.elapsed();
+        frames += 1;
+        if dt > Duration::from_millis(12) {
+            over += 1;
+        }
+        worst = worst.max(dt);
+        lag = lag.max((frame.target - frame.presented) as f64 * TICK_SECONDS);
+        let (rss, standing, held) = (rss_mb(), p.u.held_scan_bytes() / 1_000_000, p.u.held_scans());
+        peak_rss = peak_rss.max(rss);
+        peak_standing = peak_standing.max(standing);
+        peak_held = peak_held.max(held);
+        let wall = t0.elapsed().as_secs_f64();
+        if wall - last_line >= 5.0 {
+            println!(
+                "t+{wall:5.0}s game {:>9.1} rss {rss:>5} MB (peak {peak_rss}) held {held:>5} (peak {peak_held}) standing {standing:>5} MB (peak {peak_standing}) over {over:>4} worst {:>7.1} ms lag {lag:>7.3} s",
+                frame.presented as f64 * TICK_SECONDS,
+                worst.as_secs_f64() * 1e3
+            );
+            last_line = wall;
+        }
+        if frame.presented >= cut_tick - margin {
+            break;
+        }
+        if t0.elapsed().as_secs_f64() > 1_800.0 {
+            println!("WALL CAP at game {:.1}: no digest (the cut was not reached)", frame.presented as f64 * TICK_SECONDS);
+            std::process::exit(8);
+        }
+    }
+    let t = Instant::now();
+    p.u.settle(cut_tick);
+    let settle_s = t.elapsed().as_secs_f64();
+    let digest = p.u.digest();
+    println!(
+        "canonical at tick {cut_tick} (game {:.1}): digest {digest} (settle {settle_s:.2}s, held now {}, standing peak {peak_standing} MB, held peak {peak_held}, encounters {}, decisions {}, frames {frames}, over {over}, worst {:.1} ms, lag {lag:.3} s, rss peak {peak_rss} MB, wall {:.0} s, rtf {:.1})",
+        cut_tick as f64 * TICK_SECONDS,
+        p.u.held_scans(),
+        p.u.stats.encounters,
+        p.u.stats.decisions,
+        worst.as_secs_f64() * 1e3,
+        t0.elapsed().as_secs_f64(),
+        cut_tick as f64 * TICK_SECONDS / t0.elapsed().as_secs_f64()
+    );
+}
