diff --git a/crates/universe/examples/scan_cap.rs b/crates/universe/examples/scan_cap.rs
new file mode 100644
index 00000000..60401b1c
--- /dev/null
+++ b/crates/universe/examples/scan_cap.rs
@@ -0,0 +1,119 @@
+//! The band seam with the held-scan standing cap. The player is a circular belt body at 2.5 AU in the
+//! root doll, among the belt ships (`plane_extra_band`: everything else bit for bit the ladder), an
+//! L-level prograde burn held from the first second of wall time, rtf 100, a 12 ms budget. One line
+//! every 5 s of wall time: presented game-s, RSS, held scans, the bytes they pin, frames over budget,
+//! the worst frame, the worst lag; at the cut the digest (which answers what is held).
+//!
+//! The ruin this measures (quant-d7e3, taleb-625b, c481): shipped, each minted scan's capture is the
+//! whole retention, O(N), and behind it a generation of entries; the backlog's count cap (2048,
+//! assuming ~10 KB a scan) bounds nothing there, so the process dies on memory. `ES_SCAN_STANDING`
+//! (MiB) bounds the pinned bytes instead: over it the oldest scan is answered inside the frame, which
+//! moves no bit — the digest counts what is held as answered, in their order, whenever they are given.
+//!
+//! `ES_RSS_LIMIT_MB` (unset: no limit) stops the flight when RSS passes it, reporting where it stood:
+//! the ruin's kill arm, bounded for a shared box.
+//!
+//! cargo run --release -p emergent-universe --example scan_cap -- <extra> <burn level> [seed] [cut game-s] [rtf] [band 1|0]
+
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::{plane_extra, plane_extra_band};
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn rss_mb() -> u64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines()
+                .find(|l| l.starts_with("VmRSS:"))
+                .and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+        })
+        .map_or(0, |kb| kb / 1024)
+}
+
+fn rss_limit() -> Option<u64> {
+    std::env::var("ES_RSS_LIMIT_MB").ok().and_then(|v| v.parse().ok())
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let extra: usize = args[1].parse().unwrap();
+    let level: u8 = args[2].parse().unwrap();
+    let seed: u64 = args.get(3).map(|s| s.parse().unwrap()).unwrap_or(1);
+    let cut: f64 = args.get(4).map(|s| s.parse().unwrap()).unwrap_or(16_000.0);
+    let rtf: f64 = args.get(5).map(|s| s.parse().unwrap()).unwrap_or(100.0);
+    let band: bool = args.get(6).map(|s| s != "0").unwrap_or(true);
+    let cap = std::env::var("ES_SCAN_STANDING").unwrap_or_else(|_| "off".into());
+    let (t0, mut p) = (Instant::now(), if band {
+        plane_extra_band(Config::default(), seed, Order::Sparse, 1, 48, extra).unwrap()
+    } else {
+        plane_extra(Config::default(), seed, Order::Sparse, 1, 48, extra).unwrap()
+    });
+    println!(
+        "built in {:.2}s: {} bodies, band {band}, seed {seed}, L{level} held burn, rtf {rtf}, 12 ms budget, cut {cut} game-s, ES_SCAN_STANDING {cap}, rss limit {:?} MB",
+        t0.elapsed().as_secs_f64(),
+        p.u.n_bodies(),
+        rss_limit()
+    );
+    let mut sent = false;
+    let (mut frames, mut over, mut worst, mut lag) = (0u64, 0u64, Duration::ZERO, 0f64);
+    let (mut last_line, mut peak_rss, mut peak_standing) = (0f64, 0u64, 0u64);
+    let cut_tick = (cut / TICK_SECONDS) as i64;
+    let t0 = Instant::now();
+    let digest;
+    loop {
+        // The burn is one held decision at one tick (a key held is not a decision per frame): no view gather
+        // needed in flight, and gathering in-band is its own unmeasured cost this run does not price.
+        if !sent && frames as f64 / 60.0 >= 1.0 {
+            let _ = p.u.input(p.u.now, word(1, level));
+            sent = true;
+        }
+        let start = Instant::now();
+        let frame = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_millis(12)) }, i64::MAX);
+        let dt = start.elapsed();
+        frames += 1;
+        if dt > Duration::from_millis(12) {
+            over += 1;
+        }
+        worst = worst.max(dt);
+        lag = lag.max((frame.target - frame.presented) as f64 * TICK_SECONDS);
+        let (rss, standing, held) = (rss_mb(), p.u.held_scan_bytes() / 1_000_000, p.u.held_scans());
+        peak_rss = peak_rss.max(rss);
+        peak_standing = peak_standing.max(standing);
+        let wall = t0.elapsed().as_secs_f64();
+        if wall - last_line >= 5.0 {
+            println!(
+                "t+{wall:5.0}s game {:>9.1} rss {rss:>5} MB (peak {peak_rss}) held {held:>5} standing {standing:>5} MB (peak {peak_standing}) over {over:>4} worst {:>7.1} ms lag {lag:>7.3} s",
+                frame.presented as f64 * TICK_SECONDS,
+                worst.as_secs_f64() * 1e3
+            );
+            last_line = wall;
+        }
+        if let Some(limit) = rss_limit() {
+            if rss > limit {
+                println!("SELF_KILL at rss {rss} MB > {limit}: game {:.1}, held {held}, standing {standing} MB", frame.presented as f64 * TICK_SECONDS);
+                std::process::exit(9);
+            }
+        }
+        if frame.presented >= cut_tick {
+            let t = Instant::now();
+            digest = p.u.digest();
+            println!(
+                "cut at game {:.1}: digest {digest} (held answered in {:.2}s), rss {rss} MB peak {peak_rss}, standing peak {peak_standing} MB, held now {}, encounters {}, decisions {}, frames {frames}, over {over}, worst {:.1} ms, lag {lag:.3} s",
+                frame.presented as f64 * TICK_SECONDS,
+                t.elapsed().as_secs_f64(),
+                p.u.held_scans(),
+                p.u.stats.encounters,
+                p.u.stats.decisions,
+                worst.as_secs_f64() * 1e3
+            );
+            break;
+        }
+        if t0.elapsed().as_secs_f64() > 480.0 {
+            println!("WALL CAP at game {:.1}: no digest (the cut was not reached)", frame.presented as f64 * TICK_SECONDS);
+            std::process::exit(8);
+        }
+    }
+}
