+//! Print-only probe: the scan memo's duplicate class, priced on the shipped flight. The scan's
+//! memo proves "nothing changed" by rebuilding the candidate list and comparing it
+//! (`encounter.rs`: the reuse walk); with `ES_MEMO_FIRST` the engine's own change versions answer
+//! first, and `ES_MEMO_FIRST=verify` proves the cheap key against the shipped comparison on every
+//! capture. No answer depends on the probe: a flight's digest must be the same in every mode.
+//!
+//! cargo run --release -p emergent-universe --example scan_memo [-- <N> <coast|burn> [<seconds> [<rtf>]]]
+
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(10.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let burn = flight == "burn";
+    let frames = (seconds * 60.0) as usize;
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    println!(
+        "scene N={n} ({bodies} bodies) {flight} rtf {rtf} {seconds}s; build {build:.2}s",
+        bodies = p.u.n_bodies(),
+        build = t0.elapsed().as_secs_f64()
+    );
+    let mut held_max = 0usize;
+    let mut events = 0u64;
+    let mut engine_ms = Vec::new();
+    for f in 0..frames {
+        if f == 60 && burn {
+            let t = p.u.now;
+            let _ = p.u.input(t, word(1, 8));
+        }
+        let start = Instant::now();
+        let frame = p.u.frame_to(
+            1.0 / 60.0,
+            rtf,
+            Budget { events: u64::MAX, until: Some(start + Duration::from_millis(12)) },
+            i64::MAX,
+        );
+        engine_ms.push(start.elapsed().as_secs_f64() * 1e3);
+        events += frame.events;
+        held_max = held_max.max(p.u.held_scans());
+        let _ = p.u.now;
+    }
+    engine_ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let digest = p.u.digest();
+    p.u.flush_scans();
+    let settled = p.u.digest();
+    let s = p.u.stats;
+    let m = emergent_universe::encounter::memo_stats();
+    let mode = std::env::var("ES_MEMO_FIRST").unwrap_or_default();
+    println!(
+        "flight: digest={digest} settled={settled} encounters={} contacts={} events={events} held_max={held_max}",
+        s.encounters, p.u.contacts
+    );
+    println!(
+        "engine_ms: p50={:.3} p99={:.3} max={:.3}",
+        pct(&engine_ms, 0.5),
+        pct(&engine_ms, 0.99),
+        engine_ms[engine_ms.len() - 1]
+    );
+    println!(
+        "memo_stats[{mode}]: captures={} both_hit={} cheap_only_soundness={} rebuild_only_lost={} fresh={} walk_repaid_ms={:.2} walk_repaid_per_dup_us={:.1} cheap_hits_total={}",
+        m[0],
+        m[1],
+        m[2],
+        m[3],
+        m[4],
+        m[5] as f64 / 1e6,
+        if m[3] > 0 { m[5] as f64 / m[3] as f64 / 1e3 } else { 0.0 },
+        m[7]
+    );
+    let _ = TICK_SECONDS;
+}
