+//! Lab probe 20261014-1010: the static geometric edge rule vs the shipped EDGE ladder.
+//! Read-only measurement: panels, crossings, the three increments, compile time.
+//! Arm selected by ES_THIN_EDGE (unset = shipped ladder; 1|2|4 = rungs per octave).
+use emergent_space::orbit::{Orbit, OrbitKey, Passage, Scalar};
+use std::{env, hint::black_box, time::Instant};
+
+fn encode(x: f64) -> Scalar {
+    let e = x.log2().floor() as i32;
+    Scalar::raw((x * 2f64.powi(60 - e)).round() as i128, e - 60).unwrap()
+}
+fn decode(x: Scalar) -> f64 {
+    x.significand() as f64 * 2f64.powi(x.exponent() as i32 - 62)
+}
+fn key(p: f64, e: f64) -> OrbitKey {
+    OrbitKey::bound(encode(p), (e * 2f64.powi(48)).round() as u64).unwrap()
+}
+
+fn time_compile(p: f64, e: f64) -> (u128, usize) {
+    let k = key(p, e);
+    let o = Orbit::compile(k).unwrap();
+    let panels = o.shape().knots().len() - 1;
+    for _ in 0..20 {
+        black_box(Orbit::compile(k).unwrap());
+    }
+    let mut best = u128::MAX;
+    for _ in 0..3 {
+        let t = Instant::now();
+        for _ in 0..200 {
+            black_box(Orbit::compile(k).unwrap());
+        }
+        best = best.min(t.elapsed().as_nanos() / 200);
+    }
+    (best, panels)
+}
+
+fn row(p: f64, e: f64) {
+    let k = key(p, e);
+    let arm = env::var("ES_THIN_EDGE").unwrap_or_default();
+    let o = match Orbit::compile(k) {
+        Ok(o) => o,
+        Err(err) => {
+            println!("ROW,{p},{e},{arm},ERR,{err:?}");
+            return;
+        }
+    };
+    let (ns, panels) = time_compile(p, e);
+    let crossings = o.shape().crossings().len();
+    println!(
+        "ROW,{p},{e},{arm},{panels},{crossings},{:.16e},{:.16e},{:.16e},{ns}",
+        decode(o.advance().unwrap()),
+        decode(o.period().unwrap()),
+        decode(o.proper_period().unwrap())
+    );
+}
+
+fn passage_row(p: f64, e: f64, outer: f64) {
+    let arm = env::var("ES_THIN_EDGE").unwrap_or_default();
+    // Hyperbolic: k = 1/(1+e) < 1/2 stored in Q48; periapsis stored = p*k.
+    let k = 1.0 / (1.0 + e);
+    let key = OrbitKey::new(encode(p * k), (k * 2f64.powi(48)).round() as u64).unwrap();
+    let passage = match Passage::compile(key, encode(outer)) {
+        Ok(x) => x,
+        Err(err) => {
+            println!("PASSAGE,{p},{e},{outer},{arm},ERR,{err:?}");
+            return;
+        }
+    };
+    let (t, panels) = {
+        for _ in 0..20 {
+            black_box(Passage::compile(key, encode(outer)).unwrap());
+        }
+        let mut best = u128::MAX;
+        for _ in 0..3 {
+            let s = Instant::now();
+            for _ in 0..200 {
+                black_box(Passage::compile(key, encode(outer)).unwrap());
+            }
+            best = best.min(s.elapsed().as_nanos() / 200);
+        }
+        (best, passage.panels())
+    };
+    println!("PASSAGE,{p},{e},{outer},{arm},{panels},{t}");
+}
+
+fn main() {
+    let set = env::args().nth(1).unwrap_or_else(|| "grid".into());
+    let keys: Vec<(f64, f64)> = match set.as_str() {
+        "dev" => vec![(20.0, 0.1), (20.0, 0.5), (20.0, 0.9), (20.0, 0.99)],
+        "grid" => {
+            let ps = [7.1, 8.0, 10.0, 20.0, 50.0, 200.0, 1000.0, 100000.0];
+            let es = [0.1, 0.3, 0.5, 0.7, 0.9, 0.99, 0.999, 0.9999, 0.99999];
+            ps.iter()
+                .flat_map(|p| es.iter().map(move |e| (*p, *e)))
+                .collect()
+        }
+        "heldout" => vec![
+            (6.7, 0.3),
+            (6.7, 0.6),
+            (9.3, 0.45),
+            (33.3, 0.2),
+            (33.3, 0.8),
+            (777.0, 0.05),
+            (777.0, 0.95),
+            (12.0, 0.333),
+            (100000.0, 0.99999),
+            (6.9, 0.45),
+        ],
+        _ => panic!("unknown set"),
+    };
+    for (p, e) in keys {
+        row(p, e);
+    }
+    if set == "heldout" {
+        // The leaver rebind's walk (unbound): panels only; e > 1.
+        for (p, e, outer) in [(20.0, 1.5, 1e3), (100.0, 3.0, 1e5), (1e4, 1.1, 1e6)] {
+            passage_row(p, e, outer);
+        }
+    }
+}
