new file mode 100644
index 00000000..8da9b960
--- /dev/null
+++ b/crates/universe/examples/keep_probe.rs
@@ -0,0 +1,184 @@
+//! The keep probe: `lab/wiki/history-demand`'s open direction 1 — retention at one light leg
+//! (`ES_KEEP_LEGS=1`) instead of the shipped two, flown with the view gathered at the game's
+//! cadence. One process is one arm; the scene and the loop are `nladder`'s (the shipped ladder
+//! scene, a 12 ms engine budget, 60 frames a second at a real-time factor), plus one
+//! `gather_cached` every `every` frames. Instruments: every gather's completeness (emitters seen
+//! against the arm's own steady maximum, and the first frame any gather lost one), the
+//! `binding_at` census split into gather and engine shares, the retained segments per body and
+//! their depth, resident memory, the engine digest and a strict hash of the whole view — so two
+//! arms are comparable tick for tick.
+//!
+//! cargo run --release -p emergent-universe --example keep_probe [-- <N> <coast|burn> [<wall s> [<rtf> [<gather every F frames>]]]]
+
+use emergent_universe::body::keepcensus;
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::{gather_cached, View, ViewCache, TICK_SECONDS};
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn rss_mb() -> f64 {
+    std::fs::read_to_string("/proc/self/statm")
+        .ok()
+        .and_then(|s| {
+            s.split_whitespace()
+                .nth(1)
+                .and_then(|p| p.parse::<u64>().ok())
+                .map(|p| p as f64 * 4096.0 / 1e6)
+        })
+        .unwrap_or(0.0)
+}
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    if sorted.is_empty() {
+        return 0.0;
+    }
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+/// A strict hash of everything a player would see: every seen row's identity, direction, distance,
+/// colour shift, age and closing — equal views hash equal, any lost or shifted emitter differs.
+fn view_hash(v: &View) -> String {
+    let mut h = blake3::Hasher::new();
+    for s in &v.seen {
+        h.update(
+            format!(
+                "{} {:.9e} {:.9e} {:.9e} {:.9e} {:.9e} {:.9e} {:.9e}\n",
+                s.id,
+                s.direction[0],
+                s.direction[1],
+                s.light_seconds,
+                s.shift,
+                s.age,
+                s.closing,
+                s.angular_radius
+            )
+            .as_bytes(),
+        );
+    }
+    format!("{:.16}", h.finalize())
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(30000);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(24.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(2000.0);
+    let every: usize = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(1).max(1);
+    let burn = flight == "burn";
+    let frames = (seconds * 60.0) as usize;
+    let legs = std::env::var("ES_KEEP_LEGS").unwrap_or_else(|_| "2".into());
+    keepcensus::ON.store(true, std::sync::atomic::Ordering::Relaxed);
+
+    let rss0 = rss_mb();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let bodies = p.u.n_bodies();
+    let mut cache = ViewCache::default();
+    let (mut gathers, mut seen_max, mut worst_seen, mut losses) =
+        (0usize, 0usize, usize::MAX, 0usize);
+    let mut first_loss: Option<(usize, usize, usize)> = None;
+    let (mut g_calls, mut g_nones) = (0u64, 0u64);
+    let mut g_ms: Vec<f64> = Vec::new();
+    let mut g_reads: Vec<f64> = Vec::new();
+    let mut truncated = false;
+    let t_first = p.u.now;
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs(55) {
+            truncated = true;
+            break;
+        }
+        if f == 60 && burn {
+            let t = p.u.now;
+            let _ = p.u.input(t, word(1, 8));
+        }
+        let start = Instant::now();
+        let _ = p.u.frame_to(
+            1.0 / 60.0,
+            rtf,
+            Budget {
+                events: u64::MAX,
+                until: Some(start + Duration::from_micros(12_000)),
+            },
+            i64::MAX,
+        );
+        if f >= 60 && (f - 60) % every == 0 {
+            let (c0, n0, _, _) = keepcensus::read();
+            let tg = Instant::now();
+            let v = gather_cached(&p.u, &p.names, &mut cache);
+            let ms = tg.elapsed().as_secs_f64() * 1e3;
+            let (c1, n1, _, _) = keepcensus::read();
+            g_calls += c1 - c0;
+            g_nones += n1 - n0;
+            g_ms.push(ms);
+            if let Some(v) = &v {
+                let seen = v.seen.len();
+                if seen > seen_max {
+                    seen_max = seen;
+                }
+                if seen < worst_seen {
+                    worst_seen = seen;
+                }
+                if seen < seen_max {
+                    losses += 1;
+                    first_loss.get_or_insert((f, seen, seen_max));
+                }
+                g_reads.push(cache.readouts as f64);
+                gathers += 1;
+            } else {
+                losses += 1;
+                first_loss.get_or_insert((f, 0, seen_max));
+            }
+        }
+        if !p.u.rec(p.player).alive {
+            break;
+        }
+    }
+    // The final view, hashed: at the same tick in two arms it must be equal.
+    // The final view, hashed: at the same tick in two arms it must be equal.
+    let final_view = gather_cached(&p.u, &p.names, &mut cache);
+    let (final_seen, hash) = final_view
+        .as_ref()
+        .map_or((0, String::new()), |v| (v.seen.len(), view_hash(v)));
+    let game_s = (p.u.now - t_first) as f64 * TICK_SECONDS;
+    // The retained stock: every body's segments and how deep the oldest reaches.
+    let mut segs = 0usize;
+    let mut depth: Vec<f64> = Vec::new();
+    for i in 0..bodies {
+        let b = p.u.bodies().bindings_of(i);
+        segs += b.len();
+        if let Some(first) = b.first() {
+            depth.push((p.u.now - first.event_time) as f64 * TICK_SECONDS);
+        }
+    }
+    depth.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let (calls, nones, min_t, none_min_t) = keepcensus::read();
+    let (e_calls, e_nones) = (calls - g_calls, nones - g_nones);
+    let gs = |t: i64| {
+        if t == i64::MAX {
+            f64::NAN
+        } else {
+            (p.u.now - t) as f64 * TICK_SECONDS
+        }
+    };
+    let mut ms = g_ms.clone();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    println!(
