diff --git a/crates/space/examples/kickbench.rs b/crates/space/examples/kickbench.rs
new file mode 100644
index 00000000..4cfde35a
--- /dev/null
+++ b/crates/space/examples/kickbench.rs
@@ -0,0 +1,227 @@
+//! ns per kick on the shipped per-kick path: readout -> parent tide -> rebind.
+//! The plane rebinds (compiles a tube) on ~99% of kicks, so this is ns per event
+//! for the dominant engine event. Outputs a bit-identity digest of the TubeEvent
+//! stream so any variant must reproduce the exact same tube bits.
+use emergent_space::binding::cartesian;
+use emergent_space::events::handoff::bind;
+use emergent_space::events::kicks::parent_tide;
+use emergent_space::orbit::{Orbit, OrbitKey, Scalar};
+use emergent_space::tube::{Catalogue, TubeEvent};
+use std::time::{Duration, Instant};
+
+fn s(n: i64) -> Scalar {
+    Scalar::integer(n)
+}
+
+/// One scene: an orbit key, doll units, a clock, and a parent tide in doll units.
+struct Scene {
+    name: &'static str,
+    key: OrbitKey,
+    units: (i16, i16),
+    clock_exp: i16,
+    interval: i64,
+    tide_mass: Scalar,
+    tide_centre: [Scalar; 2],
+    kicks: usize,
+}
+
+#[derive(Default)]
+struct Timings {
+    readout: Duration,
+    tide: Duration,
+    bind: Duration,
+}
+
+fn run(scene: &Scene, digest: &mut blake3::Hasher) -> Timings {
+    let mut t = Timings::default();
+    let orbit = Orbit::compile(scene.key).expect("scene orbit compiles");
+    let state = orbit.state(Scalar::ZERO).expect("state at periapsis");
+    let exact = cartesian(state, 0, false, scene.units).expect("cartesian state");
+    let mut catalogue = Catalogue::default();
+    let mut event: TubeEvent =
+        bind(exact, 0, scene.clock_exp, None, &mut catalogue).expect("first bind");
+    let h = Scalar::raw(scene.interval as i128, scene.clock_exp as i32).expect("interval");
+    for k in 1..=scene.kicks {
+        let tick = (k as i64) * scene.interval;
+        let now = Instant::now();
+        let st = event.reconstruct(&catalogue).expect("reconstruct");
+        t.readout += now.elapsed();
+        let x = [
+            Scalar::raw(st.position[0] as i128, scene.units.0 as i32).expect("x0"),
+            Scalar::raw(st.position[1] as i128, scene.units.0 as i32).expect("x1"),
+        ];
+        let v = [
+            Scalar::raw(st.velocity[0] as i128, scene.units.1 as i32).expect("v0"),
+            Scalar::raw(st.velocity[1] as i128, scene.units.1 as i32).expect("v1"),
+        ];
+        let now = Instant::now();
+        let a = parent_tide(scene.tide_mass, scene.tide_centre, x).expect("tide");
+        t.tide += now.elapsed();
+        let dv = [a[0].mul(h).expect("dv0"), a[1].mul(h).expect("dv1")];
+        let to_int = |val: Scalar, e: i16| -> i64 {
+            i64::try_from(val.fixed(-(e as i32)).expect("fits")).expect("word")
+        };
+        let next = emergent_space::binding::IntegerState {
+            position: st.position,
+            velocity: [
+                to_int(v[0].add(dv[0]).expect("v0+dv0"), scene.units.1),
+                to_int(v[1].add(dv[1]).expect("v1+dv1"), scene.units.1),
+            ],
+            length_exponent: st.length_exponent,
+            velocity_exponent: st.velocity_exponent,
+        };
+        let now = Instant::now();
+        event = bind(next, tick, scene.clock_exp, None, &mut catalogue).expect("rebind");
+        t.bind += now.elapsed();
+        digest.update(&event.tube.key.to_le_bytes());
+        digest.update(&event.tube.periapsis_angle.to_le_bytes());
+        digest.update(&event.tube.periapsis_time.get().to_le_bytes());
+        for r in event.residual.position.iter().chain(event.residual.velocity.iter()) {
+            digest.update(&r.to_le_bytes());
+        }
+    }
+    t
+}
+
+
+fn heldout_scenes() -> Vec<Scene> {
+    let mass = s(1).scale(-20).expect("tide mass");
+    vec![
+        Scene { name: "held-p2e8-e0.97", key: OrbitKey::bound(s(200_000_000), 1 << 45).expect("key"), units: (-20, -30), clock_exp: -20, interval: 1 << 14, tide_mass: mass, tide_centre: [s(600_000_000), Scalar::ZERO], kicks: 64 },
+        Scene { name: "held-p1e5-e0.99", key: OrbitKey::bound(s(100_000), 1 << 43).expect("key"), units: (-14, -24), clock_exp: -14, interval: 1 << 12, tide_mass: s(1).scale(-14).expect("mass"), tide_centre: [s(300_000), Scalar::ZERO], kicks: 64 },
+        Scene { name: "held-p1e7-e0.5", key: OrbitKey::bound(s(10_000_000), 1 << 46).expect("key"), units: (-17, -27), clock_exp: -17, interval: 1 << 13, tide_mass: s(1).scale(-17).expect("mass"), tide_centre: [s(30_000_000), Scalar::ZERO], kicks: 64 },
+        Scene { name: "held-p80-e0.5", key: OrbitKey::bound(s(80), 1 << 47).expect("key"), units: (-6, -16), clock_exp: -8, interval: 1 << 10, tide_mass: s(1).scale(-10).expect("mass"), tide_centre: [s(240), Scalar::ZERO], kicks: 64 },
+    ]
+}
+fn main() {
+    let mass = s(1).scale(-20).expect("tide mass");
+    let scenes = [
+        Scene {
+            name: "weak-circle-p1e8",
+            key: OrbitKey::bound(s(100_000_000), 1).expect("key"),
+            units: (-20, -30),
+            clock_exp: -20,
+            interval: 1 << 14,
+            tide_mass: mass,
+            tide_centre: [s(300_000_000), Scalar::ZERO],
+            kicks: 64,
+        },
+        Scene {
+            name: "weak-ecc-p1e8-e0.5",
+            key: OrbitKey::bound(s(100_000_000), 1 << 47).expect("key"),
+            units: (-20, -30),
+            clock_exp: -20,
+            interval: 1 << 14,
+            tide_mass: mass,
+            tide_centre: [s(300_000_000), Scalar::ZERO],
+            kicks: 64,
+        },
+        Scene {
+            name: "strong-ecc-p1e5-e0.5",
+            key: OrbitKey::bound(s(100_000), 1 << 47).expect("key"),
+            units: (-14, -24),
+            clock_exp: -14,
+            interval: 1 << 12,
+            tide_mass: s(1).scale(-14).expect("mass"),
+            tide_centre: [s(300_000), Scalar::ZERO],
+            kicks: 64,
+        },
+        Scene {
+            name: "deep-ecc-p40-e0.5",
+            key: OrbitKey::bound(s(40), 1 << 47).expect("key"),
+            units: (-6, -16),
+            clock_exp: -8,
+            interval: 1 << 10,
+            tide_mass: s(1).scale(-10).expect("mass"),
+            tide_centre: [s(120), Scalar::ZERO],
+            kicks: 64,
+        },
+    ];
+    let repeats = 5;
+    let heldout = std::env::args().nth(1).as_deref() == Some("heldout");
+    if heldout {
+        for scene in heldout_scenes() {
+            let mut best: Option<Timings> = None;
+            let mut last_hash = None;
+            for _ in 0..repeats {
+                let mut digest = blake3::Hasher::new();
+                let t = run(&scene, &mut digest);
+                let hash = digest.finalize();
+                if let Some(prev) = last_hash {
+                    assert_eq!(prev, hash, "nondeterministic tube stream in {}", scene.name);
+                }
+                last_hash = Some(hash);
+                let total = t.readout + t.tide + t.bind;
+                if best.as_ref().map(|b| (b.readout + b.tide + b.bind) > total).unwrap_or(true) {
+                    best = Some(t);
+                }
+            }
+            let hash = last_hash.unwrap();
+            let t = best.unwrap();
+            let n = scene.kicks as u128;
+            let ns = |d: Duration| d.as_nanos() / n;
+            println!(
+                "{:<24} {:>10} ns/kick  readout {:>9} tide {:>8} bind {:>9}  digest {}",
+                scene.name,
+                ns(t.readout + t.tide + t.bind),
+                ns(t.readout),
+                ns(t.tide),
+                ns(t.bind),
+                &hash.to_hex()[..16],
+            );
+        }
+        return;
+    }
+    for scene in &scenes {
+        let mut best: Option<Timings> = None;
+        let mut last_hash = None;
+        for _ in 0..repeats {
+            let mut digest = blake3::Hasher::new();
+            let t = run(scene, &mut digest);
+            let hash = digest.finalize();
+            if let Some(prev) = last_hash {
+                assert_eq!(prev, hash, "nondeterministic tube stream in {}", scene.name);
+            }
+            last_hash = Some(hash);
+            let total = t.readout + t.tide + t.bind;
+            if best.as_ref().map(|b| (b.readout + b.tide + b.bind) > total).unwrap_or(true) {
+                best = Some(t);
+            }
+        }
+        let hash = last_hash.unwrap();
+        let t = best.unwrap();
+        let n = scene.kicks as u128;
+        let ns = |d: Duration| d.as_nanos() / n;
+        println!(
+            "{:<24} {:>10} ns/kick  readout {:>9} tide {:>8} bind {:>9}  tubes {:>8} digest {}",
+            scene.name,
+            ns(t.readout + t.tide + t.bind),
+            ns(t.readout),
+            ns(t.tide),
+            ns(t.bind),
+            n * repeats,
+            &hash.to_hex()[..16],
+        );
+    }
+
+    // Compile-only cost: the shape table rebuild every rebind pays when its key
+    // is new (the memo hits 0% on distinct kicks). Keys sweep the same shape class.
+    for scene in &scenes {
+        let mut best_compile = u128::MAX;
+        let mut knots = 0usize;
+        for _r in 0..repeats {
+            let now = Instant::now();
+            for i in 0..scene.kicks as i64 {
+                let key = OrbitKey::new(
+                    scene.key.periapsis.add(s(i)).expect("p+i"),
+                    scene.key.k,
+                )
+                .expect("key");
+                let orbit = Orbit::compile(key).expect("compile");
+                knots = orbit.shape().knots().len();
+            }
+            best_compile = best_compile.min(now.elapsed().as_nanos() / scene.kicks as u128);
+        }
+        println!("{:<24} {:>10} ns/compile  knots {}", scene.name, best_compile, knots);
+    }
+}
