+//! Micro: cos, isqrt, div_word, product — the fast_quad node primitives.
+use std::time::Instant;
+
+fn main() {
+    // emulate strong-ecc nodes: psi spanning the orbit, denominator like q=2^-16.6
+    let n = 1_000_000u32;
+    let psi_values: Vec<i128> = (0..n).map(|i| (i as i128 * 7_244_019_458_077_122_847 / n as i128)).collect();
+    let q: i128 = ((1u128 << 62) / 100_000u128) as i128;
+    let k: i128 = (1i128 << 62) * 2 / 3;
+
+    let mut sink = 0u128;
+    let t = Instant::now();
+    for &psi in &psi_values {
+        sink += emergent_space::num::cos(psi) as u128;
+    }
+    println!("cos       {:>6} ns  sink {sink}", t.elapsed().as_nanos() / n as u128);
+
+    let t = Instant::now();
+    for &psi in &psi_values {
+        let ac = (( (1i128<<62) - k) * emergent_space::num::cos(psi)) >> 62;
+        let x = k + ac;
+        let a = 6 * k + 2 * ac;
+        let denominator = (1i128 << 62) - ((q * a) >> 62);
+        let root = ((denominator as u64).isqrt() as u128) << 31;
+        let horizon = (1i128 << 62) - (((2 * q) * x) >> 62);
+        sink += root + horizon as u128;
+    }
+    println!("cos+shape {:>6} ns  sink {sink}", t.elapsed().as_nanos() / n as u128);
+
+    let roots: Vec<u64> = psi_values.iter().map(|&p| {
+        let ac = (((1i128<<62) - k) * emergent_space::num::cos(p)) >> 62;
+        let a = 6 * k + 2 * ac;
+        let d = (1i128 << 62) - (((1i128<<62)/100_000) * a >> 62);
+        (((d as u64).isqrt() as u128) << 31) as u64
+    }).collect();
+    let t = Instant::now();
+    for &r in &roots {
+        sink += emergent_space::num::div_word(1u128 << 104, r) as u128;
+    }
+    println!("div_word  {:>6} ns  sink {sink}", t.elapsed().as_nanos() / n as u128);
+
+    let t = Instant::now();
+    for &r in &roots {
+        sink += ((1u128 << 104) / r as u128) as u128;
+    }
+    println!("u128 div  {:>6} ns  sink {sink}", t.elapsed().as_nanos() / n as u128);
+
+    let t = Instant::now();
+    for &p in &psi_values {
+        let ac = (((1i128<<62) - k) * emergent_space::num::cos(p)) >> 62;
+        let x = k + ac;
+        sink += ((x as u128) << 40) / 1000;
+    }
+    println!("i128 mul  {:>6} ns  sink {sink}", t.elapsed().as_nanos() / n as u128);
+}
