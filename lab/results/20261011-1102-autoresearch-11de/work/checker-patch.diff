diff --git a/crates/space/examples/advbench.rs b/crates/space/examples/advbench.rs
new file mode 100644
index 00000000..a94ebd8c
--- /dev/null
+++ b/crates/space/examples/advbench.rs
@@ -0,0 +1,126 @@
+//! Checker's adversarial scenes for run 20261011-1102: extremes around the
+//! div_word preconditions (word_root path, near-separatrix, e->1, minimal e,
+//! p=1e12) — digest must match the baseline build bit for bit.
+use emergent_space::binding::cartesian;
+use emergent_space::events::handoff::bind;
+use emergent_space::events::kicks::parent_tide;
+use emergent_space::orbit::{Orbit, OrbitKey, Scalar};
+use emergent_space::tube::{Catalogue, TubeEvent};
+use std::time::Instant;
+
+fn s(n: i64) -> Scalar {
+    Scalar::integer(n)
+}
+
+struct Scene {
+    name: &'static str,
+    key: OrbitKey,
+    units: (i16, i16),
+    clock_exp: i16,
+    interval: i64,
+    tide_mass: Scalar,
+    tide_centre: [Scalar; 2],
+    kicks: usize,
+}
+
+fn run(scene: &Scene, digest: &mut blake3::Hasher) -> Result<(), String> {
+    let orbit = Orbit::compile(scene.key).map_err(|e| format!("compile: {e:?}"))?;
+    let state = orbit.state(Scalar::ZERO).map_err(|e| format!("state: {e:?}"))?;
+    let exact = cartesian(state, 0, false, scene.units).map_err(|e| format!("cartesian: {e:?}"))?;
+    let mut catalogue = Catalogue::default();
+    let mut event: TubeEvent =
+        bind(exact, 0, scene.clock_exp, None, &mut catalogue).map_err(|e| format!("first bind: {e:?}"))?;
+    let h = Scalar::raw(scene.interval as i128, scene.clock_exp as i32).map_err(|e| format!("interval: {e:?}"))?;
+    for k in 1..=scene.kicks {
+        let tick = (k as i64) * scene.interval;
+        let st = event.reconstruct(&catalogue).map_err(|e| format!("reconstruct: {e:?}"))?;
+        let x = [
+            Scalar::raw(st.position[0] as i128, scene.units.0 as i32).map_err(|e| format!("x0: {e:?}"))?,
+            Scalar::raw(st.position[1] as i128, scene.units.0 as i32).map_err(|e| format!("x1: {e:?}"))?,
+        ];
+        let v = [
+            Scalar::raw(st.velocity[0] as i128, scene.units.1 as i32).map_err(|e| format!("v0: {e:?}"))?,
+            Scalar::raw(st.velocity[1] as i128, scene.units.1 as i32).map_err(|e| format!("v1: {e:?}"))?,
+        ];
+        let a = parent_tide(scene.tide_mass, scene.tide_centre, x).map_err(|e| format!("tide: {e:?}"))?;
+        let dv = [
+            a[0].mul(h).map_err(|e| format!("dv0: {e:?}"))?,
+            a[1].mul(h).map_err(|e| format!("dv1: {e:?}"))?,
+        ];
+        let to_int = |val: Scalar, e: i16| -> i64 {
+            i64::try_from(val.fixed(-(e as i32)).expect("fits")).expect("word")
+        };
+        let next = emergent_space::binding::IntegerState {
+            position: st.position,
+            velocity: [
+                to_int(v[0].add(dv[0]).expect("v0+dv0"), scene.units.1),
+                to_int(v[1].add(dv[1]).expect("v1+dv1"), scene.units.1),
+            ],
+            length_exponent: st.length_exponent,
+            velocity_exponent: st.velocity_exponent,
+        };
+        event = bind(next, tick, scene.clock_exp, None, &mut catalogue).map_err(|e| format!("rebind {k}: {e:?}"))?;
+        digest.update(&event.tube.key.to_le_bytes());
+        digest.update(&event.tube.periapsis_angle.to_le_bytes());
+        digest.update(&event.tube.periapsis_time.get().to_le_bytes());
+        for r in event.residual.position.iter().chain(event.residual.velocity.iter()) {
+            digest.update(&r.to_le_bytes());
+        }
+    }
+    Ok(())
+}
+
+fn scene(
+    name: &'static str,
+    p: i64,
+    e_q48: u64,
+    units: (i16, i16),
+    clock_exp: i16,
+    interval: i64,
+    mass_exp: i16,
+    centre: i64,
+) -> Scene {
+    Scene {
+        name,
+        key: OrbitKey::bound(s(p), e_q48).expect("key"),
+        units,
+        clock_exp,
+        interval,
+        tide_mass: s(1).scale(mass_exp as i32).expect("m"),
+        tide_centre: [s(centre), Scalar::ZERO],
+        kicks: 64,
+    }
+}
+
+fn main() {
+    let scenes = vec![
+        // ultra-weak field, huge orbit
+        scene("adv-p1e12-e0.5", 1_000_000_000_000, 1 << 47, (-18, -28), -18, 1 << 14, -18, 3_000_000_000_000),
+        // deep, word_root path (delta = 0.79 >= 1/4), eccentric
+        scene("adv-p40-e0.75", 40, 3 << 46, (-6, -16), -8, 1 << 10, -10, 120),
+        scene("adv-p100-e0.999", 100, 281192871938345, (-12, -22), -12, 1 << 11, -12, 300),
+        // deep, word_root, e = 0.999 (k = 0.5002), near separatrix
+        
+        // extreme ecc, wide apoapsis, weak field
+        scene("adv-p1e3-e0.9999", 1_000, 281446163533824, (-16, -26), -16, 1 << 13, -16, 3_000),
+        // minimal eccentricity (k within an ulp of UNIT): tightest ratio corner
+        scene("adv-p1e5-emin", 100_000, 1, (-14, -24), -14, 1 << 12, -14, 300_000),
+        // mid regime, e = 0.25
+        scene("adv-p1e6-e0.25", 1_000_000, 1 << 46, (-16, -26), -16, 1 << 13, -16, 3_000_000),
+    ];
+    for scene in &scenes {
+        let now = Instant::now();
+        let mut digest = blake3::Hasher::new();
+        if let Err(e) = run(scene, &mut digest) {
+            println!("{:<20} ERROR {e}", scene.name);
+            continue;
+        }
+        let hash = digest.finalize();
+        println!(
+            "{:<20} {:>8} us total  digest {}",
+            scene.name,
+            now.elapsed().as_nanos() / 1000,
+            &hash.to_hex()[..16],
+        );
+    }
+}
diff --git a/crates/space/examples/kickbench.rs b/crates/space/examples/kickbench.rs
