+/// Whether the genesis stagger is on (lab run 20261015-1338-second-20261015-0724-system-3294-f82a):
+/// see [`Work::plan_clock`]. Read once; off by default, so the shipped tree is bit-identical without it.
+fn stagger_on() -> bool {
+    static ON: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var("STAGGER_GENESIS").is_ok_and(|v| v != "0"));
+    *ON
+}
+
+/// The offset of a body's first clock begin: `splitmix64(id) mod span`, a fixed constant of the body.
+fn genesis_stagger(i: usize, span: u64) -> u64 {
+    if !stagger_on() || span == 0 {
+        return 0;
+    }
+    let mut z = (i as u64).wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^= z >> 31;
+    z % span
+}
+
