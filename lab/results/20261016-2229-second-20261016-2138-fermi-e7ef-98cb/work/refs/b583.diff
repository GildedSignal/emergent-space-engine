+    let reach = (b.residual.position[0].unsigned_abs() + b.residual.position[1].unsigned_abs()).saturating_add(8);
+    let reach = Scalar::raw(reach.min(i64::MAX as u128) as i128, b.units.0 as i32).ok()?;
+    let fall = b.to_doll(at.radial_velocity).ok()?.abs().mul(time_of(1, b.clock_exp).ok()?).ok()?;
+    if fall.is_zero() {
+        return None;
+    }
+    Some((reach.div(fall).ok()?.fixed_ceil(0).ok()? as i64).saturating_add(1).min(CAP))
+}
