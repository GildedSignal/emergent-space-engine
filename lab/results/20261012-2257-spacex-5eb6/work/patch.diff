+    /// diagnose a stalled frame.
+    pub fn debug_queues(&self) -> String {
+        let tq = self.tqueue.as_ref().and_then(|q| q.peek()).map(|(s, e)| (s.fixed(0).unwrap_or(i128::MAX), e));
+        let dq = self.queue.as_ref().and_then(|q| q.peek()).map(|(s, e)| (s.fixed(0).unwrap_or(i128::MAX), e));
+        format!(
+            "now {} target {} wander {} | tqueue {:?} (key {:?}) | dqueue {:?} (key {:?}) | player key {:?} pending {:?} handouts {} resolved {}",
+            self.now, self.target, self.wander, tq, tq.and_then(|(_, e)| self.key_of(e)), dq, dq.and_then(|(_, e)| self.key_of(e)),
+            self.player.and_then(|p| self.key_of(p)), self.pending.front(), self.handouts.len(), self.resolved
+        )
+    }
