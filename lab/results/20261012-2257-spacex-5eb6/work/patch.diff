new file mode 100644
index 00000000..c79d07ca
--- /dev/null
+++ b/crates/universe/examples/lazy_probe.rs
@@ -0,0 +1,142 @@
+//! Lab probe 20261012-2257-spacex-5eb6: the zero-event frame tier and digest identity under the
+//! lazy rekey and the tick-due frame loop (`ES_EAGER=1` in the environment restores the shipped
+//! loop for the A/B arm; run this binary once per arm and diff).
+//!
+//! `quiet`: a player and `n` bare tubes (nothing pulls them, so nothing is due) at rtf 100 — the
+//! frame's whole cost is the fixed tier. Prints per-frame µs (median, p99, max), full rekey sweeps,
+//! events and the digest.
+//!
+//! `fly`: the plane (star, planets, moon, ships, a fleet battle, the player with an input log) run
+//! at (rtf, threads, engine budget) to a canonical cut, settled and digested: one digest per
+//! configuration, all of which must agree whatever the schedule.
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::{Budget, Config};
+use std::time::Instant;
+
+fn pct(v: &[f64], p: f64) -> f64 {
+    let mut v = v.to_vec();
+    v.sort_by(|a, b| a.total_cmp(b));
+    v[((p * (v.len() - 1) as f64).round()) as usize]
+}
+
+fn quiet(n: usize, frames: usize, rtf: f64) {
+    use emergent_space::orbit::Scalar;
+    use emergent_universe::num::from_f64;
+    use emergent_universe::{Kind, OrbitSpec, Universe};
+    let t0 = Instant::now();
+    // The player circles the star at 1 AU; the population is n hyperbolic flybys spread over
+    // bearings and radii (bare tubes: nothing pulls them, so nothing is ever due).
+    let mut u = Universe::new(Scalar::integer(emergent_universe::scenario::STAR_RADIUS as i64), Config::default());
+    let _player = u
+        .add_body(Kind::Player, OrbitSpec { doll: 0, periapsis: from_f64(1.0e8), e_q48: 0, clockwise: false, angle: 0, phase: 0 }, Scalar::ZERO)
+        .unwrap();
+    for j in 0..n {
+        let th = (j as f64 + 0.5) / n as f64 * std::f64::consts::TAU;
+        let r = 1.0e8 + 1.0e6 * th / std::f64::consts::TAU;
+        let p = [r * th.cos(), r * th.sin()];
+        let d = (p[0] * p[0] + p[1] * p[1]).sqrt();
+        let v = 1.0e-3; // hyperbolic at 1 AU, tangential: never near-radial
+        u.add_body_state(Kind::Ship, 0, [from_f64(p[0]), from_f64(p[1])], [from_f64(-v * p[1] / d), from_f64(v * p[0] / d)], Scalar::ZERO).unwrap();
+    }
+    u.start().unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let mut per = Vec::with_capacity(frames);
+    let mut events = 0u64;
+    for _ in 0..frames {
+        let f = Instant::now();
+        let fr = u.frame_to(1.0 / 60.0, rtf, Budget::unlimited(), i64::MAX);
+        per.push(f.elapsed().as_secs_f64() * 1e6);
+        events += fr.events;
+    }
+    println!(
+        "{{\"case\":\"quiet\",\"n\":{n},\"frames\":{frames},\"build_s\":{build:.2},\"median_us\":{:.2},\"p99_us\":{:.2},\"max_us\":{:.2},\"rekeys\":{},\"events\":{events},\"digest\":\"{}\"}}",
+        pct(&per, 0.5), pct(&per, 0.99), per.iter().cloned().fold(0.0, f64::max), u.stats.rekeys, &u.digest()[..16]
+    );
+}
+
+fn fly(seed: u64, rtf: f64, threads: usize, wall_ms: f64, log: &[(i64, u8)], cut: i64) -> String {
+    let mut p = plane(Config::default(), seed, Order::Sparse, threads, 16).unwrap();
+    for &(t, k) in log {
+        p.u.schedule(t, k).unwrap();
+    }
+    let mut frames = 0usize;
+    while p.u.now < cut && frames < 40_000 {
+        p.u.frame_to(1.0 / 60.0, rtf, Budget::wall(wall_ms), cut);
+        frames += 1;
+    }
+    p.u.settle(cut);
+    let s = p.u.stats;
+    println!(
+        "{{\"case\":\"fly\",\"seed\":{seed},\"rtf\":{rtf},\"threads\":{threads},\"wall_ms\":{wall_ms},\"frames\":{frames},\"events\":{},\"kicks\":{},\"rekeys\":{},\"digest\":\"{}\"}}",
+        s.events(), s.kicks, s.rekeys, &p.u.digest()[..16]
+    );
+    p.u.digest()
+}
+
+fn main() {
+    let mode = std::env::args().nth(1).unwrap_or_default();
+    if mode == "starve" {
+        starve();
+        return;
+    }
+    if mode == "quiet" {
+        for n in [428usize, 10_000, 40_000, 100_000, 200_000] {
+            quiet(n, 200, 100.0);
+        }
+        return;
+    }
+    // The input log is absolute ticks, identical in every arm and every schedule.
+    let log: Vec<(i64, u8)> = (0..24).map(|i| (5_000_000 + i * 12_000_000, if i % 3 == 0 { 1 } else { 2 })).collect();
+    let cut = 290_000_000i64;
+    let mut all = Vec::new();
+    for seed in [1u64, 3, 7] {
+        for (rtf, threads, wall) in [(100.0f64, 1usize, 5.0f64), (100.0, 4, 5.0), (1.0, 1, 5.0), (1000.0, 1, 5.0), (100.0, 1, 0.05)] {
+            all.push((fly(seed, rtf, threads, wall, &log, cut), seed, rtf, threads, wall));
+        }
+    }
+    // One digest per seed whatever the schedule: every config is checked against its own
+    // seed's first config (different seeds are different scenarios and never share a digest).
+    let mut first: std::collections::HashMap<u64, String> = std::collections::HashMap::new();
+    for (d, s, ..) in &all {
+        first.entry(*s).or_insert_with(|| d.clone());
+    }
+    let moved: Vec<_> = all.iter().filter(|(d, s, ..)| *d != first[s]).collect();
+    println!(
+        "{{\"case\":\"identity\",\"configs\":{},\"agree\":{},\"disagree\":[{}]}}",
+        all.len(),
+        moved.is_empty(),
+        moved.iter().map(|(_, s, r, t, w)| format!("\"{s}/{r}/{t}/{w}\"")).collect::<Vec<_>>().join(",")
+    );
+}
+
+fn starve() {
+    let mut p = plane(Config::default(), 11, Order::Sparse, 1, 24).unwrap();
+    let mut dips = 0;
+    for _ in 0..200 {
+        let f = p.u.frame(1.0 / 60.0, 5_000_000.0, Budget::events(3));
+        dips += f.overflow as u32;
+    }
+    let h = p.u.now;
+    let mut q = plane(Config::default(), 11, Order::Sparse, 1, 24).unwrap();
+    q.u.settle(h);
+    let mut r = plane(Config::default(), 11, Order::Sparse, 1, 24).unwrap();
+    for k in 1..=10 {
+        r.u.settle(h / 10 * k);
+    }
+    p.u.settle(h);
+    let line = |name: &str, u: &emergent_universe::Universe, n: usize| {
+        let s = u.stats;
+        println!(
+            "{{\"case\":\"starve\",\"arm\":\"{name}\",\"cut\":{h},\"bodies\":{n},\"events\":{},\"kicks\":{},\"opens\":{},\"boundaries\":{},\"handoffs\":{},\"lost\":{},\"refused\":{},\"slices\":{},\"encounters\":{},\"decisions\":{},\"leavers\":{},\"dissolved\":{},\"contacts\":{},\"rekeys\":{},\"digest\":\"{}\"}}",
+            s.events(), s.kicks, s.opens, s.boundaries, s.handoffs, s.lost, s.refused, s.slices, s.encounters, s.decisions, s.leavers, s.dissolved, u.contacts, s.rekeys, &u.digest()[..24]
+        );
+    };
+    eprintln!("overflow frames: {dips}");
+    for (name, u) in [("budgeted", &p.u), ("settled", &q.u), ("stepped", &r.u)] {
+        eprintln!("{name}: fleet tick {}, live {}", u.fleets[0].tick(), u.fleets[0].live());
+    }
+    line("budgeted", &p.u, p.u.n_bodies());
+    println!("{{\"case\":\"starve\",\"arm\":\"stepped-settle\",\"cut\":{h},\"digest\":\"{}\"}}", &r.u.digest()[..24]);
+    line("settled", &q.u, q.u.n_bodies());
+}
