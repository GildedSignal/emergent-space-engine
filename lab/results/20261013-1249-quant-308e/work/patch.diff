+    /// cos is data-independent (no tables, no data branches after entry), so a dense grid
+    /// plus LCG samples over [0, PI] carry the compile's own psi shapes.
+    fn operands(n: usize) -> Vec<i128> {
+        let mut psi = (0..n)
+            .map(|i| PI * (i as i128 + 1) / (n as i128 + 2))
+            .collect::<Vec<_>>();
+        let mut z: u128 = 0x243F_6A88_85A3_08D3;
+        for p in psi.iter_mut() {
+            z = z
+                .wrapping_mul(6364136223846793005)
+                .wrapping_add(1442695040888963407);
+            *p = (z % (PI as u128 + 1)) as i128;
+        }
+        psi[0] = 0;
+        psi[1] = PI;
+        psi[2] = PI / 2;
+        psi[3] = 1;
+        psi[4] = PI - 1;
+        psi
+    }
+
+    #[test]
+    #[ignore]
+    fn cos_variants() {
+        // fuzz: bit-identity of tuned and cos4 against cos (2M cases, lane-wise)
+        let psi = operands(1 << 21);
+        for chunk in psi.chunks(4) {
+            let c4in = [chunk[0], chunk[1], chunk[2], chunk[3]];
+            let c4 = cos4(c4in);
+            for i in 0..4 {
+                assert_eq!(cos(c4in[i]), cos_tuned(c4in[i]), "tuned {}", c4in[i]);
+                assert_eq!(cos(c4in[i]), c4[i], "cos4 lane {}", c4in[i]);
+            }
+        }
+        // bench
+        let psi = operands(2048);
+        let passes = 4000;
+        let mut sink = 0i128;
+        let t = Instant::now();
+        for _ in 0..passes {
+            for &p in &psi {
+                sink ^= cos(p);
+            }
+        }
+        std::hint::black_box(&sink);
+        let shipped = t.elapsed().as_secs_f64() / (passes * psi.len()) as f64;
+        let mut sink = 0i128;
+        let t = Instant::now();
+        for _ in 0..passes {
+            for &p in &psi {
+                sink ^= cos_tuned(p);
+            }
+        }
+        std::hint::black_box(&sink);
+        let tuned = t.elapsed().as_secs_f64() / (passes * psi.len()) as f64;
+        let packs: Vec<[i128; 4]> = psi.chunks(4).map(|c| [c[0], c[1], c[2], c[3]]).collect();
+        let mut sink = [0i128; 4];
+        let t = Instant::now();
+        for _ in 0..passes {
+            for &p in &packs {
+                let r = cos4(p);
+                for i in 0..4 {
+                    sink[i] ^= r[i];
+                }
+            }
+        }
+        std::hint::black_box(&sink);
+        let cos4_per = t.elapsed().as_secs_f64() / (passes * psi.len()) as f64;
+        // isqrt reference on the compile's own shapes (d << 62, d < 2^62)
+        let d: Vec<u128> = (0..2048u128).map(|i| ((i + 1) << 62) / 2048).collect();
+        let mut sink = 0u128;
+        let t = Instant::now();
+        for _ in 0..passes {
+            for &v in &d {
+                sink ^= isqrt(v);
+            }
+        }
+        std::hint::black_box(&sink);
+        let isqrt_ref = t.elapsed().as_secs_f64() / (passes * d.len()) as f64;
+        println!(
+            "cos shipped {:.1} ns | tuned {:.1} ns | cos4 lane {:.1} ns | isqrt(u128) ref {:.1} ns",
+            shipped * 1e9,
+            tuned * 1e9,
+            cos4_per * 1e9,
+            isqrt_ref * 1e9
+        );
+    }
