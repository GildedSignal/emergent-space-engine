+/// The identical thirteen floored nested products as [`cos`], written out: a control for
+/// codegen (loop versus straight line), bit-identical by fuzz.
+#[inline]
+#[allow(dead_code)]
+pub(crate) fn cos_tuned(psi: i128) -> i128 {
+    if psi == 0 {
+        return ONE;
+    }
+    if psi == PI {
+        return -ONE;
+    }
+    let x = (2 * psi - PI) as i64;
+    let x2 = ((x as i128 * x as i128) >> 62) as u64;
+    let mut s = ONE as u64;
+    macro_rules! step {
+        ($r:expr) => {{
+            let y = ((x2 as u128 * s as u128) >> 62) as u64;
+            s = ONE as u64 - ((y as u128 * ($r as u64 as u128)) >> 62) as u64;
+        }};
+    }
+    step!(SINE[12]);
+    step!(SINE[11]);
+    step!(SINE[10]);
+    step!(SINE[9]);
+    step!(SINE[8]);
+    step!(SINE[7]);
+    step!(SINE[6]);
+    step!(SINE[5]);
+    step!(SINE[4]);
+    step!(SINE[3]);
+    step!(SINE[2]);
+    step!(SINE[1]);
+    step!(SINE[0]);
+    -((x as i128 * s as i128) >> 62)
+}
+
+/// A/B scaffold for the interleaved-cos experiment (default on; COS4=0 disables).
+pub(crate) fn cos4_enabled() -> bool {
+    use std::sync::atomic::{AtomicU8, Ordering};
+    static ENABLED: AtomicU8 = AtomicU8::new(255);
+    let v = ENABLED.load(Ordering::Relaxed);
+    if v == 255 {
+        let on = match std::env::var("COS4") {
+            Ok(s) => s != "0",
+            Err(_) => true,
+        };
+        ENABLED.store(on as u8, Ordering::Relaxed);
+        return on;
+    }
+    v == 1
+}
+/// Four cosines in one pass. The four chains are independent, so the core overlaps
