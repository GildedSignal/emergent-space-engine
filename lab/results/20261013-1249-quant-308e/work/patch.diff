+// Orbit::compile wall on a plane-like key grid (weak field, the fast path), median of 3
+// repetitions per key. `ARM` is printed so base/patched runs can be diffed.
+use emergent_space::orbit::{Orbit, OrbitKey};
+use emergent_space::scaled::Scalar;
+use std::time::Instant;
+
+fn main() {
+    let arm = std::env::var("ARM").unwrap_or_else(|_| "base".into());
+    let mut keys = Vec::new();
+    for p_exp in [20i32, 24, 28, 32] {
+        for &e in &[0.0f64, 0.1, 0.3, 0.5, 0.7, 0.9, 0.99] {
+            let peri = Scalar::power_of_two(p_exp as i16);
+            let k = (2f64.powi(48) / (1.0 + e)) as u64;
+            keys.push((p_exp, e, OrbitKey::new(peri, k)));
+        }
+    }
+    let mut medians = Vec::new();
+    let mut refused = 0;
+    for (p_exp, e, key) in keys {
+        let key = match key {
+            Ok(k) => k,
+            Err(_) => {
+                refused += 1;
+                continue;
+            }
+        };
+        // warm + choose a rep count for ~40 ms per rep
+        let _ = Orbit::compile(key).unwrap();
+        let reps = 40;
+        let mut times = Vec::new();
+        for _ in 0..3 {
+            let t = Instant::now();
+            for _ in 0..reps {
+                std::hint::black_box(Orbit::compile(key).unwrap());
+            }
+            times.push(t.elapsed().as_secs_f64() / reps as f64);
+        }
+        times.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        medians.push((p_exp, e, times[1]));
+    }
+    medians.sort_by(|a, b| a.2.partial_cmp(&b.2).unwrap());
+    let mut line = String::new();
+    for (p, e, t) in &medians {
+        line.push_str(&format!("p2^{p} e{e:.2} {:.1}us | ", t * 1e6));
+    }
+    let mid = medians.len() / 2;
+    println!(
+        "ARM {arm}: median compile {:.1} us (min {:.1}, max {:.1}, n {}, refused {refused})",
+        medians[mid].2 * 1e6,
+        medians[0].2 * 1e6,
+        medians[medians.len() - 1].2 * 1e6,
+        medians.len()
+    );
+    println!("{line}");
+}
