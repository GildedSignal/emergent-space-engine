+// The plane's canonical digest over a fixed settle, for A/B identity checks.
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::Config;
+
+fn main() {
+    let h: i64 = std::env::args()
+        .nth(1)
+        .and_then(|a| a.parse().ok())
+        .unwrap_or(10_000_000_000);
+    let mut p = plane(Config::default(), 1, Order::Sparse, 1, 48).unwrap();
+    let t = std::time::Instant::now();
+    p.u.settle(h);
+    let s = p.u.stats;
+    println!(
+        "digest {} settle {} wall {:.1}s items {} encounters {} refused {} lost {}",
+        p.u.digest(),
+        h,
+        t.elapsed().as_secs_f64(),
+        s.kicks + s.opens + s.boundaries,
+        s.encounters,
+        s.refused,
+        s.lost
+    );
+}
