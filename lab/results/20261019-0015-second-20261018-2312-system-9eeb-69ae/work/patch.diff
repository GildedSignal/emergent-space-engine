index 00000000..ba1ca397
--- /dev/null
+++ b/crates/universe/tests/qbelt.rs
@@ -0,0 +1,69 @@
+//! The belt's cell census at the law's 11+11 width — the unmeasured half of the cell-served
+//! rebind's adoption decision (20261018-2312-system-9eeb's open direction 1, the checker's named
+//! gold experiment). Question: does a scattered belt (uniform a in [2, 3) AU, e Rayleigh σ 0.07,
+//! one exact orbit per body, `scenario::ladder_ship`) occupy one standing cell per body — the
+//! memory win caps at eviction — or sublinear, saturating cells? On the weak branch
+//! (`compactness ≤ 2^-18`) `MemoCode::shape_bits` drops the radius entirely, so the prediction is
+//! that the belt's cells are its gap classes alone.
+//!
+//! Instrument: the served memo itself (`orbit::qmemo_stats`), read through the shipped birth path
+//! (`Universe::add_body` → `spec_binding` → `orbit::served` under `ES_QMEMO=1`). Nothing is
+//! re-implemented; the census counts the memo's own distinct shape keys after construction, so
+//! "cells" here is exactly the standing-table size the engine would hold. Cumulative across the
+//! sequentially built universes of one process; the belt's contribution at N is the growth over
+//! the same plane built with extra = 0.
+use emergent_space::orbit;
+use emergent_universe::scenario::{ladder_locals, plane_extra};
+use emergent_universe::{Config, Order};
+
+fn census_at(extra: usize, seed: u64) -> (usize, u64, u64) {
+    // Identical plane (seed, members, order), `extra` ladder ships more. The thread-local served
+    // memo is cumulative, so the deltas between successive calls are each population's share.
+    let p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, extra).unwrap();
+    let (hits, builds, cells) = orbit::qmemo_stats();
+    let _ = p; // constructed and started inside; kept alive to here for clarity
+    (cells, hits, builds)
+}
+
+#[test]
+fn the_belts_cells_saturate_in_bodies() {
+    std::env::set_var("ES_QMEMO", "1");
+    let base = census_at(0, 1).0;
+    let n1 = 2_000;
+    let n2 = 4_000;
+    let (c1, h1, b1) = census_at(n1, 1);
+    let (c2, h2, b2) = census_at(n2, 1);
+    // The belt share of each run: cells beyond the plane's own, and builds beyond the plane's.
+    let belt1 = c1 - base;
+    let belt2 = c2 - c1;
+    let belt_bodies1 = n1 - ladder_locals(n1 as u64) as usize;
+    let belt_bodies2 = n2 - ladder_locals(n2 as u64) as usize;
+    println!(
+        "census: plane base {base} cells | +{n1} ladder ({} belt) -> {belt1} new cells, {} new builds | +{n2} ladder ({} belt) -> {belt2} more cells, {} more builds",
+        belt_bodies1,
+        b1,
+        belt_bodies2,
+        b2 - b1
+    );
+    println!(
+        "cells per belt body: {:.4} at N={}, {:.4} at N={} (cumulative belt cells {} for {} belt bodies, ratio {:.3})",
+        belt1 as f64 / belt_bodies1 as f64,
+        n1,
+        (c2 - base) as f64 / belt_bodies2 as f64,
+        n2,
+        c2 - base,
+        belt_bodies2,
+        (c2 - base) as f64 / belt_bodies2 as f64
+    );
+    // P4: sublinear and saturating — doubling the belt adds fewer cells than the first ladder
+    // held, and the per-body ratio at 4k is below half the (already sublinear) 2k ratio.
+    assert!(belt2 < belt1, "not saturating: {} then {}", belt1, belt2);
+    assert!(
+        (c2 - base) as f64 / belt_bodies2 as f64 < 0.2,
+        "cells per belt body {} at N={}",
+        (c2 - base) as f64 / belt_bodies2 as f64,
+        n2
+    );
+    // The served path really carried these births (builds grew with each ladder).
+    assert!(b2 > b1 && b1 > 0, "births did not serve: {} {} {}", b1, b2, h2);
+}
