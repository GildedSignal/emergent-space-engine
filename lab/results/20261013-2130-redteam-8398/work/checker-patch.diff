+//! Checker probe for 20261013-2130-redteam-8398: adversarial cases on the order-boundary
+//! round trip. (A) walk depth k > 2 (the author's named first checker experiment) with
+//! SIGNED k drift and later-time divergence against the original tube; (B) cases outside
+//! the author's grid: p beyond 1000 (galaxy scale), e beyond 0.999, retrograde sense,
+//! unbound passages. Integer decisions only.
+use emergent_space::{
+    binding::{self, IntegerState, Rebinding},
+    orbit::{Orbit, OrbitKey, Scalar},
+};
+
+fn walk(p: i64, e: f64, word: &str, steps: usize, clockwise: bool) {
+    let k0 = (e * 2f64.powi(48)).round() as u64;
+    let key = match (OrbitKey::bound(Scalar::integer(p), k0), Orbit::compile(match OrbitKey::bound(Scalar::integer(p), k0) { Ok(k) => k, Err(e) => panic!("{e:?}") })) {
+        (Ok(k), Ok(_)) => k,
+        (k, _) => { println!("walk p={p} e={e}: key refused {k:?}"); return }
+    };
+    let orbit = Orbit::compile(key).unwrap();
+    let period = orbit.period().unwrap();
+    let t_ev = match period.scale(-2).ok().and_then(|t| orbit.signed_state(t).ok().map(|_| t)) {
+        Some(t) => t,
+        None => match period.scale(-3).ok().and_then(|t| orbit.signed_state(t).ok().map(|_| t)) {
+            Some(t) => t,
+            None => { println!("walk p={p} e={e}: decode refused at P/4 and P/8"); return }
+        }
+    };
+    let st0 = orbit.signed_state(t_ev).unwrap();
+    let mut units = match word {
+        "fine" => (st0.radius.exponent() - 60, st0.transverse_velocity.abs().exponent() - 60),
+        "coarse" => (-20, -50),
+        _ => unreachable!(),
+    };
+    let input0 = match binding::cartesian(st0, 0, clockwise, units) {
+        Ok(s) => s,
+        Err(_) => {
+            units = (-20, -50);
+            match binding::cartesian(st0, 0, clockwise, units) {
+                Ok(s) => s,
+                Err(err) => { println!("walk p={p} e={e}: cartesian refused {err:?} (fine and coarse)"); return }
+            }
+        }
+    };
+    let mut fit = Rebinding::from_state(input0, t_ev, None).unwrap();
+    println!(
+        "walk p={p} e={e} {word} sense={} key0.k={} reconstruct(input)=={}",
+        if clockwise { "retro" } else { "pro" },
+        key.k,
+        fit.reconstruct().unwrap() == input0
+    );
+    let t_probe = t_ev.add(period.scale(-3).unwrap()).unwrap();
+    let mut prev = (key.k, None::<u32>, Some(key));
+    for i in 1..=steps {
+        let st = match fit.decoded_event() {
+            Ok(x) => x,
+            Err(err) => { println!("  step {i}: decode refused {err:?}"); break }
+        };
+        fit = match Rebinding::from_state(st, t_ev, None) {
+            Ok(f) => f,
+            Err(err) => { println!("  step {i}: refit refused {err:?}"); break }
+        };
+        let k = fit.trajectory.key().unwrap();
+        let s_dk = k.k as i64 - prev.0 as i64;
+        let dang = prev.1.map_or(0, |a| fit.periapsis_angle.abs_diff(a));
+        let key_same = prev.2.map_or(false, |p| p == k);
+        let div = (|| -> Option<i128> {
+            let orig = binding::cartesian(orbit.signed_state(t_probe).ok()?, 0, false, units).ok()?;
+            let now = binding::cartesian(
+                fit.trajectory.state(t_probe.sub(fit.periapsis_time).ok()?).ok()?,
+                fit.periapsis_angle, fit.clockwise, units).ok()?;
+            Some(orig.position.iter().zip(now.position.iter()).map(|(a, b)| (*a as i128 - *b as i128).abs()).max().unwrap())
+        })();
+        println!("  step {i}: k={} signed_dk={s_dk} dang={dang} full_key_same={key_same} div_pos_later={div:?} resid_max={}",
+            k.k,
+            fit.residual.position.iter().map(|x| x.abs()).max().unwrap_or(0));
+        prev = (k.k, Some(fit.periapsis_angle), Some(k));
+    }
+}
+
+fn passage_probe(r0: f64, b: f64, e: f64) {
+    // clock.rs conventions: positions n*2^-34, velocities n*2^-60, M = 1.
+    let (le, ve) = (-34i16, -60i16);
+    let f = 1.0 - 2.0 / r0;
+    let vt = b * (e * e - 1.0).sqrt() * f / (r0 * e);
+    let vr = (f * (f - vt * vt - f * f / (e * e))).sqrt();
+    let s0 = IntegerState {
+        position: [(r0 * 2f64.powi(-(le as i32))) as i64, 0],
+        velocity: [(vr * 2f64.powi(-(ve as i32))) as i64, (vt * 2f64.powi(-(ve as i32))) as i64],
+        length_exponent: le,
+        velocity_exponent: ve,
+    };
+    let t0 = Scalar::integer(1000);
+    let mut fit = Rebinding::from_state(s0, t0, None).unwrap();
+    let mut prev_k = fit.trajectory.key().unwrap();
+    println!("passage r0={r0:.1e} b={b:.1e} E~{e}: k0.k={} gap={:?}", prev_k.k, prev_k.gap.is_some());
+    for i in 1..=4 {
+        let st = match fit.decoded_event() {
+            Ok(x) => x,
+            Err(err) => { println!("  step {i}: decode refused {err:?}"); break }
+        };
+        fit = match Rebinding::from_state(st, t0, None) {
+            Ok(f) => f,
+            Err(err) => { println!("  step {i}: refit refused {err:?}"); break }
+        };
+        let k = fit.trajectory.key().unwrap();
+        println!("  step {i}: k={} signed_dk={} same_as_prev={} reconstruct=={}",
+            k.k, k.k as i64 - prev_k.k as i64, k == prev_k, fit.reconstruct().unwrap() == st);
+        prev_k = k;
+    }
+}
+
+fn main() {
+    println!("== A: walk depth (k > 2), signed drift, divergence vs original tube ==");
+    walk(8, 0.0, "fine", 16, false);
+    walk(20, 0.5, "fine", 16, false);
+    walk(20, 0.7, "coarse", 16, false);
+    walk(8, 0.9, "fine", 16, false);
+    walk(50, 0.999, "fine", 16, false);
+    println!("== B1/B2: p outside the author's range (grid stopped at 1000) ==");
+    walk(100_000, 0.5, "fine", 8, false);
+    walk(1_000_000, 0.5, "fine", 8, false);
+    println!("== B3: e outside the author's range (grid stopped at 0.999) ==");
+    walk(50, 0.9999, "fine", 8, false);
+    println!("== B4: retrograde sense (author decoded prograde only) ==");
+    walk(20, 0.5, "fine", 8, true);
+    walk(8, 0.9, "fine", 8, true);
+    println!("== B5: unbound passages (author tested bound keys only) ==");
+    passage_probe(1.5e8, 9.0e7, 1.5);
+    passage_probe(1.0e4, 3.0e2, 12.0);
+}
diff --git a/crates/space/examples/transit_roundtrip.rs b/crates/space/examples/transit_roundtrip.rs
