 }
 
 impl Ctx<'_> {
     /// Body `j`'s position and velocity at `t` in the units of the doll it sits in.
     pub fn state_of(&self, j: usize, t: Tick) -> Res<(V2, V2)> {
+        if StateCache::disabled() {
+            return Self::state_uncached(self, j, t);
+        }
+        self.cache.calls.fetch_add(1, Relaxed);
+        if let Some(v) = self.cache.lock_of(j, t).get(&(j, t)) {
+            self.cache.hits.fetch_add(1, Relaxed);
+            return Ok(*v);
+        }
+        let v = Self::state_uncached(self, j, t)?;
+        let mut g = self.cache.lock_of(j, t);
+        if g.len() >= 1 << 14 {
+            g.clear();
+        }
+        g.insert((j, t), v);
+        Ok(v)
+    }
+    fn state_uncached(&self, j: usize, t: Tick) -> Res<(V2, V2)> {
         let b = self.bodies.binding_at(j, t).ok_or(crate::num::Error::Refused("history pruned"))?;
         b.cartesian(t)
     }
