diff --git a/crates/universe/src/prof.rs b/crates/universe/src/prof.rs
index 9c5438de..a87faf98 100644
--- a/crates/universe/src/prof.rs
+++ b/crates/universe/src/prof.rs
@@ -106,4 +106,89 @@ mod on {
 }
 
 pub use on::{add, count, t, take, T};
+
+/// The read census: who reads the body store, and what each read hits. Counters only, no
+/// timing; the feature `prof` gates every cost. A read is one [`crate::body::BodyStore`]
+/// call (`binding_at` or `rec`); the reason is set by the reader right before its call.
+pub mod reads {
+    pub const SCAN_OTHER: usize = 0;
+    pub const SCAN_ME: usize = 1;
+    pub const STATE: usize = 2;
+    pub const EXT: usize = 3;
+    pub const OBSERVE: usize = 4;
+    pub const HANDOFF: usize = 5;
+    pub const RAW: usize = 6;
+    pub const OTHER: usize = 7;
+    pub const REC_ADVANCE: usize = 8;
+    pub const REC_SETTLE: usize = 9;
+    pub const REC_DECIDE: usize = 10;
+    pub const REC_REPLAN: usize = 11;
+    pub const REC_SCAN: usize = 12;
+    pub const REC_DIGEST: usize = 13;
+    pub const REC_OTHER: usize = 14;
+    pub const NR: usize = 15;
+    pub const NAMES: [&str; NR] = [
+        "scan: candidate",
+        "scan: the player",
+        "state_of (sources, centres)",
+        "ext::source (kick sources)",
+        "observe (credit/ramped)",
+        "handoff centre",
+        "root_state_raw (own body)",
+        "other",
+        "rec: advance (per event)",
+        "rec: settle batch",
+        "rec: decide (player)",
+        "rec: replan (hand-out)",
+        "rec: player_scan",
+        "rec: digest",
+        "rec: other",
+    ];
+
+    #[cfg(feature = "prof")]
+    mod on {
+        use super::NR;
+        use std::cell::Cell;
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static B: [AtomicU64; NR * 3] = [const { AtomicU64::new(0) }; NR * 3];
+        static R: [AtomicU64; NR] = [const { AtomicU64::new(0) }; NR];
+        thread_local! {
+            static TAG: Cell<usize> = const { Cell::new(super::OTHER) };
+        }
+        #[inline(always)]
+        pub fn set(reason: usize) {
+            TAG.with(|t| t.set(reason));
+        }
+        /// A `binding_at` call that hit the current binding (outcome 0), a retired one (1), or nothing (2).
+        #[inline(always)]
+        pub fn hit(outcome: usize) {
+            let r = TAG.with(|t| t.get());
+            B[r * 3].fetch_add(1, Ordering::Relaxed);
+            B[r * 3 + 1 + outcome].fetch_add(1, Ordering::Relaxed);
+        }
+        #[inline(always)]
+        pub fn hit_rec() {
+            let r = TAG.with(|t| t.get());
+            R[r].fetch_add(1, Ordering::Relaxed);
+        }
+        pub fn take() -> ([u64; NR * 3], [u64; NR]) {
+            let b = std::array::from_fn(|i| B[i].swap(0, Ordering::Relaxed));
+            let r = std::array::from_fn(|i| R[i].swap(0, Ordering::Relaxed));
+            (b, r)
+        }
+    }
+    #[cfg(not(feature = "prof"))]
+    mod on {
+        #[inline(always)]
+        pub fn set(_reason: usize) {}
+        #[inline(always)]
+        pub fn hit(_outcome: usize) {}
+        #[inline(always)]
+        pub fn hit_rec() {}
+        pub fn take() -> ([u64; 0], [u64; 0]) {
+            ([], [])
+        }
+    }
+    pub use on::{hit, hit_rec, set, take};
+}
 pub const ENABLED: bool = cfg!(feature = "prof");
