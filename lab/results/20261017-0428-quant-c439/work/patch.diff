@@ -0,0 +1,118 @@
+//! The read census: who reads the body store during a flight, how often, and what each read
+//! hits. The plane with `N` more ships (`scenario::plane_extra`, the ladder's population),
+//! flown the way the page flies it (`frame_to`, 12 ms engine budget), the player coasting or
+//! burning forward at level 8 from the first second. Counters start at the first second (the
+//! opening exodus is not the read stream). With `--features prof` the census prints; without
+//! it the run is the shipped engine and prints the same digest (the counters are the only
+//! difference). After the flight, one pass of `binding_at` and one of `rec` over every body
+//! price the hit path on this box (the clone the scan pays per candidate).
+//!
+//! cargo run --release -p emergent-universe --example read_census [--features prof] -- <N> <coast|burn> [<wall seconds> [<rtf>]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(20.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms: f64 = 12.0;
+    let burn = flight == "burn";
+    let frames = (seconds * 60.0) as usize;
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let bodies = p.u.n_bodies();
+    println!("census: n={n} bodies={bodies} flight={flight} rtf={rtf} seconds={seconds} prof={}", emergent_universe::prof::ENABLED);
+    let mut t_first = None;
+    let mut s_first = None;
+    let mut alive = true;
+    for f in 0..frames {
+        if f == 60 {
+            if burn {
+                let t = p.u.now;
+                let _ = p.u.input(t, word(1, 8));
+            }
+            t_first = Some(p.u.now);
+            s_first = Some(p.u.stats);
+            let _ = emergent_universe::prof::take();
+            let _ = emergent_universe::prof::reads::take();
+        }
+        let start = Instant::now();
+        let _ = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)) }, i64::MAX);
+        if !p.u.rec(p.player).alive {
+            println!("player lost at frame {f}");
+            alive = false;
+            break;
+        }
+    }
+    let digest = p.u.digest();
+    let (t0, s0) = (t_first.unwrap_or(p.u.now), s_first.unwrap_or(p.u.stats));
+    let game_s = (p.u.now - t0) as f64 * emergent_universe::view::TICK_SECONDS;
+    let kicks = p.u.stats.kicks - s0.kicks;
+    let events = p.u.stats.events() - s0.events();
+    println!(
+        "flight: game {game_s:.1} s after the first second, kicks {kicks} events {events} alive {alive}; digest {digest}"
+    );
+    if emergent_universe::prof::ENABLED {
+        let (b, r) = emergent_universe::prof::reads::take();
+        let mut total = 0u64;
+        let mut tot_cur = 0u64;
+        let mut tot_hist = 0u64;
+        for k in 0..emergent_universe::prof::reads::NR {
+            let (c, cur, hist) = (b[k * 3], b[k * 3 + 1], b[k * 3 + 2]);
+            if c > 0 || r[k] > 0 {
+                println!(
+                    "  {:<32} binding_at {:>10} (current {:>10}, history {:>8}, miss {:>4}) = {:.3e}/body/game-s | rec {:>8} = {:.3e}/body/game-s",
+                    emergent_universe::prof::reads::NAMES[k],
+                    c,
+                    cur,
+                    hist,
+                    c - cur - hist,
+                    c as f64 / bodies as f64 / game_s.max(1e-9),
+                    r[k],
+                    r[k] as f64 / bodies as f64 / game_s.max(1e-9)
+                );
+            }
+            total += c;
+            tot_cur += cur;
+            tot_hist += hist;
+        }
+        println!(
+            "  total binding_at {total} = {:.3e}/body/game-s (current {tot_cur}, history {tot_hist}, miss {}); scans held {}",
+            total as f64 / bodies as f64 / game_s.max(1e-9),
+            total - tot_cur - tot_hist,
+            p.u.held_scans()
+        );
+    }
+    // The hit path's price on this box: one binding_at and one rec per body, at the flight's end.
+    {
+        let ctx = p.u.ctx();
+        let t = p.u.now;
+        let mut c = 0u64;
+        let tb = Instant::now();
+        for i in 0..ctx.bodies.len() {
+            if ctx.bodies.alive(i) && ctx.bodies.binding_at(i, t).is_some() {
+                std::hint::black_box(i);
+                c += 1;
+            }
+        }
+        let ns_read = tb.elapsed().as_nanos() as f64 / c.max(1) as f64;
+        let tb = Instant::now();
+        for i in 0..ctx.bodies.len() {
+            if ctx.bodies.alive(i) {
+                std::hint::black_box(ctx.bodies.rec(i).events);
+            }
+        }
+        let ns_rec = tb.elapsed().as_nanos() as f64 / c.max(1) as f64;
+        println!(
+            "hit path: binding_at {:.1} ns, rec {:.1} ns over {c} bodies; Binding {} B, BodyRec {} B",
+            ns_read,
+            ns_rec,
+            std::mem::size_of::<emergent_universe::bind::Binding>(),
+            std::mem::size_of::<emergent_universe::body::BodyRec>()
+        );
+    }
+}
