+fn chain_mark(u: &Universe, i: usize) -> Tick {
+    let b = u.bodies();
+    let mut m = b.event_time(i);
+    let mut cur = i;
+    while let Some(c) = u.dolls[b.doll(cur) as usize].centre {
+        m = m.max(b.event_time(c));
+        cur = c;
+    }
+    m
+}
+
+/// The display quantum: one length tolerance for the extrapolated view. `1e-4` of the emitter's
+/// distance bounds the direction error (rad, `Δpos⊥/dist`) and the relative light-seconds error
+/// (`Δpos∥/dist`) alike; the redshift is second order in it.
+fn tol_len(dist: f64) -> f64 {
+    1e-4 * dist
+}
+
+/// Re-arm the next checkpoint from a measured deviation: aim so that even a quartic growth of the
+/// deviation lands at the tolerance (planets approaching periapsis grow faster than τ²).
+fn arm_checkpoint(tau: f64, dev: f64, dist: f64) -> f64 {
+    let dev = dev.max(1e-12);
+    (tau * (tol_len(dist) * 0.5 / dev).powf(0.25)).clamp(tau * 1.2, tau * 4.0)
+}
