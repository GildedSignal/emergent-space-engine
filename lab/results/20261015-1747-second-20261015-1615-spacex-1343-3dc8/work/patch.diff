+//! The lazy-entry seam's certificate: `Universe::digest()` at a canonical cut on the ladder's
+//! populations, flown as `ladder_digest` flies them (`frame_to` limited to the cut tick, then
+//! `settle(cut)`), with the seam off (shipped verbatim) or on (`ES_LAZY_ENTRY=1`): the two arms
+//! must print the same digest bit for bit. Also prints the seam's counters (demotions,
+//! promotions, the promotion compile's p50/p99), the dashboard's `bytes_per_body`,
+//! `catalogue_live`, and the process's RSS/HWM.
+//!
+//! cargo run --release -p emergent-universe --example lazy_flight [-- <N> <coast|burn> <cut game-s> <seed> [<rtf>]]
+use emergent_universe::bind::lazy_counters;
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+
+/// (rss, hwm) in bytes on Linux.
+fn mem() -> (u64, u64) {
+    let s = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut rss = 0;
+    let mut hwm = 0;
+    for line in s.lines() {
+        if let Some(v) = line.strip_prefix("VmRSS:") {
+            rss = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0) * 1024;
+        }
+        if let Some(v) = line.strip_prefix("VmHWM:") {
+            hwm = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0) * 1024;
+        }
+    }
+    (rss, hwm)
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(1000);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let cut_game_s: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(20_000.0);
+    let seed: u64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let rtf: f64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(1000.0);
+    let burn = flight == "burn";
+    let t0 = std::time::Instant::now();
+
+    let mut p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    if burn {
+        let t = (1.0 * rtf / TICK_SECONDS) as i64;
+        p.u.schedule(t, word(1, 8)).unwrap();
+    }
+    let cut = (cut_game_s / TICK_SECONDS) as i64;
+    let mut frames = 0usize;
+    for _ in 0..4_000_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        p.u.frame_to(1.0 / 60.0, rtf, Budget::unlimited(), cut);
+        frames += 1;
+    }
+    p.u.settle(cut);
+    let d = p.u.digest();
+    let (rss, hwm) = mem();
+    let (dem, pro, ns, p50, p99, mx) = lazy_counters();
+    let s = &p.u.stats;
+    println!("arm N={n} {flight} cut={cut_game_s} seed={seed} rtf={rtf} lazy={}", emergent_universe::bind::lazy_entry_on());
+    println!("digest {d}");
+    println!(
+        "kicks {} opens {} boundaries {} handoffs {} lost {} refused {} slices {} contacts {}",
+        s.kicks, s.opens, s.boundaries, s.handoffs, s.lost, s.refused, s.slices, p.u.contacts
+    );
+    println!(
+        "bodies {} bytes_per_body {} catalogue_live {} demotions {dem} promotions {pro} promote_us p50 {:.2} p99 {:.2} max {:.2} total_s {:.2}",
+        p.u.n_bodies(),
+        p.u.bytes_per_body(),
+        p.u.catalogue_live(),
+        p50 as f64 / 1e3,
+        p99 as f64 / 1e3,
+        mx as f64 / 1e3,
+        ns as f64 / 1e9
+    );
+    println!("build_s {build:.2} frames {frames} wall_s {:.2} rss_mb {:.0} hwm_mb {:.0}", t0.elapsed().as_secs_f64(), rss as f64 / 1e6, hwm as f64 / 1e6);
+}
