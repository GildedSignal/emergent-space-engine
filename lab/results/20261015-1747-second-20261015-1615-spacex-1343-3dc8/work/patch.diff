+    let build = t0.elapsed().as_secs_f64();
+    if burn {
+        let t = (1.0 * rtf / TICK_SECONDS) as i64;
+        p.u.schedule(t, word(1, 8)).unwrap();
+    }
+    let cut = (cut_game_s / TICK_SECONDS) as i64;
+    let mut frames = 0usize;
+    for _ in 0..4_000_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        p.u.frame_to(1.0 / 60.0, rtf, Budget::unlimited(), cut);
+        frames += 1;
+    }
+    p.u.settle(cut);
+    let d = p.u.digest();
+    let reached = p.u.now;
+    // The census: standing compiled arcs vs demoted records, by kind, without minting anything
+    // (a demoted slot's kind is its record's: outer set = passage).
+    let (mut cyc, mut pas, mut plu, mut dead, mut dem_cyc, mut dem_pas) = (0usize, 0usize, 0usize, 0usize, 0usize, 0usize);
+    let (mut panels, mut standing, mut w_min, mut w_max) = (0usize, 0usize, i32::MAX, i32::MIN);
+    for i in 0..p.u.n_bodies() {
+        let r = p.u.rec(i);
+        if !r.alive {
+            dead += 1;
+            continue;
+        }
+        match &r.b.entry {
+            EntrySlot::Live(e) => match &e.trajectory {
+                emergent_space::binding::Trajectory::Cycle(o) => {
+                    cyc += 1;
+                    let sh = o.shape();
+                    standing += sh.knots().len() * std::mem::size_of::<emergent_space::orbit::Knot>()
+                        + sh.crossings().len() * std::mem::size_of::<usize>();
+                }
+                emergent_space::binding::Trajectory::Passage(q) => {
+                    pas += 1;
+                    panels += q.panels();
+                    let bts = q.retained_bytes();
+                    standing += bts;
+                    let mut w = 0i32;
+                    let huge = emergent_space::orbit::Scalar::power_of_two(62);
+                    while q.key().periapsis.mul(emergent_space::orbit::Scalar::power_of_two(w as i16)).unwrap_or(huge) < q.outer_radius {
+                        w += 1;
+                    }
+                    w_min = w_min.min(w);
+                    w_max = w_max.max(w);
+                }
+                emergent_space::binding::Trajectory::Plunge(_) => plu += 1,
+            },
+            EntrySlot::Demoted { outer: Some(_), .. } => dem_pas += 1,
+            EntrySlot::Demoted { outer: None, .. } => dem_cyc += 1,
+        }
+    }
+    let (rss, hwm) = mem();
+    let (dem, pro, ns, p50, p99, mx) = lazy_counters();
+    let (pdem, ppro, pns, pp50, pp99, ppmx) = lazy_passage_counters();
+    let s = &p.u.stats;
+    let arm = match (lazy_entry_on(), lazy_passages_demote_on()) {
+        (false, _) => "ctl",
+        (true, false) => "seam",
+        (true, true) => "variant",
+    };
+    println!("arm {arm} N={n} {flight} cut={cut_game_s} seed={seed} rtf={rtf}");
+    println!("digest {d}");
+    println!(
+        "kicks {} opens {} boundaries {} handoffs {} lost {} refused {} slices {} contacts {}",
+        s.kicks, s.opens, s.boundaries, s.handoffs, s.lost, s.refused, s.slices, p.u.contacts
+    );
+    println!(
+        "census cycles {cyc} passages {pas} (w [{}, {}], panels {panels}, standing {standing} B) plunges {plu} demoted_cycles {dem_cyc} demoted_passages {dem_pas} dead {dead}",
+        if w_min == i32::MAX { -1 } else { w_min },
+        if w_max == i32::MIN { -1 } else { w_max },
+    );
+    println!(
+        "bodies {} bytes_per_body {} catalogue_live {} demotions {dem} promotions {pro} promote_us p50 {:.2} p99 {:.2} max {:.2} total_s {:.2} | passage: demotions {pdem} promotions {ppro} promote_us p50 {:.2} p99 {:.2} max {:.2} total_s {:.2}",
+        p.u.n_bodies(),
+        p.u.bytes_per_body(),
+        p.u.catalogue_live(),
+        p50 as f64 / 1e3,
+        p99 as f64 / 1e3,
+        mx as f64 / 1e3,
+        ns as f64 / 1e9,
+        pp50 as f64 / 1e3,
+        pp99 as f64 / 1e3,
+        ppmx as f64 / 1e3,
+        pns as f64 / 1e9,
+    );
+    println!("reached {reached} build_s {build:.2} frames {frames} wall_s {:.2} rss_mb {:.0} hwm_mb {:.0} entryslot_b {} demoted_record_b {}", t0.elapsed().as_secs_f64(), rss as f64 / 1e6, hwm as f64 / 1e6, std::mem::size_of::<emergent_universe::bind::EntrySlot>(), {
