+    // (1.3 stellar radii), mixed = both at the same r0 (w=12). N is the comet count (or half of
+    // it, per class, for mixed).
+    let classes: Vec<(usize, i32, f64)> = match flight.as_str() {
+        "comet" => vec![(n, 12, 1.2)],
+        "stargraze" => vec![(n, 12, 0.006)],
+        "mixed" => vec![(n / 2, 12, 1.2), (n - n / 2, 12, 0.006)],
