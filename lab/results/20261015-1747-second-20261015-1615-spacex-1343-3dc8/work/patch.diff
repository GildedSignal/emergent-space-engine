+//! The demote-passages variant of the lazy-entry seam, flown for digest identity and priced
+//! (20261015-1615-spacex-1343's checker's named gold experiment). Three arms by environment:
+//! ctl (`ES_LAZY_ENTRY` unset: shipped, nothing demotes), seam (`ES_LAZY_ENTRY=1`: cycles
+//! demote, passages never — the rule as it stands), variant (`ES_LAZY_ENTRY=1
+//! ES_LAZY_PASSAGES=1`: passages demote too, the record carrying key + outer edge + sense/unit).
+//! Every arm must print the same digest at the same canonical cut. Scenes: the standard ladder
+//! (coast/burn) and the comet stream at mixed periapsis (1.2 AU and star-grazing), the passage
+//! tail's natural scene. Counters: demotions/promotions split cycle/passage, census of standing
+//! arcs vs demoted records, RSS.
+//!
+//! cargo run --release -p emergent-universe --example passage_demote [-- <N> <coast|burn|comet|stargraze|mixed> <cut game-s> [<seed> [<rtf>]]]
+use emergent_universe::bind::{lazy_counters, lazy_entry_on, lazy_passage_counters, lazy_passages_demote_on, EntrySlot};
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::{plane_comets, plane_extra};
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+
+/// (rss, hwm) in bytes on Linux.
+fn mem() -> (u64, u64) {
+    let s = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut rss = 0;
+    let mut hwm = 0;
+    for line in s.lines() {
+        if let Some(v) = line.strip_prefix("VmRSS:") {
+            rss = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0) * 1024;
+        }
+        if let Some(v) = line.strip_prefix("VmHWM:") {
+            hwm = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0) * 1024;
+        }
+    }
+    (rss, hwm)
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
