+//! The passage tail: standing bytes, compile cost and re-mint identity against the window
+//! exponent `w = log2(outer_radius / periapsis)`, on the law's own bind path
+//! (`Rebinding::from_state`, the same call the universe makes). Also the cycle control:
+//! knots against apoapsis span, and re-mint identity from the key alone.
+//!
+//! cargo run --release -p emergent-space --example passage_tail
+use emergent_space::binding::{IntegerState, Rebinding, Trajectory};
+use emergent_space::orbit::Scalar;
+use std::time::Instant;
+
+fn state_at(r0_q: i64, r0_e: i16, vt: i64, vr: i64, ve: i16) -> IntegerState {
+    IntegerState {
+        position: [r0_q, 0],
+        velocity: [vt, vr],
+        length_exponent: r0_e,
+        velocity_exponent: ve,
+    }
+}
+
+/// One unbound state (GM = 1 in the law's scaled units): r0 = 10^6, v = 2.0e-3 mostly
+/// tangential, 1.125e-6 > 1/r0 = 1e-6 specific orbital energy: hyperbolic, L = 1500.
+fn hyper_state() -> IntegerState {
+    state_at(1_000_000 << 20, -20, (1.5e-3 * (1u64 << 40) as f64) as i64, (-1.0e-3 * (1u64 << 40) as f64) as i64, -40)
+}
+
+/// A bound state at apoapsis (v purely tangential, v² < 2/r0): the cycle control.
+fn bound_state(vt: f64) -> IntegerState {
+    // position along +x, so the tangential direction is +y: v = (0, vt), v_r = 0 at apoapsis.
+    state_at(1_000_000 << 20, -20, 0, (vt * (1u64 << 40) as f64) as i64, -40)
+}
+
+fn main() {
+    println!(
+        "sizes: Scalar {} B, passage panel (Scalar, Integral) — measured below",
+        std::mem::size_of::<Scalar>()
+    );
+
+    // ---- the passage curve: w from 0 (Topology control) to the law's edge ----
+    println!("\n== passages: standing bytes and compile µs against w = log2(outer/periapsis) ==");
+    println!("(the state is fixed; the key's periapsis is read once, then the edge is peri·2^w)\n");
+    let probe = hyper_state();
+    let fit = Rebinding::from_state(probe.clone(), Scalar::ZERO, None).unwrap();
+    let Trajectory::Passage(p0) = &fit.trajectory else { panic!("state is not a passage") };
+    let peri = p0.key().periapsis;
+    println!(
+        "state minted: periapsis {peri:?}, r0 10^6, panels at birth(w≈0) {}, knots {}",
+        p0.panels(),
+        p0.orbit_knots()
+    );
+    let mut first_w = None;
+    for w in [0i32, 9, 10, 11, 12, 13, 16, 21, 26, 31, 36, 41, 51, 56, 59, 61] {
+        // edge = peri * 2^w, but the state's r0 must stay inside the window: bind from the
+        // state with the edge directly (from_state takes passage_edge).
+        let edge = peri.mul(Scalar::power_of_two(w as i16)).unwrap();
+        let fit = match Rebinding::from_state(probe.clone(), Scalar::ZERO, Some(edge)) {
+            Ok(f) => f,
+            Err(e) => {
+                println!("w={w:>3}: refused {e:?}");
+                continue;
+            }
+        };
+        let Trajectory::Passage(p) = &fit.trajectory else { panic!("not a passage") };
+        if first_w.is_none() {
+            first_w = Some(w);
+        }
+        let bytes = p.retained_bytes();
+        // re-mint: the same two arguments, twice; read at 64 radii across the window.
+        let again = Rebinding::from_state(probe.clone(), Scalar::ZERO, Some(edge)).unwrap();
+        let Trajectory::Passage(p2) = &again.trajectory else { panic!() };
+        let mut diffs = 0u32;
+        let mut readouts = 0u32;
+        for k in 0..64u32 {
+            // geometric radii from just above periapsis to just below the edge
+            let frac = ((k as i64 + 1) * (w as i64 + 2) / 65) as i32;
+            let r = peri.mul(Scalar::power_of_two((w - frac) as i16)).unwrap();
+            let a = p.at_radius(r);
+            let b = p2.at_radius(r);
+            readouts += 1;
+            match (a, b) {
+                (Ok(x), Ok(y)) if x == y => {}
+                (Err(_), Err(_)) => {}
+                _ => diffs += 1,
+            }
+        }
+        let t0 = Instant::now();
+        for _ in 0..32 {
+            let _ = Rebinding::from_state(probe.clone(), Scalar::ZERO, Some(edge)).unwrap();
+        }
+        let us = t0.elapsed().as_secs_f64() / 32.0 * 1e6;
+        println!(
+            "w={w:>3}: panels {:>4}, knots {:>3}, standing {bytes:>7} B, compile {us:>7.1} µs, re-mint diffs {diffs}/{readouts}, key equal {}",
+            p.panels(),
+            p.orbit_knots(),
+            p.key() == p2.key(),
+        );
+    }
+
+    // ---- the cycle control: knots against apoapsis span, re-mint from the key ----
+    println!("\n== cycles (control): knots against apoapsis span; re-mint from the key = Orbit::compile ==");
+    for vt in [0.40e-3, 0.60e-3, 0.80e-3, 0.90e-3, 0.98e-3, 1.02e-3, 1.05e-3] {
+        let st = bound_state(vt);
+        let fit = match Rebinding::from_state(st.clone(), Scalar::ZERO, None) {
+            Ok(f) => f,
+            Err(e) => {
+                println!("vt={vt:.4e}: refused {e:?}");
+                continue;
+            }
+        };
+        let Trajectory::Cycle(c) = &fit.trajectory else { panic!("not a cycle") };
+        let peri = c.key().periapsis;
+        // the state sits at apoapsis (v_r = 0, bound): span = r0 / peri
+        let span = Scalar::integer(1_000_000).div(peri).unwrap();
+        let mut span_log2 = 0i32;
+        while Scalar::power_of_two(span_log2 as i16) < span {
+            span_log2 += 1;
+        }
+        let again = emergent_space::orbit::Orbit::compile(c.key()).unwrap();
+        let mut diffs = 0u32;
+        for k in 0..16u32 {
+            let frac = ((k as i64 + 1) * (span_log2 as i64 + 1) / 17) as i32;
+            let r = Scalar::power_of_two(12).mul(Scalar::power_of_two(-(frac as i16))).unwrap();
+            match (c.signed_state(r), again.signed_state(r)) {
+                (Ok(x), Ok(y)) if x == y => {}
+                (Err(_), Err(_)) => {}
+                _ => diffs += 1,
+            }
+        }
+        let shape = c.shape();
+        println!(
+            "vt={vt:.4e}: peri {peri:?}, span 2^{span_log2}, knots {:>3}, standing {:>6} B, re-mint diffs {diffs}/16",
+            shape.knots().len(),
+            shape.knots().len() * std::mem::size_of::<emergent_space::orbit::Knot>()
+                + shape.crossings().len() * std::mem::size_of::<usize>()
+        );
+    }
+}
