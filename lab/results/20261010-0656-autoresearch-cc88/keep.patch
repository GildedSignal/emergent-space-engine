 /// cos(psi) in Q62 for psi in [0, pi] in Q61. With x = psi - pi/2 in Q62 (|x| <= pi/2),
 /// cos(psi) = -sin(x), and sin(x) = x(1 - x^2/(2*3)(1 - x^2/(4*5)(1 - ... x^2/(26*27)))):
 /// thirteen nested factors, innermost first, each product floored (arithmetic shift).
+/// Four cosines at once, one Horner chain per lane interleaved: each lane performs
+/// exactly the operations of [`cos`] on its own input, so the bits are identical;
+/// the four independent chains overlap their latencies (lab 20261010-0656).
+pub fn cos4(psi: [i128; 4]) -> [i128; 4] {
+    let x = psi.map(|p| (2 * p - PI) as i64);
+    let x2 = x.map(|v| ((v as i128 * v as i128) >> 62) as u64);
+    let mut s = [ONE as u64; 4];
+    for r in SINE.iter().rev() {
+        let mut y = [0u64; 4];
+        for l in 0..4 {
+            y[l] = ((x2[l] as u128 * s[l] as u128) >> 62) as u64;
+        }
+        for l in 0..4 {
+            s[l] = ONE as u64 - ((y[l] as u128 * *r as u64 as u128) >> 62) as u64;
+        }
+    }
+    let mut out = [0i128; 4];
+    for l in 0..4 {
+        out[l] = if psi[l] == 0 {
+            ONE
+        } else if psi[l] == PI {
+            -ONE
+        } else {
+            -((x[l] as i128 * s[l] as i128) >> 62)
+        };
+    }
+    out
+}
