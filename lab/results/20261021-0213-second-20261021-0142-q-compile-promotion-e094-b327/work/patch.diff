+def heal():
+    """One-time cleanup of past publishes: defuse conflict markers, and fold each
+    page's `## Runs` back to one line per run (the literal union compounded them)."""
+    for name in sorted(os.listdir(WIKI)):
+        if not name.endswith(".md") or name in SKIP:
+            continue
+        p = os.path.join(WIKI, name)
+        t = open(p, encoding="utf-8").read()
+        body, lines = split_runs(defuse(t))
+        folded = fold_runs(lines, [])
+        if not lines and has_markers(t):  # no Runs section to fold; defuse only
+            open(p, "w", encoding="utf-8").write(defuse(t))
+            print(f"wiki: healed {name}")
+        elif has_markers(t) or folded != lines:
+            open(p, "w", encoding="utf-8").write(
+                body.rstrip("\n") + "\n\n## Runs\n" + "".join(l + "\n" for l in folded))
+            print(f"wiki: healed {name}{' (Runs folded)' if folded != lines else ''}")
