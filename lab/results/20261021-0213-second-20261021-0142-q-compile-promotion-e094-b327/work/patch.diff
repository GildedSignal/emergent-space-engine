+def fold_runs(ours, theirs):
+    """The `## Runs` union keyed on run id: one line per run; a re-graded or
+    reworded line replaces its stale variant (later in, i.e. the newer page, wins)."""
+    out = {}
+    for l in ours + theirs:
+        m = re.match(r"^- (\S+)", l)
+        out[m.group(1) if m else l] = l
+    return list(out.values())
+
+
+UNMERGED = "**⚠ unmerged — two versions stand; the next run on this topic resolves them:**"
+MARKERS = (r"^<{7} ", r"^={7}$", r"^>{7} ")
+GIT_WIKI = "lab/wiki"  # pages as addressed inside git (LAB_WIKI may point at a sandbox copy)
+
+
+def has_markers(text):
+    """Any of the three git conflict marker lines (orphan closers count)."""
+    return any(re.search(p, text, re.M) for p in MARKERS)
+
+
+def _side(items):
+    """Render parsed items; nested damage becomes nested labeled versions."""
+    out = []
+    for kind, val in items:
+        if kind == "text":
+            out.append(val)
+        else:  # a conflict block, however malformed
+            label, ours, theirs, closed = val
+            out += ["", UNMERGED, "", f"*Version `{label}` (standing):*", *_side(ours), "",
+                    f"*Version `{closed or '(truncated)'}` (this publish):*", *_side(theirs or []), ""]
+    return out
+
+
+def defuse(text):
+    """Rewrite git conflict blocks as labeled, attributable versions.
+
+    The README's contract keeps conflicts visible for the next run on the topic to
+    resolve; what must not happen is marker syntax landing on main (it nests on the
+    next publish and leaks into the index). Blocks are paired with a stack, so
+    interleaved damage (a block's closer eaten by an earlier publish) binds each
+    `=======`/`>>>>>>>` to its own opener; orphan mid/close lines are syntax debris
+    and are dropped; every captured side — including a truncated tail — renders
+    recursively, so no marker can survive at any depth.
+    """
+    root, blocks = [], []  # blocks: open (block, current-side) refs
+    cur = lambda: blocks[-1][1] if blocks else root
+    for line in text.splitlines():
+        if re.match(MARKERS[0], line):  # <<<<<<< label
+            b = [line[8:], [], None, None]  # label, ours, theirs, closer
+            cur().append(("block", b))
+            blocks.append((b, b[1]))
+        elif re.match(MARKERS[1], line):  # =======
+            if blocks and blocks[-1][0][2] is None:
+                b = blocks.pop()[0]
+                b[2] = []
+                blocks.append((b, b[2]))
+            # else: orphan mid (no block awaiting its separator) — debris, dropped
+        elif re.match(MARKERS[2], line):  # >>>>>>> label
+            if blocks:
+                blocks.pop()[0][3] = line[8:]
+            # else: orphan close — debris, dropped
+        else:
+            cur().append(("text", line))
+    return "\n".join(_side(root))
+
 
