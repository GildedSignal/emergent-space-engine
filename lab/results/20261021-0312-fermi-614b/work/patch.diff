+//! Lab census hooks (additive, experiment-only; see lab/results/20261021-0312-fermi-614b).
+//! Relaxed counters read out by the xtask allocation census after a run. They never touch an outcome.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// `Radial::candidates` returned `None` (the caller then reads every body).
+pub static RADIAL_FALLBACK: AtomicU64 = AtomicU64::new(0);
+/// `Radial::candidates` returned an index.
+pub static RADIAL_INDEXED: AtomicU64 = AtomicU64::new(0);
+/// Bodies handed out by the indexed path, summed.
+pub static RADIAL_IDS: AtomicU64 = AtomicU64::new(0);
+/// Iterations of `PlayerNeighbourhood::capture`'s candidate loop (bodies considered).
+pub static CAPTURE_LOOP: AtomicU64 = AtomicU64::new(0);
+/// Candidate tuples actually pushed (the survivors of the filters).
+pub static CAPTURE_TUPLES: AtomicU64 = AtomicU64::new(0);
+/// Largest candidate list one capture ever built.
+pub static CAPTURE_MAX: AtomicU64 = AtomicU64::new(0);
+
+pub fn read() -> [u64; 6] {
+    [
+        RADIAL_FALLBACK.load(Ordering::Relaxed),
+        RADIAL_INDEXED.load(Ordering::Relaxed),
+        RADIAL_IDS.load(Ordering::Relaxed),
+        CAPTURE_LOOP.load(Ordering::Relaxed),
+        CAPTURE_TUPLES.load(Ordering::Relaxed),
+        CAPTURE_MAX.load(Ordering::Relaxed),
+    ]
+}
