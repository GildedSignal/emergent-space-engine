+fn shape_bytes(s: &emergent_space::orbit::OrbitShape) -> (usize, usize, bool) {
+    let k = s.knots();
+    (k.len(), k.len() * std::mem::size_of::<emergent_space::orbit::Knot>() + s.crossings().len() * 8, true)
+}
+
+/// The span-coverage census (print-only, outside the timed section): per minted binding, how much
+/// of the compiled arc the body walks before the binding stops being read — its next planned kick
+/// (the exact next item of the plan the mint leaves, or the next boundary plus half its interval
+/// when no kick is planned yet), capped for passages at the release radius (a tube is compiled to
+/// 2× the doll edge and the ship is handed back at the edge). Never-read panels are counted exactly
+/// from the knots' own `psi` values; the walk is read with the shipped readout on the new binding.
+const PSI_PI: u64 = 7244019458077122842; // tables::PI (private there): apoapsis in psi units.
+
+struct SpanRow {
+    kind: u8, // 0 cycle, 1 passage (plunges are counted by kind only: none mint here)
+    psi: Vec<u64>,
+    psi0: u64,
+    out0: bool,
+    cyc0: u64,
+    psi_edge: u64,    // compiled span top
+    psi_release: u64, // the walk's cap (release at outer/2); psi_edge when there is none
+    b: emergent_universe::bind::Binding,
+}
+
+#[derive(Clone)]
+struct Closed {
+    kind: u8,
+    knots: usize,
+    never_read: usize,
+    coverage: f64,
+    t1_exact: bool,
+    no_next: bool,
+    release_capped: bool,
+    overhang: f64,
+    read_err: bool,
+}
+
+/// Panels the walk from (psi0, out0, cyc0) to (psi1, out1, cyc1) never touches, on a closed table.
+/// Panels the walked arc `[lo, hi]` never touches: a read at psi brackets the panel containing it,
+/// so the touched knots are the index range spanned by `[lo, hi]`; everything outside is never read.
+fn never_read_bracket(psi: &[u64], lo: u64, hi: u64) -> usize {
+    if psi.is_empty() {
+        return 0;
+    }
+    let first = psi.partition_point(|&p| p <= lo).saturating_sub(1); // last knot at or before lo
+    let last = (psi.partition_point(|&p| p <= hi)).saturating_sub(1); // last knot at or before hi
+    let last = last.max(first);
+    psi.len() - (last - first + 1)
+}
+
+fn cycle_never_read(psi: &[u64], psi0: u64, out0: bool, cyc0: u64, psi1: u64, out1: bool, cyc1: u64) -> usize {
+    if cyc1 > cyc0 {
+        return 0; // a periapsis was crossed: the whole table was walked
+    }
+    let (lo, hi) = if out0 && !out1 {
+        (psi0.min(psi1), PSI_PI) // over the apoapsis and back in
+    } else {
+        (psi0.min(psi1), psi0.max(psi1))
+    };
+    never_read_bracket(psi, lo, hi)
+}
+
+fn close_span(row: SpanRow, t1: Option<i64>, t1_exact: bool) -> Closed {
+    let knots = row.psi.len();
+    let overhang = 1.0 - row.psi_release as f64 / row.psi_edge.max(1) as f64;
+    let Some(t1) = t1 else {
+        return Closed { kind: row.kind, knots, never_read: 0, coverage: f64::NAN, t1_exact, no_next: true, release_capped: false, overhang, read_err: false };
+    };
+    match row.kind {
+        0 => {
+            // The unwrapped radial coordinate U (in psi units): one period = 2·PSI_PI of U.
+            let u = |psi: u64, out: bool, cyc: u64| {
+                2.0 * PSI_PI as f64 * cyc as f64 + if out { psi as f64 } else { 2.0 * PSI_PI as f64 - psi as f64 }
+            };
+            let u0 = u(row.psi0, row.out0, row.cyc0);
+            match row.b.orbit_state(t1) {
+                Ok(st) => {
+                    let u1 = u(st.psi, st.outbound, st.cycles);
+                    Closed {
+                        kind: 0,
+                        knots,
+                        never_read: cycle_never_read(&row.psi, row.psi0, row.out0, row.cyc0, st.psi, st.outbound, st.cycles),
+                        coverage: ((u1 - u0) / (2.0 * PSI_PI as f64)).clamp(0.0, 1.0),
+                        t1_exact,
+                        no_next: false,
+                        release_capped: false,
+                        overhang: 0.0,
+                        read_err: false,
+                    }
+                }
+                Err(_) => Closed { kind: 0, knots, never_read: 0, coverage: 1.0, t1_exact, no_next: false, release_capped: false, overhang: 0.0, read_err: true },
+            }
+        }
+        _ => {
+            // A passage walks psi monotonically up from the periapsis side; an inbound mint walks
+            // down through periapsis first. The walk stops at the release radius at the latest.
+            let psi1 = match row.b.orbit_state(t1) {
+                Ok(st) => st.psi.min(row.psi_release),
+                Err(_) => row.psi_release, // past the tube's end: it was walked to the cap
+            };
+            let walked = if row.out0 { psi1 as f64 - row.psi0 as f64 } else { psi1 as f64 + row.psi0 as f64 };
+            let remaining = if row.out0 { row.psi_edge as f64 - row.psi0 as f64 } else { row.psi_edge as f64 + row.psi0 as f64 };
+            let lo = if row.out0 { row.psi0 } else { 0 };
+            let never_read = never_read_bracket(&row.psi, lo, psi1);
+            Closed {
+                kind: 1,
+                knots,
+                never_read,
+                coverage: if remaining > 0.0 { (walked / remaining).clamp(0.0, 1.0) } else { 1.0 },
+                t1_exact,
+                no_next: false,
+                release_capped: psi1 == row.psi_release,
+                overhang,
+                read_err: false,
+            }
+        }
+    }
+}
+
+fn open_span(e: &emergent_universe::bind::Entry, b: &emergent_universe::bind::Binding, t0: i64) -> Option<SpanRow> {
+    let (kind, psi, psi_edge, psi_release) = match &e.trajectory {
+        Trajectory::Cycle(c) => {
+            let psi: Vec<u64> = c.shape().knots().iter().map(|k| k.psi).collect();
+            let top = *psi.last().unwrap_or(&0);
+            (0u8, psi, top, top)
+        }
+        Trajectory::Passage(p) => {
+            let psi: Vec<u64> = p.shape().knots().iter().map(|k| k.psi).collect();
+            let edge = p.at_radius(p.outer_radius).ok().map(|(_, st)| st.psi)?; // compiled span top, tail included
+            // Released at the doll edge on the way out; the root doll (0) has no edge to be handed back at.
+            let release = if b.doll == 0 { edge } else { p.at_radius(p.outer_radius.scale(-1).ok()?).ok().map(|(_, st)| st.psi)? };
+            (1u8, psi, edge, release)
+        }
+        Trajectory::Plunge(_) => return None,
+    };
+    let st0 = b.orbit_state(t0).ok()?;
+    Some(SpanRow { kind, psi, psi0: st0.psi, out0: st0.outbound, cyc0: st0.cycles, psi_edge, psi_release, b: b.clone() })
+}
+
+fn span_json(rows: &[Closed]) -> serde_json::Value {
+    let live: Vec<&Closed> = rows.iter().filter(|r| !r.no_next && !r.read_err).collect();
+    let mut knots: Vec<usize> = live.iter().map(|r| r.knots).collect();
+    knots.sort_unstable();
+    let mut never: Vec<usize> = live.iter().map(|r| r.never_read).collect();
+    never.sort_unstable();
+    let mut cov: Vec<f64> = live.iter().map(|r| r.coverage).collect();
+    cov.sort_by(f64::total_cmp);
+    let mut over: Vec<f64> = live.iter().map(|r| r.overhang).collect();
+    over.sort_by(f64::total_cmp);
+    let at = |v: &[usize], p: f64| v.get(((v.len().saturating_sub(1)) as f64 * p).ceil() as usize).copied();
+    let atf = |v: &[f64], p: f64| v.get(((v.len().saturating_sub(1)) as f64 * p).ceil() as usize).copied();
+    let tot_knots: usize = live.iter().map(|r| r.knots).sum();
+    let tot_never: usize = live.iter().map(|r| r.never_read).sum();
+    json!({
+        "n": rows.len(),
+        "no_next_kick": rows.iter().filter(|r| r.no_next).count(),
+        "read_err": rows.iter().filter(|r| r.read_err).count(),
+        "t1_estimated": live.iter().filter(|r| !r.t1_exact).count(),
+        "release_capped": live.iter().filter(|r| r.release_capped).count(),
+        "knots_min": at(&knots, 0.0), "knots_med": at(&knots, 0.5), "knots_p75": at(&knots, 0.75), "knots_max": at(&knots, 1.0),
+        "never_read_med": at(&never, 0.5), "never_read_p75": at(&never, 0.75), "never_read_max": at(&never, 1.0),
+        "never_read_share_total": if tot_knots == 0 { 0.0 } else { tot_never as f64 / tot_knots as f64 },
+        "never_read_share_med": if live.is_empty() { 0.0 } else {
+            let mut s: Vec<f64> = live.iter().map(|r| r.never_read as f64 / r.knots.max(1) as f64).collect();
+            s.sort_by(f64::total_cmp);
+            atf(&s, 0.5).unwrap_or(0.0)
+        },
+        "coverage_min": atf(&cov, 0.0), "coverage_med": atf(&cov, 0.5), "coverage_p25": atf(&cov, 0.25), "coverage_max": atf(&cov, 1.0),
+        "release_overhang_med": atf(&over, 0.5),
+        "knots_total": tot_knots, "never_read_total": tot_never,
+    })
+}
 
