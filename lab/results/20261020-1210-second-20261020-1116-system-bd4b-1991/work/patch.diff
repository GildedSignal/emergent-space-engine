+#[derive(Default)]
+struct Mints {
+    // (wall µs of the kick, knots of the minted trajectory, heap bytes of the knots/crossings, counted?)
+    rows: Vec<(f64, usize, usize, bool)>,
+    no_mint_us: Vec<f64>,
+    kinds: [u64; 3], // cycle, passage, plunge
+}
+impl Mints {
+    fn profile(t: &Trajectory) -> (usize, usize, bool) {
+        match t {
+            Trajectory::Cycle(o) => shape_bytes(o.shape()),
+            Trajectory::Passage(p) => shape_bytes(p.shape()),
+            Trajectory::Plunge(pl) => {
+                let retained = pl.retained_bytes();
+                (pl.panel_count(), retained.saturating_sub(std::mem::size_of_val(pl)), true)
+            }
+        }
+    }
+    fn knots_share(&self) -> f64 {
+        let kn: u128 = self.rows.iter().filter(|r| r.3).map(|r| r.1 as u128 * 88).sum();
+        let tot: u128 = self.rows.iter().filter(|r| r.3).map(|r| (r.2 as u128 + 88).max(r.1 as u128 * 88)).sum();
+        if tot == 0 { 0.0 } else { kn as f64 / tot as f64 }
+    }
+    fn spearman(&self) -> f64 {
+        let n = self.rows.len();
+        if n < 8 || self.rows.iter().map(|r| r.1).collect::<HashSet<_>>().len() < 3 {
+            return f64::NAN;
+        }
+        let rank_of = |vals: &[f64]| -> Vec<f64> {
+            let mut o: Vec<usize> = (0..n).collect();
+            o.sort_by(|&a, &b| vals[a].partial_cmp(&vals[b]).unwrap());
+            let mut r = vec![0.0; n];
+            let (mut i, mut rank) = (0, 0.0);
+            while i < n {
+                let mut j = i;
+                while j + 1 < n && vals[o[j + 1]] == vals[o[i]] { j += 1; }
+                let avg = (2.0 * rank + (j - i + 1) as f64 + 1.0) / 2.0;
+                for &k in &o[i..=j] { r[k] = avg; }
+                rank += (j - i + 1) as f64;
+                i = j + 1;
+            }
+            r
+        };
+        let us: Vec<f64> = self.rows.iter().map(|r| r.0).collect();
+        let kn: Vec<f64> = self.rows.iter().map(|r| r.1 as f64).collect();
+        let (ru, rk) = (rank_of(&us), rank_of(&kn));
+        let (mu, mk) = (ru.iter().sum::<f64>() / n as f64, rk.iter().sum::<f64>() / n as f64);
+        let (mut num, mut du, mut dk) = (0.0, 0.0, 0.0);
+        for i in 0..n {
+            num += (ru[i] - mu) * (rk[i] - mk);
+            du += (ru[i] - mu).powi(2);
+            dk += (rk[i] - mk).powi(2);
+        }
+        if du == 0.0 || dk == 0.0 { f64::NAN } else { num / (du * dk).sqrt() }
+    }
+    fn json(&self) -> serde_json::Value {
+        let mut knots: Vec<usize> = self.rows.iter().map(|r| r.1).collect();
+        knots.sort_unstable();
+        let at = |p: f64| knots.get(((knots.len().saturating_sub(1)) as f64 * p).ceil() as usize).copied();
+        let mut by_knots = self.rows.clone();
+        by_knots.sort_by_key(|r| r.1);
+        let terciles = || -> Vec<serde_json::Value> {
+            (0..3)
+                .map(|c| {
+                    let (lo, hi) = (c * by_knots.len() / 3, (c + 1) * by_knots.len() / 3);
+                    let mut band: Vec<f64> = by_knots[lo..hi].iter().map(|r| r.0).collect();
+                    band.sort_by(f64::total_cmp);
+                    json!({"knots": at(c as f64 / 3.0 + 0.49 / 3.0), "median_us": band.get(band.len() / 2).copied(), "n": band.len()})
+                })
+                .collect()
+        };
+        let mut minted: Vec<f64> = self.rows.iter().map(|r| r.0).collect();
+        let mut no_mint = self.no_mint_us.clone();
+        json!({
+            "mints": self.rows.len(), "knots_min": at(0.0), "knots_p25": at(0.25), "knots_med": at(0.5),
+            "knots_p75": at(0.75), "knots_max": at(1.0),
+            "distinct_knot_counts": knots.iter().collect::<HashSet<_>>().len(),
+            "heap_bytes_total": self.rows.iter().map(|r| r.2).sum::<usize>(),
+            "knots_share_of_heap": self.knots_share(),
+            "median_us_minted": percentiles(&mut minted)["median"].clone(),
+            "median_us_no_mint": percentiles(&mut no_mint)["median"].clone(),
+            "spearman_us_knots": self.spearman(),
+            "median_us_by_knot_tercile": if knots.iter().collect::<HashSet<_>>().len() >= 3 { serde_json::Value::Array(terciles()) } else { serde_json::Value::Null },
+            "kinds_cycle_passage_plunge": self.kinds,
+        })
+    }
+}
