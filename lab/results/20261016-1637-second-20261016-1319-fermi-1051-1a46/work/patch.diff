+// ---- ES_SECULAR (lab probe, default off): step 5's delete arm --------------------------------------
+//
+// docs/law.md's step 5 deletes the metronome's events for stable bodies instead of spreading them.
+// This probe implements the delete half behind a flag: a ship (not a fleet member, not the player)
+// whose orbit is secular-legal against EVERY perturber of its doll is deleted from the metronome —
+// r9's bound applied per perturber, `tau_p = 3 (m_p/m_host) (a/a_p)^3` under r9's `tau0 = 3.6e-3`
+// for the parent star and for every secondary source of the doll — and free of resonances with the
+// doll's secondaries (a small-integer period commensurability within 2%, co-orbital within 5% in a;
+// `ES_SECULAR_RES=1` disables the exclusion, the adversarial control). The body is then a pure tube,
+// the `has_forces == false` state: no kicks, no boundaries. The secular residual r9 bounded (the
+// apsidal precession the freeze no longer applies) is carried by nothing — the flight measures both
+// the deleted event ledger and that residual, which prices the sparse re-kick cadence the real
+// generator needs. With the flag off the shipped law is untouched, bit for bit.
+
+fn es_flag(name: &str) -> bool {
+    std::env::var(name).is_ok_and(|v| v != "0")
+}
+
+const SECULAR_TAU0: f64 = 3.6e-3;
+
+/// The semimajor axis of a bound turning key, as f64 in the doll's units. `None`: passage, plunge
+/// or unbound — never secular. The key holds `k`, the mantissa of `1/(1+e)`, so `a = p·k/(2k−1)`.
+fn es_a(periapsis: Scalar, k: u64, k_exponent: i16) -> Option<f64> {
+    let k = k as f64 * 2f64.powi(k_exponent as i32 - 48);
+    if k <= 0.5 {
+        return None; // e >= 1
+    }
+    Some(crate::num::to_f64(periapsis) * k / (2.0 * k - 1.0))
+}
