+    /// ES_SECULAR's per-body decision (the module note above): secular-legal against every
+    /// perturber of the doll (r9's `tau_p` under `tau0`), and free of resonances with its
+    /// secondaries. Masses come from the ctx's own units (both sides of each ratio in the same
+    /// doll's units); distances from the keys, converted by the doll-pair shift.
+    fn secular(&self) -> bool {
+        if !matches!(self.rec.kind, Kind::Ship) || self.ctx.info[self.i].from.is_some() {
+            return false; // never the player or a fleet member: the battle and the hand own them
+        }
+        let Some(key) = self.rec.b.entry.trajectory.key() else { return false };
+        let Some(a) = es_a(key.periapsis, key.k, key.k_exponent) else { return false };
+        let d = self.rec.b.doll as usize;
+        let doll = &self.ctx.dolls[d];
+        let host = crate::num::to_f64(doll.unit.mu);
+        let t = self.rec.anchor;
+        // The parent star's tide: its mass in this doll's units (Ctx::tide's own conversion), the
+        // host's semimajor axis from its key in the parent's units, shifted into this doll's.
+        if let Some(p) = doll.parent {
+            let centre = doll.centre.expect("a child doll has a centre");
+            let Some((pm, _)) = self.ctx.tide(self.rec.b.doll, t).ok().flatten() else { return false };
+            let Some(ck) = self.ctx.bodies.binding_at(centre, t).and_then(|b| b.entry.trajectory.key()) else { return false };
+            let Some(a_p) = es_a(ck.periapsis, ck.k, ck.k_exponent) else { return false };
+            let shift = 2f64.powi(doll.shift as i32 - self.ctx.dolls[p as usize].shift as i32);
+            let a_host = a_p * shift;
+            if 3.0 * (crate::num::to_f64(pm) / host) * (a / a_host).powi(3) >= SECULAR_TAU0 {
+                return false;
+            }
+        }
+        // The secondaries: r9's tide per source, then the resonance exclusion.
+        let res_on = es_flag("ES_SECULAR_RES");
+        for &j in &self.ctx.sources[d] {
+            if j == self.i {
+                continue;
+            }
+            let Some(jk) = self.ctx.bodies.binding_at(j, t).and_then(|b| b.entry.trajectory.key()) else { continue };
+            let Some(a_j) = es_a(jk.periapsis, jk.k, jk.k_exponent) else { continue }; // a passing source has no resonance
+            let m_j = crate::num::to_f64(self.ctx.info[j].gm);
+            if 3.0 * (m_j / host) * (a / a_j).powi(3) >= SECULAR_TAU0 {
