+//! 20261014-1137-redteam-56cd — the fleet doll under its own thrust.
+//!
+//! representation.md §1: "A dense region with no central mass (a battle, a fleet) is also a
+//! doll: the free-fall frame of its centre of mass." The shipped frame's origin follows an
+//! exact (geodesic) tube, rebound at re-anchors, which refuse an unbound tube. This probe
+//! burns the fleet and measures what the doll does: A0 no burn (control), A1 a gentle shared
+use emergent_lattice::law::{Body, Law, Response, Tick, World};
+use emergent_lattice::{chronon::Chronon, Kickable, Motion};
+use emergent_engine::{AnchorPolicy, Battle, Frame};
+
+const Q: i64 = 1 << 20;
+const DR: i64 = 1 << 22;
+const R: i64 = 1000 * DR;
+const N: u64 = 1 << 46;
+const N_RAD: f64 = N as f64 / (1u64 << 60) as f64;
+const TWO32: f64 = 4294967296.0;
+const NM: usize = 12;
+const STRIDE: Tick = 640;
+
+fn frame() -> Frame {
+    Frame::new(Q, R, N).unwrap()
+}
+
+fn world() -> World {
+    let spread = 0.05 * DR as f64;
+    let bodies: Vec<Body> = (0..NM)
+        .map(|i| {
+            let (a, b) = ((i % 4) as f64 - 1.5, (i / 4) as f64 - 1.0);
+            Body::new(i as u64 + 1, [(a * spread) as i64, (b * spread) as i64], [0, 0], 1 + (i % 3) as i64, 1000, Response::Pass)
+        })
+        .collect();
+    World::new(Q, None, bodies).unwrap().with_law(Law::RelativisticV1).unwrap()
+}
+
+/// One RK4 step of two-body motion with velocity `v` (units n = 1, R = 1, inertial axes).
+fn step(p: [f64; 2], v: [f64; 2], h: f64) -> ([f64; 2], [f64; 2]) {
+    let acc = |p: [f64; 2]| {
+        let r3 = (p[0] * p[0] + p[1] * p[1]).powf(1.5);
+        [-p[0] / r3, -p[1] / r3]
+    };
+    let a1 = acc(p);
+    let (p2, v2) = ([p[0] + 0.5 * h * v[0], p[1] + 0.5 * h * v[1]], [v[0] + 0.5 * h * a1[0], v[1] + 0.5 * h * a1[1]]);
+    let a2 = acc(p2);
+    let (p3, v3) = ([p[0] + 0.5 * h * v2[0], p[1] + 0.5 * h * v2[1]], [v[0] + 0.5 * h * a2[0], v[1] + 0.5 * h * a2[1]]);
+    let a3 = acc(p3);
+    let (p4, v4) = ([p[0] + h * v3[0], p[1] + h * v3[1]], [v[0] + h * a3[0], v[1] + h * a3[1]]);
+    let a4 = acc(p4);
+    (
+        [p[0] + h / 6.0 * (v[0] + 2.0 * v2[0] + 2.0 * v3[0] + v4[0]), p[1] + h / 6.0 * (v[1] + 2.0 * v2[1] + 2.0 * v3[1] + v4[1])],
+        [v[0] + h / 6.0 * (a1[0] + 2.0 * a2[0] + 2.0 * a3[0] + a4[0]), v[1] + h / 6.0 * (a1[1] + 2.0 * a2[1] + 2.0 * a3[1] + a4[1])],
+    )
+}
+
+/// Per-member truth over samples: [sample][member] position from the reference point in the
+/// parent's rotating axes (lattice units), with the staircase burn applied at sample ticks.
+fn truth(w: &World, samples: usize, dv_app: i64, s0: usize, s1: usize, burns: &[bool]) -> Vec<Vec<[f64; 2]>> {
+    let u = R as f64 * N_RAD; // the orbital speed in lattice units (v_c)
+    let h = STRIDE as f64 * N_RAD;
+    let sub = 256;
+    let mut out = Vec::with_capacity(samples + 1);
+    let mut state: Vec<([f64; 2], [f64; 2])> = w
+        .bodies
+        .iter()
+        .map(|b| {
+            let p0 = [1.0 + b.x[0] as f64 / R as f64, b.x[1] as f64 / R as f64];
+            let vr = [b.k[0] as f64 / u, b.k[1] as f64 / u];
+            (p0, [vr[0] - p0[1], vr[1] + p0[0]]) // to inertial axes
+        })
+        .collect();
+    let dv = dv_app as f64 / u;
+    for s in 0..=samples {
+        // Sample s is after s applications (s = 0 is genesis).
+        let rot = |p: [f64; 2]| {
+            let (c, sn) = ((s as f64 * h).cos(), (s as f64 * h).sin());
+            [(c * p[0] + sn * p[1]) * R as f64 - R as f64, (-sn * p[0] + c * p[1]) * R as f64]
+        };
+        out.push(state.iter().map(|(p, _)| rot(*p)).collect());
+        if s == samples {
+            break;
+        }
+        for _ in 0..sub {
+            for i in 0..NM {
+                state[i] = step(state[i].0, state[i].1, h / sub as f64);
+            }
+        }
+        if s + 1 >= s0 && s + 1 <= s1 {
+            for i in 0..NM {
+                if burns[i] {
+                    state[i].1[1] += dv;
+                }
+            }
+        }
+    }
+    out
+}
+
+/// A member's position from the reference point in the parent's rotating axes, as the frame
+/// has it (the reanchor test's convention).
+fn frame_position(b: &Battle<Chronon>, tick: Tick, x: [i64; 2]) -> [f64; 2] {
+    let t = b.tube_at(tick).expect("a frame with a parent has a tube");
+    let th = t.azimuth as f64 / (1u64 << 60) as f64;
+    let p = [t.radius as f64 + t.x[0] as f64 / TWO32 + x[0] as f64, t.x[1] as f64 / TWO32 + x[1] as f64];
+    let (c, s) = (th.cos(), th.sin());
+    [c * p[0] - s * p[1] - R as f64, s * p[0] + c * p[1]]
+}
+
+fn norm(a: [f64; 2]) -> f64 {
+    (a[0] * a[0] + a[1] * a[1]).sqrt()
+}
+
+struct Arm {
+    name: &'static str,
+    dv_app: i64,
+    s0: usize,
+    s1: usize,
+    burns: [bool; NM],
+    samples: usize,
+    dissolve: bool,
+}
+
+fn run(a: &Arm) {
+    let w = world();
+    let masses: Vec<f64> = w.bodies.iter().map(|b| b.mass as f64).collect();
+    let total: f64 = masses.iter().sum();
+    let tr = truth(&w, a.samples, a.dv_app, a.s0, a.s1, &a.burns);
+    let mut b = Battle::new(Chronon::new(w, false).unwrap(), frame(), 1).with_anchoring(AnchorPolicy::default()).unwrap();
+    if a.dissolve {
+        b = b.with_min_members(1);
+    }
+    let mut m: Vec<Motion> = Vec::new();
+    let (mut max_rel, mut max_shape, mut max_origin_dr, mut worst_tick) = (0f64, 0f64, 0f64, 0i64);
+    let mut apps = 0usize;
+    for s in 1..=a.samples {
+        let tick = s as i64 * STRIDE;
+        b.run_to(tick).unwrap();
+        if s >= a.s0 && s <= a.s1 && a.dv_app > 0 {
+            b.burn([0, a.dv_app], &a.burns).unwrap();
+            apps += 1;
+        }
+        b.stepper().motions(&mut m);
+        // Origin vs the members' true centre of mass (all members, the fleet is the fleet).
+        let cm_true: [f64; 2] = [
+            (0..NM).map(|i| masses[i] * tr[s][i][0]).sum::<f64>() / total,
+            (0..NM).map(|i| masses[i] * tr[s][i][1]).sum::<f64>() / total,
+        ];
+        let origin = frame_position(&b, tick, [0, 0]);
+        let d_origin = norm([origin[0] - cm_true[0], origin[1] - cm_true[1]]) / DR as f64;
+        if d_origin > max_origin_dr {
+            max_origin_dr = d_origin;
+            worst_tick = tick;
+        }
+        // Absolute per-member error and group shape (active members only).
+        let th = b.tube_at(tick).map_or(0.0, |t| t.azimuth as f64 / (1u64 << 60) as f64);
+        let (c, sn) = (th.cos(), th.sin());
+        let cm_f = |v: &dyn Fn(usize) -> [f64; 2]| {
+            [
+                (0..NM).filter(|&i| b.active()[i]).map(|i| masses[i] * v(i)[0]).sum::<f64>() / total,
+                (0..NM).filter(|&i| b.active()[i]).map(|i| masses[i] * v(i)[1]).sum::<f64>() / total,
+            ]
+        };
+        let cm_true_a = cm_f(&|i| tr[s][i]);
+        let cm_frame = cm_f(&|i| [m[i].x[0] as f64, m[i].x[1] as f64]);
+        let mut size = 0f64;
+        for i in 0..NM {
+            if b.active()[i] {
+                size = size.max(norm([tr[s][i][0] - cm_true_a[0], tr[s][i][1] - cm_true_a[1]]));
+            }
+        }
+        for i in 0..NM {
+            if !b.active()[i] {
+                continue;
+            }
+            let got_abs = frame_position(&b, tick, m[i].x);
+            let want_abs = tr[s][i];
+            max_rel = max_rel.max(norm([got_abs[0] - want_abs[0], got_abs[1] - want_abs[1]]) / norm(want_abs).max(1e-9));
+            let d = [m[i].x[0] as f64 - cm_frame[0], m[i].x[1] as f64 - cm_frame[1]];
+            let got = [c * d[0] - sn * d[1], sn * d[0] + c * d[1]];
+            let want = [tr[s][i][0] - cm_true_a[0], tr[s][i][1] - cm_true_a[1]];
+            max_shape = max_shape.max(norm([got[0] - want[0], got[1] - want[1]]) / size.max(1e-9));
+        }
+    }
+    let st = b.stats();
+    println!(
+        "ARM {:<4} apps={} dv_total={:<7} | anchors={} refused={} handed_out={} active={}/{} | max_rel={:.4}% max_shape={:.4}% | origin_vs_truth_com={:.3} dr (worst at tick {}, {:.3} P) | tube radius {} (genesis {})",
+        a.name,
+        apps,
+        apps as f64 * a.dv_app as f64 / (R as f64 * N_RAD),
+        st.anchors,
+        st.anchors_refused,
+        st.handed_out,
+        b.active().iter().filter(|&&x| x).count(),
+        NM,
+        100.0 * max_rel,
+        100.0 * max_shape,
+        max_origin_dr,
+        worst_tick,
+        worst_tick as f64 / frame().period() as f64,
+        b.orbit().map(|o| o.0).unwrap_or(-1),
+        R,
+    );
+    println!("      handoffs recorded: {}; last refusal: {:?}", b.handoffs().len(), b.last_anchor_refusal());
+}
+
+fn main() {
+    println!("fleet doll under thrust: q={}, R={} dr, n=2^-14, v_c=nR=c/4, epoch={}, period={} chronons, stride {}", Q, R / DR, frame().epoch(), frame().period(), STRIDE);
+    let all = [true; NM];
+    let mut half = [false; NM];
+    for i in 0..6 {
+        half[i] = true;
+    }
+    let samples = |periods: f64| (periods * frame().period() as f64 / STRIDE as f64) as usize;
+    run(&Arm { name: "A0", dv_app: 0, s0: 1, s1: 0, burns: all, samples: samples(3.0), dissolve: false });
+    run(&Arm { name: "A1", dv_app: 655, s0: 8, s1: 47, burns: all, samples: samples(3.0), dissolve: false });
+    run(&Arm { name: "A2", dv_app: 8738, s0: 8, s1: 31, burns: all, samples: samples(1.0), dissolve: true });
+    run(&Arm { name: "A3", dv_app: 655, s0: 8, s1: 47, burns: half, samples: samples(3.0), dissolve: false });
+}
