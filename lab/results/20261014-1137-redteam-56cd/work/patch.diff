+    /// A shared burn (a decision's kink) applied to every member still in the frame: `dv` is
+    /// added to each active member's lattice velocity at the current tick. The frame's own law
+    /// is unchanged by it; the lab probe `examples/rt_fleet_thrust.rs` drives it.
+    pub fn burn(&mut self, dv: [i64; 2], burns: &[bool]) -> Result<(), FrameError> {
+        let d: Vec<[i64; 2]> = self
+            .active
+            .iter()
+            .zip(burns)
+            .map(|(&a, &b)| if a && b { dv } else { [0, 0] })
+            .collect();
+        self.stepper.kick(&d).map_err(|e| FrameError(e.0))?;
+        Ok(())
+    }
+
+    /// The last refused re-anchor's reason, if any (the lab probe reads it).
+    pub fn last_anchor_refusal(&self) -> Option<String> {
+        self.anchoring.as_ref().and_then(|a| a.last_refusal.clone())
+    }
+
