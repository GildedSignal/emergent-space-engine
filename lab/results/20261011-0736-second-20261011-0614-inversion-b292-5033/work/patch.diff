new file mode 100644
index 00000000..f2ad870a
--- /dev/null
+++ b/crates/encounters/src/bin/invert.rs
@@ -0,0 +1,444 @@
+//! Inversion-lens probe (lab run 20261011-0614-inversion-b292): does the phase-neighbour
+//! (train) certificate's premise — "every real encounter lies within partner rank 4 along
+//! the orbit" (gold 20261006-0346-taleb-09b5) — survive apsidal misalignment and
+//! eccentricity spread inside a co-orbital clump?
+//!
+//! Truth is unbiased: a true-longitude-binned sweep (dt = 2e-5, relative motion < rho/2 per
+//! step), so the equation of center cannot hide an encounter (the gold's mean-longitude bin
+//! could; their own instrument lesson). For every true encounter we report the partner's
+//! distance-rank (the gold's metric), true-longitude rank, and mean-longitude (lambda-bar)
+//! rank — the quantity a phase-sorted watch actually needs — plus the lambda-bar window the
+//! encounter requires, and the cost of the *sound* lambda-bar walk (exact equation-of-center
+//! amplitudes, linear drift) against the quadratic tier.
+//!
+//! Second-author correction (run 20261011-0736-second-...-5033): the original λ̄ rank
+//! sorted raw `mean_anomaly(t) + pom`, which spans > 2π once ϖ is spread, so cross-block
+//! pairs' ranks were inflated (the checker's finding). Every line now carries both:
+//! `ranks.lbar` (raw, byte-compatible with the b292 record) and `ranks.lbar_mod`
+//! (corrected: (m + pom).rem_euclid(TAU) before circ_rank). Scenes c0b/n1k/aspread/e5
+//! are the checker's held-out attacks, now shipped in the record.
+
+use emergent_encounters::belt::Rng;
+use emergent_encounters::kepler::Body;
+use emergent_encounters::method::{run_section, Stats};
+use emergent_encounters::pairs::{cone_pairs, sections};
+use std::collections::HashMap;
+use std::f64::consts::TAU;
+use std::time::Instant;
+const PHI: f64 = 1.618_033_988_749_895;
+
+const RHO: f64 = 1e-4;
+const SAFETY: f64 = 1.1;
+const DT: f64 = 2e-5;
+const ORBITS: f64 = 1.0;
+
+fn rayleigh(rng: &mut Rng, s: f64, cap: f64) -> f64 {
+    let u = rng.f64();
+    (s * (-2.0 * (1.0 - u).ln()).sqrt()).min(cap)
+}
+
+/// Wrap an angle difference to (-pi, pi].
+fn wrap(x: f64) -> f64 {
+    let d = x.rem_euclid(TAU);
+    if d > std::f64::consts::PI {
+        d - TAU
+    } else {
+        d
+    }
+}
+
+/// The gold's fleet generator with sigma_e and apsidal span as knobs (RNG call order kept
+/// identical, so (sig_e=1e-3, span=0.1, seed 27) reproduces the gold's adj scene exactly).
+fn fleet2(nc: usize, a_hw: f64, sig_lam: f64, sig_e: f64, pom_span: f64, seed: u64) -> Vec<Body> {
+    let mut rng = Rng(seed);
+    let pom0 = TAU * rng.f64();
+    let lam0 = TAU * rng.f64();
+    (0..nc)
+        .map(|_| {
+            let a = 1.0 + (2.0 * rng.f64() - 1.0) * a_hw;
+            let e = rayleigh(&mut rng, sig_e, 10.0 * sig_e);
+            let pom = pom0 + (2.0 * rng.f64() - 1.0) * pom_span;
+            let lam = if sig_lam <= 0.0 {
+                TAU * rng.f64()
+            } else {
+                let (u1, u2) = (rng.f64(), rng.f64());
+                let z = (-2.0 * (1e-12 + u1).ln()).sqrt() * (TAU * u2).cos();
+                lam0 + sig_lam * z
+            };
+            Body::new(a, e, pom, lam)
+        })
+        .collect()
+}
+
+/// Exact max |nu - M| over the orbit (the equation-of-center amplitude), golden section on
+/// (0, pi); nu - M is unimodal there for e < 1 and odd about periapsis.
+fn ecc_amp(b: &Body) -> f64 {
+    let g = |nu: f64| nu - b.true_to_mean(nu);
+    let mut lo = 1e-9;
+    let mut hi = std::f64::consts::PI - 1e-9;
+    let mut x1 = hi - (hi - lo) / PHI;
+    let mut x2 = lo + (hi - lo) / PHI;
+    let mut f1 = g(x1);
+    let mut f2 = g(x2);
+    for _ in 0..200 {
+        if f1 < f2 {
+            lo = x1;
+            x1 = x2;
+            f1 = f2;
+            x2 = lo + (hi - lo) / PHI;
+            f2 = g(x2);
+        } else {
+            hi = x2;
+            x2 = x1;
+            f2 = f1;
+            x1 = hi - (hi - lo) / PHI;
+            f1 = g(x1);
+        }
+        if hi - lo < 1e-14 {
+            break;
+        }
+    }
+    f1.max(f2).max(0.0)
+}
+
+/// Rank of j among all members sorted by `vals`, counting the shorter circular arc between
+/// i and j (the invariant a +-k sorted-order watch needs).
+fn circ_rank(vals: &[f64], i: usize, j: usize) -> u64 {
+    let n = vals.len();
+    let mut idx: Vec<usize> = (0..n).collect();
+    idx.sort_by(|&a, &b| vals[a].partial_cmp(&vals[b]).unwrap());
+    let mut pos = vec![0usize; n];
+    for (p, &k) in idx.iter().enumerate() {
+        pos[k] = p;
+    }
+    let gap = (pos[j] as i64 - pos[i] as i64).rem_euclid(n as i64) as usize;
+    (gap - 1).min(n - gap - 1) as u64
+}
+
+struct SceneOut {
+    enc: u64,
+    dmin: f64,
+    lb_ranks: Vec<u64>,
+    /// corrected (modular) lambda-bar ranks: the raw lam = m + pom spans > 2 pi once
+    /// pom is spread, so raw sorted order is not a circular order (checker b292);
+    /// lbar_mod sorts (m + pom).rem_euclid(TAU) — the invariant a +-k watch needs.
+    lb_ranks_mod: Vec<u64>,
+    dist_max: u64,
+    dist_le4: u64,
+    true_max: u64,
+    true_le4: u64,
+    lb_win_max: f64,
+    sound_viol: f64,
+    twoterm_viol: f64,
+    watch_pairs: u64,
+    quad: u64,
+    meth_pairs: u64,
+    meth_missed: u64,
+    meth_false: u64,
+    meth_s: f64,
+    meth_trunc: bool,
+    sweep_s: f64,
+    samples: Vec<String>,
+}
+
+fn scene(name: &str, nc: usize, a_hw: f64, sig_lam: f64, sig_e: f64, pom_span: f64, seed: u64, with_method: bool) {
+    let fl = fleet2(nc, a_hw, sig_lam, sig_e, pom_span, seed);
+    let t_end = ORBITS * TAU;
+
+    // ---- unbiased truth: true-longitude binned sweep ----
+    let steps = (t_end / DT) as usize;
+    let nb = 32768usize;
+    let binsz = TAU / nb as f64;
+    let mut head = vec![-1i64; nb];
+    let mut nxt = vec![-1i64; nc];
+    let mut px = vec![0.0f64; nc];
+    let mut py = vec![0.0f64; nc];
+    let mut best: HashMap<(u32, u32), (f64, f64)> = HashMap::new();
+    let t0 = Instant::now();
+    for s in 0..steps {
+        let t = s as f64 * DT;
+        let mut occupied: Vec<usize> = Vec::with_capacity(nc);
+        for i in 0..nc {
+            let m = fl[i].mean_anomaly(t);
+            let st = fl[i].state_at_mean(m);
+            px[i] = st[0];
+            py[i] = st[1];
+            let th = st[1].atan2(st[0]).rem_euclid(TAU);
+            let bin = ((th / binsz) as usize).min(nb - 1);
+            if head[bin] < 0 {
+                occupied.push(bin);
+            }
+            nxt[i] = head[bin];
+            head[bin] = i as i64;
+        }
+        for &bin in &occupied {
+            let mut p = head[bin];
+            while p >= 0 {
+                let mut q = nxt[p as usize];
+                while q >= 0 {
+                    rec(&px, &py, p as usize, q as usize, t, &mut best);
+                    q = nxt[q as usize];
+                }
+                p = nxt[p as usize];
+            }
+            let nb2 = (bin + 1) % nb;
+            let mut p = head[bin];
+            while p >= 0 {
+                let mut q = head[nb2];
+                while q >= 0 {
+                    rec(&px, &py, p as usize, q as usize, t, &mut best);
+                    q = nxt[q as usize];
+                }
+                p = nxt[p as usize];
+            }
+        }
+        for &bin in &occupied {
+            head[bin] = -1;
+        }
+    }
+    let sweep_s = t0.elapsed().as_secs_f64();
+
+    // ---- ranks and windows at each closest approach ----
+    let amps: Vec<f64> = fl.iter().map(ecc_amp).collect();
+    let mut keys: Vec<_> = best.keys().copied().collect();
+    keys.sort_unstable();
+    let mut out = SceneOut {
+        enc: keys.len() as u64,
+        dmin: f64::INFINITY,
+        lb_ranks: Vec::new(),
+        lb_ranks_mod: Vec::new(),
+        dist_max: 0,
+        dist_le4: 0,
+        true_max: 0,
+        true_le4: 0,
+        lb_win_max: 0.0,
+        sound_viol: f64::NEG_INFINITY,
+        twoterm_viol: f64::NEG_INFINITY,
+        watch_pairs: 0,
+        quad: (nc * (nc - 1) / 2) as u64,
+        meth_pairs: 0,
+        meth_missed: 0,
+        meth_false: 0,
+        meth_s: 0.0,
+        meth_trunc: false,
+        sweep_s,
+        samples: Vec::new(),
+    };
+
+    // the pairwise method (cone + sections), for the fallback tier's miss rate
+    let mut mm: HashMap<(u32, u32), u64> = HashMap::new();
+    if with_method {
+        let t1 = Instant::now();
+        let cs = cone_pairs(&fl, RHO);
+        for &(i, j) in &cs.pairs {
+            if t1.elapsed().as_secs_f64() > 90.0 {
+                out.meth_trunc = true;
+                break;
+            }
+            let (bi, bj) = (&fl[i as usize], &fl[j as usize]);
+            let mut ev = 0u64;
+            let mut st = Stats::default();
+            let mut hits = Vec::new();
+            for sec in sections(bi, bj, RHO, SAFETY, &mut ev) {
+                hits.clear();
+                run_section(bi, bj, &sec, RHO, 0.0, t_end, &mut st, &mut hits);
+                if !hits.is_empty() {
+                    *mm.entry((i, j)).or_insert(0) += hits.len() as u64;
+                }
+            }
+        }
+        out.meth_s = t1.elapsed().as_secs_f64();
+        out.meth_pairs = mm.len() as u64;
+    }
+
+    // sound lambda-bar window per pair, and the walk cost (closed form: lambda-bar drifts
+    // linearly; the horizon is short enough that no pair wraps)
+    let lam0: Vec<f64> = (0..nc).map(|i| fl[i].mean_anomaly(0.0) + fl[i].pom).collect();
+    let mut watch = 0u64;
+    for i in 0..nc {
+        for j in (i + 1)..nc {
+            let (bi, bj) = (&fl[i], &fl[j]);
+            let lmax = (RHO / bi.rmin().min(bj.rmin())).asin() + amps[i] + amps[j];
+            let f0 = wrap(lam0[i] - lam0[j]);
+            let f1 = f0 + (bi.n - bj.n) * t_end;
+            let minf = if f0 * f1 <= 0.0 { 0.0 } else { f0.abs().min(f1.abs()) };
+            if minf <= lmax {
+                watch += 1;
+            }
+        }
+    }
+    out.watch_pairs = watch;
+
+    for &(i, j) in &keys {
+        let (d, t) = best[&(i, j)];
+        out.dmin = out.dmin.min(d);
+        let mut lam = vec![0.0f64; nc];
+        let mut th = vec![0.0f64; nc];
+        let mut pos = vec![[0.0f64; 2]; nc];
+        for k in 0..nc {
+            let m = fl[k].mean_anomaly(t);
+            lam[k] = m + fl[k].pom;
+            let st = fl[k].state_at_mean(m);
+            pos[k] = [st[0], st[1]];
+            th[k] = st[1].atan2(st[0]);
+        }
+        let (i, j) = (i as usize, j as usize);
+        // distance rank (the gold's metric), both directions, min
+        let di = (0..nc)
+            .filter(|&k| k != i && k != j)
+            .filter(|&k| (pos[k][0] - pos[i][0]).hypot(pos[k][1] - pos[i][1]) < d)
+            .count() as u64;
+        let dj = (0..nc)
+            .filter(|&k| k != i && k != j)
+            .filter(|&k| (pos[k][0] - pos[j][0]).hypot(pos[k][1] - pos[j][1]) < d)
+            .count() as u64;
+        let dr = di.min(dj);
+        out.dist_max = out.dist_max.max(dr);
+        out.dist_le4 += (dr <= 4) as u64;
+        let tr = circ_rank(&th, i, j);
+        out.true_max = out.true_max.max(tr);
+        out.true_le4 += (tr <= 4) as u64;
+        let lr = circ_rank(&lam, i, j);
+        out.lb_ranks.push(lr);
+        let lam_mod: Vec<f64> = lam.iter().map(|&x| x.rem_euclid(TAU)).collect();
+        let lrm = circ_rank(&lam_mod, i, j);
+        out.lb_ranks_mod.push(lrm);
+        // window this encounter required, and the two window bounds
+        let w = wrap(lam[i] - lam[j]).abs();
+        out.lb_win_max = out.lb_win_max.max(w);
+        let (bi, bj) = (&fl[i], &fl[j]);
+        let sound = (RHO / bi.rmin().min(bj.rmin())).asin() + amps[i] + amps[j];
+        out.sound_viol = out.sound_viol.max(w - sound);
+        let two = RHO + 2.0 * (bi.e + bj.e) + 1.25 * (bi.e * bi.e + bj.e * bj.e);
+        out.twoterm_viol = out.twoterm_viol.max(w - two);
+    }
+    out.lb_ranks.sort_unstable();
+    out.lb_ranks_mod.sort_unstable();
+    out.meth_missed = keys.iter().filter(|k| !mm.contains_key(k)).count() as u64;
+    out.meth_false = mm.keys().filter(|k| !best.contains_key(k)).count() as u64;
+
+    // top samples by lambda-bar rank
+    let mut keyed: Vec<(u64, (u32, u32))> = keys
+        .iter()
+        .map(|&k| {
+            let (d, t) = best[&k];
+            let mut lam_mod = vec![0.0f64; nc];
+            for q in 0..nc {
+                lam_mod[q] = (fl[q].mean_anomaly(t) + fl[q].pom).rem_euclid(TAU);
+            }
+            (circ_rank(&lam_mod, k.0 as usize, k.1 as usize), k)
+        })
+        .collect();
+    keyed.sort_unstable();
+    keyed.reverse();
+    for &(r, k) in keyed.iter().take(4) {
+        let (d, t) = best[&k];
+        let w = wrap((fl[k.0 as usize].mean_anomaly(t) + fl[k.0 as usize].pom)
+            - (fl[k.1 as usize].mean_anomaly(t) + fl[k.1 as usize].pom))
+        .abs();
+        let lam_raw: Vec<f64> = (0..nc).map(|q| fl[q].mean_anomaly(t) + fl[q].pom).collect();
+        let r_raw = circ_rank(&lam_raw, k.0 as usize, k.1 as usize);
+        let es = fl[k.0 as usize].e + fl[k.1 as usize].e;
+        out.samples.push(format!(
+            "{{\"pair\":[{},{}],\"lb_rank\":{},\"lb_rank_raw\":{},\"lb_win\":{:.2e},\"e_sum\":{:.2e},\"d\":{:.2e},\"meth_missed\":{}}}",
+            k.0, k.1, r, r_raw, w, es, d, !mm.contains_key(&k)
+        ));
+    }
+
+    let p = |v: &[u64], q: f64| if v.is_empty() { 0 } else { v[((q * (v.len() - 1) as f64).round()) as usize] };
+    let lb = &out.lb_ranks;
+    let lbm = &out.lb_ranks_mod;
+    println!(
+        "{{\"scene\":\"{}\",\"nc\":{},\"sig_lam\":{},\"sig_e\":{},\"pom_span\":{},\"seed\":{},\"enc\":{},\"d_min\":{:.3e},\"sweep_s\":{:.1},\"ranks\":{{\"dist\":{{\"max\":{},\"le4\":{}}},\"true\":{{\"max\":{},\"le4\":{}}},\"lbar\":{{\"max\":{},\"p50\":{},\"p90\":{},\"le4\":{},\"le8\":{},\"gt4_frac\":{:.3}}},\"lbar_mod\":{{\"max\":{},\"p50\":{},\"p90\":{},\"le4\":{},\"le8\":{},\"gt4_frac\":{:.3}}}}},\"window\":{{\"lb_max\":{:.3e},\"sound_viol_max\":{:.2e},\"twoterm_viol_max\":{:.2e}}},\"watch\":{{\"sound_pairs\":{},\"k_hat\":{:.1},\"quad\":{},\"frac_quad\":{:.3}}},\"method\":{{\"pairs\":{},\"missed\":{},\"false\":{},\"s\":{:.1},\"truncated\":{}}},\"worst\":[{}]}}",
+        name, nc, sig_lam, sig_e, pom_span, seed, out.enc, out.dmin, out.sweep_s,
+        out.dist_max, out.dist_le4, out.true_max, out.true_le4,
+        lb.last().copied().unwrap_or(0), p(lb, 0.5), p(lb, 0.9),
+        lb.iter().filter(|&&r| r <= 4).count(), lb.iter().filter(|&&r| r <= 8).count(),
+        if out.enc > 0 { 1.0 - lb.iter().filter(|&&r| r <= 4).count() as f64 / out.enc as f64 } else { 0.0 },
+        lbm.last().copied().unwrap_or(0), p(lbm, 0.5), p(lbm, 0.9),
+        lbm.iter().filter(|&&r| r <= 4).count(), lbm.iter().filter(|&&r| r <= 8).count(),
+        if out.enc > 0 { 1.0 - lbm.iter().filter(|&&r| r <= 4).count() as f64 / out.enc as f64 } else { 0.0 },
+        out.lb_win_max, out.sound_viol, out.twoterm_viol,
+        out.watch_pairs, 2.0 * out.watch_pairs as f64 / nc as f64, out.quad,
+        out.watch_pairs as f64 / out.quad as f64,
+        out.meth_pairs, out.meth_missed, out.meth_false, out.meth_s, out.meth_trunc,
+        out.samples.join(",")
+    );
+}
+
+fn rec(px: &[f64], py: &[f64], i: usize, j: usize, t: f64, best: &mut HashMap<(u32, u32), (f64, f64)>) {
+    let d = (px[i] - px[j]).hypot(py[i] - py[j]);
+    if d < RHO {
+        let e = best
+            .entry((i.min(j) as u32, i.max(j) as u32))
+            .or_insert((f64::INFINITY, t));
+        if d < e.0 {
+            *e = (d, t);
+        }
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let sel = args.first().map(|s| s.as_str()).unwrap_or("all");
+    let is = |n: &str| sel == "all" || sel == n || sel.split(',').any(|s| s == n);
+    if is("c0") {
+        scene("c0-gold-adj", 200, 1e-5, 0.01, 1e-3, 0.1, 27, true);
+    }
+    if is("w1") {
+        scene("w1-pom-pi", 200, 1e-5, 0.01, 1e-3, std::f64::consts::PI, 27, true);
+    }
+    if is("w1b") {
+        scene("w1-pom-pi-s40", 200, 1e-5, 0.01, 1e-3, std::f64::consts::PI, 40, false);
+    }
+    if is("w1c") {
+        scene("w1-pom-pi-s41", 200, 1e-5, 0.01, 1e-3, std::f64::consts::PI, 41, false);
+    }
+    if is("e3") {
+        scene("e3-sige-3e-3", 200, 1e-5, 0.01, 3e-3, std::f64::consts::PI, 27, true);
+    }
+    if is("e10") {
+        scene("e10-sige-1e-2", 200, 1e-5, 0.01, 1e-2, std::f64::consts::PI, 27, true);
+    }
+    if is("e10b") {
+        scene("e10-sige-1e-2-s40", 200, 1e-5, 0.01, 1e-2, std::f64::consts::PI, 40, false);
+    }
+    if is("s5") {
+        scene("s5-siglam-0.05", 200, 1e-5, 0.05, 3e-3, std::f64::consts::PI, 28, true);
+    }
+    if is("d30") {
+        scene("d30-debris", 200, 1e-5, 0.02, 3e-2, std::f64::consts::PI, 28, true);
+    }
+    if is("c0b") {
+        scene("c0b-gold-adj-s40", 200, 1e-5, 0.01, 1e-3, 0.1, 40, true);
+    }
+    if is("n1k") {
+        scene("n1k-nc1000-ctrl", 1000, 1e-5, 0.01, 1e-3, 0.1, 27, true);
+    }
+    if is("aspread") {
+        scene("aspread-ahw-1e-3", 200, 1e-3, 0.01, 1e-3, std::f64::consts::PI, 27, true);
+    }
+    if is("e5") {
+        scene("e5-sige-5e-2", 200, 1e-5, 0.01, 5e-2, std::f64::consts::PI, 27, true);
+    }
+    if is("dbg") {
+        dbg_method(200, 1e-5, 0.01, 1e-3, std::f64::consts::PI, 27);
+        dbg_method(200, 1e-5, 0.01, 1e-3, std::f64::consts::PI, 40);
+        dbg_method(200, 1e-5, 0.01, 1e-3, std::f64::consts::PI, 41);
+    }
+}
+
+#[allow(dead_code)]
+fn dbg_method(nc: usize, a_hw: f64, sig_lam: f64, sig_e: f64, pom_span: f64, seed: u64) {
+    let fl = fleet2(nc, a_hw, sig_lam, sig_e, pom_span, seed);
+    let cs = cone_pairs(&fl, RHO);
+    println!("{{\"dbg\":\"cone\",\"seed\":{},\"pairs\":{},\"scanned\":{}}}", seed, cs.pairs.len(), cs.scanned);
+    let mut kinds = [0u64; 3];
+    let mut ev = 0u64;
+    for &(i, j) in cs.pairs.iter().step_by(97) {
+        for sec in sections(&fl[i as usize], &fl[j as usize], RHO, SAFETY, &mut ev) {
+            kinds[sec.kind as usize] += 1;
+        }
+    }
+    println!("{{\"dbg\":\"kinds\",\"seed\":{},\"cross\":{},\"wide\":{},\"full\":{}}}", seed, kinds[0], kinds[1], kinds[2]);
+}
