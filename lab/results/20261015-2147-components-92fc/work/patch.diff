+//! The history stack's census on the shipped plane: one flight to a canonical cut, then the
+//! retired segments, the compiled-arc bytes they pin, the reads that ever served a retired
+//! binding, and the process's resident memory. `ES_COMETS=<n>` (read by `scenario`) turns the
+//! first n belt ships into infalling comets; unset, the flight is the shipped ladder scene.
+//!
+//! cargo run --release -p emergent-universe --example hist_census -- <game-seconds> <extra>
+use emergent_universe::scenario::{plane_extra, ladder_locals};
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{body, Budget, Config};
+use emergent_universe::fleet::Order;
+
+const RTF: f64 = 100.0;
+
+fn rss_mb() -> f64 {
+    std::fs::read_to_string("/proc/self/statm")
+        .ok()
+        .and_then(|s| s.split_whitespace().nth(1).and_then(|r| r.parse::<u64>().ok()))
+        .map(|pages| pages as f64 * 4096.0 / 1e6)
+        .unwrap_or(0.0)
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let seconds: f64 = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(8_000.0);
+    let extra: u64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(2_000);
+    let seed: u64 = std::env::var("SEED").ok().and_then(|s| s.parse().ok()).unwrap_or(1);
+    let cut = (seconds * RTF / TICK_SECONDS) as i64;
+    let mut p = plane_extra(Config::default(), seed, Order::Sparse, 1, extra, 0).unwrap();
+    for _ in 0..400_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        p.u.frame_to(1.0 / 60.0, RTF, Budget::unlimited(), cut);
+    }
+    p.u.settle(cut);
+    let n = p.u.bodies().len();
+    let mut segs = 0usize;
+    let mut arc = 0usize;
+    let mut deep = (0usize, 0usize, 0usize); // bodies with >50 segments: count, segs, arc bytes
+    let mut top = vec![(0usize, 0usize); 8]; // (segs, arc) leaders
+    for i in 0..n {
+        let (l, a) = (p.u.bodies().history_len(i), p.u.bodies().history_arc_bytes(i));
+        segs += l;
+        arc += a;
+        if l > 50 {
+            deep.0 += 1;
+            deep.1 += l;
+            deep.2 += a;
+        }
+        if l > top[7].0 {
+            top[7] = (l, a);
+            top.sort_by(|x, y| y.0.cmp(&x.0));
+        }
+    }
+    let comets: u64 = std::env::var("ES_COMETS").ok().and_then(|s| s.parse().ok()).unwrap_or(0);
+    println!(
+        "cut {:.0}s bodies {} (comets {}, locals {}) | kicks {} | retired_reads {} | segs {} (deep>50: {} bodies, {} segs) | pinned_arc_MB {:.1} (deep {:.1}) | rss_MB {:.1}",
+        seconds, n, comets, ladder_locals(extra), p.u.stats.kicks,
+        body::RETIRED_READS.load(std::sync::atomic::Ordering::Relaxed),
+        segs, deep.0, deep.1, arc as f64 / 1e6, deep.2 as f64 / 1e6, rss_mb()
+    );
+    println!("  per-body segs: {}", top.iter().map(|(l, a)| format!("{}:{:.0}kB", l, *a as f64 / 1e3)).collect::<Vec<_>>().join(" "));
+    println!("  digest {}", &p.u.digest()[..32]);
+}
