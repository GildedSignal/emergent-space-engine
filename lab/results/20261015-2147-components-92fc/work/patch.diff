+pub use std::sync::atomic::{AtomicU64, Ordering};
+
+/// Reads that served a RETIRED binding (the history stack's whole read demand). Observation only:
+/// `binding_at` is `&self`, so this counter cannot move a bit of state.
+pub static RETIRED_READS: AtomicU64 = AtomicU64::new(0);
+
+/// Bytes of the compiled trajectory an `Arc` holds, by the store's own accounting (`bytes_of`'s
+/// shape formula: knots for cycles, a panel budget for passages, the plunge's retained bytes).
+pub fn arc_bytes(t: &emergent_space::binding::Trajectory) -> usize {
+    match t {
+        emergent_space::binding::Trajectory::Cycle(o) => o.shape().knots().len() * size_of::<emergent_space::orbit::Knot>() + o.shape().crossings().len() * size_of::<usize>(),
+        emergent_space::binding::Trajectory::Passage(_) => 4096,
+        emergent_space::binding::Trajectory::Plunge(p) => p.retained_bytes(),
+    }
+}
