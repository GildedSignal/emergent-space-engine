+//! The scan queue's phase diagram (the lab's dynamics lens): the player born mid-belt (`ES_BELT_PLAYER`),
+//! one sustained burn, then coast. Paced at 60 Hz like the player's frame loop; the engine advance under
+//! a wall budget; the scan counters (`encounter::scan_counters`) and `held_scans` sampled every frame.
+//! Print-only instrument: the counters are atomics no law reads.
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::{Budget, Config};
+use emergent_universe::fleet::Order;
+use emergent_universe::view::TICK_SECONDS;
+use std::io::Write as _;
+use std::time::{Duration, Instant};
+
+fn rss_mb() -> f64 {
+    std::fs::read_to_string("/proc/self/statm")
+        .ok()
+        .and_then(|s| s.split_whitespace().nth(1).and_then(|r| r.parse::<u64>().ok()))
+        .map_or(0.0, |pages| pages as f64 * 4096.0 / 1e6)
+}
+
+fn arg(name: &str, default: &str) -> String {
+    std::env::args().collect::<Vec<_>>().windows(2).find(|w| w[0] == name).map_or_else(|| default.to_string(), |w| w[1].clone())
+}
+
+fn main() {
+    let n: usize = arg("--n", "2000").parse().unwrap();
+    let seed: u64 = arg("--seed", "1").parse().unwrap();
+    let level: u8 = arg("--level", "0").parse().unwrap();
+    let engine_ms: f64 = arg("--engine-ms", "5.0").parse().unwrap();
+    let rtf: f64 = arg("--rtf", "1.0").parse().unwrap();
+    let burn_s: f64 = arg("--burn-s", "12").parse().unwrap();
+    let coast_s: f64 = arg("--coast-s", "10").parse().unwrap();
+    let warmup_s: f64 = arg("--warmup-s", "3").parse().unwrap();
+    let fence_mb: f64 = arg("--fence-mb", "1700").parse().unwrap();
+    let key: u8 = arg("--key", "1").parse().unwrap();
+    let frames = ((warmup_s + burn_s + coast_s) * 60.0) as usize;
+    std::env::set_var("ES_BELT_PLAYER", "1");
+    let t0 = Instant::now();
+    let p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).expect("the plane");
+    let mut u = p.u;
+    let player = p.player;
+    eprintln!("setup_s {:.2} bodies {} player_alive {}", t0.elapsed().as_secs_f64(), u.n_bodies(), u.rec(player).alive);
+    // The burn and its release, at canonical ticks (the wall's frames never move a decision).
+    let per_frame = rtf / 60.0 / TICK_SECONDS;
+    let (f_on, f_off) = ((warmup_s * 60.0) as usize, ((warmup_s + burn_s) * 60.0) as usize);
+    let word = |keys: u8| emergent_universe::thrust::word(keys, level);
+    u.schedule(((f_on as f64) * per_frame).round() as i64, word(key)).unwrap();
+    u.schedule(((f_off as f64) * per_frame).round() as i64, word(0)).unwrap();
+    let (wall, mut last) = (Instant::now(), Instant::now());
+    let (mut f, mut fence_hit) = (0usize, false);
+    for fno in 1..=frames {
+        let due = wall + Duration::from_secs_f64(fno as f64 / 60.0);
+        if let Some(wait) = due.checked_duration_since(Instant::now()) {
+            std::thread::sleep(wait);
+        }
+        let dt = last.elapsed().as_secs_f64().min(0.1);
+        last = Instant::now();
+        let fs = last.elapsed();
+        let _ = fs;
+        let fr = last;
+        u.frame_to(dt, rtf, Budget::wall(engine_ms), i64::MAX);
+        let frame_ms = fr.elapsed().as_secs_f64() * 1e3;
+        let (mints, answers, ans_ns, _cap_ns) = emergent_universe::encounter::scan_counters();
+        let row = format!(
+            "{{\"f\":{},\"t\":{:.3},\"held\":{},\"mints\":{},\"answers\":{},\"ans_ms\":{:.3},\"tick\":{},\"nom\":{},\"frame_ms\":{:.3},\"rss\":{:.1}}}\n",
+            fno, fno as f64 / 60.0, u.held_scans(), mints, answers, ans_ns as f64 / 1e6 / answers.max(1) as f64,
+            u.now, (fno as f64 * per_frame).round() as i64, frame_ms, rss_mb()
+        );
+        let mut so = std::io::stdout().lock();
+        so.write_all(row.as_bytes()).unwrap();
+        if rss_mb() > fence_mb {
+            fence_hit = true;
+            f = fno;
+            break;
+        }
+    }
+    let (mints, answers, ans_ns, _) = emergent_universe::encounter::scan_counters();
+    // The deferred bill: answer everything still held, timed.
+    let t1 = Instant::now();
+    let held_before = u.held_scans();
+    u.flush_scans();
+    let drain_s = t1.elapsed().as_secs_f64();
+    eprintln!(
+        "{{\"summary\":true,\"n\":{},\"seed\":{},\"level\":{},\"engine_ms\":{},\"burn_s\":{},\"frames_flown\":{},\"fence_hit\":{},\"player_alive\":{},\"mints\":{},\"answers\":{},\"ans_ms_each\":{:.3},\"held_before_flush\":{},\"flush_s\":{:.3},\"rss_peak_or_end\":{:.1}}}",
+        n, seed, level, engine_ms, burn_s, if f == 0 { frames } else { f }, fence_hit, u.rec(player).alive,
+        mints, answers, ans_ns as f64 / 1e6 / answers.max(1) as f64, held_before, drain_s, rss_mb()
+    );
+}
