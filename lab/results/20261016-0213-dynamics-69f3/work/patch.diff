+// The scan queue's instrument (print-only, digest-neutral): how many scans were minted (new `Scan`s,
+// not reuses of the last), how many were answered (the expensive half run), and the ns the answers and
+// the captures took. Read by the lab's scan-queue probe; nothing in the law reads these.
+static MINTS: AtomicU64 = AtomicU64::new(0);
+static ANSWERS: AtomicU64 = AtomicU64::new(0);
+static ANSWER_NS: AtomicU64 = AtomicU64::new(0);
+static CAPTURE_NS: AtomicU64 = AtomicU64::new(0);
+
+/// The scan queue's counters: (mints, answers, answer_ns, capture_ns).
+pub fn scan_counters() -> (u64, u64, u64, u64) {
+    (MINTS.load(Ordering::Relaxed), ANSWERS.load(Ordering::Relaxed), ANSWER_NS.load(Ordering::Relaxed), CAPTURE_NS.load(Ordering::Relaxed))
+}
