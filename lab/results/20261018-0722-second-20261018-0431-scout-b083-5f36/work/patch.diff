diff --git a/crates/universe/examples/rigidring.rs b/crates/universe/examples/rigidring.rs
new file mode 100644
index 00000000..3223087b
--- /dev/null
+++ b/crates/universe/examples/rigidring.rs
@@ -0,0 +1,196 @@
+//! The rigid-ring probe: the shipped encounter ANSWER (`law::hit` with its approaching
+//! conjunct) on a rigid keys fleet — K ships on ONE compiled orbit (same key, uniform
+//! phases) in Home's doll beside the shipped plane — against the near set (the exact
+//! tier's read list), with the integer d.w classified exactly in i128. Flown on the
+//! shipped binary: one frame registers bodies into the radial store, then the shipped
+//! `PlayerNeighbourhood::capture`+`answer` path decides. Print-only.
+//! cargo run --release -p emergent-universe --example rigidring -- [K [rho_e5 [e_q48 [report_t]]]]
+use emergent_universe::body::Kind;
+use emergent_universe::encounter::{Encounters, PlayerNeighbourhood};
+use emergent_universe::num::{time_of, to_f64};
+use emergent_universe::scenario::{plane_extra, Plane};
+use emergent_universe::{Budget, Config, OrbitSpec};
+use emergent_space::orbit::Scalar;
+use std::time::Instant;
+
+fn f(s: Scalar) -> f64 { to_f64(s) }
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let k: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(10_000);
+    let rho_e5: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(1.0); // rho = rho_e5 * 1e-5
+    let e_q48: u64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(1); // 1 = e 2^-48 (circular key)
+    let report_t: bool = args.get(4).map(|s| s != "0").unwrap_or(true);
+    let angle: u32 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(0x2000_0000);
+    let t0 = Instant::now();
+    let Plane { mut u, dolls, .. } = plane_extra(Config::default(), 1, emergent_universe::fleet::Order::Sparse, 1, 48, 0).unwrap();
+    let home = dolls[1];
+    let peri = Scalar::raw(6_000, 18).unwrap(); // 6000 root units, above the player's 4,740
+    let r_ring = f(peri);
+    let r_ship = Scalar::raw((rho_e5 * 5e-6 * r_ring) as i128, 0).unwrap(); // reach = 2 r_ship = rho r
+    let reach = 2.0 * f(r_ship);
+    let rho = reach / r_ring;
+    let mut ring = Vec::with_capacity(k);
+    for j in 0..k {
+        let phase = ((j as u128) << 32) / (k as u128);
+        ring.push(u.add_body(
+            Kind::Ship,
+            OrbitSpec { doll: home, periapsis: peri, e_q48: e_q48, clockwise: false, angle, phase: phase as u32 },
+            r_ship,
+        ).unwrap());
+    }
+    let obs = ring[0];
+    let (rlo, rhi) = (ring[0], *ring.last().unwrap());
+    u.start().unwrap(); // the plane started before the ring: replan with everyone made
+    // Warm up until the radial store has registered (nearly) everyone: registration rides item resolution.
+    let total = u.ctx().bodies.len();
+    let mut frames = 0usize;
+    while u.ctx().radial.bodies + 5 < total && frames < 900 {
+        let _ = u.frame_to(1.0 / 60.0, 100.0, Budget { events: u64::MAX, until: None }, i64::MAX);
+        frames += 1;
+    }
+    println!("warmup: {frames} frames, radial.bodies={}/{}", u.ctx().radial.bodies, total);
+    println!("ring K={k} angle={angle:#x} e_q48={e_q48} r_ring={r_ring:.3e} reach={reach:.3e} rho={rho:.3e} near_over_r={:.3e} build={:.2}s bodies={}",
+             1024.0 * rho, t0.elapsed().as_secs_f64(), u.ctx().bodies.len());
+
+    for interval in [2i64, 1 << 12, 1 << 24] {
+        let ctx = u.ctx();
+        let t = ctx.bodies.event_time(obs).max(1);
+        let me = ctx.bodies.binding_at(obs, t).unwrap();
+        let h = f(time_of(interval, me.clock_exp).unwrap());
+        let (x, v) = me.cartesian(t).unwrap();
+        // Scan::compute's exact integer quantization, replicated (pub API): units of 2^q_exp.
+        let reach_s = ctx.info[obs].radius.add(ctx.info[ring[1]].radius).unwrap();
+        let q_exp = reach_s.exponent() as i32 - 20;
+        let near_s = reach_s.scale(10).unwrap();
+        let qi = |s: Scalar| s.fixed(-q_exp).unwrap();
+        let (mut cands, mut inwin, mut dwz, mut dwn, mut dwp, mut ring_c, mut near_rd) = (0usize, 0, 0, 0, 0, 0, 0);
+        let (mut iwin_ring, mut iwin_dwn, mut iwin_dwz, mut iwin_dwp) = (0usize, 0, 0, 0);
+        let mut iwin_cos: Vec<f64> = Vec::new();
+        for j in 0..ctx.bodies.len() {
+            if j == obs || !ctx.bodies.alive(j) || t <= ctx.info[j].born { continue; }
+            let Some(other) = ctx.bodies.binding_at(j, t) else { continue };
+            if other.doll != home { continue; }
+            let reach2 = ctx.info[obs].radius.add(ctx.info[j].radius).unwrap_or(Scalar::ZERO);
+            if reach2.is_zero() { continue; }
+            cands += 1;
+            if j >= rlo && j <= rhi { ring_c += 1; }
+            let Ok((xj, vj)) = other.cartesian(t) else { continue };
+            let (dx, dy) = (xj[0].sub(x[0]).unwrap(), xj[1].sub(x[1]).unwrap());
+            let w = [vj[0].sub(v[0]).unwrap().mul(time_of(interval, me.clock_exp).unwrap()).unwrap(), vj[1].sub(v[1]).unwrap().mul(time_of(interval, me.clock_exp).unwrap()).unwrap()];
+            let (dix, diy, wix, wiy) = (qi(dx), qi(dy), qi(w[0]), qi(w[1]));
+            let (dd, dw, ww) = (dix * dix + diy * diy, dix * wix + diy * wiy, wix * wix + wiy * wiy);
+            let rr = qi(near_s) * qi(near_s);
+            if dd <= rr {
+                inwin += 1;
+                if j >= rlo && j <= rhi {
+                    iwin_ring += 1;
+                    if dw < 0 { iwin_dwn += 1 } else if dw == 0 { iwin_dwz += 1 } else { iwin_dwp += 1 }
+                    let dn = ((dd as f64).sqrt() * (ww as f64).sqrt()).max(1.0);
+                    iwin_cos.push(dw as f64 / dn);
+                }
+            }
+            if dw == 0 { dwz += 1 } else if dw < 0 { dwn += 1 } else { dwp += 1 }
+            // the read list the tier would confirm exactly: seg-dist <= near, approaching ignored
+            let seg = if dd <= rr { true } else if ww == 0 || dw >= 0 { false } else if -dw >= ww { (dix + wix) * (dix + wix) + (diy + wiy) * (diy + wiy) <= rr } else { (dix * wiy - diy * wix) * (dix * wiy - diy * wix) <= rr * ww };
+            if seg { near_rd += 1; }
+        }
+        // The shipped decision, timed: fresh captures so nothing is cached.
+        let reps = 5;
+        let mut answers = Vec::new();
+        let (mut tc, mut ta) = (0f64, 0f64);
+        for _ in 0..reps {
+            let finder = PlayerNeighbourhood::default();
+            let a = Instant::now();
+            let held = finder.capture(&ctx, obs, t, interval).unwrap();
+            tc += a.elapsed().as_secs_f64();
+            let b = Instant::now();
+            answers = held.answer();
+            ta += b.elapsed().as_secs_f64();
+        }
+        let (tc, ta) = (tc / reps as f64, ta / reps as f64);
+        {
+            // The engine predicate on replicated integers, over ALL candidates: count + examples.
+            use emergent_lattice::law::hit;
+            let (mut mine_true, mut ex) = (0usize, (0usize, 0, 0));
+            for j in 0..ctx.bodies.len() {
+                if j == obs || !ctx.bodies.alive(j) || t <= ctx.info[j].born { continue; }
+                let Some(other) = ctx.bodies.binding_at(j, t) else { continue };
+                if other.doll != home { continue; }
+                let reach2 = ctx.info[obs].radius.add(ctx.info[j].radius).unwrap_or(Scalar::ZERO);
+                if reach2.is_zero() { continue; }
+                let Ok((xj, vj)) = other.cartesian(t) else { continue };
+                let (dx, dy) = (xj[0].sub(x[0]).unwrap(), xj[1].sub(x[1]).unwrap());
+                let w = [vj[0].sub(v[0]).unwrap().mul(time_of(interval, me.clock_exp).unwrap()).unwrap(), vj[1].sub(v[1]).unwrap().mul(time_of(interval, me.clock_exp).unwrap()).unwrap()];
+                let q2 = reach2.exponent() as i32 - 20;
+                let qi2 = |sc: Scalar| sc.fixed(-q2).unwrap();
+                let (di, wi) = ([qi2(dx), qi2(dy)], [qi2(w[0]), qi2(w[1])]);
+                let nq2 = qi2(reach2.scale(10).unwrap());
+                if hit(di, wi, nq2) { mine_true += 1; if ex.0 < 3 { println!("  myhit[{:?}] j={j} di={di:?} wi={wi:?} near={nq2}", ex.0); ex.0 += 1; } }
+                if ex.1 < 3 && di[0]*di[0] + di[1]*di[1] <= nq2*nq2 { println!("  inwin[{:?}] j={j} di={di:?} wi={wi:?} near={nq2} dw={}", ex.1, di[0]*wi[0] + di[1]*wi[1]); ex.1 += 1; }
+            }
+            println!("  my replicated hit true: {mine_true} (engine ANSWERS: {})", answers.len());
+        }
+        if interval == 2 {
+            // Geometry: chords |d| to ring members, smallest 12 + zero/near counts + angle steps.
+            let mut chords: Vec<f64> = Vec::new();
+            for j in rlo..=rhi {
+                let Some(other) = ctx.bodies.binding_at(j, t) else { continue };
+                let Ok((xj, _)) = other.cartesian(t) else { continue };
+                let (dx, dy) = (f(xj[0].sub(x[0]).unwrap()), f(xj[1].sub(x[1]).unwrap()));
+                chords.push((dx * dx + dy * dy).sqrt());
+            }
+            chords.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            println!("  geom: ring={:?} zero_chord={} lt_near={} | smallest: {:?} | steps: first 10 {:.3e}",
+                chords.len(), chords.iter().filter(|c| **c == 0.0).count(), chords.iter().filter(|c| **c < 1024.0 * reach).count(),
+                &chords[..chords.len().min(12)], chords[1..11].iter().map(|c| *c).sum::<f64>() / 10.0);
+            // Diagnostic: the engine predicate called directly on replicated integers, nearest ring members.
+            use emergent_lattice::law::hit;
+            let mut rows: Vec<(i128, i128, [i128;2], [i128;2], i128, bool, bool)> = Vec::new();
+            for j in 0..ctx.bodies.len() {
+                if j == obs || j < rlo || j > rhi { continue; }
+                let Some(other) = ctx.bodies.binding_at(j, t) else { continue };
+                let Ok((xj, vj)) = other.cartesian(t) else { continue };
+                let (dx, dy) = (xj[0].sub(x[0]).unwrap(), xj[1].sub(x[1]).unwrap());
+                let w = [vj[0].sub(v[0]).unwrap().mul(time_of(interval, me.clock_exp).unwrap()).unwrap(), vj[1].sub(v[1]).unwrap().mul(time_of(interval, me.clock_exp).unwrap()).unwrap()];
+                let (di, wi) = ([qi(dx), qi(dy)], [qi(w[0]), qi(w[1])]);
+                let nq = qi(near_s);
+                let dd = di[0]*di[0] + di[1]*di[1];
+                rows.push((dd, di[0]*wi[0] + di[1]*wi[1], di, wi, nq, hit(di, wi, nq), false));
+                if rows.len() >= 6 { break; }
+            }
+            for (i, (dd, dw, di, wi, nq, h, _)) in rows.iter().enumerate() {
+                println!("  diag[{i}] |d|={:.3e} dw={dw} near={nq} hit={h} di={di:?} wi={wi:?}", (dd.clone() as f64).sqrt());
+            }
+        }
+        let contacts = answers.iter().filter(|e| e.contact).count();
+        let ans_ring = answers.iter().filter(|e| e.b >= rlo && e.b <= rhi).count();
+        println!(
+            "scan interval={interval} h={h:.3e} | candidates={cands} (ring {ring_c}) | near_set(read list)={near_rd} in_window={inwin} | INTEGER d.w: ==0:{dwz} <0:{dwn} >0:{dwp} | IN-WINDOW ring {iwin_ring}: dw<0:{iwin_dwn} ==0:{iwin_dwz} >0:{iwin_dwp} cos(d,w) med {:.1e} | ANSWERS={} (ring {ans_ring}, contacts {contacts}) | capture {:.0} us answer {:.0} us ({:.0} ns/cand)",
+            { iwin_cos.clone().sort_by(|a, b| a.partial_cmp(b).unwrap()); iwin_cos.get(iwin_cos.len() / 2).copied().unwrap_or(0.0) },
+            answers.len(), tc * 1e6, ta * 1e6, if cands > 0 { ta * 1e9 / cands as f64 } else { 0.0 });
+        println!("  answer ids (first 40): {:?}", &answers.iter().map(|e| e.b).take(40).collect::<Vec<_>>());
+        if report_t && interval == 2 {
+            // Quarter/ half-period away on the same ring: near set constant; answer membership?
+            let b = ctx.bodies.binding_at(obs, t).unwrap();
+            let (x0, _) = b.cartesian(t).unwrap();
+            let a0 = f64::atan2(f(x0[1]), f(x0[0]));
+            let (mut dt, mut quarter) = (1i64, None);
+            for _ in 0..62 {
+                if let Ok((x1, _)) = b.cartesian(t + dt) {
+                    if (f64::atan2(f(x1[1]), f(x1[0])) - a0).abs() >= std::f64::consts::FRAC_PI_2 { quarter = Some(dt); break; }
+                }
+                dt *= 2;
+            }
+            if let Some(q) = quarter {
+                for dq in [q, 2 * q] {
+                    let finder = PlayerNeighbourhood::default();
+                    let t2 = t + dq;
+                    let held2 = finder.capture(&ctx, obs, t2, interval).unwrap();
+                    let ans2 = held2.answer();
+                    println!("  t+{dq}: ANSWERS={} ids {:?}", ans2.len(), &ans2.iter().map(|e| e.b).take(10).collect::<Vec<_>>());
+                }
+            }
+        }
+    }
+}
