     "  fit again: the coarser word (bind_surface)",
+    "  readout: one tube decode (Binding::readout)",
+    "  secondaries: source states rebuilt (Ctx::secondaries)",
 ];
 
+/// The `(doll, tick)` multiplicity of `Ctx::secondaries` calls: how many events of one flight
+/// shared one field read (feature `prof` only; print-only instrument). `take` resets it.
+/// Compiled always (the call sites are const-false without `prof`), called only under it.
+pub mod secstat {
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    thread_local! {
+        static M: RefCell<HashMap<(u16, i64), u64>> = RefCell::new(HashMap::new());
+    }
+    pub fn count(d: u16, t: i64) {
+        M.with(|m| *m.borrow_mut().entry((d, t)).or_insert(0) += 1);
+    }
+    /// (distinct (doll, tick) keys, total calls, calls at multiplicity ≥ 2/4/8/16/64).
+    pub fn take() -> (usize, u64, [u64; 5]) {
+        M.with(|m| {
+            let mut map = m.borrow_mut();
+            let distinct = map.len();
+            let total: u64 = map.values().sum();
+            let mut at = [0u64; 5];
+            for v in map.values() {
+                for (i, th) in [2u64, 4, 8, 16, 64].iter().enumerate() {
+                    if *v >= *th {
+                        at[i] += *v;
+                    }
+                }
+            }
+            map.clear();
+            (distinct, total, at)
+        })
+    }
+}
