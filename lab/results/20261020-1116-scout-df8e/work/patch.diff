+/// The Linux stand-in (the lab's cloud box): VmHWM is the peak resident size, VmRSS the current one.
+#[cfg(target_os = "linux")]
+fn footprint() -> (u64, u64) {
+    let read = |key: &str| -> Option<u64> {
+        let s = std::fs::read_to_string("/proc/self/status").ok()?;
+        let l = s.lines().find(|l| l.starts_with(key))?;
+        l.split_whitespace().nth(1)?.parse().ok()
+    };
+    (read("VmRSS:").unwrap_or(0) * 1024, read("VmHWM:").unwrap_or(0) * 1024)
+}
