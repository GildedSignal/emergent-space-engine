+// ES_FIX_PROBE (a probe; unset = all zero and no work): what a captured candidate reads. A candidate is *stale* when
+// its body's next item is due before the scan's tick (its binding at that tick is a fit the due item will replace),
+// so with the root's ships left to the queue the scan's answer is a function of the schedule, not of the law.
+pub fn scan_probe_counts() -> (u64, u64, u64, u64) {
+    (SCANS.load(Relaxed), CANDS.load(Relaxed), STALE.load(Relaxed), STALE_MAX.load(Relaxed))
+}
+static SCANS: AtomicU64 = AtomicU64::new(0);
+static CANDS: AtomicU64 = AtomicU64::new(0);
+static STALE: AtomicU64 = AtomicU64::new(0);
+static STALE_MAX: AtomicU64 = AtomicU64::new(0);
+static PROBE: AtomicU8 = AtomicU8::new(0);
+fn probe_on() -> bool {
+    match PROBE.load(Relaxed) {
+        0 => {
+            let on = std::env::var_os("ES_FIX_PROBE").is_some();
+            PROBE.store(if on { 2 } else { 1 }, Relaxed);
+            on
+        }
+        v => v == 2,
+    }
+}
