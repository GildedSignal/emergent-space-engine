+//! Knot-table census (lab run 20261014-1221-system-b8fc): who pays for the compiled cycle's panel
+//! grid, and who reads it. Purely additive counters — no arithmetic of the law is touched, so no
+//! bit can move. All hooks are in `orbit.rs` (the bound Darwin cycle and its readouts); Kerr and
+//! light are out of this census's domain.
+use std::cell::{Cell, RefCell};
+use std::collections::HashSet;
+
+pub const COMPILES: usize = 0; // bound-cycle table builds (Orbit::compile)
+pub const KNOTS: usize = 1; // knots pushed by the build walk (panels + 1)
+pub const C_QUADS: usize = 2; // quad calls at build
+pub const C_NODES: usize = 3; // node() integrand evals at build (general branch)
+pub const READS: usize = 4; // outbound_at calls: every time→state readout
+pub const R_PROBES: usize = 5; // bracket binary-search probes over the knot sums
+pub const R_NEWTON: usize = 6; // Newton iterations inside the bracket
+pub const R_QUADS: usize = 7; // quad calls at readout (partial-panel re-integration)
+pub const R_NODES: usize = 8; // node() evals inside readout quads
+pub const R_RATE: usize = 9; // node() evals as Newton's rate
+pub const R_AR: usize = 10; // at_radius calls (the passage guess path)
+pub const AR_QUADS: usize = 11; // quad calls inside at_radius
+pub const TOUCHED: usize = 12; // distinct (table, bracket) cells ever read
+pub const TABLES: usize = 13; // distinct tables that were read at least once
+pub const OTHER_NODES: usize = 14; // node() evals outside build/read/at_radius
+pub const N: usize = 15;
+
+pub const NAMES: [&str; N] = [
+    "compiles (Orbit::compile)",
+    "knots pushed",
+    "quad calls at build",
+    "node evals at build",
+    "readouts (outbound_at)",
+    "bracket probes",
+    "newton iterations",
+    "quad calls at readout",
+    "node evals in readout quads",
+    "node evals as newton rate",
+    "at_radius calls",
+    "quad calls in at_radius",
+    "distinct (table,bracket) read",
+    "distinct tables read",
+    "node evals elsewhere",
+];
+
+/// Who is calling `node()` right now (0 other, 1 build, 2 readout, 3 at_radius).
+thread_local! {
+    static ROLE: Cell<u8> = const { Cell::new(0) };
+    static C: RefCell<Census> = RefCell::new(Census { c: [0; N], cells: HashSet::new(), tables: HashSet::new() });
+}
+
+struct Census {
+    c: [u64; N],
+    cells: HashSet<(usize, u32)>,
+    tables: HashSet<usize>,
+}
+
+pub fn node() {
+    C.with(|c| {
+        let i = match ROLE.get() {
+            1 => C_NODES,
+            2 => R_NODES,
+            3 => R_NODES, // at_radius re-integrates the same partial panels; counted by its quad calls
+            _ => OTHER_NODES,
+        };
+        c.borrow_mut().c[i] += 1;
+    });
+}
+
+pub fn bump(i: usize) {
+    C.with(|c| c.borrow_mut().c[i] += 1);
+}
+pub fn role(r: u8) {
+    ROLE.set(r);
+}
+/// A readout settled on bracket `index` of table `id`.
+pub fn touch(id: usize, index: usize) {
+    C.with(|c| {
+        let mut b = c.borrow_mut();
+        b.cells.insert((id, index as u32));
+        b.tables.insert(id);
+    });
+}
+pub fn take() -> [u64; N] {
+    C.with(|c| {
+        let mut b = c.borrow_mut();
+        b.c[TOUCHED] = b.cells.len() as u64;
+        b.c[TABLES] = b.tables.len() as u64;
+        b.c
+    })
+}
