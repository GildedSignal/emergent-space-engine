diff --git a/crates/universe/examples/knot_census.rs b/crates/universe/examples/knot_census.rs
new file mode 100644
index 00000000..5e2f9999
--- /dev/null
+++ b/crates/universe/examples/knot_census.rs
@@ -0,0 +1,87 @@
+//! The knot-table census (lab run 20261014-1221-system-b8fc): on a shipped plane scene, who pays
+//! for the compiled cycle's panel grid (the build walk) and who reads it (brackets + partial-panel
+//! re-integration), with the universe's own stage timers when built `--features prof`.
+//! Counters only — no arithmetic changed — so the digest at the cut is the shipped one and must
+//! agree across schedules (checked here at unlimited vs a biting wall budget).
+//!
+//! cargo run --release -p emergent-universe --features prof --example knot_census --
+//!   [<seed> <members> <rtf> <game-seconds> [<wall-ms budget, 0 = unlimited>]]
+use emergent_space::census;
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let seed: u64 = a.get(1).and_then(|s| s.parse().ok()).unwrap_or(3);
+    let members: u64 = a.get(2).and_then(|s| s.parse().ok()).unwrap_or(1500);
+    let rtf: f64 = a.get(3).and_then(|s| s.parse().ok()).unwrap_or(1.0);
+    let secs: f64 = a.get(4).and_then(|s| s.parse().ok()).unwrap_or(8.0);
+    let wall_ms: f64 = a.get(5).and_then(|s| s.parse().ok()).unwrap_or(0.0);
+    let cut = (secs * rtf / TICK_SECONDS) as i64;
+    let mut p = plane(Config::default(), seed, Order::Sparse, 1, members).unwrap();
+    let budget = if wall_ms > 0.0 { Budget::wall(wall_ms) } else { Budget::unlimited() };
+    let t0 = std::time::Instant::now();
+    for _ in 0..200_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        p.u.frame_to(1.0 / 60.0, rtf, budget, cut);
+    }
+    let reached = p.u.now;
+    let engine = t0.elapsed();
+    p.u.settle(cut);
+    let digest = p.u.digest();
+    let c = census::take();
+    println!(
+        "seed {seed} members {members} rtf {rtf} {secs} game-s budget {} | digest {} reached {} kicks {} handouts {}",
+        if wall_ms > 0.0 { format!("{wall_ms} ms") } else { "unlimited".into() },
+        &digest[..32],
+        reached,
+        p.u.stats.kicks,
+        p.u.stats.dissolved,
+    );
+    println!("engine wall {:.2} s (frames, before the settle)", engine.as_secs_f64());
+    for (i, n) in census::NAMES.iter().zip(c.iter()) {
+        println!("  {:<34} {}", n, n_separated(*n));
+    }
+    let integrand_build = 4 * c[census::C_QUADS] + c[census::C_NODES];
+    let integrand_read = 4 * c[census::R_QUADS] + c[census::R_NODES] + 4 * c[census::AR_QUADS];
+    println!(
+        "  integrand evals: build {} ({:.1}%) read {} ({:.1}%) | knots/table {:.1} readouts/table {:.1} cells-read/table {:.1}",
+        n_separated(integrand_build),
+        100.0 * integrand_build as f64 / (integrand_build + integrand_read).max(1) as f64,
+        n_separated(integrand_read),
+        100.0 * integrand_read as f64 / (integrand_build + integrand_read).max(1) as f64,
+        c[census::KNOTS] as f64 / c[census::COMPILES].max(1) as f64,
+        c[census::READS] as f64 / c[census::TABLES].max(1) as f64,
+        c[census::TOUCHED] as f64 / c[census::TABLES].max(1) as f64,
+    );
+    if emergent_universe::prof::ENABLED {
+        let (ns, calls) = emergent_universe::prof::take();
+        for i in 0..emergent_universe::prof::N {
+            if calls[i] > 0 {
+                println!(
+                    "  prof {:<40} {:>9.1} ms  {:>7} calls  {:>7.0} ns/call",
+                    emergent_universe::prof::NAMES[i],
+                    ns[i] as f64 / 1e6,
+                    n_separated(calls[i]),
+                    ns[i] as f64 / calls[i].max(1) as f64
+                );
+            }
+        }
+    }
+}
+
+fn n_separated(n: u64) -> String {
+    let s = n.to_string();
+    let mut out = String::new();
+    for (i, ch) in s.chars().enumerate() {
+        if i > 0 && (s.len() - i) % 3 == 0 {
+            out.push(',');
+        }
+        out.push(ch);
+    }
+    out
+}
