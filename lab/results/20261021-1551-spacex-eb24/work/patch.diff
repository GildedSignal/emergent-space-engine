@@ -0,0 +1,94 @@
+//! The scan's capture walk: attributed (od 1 of the scan-news page) and pre-checked (od 3).
+//!
+//! The shipped plane (`scenario::plane_extra`, the nladder scene) flown the way nladder flies it;
+//! `ES_SCAN_SPLIT=1` times the walk's halves (the player's own `binding_at`, the radial window,
+//! the per-candidate lookups and the build), `ES_SCAN_PRECHECK=1` turns on the exact pre-check
+//! (the store-epoch certificate: nothing resolved since the last scan ⇒ the walk's every reading
+//! is what the last scan already holds). The digest after `settle` is schedule-independent, so
+//! off and on must print the same one: the pre-check returns the memo's own `Arc`.
+//!
+//! cargo run --release -p emergent-universe --example scanpre [-- <N> <coast|burn> [<wall s> [<rtf> [<budget ms>]]]]
+use emergent_universe::encounter::stat;
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+/// Linux: peak resident set from /proc (the macOS footprint call is not portable).
+fn peak_rss_mb() -> f64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines().find(|l| l.starts_with("VmHWM")).and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<f64>().ok()))
+        })
+        .map_or(0.0, |kb| kb / 1024.0)
+}
+
+fn main() {
+    let t_start = Instant::now();
+    stat::arm();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(30000);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let mut rows: Vec<f64> = Vec::new();
+    let mut late_stats: Option<(emergent_universe::universe::Stats, i64)> = None;
+    let mut held_max = 0usize;
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(20.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms: f64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(12.0);
+    let frames = (seconds * 60.0) as usize;
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let bodies = p.u.n_bodies();
+    let mut ran = 0usize;
+    let mut truncated = false;
+    let burn = flight == "burn";
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs(50) {
+            truncated = true;
+            break;
+        }
+        if f == 60 {
+            if burn {
+                let t = p.u.now;
+                let _ = p.u.input(t, word(1, 8));
+            }
+            late_stats = Some((p.u.stats, p.u.now));
+        }
+        let start = Instant::now();
+        let _frame = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)) }, i64::MAX);
+        if f >= 60 {
+            rows.push(start.elapsed().as_secs_f64() * 1e3);
+        }
+        held_max = held_max.max(p.u.held_scans());
+        ran += 1;
+        if !p.u.rec(p.player).alive {
+            break;
+        }
+    }
+    let mut ms = rows.clone();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let over = rows.iter().filter(|m| **m > budget_ms).count();
+    let (s0, t_first) = late_stats.expect("at least one late frame");
+    let last = p.u.stats;
+    let game_s = (p.u.now - t_first) as f64 * emergent_universe::view::TICK_SECONDS;
+    // The digest is schedule-independent after settle: off and on arms must agree on it.
+    let settle_to = p.u.now + (p.u.now - t_first).max(1);
+    p.u.settle(settle_to);
+    let digest = p.u.digest();
+    println!(
+        "scanarm: n={n} bodies={bodies} flight={flight} rtf={rtf} frames={ran} build_s={build:.2} peak_mb={:.0} | engine ms p50 {:.3} p99 {:.3} max {:.3} over{budget_ms}ms {over} | game_s {game_s:.1} kicks {} events {} encounters {} contacts {} refused {} | held_max {held_max} digest {digest} truncated {truncated} wall_s {:.1}",
+        peak_rss_mb(),
+        pct(&ms, 0.5), pct(&ms, 0.99), pct(&ms, 1.0),
+        last.kicks - s0.kicks, last.events() - s0.events(),
+        last.encounters - s0.encounters, p.u.contacts, last.refused - s0.refused,
+        t_start.elapsed().as_secs_f64(),
+    );
+    stat::report();
+}
