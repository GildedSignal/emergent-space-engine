+        if let Some(path) = std::env::var_os("ES_SEEN_DUMP") {
+            if n == 30 || n == 90 {
+                if let Some(seen) = v.get("seen").and_then(|s| s.as_array()) {
+                    let wire = serde_json::to_string(seen).map(|t| t.len()).unwrap_or(0);
+                    let ang = |s: &serde_json::Value| -> f64 {
+                        let d = s.get("direction").and_then(|d| d.as_array()).unwrap();
+                        d[1].as_f64().unwrap().atan2(d[0].as_f64().unwrap())
+                    };
+                    let ls = |s: &serde_json::Value| s.get("light_seconds").and_then(|x| x.as_f64()).unwrap_or(0.0);
+                    let (mut far, mut near): (Vec<f64>, Vec<f64>) = (Vec::new(), Vec::new());
+                    for s in seen {
+                        (if ls(s) > 100.0 { &mut far } else { &mut near }).push(ang(s));
+                    }
+                    fn census(a: &mut Vec<f64>) -> String {
+                        a.sort_by(|x, y| x.partial_cmp(y).unwrap());
+                        let n = a.len();
+                        if n < 2 {
+                            return format!("n={n} nn=- alone=-");
+                        }
+                        let mut gaps: Vec<f64> = a.windows(2).map(|w| w[1] - w[0]).collect();
+                        gaps.push(2.0 * std::f64::consts::PI - (a[n - 1] - a[0]));
+                        gaps.sort_by(|x, y| x.partial_cmp(y).unwrap());
+                        let nn_p50 = gaps[n / 2];
+                        let nn_min = gaps[0];
+                        let mut out = format!("n={n} nn_p50={nn_p50:.3e} nn_min={nn_min:.3e}");
+                        for f in [8e-3f64, 1e-3, 1e-4, 1e-5] {
+                            let mut cnt: std::collections::HashMap<i64, u32> = std::collections::HashMap::new();
+                            for &x in a.iter() {
+                                *cnt.entry((x / f).floor() as i64).or_insert(0) += 1;
+                            }
+                            let alone = cnt.values().filter(|&&c| c == 1).count();
+                            out += &format!(" f{f:e}:cells={} alone={:.4}", cnt.len(), alone as f64 / n as f64);
+                        }
+                        out
+                    }
+                    let line = format!("frame={n} seen={} wire_bytes={} FAR[{}] NEAR[{}]\n", seen.len(), wire, census(&mut far), census(&mut near));
+        use std::io::Write as _;
+        if let Ok(mut fh) = std::fs::OpenOptions::new().create(true).append(true).open(&path) {
+                            let _ = fh.write_all(line.as_bytes());
+                        }
+                    }
+                }
+            }
+        }
