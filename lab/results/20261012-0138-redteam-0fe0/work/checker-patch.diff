+//! Debug probe: does the lone near-c pair meet at all, in the plain lattice and in a frame?
+use emergent_engine::{Battle, Frame};
+use emergent_lattice::chronon::Chronon;
+use emergent_lattice::law::{Body, Law, Response, Tick, World};
+use emergent_lattice::{Kind, Stepper};
+use emergent_lattice_event::EventCore;
+
+const HORIZON: Tick = 4096;
+
+fn pair(x: i64, k: i64) -> World {
+    let q = 1024i64;
+    let bodies = vec![
+        Body::new(1, [-x, 0], [k, 0], 1, q / 2, Response::Bounce),
+        Body::new(2, [x, 0], [-k, 0], 1, q / 2, Response::Bounce),
+    ];
+    World::new(q, None, bodies).unwrap().with_law(Law::RelativisticV1).unwrap()
+}
+
+#[test]
+fn probe_lone_pair_plain_and_framed() {
+    for &(x, k) in &[(432_000i64, 900i64), (432_000, 1023), (100_000, 900), (20_000, 900)] {
+        let w = pair(x, k);
+        let mut c = Chronon::new(w.clone(), true).unwrap();
+        c.run_to(HORIZON);
+        let wf = c.world();
+        let d = wf.bodies[0].x[0] - wf.bodies[1].x[0];
+        let pairs: Vec<_> = c.log().events.iter().filter(|e| e.kind == Kind::Contact).map(|e| (e.a, e.b, e.tick)).collect();
+        println!("plain   x={x} k={k}: contacts {} {pairs:?}; final x0={} x1={} sep={d}", c.log().contacts, wf.bodies[0].x[0], wf.bodies[1].x[0]);
+
+        let mut e = EventCore::new(w.clone(), true).unwrap();
+        e.run_to(HORIZON);
+        println!("  sparse equal: {}", e.outcome() == c.outcome());
+
+        // same pair inside the battle frame (kicks pushed past the horizon)
+        let r_extent = 32 * (x + 4 * HORIZON * 128);
+        let r = ((1024i64 << 15) / 4).max(32 * (x + 4 * HORIZON * 128));
+        let f = Frame::new(1024, r, 1u64 << 45).unwrap();
+        let mut b = Battle::new(Chronon::new(w, true).unwrap(), f, 1).with_epoch_shift(HORIZON + 1);
+        b.run_to(HORIZON).unwrap();
+        println!("framed  x={x} k={k}: contacts {}", b.stepper().log().contacts);
+    }
+}
+
+trait Pipe: Sized { fn pipe<T>(self, f: impl FnOnce(Self) -> T) -> T { f(self) } }
+impl<T> Pipe for T {}
