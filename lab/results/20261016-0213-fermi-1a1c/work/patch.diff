+/// Linux: resident now and peak resident (VmRSS/VmHWM) from /proc/self/status — an order-of-magnitude stand-in
+/// for the macOS physical footprint (no compressed pages counted).
+#[cfg(not(target_os = "macos"))]
+fn footprint() -> (u64, u64) {
+    let mut now = 0u64;
+    let mut peak = 0u64;
+    if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+        for line in s.lines() {
+            let kv = line.splitn(2, ':').collect::<Vec<_>>();
+            if kv.len() != 2 {
+                continue;
+            }
+            let v = kv[1].split_whitespace().next().and_then(|x| x.parse::<u64>().ok()).unwrap_or(0) * 1024;
+            match kv[0] {
+                "VmRSS" => now = v,
+                "VmHWM" => peak = v,
+                _ => {}
+            }
+        }
+    }
+    (now, peak)
+}
