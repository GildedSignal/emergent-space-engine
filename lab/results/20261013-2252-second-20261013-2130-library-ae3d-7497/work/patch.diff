+++ b/crates/universe/examples/kick_tail.rs
@@ -0,0 +1,86 @@
+//! Rule 2's falsifier (the nladder page, open direction 1): the per-body surprise-rate
+//! distribution on shipped scenes. Logs every applied kick `(tick, body, level, clock)`
+//! through `Universe::kick_log` (probe field; `None` leaves the engine untouched), settles
+//! the shipped `plane` scenario, and prints one JSON line per body with its kick tally,
+//! its compiled period (ticks) and its rate per orbit and per game-second, then a scene
+//! line with the counters. The fleet origin's own kicks are the frame's (aggregate, in
+//! `stats.kicks` minus the body tally).
+//!
+//! cargo run --release -p emergent-universe --example kick_tail -- idle <secs> [seed] [members]
+//! cargo run --release -p emergent-universe --example kick_tail -- burn <secs> [seed] [members] [keys level from_s]
+use emergent_space::binding::Trajectory;
+
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::Config;
+
+fn period_ticks(p: &emergent_universe::scenario::Plane, i: usize) -> Option<f64> {
+    let b = &p.u.rec(i).b;
+    let per = match &b.entry.trajectory {
+        Trajectory::Cycle(c) => c.period().ok()?,
+        Trajectory::Passage(g) => g.duration().ok()?,
+        Trajectory::Plunge(g) => g.motion_period().ok()?,
+    };
+    Some(emergent_universe::num::to_f64(per) * 2f64.powi(-(b.clock_exp as i32)))
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let scene = args.get(1).cloned().unwrap_or("idle".into());
+    let secs: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(3600.0);
+    let seed: u64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let members: u64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(48);
+    let mut p = plane(Config::default(), seed, Order::Sparse, 1, members).unwrap();
+    let cut = (secs / TICK_SECONDS) as i64;
+    if scene == "burn" {
+        let keys: u8 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(1);
+        let level: u8 = args.get(6).and_then(|s| s.parse().ok()).unwrap_or(12);
+        let from_s: f64 = args.get(7).and_then(|s| s.parse().ok()).unwrap_or(1.0);
+        p.u.schedule((from_s / TICK_SECONDS) as i64, word(keys, level)).unwrap();
+    }
+    let t0 = std::time::Instant::now();
+    p.u.kick_log = Some(Vec::new());
+    p.u.settle(cut);
+    let wall = t0.elapsed().as_secs_f64();
+    let log = p.u.kick_log.take().unwrap_or_default();
+
+    let mut per = vec![(0u64, 0u64, 0u64, 0u64, i64::MAX, 0i64); p.u.n_bodies()];
+    for (t, i, l, clock) in &log {
+        let r = &mut per[*i];
+        r.0 += 1;
+        if *l > 0 { r.1 += 1 }
+        if *clock { r.2 += 1 }
+        if *t < r.4 { r.4 = *t }
+        if *t > r.5 { r.5 = *t }
+    }
+    let span_ticks = cut as f64;
+    for i in 0..p.u.n_bodies() {
+        let r = per[i];
+        if r.0 == 0 && i >= p.names.len() {
+            continue;
+        }
+        let pt = period_ticks(&p, i).filter(|_| r.0 > 0);
+        let orbits = pt.map(|p| span_ticks / p);
+        let kind = format!("{:?}", p.u.rec(i).kind);
+        let name = p.names.get(i).cloned().unwrap_or_else(|| format!("member {i}"));
+        let live = p.u.rec(i).alive;
+        let born = p.u.info.get(i).map(|b| b.born).unwrap_or(0);
+        let doll = p.u.rec(i).b.doll;
+        let group = if name.starts_with("member") { "member" } else if matches!(name.as_str(), "Cinder" | "Home" | "Giant" | "Moon" | "You") { "core" } else { "ship" };
+        println!(
+            "{{\"body\":{i},\"name\":\"{name}\",\"kind\":\"{kind}\",\"group\":\"{group}\",\"doll\":{doll},\"kicks\":{},\"sub\":{},\"clock\":{},\"t_first\":{},\"t_last\":{},\"alive\":{live},\"born\":{born},\"period_ticks\":{},\"kicks_per_orbit\":{},\"kicks_per_sec\":{}}}",
+            r.0, r.1, r.2, r.4, r.5,
+            pt.map(|x| x.trunc()).unwrap_or(0.0),
+            orbits.map(|o| r.0 as f64 / o).unwrap_or(0.0),
+            r.0 as f64 / secs,
+        );
+    }
+    let body_kicks: u64 = per.iter().map(|r| r.0).sum();
+    let s = &p.u.stats;
+    println!(
+        "{{\"scene\":\"{scene}\",\"seed\":{seed},\"members\":{members},\"secs\":{secs},\"wall_s\":{wall:.2},\"bodies\":{},\"kicks_body\":{body_kicks},\"kicks_total\":{},\"origin_kicks\":{},\"opens\":{},\"boundaries\":{},\"decisions\":{},\"leavers\":{},\"lost\":{},\"refused\":{},\"contacts\":{}}}",
+        p.u.n_bodies(), s.kicks, s.kicks - body_kicks, s.opens, s.boundaries, s.decisions, s.leavers, s.lost, s.refused, p.u.contacts
+    );
+}
