+    pub fn history_census(&self) -> (usize, usize, usize) {
+        let (mut gt1, mut total, mut max) = (0usize, 0usize, 0usize);
+        for i in 0..self.bodies.len() {
+            let h = self.bodies.history_len(i);
+            total += h;
+            if h > 1 {
+                gt1 += 1;
+            }
+            max = max.max(h);
+        }
+        (gt1, total, max)
+    }
