+/// `None` = shipped behaviour, bit for bit.
+fn pin_oldest() -> Option<Tick> {
+    static PIN: std::sync::LazyLock<Option<Tick>> =
+        std::sync::LazyLock::new(|| std::env::var("ES_PIN_OLDEST").ok().and_then(|s| s.parse::<Tick>().ok()));
+    *PIN
 }
