+fn gather_with(u: &Universe, names: &[String], cache: Option<&mut ViewCache>) -> Option<View> {
+    // (lab 20261016-0117-second-…-d86c) every read this gather makes is a view read: tag it so the
+    // retired-read instrument attributes serves and misses to the view, not the engine, and clear
+    // the tag on the way out (the reader clock too — no stale-clock ages after a gather).
+    crate::body::IN_VIEW.store(true, std::sync::atomic::Ordering::Relaxed);
+    crate::body::READER_NOW.store(u.now, std::sync::atomic::Ordering::Relaxed);
+    let out = gather_tagged(u, names, cache);
+    crate::body::IN_VIEW.store(false, std::sync::atomic::Ordering::Relaxed);
+    crate::body::READER_NOW.store(i64::MIN, std::sync::atomic::Ordering::Relaxed);
+    out
+}
+
+fn gather_tagged(u: &Universe, names: &[String], mut cache: Option<&mut ViewCache>) -> Option<View> {
     let ctx = u.ctx();
     if let Some(c) = cache.as_mut() {
         c.readouts = 0;
