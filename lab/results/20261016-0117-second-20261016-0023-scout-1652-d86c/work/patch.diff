+    /// (lab 20261016-0117-second-…-d86c) The history stack against the prune's own light-cone window:
+    /// for every body holding retained history, `(index, alive, history_len, the age of its newest
+    /// retired binding past the current binding's birth, the keep window `2·light distance + 2²⁶`,
+    /// `bytes_of`), all in ticks where dimensional (the scout 1652 census, unchanged).
+    pub fn history_window(&self) -> Vec<(usize, bool, usize, i128, i128, usize)> {
+        (0..self.bodies.len())
+            .filter(|&i| self.bodies.history_len(i) > 0)
+            .map(|i| {
+                let age = (self.now as i128 - self.bodies.rec(i).b.event_time as i128).max(0);
+                let keep = 2 * self.light_distance(i) as i128 + (1 << 26);
+                (i, self.bodies.rec(i).alive, self.bodies.history_len(i), age, keep, self.bodies.bytes_of(i))
+            })
+            .collect()
+    }
+
+    /// (lab 20261016-0117-…-d86c) The retired-read counters, tagged by caller: `(serves_view,
+    /// max_depth_view_ticks, max_age_view_ticks, serves_engine, max_depth_engine_ticks, misses_view,
+    /// misses_engine)`, cumulative since process start.
+    pub fn retired_split(&self) -> (u64, i64, i64, u64, i64, u64, u64) {
+        use std::sync::atomic::Ordering::Relaxed;
+        (
+            crate::body::SERVES_VIEW.load(Relaxed),
+            crate::body::DEPTH_VIEW.load(Relaxed),
+            crate::body::AGE_VIEW.load(Relaxed),
+            crate::body::SERVES_ENGINE.load(Relaxed),
+            crate::body::DEPTH_ENGINE.load(Relaxed),
+            crate::body::MISSES_VIEW.load(Relaxed),
+            crate::body::MISSES_ENGINE.load(Relaxed),
+        )
+    }
+
+    /// (lab 20261016-0117-…-d86c) Zero the view-side max counters (they are maxes, not deltas), for
+    /// per-phase reads. Serve/miss counters are untouched.
+    pub fn reset_view_maxes(&self) {
+        use std::sync::atomic::Ordering::Relaxed;
+        crate::body::DEPTH_VIEW.store(0, Relaxed);
+        crate::body::AGE_VIEW.store(0, Relaxed);
+    }
