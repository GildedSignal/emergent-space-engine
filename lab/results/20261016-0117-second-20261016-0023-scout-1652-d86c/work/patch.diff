+//! (lab 20261016-0117-second-20261016-0023-scout-1652-d86c) Fly the deletion: the history stack's
+//! `len() > 1` floor (`PlainBodies::prune`/`droppable_until`) dropped behind `ES_DROP_FLOOR`, on the
+//! scout's belt scene, coast and burn, with the retired-read instrument tagged per caller (view vs
+//! engine: `view::gather*` sets the tag) and a warm gather loop. At each cut the universe is settled
+//! (a canonical state), the digest taken, the stack censused against the prune's own keep window,
+//! and the view gathered cold-then-warm; the last warm view is dumped for baseline-vs-deletion
+//! comparison.
+//!
+//! cargo run --release -p emergent-universe --example history_floor -- [N] [rtf] [coast|burn] [cut game-s]...
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::thrust::word;
+use emergent_universe::view::{gather_cached, ViewCache, TICK_SECONDS};
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+fn rss_mb() -> f64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines()
+                .find(|l| l.starts_with("VmRSS:"))
+                .and_then(|l| l.split_whitespace().nth(1).and_then(|v| v.parse::<f64>().ok()))
+        })
+        .map(|kb| kb / 1024.0)
+        .unwrap_or(0.0)
+}
+
+fn pct(v: &[f64], q: f64) -> f64 {
+    if v.is_empty() { 0.0 } else { v[((v.len() - 1) as f64 * q).round() as usize] }
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(10_000);
+    let rtf: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(1_500.0);
+    let burn = args.get(3).map_or(false, |s| s == "burn");
+    let cuts: Vec<f64> = args[4..].iter().filter_map(|s| s.parse().ok()).collect();
+    let cuts = if cuts.is_empty() { vec![15_000.0, 20_000.0, 32_000.0, 48_000.0, 60_000.0] } else { cuts };
+    let warm: usize = std::env::var("ES_WARM").ok().and_then(|s| s.parse().ok()).unwrap_or(12);
+    let floor = std::env::var("ES_DROP_FLOOR").is_err();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let bodies = p.u.n_bodies();
+    println!(
+        "scene: {bodies} bodies (N={n}), rtf {rtf}, {}, warm {warm}, cuts {:?} game-s, rss {:.0} MB",
+        if floor { "FLOOR ON (shipped)" } else { "FLOOR OFF (deletion)" },
+        cuts,
+        rss_mb()
+    );
+    // ES_DET: a fully deterministic frame budget (no wall cap) — the frame loop advances exactly
+    // `dt·rtf` of game-time per frame in both builds, so a digest difference cannot be wall-schedule
+    // noise (the deletion does more prune work per frame, which a wall cap turns into different
+    // game-time per frame).
+    let det = std::env::var("ES_DET").is_ok();
+    let frame_budget = || {
+        if det {
+            Budget { events: u64::MAX, until: None }
+        } else {
+            Budget { events: u64::MAX, until: Some(Instant::now() + Duration::from_millis(50)) }
+        }
+    };
+    // A warmup half second (the fleet's opening exodus), like the ladder's stats window.
+    for _ in 0..30 {
+        let _ = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(Instant::now() + Duration::from_millis(50)) }, i64::MAX);
+    }
+    let t0 = p.u.now;
+    let at = |game_s: f64| t0 + (game_s / TICK_SECONDS) as i64;
+    // The burn script: two held reverses at L8 with coast between, at canonical ticks.
+    if burn {
+        for (game_s, keys) in [(18_000.0f64, 2u8), (26_000.0, 0), (38_000.0, 2), (44_000.0, 0)] {
+            p.u.schedule(at(game_s), word(keys, 8)).unwrap();
+        }
+    }
+    let mut next = 0usize;
+    let mut last: Option<(u64, u64)> = None; // (engine serves, engine misses) at the last cut's gathers' end
+    loop {
+        if t_start.elapsed() > Duration::from_secs(220) {
+            println!("TRUNCATED");
+            break;
+        }
+        let game_s = (p.u.now - t0) as f64 * TICK_SECONDS;
+        while next < cuts.len() && game_s >= cuts[next] - 1e-9 {
+            let cut = cuts[next];
+            let cut_tick = at(cut);
+            let s0 = p.u.retired_split();
+            p.u.settle(cut_tick);
+            let s1 = p.u.retired_split();
+            let digest = p.u.digest();
+            // The census (no history reads: it does not move the counters).
+            let rows = p.u.history_window();
+            let with = rows.len();
+            let total_segs: usize = rows.iter().map(|r| r.2).sum();
+            let in_win = rows.iter().filter(|r| r.3 <= r.4).count();
+            let pinned = rows.iter().filter(|r| r.3 > r.4).count();
+            let dead_with = rows.iter().filter(|r| !r.1).count();
+            let multi = rows.iter().filter(|r| r.2 > 1).count();
+            let bytes_with: usize = rows.iter().map(|r| r.5).sum();
+            let mut ages: Vec<f64> = rows.iter().map(|r| r.3 as f64 * TICK_SECONDS).collect();
+            ages.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            let mut keeps: Vec<f64> = rows.iter().map(|r| r.4 as f64 * TICK_SECONDS).collect();
+            keeps.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            // The view: one cold gather (a fresh cache), then the warm loop on the same cache. The
+            // depth/age maxes are reset per phase (they are maxes, not deltas); serves/misses are
+            // monotone counters read as deltas.
+            let mut cache = ViewCache::default();
+            let t_cold = Instant::now();
+            p.u.reset_view_maxes();
+            let mut view = gather_cached(&p.u, &p.names, &mut cache);
+            let cold_ms = t_cold.elapsed().as_secs_f64() * 1e3;
+            let s2 = p.u.retired_split();
+            let t_warm = Instant::now();
+            p.u.reset_view_maxes();
+            for _ in 1..warm {
+                view = gather_cached(&p.u, &p.names, &mut cache);
+            }
+            let warm_ms = t_warm.elapsed().as_secs_f64() * 1e3 / (warm - 1) as f64;
+            let s3 = p.u.retired_split();
+            // The engine's retired reads since the last cut's gathers ended (pure engine: the
+            // flight and this cut's settle).
+            let eng = last.map_or((0, 0), |l| (s0.3 - l.0, s0.6 - l.1));
+            println!(
+                "cut game_s={:.0} digest={} kicks {} enc {} contacts {} | with_hist {} ({:.3}/body; segs {:.3}/body; len>1 {}) dead_with={} | IN_WINDOW {:.1}% PINNED_PAST {:.1}% | age_s p50={:.0} max={:.0} | keep_s p50={:.0} max={:.0} | bytes_of(hist)={:.0} B, whole-store {} B/body",
+                cut,
+                &digest[..48],
+                p.u.stats.kicks,
+                p.u.stats.encounters,
+                p.u.contacts,
+                with,
+                with as f64 / bodies as f64,
+                total_segs as f64 / bodies as f64,
+                multi,
+                dead_with,
+                100.0 * in_win as f64 / with.max(1) as f64,
+                100.0 * pinned as f64 / with.max(1) as f64,
+                pct(&ages, 0.5),
+                ages.last().copied().unwrap_or(0.0),
+                pct(&keeps, 0.5),
+                keeps.last().copied().unwrap_or(0.0),
+                bytes_with as f64 / with.max(1) as f64,
+                p.u.bytes_per_body(),
+            );
+            println!(
+                "   reads: engine-between-cuts serves {} miss {} | settle(engine) serves {} miss {} | cold(view) serves {} depth {:.0}s age {:.0}s miss {} | warm[{}] serves {} ({:.0}/gather) depth {:.0}s age {:.0}s miss {} | view cold {:.0} ms warm {:.1} ms/gather seen {} | rss {:.0} MB",
+                eng.0,
+                eng.1,
+                s1.3 - s0.3,
+                s1.6 - s0.6,
+                s2.0 - s1.0,
+                s2.1 as f64 * TICK_SECONDS,
+                s2.2 as f64 * TICK_SECONDS,
+                s2.5 - s1.5,
+                warm,
+                s3.0 - s2.0,
+                (s3.0 - s2.0) as f64 / (warm - 1) as f64,
+                s3.1 as f64 * TICK_SECONDS,
+                s3.2 as f64 * TICK_SECONDS,
+                s3.5 - s2.5,
+                cold_ms,
+                warm_ms,
+                view.as_ref().map_or(0, |v| v.seen.len()),
+                rss_mb(),
+            );
+            // The seen dump for baseline-vs-deletion comparison (the last warm view).
+            if let Some(v) = &view {
+                for s in &v.seen {
+                    println!(
+                        "S {:.0} {} {} {:.12e} {:.12e} {:.12e} {:.6e} {:.6e}",
+                        cut, s.id, s.kind, s.offset[0], s.offset[1], s.light_seconds, s.angular_radius, s.shift
+                    );
+                }
+            }
+            last = Some((s3.3, s3.6));
+            next += 1;
+        }
+        if next >= cuts.len() {
+            break;
+        }
+        let _ = p.u.frame_to(1.0 / 30.0, rtf, frame_budget(), i64::MAX);
+    }
+    println!("end: wall {:.1} s, rss {:.0} MB", t_start.elapsed().as_secs_f64(), rss_mb());
+}
