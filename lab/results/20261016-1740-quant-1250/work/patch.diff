+}
+
+const TAU: f64 = 2.0 * std::f64::consts::PI;
+
+/// The polar angle of a bound tube at `t`, as an arc `[centre − half, centre + half]` (radians, mod a turn):
+/// the knot panel the tick falls in, widened by the periapsis-angle turn's sub-quantum shear and the offset the
+/// fit carries, the unknown part of the within-cycle advance, and float rounding. Every widening is against the
+/// cut (the arc only grows), so a pair the arc excludes cannot be read at `t`. `None`: no arc (not a bound cycle,
+/// a circle, or a degenerate table) — the caller reads the body.
+fn angle_arc(b: &Binding, t: Tick, lo: f64) -> Option<(f64, f64)> {
+    let Trajectory::Cycle(orbit) = &b.entry.trajectory else { return None };
+    let times = orbit.knot_times_f64();
+    let n = times.len();
+    if n < 2 || !times.windows(2).all(|w| w[0] <= w[1]) {
+        return None;
+    }
+    let mu_inv = to_f64(b.entry.unit.inverse);
+    let period = to_f64(orbit.period().ok()?) * mu_inv; // doll time per cycle
+    if !period.is_finite() || period <= 0.0 {
+        return None;
+    }
+    let adv = to_f64(orbit.advance().ok()?); // radians per cycle (the shape's excess; see `e_adv`)
+    let peri_t = b.tube.periapsis_time.get() as i64;
+    let elapsed = (t as i128 - peri_t as i128) as f64 * 2f64.powi(b.clock_exp as i32) * mu_inv;
+    if !elapsed.is_finite() {
+        return None;
+    }
+    let cycles = (elapsed / period).floor();
+    let rem = elapsed - cycles * period; // [0, period), up to rounding
+    let half = 0.5 * period;
+    let slack = elapsed.abs() * 1e-9 + period * 1e-12 + 1e-300;
+    let d_out = rem.min(period - rem); // distance from periapsis in time (the cycle is symmetric)
+    let (d_lo, d_hi) = (d_out - slack, d_out + slack);
+    // The ψ span the interval [d_lo, d_hi] covers on the outbound leg (ψ is monotone in time there; the knots'
+    // times were checked monotone above). Q61 radians out.
+    let knots = orbit.shape().knots();
+    let psi_of = |i: usize| knots.get(i).map_or(f64::INFINITY, |k| k.psi as f64 * 2f64.powi(-61));
+    let (mut i_lo, mut i_hi) = (n - 1, n - 1);
+    for i in 0..n {
+        if times[i] * mu_inv <= d_lo {
+            i_lo = i;
+        }
+        if times[i] * mu_inv <= d_hi {
+            i_hi = i;
+        }
+    }
+    let psi_lo = if d_lo <= 0.0 { 0.0 } else { psi_of(i_lo) };
+    let psi_hi = psi_of((i_hi + 1).min(n - 1));
+    // The inbound leg mirrors ψ about the apoapsis; an interval straddling the half-cycle takes the union.
+    let near_half = (rem - half).abs() <= slack;
+    let (a_lo, a_hi) = match (rem <= half, near_half) {
+        (true, false) => (psi_lo, psi_hi),
+        (false, false) => (TAU - psi_hi, TAU - psi_lo),
+        (_, true) => (psi_lo.min(TAU - psi_hi), psi_hi.max(TAU - psi_lo)),
+    };
+    if !a_lo.is_finite() || !a_hi.is_finite() || a_hi < a_lo {
+        return None;
+    }
+    // What the fit carries beyond the tube: the offset (any direction), the readout's rounding, the turn's shear.
+    let q_len = 2f64.powi(b.units.0 as i32);
+    let res_len = ((b.residual.position[0].unsigned_abs() + b.residual.position[1].unsigned_abs()) as f64 + 8.0) * q_len;
+    let eps_off = 1.01 * (res_len + 16.0 * q_len) / lo + 2f64.powi(-31) * TAU;
+    // The unknown within-cycle advance (the excess integral between knots, its sign unknown, the weak branch's
+    // zeroed q included) and the float rounding of the accumulated advance.
+    let adv_term = adv * cycles;
+    let e_adv = 2.0 * adv.abs() + 4e-3 + 1e-6 * (1.0 + adv_term.abs());
+    let omega = b.tube.periapsis_angle as f64 * TAU / 2f64.powi(32);
+    let sgn = if b.entry.clockwise { -1.0 } else { 1.0 };
+    let centre = omega + sgn * (0.5 * (a_lo + a_hi) + adv_term);
+    let half_w = 0.5 * (a_hi - a_lo) + eps_off + e_adv + 1e-9;
+    if half_w >= TAU / 4.0 {
+        return None;
+    }
+    Some((centre, half_w))
+}
