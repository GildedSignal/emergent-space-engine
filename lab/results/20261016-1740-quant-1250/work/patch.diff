+/// Can this candidate's linear motion over `[t, t + h]` come within `near` of the player's? True = provably not:
+/// the angular separation at `t` (the arc above against the player's exact readout), minus the largest angles the
+/// two can sweep over `h`, still exceeds the largest separation a chord `near` allows at the smallest radius either
+/// can reach. Every term is widened against the cut (the radial window's rule: a float only ever drops a pair that
+/// cannot meet). False = read the body.
+fn cannot_meet(b: &Binding, t: Tick, th_p: f64, r_p: f64, v_p: f64, h: f64, near: f64) -> bool {
+    if !(h.is_finite() && h >= 0.0 && r_p.is_finite() && r_p > 0.0 && v_p.is_finite() && near.is_finite() && near >= 0.0) {
+        return false;
+    }
+    let Some((lo, _hi, v_b)) = range_of(b) else { return false };
+    if !(lo.is_finite() && lo > 0.0 && v_b.is_finite() && v_b >= 0.0) {
+        return false;
+    }
+    let Some((centre, half_w)) = angle_arc(b, t, lo) else { return false };
+    let rel = 1.0 + 1e-9;
+    let r_p_min = r_p - v_p * h * rel;
+    let r_b_min = lo - v_b * h * rel;
+    if r_p_min <= 0.0 || r_b_min <= 0.0 {
+        return false;
+    }
+    // The least separation of the two angles at t.
+    let d = (th_p - centre).rem_euclid(TAU);
+    let dist = d.min(TAU - d) - half_w;
+    if dist <= 0.0 {
+        return false;
+    }
+    // The most the separation can close over h, and the widest angle a chord `near` allows at the conjunction.
+    let travel = (v_b / r_b_min + v_p / r_p_min) * h * rel;
+    let r_min = r_b_min.min(r_p_min);
+    let alpha = 2.0 * (near * rel / (2.0 * r_min)).clamp(0.0, 1.0).asin();
+    dist > travel + alpha + 1e-9
+}
 
