+    /// `cargo test --release -p xtask b13_cut -- --ignored --nocapture`.
+    #[test]
+    #[ignore]
+    fn b13_cut() {
+        use super::super::assist::{self, Flyby};
+        use emergent_universe::bind::scalars;
+        use emergent_universe::num::{cross2, dot2, norm2, to_f64};
+        use emergent_universe::step::bill;
+        let step: i32 = std::env::var("B13_STEP").ok().and_then(|v| v.parse().ok()).unwrap_or(8);
+        let scene = JUPITER;
+        let mut taken = 0;
+        let (mut same, mut cut_draws, mut keep_draws, mut near_escape) = (0, 0, 0, 0);
+        let mut keep_on_near_escape = 0;
+        for (i, (q, v_inf, psi)) in super::super::sample::flybys(assist::DRAWS).into_iter().enumerate() {
+            if taken == assist::SEEDS {
+                break;
+            }
+            let s = assist::ship(&scene, q, v_inf, psi);
+            let (flyby, closest) = assist::reference(&scene, s, RTOL);
+            if closest < scene.planet_radius {
+                continue;
+            }
+            taken += 1;
+            let Flyby::Exit(t, _, _) = flyby else { continue };
+            let before = scene.heliocentric(0.0, &s);
+            let tick = (t / (1.0 - scene.mu)).round() as i64;
+            let mut arms = Vec::new();
+            for on in [false, true] {
+                if on {
+                    std::env::set_var("ES_BOUNDARY_CUT", "1");
+                } else {
+                    std::env::remove_var("ES_BOUNDARY_CUT");
+                }
+                let c0 = bill::counters();
+                let (mut u, id) = build_scene(&scene, s, step).unwrap();
+                u.settle(tick);
+                let alive = u.bodies().alive(id);
+                let (ee, el) = if alive {
+                    let (pos, vel) = observe::root_state(&u.ctx(), id, tick).unwrap();
+                    let (sp, sv) = scene.star(t);
+                    let st = [pos[0] * (1.0 - scene.mu) + sp[0], pos[1] * (1.0 - scene.mu) + sp[1], vel[0] + sv[0], vel[1] + sv[1]];
+                    let a = scene.heliocentric(t, &st);
+                    (((a.0 - before.0)).abs() / before.0.abs(), ((a.1 - before.1)).abs() / before.1.abs())
+                } else {
+                    (f64::INFINITY, f64::INFINITY)
+                };
+                let rec = u.rec(id);
+                // The exit leg's heliocentric Newtonian energy, in the root doll's units (μ* = 1).
+                let near = (|| {
+                    let st = rec.b.readout(rec.b.event_time).ok()?;
+                    let (x, v) = scalars(&st).ok()?;
+                    let r = to_f64(norm2(x).ok()?);
+                    let (vr, vt) = (to_f64(dot2(x, v).ok()?) / r, to_f64(cross2(x, v).ok()?) / r);
