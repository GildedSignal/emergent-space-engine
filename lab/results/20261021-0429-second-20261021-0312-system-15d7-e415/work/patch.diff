+//! Run 20261021-0429 (second author on 20261021-0312-system-15d7): fly the boundary comb's deletion.
+//! With `ES_BOUNDARY_CUT` set, `kick_clock` gates the comb per kick (bound arc, apoapsis inside the
+//! edge) and takes the anchor over; without it the run is the shipped behaviour, bit for bit — the
+//! first run's frozen record must reproduce. The **tubes digest** hashes everything the shipped
+//! digest does except the bookkeeping the deletion changes by design (step, interval, anchor, plan,
+//! event counts): equal tubes digests prove the physics moved bit for bit.
+//!
+//! cargo run --release -p emergent-universe --example boundary_bill [-- <N> <game seconds> [seed]]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::step::bill;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+
+const RTF: f64 = 100.0;
+
+fn main() {
+    let n: usize = std::env::args().nth(1).and_then(|s| s.parse().ok()).unwrap_or(30_000);
+    let gs: f64 = std::env::args().nth(2).and_then(|s| s.parse().ok()).unwrap_or(60_000.0);
+    let seed: u64 = std::env::args().nth(3).and_then(|s| s.parse().ok()).unwrap_or(1);
+    let cut = (gs * RTF / TICK_SECONDS) as i64;
+    let t0 = std::time::Instant::now();
+    let mut p = plane_extra(Config::default(), seed, Order::Sparse, 1, 48, n).unwrap();
+    for _ in 0..2_000_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        p.u.frame_to(1.0 / 60.0, RTF, Budget::unlimited(), cut);
+    }
+    p.u.settle(cut);
+    let c = bill::counters();
+    println!(
+        "N {n} seed {seed} horizon {gs:.0} gs reached {:.0} gs | digest {} | tubes {} | kicks {} encounters {} contacts {}",
+        p.u.now as f64 * TICK_SECONDS,
+        &p.u.digest()[..32],
+        &p.u.tubes_digest()[..32],
+        p.u.stats.kicks,
+        p.u.stats.encounters,
+        p.u.contacts
+    );
+    println!(
+        "boundary combs {} (clock-stepped {}) | fires: crash {} leave {} handoff {} | kick-surface fires {} | gate: cut {} keep {}",
+        c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7]
+    );
+    println!("wall {:.1} s | cut {}", t0.elapsed().as_secs_f64(), if bill::enabled() { "ON" } else { "off" });
+}
