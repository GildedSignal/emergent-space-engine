new file mode 100644
index 0000000..debfe95
--- /dev/null
+++ b/crates/universe/examples/kick_bench.rs
@@ -0,0 +1,56 @@
+// Lab bench: the pure kick resolve (µs per kick) and the whole-universe digest.
+// args: [reps] | seed members order(dense|sparse) ticks reps settle
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::Config;
+use std::time::Instant;
+
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let settle_mode = a.iter().any(|s| s == "settle");
+    let (seed, members, order, ticks, reps) = if a.len() <= 1 {
+        (1u64, 8u64, Order::Sparse, 30_000_000_000i64, a.first().and_then(|s| s.parse().ok()).unwrap_or(1))
+    } else {
+        (
+            a[0].parse().unwrap(),
+            a[1].parse().unwrap(),
+            if a[2] == "dense" { Order::Dense } else { Order::Sparse },
+            a[3].parse().unwrap(),
+            a.get(4).and_then(|s| s.parse().ok()).unwrap_or(1),
+        )
+    };
+    let mut p = plane(Config::default(), seed, order, 1, members).unwrap();
+    let ship = p.ships[14.min(p.ships.len() - 1)];
+    let n = 3000;
+    let ctx = p.u.ctx();
+    let rec = p.u.rec(ship);
+    let mut times = Vec::new();
+    for _ in 0..reps {
+        let t0 = Instant::now();
+        let mut kicks = 0usize;
+        for _ in 0..n {
+            let mut r = rec.clone();
+            while !matches!(r.plan.first().map(|i| i.what), Some(emergent_universe::body::What::Kick(0))) { r.plan.remove(0); }
+            let u = emergent_universe::step::process(&ctx, ship, r);
+            kicks += matches!(u.kind, emergent_universe::step::Resolved::Kick) as usize;
+            std::hint::black_box(&u);
+        }
+        times.push(t0.elapsed().as_secs_f64() * 1e6 / n as f64);
+        std::hint::black_box(&kicks);
+    }
+    drop(ctx);
+    times.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let min = times.first().unwrap();
+    let med = &times[times.len() / 2];
+    println!("seed {seed} members {members} reps {reps}: pure kick min {min:.2} us, median {med:.2} us");
+    if settle_mode {
+        let t0 = Instant::now();
+        p.u.settle(ticks);
+        let wall = t0.elapsed().as_secs_f64();
+        let s = p.u.stats;
+        let ev = s.kicks + s.opens + s.boundaries;
+        println!("settle {ticks} ticks in {wall:.2} s: {ev} items, {:.2} us/item (ships {:.2})", wall * 1e6 / ev as f64, s.cost_ns[2] as f64 / 1e3 / s.items[2].max(1) as f64);
+        println!("digest {}", p.u.digest());
+        println!("events: kicks {} opens {} boundaries {} contacts {}", s.kicks, s.opens, s.boundaries, p.u.contacts);
+    }
+}
