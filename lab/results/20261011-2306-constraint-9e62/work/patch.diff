+    /// The view gather's own split, summed over the run (lab instrumentation; the run's patch).
+    pub fn view_split(&self) -> Value {
+        let p = &self.cache.parts_ns;
+        let ms = |n: u64| n as f64 / 1e6;
+        let total: u64 = p.iter().sum();
+        json!({
+            "note": "sums over the run, from the view's cache (the gather only; observer setup excluded): bodies = Newton crossings of the 27 non-fleet bodies, eval = the state_rate readouts inside it, fleet_setup, fleet_motions, fleet_members",
+            "frames": self.cache.frames,
+            "readouts": self.cache.readouts_total,
+            "readouts_per_body_frame": if self.cache.frames > 0 { self.cache.readouts_total as f64 / self.cache.frames as f64 / 27.0 } else { 0.0 },
+            "bodies_ms": ms(p[0]), "eval_ms": ms(p[1]), "fleet_setup_ms": ms(p[2]), "fleet_motions_ms": ms(p[3]), "fleet_members_ms": ms(p[4]),
+            "share_of_split": p.iter().map(|n| if total > 0 { *n as f64 / total as f64 } else { 0.0 }).collect::<Vec<_>>()
+        })
+    }
+
