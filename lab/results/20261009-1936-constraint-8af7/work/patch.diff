+/// Readout attribution counters (this run's instrumentation; ns and calls). Accumulate across the
+/// engine and the view alike: the report notes the mix.
+pub static CARTESIAN_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CARTESIAN_N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static SECONDARIES_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static SECONDARIES_N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// `(cartesian ms, secondaries ms, cartesian calls, secondaries calls)`, then all reset.
+pub fn readout_stats() -> (f64, f64, u64, u64) {
+    use std::sync::atomic::Ordering;
+    let c = CARTESIAN_NS.swap(0, Ordering::Relaxed) as f64 / 1e6;
+    let s = SECONDARIES_NS.swap(0, Ordering::Relaxed) as f64 / 1e6;
+    (c, s, CARTESIAN_N.swap(0, Ordering::Relaxed), SECONDARIES_N.swap(0, Ordering::Relaxed))
+}
