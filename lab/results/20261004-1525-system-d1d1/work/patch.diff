+/// The law's declared kick path (`law.md` State: tubes key the *quantized* memo): the fit and
+/// the remainder are identical to [`Self::from_state`]; only the periodic compile goes through
+/// the shared quantized shape, so repeated keys share one quadrature. Passages always compile.
+pub fn from_state_memoized(
+    state: IntegerState,
+    event_time: Scalar,
+    passage_edge: Option<Scalar>,
+    memo: &mut crate::orbit::QuantizedMemo,
+) -> Result<Self> {
+    let (key, r, clockwise, incoming) = fit_key(state, true)?;
+    let trajectory = if key.periodic() {
+        Trajectory::Cycle(memo.get(key)?)
+    } else {
+        Trajectory::Passage(Passage::compile(key, passage_edge.unwrap_or(r.scale(1)?))?)
+    };
+    Self::finish(state, event_time, trajectory, r, clockwise, incoming)
+}
+
+fn finish(
+    state: IntegerState,
+    event_time: Scalar,
+    trajectory: Trajectory,
+    r: Scalar,
+    clockwise: bool,
+    incoming: bool,
+) -> Result<Self> {
+    let (mut offset, mut sample) = trajectory.at_radius(r)?;
+    if incoming {
+        offset = offset.negate();
+        sample.reflect();
+    }
+    let (p, _) = state.components()?;
+    let at = angle(p[0], p[1])?;
+    let orientation = (at - if clockwise { -phase(sample)? } else { phase(sample)? }).rem_euclid(2 * PI);
+    let periapsis_angle = ((orientation << 32) / (2 * PI)) as u32;
+    let mut fit = Self {
+        trajectory,
+        periapsis_time: event_time.sub(offset)?,
+        periapsis_angle,
+        clockwise,
+        residual: Residual { position: [0; 2], velocity: [0; 2] },
+        event_time,
+        units: (state.length_exponent, state.velocity_exponent),
+    };
+    fit.residual = Residual::between(state, fit.decoded_event()?);
+    Ok(fit)
+}
     pub fn decoded_event(&self) -> Result<IntegerState> {
         cartesian(
             self.trajectory.state(self.event_time.sub(self.periapsis_time)?)?,
