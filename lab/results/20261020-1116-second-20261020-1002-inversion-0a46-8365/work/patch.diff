@@ -104,6 +104,27 @@ pub fn step_for(b: &Binding, per_period_log2: i32, edge: Option<Scalar>) -> Res<
 /// multiple of its own length, a body of a longer step has its boundaries on those of a shorter one's, and every pair
 /// shares boundaries. (The way back by doublings from the tick's own lowest set bit would take a dozen intervals, each
 /// an event, inside one frame: a stub is one.) A stub under `MIN_STEP` ticks is joined to the next interval.
+
+/// Lab probe (env-gated, off = shipped bits): `ES_STAGGER_GS` spreads the birth phase of the root
+/// doll's clock-stepped ships — each ship's first clock interval is stretched by a deterministic
+/// offset of its id, uniform over the given game-seconds. The belt's clocks are otherwise born in
+/// phase (the standing comb); this tests whether phase spread alone deletes the comb and the cost
+/// concentration riding it. Zero (and no stretching at all) when the variable is unset.
+pub fn birth_stagger_ticks(i: usize) -> i64 {
+    static SPREAD_GS: std::sync::LazyLock<f64> =
+        std::sync::LazyLock::new(|| std::env::var("ES_STAGGER_GS").ok().and_then(|v| v.parse().ok()).unwrap_or(0.0));
+    let gs = *SPREAD_GS;
+    if gs <= 0.0 {
+        return 0;
+    }
+    let mut x = (i as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1;
+    x ^= x >> 33;
+    x = x.wrapping_mul(0xFF51_AFD7_ED55_8CCD);
+    x ^= x >> 33;
+    let frac = (x >> 11) as f64 / (1u64 << 53) as f64;
+    (frac * gs / crate::view::TICK_SECONDS) as i64
+}
