+/// The probe's report (lab run 20261009-1259-constraint-2666): average per-frame gather split, "k=v" pairs.
+pub fn gather_profile() -> String {
+    GATHER_PROF.with(|p| {
+        let g = p.borrow();
+        let f = g.frames.max(1) as f64;
+        format!("frames={} player_ms={:.3} bodies_ms={:.3} crossing_ms={:.3} readouts_per_frame={:.1} fleets_ms={:.3}",
+            g.frames, g.player_ns as f64 / 1e6 / f, g.bodies_ns as f64 / 1e6 / f, g.crossing_ns as f64 / 1e6 / f, g.readouts as f64 / f, g.fleets_ns as f64 / 1e6 / f)
+    })
+}
+
+/// Probe (lab run 20261009-1259-constraint-2666): the view's surprise rate — how many emitters' Seen
+/// payload changes between consecutive frames by more than a player-differentiation floor.
+thread_local! {
+    static LAST_SEEN: std::cell::RefCell<std::collections::HashMap<usize, Seen>> = std::cell::RefCell::new(std::collections::HashMap::new());
+    static SEEN_DIFF: std::cell::RefCell<(u64, u64)> = std::cell::RefCell::new((0, 0)); // (frames, changed)
+}
+fn seen_surprise(s: &Seen) -> bool {
+    LAST_SEEN.with(|m| {
+        let mut m = m.borrow_mut();
+        let Some(p) = m.get(&s.id) else { m.insert(s.id, s.clone()); return true; };
+        let changed = {
+            let dd = (s.direction[0] - p.direction[0]).hypot(s.direction[1] - p.direction[1]);
+            let doff = (s.offset[0] - p.offset[0]).hypot(s.offset[1] - p.offset[1]);
+            let dls = (s.light_seconds - p.light_seconds).abs();
+            let dcol = (s.color[0] - p.color[0]).abs().max((s.color[1] - p.color[1]).abs()).max((s.color[2] - p.color[2]).abs());
+            let dlum = ((s.luminosity - p.luminosity) / p.luminosity.max(1e-12)).abs();
+            let dshift = ((s.shift - p.shift) / p.shift.max(1e-12)).abs();
+            let dclose = (s.closing - p.closing).abs();
+            dd > 4e-4 || doff > 1e-5 || dls > 1e-5 || dcol > 4e-3 || dlum > 1e-3 || dshift > 1e-3 || dclose > 1e-3
+        };
+        changed
+    })
+}
+
+pub fn surprise_profile() -> String {
+    SEEN_DIFF.with(|d| { let (f, c) = *d.borrow(); format!("frames={} changed_emitters_total={} per_frame={:.1}", f, c, c as f64 / f.max(1) as f64) })
+}
+
+/// Probe part 2 (lab run 20261009-1259-constraint-2666): could the per-frame exact readout be replaced by
+/// advancing the last exact state? For each emitter, compare this frame's exact crossing state against a
+/// linear advance of the previous frame's (x, v) over the ticks the crossing moved. Errors in root units
+/// (1 unit = one light-tick ≈ 1.48 km).
+thread_local! {
+    static LAST_AT: std::cell::RefCell<std::collections::HashMap<usize, (Tick, [f64; 2], [f64; 2])>> = std::cell::RefCell::new(std::collections::HashMap::new());
+    static EXTRAP: std::cell::RefCell<[u64; 5]> = std::cell::RefCell::new([0; 5]); // [crossings, e<1e-3, e<1e-2, e<1e-1, e<1]
+}
+fn note_extrap(id: usize, t_e: Tick, at: &At) {
+    LAST_AT.with(|m| {
+        let mut m = m.borrow_mut();
+        let Some(&(t0, x0, v0)) = m.get(&id) else { m.insert(id, (t_e, at.x, at.v)); return; };
+        let dt = t_e.saturating_sub(t0) as f64;
+        let pred = [x0[0] + v0[0] * dt, x0[1] + v0[1] * dt];
+        let err = (pred[0] - at.x[0]).hypot(pred[1] - at.x[1]);
+        EXTRAP.with(|e| {
+            let mut e = e.borrow_mut();
+            e[0] += 1;
+            if err < 1e-3 { e[1] += 1; }
+            if err < 1e-2 { e[2] += 1; }
+            if err < 1e-1 { e[3] += 1; }
+            if err < 1.0 { e[4] += 1; }
+        });
+        m.insert(id, (t_e, at.x, at.v));
+    });
+}
+pub fn extrap_profile() -> String {
+    EXTRAP.with(|e| { let e = *e.borrow(); format!("crossings={} lt_1.5m={:.3} lt_15m={:.3} lt_150m={:.3} lt_1.5km={:.3}", e[0], e[1] as f64 / e[0].max(1) as f64, e[2] as f64 / e[0].max(1) as f64, e[3] as f64 / e[0].max(1) as f64, e[4] as f64 / e[0].max(1) as f64) })
+}
