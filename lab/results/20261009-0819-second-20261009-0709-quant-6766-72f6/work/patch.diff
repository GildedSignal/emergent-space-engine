new file mode 100644
index 0000000..6e62f79
--- /dev/null
+++ b/crates/universe/examples/qc.rs
@@ -0,0 +1,69 @@
+//! The gold experiment the checker named: race the drains at the same canonical cut.
+//!
+//! One restricted universe exactly as `quant_events` builds it (same seed, same distribution, same
+//! windows), run under three drains (env `ES_DRAIN`: `drain` = mainline, `break` = the first
+//! author's one-liner, `guard` = the tick-indexed cut-preserving break), then `settle(limit)` at
+//! one FIXED cut and print the digest and `due_left` — the items still due at the cut, which must
+//! be 0 for the cut to be canonical.
+//!
+//! History-stability is part of the race: `rounds` rounds share one total span (16 rounds of the
+//! quant_events window), so `qc n 8` walks to the cut in half the windows of `qc n 16` and the
+//! digest at the cut must not care. A digest is schedule-independent by contract (universe.rs),
+//! so drain/guard must agree on it at every (n, rounds); the break is expected to disagree.
+//!
+//! Usage: qc <n> [rounds=16] [per_round=20000]
+use emergent_universe::scenario::restricted;
+use emergent_universe::Budget;
+
+fn lcg(rng: &mut u64) -> f64 {
+    *rng = rng.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+    (*rng >> 11) as f64 / (1u64 << 53) as f64
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let n: usize = a[1].parse().unwrap();
+    let rounds: i64 = a.get(2).map(|s| s.parse().unwrap()).unwrap_or(16);
+    let per_round: f64 = a.get(3).map(|s| s.parse().unwrap()).unwrap_or(20_000.0);
+    let (mu_log2, sep) = (-10i32, 527_000_000i64);
+    let hill = sep as f64 * (2f64.powi(mu_log2) / 3.0).cbrt();
+    let mut rng = 0x853c_49e6_748f_ea9bu64;
+    let ships: Vec<(i64, u32)> = (0..n)
+        .map(|_| {
+            let u1 = lcg(&mut rng);
+            let u2 = lcg(&mut rng);
+            let r = sep as f64 + (u1 * 2.0 - 1.0) * hill * 6.0;
+            (r as i64, (u2 * 4294967296.0) as u32)
+        })
+        .collect();
+    let mut w = restricted(mu_log2, sep, 49_000, &ships, 1).unwrap();
+    // The ships' period in ticks (root units, c = 1), as tests/motion.rs computes it in seconds.
+    let period = 2.0 * std::f64::consts::PI / ((1.0 + 2f64.powi(mu_log2)).sqrt() / (sep as f64).powf(1.5));
+    let kick = period / 128.0; // Config::default().step_log2 = 7
+    // One cut for every rounds count: the span of 16 quant_events rounds.
+    let span = ((per_round * 16.0 / n as f64) * kick) as i64;
+    let window = (span / rounds).max(1);
+    let mut now = 0i64;
+    for i in 0..rounds {
+        let adv = w.u.advance(now + window, Budget::unlimited());
+        now = now.max(adv.horizon);
+        if (i + 1) % 8 == 0 {
+            w.u.prune();
+        }
+        let _ = i;
+    }
+    let limit = span;
+    w.u.settle(limit);
+    let variant = std::env::var("ES_DRAIN").unwrap_or_else(|_| "guard".into());
+    println!(
+        "{{\"kind\":\"race\",\"n\":{},\"rounds\":{},\"variant\":\"{}\",\"digest\":\"{}\",\"lag\":{},\"cut\":{},\"now\":{},\"events\":{}}}",
+        n,
+        rounds,
+        variant,
+        w.u.digest(),
+        w.u.due_left(limit),
+        limit,
+        w.u.now,
+        w.u.stats.events()
+    );
+}
