+// ---- the stage profiler (experiments only; the lab's quant lens) --------------------------------
+/// Wall nanoseconds by stage of `advance`: 0 rekey, 2 the main loop (drain + resolve), 3 resolve
+/// alone, 4 the deferred requeue, 5 the per-event position readback in `apply`. (1 unused.)
+pub mod prof {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    pub static NS: [AtomicU64; 6] = [
+        AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+        AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+    ];
+    pub fn add(i: usize, t: std::time::Instant) {
+        NS[i].fetch_add(t.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+    pub fn reset() {
+        for v in &NS {
+            v.store(0, Ordering::Relaxed);
+        }
+    }
+    pub fn read() -> [u64; 6] {
+        std::array::from_fn(|i| NS[i].load(Ordering::Relaxed))
+    }
+}
