+//! The far hyperbolic wall of the shipped fit (`Rebinding::from_state`), measured on
+//! exact periapsis states across (E, periapsis), with the invariants key as the control.
+//! One binary, two arms: with the far-field patch, `ES_INVDOMAIN=0` restores the shipped
+//! behavior; on base the env var is ignored. Prints one row per grid point.
+use emergent_space::binding::{IntegerState, Rebinding};
+use emergent_space::orbit::{OrbitKey, Scalar};
+
+fn f(s: Scalar) -> f64 {
+    s.significand() as f64 * 2f64.powi(s.exponent() as i32 - 62)
+}
+
+fn state_at_periapsis(e: f64, rp: f64) -> IntegerState {
+    // At periapsis vr = 0; E^2 = lapse^2/den with den = lapse - vt^2 (fit_key's algebra),
+    // so vt^2 = lapse - lapse^2/E^2. Words are exact integers; the fit's oracle is the
+    // state's own Scalar E, recomputed below, not this target.
+    let u = 1.0 / rp;
+    let lapse = 1.0 - u;
+    let vt2 = lapse - lapse * lapse / (e * e);
+    let vt = vt2.sqrt();
+    let le = (rp.abs().log2().floor() - 54.0) as i16;
+    let px = (rp / 2f64.powi(le as i32)).round() as i64;
+    let vy = (vt * 2f64.powi(60)).round() as i64;
+    IntegerState {
+        position: [px, 0],
+        length_exponent: le,
+        velocity: [0, vy],
+        velocity_exponent: -60,
+    }
+}
+
+fn scalars(st: IntegerState) -> (Scalar, Scalar, Scalar, Scalar) {
+    // (r, vt, den, lapse) from the state's own words, exactly as fit_key forms them.
+    let p = [
+        Scalar::raw(st.position[0] as i128, st.length_exponent as i32).unwrap(),
+        Scalar::raw(st.position[1] as i128, st.length_exponent as i32).unwrap(),
+    ];
+    let v = [
+        Scalar::raw(st.velocity[0] as i128, st.velocity_exponent as i32).unwrap(),
+        Scalar::raw(st.velocity[1] as i128, st.velocity_exponent as i32).unwrap(),
+    ];
+    let r = p[0].mul(p[0]).unwrap().add(p[1].mul(p[1]).unwrap()).unwrap().sqrt().unwrap();
+    let vt = v[1].abs();
+    let u = r.reciprocal().unwrap();
+    let lapse = Scalar::integer(1).sub(u).unwrap();
+    let den = lapse.sub(vt.mul(vt).unwrap()).unwrap();
+    (r, vt, den, lapse)
+}
+
+fn main() {
+    let energies = [1.001, 1.01, 1.1, 1.5, 2.0, 5.0, 10.0, 100.0, 1e3, 1e4, 1e6];
+    let peris = [1e2, 1e4, 1e6, 1e8, 2.7e8, 4e8, 1e9, 1.6e10];
+    let arm = std::env::var("ES_INVDOMAIN").unwrap_or_default();
+    println!("arm ES_INVDOMAIN={arm}");
+    println!("e,rp,outcome,peri_relerr,kword,gap_erel,res_pos_rel,res_vel_rel,inv");
+    let (mut ok, mut refused, mut mismatch, mut invok) = (0u32, 0u32, 0u32, 0u32);
+    for &e in &energies {
+        for &rp in &peris {
+            let st = state_at_periapsis(e, rp);
+            let (r, vt, den, lapse) = scalars(st);
+            // State's own invariants (the oracle and the control's input).
+            let e2 = lapse.mul(lapse).unwrap().div(den).unwrap();
+            let delta = e2.sub(Scalar::integer(1)).unwrap();
+            let angular = r.mul(vt).unwrap();
+            let inv = OrbitKey::from_invariants(delta, angular);
+            if inv.is_ok() {
+                invok += 1;
+            }
+            let row = match Rebinding::from_state(st, Scalar::integer(0), None) {
+                Ok(fit) => {
+                    ok += 1;
+                    let key = fit.trajectory.key();
+                    let perr = (f(key.periapsis) / f(r) - 1.0).abs();
+                    let pos = fit.residual.position;
+                    let vel = fit.residual.velocity;
+                    let pn = ((pos[0] * pos[0] + pos[1] * pos[1]) as f64).sqrt()
+                        * 2f64.powi(st.length_exponent as i32);
+                    let vn = ((vel[0] * vel[0] + vel[1] * vel[1]) as f64).sqrt()
+                        * 2f64.powi(st.velocity_exponent as i32);
+                    // Clock oracle: E^2 = tn/d for keys that carry their gap.
+                    let gapcol = match key.gap {
+                        Some(d) => {
+                            let q = key.compactness().unwrap();
+                            let ks = Scalar::raw(key.k as i128, -48).unwrap();
+                            let tn = ks
+                                .mul(Scalar::integer(1).sub(q.scale(1).unwrap()).unwrap())
+                                .unwrap()
+                                .mul(
+                                    Scalar::integer(1)
+                                        .add(
+                                            q.scale(1)
+                                                .unwrap()
+                                                .mul(Scalar::integer(1).sub(ks.scale(1).unwrap()).unwrap())
+                                                .unwrap(),
+                                        )
+                                        .unwrap(),
+                                )
+                                .unwrap();
+                            let e2k = f(tn.div(d).unwrap());
+                            format!("{:.2e}", (e2k / f(e2) - 1.0).abs())
+                        }
+                        None => "-".into(),
+                    };
+                    let invm = match &inv {
+                        Ok(ik) => {
+                            if ik.periapsis == key.periapsis && ik.k == key.k {
+                                "same"
+                            } else {
+                                mismatch += 1;
+                                "diff"
+                            }
+                        }
+                        Err(_) => "inv-err",
+                    };
+                    format!(
+                        "ok,{:.2e},{},{},{:.2e},{:.2e},{}",
+                        perr,
+                        key.k,
+                        gapcol,
+                        pn / f(r).max(1e-300),
+                        vn / f(vt).max(1e-300),
+                        invm
+                    )
+                }
+                Err(err) => {
+                    refused += 1;
+                    format!(
+                        "refused-{:?},-,,-,-,-,{}",
+                        err,
+                        if inv.is_ok() { "inv-ok" } else { "inv-err" }
+                    )
+                }
+            };
+            println!("{e},{rp},{row}");
+        }
+    }
+    println!("summary ok={ok} refused={refused} invariants_ok={invok} invariants_key_mismatch={mismatch}");
+}
