+//! Focused: at three former Range-refusal points, print the fallback's fitted key vs the
+//! control from_invariants key, and the error stage for points that still refuse.
+use emergent_space::binding::{IntegerState, Rebinding};
+use emergent_space::orbit::{OrbitKey, Scalar};
+
+fn f(s: Scalar) -> f64 {
+    s.significand() as f64 * 2f64.powi(s.exponent() as i32 - 62)
+}
+
+fn mk(e: f64, rp: f64) -> IntegerState {
+    let u = 1.0 / rp;
+    let lapse = 1.0 - u;
+    let vt = (lapse - lapse * lapse / (e * e)).sqrt();
+    let le = (rp.abs().log2().floor() - 54.0) as i16;
+    IntegerState {
+        position: [(rp / 2f64.powi(le as i32)).round() as i64, 0],
+        velocity: [0, (vt * 2f64.powi(60)).round() as i64],
+        length_exponent: le,
+        velocity_exponent: -60,
+    }
+}
+
+fn main() {
+    for &(e, rp) in &[
+        (1.5f64, 1e9f64),
+        (2.0, 4e8),
+        (100.0, 4e8),
+        (1000.0, 1.6e10),
+        (10000.0, 1e9),
+        (1.001, 1e6),
+    ] {
+        let st = mk(e, rp);
+        let p = Scalar::raw(st.position[0] as i128, st.length_exponent as i32).unwrap();
+        let v = Scalar::raw(st.velocity[1] as i128, st.velocity_exponent as i32).unwrap();
+        let r = p.abs();
+        let u = r.reciprocal().unwrap();
+        let lapse = Scalar::integer(1).sub(u).unwrap();
+        let den = lapse.sub(v.mul(v).unwrap()).unwrap();
+        let e2 = lapse.mul(lapse).unwrap().div(den).unwrap();
+        let delta = e2.sub(Scalar::integer(1)).unwrap();
+        let ang = r.mul(v).unwrap();
+        let ctrl = OrbitKey::from_invariants(delta, ang);
+        let fit = Rebinding::from_state(st, Scalar::integer(0), None);
+        match (&ctrl, &fit) {
+            (Ok(ck), Ok(fit)) => {
+                let fk = fit.trajectory.key();
+                println!(
+                    "e={e} rp={rp}: fit k={} ctrl k={} kdiff={} peri_fit={:.6e} peri_ctrl={:.6e} peridiff={:.3e} gap={}",
+                    fk.k,
+                    ck.k,
+                    fk.k as i64 as f64 - ck.k as i64 as f64,
+                    f(fk.periapsis),
+                    f(ck.periapsis),
+                    (f(fk.periapsis) - f(ck.periapsis)).abs(),
+                    fk.gap.is_some(),
+                );
+            }
+            (ck, fe) => println!("e={e} rp={rp}: ctrl={ck:?} fit={fe:?}"),
+        }
+        // Stage isolation for refusals: compile the control key directly.
+        if let Ok(ck) = &ctrl {
+            let comp = emergent_space::orbit::Passage::compile(*ck, r);
+            println!("   passage compile of control key: {:?}", comp.map(|_| ()));
+        }
+    }
+}
