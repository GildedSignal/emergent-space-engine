diff --git a/crates/universe/examples/ramp_debug.rs b/crates/universe/examples/ramp_debug.rs
new file mode 100644
index 0000000..f435265
--- /dev/null
+++ b/crates/universe/examples/ramp_debug.rs
@@ -0,0 +1,44 @@
+// One readout between kicks, dissected: the ramp's dv against the exact partial step's, with the
+// stored samples, the step geometry and the units, so a mismatch says where it came from.
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::Config;
+use emergent_universe::num::to_f64;
+
+fn main() {
+    let mut p = plane(Config::default(), 1, Order::Sparse, 1, 8).unwrap();
+    let ship = p.ships[0];
+    p.u.settle(p.u.now + 4_000_000_000);
+    let ctx = p.u.ctx();
+    let t = p.u.now + 123_456;
+    let b = ctx.bodies.binding_at(ship, t).unwrap();
+    let k = b.kick;
+    println!("binding event_time {}, kick(clock={}, len {}, boundary {}, lead {}), dv {:?}", b.event_time, k.clock, k.len, k.boundary, k.lead, k.dv);
+    let prev = ctx.bodies.binding_at(ship, b.event_time - 1).unwrap();
+    println!("prev event_time {}, kick(clock={}, len {}, boundary {}), dv {:?}", prev.event_time, prev.kick.clock, prev.kick.len, prev.kick.boundary, prev.kick.dv);
+    println!("units b {:?} prev {:?}, clock_exp {}", b.units, prev.units, b.clock_exp);
+    let (base, start) = if t >= k.boundary { (b.clone(), k.boundary) } else { (ctx.bodies.binding_at(ship, b.event_time - 1).unwrap(), b.event_time - k.lead) };
+    let tau = t - start;
+    let mid = start + tau / 2;
+    println!("start {start}, tau {tau}, mid {mid} (mid - base.event_time = {})", mid - base.event_time);
+    // the exact force at mid and at the two kick ticks
+    for tt in [base.event_time, mid, t] {
+        let (x, _) = base.cartesian(tt).unwrap();
+        let f = emergent_universe::force::field(&ctx.secondaries(base.doll, tt, ship).unwrap(), x).unwrap();
+        println!("  exact accel at {tt}: ({:.3e}, {:.3e})", to_f64(f.accel[0]), to_f64(f.accel[1]));
+    }
+    // what the stored words decode to
+    let decode = |w: i64, ve: i16| to_f64(emergent_space::orbit::Scalar::raw(w as i128, ve as i32).unwrap());
+    println!("  base stored a: ({:.3e}, {:.3e})", decode(base.kick.dv[0], base.units.1), decode(base.kick.dv[1], base.units.1));
+    println!("  prev stored a: ({:.3e}, {:.3e})", decode(prev.kick.dv[0], prev.units.1), decode(prev.kick.dv[1], prev.units.1));
+    // the two readouts
+    let (_, pr, vr) = emergent_universe::observe::ramped(&ctx, ship, t).unwrap();
+    let (x_raw, v_raw) = base.cartesian(t).unwrap();
+    let (x_mid, _) = base.cartesian(mid).unwrap();
+    let f_mid = emergent_universe::force::field(&ctx.secondaries(base.doll, mid, ship).unwrap(), x_mid).unwrap();
+    let tau_s = emergent_universe::num::time_of(tau, base.clock_exp).unwrap();
+    let dv_exact = emergent_universe::num::scale2(f_mid.accel, tau_s).unwrap();
+    println!("ramp  dv: ({:.3e}, {:.3e})", to_f64(vr[0]) - to_f64(v_raw[0]), to_f64(vr[1]) - to_f64(v_raw[1]));
+    println!("exact dv: ({:.3e}, {:.3e})", to_f64(dv_exact[0]), to_f64(dv_exact[1]));
+    println!("ramp  dx: ({:.3e}, {:.3e})", to_f64(pr[0]) - to_f64(x_raw[0]), to_f64(pr[1]) - to_f64(x_raw[1]));
+}
diff --git a/crates/universe/examples/ramp_scan.rs b/crates/universe/examples/ramp_scan.rs
new file mode 100644
index 0000000..b62bb6e
--- /dev/null
+++ b/crates/universe/examples/ramp_scan.rs
@@ -0,0 +1,58 @@
+// Scan reads between kicks on the Jacobi ensemble: the ramp's departure from the exact partial
+// step, with the geometry of the worst ones (base, samples, step ticks), to say where a mismatch
+// comes from. `ramp_scan [PERIODS]`.
+use emergent_universe::num::{add2, scale2, time_of, to_f64};
+use emergent_universe::bind::scalars;
+
+fn main() {
+    let periods: i64 = std::env::args().nth(1).and_then(|a| a.parse().ok()).unwrap_or(4);
+    let (mu_log2, sep) = (-10, 527_000_000i64);
+    let hill = sep as f64 * (2f64.powi(mu_log2) / 3.0).cbrt();
+    let ships: Vec<(i64, u32)> = (0..6).map(|i| ((sep as f64 + if i % 2 == 0 { 1.0 } else { -1.0 } * hill * (1.5 + 0.3 * i as f64)) as i64, (i as u32).wrapping_mul(0x9E37_79B9))).collect();
+    let mut w = emergent_universe::scenario::restricted(mu_log2, sep, 49_000, &ships, 1).unwrap();
+    let period = 2.0 * std::f64::consts::PI / ((1.0 + 2f64.powi(mu_log2)).sqrt() / (sep as f64).powf(1.5));
+    let mut worst: Vec<(f64, usize, i64, String)> = Vec::new();
+    for k in 1..=(periods * 8) {
+        let t = (k as f64 * period / 8.0 / 7.0) as i64;
+        w.u.settle(t);
+        for (n, &sh) in w.ships.iter().enumerate() {
+            let ctx = w.u.ctx();
+            let b = match ctx.bodies.binding_at(sh, t) { Some(b) => b, None => continue };
+            let k = b.kick;
+            if !k.clock { continue; }
+            let held;
+            let (base, start) = if t >= k.boundary {
+                (b.clone(), k.boundary)
+            } else if k.lead > 0 {
+                match ctx.bodies.binding_at(sh, b.event_time - 1) {
+                    Some(p) => { held = p; (held.clone(), b.event_time - k.lead) }
+                    None => continue,
+                }
+            } else { continue };
+            let tau = t - start;
+            if tau <= 0 || tau > 2 * k.len.max(1) { continue; }
+            let mid = start + tau / 2;
+            let (x_mid, _) = match base.cartesian(mid) { Ok(x) => x, Err(_) => continue };
+            let field = match emergent_universe::force::field(&ctx.secondaries(base.doll, mid, sh).unwrap(), x_mid) { Ok(f) => f, Err(_) => continue };
+            let tau_s = time_of(tau, base.clock_exp).unwrap();
+            let dv_e = scale2(field.accel, tau_s).unwrap();
+            let dx_e = scale2(dv_e.clone(), tau_s.scale(-1).unwrap()).unwrap();
+            let (p, v) = base.cartesian(t).unwrap();
+            let (pe, ve) = (add2(p, dx_e).unwrap(), add2(v, dv_e).unwrap());
+            let (_, pr, vr) = emergent_universe::observe::ramped(&ctx, sh, t).unwrap();
+            let corr = (to_f64(pe[0]) - to_f64(p[0])).hypot(to_f64(pe[1]) - to_f64(p[1])) + (to_f64(ve[0]) - to_f64(v[0])).hypot(to_f64(ve[1]) - to_f64(v[1]));
+            let miss = (to_f64(pr[0]) - to_f64(pe[0])).hypot(to_f64(pr[1]) - to_f64(pe[1])) + (to_f64(vr[0]) - to_f64(ve[0])).hypot(to_f64(vr[1]) - to_f64(ve[1]));
+            if corr > 0.0 {
+                let share = miss / corr;
+                let note = format!("t {t}, base.et {}, pred.dv {:?}, base.dv {:?}, dm {}, mid-et {}, tau {}, len {}, branch {}", base.event_time, ctx.bodies.binding_at(sh, base.event_time - 1).map(|p| p.kick.dv).unwrap_or_default(), base.kick.dv, base.event_time as i64 - ctx.bodies.binding_at(sh, base.event_time - 1).map(|p| p.event_time).unwrap_or(0), mid - base.event_time, tau, k.len, if t >= k.boundary { "post" } else { "pre" });
+                worst.push((share, n, t, note));
+            }
+        }
+    }
+    worst.sort_by(|a, b| b.0.partial_cmp(&a.0).unwrap());
+    for (s, n, t, note) in worst.iter().take(8) {
+        println!("share {s:.3e} ship {n} {note}");
+    }
+    println!("{} reads; median share {:.2e}", worst.len(), worst[worst.len() / 2].0);
+    let _ = scalars;
+}
diff --git a/crates/universe/examples/readout_cost.rs b/crates/universe/examples/readout_cost.rs
new file mode 100644
index 0000000..ecfbec0
--- /dev/null
+++ b/crates/universe/examples/readout_cost.rs
@@ -0,0 +1,75 @@
+// Where the readout between kicks spends its time, on the ships the view gathers: the raw tube
+// against the partial step (`observe::partial`, through `ramped_in`), and the pieces of the
+// partial step (the second decode, the sources, the field). `readout_cost [RTF]`.
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::Config;
+use std::time::Instant;
+
+fn main() {
+    let mut p = plane(Config::default(), 1, Order::Sparse, 1, 8).unwrap();
+    // The haulers: ships of the root doll, read by the motion law v2's partial step.
+    let haulers: Vec<usize> = p.ships.iter().copied().take(12).collect();
+    let h0 = p.u.now + 4_000_000_000; // well inside the run, engines warm
+    p.u.settle(h0);
+    let ctx = p.u.ctx();
+    let t = p.u.now + 123_456; // a tick between kicks for most ships
+    let n = 2000;
+
+    fn sum(name: &str, n: u32, mut f: impl FnMut()) {
+        // best of 5 rounds, the plane's own convention
+        let mut best = f64::INFINITY;
+        for _ in 0..5 {
+            let t0 = Instant::now();
+            for _ in 0..n {
+                f();
+            }
+            best = best.min(t0.elapsed().as_secs_f64() * 1e6 / n as f64);
+        }
+        println!("{name:<44} {best:7.2} us");
+    }
+
+    let mut clocked = 0;
+    for &s in &haulers {
+        let b = ctx.bodies.binding_at(s, t).unwrap();
+        if b.kick.clock {
+            clocked += 1;
+        }
+    }
+    println!("{clocked} of {} haulers are on the clock at t", haulers.len());
+    let any = haulers.iter().copied().find(|&s| ctx.bodies.binding_at(s, t).unwrap().kick.clock).unwrap();
+
+    sum("raw tube (b.cartesian)", n, || {
+        let b = ctx.bodies.binding_at(any, t).unwrap();
+        std::hint::black_box(b.cartesian(t).unwrap());
+    });
+    sum("partial step (ramped_in)", n, || {
+        let b = ctx.bodies.binding_at(any, t).unwrap();
+        std::hint::black_box(emergent_universe::observe::ramped_in(&ctx, any, t, &b).unwrap());
+    });
+    sum("root_state (ramped, up the chain)", n, || {
+        std::hint::black_box(emergent_universe::observe::root_state(&ctx, any, t).unwrap());
+    });
+    // the pieces of the partial step
+    let b = ctx.bodies.binding_at(any, t).unwrap();
+    let k = b.kick;
+    let (base, start) = if t >= k.boundary { (b.clone(), k.boundary) } else { (ctx.bodies.binding_at(any, b.event_time - 1).unwrap(), b.event_time - k.lead) };
+    let tau = t - start;
+    let mid = start + tau / 2;
+    sum("  decode at mid (base.cartesian)", n, || {
+        std::hint::black_box(base.cartesian(mid).unwrap());
+    });
+    sum("  secondaries at mid", n, || {
+        std::hint::black_box(ctx.secondaries(base.doll, mid, any).unwrap());
+    });
+    let secs = ctx.secondaries(base.doll, mid, any).unwrap();
+    let (x_mid, _) = base.cartesian(mid).unwrap();
+    sum("  field at mid (potential+rate+accel)", n, || {
+        std::hint::black_box(emergent_universe::force::field(&secs, x_mid).unwrap());
+    });
+    sum("  decode at t", n, || {
+        std::hint::black_box(base.cartesian(t).unwrap());
+    });
+    drop(ctx);
+    println!("sources in the root doll: {}", p.u.sources[0].len());
+}
