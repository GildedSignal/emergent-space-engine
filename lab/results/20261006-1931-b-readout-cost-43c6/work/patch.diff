+/// The force a reader completes the tube with, from the kicks' own samples: the kick that made `base`
+/// applied its acceleration at its own tick and stored it ([`Kick::dv`], at its own exponent), and
+/// the kick before it the same, so the force at `t_hat` is read linearly in time through the two. The
+/// pair is anchored on `base`, which does not change across the kicks that rebind inside a step, so the
+/// readout is continuous across a kick and hands over at the boundaries, where the correction is zero.
+///
+/// `None` where no sample exists (the clock's first step, `dv` still zero; a force that did not fit the
+/// word): the caller evaluates the field. A missing predecessor leaves the one sample alone (no slope).
+fn ramped_accel(bodies: &dyn BodyStore, i: usize, base: &Binding, t_hat: Tick) -> Res<Option<V2>> {
+    let k = base.kick;
+    if !k.clock || k.dv == [0, 0] {
+        return Ok(None);
+    }
+    let a1 = [Scalar::raw(k.dv[0] as i128, k.exp as i32)?, Scalar::raw(k.dv[1] as i128, k.exp as i32)?];
+    let Some(prev) = bodies.binding_at(i, base.event_time - 1) else {
+        return Ok(Some(a1));
+    };
+    let dm = base.event_time - prev.event_time;
+    if !prev.kick.clock || prev.kick.dv == [0, 0] || dm <= 0 {
+        return Ok(Some(a1));
+    }
+    let a0 = [Scalar::raw(prev.kick.dv[0] as i128, prev.kick.exp as i32)?, Scalar::raw(prev.kick.dv[1] as i128, prev.kick.exp as i32)?];
+    let dt = Scalar::integer(t_hat - base.event_time);
+    let mut a = a1;
+    for c in 0..2 {
+        let slope = a1[c].sub(a0[c])?.div(Scalar::integer(dm))?;
+        a[c] = slope.mul(dt)?.add(a1[c])?;
+    }
+    Ok(Some(a))
+}
