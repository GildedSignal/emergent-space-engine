+/// The ramp is the partial step's equal where it replaces it. The readout between kicks reads the force
+/// from the kicks' own samples (linear in time; no source decoded, no field summed at read time), so on
+/// the same ensemble, at between-kick phases across eight planet periods (encounters included), it is
+/// compared against the exact partial step — the sources decoded and the field summed at the half-drift
+/// point, the memo's own definition. The scale is the correction both forms apply, measured against the
+/// base tube they complete (not the current binding's tube, which for a read before the boundary already
+/// carries the kick, and would cancel the correction at the window's end). The bound: the worst departure
+/// at most 1% of that correction (the linear fit's error over one step, against the pending impulse the
+/// correction exists to cancel).
+#[test]
+fn the_ramp_matches_the_partial_step_it_replaces() {
+    use emergent_universe::num::{add2, scale2, time_of, to_f64};
+    let (mu_log2, sep) = (-10, 527_000_000i64);
+    let hill = sep as f64 * (2f64.powi(mu_log2) / 3.0).cbrt();
+    let ships: Vec<(i64, u32)> = (0..6).map(|i| ((sep as f64 + if i % 2 == 0 { 1.0 } else { -1.0 } * hill * (1.5 + 0.3 * i as f64)) as i64, (i as u32).wrapping_mul(0x9E37_79B9))).collect();
+    let mut w = emergent_universe::scenario::restricted(mu_log2, sep, 49_000, &ships, 1).unwrap();
+    let period = 2.0 * std::f64::consts::PI / ((1.0 + 2f64.powi(mu_log2)).sqrt() / (sep as f64).powf(1.5));
+    // (the exact partial step, the base tube it completes), from the public pieces.
+    let exact = |u: &Universe, i: usize, t: i64| -> Option<([f64; 2], [f64; 2], [f64; 2], [f64; 2])> {
+        let ctx = u.ctx();
+        let b = ctx.bodies.binding_at(i, t)?;
+        let k = b.kick;
+        if !k.clock {
+            return None;
+        }
+        let held;
+        let (base, start) = if t >= k.boundary {
+            (&b, k.boundary)
+        } else if k.lead > 0 {
+            held = ctx.bodies.binding_at(i, b.event_time - 1)?;
+            (&held, b.event_time - k.lead)
+        } else {
+            return None;
+        };
+        let tau = t - start;
+        if tau <= 0 || tau > 2 * k.len.max(1) {
+            return None;
+        }
+        let mid = start + tau / 2;
+        let (x_mid, _) = base.cartesian(mid).ok()?;
+        let field = emergent_universe::force::field(&ctx.secondaries(base.doll, mid, i).ok()?, x_mid).ok()?;
+        let tau_s = time_of(tau, base.clock_exp).ok()?;
+        let dv = scale2(field.accel, tau_s).ok()?;
+        let dx = scale2(dv, tau_s.scale(-1).ok()?).ok()?;
+        let (p, v) = base.cartesian(t).ok()?;
+        let (xb, vb) = ([to_f64(p[0]), to_f64(p[1])], [to_f64(v[0]), to_f64(v[1])]);
+        let (p, v) = (add2(p, dx).ok()?, add2(v, dv).ok()?);
+        Some(([to_f64(p[0]), to_f64(p[1])], [to_f64(v[0]), to_f64(v[1])], xb, vb))
+    };
+    let (mut looked, mut worst_share) = (0, 0.0f64);
+    for k in 1..=(8 * 8) {
+        let t = (k as f64 * period / 8.0) as i64;
+        w.u.settle(t);
+        for &sh in &w.ships {
+            let ctx = w.u.ctx();
+            let Some((xe, ve, xr, vr)) = exact(&w.u, sh, t) else { continue };
+            let (_, p, v) = emergent_universe::observe::ramped(&ctx, sh, t).unwrap();
+            let (x, v) = ([to_f64(p[0]), to_f64(p[1])], [to_f64(v[0]), to_f64(v[1])]);
+            let corr = (xe[0] - xr[0]).hypot(xe[1] - xr[1]) + (ve[0] - vr[0]).hypot(ve[1] - vr[1]);
+            let miss = (x[0] - xe[0]).hypot(x[1] - xe[1]) + (v[0] - ve[0]).hypot(v[1] - ve[1]);
+            if corr > 0.0 {
+                looked += 1;
+                worst_share = worst_share.max(miss / corr);
+            }
+        }
+    }
+    println!("{looked} reads between kicks: the ramp's worst departure from the exact partial step is {worst_share:.2e} of the correction");
+    assert!(looked > 200, "enough between-kick reads were compared: {looked}");
+    assert!(worst_share <= 1e-2, "the ramp misses {worst_share:.2e} of the correction it replaces");
+}
+
