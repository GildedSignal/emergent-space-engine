+    let presented_cut = args.get(6).map(String::as_str) == Some("now");
+    let (rss0, _) = proc_status();
+    let t0 = Instant::now();
+    let mut p = plane_extra(Config::default(), std::env::var("WSEED").ok().and_then(|s| s.parse::<u64>().ok()).unwrap_or(1), Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
