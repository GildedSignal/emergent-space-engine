@@ -0,0 +1,98 @@
+//! Read/write census of the compiled cycle (lab run 20261016-1946-system-5d50).
+//!
+//! The standing question: is a body's compiled trajectory (the knot table) *state* (read
+//! many times between writes) or a *transient of the event that wrote it* (read O(1)
+//! times, at the next event)? Every panel read of a compiled table goes through
+//! [`crate::bind::decode`]; every fresh table is written by [`crate::bind::bind_in`].
+//! Thread-safe statics, zero cost when not reported; the tags name the reader.
+
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// A kick's own readout of the state it is about to change (`Work::kick`).
+pub const R_KICK: usize = 0;
+/// `next_impact`'s surface search (the crash check after a kick or boundary).
+pub const R_CRASH: usize = 1;
+/// Event planning that reads the table (`next_periapsis`, `next_exit`).
+pub const R_PLAN: usize = 2;
+/// The view: the retarded-time gather and the HUD's clock read.
+pub const R_VIEW: usize = 3;
+/// The rebind itself reading the old binding's clock (`orbit_state` for τ).
+pub const R_BIND: usize = 4;
+/// Clock reads between events (`proper_since`, the player's clock-stepped path).
+pub const R_TAU: usize = 5;
+/// Anything else (genesis, doll creation, captures, hand-outs' reads).
+pub const R_OTHER: usize = 6;
+pub const READERS: usize = 7;
+
+pub const READER_NAMES: [&str; READERS] = [
+    "kick readout", "crash search", "plan", "view", "rebind tau", "clock", "other",
+];
+
+/// A fresh compiled cycle standing in a binding (`bind_in`).
+pub const W_BIND: usize = 0;
+/// The coarser-word second fit of the same bind (the retry).
+pub const W_RETRY: usize = 1;
+pub const WRITERS: usize = 2;
+
+static READS: [AtomicU64; READERS] = [const { AtomicU64::new(0) }; READERS];
+static WRITES: [AtomicU64; WRITERS] = [const { AtomicU64::new(0) }; WRITERS];
+
+thread_local! {
+    static READER: Cell<usize> = const { Cell::new(R_OTHER) };
+}
+
+/// Run `f` with every `decode` it performs counted under `reader`.
+pub fn with<R>(reader: usize, f: impl FnOnce() -> R) -> R {
+    struct Reset(usize);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            READER.with(|r| r.set(self.0));
+        }
+    }
+    let old = READER.with(|r| r.replace(reader));
+    let guard = Reset(old);
+    let out = f();
+    drop(guard);
+    out
+}
+
+/// Called by `decode` only: one panel read of a compiled table.
+pub(crate) fn read() {
+    let r = READER.with(|c| c.get());
+    READS[r.min(READERS - 1)].fetch_add(1, Ordering::Relaxed);
+}
+/// What the bindings hold at this instant: (bodies, bound cycles, knots, crossings, bytes of
+/// compiled table: knots and crossing words). Passages and plunges hold their own arcs, counted
+/// as bodies only.
+pub fn standing(u: &crate::universe::Universe) -> [usize; 5] {
+    let n = u.n_bodies();
+    let (mut cycles, mut knots, mut crossings) = (0usize, 0usize, 0usize);
+    for i in 0..n {
+        if let emergent_space::binding::Trajectory::Cycle(o) = &u.rec(i).b.entry.trajectory {
+            cycles += 1;
+            knots += o.shape().knots().len();
+            crossings += o.shape().crossings().len();
+        }
+    }
+    let bytes = knots * std::mem::size_of::<emergent_space::orbit::Knot>() + crossings * std::mem::size_of::<usize>();
+    [n, cycles, knots, crossings, bytes]
+}
+
+/// Called by `bind_in` (W_BIND) and its coarser retry (W_RETRY).
+pub(crate) fn write(retry: usize) {
+    WRITES[retry.min(WRITERS - 1)].fetch_add(1, Ordering::Relaxed);
+}
+
+/// The census so far: (reads by reader, writes by kind).
+pub fn report() -> ([u64; READERS], [u64; WRITERS]) {
+    let mut r = [0_u64; READERS];
+    let mut w = [0_u64; WRITERS];
+    for i in 0..READERS {
+        r[i] = READS[i].load(Ordering::Relaxed);
+    }
+    for i in 0..WRITERS {
+        w[i] = WRITES[i].load(Ordering::Relaxed);
+    }
+    (r, w)
+}
