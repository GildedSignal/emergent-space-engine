+/// One committed event, as the store saw it (the H_live instrument). `dv` is the kick's velocity
+/// add in quanta of the new binding's velocity exponent; zero for events that are not kicks.
+#[derive(Clone, Copy, Debug)]
+pub struct HliveEvent {
+    pub kind: u8,
+    pub body: u32,
+    pub t: i64,
+    /// Retired segments pushed to history (the scar writes).
+    pub retired: u32,
+    /// The `BodyRec` (with its plan) written back, in bytes.
+    pub rec_bytes: u32,
+    /// A trajectory was compiled and inserted into the catalogue.
+    pub compiled: bool,
+    pub dv: [i64; 2],
+    pub level: u8,
+    pub len: i64,
+    pub clock: bool,
+    pub vel_exp: i16,
+}
+
+/// Counts and samples what the resolver commits, so bits per event can be measured off-line.
+/// It reads `Update`s only; it changes no state and appears in no digest.
+#[derive(Default)]
+pub struct Hlive {
+    pub events: Vec<HliveEvent>,
+    /// The sample cap (the totals keep counting past it).
+    pub cap: usize,
+    pub total: u64,
+    /// Committed events by `Resolved` discriminant (Kick, Open, Boundary, Handoff, Lost, Refused).
+    pub by_kind: [u64; 6],
+    /// Retired segments and `BodyRec` bytes by the same discriminant.
+    pub segs_by_kind: [u64; 6],
+    pub bytes_by_kind: [u64; 6],
+    pub compiled_total: u64,
+}
+impl Hlive {
+    pub fn new(cap: usize) -> Self {
+        Self { cap, ..Default::default() }
+    }
+    fn kind_of(k: step::Resolved) -> u8 {
+        match k {
+            step::Resolved::Kick => 0,
+            step::Resolved::Open => 1,
+            step::Resolved::Boundary => 2,
+            step::Resolved::Handoff => 3,
+            step::Resolved::Lost => 4,
+            step::Resolved::Refused => 5,
+        }
+    }
+    pub fn note(&mut self, i: usize, upd: &step::Update) {
+        let k = Self::kind_of(upd.kind) as usize;
+        let rec_bytes =
+            (std::mem::size_of::<BodyRec>() + upd.rec.plan.len() * std::mem::size_of::<Item>()) as u32;
+        self.total += 1;
+        self.by_kind[k] += 1;
+        self.segs_by_kind[k] += upd.retired.len() as u64;
+        self.bytes_by_kind[k] += rec_bytes as u64;
+        self.compiled_total += u64::from(upd.new_entry.is_some());
+        if self.events.len() < self.cap {
+            self.events.push(HliveEvent {
+                kind: k as u8,
+                body: i as u32,
+                t: upd.rec.b.event_time,
+                retired: upd.retired.len() as u32,
+                rec_bytes,
+                compiled: upd.new_entry.is_some(),
+                dv: upd.rec.b.kick.dv,
+                level: upd.rec.b.kick.level,
+                len: upd.rec.b.kick.len,
+                clock: upd.rec.b.kick.clock,
+                vel_exp: upd.rec.b.units.1,
+            });
+        }
+    }
+}
