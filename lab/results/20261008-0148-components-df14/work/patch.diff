+//! `universe --h-live`: what the resolver commits, per game-second, measured as events, written
+//! bytes and the kicks' `dv` streams (the storage component's floor work: bits of live
+//! distinguishing information against bytes of scar). The recorder changes no state and no digest.
+use super::{script, Session};
+use emergent_universe::body::{BodyRec, Item, Segment};
+use emergent_universe::bind::Binding;
+use emergent_universe::universe::Hlive;
+use emergent_universe::view::TICK_SECONDS;
+use serde_json::json;
+use std::io::Write;
+use std::time::Instant;
+
+pub(super) fn run(mut s: Session, seconds: f64, cap: usize, csv: Option<String>) -> crate::Result<u8> {
+    let machine_before = crate::measure::machine_state("before");
+    let made_n = s.n_bodies();
+    s.p.u.hlive = Some(Hlive::new(cap));
+    let wall = Instant::now();
+    let mut frames = 0usize;
+    let mut keys = 0u8;
+    for n in 1..=(seconds * 60.0) as usize {
+        if wall.elapsed().as_secs_f64() >= 55.0 {
+            return Err("h-live run exceeded 55 s; no complete result".into());
+        }
+        let now = s.p.u.now;
+        if keys != script(n) {
+            keys = script(n);
+            s.p.u.input(now, keys).map_err(|e| format!("input: {e:?}"))?;
+        }
+        s.p.u.frame(1.0 / 60.0, s.rtf, emergent_universe::Budget::unlimited());
+        s.p.u.settle(s.p.u.now);
+        frames = n;
+    }
+    let h = s.p.u.hlive.take().unwrap_or_default();
+    let game_seconds = s.p.u.now as f64 * TICK_SECONDS;
+    let segment_bytes = std::mem::size_of::<Segment>() as u64;
+    let names = ["kick", "open", "boundary", "handoff", "lost", "refused"];
+    let by_kind: Vec<serde_json::Value> = names
+        .iter()
+        .enumerate()
+        .map(|(k, name)| {
+            json!({
+                "kind": name,
+                "events": h.by_kind[k],
+                "events_per_game_second": h.by_kind[k] as f64 / game_seconds,
+                "segments": h.segs_by_kind[k],
+                "segment_bytes": h.segs_by_kind[k] * segment_bytes,
+                "rec_bytes": h.bytes_by_kind[k],
+            })
+        })
+        .collect();
+    // The store's live bytes per body (records, plans, catalogue share of the compiled shape, history).
+    let mut store_bytes = 0u64;
+    for i in 0..s.n_bodies() {
+        store_bytes += s.p.u.bodies().bytes_of(i) as u64;
+    }
+    let out = json!({
+        "scope": "committed resolver events (the persistent-store commit path); fleet-internal battle slices excluded (they write no segments)",
+        "seed": s.seed, "rtf": s.rtf, "frames": frames, "members_made": made_n,
+        "game_seconds": game_seconds, "wall_seconds": wall.elapsed().as_secs_f64(),
+        "events_total": h.total, "events_sampled": h.events.len(),
+        "events_per_game_second": h.total as f64 / game_seconds,
+        "compiled_inserts": h.compiled_total,
+        "sizes": {
+            "segment": segment_bytes,
+            "binding": std::mem::size_of::<Binding>(),
+            "body_rec": std::mem::size_of::<BodyRec>(),
+            "item": std::mem::size_of::<Item>(),
+            "tube": emergent_universe::body::tube_bytes(),
+        },
+        "by_kind": by_kind,
+        "store_bytes_total": store_bytes,
+        "n_bodies_final": s.n_bodies(),
+        "bytes_per_body": s.p.u.bytes_per_body(),
+        "digest": s.digest_at_cut().1,
+        "machine_before": machine_before,
+        "machine_after": crate::measure::machine_state("after"),
+    });
+    println!("{}", serde_json::to_string_pretty(&out)?);
+    if let Some(path) = csv {
+        let mut f = std::fs::File::create(&path)?;
+        writeln!(f, "kind,body,t,retired,rec_bytes,compiled,dv0,dv1,level,len,clock,vel_exp")?;
+        for e in &h.events {
+            writeln!(
+                f,
+                "{},{},{},{},{},{},{},{},{},{},{},{}",
+                e.kind, e.body, e.t, e.retired, e.rec_bytes, u8::from(e.compiled),
+                e.dv[0], e.dv[1], e.level, e.len, u8::from(e.clock), e.vel_exp
+            )?;
+        }
+    }
+    Ok(0)
+}
