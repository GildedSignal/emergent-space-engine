+//! The co-orbital certificate red-team (lab run 20261008-2206-taleb-f965, lens Taleb).
+//!
+//! Question: the phase-neighbour certificate (rank ≤ 4 along the orbit, adopted 6 October for
+//! concentrated workloads) — where does it break, and does a family-level crossing gate keep
+//! candidate work tracking real encounters?
+//!
+//! Methods, all judged against the crate's independent truth (`truth_pair`, Halley states):
+//! - `cone`:      the adopted window tier (Binet cone + section windows) over every candidate;
+//! - `rankk-glb`: the dangerous reading of the trigger: phase rank over ALL bodies by λ(t=0);
+//! - `gate`:      greedy families in Binet space (ε), rank-k inside a family, and for each
+//!                crossing family-pair a time gate at the crossing longitudes
+//!                (window = S·(ρ+ε)/|Δv| from the representatives), then the same exact
+//!                per-pair minimum scan the section machinery uses.
+//!
+//! One JSON object per line on stdout.
+
+use emergent_encounters::belt::{make_belt, Rng, Spec};
+use emergent_encounters::kepler::{Body, TICKS};
+use emergent_encounters::method::{pair_events, Stats};
+use emergent_encounters::pairs::{cone_pairs, norm, radial_pairs, scan_minima};
+use emergent_encounters::truth::{truth_pair, TruthStats};
+use emergent_encounters::par_chunks;
+use std::f64::consts::{PI, TAU};
+use std::time::Instant;
+
+const THREADS: usize = 4;
+const SAFETY: f64 = 1.1; // section windows, as in main.rs
+const EPS_FAM: f64 = 2e-3; // family radius in Binet space
+const GATE_S: f64 = 4.0; // gate safety on the time window
+const EPS_FAM_JOIN: f64 = 3e-3; // family JOIN radius (absorbs a fleet's full diameter)
+const K_SIDE: usize = 2; // rank partners each way (4 total, the adopted rank)
+
+type Enc = (u32, u32, f64, f64);
+
+struct Scene {
+    name: String,
+    b: Vec<Body>,
+    rho: f64,
+    t_end: f64,
+}
+
+fn rang(r: &mut Rng, lo: f64, hi: f64) -> f64 {
+    lo + (hi - lo) * r.f64()
+}
+
+fn fleet(n: usize, seed: u64, e0: f64, pom0: f64, lam_lo: f64, lam_hi: f64) -> Vec<Body> {
+    let mut r = Rng(seed);
+    (0..n)
+        .map(|_| {
+            let a = 1.0 + rang(&mut r, -5e-5, 5e-5);
+            let e = e0 + rang(&mut r, -1e-3, 1e-3);
+            let pom = pom0 + rang(&mut r, -1e-3, 1e-3);
+            let lam = rang(&mut r, lam_lo, lam_hi);
+            Body::new(a, e, pom, lam)
+        })
+        .collect()
+}
+
+fn belt_spec(n: usize, sigma_e: f64, rho: f64, a_lo: f64, a_hi: f64, seed: u64, orbits: f64) -> Spec {
+    Spec {
+        name: String::new(),
+        n,
+        sigma_e,
+        rho,
+        a_lo,
+        a_hi,
+        keys: 0,
+        seed,
+        orbits,
+    }
+}
