+        for &(i, j) in &pairs[r] {
+            tmp.clear();
+            pair_events(&b[i as usize], &b[j as usize], rho, SAFETY, 0.0, t_end, &mut st, &mut tmp);
+            out.extend(tmp.iter().map(|&(t, d)| (i, j, t, d)));
+        }
