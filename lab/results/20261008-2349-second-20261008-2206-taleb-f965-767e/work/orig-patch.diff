+fn method_pairs_t(b: &[Body], pairs: &[(u32, u32)], rho: f64, t0: f64, t1: f64) -> (Vec<Enc>, Stats, u128) {
+    let ts = Instant::now();
+    let parts = par_chunks(pairs.len(), 256, THREADS, |r| {
+        let mut out = Vec::new();
+        let mut st = Stats::default();
+        let mut tmp = Vec::new();
+        for &(i, j) in &pairs[r] {
+            tmp.clear();
+            pair_events(&b[i as usize], &b[j as usize], rho, SAFETY, t0, t1, &mut st, &mut tmp);
+            out.extend(tmp.iter().map(|&(t, d)| (i, j, t, d)));
+        }
+        (out, st)
+    });
+    let mut all = Vec::new();
+    let mut st = Stats::default();
+    for (o, s) in parts {
+        all.extend(o);
+        st.add(&s);
+    }
+    (all, st, ts.elapsed().as_millis())
+}
+fn method_pairs(b: &[Body], pairs: &[(u32, u32)], rho: f64, t_end: f64) -> (Vec<Enc>, Stats, u128) {
+    let t0 = Instant::now();
+    let parts = par_chunks(pairs.len(), 256, THREADS, |r| {
+        let mut out = Vec::new();
+        let mut st = Stats::default();
