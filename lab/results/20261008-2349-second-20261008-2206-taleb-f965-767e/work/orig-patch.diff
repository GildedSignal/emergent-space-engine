+    let mut st = Stats::default();
+    for (o, s) in parts {
+        all.extend(o);
+        st.add(&s);
+    }
+    (all, st, t0.elapsed().as_millis())
+}
+
+struct Fam {
+    members: Vec<u32>,
+    rep: Body,
+    /// Actual radius of this family in Binet space (max member distance to the representative).
+    eps: f64,
+}
+
+/// Greedy leader families in Binet space (no chaining): a body joins the first leader within ε.
+fn families(b: &[Body], eps: f64) -> (Vec<usize>, Vec<Fam>) {
+    let mut order: Vec<u32> = (0..b.len() as u32).collect();
+    order.sort_by(|&i, &j| b[i as usize].binet()[0].total_cmp(&b[j as usize].binet()[0]));
+    let mut assign = vec![usize::MAX; b.len()];
+    let mut fams: Vec<Fam> = Vec::new();
+    for &i in &order {
+        let ui = b[i as usize].binet();
+        let mut found = None;
+        for (fi, f) in fams.iter().enumerate() {
+            let uf = f.rep.binet();
+            let d = (ui[0] - uf[0]).hypot(ui[1] - uf[1]).hypot(ui[2] - uf[2]);
+            if d <= eps {
+                found = Some(fi);
+                break;
+            }
+        }
+        match found {
+            Some(fi) => {
+                assign[i as usize] = fi;
+                fams[fi].members.push(i);
+            }
+            None => {
+                assign[i as usize] = fams.len();
+                fams.push(Fam { members: vec![i], rep: b[i as usize], eps: f64::INFINITY });
+            }
+        }
+    }
+    for f in fams.iter_mut() {
+        let (mut u, mut v, mut w) = (0.0, 0.0, 0.0);
+        for &m in &f.members {
+            let x = b[m as usize].binet();
+            u += x[0];
+            v += x[1];
+            w += x[2];
+        }
+        let n = f.members.len() as f64;
+        (u, v, w) = (u / n, v / n, w / n);
+        let e = v.hypot(w) / u;
+        let a = 1.0 / (u * (1.0 - e * e));
+        f.rep = Body::new(a, e, w.atan2(v), 0.0);
+        f.eps = f
+            .members
+            .iter()
+            .map(|&m| {
+                let x = b[m as usize].binet();
+                (x[0] - u).hypot(x[1] - v).hypot(x[2] - w)
+            })
+            .fold(0.0, f64::max)
+            .max(1e-9);
+        let _ = f.eps;
+    }
+    (assign, fams)
+}
+struct Xing {
+    fa: usize,
+    fb: usize,
+    th: f64,
+    wg: f64,
+    dvv: f64,
+}
+
+/// Crossing longitudes and time-window half-widths per family pair (representatives, widened by ε).
+fn family_crossings(fams: &[Fam], rho: f64, eps: f64) -> Vec<Xing> {
+    let mut xs = Vec::new();
+    for a in 0..fams.len() {
+        for bb in a + 1..fams.len() {
+            let ua = fams[a].rep.binet();
+            let ub = fams[bb].rep.binet();
+            let (du, dv, dw) = (ub[0] - ua[0], ub[1] - ua[1], ub[2] - ua[2]);
+            let r = dv.hypot(dw);
+            if r < 1e-12 || du.abs() - r >= 2.5 * eps {
+                continue; // spacelike-wide with margin: members cannot cross either
+            }
+            let x = (-du / r).clamp(-1.0, 1.0);
+            let base = dw.atan2(dv);
+            for sgn in [1.0, -1.0] {
+                let th = (base + sgn * x.acos()).rem_euclid(TAU);
+                let sa = fams[a].rep.at_longitude(th);
+                let sb = fams[bb].rep.at_longitude(th);
+                let dvv = norm([sa[2] - sb[2], sa[3] - sb[3]]).max(1e-9);
+                let wg = GATE_S * (rho + fams[a].eps + fams[bb].eps) / dvv;
+                xs.push(Xing { fa: a, fb: bb, th, wg, dvv });
+            }
+        }
+    }
+    xs
+}
+
+#[allow(clippy::too_many_arguments)]
+fn gate_method(
+    b: &[Body],
+    rho: f64,
+    t_end: f64,
+    k_side: usize,
+    scans: bool,
+) -> (Vec<Enc>, u64, u64, u64, f64, usize, u128) {
+    let t0 = Instant::now();
+    let (assign, fams) = families(b, EPS_FAM_JOIN);
+    let xs = family_crossings(&fams, rho, EPS_FAM);
+
+    // Intra-family: the phase-rank certificate, re-ranked every orbit (synodic drift moves
+    // partners by ~Δn·T_chunk per chunk; one orbit keeps the drift far below one spacing).
+    let mut ev: Vec<Enc> = Vec::new();
+    let mut st = Stats::default();
+    let mut t0c = 0.0f64;
+    while t0c < t_end {
+        let t1c = (t0c + TAU).min(t_end);
+        let mut intra: Vec<(u32, u32)> = Vec::new();
+        for f in &fams {
+            intra.extend(rank_pairs_at(b, &f.members, k_side, t0c));
+        }
+        let (mut e2, mut s2, _) = method_pairs_t(b, &intra, rho, t0c, t1c);
+        ev.append(&mut e2);
+        st.add(&s2);
+        t0c = t1c;
+    }
+
+    // Inter-family: passage events at each crossing longitude, joined in time.
+    #[derive(Clone, Copy)]
+    struct Ev {
+        xid: u32,
+        t: f64,
+        body: u32,
+        fam: usize,
+    }
+    let mut events: Vec<Ev> = Vec::new();
+    for (xi, x) in xs.iter().enumerate() {
+        for &i in &fams[x.fa].members {
+            let bi = &b[i as usize];
+            let p = bi.period as f64 / TICKS;
+            let tp = bi.passage_tick(x.th) as f64 / TICKS;
+            let mut t = tp;
+            while t <= t_end {
+                events.push(Ev { xid: xi as u32, t, body: i, fam: x.fa });
+                t += p;
+            }
+        }
+        for &i in &fams[x.fb].members {
+            let bi = &b[i as usize];
+            let p = bi.period as f64 / TICKS;
+            let tp = bi.passage_tick(x.th) as f64 / TICKS;
+            let mut t = tp;
+            while t <= t_end {
+                events.push(Ev { xid: xi as u32, t, body: i, fam: x.fb });
+                t += p;
+            }
+        }
+    }
+    events.sort_by(|a, c| (a.xid, a.t, a.fam).partial_cmp(&(c.xid, c.t, c.fam)).unwrap());
+
+    // Time join per crossing: pair bodies of different families within the window.
+    let mut hits: Vec<(u32, u32, f64, f64, f64, f64)> = Vec::new(); // (i, j, t_mid, wg, |dt|, dvv)
+    let mut q = 0usize;
+    while q < events.len() {
+        let xid = events[q].xid;
+        let mut w = q;
+        while w < events.len() && events[w].xid == xid {
+            w += 1;
+        }
+        let wg = xs[xid as usize].wg;
+        let dvv = xs[xid as usize].dvv;
+        for e in q..w {
+            for f in e + 1..w {
+                if events[f].t - events[e].t > wg {
+                    break;
+                }
+                if events[f].fam == events[e].fam {
+                    continue;
+                }
+                let (i, j) = (events[e].body, events[f].body);
+                hits.push((
+                    i.min(j),
+                    i.max(j),
+                    0.5 * (events[e].t + events[f].t),
+                    wg,
+                    (events[f].t - events[e].t).abs(),
+                    dvv,
+                ));
+            }
+        }
+        q = w;
+    }
+
+    // Exact per-pair checks on the gated passages (deduped per pair and time proximity).
+    hits.sort_by(|a, c| (a.0, a.1, a.2).partial_cmp(&(c.0, c.1, c.2)).unwrap());
+    let mut evals = st.evals;
+    let mut max_util = 0.0f64;
+    let mut last: (u32, u32, f64) = (u32::MAX, u32::MAX, f64::NAN);
+    for &(i, j, t, wg, dt, dvv) in &hits {
+        if (i, j) == (last.0, last.1) && (t - last.2).abs() < 2.0 * wg {
+            continue;
+        }
+        last = (i, j, t);
+        if !scans {
+            continue;
+        }
+        let (lo, hi) = ((t - 3.0 * wg).max(0.0), (t + 3.0 * wg).min(t_end));
+        if hi <= lo {
+            continue;
+        }
+        // Resolve near-tangent crossings (large window, slow closing): sample at a quarter of
+        // the encounter duration, capped like the section machinery's Wide/Full sections.
+        let dur = 0.25 * rho / dvv.max(1e-12);
+        let k = (((hi - lo) / dur.max(1e-15)) as usize).clamp(24, 1024);
+        let mut out: Vec<(f64, f64)> = Vec::new();
+        scan_minima(&b[i as usize], &b[j as usize], lo, hi, k, rho, false, &mut out, &mut evals);
+        for &(tm, dm) in &out {
+            ev.push((i, j, tm, dm));
+            max_util = max_util.max(dt / wg);
+        }
+    }
+    ev.sort_by(|a, c| (a.0, a.1, a.2).partial_cmp(&(c.0, c.1, c.2)).unwrap());
+    (
+        ev,
+        evals,
+        events.len() as u64,
+        hits.len() as u64,
+        max_util,
+        fams.len(),
+        t0.elapsed().as_millis(),
+    )
+}
+
+fn report(
+    sc: &Scene,
+    method: &str,
+    fams: usize,
+    cands: u64,
+    events: u64,
+    hits: u64,
+    evals: u64,
+    enc_in: u64,
+    missed: u64,
+    false_: u64,
+    ms: u128,
+) {
+    println!(
+        "{{\"scene\":\"{}\",\"method\":\"{}\",\"n\":{},\"fams\":{},\"cands\":{},\"events\":{},\"hits\":{},\"evals\":{},\"enc\":{},\"missed\":{},\"false\":{},\"ms\":{}}}",
+        sc.name, method, sc.b.len(), fams, cands, events, hits, evals, enc_in, missed, false_, ms
+    );
+}
+
+fn dump_missed(sc: &Scene, truth: &[Enc], ev: &[Enc]) {
+    let (assign, _fams) = families(&sc.b, EPS_FAM);
+    let mut shown = 0;
+    for &(i, j, t, d) in truth.iter() {
+        if !(t > 0.05 && t < sc.t_end - 0.05) {
+            continue;
+        }
+        let found = ev.iter().any(|&(a, c, tm, _)| (a, c) == (i, j) && (tm - t).abs() < 0.05);
+        if !found {
+            let (bi, bj) = (&sc.b[i as usize], &sc.b[j as usize]);
+            eprintln!(
+                "MISS {} ({},{}) t={:.4} d={:.2e} fams=({},{}) lam0=({:.4},{:.4}) a=({:.6},{:.6}) e=({:.5},{:.5}) pom=({:.4},{:.4})",
+                sc.name, i, j, t, d, assign[i as usize], assign[j as usize],
+                lam0(bi), lam0(bj), bi.a, bj.a, bi.e, bj.e, bi.pom, bj.pom
+            );
+            shown += 1;
+            if shown >= 8 {
+                break;
+            }
+        }
+    }
+}
+
+fn run_scene(sc: &Scene) {
+    let rho = sc.rho;
+    let (truth, tevals, tms) = truth_all(&sc.b, rho, sc.t_end);
+    let tin = truth.iter().filter(|e| e.2 > 0.05 && e.2 < sc.t_end - 0.05).count() as u64;
+    report(sc, "truth", 0, 0, 0, 0, tevals, tin, 0, 0, tms);
+
+    // cone: the adopted window tier over every candidate.
+    let t0 = Instant::now();
+    let cs = cone_pairs(&sc.b, rho);
+    let (ev, st, _) = method_pairs(&sc.b, &cs.pairs, rho, sc.t_end);
+    let ms = t0.elapsed().as_millis();
+    let (missed, false_, _, _) = matchup(&truth, &ev, sc.t_end, 0.05);
+    let ein = ev.iter().filter(|e| e.2 > 0.05 && e.2 < sc.t_end - 0.05).count() as u64;
+    report(sc, "cone", 0, cs.pairs.len() as u64, 0, 0, st.evals, ein, missed, false_, ms);
+
+    // rankk-glb: the dangerous trigger reading — phase rank over ALL bodies.
+    let ids: Vec<u32> = (0..sc.b.len() as u32).collect();
+    let glb = rank_pairs(&sc.b, &ids, K_SIDE);
+    let (ev, st, ms) = method_pairs(&sc.b, &glb, rho, sc.t_end);
+    let (missed, false_, _, _) = matchup(&truth, &ev, sc.t_end, 0.05);
+    let ein = ev.iter().filter(|e| e.2 > 0.05 && e.2 < sc.t_end - 0.05).count() as u64;
+    report(sc, "rankk-glb", 0, glb.len() as u64, 0, 0, st.evals, ein, missed, false_, ms);
+    if missed > 0 {
+        dump_missed(sc, &truth, &ev);
+    }
+
+    // gate: families + intra rank + inter crossing gates.
+    let (ev, evals, events, hits, _util, nfam, ms) = gate_method(&sc.b, rho, sc.t_end, K_SIDE, true);
+    let (missed, false_, _, _) = matchup(&truth, &ev, sc.t_end, 0.05);
+    let ein = ev.iter().filter(|e| e.2 > 0.05 && e.2 < sc.t_end - 0.05).count() as u64;
+    report(sc, "gate", nfam, 0, events, hits, evals, ein, missed, false_, ms);
+    if missed > 0 {
+        dump_missed(sc, &truth, &ev);
+    }
+}
+
+/// Scaling without truth: cone candidates vs gate events/hits as both fleets double.
+fn scale_scene() {
+    let rho = 1e-4;
+    for n_side in [37usize, 75, 150] {
+        let s = 20261008u64;
+        let mut b = fleet(n_side, s + 4, 0.2, 0.0, 0.0, TAU);
+        b.extend(fleet(n_side, s + 5, 0.2, PI / 2.0, 0.0, TAU));
+        let t_end = 20.0 * TAU;
+        let cs = cone_pairs(&b, rho);
+        let (_ev, _e, events, hits, _u, nfam, ms) = gate_method(&b, rho, t_end, K_SIDE, false);
+        println!(
+            "{{\"scene\":\"S5-scale-{}\",\"method\":\"cone|gate\",\"n\":{},\"fams\":{},\"cands\":{},\"events\":{},\"hits\":{},\"evals\":0,\"enc\":0,\"missed\":0,\"false\":0,\"ms\":{}}}",
+            n_side, b.len(), nfam, cs.pairs.len(), events, hits, ms
+        );
+    }
+}
+
+fn main() {
+    let scenes = build_scenes();
+    for sc in &scenes {
+        run_scene(sc);
+    }
+    scale_scene();
+}
