+fn truth_all(b: &[Body], rho: f64, t_end: f64) -> (Vec<Enc>, u64, u128) {
+    let t0 = Instant::now();
+    let pairs = radial_pairs(b, rho);
+    let parts = par_chunks(pairs.len(), 256, THREADS, |r| {
+        let mut out = Vec::new();
+        let mut st = TruthStats::default();
+        let mut tmp = Vec::new();
+        for &(i, j) in &pairs[r] {
+            tmp.clear();
+            truth_pair(&b[i as usize], &b[j as usize], rho, t_end, &mut tmp, &mut st);
+            out.extend(tmp.iter().map(|&(t, d)| (i, j, t, d)));
+        }
+        (out, st)
+    });
+    let mut all = Vec::new();
+    let mut st = TruthStats::default();
+    for (o, s) in parts {
+        all.extend(o);
+        st.add(&s);
+    }
+    (all, st.evals, t0.elapsed().as_millis())
+}
+
+/// (missed, false, matched, dup) against the truth, both restricted to the open horizon.
+fn matchup(truth: &[Enc], meth: &[Enc], t_end: f64, tol: f64) -> (u64, u64, u64, u64) {
+    let inside = |t: f64| t > 0.05 && t < t_end - 0.05;
+    let mut by_pair: std::collections::HashMap<(u32, u32), Vec<f64>> = std::collections::HashMap::new();
+    for e in meth {
+        by_pair.entry((e.0, e.1)).or_default().push(e.2);
+    }
+    let mut tby: std::collections::HashMap<(u32, u32), Vec<f64>> = std::collections::HashMap::new();
+    for e in truth {
+        tby.entry((e.0, e.1)).or_default().push(e.2);
+    }
+    let mut missed = 0u64;
+    let mut matched = 0u64;
+    for e in truth.iter().filter(|e| inside(e.2)) {
+        if by_pair.get(&(e.0, e.1)).is_some_and(|v| v.iter().any(|&t| (t - e.2).abs() < tol)) {
+            matched += 1;
+        } else {
+            missed += 1;
+        }
+    }
+    let mut false_ = 0u64;
+    let mut dup = 0u64;
+    let mut seen: std::collections::HashMap<(u32, u32, i64), u32> = std::collections::HashMap::new();
+    for e in meth.iter().filter(|e| inside(e.2)) {
+        match tby.get(&(e.0, e.1)).and_then(|v| v.iter().find(|&&t| (t - e.2).abs() < tol)) {
+            None => false_ += 1,
+            Some(&t) => {
+                let c = seen.entry((e.0, e.1, (t * 1e6) as i64)).or_insert(0);
+                if *c > 0 {
+                    dup += 1;
+                }
+                *c += 1;
+            }
+        }
+    }
+    (missed, false_, matched, dup)
+}
+
+fn lam0(bd: &Body) -> f64 {
+    (bd.mean_anomaly(0.0) + bd.pom).rem_euclid(TAU)
+}
+
+/// λ at time t.
+fn lam_at(bd: &Body, t: f64) -> f64 {
+    (bd.mean_anomaly(t) + bd.pom).rem_euclid(TAU)
+}
+
+/// Rank partners each way by λ at time t (the certificate's refresh).
+fn rank_pairs_at(b: &[Body], ids: &[u32], k_side: usize, t: f64) -> Vec<(u32, u32)> {
+    let mut v: Vec<(f64, u32)> = ids.iter().map(|&i| (lam_at(&b[i as usize], t), i)).collect();
+    v.sort_by(|x, y| x.0.total_cmp(&y.0));
+    let m = v.len();
+    if m < 2 {
+        return Vec::new();
+    }
+    let k = k_side.min(m - 1);
+    let mut out = Vec::new();
+    for q in 0..m {
+        for d in 1..=k {
+            for &w in &[q + d, q + m - d] {
+                let w = w % m;
+                if v[w].1 != v[q].1 {
+                    out.push((v[q].1.min(v[w].1), v[q].1.max(v[w].1)));
+                }
+            }
+        }
+    }
+    out.sort();
+    out.dedup();
+    out
+}
+
+/// The k_side nearest partners each way by λ(t=0), among `ids`.
+fn rank_pairs(b: &[Body], ids: &[u32], k_side: usize) -> Vec<(u32, u32)> {
+    let mut v: Vec<(f64, u32)> = ids.iter().map(|&i| (lam0(&b[i as usize]), i)).collect();
+    v.sort_by(|x, y| x.0.total_cmp(&y.0));
+    let m = v.len();
+    if m < 2 {
+        return Vec::new();
+    }
+    let k = k_side.min(m - 1);
+    let mut out = Vec::new();
+    for q in 0..m {
+        for d in 1..=k {
+            for &w in &[q + d, q + m - d] {
+                let w = w % m;
+                if v[w].1 != v[q].1 {
+                    out.push((v[q].1.min(v[w].1), v[q].1.max(v[w].1)));
+                }
+            }
+        }
+    }
+    out.sort();
+    out.dedup();
+    out
+}
