diff --git a/crates/universe/examples/alloc_bt.rs b/crates/universe/examples/alloc_bt.rs
new file mode 100644
index 00000000..10721c7c
--- /dev/null
+++ b/crates/universe/examples/alloc_bt.rs
@@ -0,0 +1,286 @@
+//! Names the arrays the player-item allocation census counts (od 6(a) of budget-1e9): the same
+//! scope-attributed flight as `alloc_scope`, plus a sampled size-tagged backtrace on every
+//! alloc/realloc at or above `ES_BT_MIN` bytes (default 2048) inside scopes `ES_BT_SCOPES`
+//! (default "4": the player item; "3" ship, "5" fleet), every `ES_BT_EVERY`-th event (default 4).
+//! At exit, backtraces are symbolized, grouped by their first engine frames, and reported with
+//! per-site size bands — rung starts (2–16 K), the capped ladder's cap (≥ 28,656 B), and chains
+//! past it. `ES_ALLOC_SCOPE=1` arms the engine marker as in alloc_scope.
+//!
+//! cargo run --release -p emergent-universe --example alloc_bt [-- <N> <coast|burn> [<wall s> [<rtf> [<budget ms>]]]]
+
+use emergent_universe::universe::alloc_scope;
+use emergent_universe::universe::Stats;
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::backtrace::Backtrace;
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+const S: usize = 6;
+static ALLOCS: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static BYTES: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static REALLOCS: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static RBYTES: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static TICK: AtomicU64 = AtomicU64::new(0);
+// Exact (unsampled) per-size counts for scope 4: index = size/512 (2 KiB..64 KiB), [+0] alloc, [+128] realloc.
+static EXACT: [AtomicU64; 256] = [const { AtomicU64::new(0) }; 256];
+
+thread_local! {
+    static IN_BT: Cell<bool> = const { Cell::new(false) };
+}
+
+struct Sample {
+    scope: usize,
+    op: u8, // 0 = alloc, 1 = realloc
+    size: usize,
+    bt: Backtrace,
+}
+
+static SAMPLES: Mutex<Option<Vec<Sample>>> = Mutex::new(None);
+
+fn min_size() -> usize {
+    static V: std::sync::LazyLock<usize> =
+        std::sync::LazyLock::new(|| std::env::var("ES_BT_MIN").ok().and_then(|s| s.parse().ok()).unwrap_or(2048));
+    *V
+}
+fn every() -> u64 {
+    static V: std::sync::LazyLock<u64> =
+        std::sync::LazyLock::new(|| std::env::var("ES_BT_EVERY").ok().and_then(|s| s.parse().ok()).unwrap_or(16));
+    *V
+}
+fn scopes() -> std::collections::HashSet<usize> {
+    static V: std::sync::LazyLock<std::collections::HashSet<usize>> = std::sync::LazyLock::new(|| {
+        std::env::var("ES_BT_SCOPES")
+            .unwrap_or_else(|_| "4".into())
+            .split(',')
+            .filter_map(|s| s.parse().ok())
+            .collect()
+    });
+    V.clone()
+}
+
+const MAX_SAMPLES: usize = 400;
+
+fn maybe_sample(scope: usize, op: u8, size: usize) {
+    if scope == 4 && size >= 2048 && size <= 65_536 {
+        EXACT[(size / 512 - 4) + op as usize * 128].fetch_add(1, Ordering::Relaxed);
+    }
+    if size < min_size() || !scopes().contains(&scope) {
+        return;
+    }
+    if TICK.fetch_add(1, Ordering::Relaxed) % every() != 0 {
+        return;
+    }
+    if IN_BT.with(|b| b.get()) {
+        return; // the backtrace machinery itself allocates; never recurse into a sample
+    }
+    if let Ok(g) = SAMPLES.lock() {
+        if g.as_ref().is_some_and(|v| v.len() >= MAX_SAMPLES) {
+            return;
+        }
+    }
+    IN_BT.with(|b| b.set(true));
+    let bt = Backtrace::force_capture();
+    IN_BT.with(|b| b.set(false));
+    if let Ok(mut g) = SAMPLES.lock() {
+        g.get_or_insert_with(Vec::new).push(Sample { scope, op, size, bt });
+    }
+}
+
+struct ScopeAlloc;
+
+unsafe impl GlobalAlloc for ScopeAlloc {
+    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+        let scope = alloc_scope::scope() as usize % S;
+        let p = System.alloc(l);
+        if !p.is_null() {
+            ALLOCS[scope].fetch_add(1, Ordering::Relaxed);
+            BYTES[scope].fetch_add(l.size() as u64, Ordering::Relaxed);
+            maybe_sample(scope, 0, l.size());
+        }
+        p
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+        System.dealloc(p, l)
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: Layout, new: usize) -> *mut u8 {
+        let scope = alloc_scope::scope() as usize % S;
+        let q = System.realloc(p, l, new);
+        if !q.is_null() {
+            REALLOCS[scope].fetch_add(1, Ordering::Relaxed);
+            RBYTES[scope].fetch_add(new as u64, Ordering::Relaxed);
+            maybe_sample(scope, 1, new);
+        }
+        q
+    }
+}
+
+#[global_allocator]
+static A: ScopeAlloc = ScopeAlloc;
+
+fn band(size: usize) -> usize {
+    // 0: [min,4K) rung starts · 1: [4K,16K) rung growth · 2: [16K,28,656) · 3: [28,656, 57,344] the cap · 4: > 57,344 chains
+    match size {
+        s if s < 4096 => 0,
+        s if s < 16384 => 1,
+        s if s < 28_656 => 2,
+        s if s <= 57_344 => 3,
+        _ => 4,
+    }
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(30.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(2000.0);
+    let budget_ms: f64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(12.0);
+    let burn = flight == "burn";
+    let frames = (seconds * 60.0) as usize;
+    assert!(
+        std::env::var("ES_ALLOC_SCOPE").as_deref() == Ok("1"),
+        "run with ES_ALLOC_SCOPE=1"
+    );
+    let seed: u64 = std::env::var("ES_SEED").ok().and_then(|s| s.parse().ok()).unwrap_or(1);
+    let mut p = emergent_universe::scenario::plane_extra(
+        emergent_universe::Config::default(),
+        seed,
+        emergent_universe::fleet::Order::Sparse,
+        1,
+        48,
+        n,
+    )
+    .unwrap();
+    let bodies = p.u.n_bodies();
+    let mut late_stats: Option<(Stats, i64)> = None;
+    let mut last_stats = p.u.stats;
+    let snap = |s: usize| (ALLOCS[s].load(Ordering::Relaxed), BYTES[s].load(Ordering::Relaxed), REALLOCS[s].load(Ordering::Relaxed), RBYTES[s].load(Ordering::Relaxed));
+    let mut snap0 = [snap(0), snap(1), snap(2), snap(3), snap(4), snap(5)];
+    let t0 = p.u.now;
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs(52) {
+            break;
+        }
+        if f == 60 {
+            if burn {
+                let t = p.u.now;
+                let _ = p.u.input(t, emergent_universe::thrust::word(1, 8));
+            }
+            late_stats = Some((p.u.stats, p.u.now));
+            snap0 = [snap(0), snap(1), snap(2), snap(3), snap(4), snap(5)];
+        }
+        let start = Instant::now();
+        let _ = p.u.frame_to(
+            1.0 / 60.0,
+            rtf,
+            emergent_universe::Budget {
+                events: u64::MAX,
+                until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)),
+            },
+            i64::MAX,
+        );
+        last_stats = p.u.stats;
+    }
+    let (s0, t_first) = late_stats.unwrap_or((p.u.stats, t0));
+    let game_s = (p.u.now - t_first) as f64 * emergent_universe::view::TICK_SECONDS;
+    let (kicks, items): (u64, Vec<u64>) = (
+        last_stats.kicks - s0.kicks,
+        (0..5).map(|c| last_stats.items[c] - s0.items[c]).collect(),
+    );
+    println!(
+        "alloc_bt: N={n} bodies={bodies} {flight} seed={seed} rtf={rtf} game_s={game_s:.0} kicks={kicks} items={items:?} samples={}",
+        SAMPLES.lock().map(|g| g.as_ref().map_or(0, |v| v.len())).unwrap_or(0)
+    );
+    let p_items = items[3].max(1) as f64;
+    for s in 0..S {
+        let (a, b, r, rb) = snap(s);
+        let (a0, b0, r0, rb0) = snap0[s];
+        let (da, db, dr, drb) = (a - a0, b - b0, r - r0, rb - rb0);
+        if da + dr == 0 {
+            continue;
+        }
+        println!(
+            "scope {s}: allocs {da}, bytes {db} ({:.1} KB), reallocs {dr}, realloc bytes {drb} ({:.1} KB)",
+            db as f64 / 1e3,
+            drb as f64 / 1e3
+        );
+        if s == 4 {
+            println!(
+                "player term: {:.1} KB/item over {p_items} items",
+                (db + drb) as f64 / 1e3 / p_items
+            );
+        }
+    }
+    println!("exact scope-4 size census (size B: allocs, reallocs):");
+    for (i, c) in EXACT.iter().enumerate().take(128) {
+        let (a, r) = (c.load(Ordering::Relaxed), EXACT[i + 128].load(Ordering::Relaxed));
+        if a + r > 0 {
+            println!("  {:>6}: {:>7} a, {:>7} r", (i + 4) * 512, a, r);
+        }
+    }
+    // Symbolize a few samples per size band (std's symbolizer is ~0.5 s/trace with full debuginfo —
+    // naming needs the dominant site per band, not every sample; exact band counts come from
+    // alloc_scope's census). Each picked sample stands for its band's share of sampled events.
+    let samples = SAMPLES.lock().ok().and_then(|mut g| g.take()).unwrap_or_default();
+    let mut per_band: [Vec<&Sample>; 5] = [const { Vec::new() }; 5];
+    for s in &samples {
+        per_band[band(s.size)].push(s);
+    }
+
+    // Pick per exact size (families interleave per item: a per-band take misses whole families).
+    let mut seen_sizes: HashMap<usize, usize> = HashMap::new();
+    let mut picked: Vec<&Sample> = Vec::new();
+    for s in &samples {
+        let c = seen_sizes.entry(s.size).or_insert(0);
+        if *c < 3 {
+            picked.push(s);
+            *c += 1;
+        }
+    }
+    eprintln!("symbolizing {}/{} samples, {} distinct sizes", picked.len(), samples.len(), seen_sizes.len());
+    let mut groups: HashMap<String, (u64, u64, usize, usize, usize, [u64; 5], [u64; 5], u64, u64)> = HashMap::new();
+    let t_sym = Instant::now();
+    for (i, s) in picked.iter().enumerate() {
+        eprintln!("sym {}/{}: band {} size {}", i + 1, picked.len(), band(s.size), s.size);
+        let text = format!("{:?}", s.bt);
+        // The Debug output is one line of { fn, file, line } records: the signature is the
+        // first engine frames after the allocator machinery — the naming information itself.
+        let frames: Vec<String> = text
+            .split("}, ")
+            .filter(|f: &&str| f.contains("/crates/") && !f.contains("alloc_bt.rs"))
+            .map(|f: &str| f.trim_start_matches("{ ").trim_end_matches('}').to_string())
+            .take(5)
+            .collect();
+        let key = if frames.is_empty() { format!("UNRESOLVED size {}", s.size) } else { frames.join(" ;; ") };
+        let stand = 1u64; // picked per exact size; groups are site names, not statistics
+        let e = groups.entry(key).or_insert((0, 0, usize::MAX, 0, 0, [0; 5], [0; 5], 0, 0));
+        e.0 += stand;
+        e.1 += s.size as u64 * stand;
+        e.2 = e.2.min(s.size);
+        e.4 = e.4.max(s.size);
+        let b = band(s.size);
+        e.5[b] += stand;
+        e.6[b] += s.size as u64 * stand;
+        if s.op == 1 {
+            e.8 += stand;
+        } else {
+            e.7 += stand;
+        }
+    }
+    let mut rows: Vec<_> = groups.into_iter().collect();
+    rows.sort_by(|a, b| b.1 .1.cmp(&a.1 .1));
+    println!("site census (symbolization {:.1} s; bands: 0=[min,4K) 1=[4K,16K) 2=[16K,28.6K) 3=[28.6K,57.3K]=cap 4=>57.3K chains):", t_sym.elapsed().as_secs_f64());
+    for (i, (k, (n, bytes, min, _mid, max, counts, byte_counts, na, nr))) in rows.iter().take(24).enumerate() {
+        println!(
+            "#{i} n={n} ({na}a/{nr}r) bytes={bytes} min={min} max={max} bands c={counts:?} b={:?}",
+            byte_counts.iter().map(|x| x / 1024).collect::<Vec<_>>()
+        );
+        for line in k.split(" ;; ").take(5) {
+            println!("    {line}");
+        }
+    }
+}
diff --git a/crates/universe/examples/alloc_scope.rs b/crates/universe/examples/alloc_scope.rs
new file mode 100644
index 00000000..816dcccf
--- /dev/null
+++ b/crates/universe/examples/alloc_scope.rs
@@ -0,0 +1,248 @@
+//! The fired item's own allocation scope, attributed by the allocator itself (never through
+//! budget-coupled windows). Runs the shipped `nladder` flight verbatim; `ES_ALLOC_SCOPE=1` arms
+//! the engine's scope marker (universe.rs `alloc_scope`), this probe's counting `GlobalAlloc`
+//! attributes every alloc/free/realloc to the outermost scope it happens in: 0 = the frame's
+//! base, 1..=5 = inside the fired item of that class (planet, moon, ship, player, fleet;
+//! nested items stay in the outermost item). Per-frame deltas go to a CSV (`ES_ALLOC_CSV=path`),
+//! the census of call sizes to stdout. Off (`ES_ALLOC_SCOPE` unset) the flight is the shipped one.
+//!
+//! cargo run --release -p emergent-universe --example alloc_scope [-- <N> <coast|burn> [<wall seconds> [<rtf> [<engine budget ms>]]]]
+
+use emergent_universe::universe::alloc_scope;
+use emergent_universe::universe::Stats;
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::fs::File;
+use std::io::Write;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+
+/// scope 0 = frame base, 1..=5 = fired item of class scope-1. Buckets are power-of-two sizes.
+const S: usize = 6;
+const B: usize = 34; // 2^0 .. 2^33 bytes
+static ALLOCS: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static BYTES: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static FREES: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static FREED: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static REALLOCS: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static RBYTES: [AtomicU64; S] = [const { AtomicU64::new(0) }; S];
+static BCOUNT: std::sync::LazyLock<[[AtomicU64; B]; S]> =
+    std::sync::LazyLock::new(|| std::array::from_fn(|_| std::array::from_fn(|_| AtomicU64::new(0))));
+static BBYTES: std::sync::LazyLock<[[AtomicU64; B]; S]> =
+    std::sync::LazyLock::new(|| std::array::from_fn(|_| std::array::from_fn(|_| AtomicU64::new(0))));
+
+fn bucket(size: usize) -> usize {
+    (usize::BITS - 1 - size.leading_zeros()) as usize
+}
+
+struct ScopeAlloc;
+
+unsafe impl GlobalAlloc for ScopeAlloc {
+    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+        let p = System.alloc(l);
+        if !p.is_null() {
+            let s = alloc_scope::scope() as usize % S;
+            ALLOCS[s].fetch_add(1, Ordering::Relaxed);
+            BYTES[s].fetch_add(l.size() as u64, Ordering::Relaxed);
+            let b = bucket(l.size()).min(B - 1);
+            BCOUNT[s][b].fetch_add(1, Ordering::Relaxed);
+            BBYTES[s][b].fetch_add(l.size() as u64, Ordering::Relaxed);
+        }
+        p
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+        let s = alloc_scope::scope() as usize % S;
+        FREES[s].fetch_add(1, Ordering::Relaxed);
+        FREED[s].fetch_add(l.size() as u64, Ordering::Relaxed);
+        System.dealloc(p, l)
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: Layout, new: usize) -> *mut u8 {
+        let q = System.realloc(p, l, new);
+        if !q.is_null() {
+            let s = alloc_scope::scope() as usize % S;
+            REALLOCS[s].fetch_add(1, Ordering::Relaxed);
+            RBYTES[s].fetch_add(new as u64, Ordering::Relaxed);
+            let b = bucket(new).min(B - 1);
+            BCOUNT[s][b].fetch_add(1, Ordering::Relaxed);
+            BBYTES[s][b].fetch_add(new as u64, Ordering::Relaxed);
+        }
+        q
+    }
+}
+
+#[global_allocator]
+static A: ScopeAlloc = ScopeAlloc;
+
+#[derive(Clone, Copy)]
+struct Snap {
+    allocs: [u64; S],
+    bytes: [u64; S],
+    frees: [u64; S],
+    freed: [u64; S],
+    reallocs: [u64; S],
+    rbytes: [u64; S],
+}
+
+fn snap() -> Snap {
+    let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+    Snap {
+        allocs: std::array::from_fn(|i| g(&ALLOCS[i])),
+        bytes: std::array::from_fn(|i| g(&BYTES[i])),
+        frees: std::array::from_fn(|i| g(&FREES[i])),
+        freed: std::array::from_fn(|i| g(&FREED[i])),
+        reallocs: std::array::from_fn(|i| g(&REALLOCS[i])),
+        rbytes: std::array::from_fn(|i| g(&RBYTES[i])),
+    }
+}
+
+const CLASS: [&str; S] = ["base(frame)", "planet", "moon", "ship", "player", "fleet/handout"];
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "coast".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(10.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms: f64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(12.0);
+    let burn = flight == "burn";
+    let frames = (seconds * 60.0) as usize;
+    assert!(
+        std::env::var("ES_ALLOC_SCOPE").as_deref() == Ok("1"),
+        "run with ES_ALLOC_SCOPE=1 (and ES_ALLOC_CSV=path)"
+    );
+    // Disclosed addition over 8994's instrument: env-gated seed override (default 1 = shipped bits).
+    let seed: u64 = std::env::var("ES_SEED").ok().and_then(|s| s.parse().ok()).unwrap_or(1);
+    let mut csv = std::env::var("ES_ALLOC_CSV").ok().map(|p| File::create(p).unwrap());
+    if let Some(f) = csv.as_mut() {
+        writeln!(f, "frame,ms,events,gs_now,base_a,base_b,base_rb,item_a,item_b,item_rb,player_a,player_b,player_rb").unwrap();
+    }
+    let t0 = Instant::now();
+    let mut p = emergent_universe::scenario::plane_extra(
+        emergent_universe::Config::default(),
+        seed,
+        emergent_universe::fleet::Order::Sparse,
+        1,
+        48,
+        n,
+    )
+    .unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let bodies = p.u.n_bodies();
+    let mut late_stats: Option<(Stats, i64)> = None;
+    let mut last_stats = p.u.stats;
+    let mut snap0 = snap();
+    let mut prev = snap();
+    let mut ran = 0usize;
+    let mut peak_item_frame = (0u64, 0usize); // (bytes, frame)
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs(52) {
+            break;
+        }
+        if f == 60 {
+            if burn {
+                let t = p.u.now;
+                let _ = p.u.input(t, emergent_universe::thrust::word(1, 8));
+            }
+            late_stats = Some((p.u.stats, p.u.now));
+            snap0 = snap();
+        }
+        let start = Instant::now();
+        let frame = p.u.frame_to(
+            1.0 / 60.0,
+            rtf,
+            emergent_universe::Budget {
+                events: u64::MAX,
+                until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)),
+            },
+            i64::MAX,
+        );
+        let took = start.elapsed();
+        let now = snap();
+        if f >= 60 {
+            let d = |a: u64, b: u64| b - a;
+            let (ba, bb) = (d(prev.allocs[0], now.allocs[0]), d(prev.bytes[0], now.bytes[0]));
+            let (ia, ib) = (
+                d(prev.allocs[1], now.allocs[1]) + d(prev.allocs[2], now.allocs[2]) + d(prev.allocs[3], now.allocs[3]) + d(prev.allocs[5], now.allocs[5]),
+                d(prev.bytes[1], now.bytes[1]) + d(prev.bytes[2], now.bytes[2]) + d(prev.bytes[3], now.bytes[3]) + d(prev.bytes[5], now.bytes[5]),
+            );
+            let (pa, pb) = (d(prev.allocs[4], now.allocs[4]), d(prev.bytes[4], now.bytes[4]));
+            let (brb, irb, prb) = (d(prev.rbytes[0], now.rbytes[0]), d(prev.rbytes[1], now.rbytes[1]) + d(prev.rbytes[2], now.rbytes[2]) + d(prev.rbytes[3], now.rbytes[3]) + d(prev.rbytes[5], now.rbytes[5]), d(prev.rbytes[4], now.rbytes[4]));
+            if ib + pb + irb + prb > peak_item_frame.0 {
+                peak_item_frame = (ib + pb + irb + prb, f);
+            }
+            if let Some(fw) = csv.as_mut() {
+                writeln!(
+                    fw,
+                    "{},{:.3},{},{},{},{},{},{},{},{},{},{},{}",
+                    f,
+                    took.as_secs_f64() * 1e3,
+                    frame.events,
+                    p.u.now,
+                    ba,
+                    bb,
+                    brb,
+                    ia,
+                    ib,
+                    irb,
+                    pa,
+                    pb,
+                    prb
+                )
+                .unwrap();
+            }
+        }
+        prev = now;
+        last_stats = p.u.stats;
+        ran += 1;
+    }
+    let end = snap();
+    let (s0, t_first) = late_stats.unwrap_or((p.u.stats, p.u.now));
+    let game_s = (p.u.now - t_first) as f64 * emergent_universe::view::TICK_SECONDS;
+    let (kicks, evs) = (last_stats.kicks - s0.kicks, last_stats.events() - s0.events());
+    let items: Vec<u64> = (0..5).map(|c| last_stats.items[c] - s0.items[c]).collect();
+    let tot_items: u64 = items.iter().sum();
+    println!(
+        "alloc_scope: N={n} bodies={bodies} {flight} rtf={rtf} frames={ran} build_s={build:.2} game_s={game_s:.0} kicks={kicks} events={evs} items={items:?} peak_item_frame={:?}",
+        peak_item_frame
+    );
+    let item_bytes: u64 = (1..S).map(|s| end.bytes[s] - snap0.bytes[s] + end.rbytes[s] - snap0.rbytes[s]).sum();
+    let (base_a, base_rb): (u64, u64) = (end.bytes[0] - snap0.bytes[0], end.rbytes[0] - snap0.rbytes[0]);
+    println!(
+        "per fired kick: item-scope {:.2} KB alloc'd, base {:.2} KB/game-s; per fired item (any class): item-scope {:.2} KB",
+        item_bytes as f64 / kicks as f64 / 1e3,
+        (base_a + base_rb) as f64 / game_s.max(1.0) / 1e3,
+        item_bytes as f64 / tot_items.max(1) as f64 / 1e3,
+    );
+    for s in 0..S {
+        let (a, b) = (end.allocs[s] - snap0.allocs[s], end.bytes[s] - snap0.bytes[s]);
+        if a == 0 && b == 0 {
+            continue;
+        }
+        println!(
+            "scope {:>13} ({}): allocs {a}, bytes {b} ({:.1} KB), frees {}, freed {} KB, reallocs {}",
+            CLASS[s],
+            s,
+            b as f64 / 1e3,
+            end.frees[s] - snap0.frees[s],
+            (end.freed[s] - snap0.freed[s]) as f64 / 1e3,
+            end.reallocs[s] - snap0.reallocs[s],
+        );
+        println!(
+            "scope {:>13} ({}): realloc bytes {} ({:.1} KB)",
+            CLASS[s],
+            s,
+            end.rbytes[s] - snap0.rbytes[s],
+            (end.rbytes[s] - snap0.rbytes[s]) as f64 / 1e3
+        );
+    }
+    println!("size census (bucket, class): count, bytes, mean B — only buckets with bytes");
+    for s in 0..S {
+        for b in 0..B {
+            let c = BCOUNT[s][b].load(Ordering::Relaxed);
+            let by = BBYTES[s][b].load(Ordering::Relaxed);
+            if c > 0 && (1usize << b) >= 2048 {
+                println!("  {:>6} B {:>13}: {:>8} calls, {:>10} bytes, mean {:>8.0} B", 1usize << b, CLASS[s], c, by, by as f64 / c as f64);
+            }
+        }
+    }
+}
