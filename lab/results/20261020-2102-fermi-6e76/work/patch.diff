+            },
+            i64::MAX,
+        );
+        let took = start.elapsed();
+        let now = snap();
+        if f >= 60 {
+            let d = |a: u64, b: u64| b - a;
+            let (ba, bb) = (d(prev.allocs[0], now.allocs[0]), d(prev.bytes[0], now.bytes[0]));
+            let (ia, ib) = (
+                d(prev.allocs[1], now.allocs[1]) + d(prev.allocs[2], now.allocs[2]) + d(prev.allocs[3], now.allocs[3]) + d(prev.allocs[5], now.allocs[5]),
+                d(prev.bytes[1], now.bytes[1]) + d(prev.bytes[2], now.bytes[2]) + d(prev.bytes[3], now.bytes[3]) + d(prev.bytes[5], now.bytes[5]),
+            );
+            let (pa, pb) = (d(prev.allocs[4], now.allocs[4]), d(prev.bytes[4], now.bytes[4]));
+            let (brb, irb, prb) = (d(prev.rbytes[0], now.rbytes[0]), d(prev.rbytes[1], now.rbytes[1]) + d(prev.rbytes[2], now.rbytes[2]) + d(prev.rbytes[3], now.rbytes[3]) + d(prev.rbytes[5], now.rbytes[5]), d(prev.rbytes[4], now.rbytes[4]));
+            if ib + pb + irb + prb > peak_item_frame.0 {
+                peak_item_frame = (ib + pb + irb + prb, f);
+            }
+            if let Some(fw) = csv.as_mut() {
+                writeln!(
+                    fw,
+                    "{},{:.3},{},{},{},{},{},{},{},{},{},{},{}",
+                    f,
+                    took.as_secs_f64() * 1e3,
+                    frame.events,
+                    p.u.now,
+                    ba,
+                    bb,
+                    brb,
+                    ia,
+                    ib,
+                    irb,
+                    pa,
+                    pb,
+                    prb
+                )
+                .unwrap();
+            }
+        }
+        prev = now;
+        last_stats = p.u.stats;
+        ran += 1;
+    }
+    let end = snap();
+    let (s0, t_first) = late_stats.unwrap_or((p.u.stats, p.u.now));
+    let game_s = (p.u.now - t_first) as f64 * emergent_universe::view::TICK_SECONDS;
+    let (kicks, evs) = (last_stats.kicks - s0.kicks, last_stats.events() - s0.events());
+    let items: Vec<u64> = (0..5).map(|c| last_stats.items[c] - s0.items[c]).collect();
+    let tot_items: u64 = items.iter().sum();
+    println!(
+        "alloc_scope: N={n} bodies={bodies} {flight} rtf={rtf} frames={ran} build_s={build:.2} game_s={game_s:.0} kicks={kicks} events={evs} items={items:?} peak_item_frame={:?}",
+        peak_item_frame
+    );
+    let item_bytes: u64 = (1..S).map(|s| end.bytes[s] - snap0.bytes[s] + end.rbytes[s] - snap0.rbytes[s]).sum();
+    let (base_a, base_rb): (u64, u64) = (end.bytes[0] - snap0.bytes[0], end.rbytes[0] - snap0.rbytes[0]);
+    println!(
+        "per fired kick: item-scope {:.2} KB alloc'd, base {:.2} KB/game-s; per fired item (any class): item-scope {:.2} KB",
+        item_bytes as f64 / kicks as f64 / 1e3,
+        (base_a + base_rb) as f64 / game_s.max(1.0) / 1e3,
+        item_bytes as f64 / tot_items.max(1) as f64 / 1e3,
+    );
+    for s in 0..S {
+        let (a, b) = (end.allocs[s] - snap0.allocs[s], end.bytes[s] - snap0.bytes[s]);
+        if a == 0 && b == 0 {
+            continue;
+        }
+        println!(
+            "scope {:>13} ({}): allocs {a}, bytes {b} ({:.1} KB), frees {}, freed {} KB, reallocs {}",
+            CLASS[s],
+            s,
+            b as f64 / 1e3,
+            end.frees[s] - snap0.frees[s],
+            (end.freed[s] - snap0.freed[s]) as f64 / 1e3,
+            end.reallocs[s] - snap0.reallocs[s],
+        );
+        println!(
+            "scope {:>13} ({}): realloc bytes {} ({:.1} KB)",
+            CLASS[s],
+            s,
+            end.rbytes[s] - snap0.rbytes[s],
+            (end.rbytes[s] - snap0.rbytes[s]) as f64 / 1e3
+        );
+    }
+    println!("size census (bucket, class): count, bytes, mean B — only buckets with bytes");
+    for s in 0..S {
+        for b in 0..B {
+            let c = BCOUNT[s][b].load(Ordering::Relaxed);
+            let by = BBYTES[s][b].load(Ordering::Relaxed);
+            if c > 0 && (1usize << b) >= 2048 {
+                println!("  {:>6} B {:>13}: {:>8} calls, {:>10} bytes, mean {:>8.0} B", 1usize << b, CLASS[s], c, by, by as f64 / c as f64);
+            }
+        }
+    }
+}
