+/// The gold's fleet scenario: 400-ship formation in a 3600-body sea, 20 orbits. No full truth
+/// (quadratic); the train's cost and the pairwise setup cost on a sample of intra-fleet pairs.
+fn train_cost() {
+    let rho = 1e-4;
+    let orbits = 20.0;
+    let t_end = orbits * TAU;
+    let fl = fleet(400, 1e-5, 0.0, 11, 0.001, 0.01, 0.1);
+    let mut b = fl.clone();
+    b.extend(sea(3600, 11));
+    let srt = Sorted::new(&b, rho);
+    let d_c = 8.0 * srt.eps_max;
+    let t0 = Instant::now();
+    let cs = emergent_encounters::train::clumps(&b, d_c);
+    let clump_s = t0.elapsed().as_secs_f64();
+    let mut st = emergent_encounters::train::TrainStats::default();
+    let mut train: Vec<Enc> = Vec::new();
+    let t1 = Instant::now();
+    for c in &cs {
+        let z = emergent_encounters::train::zeta(&b, c, rho);
+        if z < 1.0 {
+            st.fired += 1;
+            emergent_encounters::train::train_events(&b, c, rho, 0.0, t_end, &mut st, &mut train);
+        } else {
+            st.declined += 1;
+        }
+    }
+    let train_s = t1.elapsed().as_secs_f64();
+    // pairwise setup+run on a sample of the fleet's internal pairs (the gold sampled 2494)
+    let mut ff: Vec<(u32, u32)> = Vec::new();
+    for i in 0..400u32 {
+        for j in (i + 1)..400u32 {
+            ff.push((i, j));
+        }
+    }
+    let stride = ff.len().div_ceil(2500).max(1);
+    let sample: Vec<(u32, u32)> = ff.iter().step_by(stride).copied().collect();
+    let t2 = Instant::now();
+    let mut ms = Stats::default();
+    let mut setup_evals = 0u64;
+    let mut kinds = [0u64; 3];
+    let mut tmp = Vec::new();
+    for &(i, j) in &sample {
+        let mut ev = 0u64;
+        for sec in sections(&fl[i as usize], &fl[j as usize], rho, SAFETY, &mut ev) {
+            kinds[sec.kind as usize] += 1;
+            tmp.clear();
+            run_section(&fl[i as usize], &fl[j as usize], &sec, rho, 0.0, t_end, &mut ms, &mut tmp);
+        }
+        ms.evals += ev;
+        setup_evals += ev;
+    }
+    let meth_s = t2.elapsed().as_secs_f64();
+    let meth_hits = ms.hits_total();
+    println!(
+        "{{\"exp\":\"train-cost\",\"scene\":\"fleet-400-sea-3600\",\"rho\":{},\"orbits\":{},\"clumps\":{},\"clump_s\":{:.3},\"fired\":{},\"declined\":{},\"train\":{{\"watched\":{},\"cone_filtered\":{},\"queries\":{},\"qsteps\":{},\"equal_p\":{},\"windows\":{},\"evals\":{},\"events\":{},\"s\":{:.3}}},\"pairwise_sample\":{{\"pairs\":{},\"of\":{},\"kinds\":{:?},\"setup_evals\":{},\"run_evals\":{},\"hits\":{},\"s\":{:.3}}},\"train_evals_per_event\":{:.1},\"extrapolated_pairwise_evals_per_event\":{:.0},\"watched_vs_all_pairs\":{:.6}}}",
+        rho, orbits, cs.len(), clump_s, st.fired, st.declined,
+        st.watched, st.cone_filtered, st.queries, st.qsteps, st.equal_p, st.windows, st.evals, st.events, train_s,
+        sample.len(), ff.len(), kinds, setup_evals, ms.evals - setup_evals, meth_hits, meth_s,
+        st.evals as f64 / st.events.max(1) as f64,
+        (setup_evals + ms.evals) as f64 * (ff.len() as f64 / sample.len() as f64) / meth_hits.max(1) as f64,
+        st.watched as f64 / ff.len() as f64
+    );
+}
