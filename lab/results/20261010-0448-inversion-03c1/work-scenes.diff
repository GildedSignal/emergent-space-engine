+/// Fragmentation: which share of a fleet's pairs the train actually certifies (inside a fired
+/// clump) versus leaves to the pairwise tier, and what that tier pays on a sample there.
+fn frag(nc: usize, e_s: f64, e_cap: f64, pom_s: f64, seed: u64, orbits: f64) {
+    let rho = 1e-4;
+    let b = fleet(nc, 1e-5, 0.0, seed, e_s, e_cap, pom_s);
+    let srt = Sorted::new(&b, rho);
+    let d_c = 8.0 * srt.eps_max;
+    let cs = emergent_encounters::train::clumps(&b, d_c);
+    let mut in_clump = vec![false; b.len()];
+    let mut intra = 0u64;
+    let mut fired_intra = 0u64;
+    for c in &cs {
+        for &i in c {
+            in_clump[i as usize] = true;
+        }
+        intra += c.len() as u64 * (c.len() as u64 - 1) / 2;
+        if emergent_encounters::train::zeta(&b, c, rho) < 1.0 {
+            fired_intra += c.len() as u64 * (c.len() as u64 - 1) / 2;
+        }
+    }
+    let all = nc as u64 * (nc as u64 - 1) / 2;
+    let cross = all - intra;
+    let mut cand: Vec<(u32, u32)> = Vec::new();
+    for i in 0..nc as u32 {
+        for j in (i + 1)..nc as u32 {
+            if in_clump[i as usize] && in_clump[j as usize] {
+                continue;
+            }
+            cand.push((i, j));
+        }
+    }
+    let admitted: u64 = cand.iter().filter(|&&(i, j)| is_candidate(&b[i as usize], &b[j as usize], rho)).count() as u64;
+    let stride = cand.len().div_ceil(2000).max(1);
+    let sample: Vec<(u32, u32)> = cand.iter().step_by(stride).copied().collect();
+    let t0 = Instant::now();
+    let mut setup_evals = 0u64;
+    let mut kinds = [0u64; 3];
+    for &(i, j) in &sample {
+        let mut ev = 0u64;
+        for sec in sections(&b[i as usize], &b[j as usize], rho, SAFETY, &mut ev) {
+            kinds[sec.kind as usize] += 1;
+        }
+        setup_evals += ev;
+    }
+    let sample_s = t0.elapsed().as_secs_f64();
+    println!(
+        "{{\"exp\":\"frag\",\"n\":{},\"e_s\":{},\"pom_s\":{},\"seed\":{},\"eps_max\":{:.2e},\"d_c\":{:.2e},\"clumps\":{},\"clump_max\":{},\"intra\":{},\"fired_intra\":{},\"cross\":{},\"all\":{},\"certified_share\":{:.6},\"cross_cone_admitted\":{},\"cross_sample\":{{\"pairs\":{},\"setup_evals\":{},\"kinds\":{:?},\"s\":{:.3}}},\"setup_us_per_cross_pair\":{:.3}}}",
+        nc, e_s, pom_s, seed, srt.eps_max, d_c, cs.len(), cs.iter().map(|c| c.len()).max().unwrap_or(0), intra, fired_intra, cross, all,
+        fired_intra as f64 / all as f64, admitted, sample.len(), setup_evals, kinds, sample_s,
+        sample_s * 1e6 / sample.len().max(1) as f64
+    );
+    let _ = cross;
+}
+
+fn frag_all() {
+    frag(600, 0.001, 0.01, 0.1, 51, 2.0);
+    frag(600, 0.005, 0.05, 0.1, 52, 2.0);
+    frag(600, 0.02, 0.3, 0.1, 53, 2.0);
+    frag(600, 0.05, 0.6, 0.1, 54, 2.0);
+    frag(600, 0.25, 0.85, 0.1, 55, 2.0);
+}
