+/// One scene: truth over every intra-clump pair of fired clumps (r8's construction), the train,
+/// and the pairwise method on the same pairs, matched up both ways.
+fn train_scene(name: &str, b: &[Body], rho: f64, orbits: f64) {
+    let t_end = orbits * TAU;
+    let srt = Sorted::new(b, rho);
+    let d_c = 8.0 * srt.eps_max;
+    let t0 = Instant::now();
+    let cs = emergent_encounters::train::clumps(b, d_c);
+    let clump_s = t0.elapsed().as_secs_f64();
+    let mut st = emergent_encounters::train::TrainStats::default();
+    let mut train: Vec<Enc> = Vec::new();
+    let mut pairs: Vec<(u32, u32)> = Vec::new();
+    let (mut z_sum, mut z_max, mut fired_nc) = (0.0f64, 0.0f64, 0u64);
+    let t1 = Instant::now();
+    for c in &cs {
+        let z = emergent_encounters::train::zeta(b, c, rho);
+        z_sum += z;
+        z_max = z_max.max(z);
+        if z < 1.0 {
+            st.fired += 1;
+            fired_nc += c.len() as u64;
+            emergent_encounters::train::train_events(b, c, rho, 0.0, t_end, &mut st, &mut train);
+            for w in 0..c.len() {
+                for v in (w + 1)..c.len() {
+                    pairs.push((c[w].min(c[v]), c[w].max(c[v])));
+                }
+            }
+        } else {
+            st.declined += 1;
+        }
+    }
+    let train_s = t1.elapsed().as_secs_f64();
+    let t2 = Instant::now();
+    let parts = par_chunks(pairs.len(), 256, THREADS, |r| {
+        let mut out = Vec::new();
+        let mut tst = TruthStats::default();
+        let mut tmp = Vec::new();
+        for &(i, j) in &pairs[r] {
+            tmp.clear();
+            truth_pair(&b[i as usize], &b[j as usize], rho, t_end, &mut tmp, &mut tst);
+            out.extend(tmp.iter().map(|&(t, d)| (i, j, t, d)));
+        }
+        (out, tst)
+    });
+    let mut truth: Vec<Enc> = Vec::new();
+    let mut tst = TruthStats::default();
+    for (o, s) in parts {
+        truth.extend(o);
+        tst.add(&s);
+    }
+    let truth_s = t2.elapsed().as_secs_f64();
+    let t3 = Instant::now();
+    let parts = par_chunks(pairs.len(), 256, THREADS, |r| {
+        let mut out = Vec::new();
+        let mut ms = Stats::default();
+        let mut tmp = Vec::new();
+        for &(i, j) in &pairs[r] {
+            tmp.clear();
+            pair_events(&b[i as usize], &b[j as usize], rho, SAFETY, 0.0, t_end, &mut ms, &mut tmp);
+            out.extend(tmp.iter().map(|&(t, d)| (i, j, t, d)));
+        }
+        (out, ms)
+    });
+    let mut meth: Vec<Enc> = Vec::new();
+    let mut ms = Stats::default();
+    for (o, s) in parts {
+        meth.extend(o);
+        ms.add(&s);
+    }
+    let meth_s = t3.elapsed().as_secs_f64();
+    let (tm, tf, _, td) = matchup(&truth, &train, t_end, 1e-3);
+    let (mm, mf, _, md) = matchup(&truth, &meth, t_end, 1e-3);
+    println!(
+        "{{\"exp\":\"train-verify\",\"scene\":\"{}\",\"n\":{},\"rho\":{},\"orbits\":{},\"clumps\":{},\"fired\":{},\"declined\":{},\"fired_nc\":{},\"zeta_mean\":{:.4},\"zeta_max\":{:.4},\"pairs\":{},\"clump_s\":{:.3},\"train\":{{\"watched\":{},\"cone_filtered\":{},\"queries\":{},\"qsteps\":{},\"equal_p\":{},\"windows\":{},\"evals\":{},\"events\":{},\"missed\":{},\"false\":{},\"dup\":{},\"s\":{:.3}}},\"truth\":{{\"enc\":{},\"steps\":{},\"fine\":{},\"evals\":{},\"s\":{:.3}}},\"method\":{{\"events\":{},\"missed\":{},\"false\":{},\"dup\":{},\"evals\":{},\"s\":{:.3}}},\"train_evals_per_enc\":{:.1},\"meth_evals_per_enc\":{:.1}}}",
+        name, b.len(), rho, orbits, cs.len(), st.fired, st.declined, fired_nc, z_sum / cs.len().max(1) as f64, z_max,
+        pairs.len(), clump_s,
+        st.watched, st.cone_filtered, st.queries, st.qsteps, st.equal_p, st.windows, st.evals, st.events, tm.len(), tf.len(), td, train_s,
+        truth.len(), tst.steps, tst.fine, tst.evals, truth_s,
+        meth.len(), mm.len(), mf.len(), md, ms.evals, meth_s,
+        st.evals as f64 / truth.len().max(1) as f64, ms.evals as f64 / truth.len().max(1) as f64
+    );
+    if !tm.is_empty() {
+        println!("  {{\"train_missed_sample\":{:?}}}", &tm[..tm.len().min(4)]);
+    }
+    if !mm.is_empty() {
+        println!("  {{\"method_missed_sample\":{:?}}}", &mm[..mm.len().min(4)]);
+    }
+}
+
+fn lam_of(b: &Body) -> f64 {
+    b.mean_anomaly(0.0) + b.pom
+}
