+fn rayleigh(rng: &mut emergent_encounters::belt::Rng, s: f64, cap: f64) -> f64 {
+    let u = rng.f64();
+    (s * (-2.0 * (1.0 - u).ln()).sqrt()).min(cap)
+}
+
+/// The gold run's formation generator, bit for bit (same RNG draw order as taleb.rs).
+fn fleet(nc: usize, a_hw: f64, sig_lam: f64, seed: u64, e_s: f64, e_cap: f64, pom_s: f64) -> Vec<Body> {
+    let mut rng = emergent_encounters::belt::Rng(seed);
+    let pom0 = TAU * rng.f64();
+    let lam0 = TAU * rng.f64();
+    (0..nc)
+        .map(|_| {
+            let a = 1.0 + (2.0 * rng.f64() - 1.0) * a_hw;
+            let e = rayleigh(&mut rng, e_s, e_cap);
+            let pom = pom0 + (2.0 * rng.f64() - 1.0) * pom_s;
+            let lam = if sig_lam <= 0.0 {
+                TAU * rng.f64()
+            } else {
+                let (u1, u2) = (rng.f64(), rng.f64());
+                let z = (-2.0 * (1e-12 + u1).ln()).sqrt() * (TAU * u2).cos();
+                lam0 + sig_lam * z
+            };
+            Body::new(a, e, pom, lam)
+        })
+        .collect()
+}
+
+fn sea(n: usize, seed: u64) -> Vec<Body> {
+    let mut rng = emergent_encounters::belt::Rng(seed ^ 0x5a5a);
+    (0..n)
+        .map(|_| Body::new(0.9 + 0.2 * rng.f64(), rayleigh(&mut rng, 0.05, 0.5), TAU * rng.f64(), TAU * rng.f64()))
+        .collect()
+}
