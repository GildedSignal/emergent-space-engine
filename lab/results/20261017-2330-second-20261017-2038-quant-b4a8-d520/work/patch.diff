+/// The belt's draw: the span of its semi-major axes (root units at 2^-8 each) and the Rayleigh scale of its
+/// eccentricities in milli, with optional quantization onto `classes` shared exact axes and `e_levels` shared
+/// exact eccentricities (the compact store's shared exact periods: same (a, e) ⇒ same clock constants ⇒ same
+/// step). The shipped ladder belt is [`BeltDraw::SHIPPED`].
+#[derive(Clone, Copy)]
+pub struct BeltDraw {
+    pub a_lo_q8: u128,
+    pub a_hi_q8: u128,
+    pub sigma_milli: u64,
+    pub classes: u64,
+    pub e_levels: u64,
+}
+
+impl BeltDraw {
+    /// The shipped ladder belt: a uniform in [2, 3) AU at 2^-8 of a root unit, e Rayleigh of scale 0.070, continuous.
+    pub const SHIPPED: BeltDraw = BeltDraw {
+        a_lo_q8: (2 * AU as u128) << 8,
+        a_hi_q8: (3 * AU as u128) << 8,
+        sigma_milli: 70,
+        classes: 0,
+        e_levels: 0,
+    };
+}
+
+/// One ship of the belt (the ladder's `k ≥ locals` ships): the draw is [`BeltDraw`]'s, the lanes the ladder's own.
+pub fn belt_ship(seed: u64, k: u64, draw: &BeltDraw) -> Res<(OrbitSpec, Scalar)> {
+    let d = |lane: u64| draw_lane(seed, k, lane);
+    let (angle, phase) = (d(3) as u32, (d(3) >> 32) as u32);
+    let span = draw.a_hi_q8 - draw.a_lo_q8;
+    let a_q8 = if draw.classes > 0 {
+        draw.a_lo_q8 + ((d(1) as u128 % draw.classes as u128) * span) / draw.classes as u128
+    } else {
+        draw.a_lo_q8 + (d(1) as u128 % span)
+    };
+    let mut e = rayleigh_q48((d(2) >> 32) as u32, draw.sigma_milli);
+    for lane in 16.. {
+        if e <= (2u64 << 48) / 5 {
+            break;
+        }
+        e = rayleigh_q48((d(lane) >> 32) as u32, draw.sigma_milli);
+    }
+    if draw.e_levels > 0 {
+        let grid = (1u64 << 48) / draw.e_levels;
+        e = e / grid * grid;
+    }
+    let p_q8 = a_q8 - ((a_q8 * e as u128) >> 48);
+    let spec = OrbitSpec { doll: 0, periapsis: Scalar::raw(p_q8 as i128, -8)?, e_q48: e, clockwise: false, angle, phase };
+    Ok((spec, Scalar::raw(34, -10)?))
+}
