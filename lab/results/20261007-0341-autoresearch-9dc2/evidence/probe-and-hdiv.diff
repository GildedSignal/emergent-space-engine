+/// 9dc2: `n/d` (both u128) through the hardware 64-bit divider whenever the quotient provably
+/// fits u64 (`(n >> 64) < d`, `div_word`'s contract); the wide division otherwise. Identical
+/// bits to `(n / d) as u64`, without `__udivti3` on the hot quadrature path.
+fn hdiv(n: u128, d: u128) -> u64 {
+    if let Ok(d) = u64::try_from(d) {
+        if (n >> 64) < d as u128 {
+            return crate::num::div_word(n, d);
+        }
+    }
+    (n / d) as u64
+}
