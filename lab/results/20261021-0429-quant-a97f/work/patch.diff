+    /// The genesis stagger (a scene variant for the dues census, not a law change): delay every root-doll ship's
+    /// genesis plan by a per-body hash draw in `[0, span)`. The body drifts exactly until its (later) first kick:
+    /// `kick_clock` reads the state by exact readout at the item's tick, so only the schedule moves. Run once,
+    /// right after `start`.
+    pub fn stagger_genesis(&mut self, span: Tick) {
+        for i in 0..self.bodies.len() {
+            if self.info[i].kind != Kind::Ship {
+                continue;
+            }
+            let mut rec = self.bodies.rec(i);
+            if rec.b.doll != 0 || rec.plan.is_empty() || !rec.plan.iter().any(|it| matches!(it.what, What::Kick(_))) {
+                continue;
+            }
+            let h = (i as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15);
+            let by = ((h >> 24) % span.max(1) as u64) as Tick;
+            for it in rec.plan.iter_mut() {
+                it.t += by;
+            }
+            self.bodies.put(i, rec);
+            self.requeue(i);
+        }
+        self.rekey();
+    }
+
     /// Key body `i` in `prunable` at the earliest tick its oldest retired binding could be forgotten (never before `after`), or take it
     /// out when it holds one or none.
     fn key_prune(&mut self, i: usize, after: Tick) {
