@@ -796,11 +802,28 @@ impl Universe {
                 self.resolve_fleet(f, cap);
             }
             None => {
+                // The item about to resolve, read before the clock starts so the classification costs
+                // nothing inside the timed window (resolve_body reads the same plan first).
+                let comb = self.bodies.rec(e).plan.first().map(|it| it.what);
                 let t0 = Instant::now();
                 let class = self.info[e].kind as usize;
                 self.resolve_body(e);
-                self.stats.cost_ns[class] += t0.elapsed().as_nanos() as u64;
+                let el = t0.elapsed().as_nanos() as u64;
+                self.stats.cost_ns[class] += el;
                 self.stats.items[class] += 1;
+                if class == Kind::Ship as usize {
