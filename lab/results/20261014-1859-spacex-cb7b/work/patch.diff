+/// Linux: the resident set and its high-water mark from /proc (kB lines; 0 when unreadable).
+#[cfg(not(target_os = "macos"))]
+fn footprint() -> (u64, u64) {
+    let read = |key: &str| -> u64 {
+        std::fs::read_to_string("/proc/self/status").ok().and_then(|s| {
+            s.lines().find(|l| l.starts_with(key)).and_then(|l| l.split_whitespace().nth(1)?.parse::<u64>().ok())
+        }).unwrap_or(0) * 1024
+    };
+    (read("VmRSS:"), read("VmHWM:"))
+}
