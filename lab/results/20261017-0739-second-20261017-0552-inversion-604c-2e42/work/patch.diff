+/// One ship of the formation scene: co-orbital with the player on Home's low orbit (the fleet's
+/// circle, 4,740 root units — the player's own periapsis), within ±2 % in size (inside one
+/// sixteenth-octave bin of the scan's index, so the radial filter cannot cut it), e Rayleigh of
+/// scale 0.005, uniform angle and phase. A fleet formation: the game's own crowd, drawn from
+/// integers and the seed like [`ladder_ship`], with `k` offset so its draws never collide with the
+/// ladder's.
+pub fn formation_ship(seed: u64, k: u64, home_doll: u16) -> Res<(OrbitSpec, Scalar)> {
+    let d = |lane: u64| draw(seed, k.wrapping_add(1 << 40), lane);
+    let jit = |lane: u64| (d(lane) >> 32) as i128 - (1i128 << 31); // [-1/2, 1/2) turn of 2^32
+    let base = 4_740i128 << 16; // the fleet's circle in root units, Q16 (the ladder locals' shape)
+    let peri_q16 = base + base * jit(1) / (50 * (1i128 << 32)); // ±2 %
+    let mut e = rayleigh_q48((d(2) & 0xFFFF_FFFF) as u32, 5);
+    for lane in 16.. {
+        if e <= (1u64 << 48) / 20 {
+            break;
+        }
+        e = rayleigh_q48((d(lane) & 0xFFFF_FFFF) as u32, 5);
+    }
+    let (angle, phase) = (d(3) as u32, (d(3) >> 32) as u32);
+    let spec = OrbitSpec {
+        doll: home_doll,
+        periapsis: Scalar::raw(peri_q16, 18 - 16)?,
+        e_q48: e,
+        clockwise: false,
+        angle,
+        phase,
+    };
+    Ok((spec, Scalar::raw(34, -10 + 18)?))
+}
