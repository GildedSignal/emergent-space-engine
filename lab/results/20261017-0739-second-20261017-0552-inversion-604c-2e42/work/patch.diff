+        scanstat::W_R.store(w.r.to_bits(), Relaxed);
+        scanstat::W_V.store(w.v.to_bits(), Relaxed);
+        scanstat::W_H.store(w.h.to_bits(), Relaxed);
+        scanstat::W_REACH.store(reach.to_bits(), Relaxed);
+        scanstat::W_VCAP.store(idx.speed_cap.to_bits(), Relaxed);
