+/// The table `base ⊕ over` in ascending id order (both halves ascend; `over` never repeats an id).
+struct Merged<'a> {
+    base: &'a [Cand],
+    over: &'a [Delta],
+    i: usize,
+    k: usize,
+}
+
+impl<'a> Merged<'a> {
+    fn new(t: &'a Table) -> Self {
+        Merged { base: &t.base, over: &t.over, i: 0, k: 0 }
+    }
+}
+
+impl<'a> Iterator for Merged<'a> {
+    type Item = &'a Cand;
+    fn next(&mut self) -> Option<&'a Cand> {
+        loop {
+            match (self.base.get(self.i), self.over.get(self.k)) {
+                (Some(b), Some(Delta::Set(c))) => match b.0.cmp(&c.0) {
+                    std::cmp::Ordering::Less => {
+                        self.i += 1;
+                        return Some(b);
+                    }
+                    std::cmp::Ordering::Equal => {
+                        self.i += 1;
+                        self.k += 1;
+                        return Some(c);
+                    }
+                    std::cmp::Ordering::Greater => {
+                        self.k += 1;
+                        return Some(c);
+                    }
+                },
+                (Some(b), Some(Delta::Del(id))) => {
+                    if b.0 < *id {
+                        self.i += 1;
+                        return Some(b);
+                    }
+                    self.i += (b.0 == *id) as usize;
+                    self.k += 1;
+                }
+                (Some(b), None) => {
+                    self.i += 1;
+                    return Some(b);
+                }
+                (None, Some(Delta::Set(c))) => {
+                    self.k += 1;
+                    return Some(c);
+                }
+                (None, Some(Delta::Del(_))) => {
+                    self.k += 1;
+                }
+                (None, None) => return None,
+            }
+        }
+    }
+}
+
+/// What takes the stored table to the fresh walk (`fresh` ascending by id): every entry whose id or
+/// reading differs, and every stored id the walk no longer holds.
+fn diff(stored: &Table, fresh: &[Cand]) -> Vec<Delta> {
+    let mut out = Vec::new();
+    let mut m = Merged::new(stored).peekable();
+    for f in fresh {
+        // Stored ids below the fresh id are bodies the walk no longer holds.
+        while m.peek().is_some_and(|s| s.0 < f.0) {
+            out.push(Delta::Del(m.next().unwrap().0));
+        }
+        match m.peek() {
+            Some(s) if s.0 == f.0 => {
+                let held = m.next().unwrap();
+                if !(held.2 == f.2 && same(&held.1, &f.1)) {
+                    out.push(Delta::Set(f.clone()));
+                }
+            }
+            _ => out.push(Delta::Set(f.clone())),
+        }
+    }
+    for s in m {
+        out.push(Delta::Del(s.0));
+    }
+    out
+}
+
+/// Merge a delta list into an overlay (both ascending; the delta wins on equal ids).
+fn merge_over(over: &[Delta], d: Vec<Delta>) -> Vec<Delta> {
+    let mut out = Vec::with_capacity(over.len() + d.len());
+    let (mut i, mut k) = (0, 0);
+    while i < over.len() && k < d.len() {
+        let oid = match &over[i] {
+            Delta::Set(c) => c.0,
+            Delta::Del(id) => *id,
+        };
+        let nid = match &d[k] {
+            Delta::Set(c) => c.0,
+            Delta::Del(id) => *id,
+        };
+        if oid < nid {
+            out.push(over[i].clone());
+            i += 1;
+        } else if oid == nid {
+            out.push(d[k].clone());
+            i += 1;
+            k += 1;
+        } else {
+            out.push(d[k].clone());
+            k += 1;
+        }
+    }
+    out.extend(over[i..].iter().cloned());
+    out.extend(d[k..].iter().cloned());
+    out
+}
