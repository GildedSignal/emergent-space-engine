+//! The in-band scan ruin and its deletion: the player inside the belt band (625b/d7e3's scene, this run's
+//! `scenario::plane_extra_band`), flown to a canonical cut, measuring what the scan holds. The patch shares
+//! the candidate table across mints (copy-on-write); pristine main clones the doll's binding table per mint.
+//! The certificate is the digest at the cut: the patch must not move it.
+//!
+//! cargo run --release -p emergent-universe --example scan_ruin [-- <N> <coast|burn> [<wall s> [<rtf> [<budget ms> [<cut game s>]]]]]
+use emergent_universe::encounter::{ADVANCES, DELTA_ENTRIES, DELTAS, MINTS, REUSES, SHARED};
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane_extra_band;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+/// (VmRSS, VmHWM) in bytes, Linux.
+fn rss() -> (u64, u64) {
+    let s = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut out = (0, 0);
+    for line in s.lines() {
+        if let Some(v) = line.strip_prefix("VmRSS:") {
+            out.0 = v.trim_end_matches(" kB").trim().parse().unwrap_or(0) * 1024;
+        }
+        if let Some(v) = line.strip_prefix("VmHWM:") {
+            out.1 = v.trim_end_matches(" kB").trim().parse().unwrap_or(0) * 1024;
+        }
+    }
+    out
+}
+
+fn pct(sorted: &[u32], p: f64) -> u32 {
+    if sorted.is_empty() {
+        return 0;
+    }
+    sorted[(((sorted.len() - 1) as f64) * p).round() as usize]
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(1000);
+    let flight = args.get(2).cloned().unwrap_or_else(|| "burn".into());
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(30.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms: f64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(12.0);
+    let cut_game_s: f64 = args.get(6).and_then(|s| s.parse().ok()).unwrap_or(16_000.0);
+    let burn = flight == "burn";
+    let (_, rss0) = rss();
+    let t0 = Instant::now();
+    let mut p = plane_extra_band(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let (rss1, _) = rss();
+    let bodies = p.u.n_bodies();
+    let t_first = p.u.now;
+    let cut = t_first + (cut_game_s / TICK_SECONDS) as i64;
+    println!("band N={n} ({bodies} bodies) {flight} rtf {rtf} budget {budget_ms} ms cut {cut_game_s} game-s; build {build:.2} s, rss {:.0} MB", rss1 as f64 / 1e6);
+    let mut frames = 0usize;
+    let mut over = 0usize;
+    let mut worst_ms = 0f64;
+    let mut held_max = 0usize;
+    let mut rss_samples: Vec<(usize, u64, usize)> = Vec::new(); // frame, rss, held
+    let mut alive = true;
+    while p.u.now < cut {
+        if t_start.elapsed() > Duration::from_secs((seconds - 2.0).max(5.0) as u64) {
+            println!("TRUNCATED at frame {frames} (wall guard), now {} of cut {}", p.u.now, cut);
+            break;
+        }
+        if burn && frames == 60 {
+            let t = p.u.now;
+            let _ = p.u.input(t, word(1, 8));
+        }
+        let start = Instant::now();
+        let frame = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)) }, cut);
+        let took = start.elapsed().as_secs_f64() * 1e3;
+        frames += 1;
+        over += (took > budget_ms) as usize;
+        worst_ms = worst_ms.max(took);
+        held_max = held_max.max(p.u.held_scans());
+        if frames % 60 == 0 {
+            let (r, _) = rss();
+            rss_samples.push((frames, r, p.u.held_scans()));
+        }
+        let _ = frame.events;
+        if !p.u.rec(p.player).alive {
+            alive = false;
+            break;
+        }
+    }
+    let (rss2, hwm) = rss();
+    let game_s = (p.u.now - t_first) as f64 * TICK_SECONDS;
+    let t_settle = Instant::now();
+    p.u.settle(cut);
+    let settle_s = t_settle.elapsed().as_secs_f64();
+    let digest = p.u.digest();
+    let deltas = DELTAS.lock().unwrap().clone();
+    let mut ds = deltas.clone();
+    ds.sort_unstable();
+    let (mints, reuses, shared, dents, adv) = (
+        MINTS.load(std::sync::atomic::Ordering::Relaxed),
+        REUSES.load(std::sync::atomic::Ordering::Relaxed),
+        SHARED.load(std::sync::atomic::Ordering::Relaxed),
+        DELTA_ENTRIES.load(std::sync::atomic::Ordering::Relaxed),
+        ADVANCES.load(std::sync::atomic::Ordering::Relaxed),
+    );
+    println!(
+        "flight: {frames} frames, {game_s:.0} game-s; over budget {over}, worst {worst_ms:.1} ms; held max {held_max}, now {}; rss {:.0} MB (hwm {:.0} MB); settle {settle_s:.1} s; alive {alive}",
+        p.u.held_scans(),
+        rss2 as f64 / 1e6,
+        hwm as f64 / 1e6
+    );
+    println!("scans: mints {mints}, reuses {reuses}, shared-epoch mints {shared}, delta entries total {dents}, base advances {adv}; delta/mint p50 {} p90 {} max {} of table", pct(&ds, 0.5), pct(&ds, 0.9), pct(&ds, 1.0));
+    println!("rss samples (frame, MB, held): {}", rss_samples.iter().map(|(f, r, h)| format!("({f}, {:.0}, {h})", *r as f64 / 1e6)).collect::<Vec<_>>().join(" "));
+    println!("digest: {digest} kicks {} encounters {} contacts {}", p.u.stats.kicks, p.u.stats.encounters, p.u.contacts);
+    println!("scanruin: n={n} flight={flight} frames={frames} game_s={game_s:.0} over={over} worst_ms={worst_ms:.1} held_max={held_max} rss_mb={:.0} hwm_mb={:.0} settle_s={settle_s:.1} mints={mints} reuses={reuses} shared={shared} dents={dents} adv={adv} dp50={} dp90={} dmax={} kicks={} encounters={} contacts={} digest={digest} alive={alive} rss0_mb={:.0}", rss2 as f64 / 1e6, hwm as f64 / 1e6, pct(&ds, 0.5), pct(&ds, 0.9), pct(&ds, 1.0), p.u.stats.kicks, p.u.stats.encounters, p.u.contacts, rss0 as f64 / 1e6);
+    let _ = (over, worst_ms);
+}
