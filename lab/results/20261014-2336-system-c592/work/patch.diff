+    let p_band = Scalar::raw((((5 * AU) / 2) as i128) << 8, -8)?;
+    let player = u.add_body(
+        Kind::Player,
+        OrbitSpec { doll: 0, periapsis: p_band, e_q48: 0, clockwise: false, angle: fleet_angle.wrapping_add(player_offset), phase: 0 },
+        Scalar::raw(34, -10 + 18)?,
+    )?;
+    names.push("You".into());
+    let f = u.add_fleet(fleet);
+    u.start()?;
+    Ok(Plane { u, planets, dolls, moon: m, player, ships, fleet: f, names })
