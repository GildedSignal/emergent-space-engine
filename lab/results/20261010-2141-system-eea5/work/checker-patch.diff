 use std::sync::Arc;
+/// Compile instrumentation (lab run 20261010-2141-system-eea5): nanoseconds and call count of
+/// `Rebinding::from_state`, the trajectory compilation inside every `bind_in`. The kick bench
+/// reads the deltas around a resolver call to split a kick into compile vs the rest.
+pub fn compile_cost() -> (u64, u64) {
+    (
+        COMPILE_NS.load(std::sync::atomic::Ordering::Relaxed),
+        COMPILE_COUNT.load(std::sync::atomic::Ordering::Relaxed),
+    )
+}
+static COMPILE_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static COMPILE_COUNT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
 
 /// A compiled trajectory and its sense: the entry a tube's key indexes. The trajectory is compiled
 /// about a mass of one, in units of the doll's mass; `unit` converts it to the doll's own units (the
@@ -223,7 +235,10 @@ fn in_tube_units(st: IntegerState, unit: Unit) -> Res<IntegerState> {
 }
 
 fn bind_in(exact: IntegerState, t: Tick, clock_exp: i16, edge: Option<Scalar>, unit: Unit) -> Res<Bound> {
+    let c0 = std::time::Instant::now();
     let fit = Rebinding::from_state(in_tube_units(exact, unit)?, unit.to_tube(time_of(t, clock_exp)?)?, edge.map(|e| unit.to_tube(e)).transpose()?)?;
+    COMPILE_NS.fetch_add(c0.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+    COMPILE_COUNT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
     let peri = i64::try_from(unit.to_doll(fit.periapsis_time)?.fixed(-(clock_exp as i32))?).map_err(|_| Error::Refused("periapsis time outside the clock"))?;
     let tube = Tube::new(0, fit.periapsis_angle, peri);
     let entry = Arc::new(Entry { trajectory: fit.trajectory, clockwise: fit.clockwise, unit });
