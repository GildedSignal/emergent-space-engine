@@ -0,0 +1,162 @@
+// The whole-system audit: does the engine pay per frame per *entity* (a tick), or per *event*?
+// Modes:
+//   tick_audit quiet <n> [frames]  — n quiet ships (4 AU circles, one planet as the secondary), advance
+//                                    with ~zero events; reports per-frame wall and events.
+//   tick_audit digest [cut]        — the plane scenario, three schedules (sparse threads 1, wave threads 4,
+//                                    starved budget), settled at one canonical cut (default 9e10); digests
+//                                    must be equal. Prints per-schedule stats.
+//   tick_audit restricted          — the fleet-free control (tests/motion.rs params): settle vs starved
+//                                    frames at one canonical cut.
+use emergent_universe::body::Kind;
+use emergent_universe::scenario::{plane, AU, STAR_RADIUS};
+use emergent_universe::{Budget, Config, OrbitSpec, Universe};
+use emergent_space::orbit::Scalar;
+use std::time::Instant;
+
+fn s(v: i64) -> Scalar {
+    Scalar::integer(v)
+}
+
+fn quiet(n: usize, frames: usize) {
+    let mut u = Universe::new(s(STAR_RADIUS), Config::default());
+    u.threads = 1;
+    // One planet at 1 AU: the secondary every ship's kick reads. Its own kicks are ~1e11 ticks apart.
+    let planet = u
+        .add_body(
+            Kind::Planet,
+            OrbitSpec { doll: 0, periapsis: s(AU), e_q48: 0, clockwise: false, angle: 0, phase: 0 },
+            Scalar::ZERO,
+        )
+        .unwrap();
+    u.add_doll("Planet", planet, -10, Scalar::raw(1_000, -10).unwrap()).unwrap();
+    // n quiet ships: circular 4 AU orbits, ~8-year periods, kicks ~8e11 ticks apart.
+    let t0 = Instant::now();
+    for k in 0..n {
+        let _ = u
+            .add_body(
+                Kind::Ship,
+                OrbitSpec {
+                    doll: 0,
+                    periapsis: s(4 * AU),
+                    e_q48: 0,
+                    clockwise: false,
+                    angle: (k as u32).wrapping_mul(2_654_435_761),
+                    phase: 0,
+                },
+                Scalar::raw(34, -10).unwrap(),
+            )
+            .unwrap();
+    }
+    let setup_us = t0.elapsed().as_secs_f64() * 1e6;
+    u.start().unwrap();
+    let queued = (0..u.n_bodies()).filter(|e| u.key_of(*e).is_some()).count();
+    // 1e8 ticks per frame: no item can fall due (the nearest is ~1e11 away).
+    let step: i64 = 100_000_000;
+    let mut events_total = 0u64;
+    let mut worst = 0f64;
+    let t0 = Instant::now();
+    for f in 0..frames {
+        let target = step * (f as i64 + 1);
+        let tf = Instant::now();
+        let a = u.advance(target, Budget::unlimited());
+        let dt = tf.elapsed().as_secs_f64() * 1e6;
+        events_total += a.events;
+        if f >= 3 {
+            worst = worst.max(dt);
+        }
+    }
+    let per_frame = t0.elapsed().as_secs_f64() * 1e6 / frames as f64;
+    println!(
+        "quiet n={n} frames={frames} bodies={} queued={} setup={setup_us:.0}us per_frame={per_frame:.2}us worst={worst:.2}us events={events_total} ns_per_body_per_frame={:.2}",
+        u.n_bodies(),
+        queued,
+        per_frame / n as f64 * 1000.0
+    );
+}
+
+fn stats(u: &Universe, tag: &str) {
+    let st = &u.stats;
+    println!(
+        "stats {tag}: kicks={} opens={} boundaries={} handoffs={} slices={} leavers={} dissolved={} lost={} refused={} decisions={} encounters={} items={:?} bodies={} now={} pending_handouts={}",
+        st.kicks, st.opens, st.boundaries, st.handoffs, st.slices, st.leavers, st.dissolved, st.lost, st.refused, st.decisions, st.encounters, st.items, u.n_bodies(), u.now, u.pending_handouts()
+    );
+}
+
+
+fn bodies_mode(cut: i64) {
+    let mut a = plane(Config::default(), 1, emergent_universe::fleet::Order::Sparse, 1, 8).unwrap();
+    a.u.settle(cut);
+    for i in 0..a.u.n_bodies() {
+        let r = a.u.rec(i);
+        println!("body {i} kind={:?} alive={} events={} refusals={} event_time={} interval={}", r.kind, r.alive, r.events, r.refusals, r.b.event_time, r.interval);
+    }
+    println!("digest A: {}", a.u.digest());
+}
+
+fn digest_mode(cut: i64) {
+    // Schedule A: single thread, no budget.
+    let mut a = plane(Config::default(), 1, emergent_universe::fleet::Order::Sparse, 1, 8).unwrap();
+    a.u.settle(cut);
+    println!("digest A (threads 1, settle): {}", a.u.digest());
+    stats(&a.u, "A");
+    // Schedule B: four threads (the wave path), frames under a wall budget.
+    let mut b = plane(Config::default(), 1, emergent_universe::fleet::Order::Sparse, 4, 8).unwrap();
+    let mut t = 0i64;
+    while t < cut {
+        let want = 3_000_000_000i64.min(cut - t);
+        t += want;
+        let _ = b.u.frame_to(1.0, 100.0, Budget::wall(0.5), t);
+    }
+    b.u.settle(cut);
+    println!("digest B (threads 4, budgeted frames): {}", b.u.digest());
+    stats(&b.u, "B");
+    // Schedule C: starved budget (overflow + the deferred path), then catch up.
+    let mut c = plane(Config::default(), 1, emergent_universe::fleet::Order::Sparse, 1, 8).unwrap();
+    let mut t = 0i64;
+    while t < cut {
+        let want = 9_000_000_000i64.min(cut - t);
+        t += want;
+        let _ = c.u.frame_to(1.0, 300.0, Budget::events(3), t);
+    }
+    c.u.settle(cut);
+    println!("digest C (starved, overflow): {}", c.u.digest());
+    stats(&c.u, "C");
+}
+
+fn digest_restricted() {
+    // tests/motion.rs params: mu_log2 = -10, sep = 5.27e8, ships at 1.5–2.6 Hill radii; cut = 3 periods.
+    let (mu_log2, sep) = (-10i32, 527_000_000i64);
+    let hill = sep as f64 * (2f64.powi(mu_log2) / 3.0).cbrt();
+    let ships: Vec<(i64, u32)> =
+        (0..12).map(|i| ((sep as f64 + if i % 2 == 0 { 1.0 } else { -1.0 } * hill * (1.5 + 0.1 * i as f64)) as i64, (i as u32).wrapping_mul(0x9E37_79B9))).collect();
+    let period = 2.0 * std::f64::consts::PI / ((1.0 + 2f64.powi(mu_log2)).sqrt() / (sep as f64).powf(1.5));
+    let cut = (3.0 * period) as i64;
+    let mut a = emergent_universe::scenario::restricted(mu_log2, sep, 49_000, &ships, 1).unwrap();
+    a.u.settle(cut);
+    println!("digest R (restricted, settle): {} [cut {cut}]", a.u.digest());
+    stats(&a.u, "R");
+    let mut b = emergent_universe::scenario::restricted(mu_log2, sep, 49_000, &ships, 1).unwrap();
+    let mut t = 0i64;
+    while t < cut {
+        t += 2_000_000_000i64.min(cut - t);
+        let _ = b.u.frame_to(1.0, 100.0, Budget::events(4), t);
+    }
+    b.u.settle(cut);
+    println!("digest R2 (restricted, starved frames): {}", b.u.digest());
+    stats(&b.u, "R2");
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    match args.get(1).map(|s| s.as_str()) {
+        Some("quiet") => {
+            let n: usize = args[2].parse().unwrap();
+            let frames: usize = args.get(3).map(|s| s.parse().unwrap()).unwrap_or(30);
+            quiet(n, frames);
+        }
+        Some("digest") => digest_mode(args.get(2).map(|s| s.parse().unwrap()).unwrap_or(90_000_000_000)),
+        Some("bodies") => bodies_mode(args.get(2).map(|s| s.parse().unwrap()).unwrap_or(90_000_000_000)),
+        Some("restricted") => digest_restricted(),
+        _ => println!("usage: tick_audit quiet <n> [frames] | digest [cut] | restricted"),
+    }
+}
