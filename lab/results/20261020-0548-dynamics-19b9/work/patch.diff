@@ -0,0 +1,46 @@
+// Isolation: does V1 resolve conserve ΣE + Σresidual exactly, per batch?
+use emergent_lattice::law::{Body, Law, Response};
+use emergent_lattice::relativity::momentum;
+
+fn main() {
+    let q: i64 = 1 << 20;
+    let mut state: u64 = 0x1234_5678_9abc_def0;
+    let mut next = || { state ^= state << 13; state ^= state >> 7; state ^= state << 17; state };
+    let mut worst: i128 = 0;
+    let mut n_bad = 0u64;
+    for _ in 0..200_000u64 {
+        // random pair in contact geometry: close positions, approaching velocities
+        let bits = next() % 20 + 2;
+        let mut r = || (((next() % (1u64 << bits)) as i64) - (1i64 << (bits - 1))).clamp(-(q/2 - 1), q/2 - 1);
+        let d = [r() as i128, r() as i128];
+        if d[0] * d[0] + d[1] * d[1] == 0 { continue; }
+        let ka = [r(), r()];
+        let kb = [r(), r()];
+        // ensure approaching along d and inside light cone
+        let dot = d[0] * (kb[0] - ka[0]) as i128 + d[1] * (kb[1] - ka[1]) as i128;
+        if dot >= 0 { continue; }
+        let xa = [0i64, 0i64];
+        let xb = [d[0] as i64, d[1] as i64];
+        let mut bodies = vec![
+            Body::new(1, xa, ka, 1, q, Response::Bounce),
+            Body::new(2, xb, kb, 1, q, Response::Bounce),
+        ];
+        let e_before: i128 = bodies.iter().map(|b| momentum(Law::RelativisticV1, b.mass, b.k, q)[0]).sum();
+        let r_before: i128 = bodies.iter().map(|b| b.residual as i128).sum();
+        let pairs = vec![(0usize, 1usize)];
+        let walls = vec![false; 2];
+        let mut wm = [0i64; 2];
+        emergent_lattice::relativity::resolve_law(Law::RelativisticV1, q, &mut bodies, &pairs, &walls, None, &mut wm);
+        let e_after: i128 = bodies.iter().map(|b| momentum(Law::RelativisticV1, b.mass, b.k, q)[0]).sum();
+        let r_after: i128 = bodies.iter().map(|b| b.residual as i128).sum();
+        let dev = (e_after - r_after) - (e_before - r_before); // ledger: sumE - sumR invariant
+        if dev != 0 {
+            n_bad += 1;
+            if dev.abs() > worst.abs() { worst = dev; }
+            if n_bad <= 5 {
+                println!("DEV {dev} ka={ka:?} kb={kb:?} d={d:?} -> k={:?} {:?}", bodies[0].k, bodies[1].k);
+            }
+        }
+    }
+    println!("bad batches: {n_bad}/200000, worst |dev| {worst}");
+}
diff --git a/crates/lattice/src/chronon.rs b/crates/lattice/src/chronon.rs
index 9bab167d..004f07f9 100644
--- a/crates/lattice/src/chronon.rs
+++ b/crates/lattice/src/chronon.rs
@@ -141,6 +141,21 @@ impl Chronon {
             });
         }
     }
+
+    /// The kept events so far, taken out of the log. Counters, sums and both digests are
+    /// unaffected (they live in the counters, never in the kept copy); only `sorted`
+    /// readers notice. Read-only instrumentation for harnesses that tally per-chronon
+    /// events without growing memory.
+    pub fn take_kept_events(&mut self) -> Vec<Event> {
+        std::mem::take(&mut self.log.events)
+    }
+
+    /// Per-body carries `[residual, carry[0], carry[1]]` at the world's tick. Read-only
+    /// instrumentation: no state changes, no digest effect.
+    pub fn carries(&self, out: &mut Vec<[i64; 3]>) {
+        out.clear();
+        out.extend(self.w.bodies.iter().map(|b| [b.residual, b.carry[0], b.carry[1]]));
+    }
 }
 
 impl Stepper for Chronon {
