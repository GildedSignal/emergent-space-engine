@@ -1372,4 +1372,18 @@ impl Universe {
     pub fn horizon_of(&self, i: usize) -> Option<Tick> {
         self.key_of(i).map(|k| k.0)
     }
+
+    /// Print-only census of the scheduling apparatus (run 20261020-0036-components-6b9a):
+    /// the five calendars' live lengths and the deadline position cache's row count.
+    /// A getter; no behaviour change.
+    pub fn sched_census(&self) -> [usize; 6] {
+        [
+            self.queue.as_ref().map_or(0, |q| q.len()),
+            self.ship_ticks.len(),
+            self.child_ticks.len(),
+            self.waiting.len(),
+            self.prunable.len(),
+            self.pos.len(),
+        ]
+    }
 }
