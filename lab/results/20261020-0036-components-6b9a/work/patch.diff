@@ -0,0 +1,51 @@
+//! Run 20261020-0036-components-6b9a: occupancy census of the scheduling apparatus on
+//! the shipped flight path (nladder's own driver: plane_extra, frame_to, 12 ms budget).
+//! Print-only; no engine behaviour change (the patch adds the sched_census getter).
+//!
+//! cargo run --release -p emergent-universe --example schedcensus -- <N> <rtf> <wall seconds>
+use emergent_universe::scenario::plane_extra;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+use emergent_universe::fleet::Order;
+use std::time::{Duration, Instant};
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let n: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(10_000);
+    let rtf: f64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(1000.0);
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(30.0);
+    let frames = (seconds * 60.0) as usize;
+    let t_start = Instant::now();
+    let mut p = plane_extra(Config::default(), 1, Order::Sparse, 1, 48, n).unwrap();
+    let bodies = p.u.n_bodies();
+    let [q, st, ct, w, pr, pos] = p.u.sched_census();
+    println!(
+        "census n={} bodies={} build_s={:.2} | queue={} ship_ticks={} child_ticks={} waiting={} prunable={} pos={} | frac_of_bodies {:.3} {:.3} {:.3} {:.3} {:.3}",
+        n, bodies, t_start.elapsed().as_secs_f64(), q, st, ct, w, pr, pos,
+        q as f64 / bodies as f64, st as f64 / bodies as f64, ct as f64 / bodies as f64,
+        w as f64 / bodies as f64, pr as f64 / bodies as f64
+    );
+    let mut last_kicks = p.u.stats.kicks;
+    let mut t0 = p.u.now;
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs(50) {
+            println!("truncated at frame {f}");
+            break;
+        }
+        let start = Instant::now();
+        let _ = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_micros(12_000)) }, i64::MAX);
+        if f % 120 == 0 || f == frames - 1 {
+            let [q, st, ct, w, pr, pos] = p.u.sched_census();
+            let gs = (p.u.now - t0) as f64 * TICK_SECONDS;
+            let dk = p.u.stats.kicks.saturating_sub(last_kicks);
+            println!(
+                "census f={f} gs={gs:.0} kicks+={dk} | queue={} ship_ticks={} child_ticks={} waiting={} prunable={} pos={} | frac {:.3} {:.3} {:.3} {:.3} {:.3}",
+                q, st, ct, w, pr, pos,
+                q as f64 / bodies as f64, st as f64 / bodies as f64, ct as f64 / bodies as f64,
+                w as f64 / bodies as f64, pr as f64 / bodies as f64
+            );
+            last_kicks = p.u.stats.kicks;
+            t0 = p.u.now;
+        }
+    }
+}
