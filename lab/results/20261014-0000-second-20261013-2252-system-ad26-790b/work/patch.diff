+/// Lab probe (run 20261013-2005-quant-7055): the key identity of every `from_state` compile, and an
+/// **exact** memo of compiled trajectories keyed on (OrbitKey, effective edge) — compile is a pure
+/// function of the key, so a hit returns bit-identical bits (unlike the killed quantized memo).
+/// Both inert unless the env vars are set; `site` tags the caller (1 = a hand-out's bind).
+pub mod promo_probe {
+    use super::{OrbitKey, Scalar, Trajectory};
+    use crate::Result;
+    use std::cell::Cell;
+    use std::collections::HashMap;
+    use std::sync::{LazyLock, Mutex};
+
+    const MEMO_CAP: usize = 1 << 16;
+
+    thread_local! {
+        static SITE: Cell<u8> = const { Cell::new(0) };
+    }
+    pub fn set_site(s: u8) {
+        SITE.with(|c| c.set(s));
+    }
+    pub fn site() -> u8 {
+        SITE.with(|c| c.get())
+    }
+    /// (site, periodic, hit, key) per `from_state` compile, in call order.
+    static LOG: LazyLock<Mutex<Vec<(u8, bool, bool, String)>>> =
+        LazyLock::new(|| Mutex::new(Vec::new()));
+    static MEMO: LazyLock<Mutex<HashMap<(OrbitKey, Option<Scalar>), Trajectory>>> =
+        LazyLock::new(|| Mutex::new(HashMap::new()));
+
+    pub fn logging() -> bool {
+        std::env::var_os("ES_ORBIT_KEYS").is_some()
+    }
+    pub fn memo_on() -> bool {
+        std::env::var_os("ES_ORBIT_MEMO").is_some()
+    }
+
+    /// Compile through the exact memo (if on) and log the key (if on). `edge` is the effective
+    /// passage edge (the caller's, or the state's own radius).
+    pub fn trajectory(
+        key: OrbitKey,
+        edge: Option<Scalar>,
+        site: u8,
+        compile: impl FnOnce() -> Result<Trajectory>,
+    ) -> Result<Trajectory> {
+        let mut hit = false;
+        let out = if memo_on() {
+            let mk = (key, edge);
+            let mut m = MEMO.lock().unwrap();
+            if let Some(t) = m.get(&mk) {
+                hit = true;
+                Ok(t.clone())
+            } else {
+                let t = compile()?;
+                if m.len() < MEMO_CAP {
+                    m.insert(mk, t.clone());
+                }
+                Ok(t)
+            }
+        } else {
+            compile()
+        };
+        if logging() {
+            LOG.lock()
+                .unwrap()
+                .push((site, key.periodic(), hit, format!("{:?}", key)));
+        }
+        out
+    }
+
+    /// The log, drained: (site, periodic, hit, key) rows in call order.
+    pub fn take_log() -> Vec<(u8, bool, bool, String)> {
+        std::mem::take(&mut *LOG.lock().unwrap())
+    }
+    pub fn memo_entries() -> usize {
+        MEMO.lock().unwrap().len()
+    }
+}
