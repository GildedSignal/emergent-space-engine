+/// Whether readers between kicks reconstruct the field from the kicks' stored two-word (`a`, slope)
+/// instead of evaluating the sources once per read. The word is the view's only; the arm changes no
+/// outcome, and with it off the engine runs the shipped per-read evaluation bit for bit.
+pub fn a_word() -> bool {
+    static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("A_WORD").ok().as_deref() == Some("2"));
+    *ON
+}
