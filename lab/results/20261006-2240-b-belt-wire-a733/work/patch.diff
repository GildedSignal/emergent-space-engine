diff --git a/xtask/src/behave/space_belt.rs b/xtask/src/behave/space_belt.rs
new file mode 100644
index 0000000..7157ea5
--- /dev/null
+++ b/xtask/src/behave/space_belt.rs
@@ -0,0 +1,256 @@
+//! The space law's belt: the shipmem belt program behind the judge's [`Belt`] interface.
+//!
+//! The program is Sol's (wt/belt, `crates/shipmem/src/belt.rs`): body i is a pure function of
+//! its ordinal and the belt's five keys, through a quantile table derived at birth from the
+//! parameters (a working constant, never stored: B18b caps a program's declared information at
+//! its parameters). The keys come from the birth seed, so the whole belt is a function of
+//! (spec, n, seed). History rewrites an ordinal as a scar: the store keeps each scarred body
+//! as its delta against the program's body (varint ordinal gaps, zigzag varint deltas), so a
+//! 50-bit replacement kick costs about ten bytes and nothing else changes.
+
+use super::belt::{Belt, BeltSpec, Body, Form};
+use emergent_shipmem::belt::{Belt as Program, Columns, Params};
+use std::collections::BTreeMap;
+
+/// The five keys of a birth: the SplitMix64 finalizer of the seed and the column, made odd,
+/// with repeats re-mixed until distinct (a collision has probability about 2^-60; the loop is
+/// deterministic, so the same seed always gives the same keys).
+fn keys_from(seed: u64) -> [u64; 5] {
+    let mix = |mut z: u64| {
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    };
+    let mut keys = [0u64; 5];
+    for f in 0..5 {
+        let mut k = mix(seed ^ ((f as u64 + 1).wrapping_mul(0x9E37_79B9_7F4A_7C15))) | 1;
+        while keys[..f].contains(&k) {
+            k = mix(k) | 1;
+        }
+        keys[f] = k;
+    }
+    keys
+}
+
+fn params_of(spec: &BeltSpec) -> Option<Params> {
+    // The judged belt draws no kind; the program's 6-bit kind column stays for the engine.
+    Some(Params { p_lo: u32::try_from(spec.p_lo).ok()?, p_bits: spec.p_bits, sigma_milli: spec.sigma_milli, e_bits: spec.e_bits, e_cap: spec.e_cap, kind_bits: 6, w_bits: spec.w_bits, t_bits: spec.t_bits })
+}
+
+fn put_varint(out: &mut Vec<u8>, mut v: u64) {
+    loop {
+        let b = (v & 0x7F) as u8;
+        v >>= 7;
+        if v == 0 {
+            out.push(b);
+            return;
+        }
+        out.push(b | 0x80);
+    }
+}
+fn get_varint(b: &[u8], at: &mut usize) -> Option<u64> {
+    let (mut v, mut shift) = (0u64, 0u32);
+    loop {
+        let byte = *b.get(*at)?;
+        *at += 1;
+        v |= ((byte & 0x7F) as u64) << shift;
+        if byte & 0x80 == 0 {
+            return Some(v);
+        }
+        shift += 7;
+    }
+}
+fn zigzag(d: u64) -> u64 {
+    (d << 1) ^ ((d as i64 >> 63) as u64)
+}
+fn unzigzag(z: u64) -> u64 {
+    ((z >> 1) as i64 ^ -((z & 1) as i64)) as u64
+}
+
+/// One belt of the space law: the program, its length, and its scars.
+pub struct SpaceBelt {
+    program: Program,
+    n: u64,
+    seed: u64,
+    scars: BTreeMap<u64, Body>,
+}
+
+impl SpaceBelt {
+    pub fn birth(spec: &BeltSpec, n: u64, seed: u64) -> Option<SpaceBelt> {
+        let program = Program::new(keys_from(seed), Columns::Independent, params_of(spec)?).ok()?;
+        Some(SpaceBelt { program, n, seed, scars: BTreeMap::new() })
+    }
+
+    /// The program's body for ordinal i (the scars' reference).
+    fn program_body(&self, i: u64) -> Body {
+        let (p, e, _kind, w, t) = self.program.draws(i);
+        Body { p: p as u64, e: e as u64, w: w as u64, t }
+    }
+
+    pub fn restore(bytes: &[u8]) -> Option<SpaceBelt> {
+        if bytes.first()? != &b'S' || bytes.get(1)? != &1 {
+            return None;
+        }
+        let mut at = 2usize;
+        let n = get_varint(bytes, &mut at)?;
+        let seed = u64::from_le_bytes(bytes.get(at..at + 8)?.try_into().unwrap());
+        at += 8;
+        let p_lo = get_varint(bytes, &mut at)?;
+        let p_bits = *bytes.get(at)? as u32;
+        at += 1;
+        let sigma_milli = u16::from_le_bytes([*bytes.get(at)?, *bytes.get(at + 1)?]) as u64;
+        at += 2;
+        let e_bits = *bytes.get(at)? as u32;
+        at += 1;
+        let e_cap = get_varint(bytes, &mut at)?;
+        let kind_bits = *bytes.get(at)? as u32;
+        at += 1;
+        let w_bits = *bytes.get(at)? as u32;
+        at += 1;
+        let t_bits = *bytes.get(at)? as u32;
+        at += 1;
+        let params = Params { p_lo: u32::try_from(p_lo).ok()?, p_bits, sigma_milli, e_bits, e_cap, kind_bits, w_bits, t_bits };
+        let program = Program::new(keys_from(seed), Columns::Independent, params).ok()?;
+        let mut belt = SpaceBelt { program, n, seed, scars: BTreeMap::new() };
+        let count = get_varint(bytes, &mut at)?;
+        let mut prev = 0u64;
+        for j in 0..count {
+            let gap = get_varint(bytes, &mut at)?;
+            let i = if j == 0 { gap } else { prev + 1 + gap };
+            let mut d = [0u64; 4];
+            for x in &mut d {
+                *x = unzigzag(get_varint(bytes, &mut at)?);
+            }
+            let base = belt.program_body(i);
+            belt.scars.insert(
+                i,
+                Body {
+                    p: base.p.wrapping_add(d[0]),
+                    e: base.e.wrapping_add(d[1]),
+                    w: base.w.wrapping_add(d[2]),
+                    t: base.t.wrapping_add(d[3]),
+                },
+            );
+            prev = i;
+        }
+        (at == bytes.len() && belt.n == n).then_some(belt)
+    }
+}
+
+impl Belt for SpaceBelt {
+    fn len(&self) -> u64 {
+        self.n
+    }
+    fn body(&self, i: u64) -> Body {
+        if let Some(b) = self.scars.get(&i) {
+            return *b;
+        }
+        self.program_body(i)
+    }
+    fn store(&self) -> Vec<u8> {
+        let mut out = vec![b'S', 1];
+        put_varint(&mut out, self.n);
+        out.extend(self.seed.to_le_bytes());
+        let p = self.program.params();
+        put_varint(&mut out, p.p_lo as u64);
+        out.push(p.p_bits as u8);
+        out.extend((p.sigma_milli as u16).to_le_bytes());
+        out.push(p.e_bits as u8);
+        put_varint(&mut out, p.e_cap);
+        out.push(p.kind_bits as u8);
+        out.push(p.w_bits as u8);
+        out.push(p.t_bits as u8);
+        put_varint(&mut out, self.scars.len() as u64);
+        let mut prev = 0u64;
+        for (j, (&i, b)) in self.scars.iter().enumerate() {
+            let base = self.program_body(i);
+            put_varint(&mut out, if j == 0 { i } else { i - prev - 1 });
+            for (&x, y) in [b.p, b.e, b.w, b.t].iter().zip([base.p, base.e, base.w, base.t]) {
+                put_varint(&mut out, zigzag(x.wrapping_sub(y)));
+            }
+            prev = i;
+        }
+        out
+    }
+    fn bytes_used(&self) -> u64 {
+        // What the belt holds that is specific to the population: its parameters and its scars.
+        // The derived table is a working constant of the law, not counted and not stored.
+        self.store().len() as u64
+    }
+    fn scar(&mut self, i: u64, b: Body) {
+        self.scars.insert(i, b);
+    }
+    fn form(&self) -> Form {
+        Form::Program { info_bytes: self.store().len() as u64 }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::behave::belt::SPEC;
+
+    #[test]
+    fn birth_is_deterministic_and_round_trips() {
+        let mut belt = SpaceBelt::birth(&SPEC, 1 << 14, 20261008).unwrap();
+        let truth: Vec<u64> = (0..1 << 14).map(|i| belt.body(i).hash()).collect();
+        let twin = SpaceBelt::birth(&SPEC, 1 << 14, 20261008).unwrap();
+        assert_eq!(twin.store(), belt.store());
+        assert!((0..1 << 14).all(|i| twin.body(i).hash() == truth[i as usize]));
+        let bytes = belt.store();
+        let back = SpaceBelt::restore(&bytes).unwrap();
+        assert_eq!(back.store(), bytes);
+        assert!((0..1 << 14).all(|i| back.body(i).hash() == truth[i as usize]));
+        // A birth at 1e9 costs constant bytes (the judge reports this number).
+        let billion = SpaceBelt::birth(&SPEC, 1_000_000_000, 7).unwrap();
+        assert!(billion.store().len() <= 64, "{}", billion.store().len());
+    }
+
+    #[test]
+    fn scars_replace_exactly_and_stay_cheap() {
+        let n = 1u64 << 16;
+        let mut belt = SpaceBelt::birth(&SPEC, n, 99).unwrap();
+        let birth = belt.store().len() as u64;
+        let mut kicked = 0;
+        for i in 0..n {
+            if i % 101 == 0 {
+                let mut b = belt.body(i);
+                b.p = b.p.wrapping_add(200);
+                b.e = b.e.wrapping_sub(1000);
+                b.w = b.w.wrapping_add(30000);
+                b.t = b.t.wrapping_add(2);
+                belt.scar(i, b);
+                kicked += 1;
+            }
+        }
+        let pristine = SpaceBelt::birth(&SPEC, n, 99).unwrap();
+        for i in 0..n {
+            let want = pristine.body(i);
+            let want = if i % 101 == 0 {
+                Body { p: want.p.wrapping_add(200), e: want.e.wrapping_sub(1000), w: want.w.wrapping_add(30000), t: want.t.wrapping_add(2) }
+            } else {
+                want
+            };
+            assert_eq!(belt.body(i), want, "ordinal {i}");
+        }
+        let per = (belt.store().len() as u64 - birth) as f64 / kicked as f64;
+        // The floor of a 50-bit kick plus which-ordinal is about 6.8 bytes here; the rule is
+        // [0.5 floor, 2 floor + 2].
+        assert!(per >= 3.0 && per <= 15.5, "{per:.2} bytes per scarred body");
+        let bytes = belt.store();
+        let back = SpaceBelt::restore(&bytes).unwrap();
+        assert_eq!(back.store(), bytes);
+        assert!((0..n).all(|i| back.body(i) == belt.body(i)));
+    }
+
+    #[test]
+    fn keys_are_distinct_odd_and_seed_driven() {
+        assert_eq!(keys_from(1), keys_from(1));
+        assert_ne!(keys_from(1), keys_from(2));
+        for seed in [0u64, 1, 20261008] {
+            let k = keys_from(seed);
+            assert!(k.iter().all(|x| x & 1 == 1));
+            assert!((0..5).all(|i| !k[..i].contains(&k[i])));
+        }
+    }
