diff --git a/crates/shipmem/src/belt.rs b/crates/shipmem/src/belt.rs
new file mode 100644
index 0000000..1280f24
--- /dev/null
+++ b/crates/shipmem/src/belt.rs
@@ -0,0 +1,264 @@
+//! Independent birth belt: banded Darwin p, Rayleigh e, uniform kind, omega and t_p.
+//! This is a description of individuals, not preservation of an existing iid sample.
+//! Correlated/sculpted belts are unsupported: they require a joint description.
+//! The quantile table is derived at birth from the parameters and never stored (a working
+//! constant of the law); no floating arithmetic decides regeneration.
+use crate::codec::Enc;
+use crate::codec::MAXC;
+use crate::program::Prog;
+use crate::shelf::Ship;
+use emergent_space::Key;
+use std::sync::Arc;
+
+#[path = "belt_quantiles.rs"]
+mod quantiles;
+
+/// Bijective counter finalizer for odd keys. Projection to a column is not injective.
+#[inline]
+pub fn mix(i: u64, key: u64) -> u64 {
+    let mut z = i.wrapping_add(0x9E37_79B9_7F4A_7C15).wrapping_mul(key);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Columns {
+    Independent,
+    Correlated,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BeltError {
+    CorrelatedColumns,
+    InvalidKeys,
+    /// The parameters leave the u32 Darwin p grid, or e off its u32 grid.
+    OutOfRange,
+}
+
+/// The belt's parameters: everything but its keys. p is Darwin's in Q16 (p_lo included),
+/// e Rayleigh of this sigma on the 2^e_bits grid capped at e_cap, the kind uniform over
+/// 2^kind_bits, omega over 2^w_bits and t_p over 2^t_bits quanta.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Params {
+    pub p_lo: u32,
+    pub p_bits: u32,
+    /// Rayleigh sigma of e, in thousandths (70 is 0.070).
+    pub sigma_milli: u64,
+    pub e_bits: u32,
+    pub e_cap: u64,
+    pub kind_bits: u32,
+    pub w_bits: u32,
+    pub t_bits: u32,
+}
+impl Params {
+    /// The lab's smooth belt (components-98bc): p in [2048, 2560) Q16, e Rayleigh sigma 0.07,
+    /// 64 kinds, omega over 2^32, t_p over 2^44.
+    pub const LAB: Params = Params { p_lo: 2048 << 16, p_bits: 25, sigma_milli: 70, e_bits: 30, e_cap: u32::MAX as u64, kind_bits: 6, w_bits: 32, t_bits: 44 };
+    pub fn sigma(&self) -> f64 {
+        self.sigma_milli as f64 / 1000.0
+    }
+
+    fn check(&self) -> Result<(), BeltError> {
+        let p_fits = (self.p_lo as u64 + (1u64 << self.p_bits)) <= 1 + u32::MAX as u64;
+        if !p_fits || self.e_bits > 32 || self.kind_bits > 64 || self.w_bits > 64 || self.t_bits > 64 || self.kind_bits == 0 {
+            return Err(BeltError::OutOfRange);
+        }
+        Ok(())
+    }
+}
+
+/// The lab's smooth belt as a program: body i is a pure function of (keys, i). The table is
+/// derived at birth (see [`quantiles`]) and shared by every clone; the store of a belt is its
+/// keys and parameters, nothing else.
+#[derive(Clone)]
+pub struct Belt {
+    keys: [u64; 5],
+    params: Params,
+    table: Arc<quantiles::Quantiles>,
+}
+
+/// Two belts are the same program iff their keys and parameters are: the table is derived
+/// from the parameters, never an identity of its own.
+impl std::fmt::Debug for Belt {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Belt").field("keys", &self.keys).field("params", &self.params).finish_non_exhaustive()
+    }
+}
+impl PartialEq for Belt {
+    fn eq(&self, other: &Self) -> bool {
+        self.keys == other.keys && self.params == other.params
+    }
+}
+impl Eq for Belt {}
+
+impl Belt {
+    pub const LAB_KEYS: [u64; 5] = [
+        0x0123_4567_89ab_cdef,
+        0x243f_6a88_85a3_08d3,
+        0x1319_8a2e_0370_7345,
+        0xa409_3822_299f_31d1,
+        0x082e_fa98_ec4e_6c89,
+    ];
+
+    pub fn new(keys: [u64; 5], columns: Columns, params: Params) -> Result<Self, BeltError> {
+        if columns != Columns::Independent {
+            return Err(BeltError::CorrelatedColumns);
+        }
+        if keys.iter().any(|k| k & 1 == 0) || (0..5).any(|i| keys[..i].contains(&keys[i])) {
+            return Err(BeltError::InvalidKeys);
+        }
+        params.check()?;
+        Ok(Self { keys, params, table: Arc::new(quantiles::derive(&params)) })
+    }
+
+    pub fn params(&self) -> Params {
+        self.params
+    }
+
+    pub fn keys(&self) -> [u64; 5] {
+        self.keys
+    }
+
+    /// The derived table's payload in bytes: a working constant of the law, charged once per
+    /// population and never stored.
+    pub fn table_bytes(&self) -> usize {
+        self.table.bytes()
+    }
+
+    /// Quantile of a uniform u64 draw through the table derived at birth: the middle of the
+    /// distribution at 12-bit resolution, and dyadic octaves at both ends, so no tail is capped.
+    #[inline]
+    pub fn eccentricity(&self, u: u64) -> u32 {
+        let e = &self.table.e;
+        let central = (u >> 52) as usize;
+        if central != 0 && central != 4095 {
+            return e[central - 1];
+        }
+        if central == 0 {
+            // The bottom of e: the CDF v = u/2^64 < 2^-12, in its own octaves. The fraction
+            // takes the 6 bits below the leading one, like the survival at the top end.
+            if u < 64 {
+                return e[4094 + 46 * 64 + u as usize];
+            }
+            let z = u.leading_zeros() as usize;
+            let f = ((u >> (57 - z)) & 63) as usize;
+            return e[4094 + (z - 12) * 64 + f];
+        }
+        // The top of e: the survival s = !u < 2^12 of the probability, in its own octaves.
+        let s = !u;
+        if s < 64 {
+            return e[4094 + 46 * 64 + 64 + 46 * 64 + s as usize];
+        }
+        let z = s.leading_zeros() as usize;
+        let f = ((s >> (57 - z)) & 63) as usize;
+        e[4094 + 46 * 64 + 64 + (z - 12) * 64 + f]
+    }
+
+    /// Physical draws, before the law's exact boundary conversion: (p Q16, e Qe_bits, kind, omega, t_p).
+    #[inline]
+    pub fn draws(&self, i: u64) -> (u32, u32, u64, u32, u64) {
+        let u = |f: usize| mix(i, self.keys[f]);
+        (
+            self.params.p_lo + (u(0) >> (64 - self.params.p_bits)) as u32,
+            self.eccentricity(u(1)),
+            u(2) >> (64 - self.params.kind_bits),
+            (u(3) >> (64 - self.params.w_bits)) as u32,
+            u(4) >> (64 - self.params.t_bits),
+        )
+    }
+
+    /// The engine's ship for ordinal i: the draw through the law's exact (E, L) conversion.
+    #[inline]
+    pub fn eval(&self, i: u64) -> Ship {
+        let (p, e, kind, w, t) = self.draws(i);
+        let key = Key::darwin(p, e).expect("belt's full quantile range is bound");
+        [
+            t,
+            kind,
+            key.energy.get(),
+            key.angular.get(),
+            w as u64,
+            0,
+            0,
+            0,
+        ]
+    }
+
+    pub fn programs(&self) -> [Prog; MAXC] {
+        std::array::from_fn(|column| {
+            if column < 5 {
+                Prog::Belt(BeltColumn {
+                    belt: self.clone(),
+                    column: column as u8,
+                    offset: 0,
+                })
+            } else {
+                Prog::Const(0)
+            }
+        })
+    }
+
+    /// Birth is constant work and stores no generated members.
+    pub fn population(&self, n: u64, enc: &mut Enc) -> crate::program::Program {
+        assert!(n <= u32::MAX as u64, "population hot ordinals are u32");
+        crate::program::Program::seal_from(n, 5, self.programs(), &[], enc)
+    }
+}
+
+/// A column view of the same population program; splitting only shifts its ordinal.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct BeltColumn {
+    pub(crate) belt: Belt,
+    pub(crate) column: u8,
+    pub(crate) offset: u64,
+}
+
+impl BeltColumn {
+    #[inline]
+    pub fn at(&self, i: u64) -> u64 {
+        let i = self.offset.wrapping_add(i);
+        let p = &self.belt.params;
+        match self.column {
+            0 => mix(i, self.belt.keys[4]) >> (64 - p.t_bits),
+            1 => mix(i, self.belt.keys[2]) >> (64 - p.kind_bits),
+            4 => (mix(i, self.belt.keys[3]) >> (64 - p.w_bits)) as u64,
+            c => self.belt.eval(i)[c as usize],
+        }
+    }
+    pub(crate) fn shifted(mut self, s: u64) -> Self {
+        self.offset = self.offset.wrapping_add(s);
+        self
+    }
+    pub(crate) fn bounds(&self) -> (i128, i128) {
+        let p = &self.belt.params;
+        match self.column {
+            0 => (0, (1i128 << p.t_bits) - 1),
+            1 => (0, (1i128 << p.kind_bits) - 1),
+            2 => (1, 16i128 << 48),
+            3 => (1 << 30, 4096i128 << 32),
+            4 => (0, (1i128 << p.w_bits) - 1),
+            _ => unreachable!(),
+        }
+    }
+}
+
+/// Recognize a full belt once, so E and L share one Darwin conversion.
+pub(crate) fn base(prog: &[Prog; MAXC], cols: usize, i: u64) -> Option<Ship> {
+    let Prog::Belt(first) = &prog[0] else {
+        return None;
+    };
+    if cols != 5 || first.column != 0 {
+        return None;
+    }
+    if (1..5).any(|c| {
+        &prog[c]
+            != &Prog::Belt(BeltColumn {
+                column: c as u8,
+                ..first.clone()
+            })
+    }) {
+        return None;
+    }
+    Some(first.belt.eval(first.offset.wrapping_add(i)))
+}
