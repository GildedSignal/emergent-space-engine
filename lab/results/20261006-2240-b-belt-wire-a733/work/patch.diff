new file mode 100644
index 0000000..31be38d
--- /dev/null
+++ b/crates/shipmem/src/belt_quantiles.rs
@@ -0,0 +1,119 @@
+//! The belt's eccentricity quantiles, derived at birth from the parameters.
+//!
+//! No frozen data: the table is a working constant of the law (B18b: "a table derived from the
+//! spec is a working constant, not counted, and not stored"), rebuilt whenever a belt is born.
+//! Only +, -, *, / and IEEE sqrt decide its bits, so every machine derives the same table and
+//! regeneration afterwards is pure integer arithmetic.
+//!
+//! Structure (u the uniform word, v = u/2^64, S = 1 - v the survival, e = sigma*sqrt(-2 ln S)
+//! on the 2^e_bits grid, floored and capped):
+//! - 4094 central midpoint cells for v in [2^-12, 1 - 2^-12] (u's top 12 bits 1..=4094);
+//! - at BOTH ends of e, 46 dyadic octaves of 64 cells each plus the exact last 64 draws, so
+//!   neither tail is capped: the bottom of e (v < 2^-12, e near 0) and the top (S < 2^-12,
+//!   e large) are each resolved in their own probability octaves. A single-level midpoint
+//!   table puts a whole 1e-4 tail in one cell; dyadic in the probability's octaves does not.
+//!
+//! The bottom end resolves octaves of the CDF 1 - S (v itself, near 0), the top end octaves of
+//! the survival S: each octave holds half of the previous one's probability, and within an
+//! octave all 64 cells are equally wide, so the belt's e marginal is the law's, discretized.
+
+use super::Params;
+
+/// Central midpoint cells: u's top 12 bits 1..=4094.
+const MID: usize = 4094;
+/// Octaves at each end: lz of the end's word in [12, 57] (the word in [64, 2^52)).
+const OCTAVES: usize = 46;
+const CELLS: usize = 64;
+
+/// The derived table. Indexed exactly as [`crate::belt::Belt::eccentricity`] reads it:
+/// [central 4094][bottom octaves][bottom exact 64][top octaves][top exact 64].
+pub struct Quantiles {
+    pub e: Vec<u32>,
+}
+
+impl Quantiles {
+    /// The bytes of working constant the executable holds for one belt (charged once per
+    /// population, never stored, never declared as information).
+    pub fn bytes(&self) -> usize {
+        self.e.len() * 4
+    }
+}
+
+/// ln x for a positive normal x from +, -, *, / only: the exponent, then 2 atanh((m-1)/(m+1))
+/// for the mantissa. The same bits on every machine (the truncation error, < 2^-70 here, is a
+/// fixed function of the input bits).
+fn ln_det(x: f64) -> f64 {
+    let bits = x.to_bits();
+    let mut k = ((bits >> 52) & 0x7FF) as i64 - 1023;
+    let mut m = f64::from_bits((bits & 0x000F_FFFF_FFFF_FFFF) | 0x3FF0_0000_0000_0000);
+    if m > std::f64::consts::SQRT_2 {
+        m *= 0.5;
+        k += 1;
+    }
+    let z = (m - 1.0) / (m + 1.0);
+    let z2 = z * z;
+    let (mut sum, mut term, mut j) = (0.0, z, 1.0);
+    for _ in 0..14 {
+        sum += term / j;
+        term *= z2;
+        j += 2.0;
+    }
+    k as f64 * std::f64::consts::LN_2 + 2.0 * sum
+}
+
+/// ln(1 - d) for 0 < d <= 2^-12, from +, -, *, / only (the series; 12 terms leave < 2^-140).
+fn ln_1m(d: f64) -> f64 {
+    let (mut sum, mut term) = (0.0, d);
+    for k in 1..=12 {
+        sum += term / (k as f64);
+        term *= d;
+    }
+    -sum
+}
+
+/// e = sigma * sqrt(-2 ln S) on the 2^e_bits grid, floored and capped.
+fn grid(ln_s: f64, p: &Params) -> u32 {
+    let e = p.sigma() * (-2.0 * ln_s).sqrt() * (1u64 << p.e_bits) as f64;
+    (e as u64).min(p.e_cap) as u32
+}
+
+/// The midpoint survival of central cell j (u's top bits j, j in 1..=4094): 1 - (j + 0.5)/4096,
+/// exact in f64 (13 significant bits).
+fn mid_survival(j: usize) -> f64 {
+    1.0 - (j as f64 + 0.5) / 4096.0
+}
+
+/// The dyadic cell midpoint of word w with lz(w) = z in [12, 57] and fraction f in [0, 64):
+/// (2^(63-z) + (2f+1) 2^(56-z)) / 2^64 = 2^-(z+1) (1 + (f + 0.5)/64), exact in f64.
+fn dyadic(z: u32, f: usize) -> f64 {
+    (1.0 + (f as f64 + 0.5) / 64.0) / ((1u64 << (z + 1)) as f64)
+}
+
+/// Derive the table from the parameters. Deterministic: the same bits for the same params on
+/// every machine (exact arithmetic above; sqrt is IEEE-exact).
+pub fn derive(p: &Params) -> Quantiles {
+    assert!(p.e_bits <= 32, "the table stores e as u32");
+    let mut e = Vec::with_capacity(MID + 2 * (OCTAVES * CELLS + CELLS));
+    for j in 1..=MID {
+        e.push(grid(ln_det(mid_survival(j)), p));
+    }
+    // The bottom of e: u in [0, 2^52), the CDF v = u/2^64 in [0, 2^-12). Octaves of v.
+    for z in 12..12 + OCTAVES as u32 {
+        for f in 0..CELLS {
+            e.push(grid(ln_1m(dyadic(z, f)), p));
+        }
+    }
+    for u in 0..CELLS as u64 {
+        e.push(grid(ln_1m((u as f64 + 0.5) / 18_446_744_073_709_551_616.0), p));
+    }
+    // The top of e: survival s = !u in [0, 2^52). Octaves of s.
+    for z in 12..12 + OCTAVES as u32 {
+        for f in 0..CELLS {
+            e.push(grid(ln_det(dyadic(z, f)), p));
+        }
+    }
+    for s in 0..CELLS as u64 {
+        e.push(grid(ln_det((s as f64 + 0.5) / 18_446_744_073_709_551_616.0), p));
+    }
+    Quantiles { e }
+}
