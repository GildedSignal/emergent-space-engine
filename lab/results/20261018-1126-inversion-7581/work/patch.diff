+//! The formation probe: what the player's neighbourhood scan costs when the crowd around the player is
+//! a fleet formation on the player's own circle (the game's own scene: factions fly in fleets), instead
+//! of the N ladder's spread population (locals capped at 300, none on the player's low orbit, the rest a
+//! belt the radial filter cuts). Coasting only, flown the way the page flies it; every number a
+//! key=value on one `probe:` line. The scan census (`radial::scanstat`) is counters only.
+//!
+//! cargo run --release --features prof -p emergent-universe --example scanprobe [-- <form> [<extra> [<wall seconds> [<rtf>]]]]
+use emergent_universe::fleet::Order;
+use emergent_universe::radial::scanstat;
+use emergent_universe::scenario::plane_formation;
+use emergent_universe::{Budget, Config};
+use std::time::{Duration, Instant};
+
+/// (resident, peak) from /proc on Linux, zeros elsewhere: the lab's machines are Linux.
+fn footprint() -> (u64, u64) {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let mut rss = 0;
+    let mut hwm = 0;
+    for line in status.lines() {
+        if let Some(v) = line.strip_prefix("VmRSS:") {
+            rss = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0);
+        }
+        if let Some(v) = line.strip_prefix("VmHWM:") {
+            hwm = v.trim().trim_end_matches("kB").trim().parse().unwrap_or(0);
+        }
+    }
+    (rss * 1024, hwm * 1024)
+}
+
+fn main() {
+    let t_start = Instant::now();
+    let args: Vec<String> = std::env::args().collect();
+    let form: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let extra: usize = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let seconds: f64 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(10.0);
+    let rtf: f64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(100.0);
+    let budget_ms = 12.0;
+    let frames = (seconds * 60.0) as usize;
+    let (_, rss0) = footprint();
+    let t0 = Instant::now();
+    let mut p = plane_formation(Config::default(), 1, Order::Sparse, 1, 48, extra, form).unwrap();
+    let build = t0.elapsed().as_secs_f64();
+    let (_, rss1) = footprint();
+    let bodies = p.u.n_bodies();
+    println!(
+        "probe form={form} extra={extra} ({bodies} bodies), coast, rtf {rtf}, {seconds} s; build {build:.2} s, peak {rss0}..{rss1} bytes; cand_bytes {}",
+        scanstat::candidate_bytes()
+    );
+    let mut rows: Vec<(usize, f64, u64)> = Vec::new(); // frame, engine ms, events
+    let mut stage_ns = [0u64; emergent_universe::prof::N];
+    let mut stage_calls = [0u64; emergent_universe::prof::N];
+    let mut held_max = 0usize;
+    let mut late_stats: Option<(emergent_universe::universe::Stats, i64)> = None;
+    let mut last_stats = p.u.stats;
+    for f in 0..frames {
+        if t_start.elapsed() > Duration::from_secs(55) {
+            break;
+        }
+        if f == 60 {
+            late_stats = Some((p.u.stats, p.u.now));
+            scanstat::reset();
+            let _ = emergent_universe::prof::take();
+        }
+        let start = Instant::now();
+        let frame = p.u.frame_to(1.0 / 60.0, rtf, Budget { events: u64::MAX, until: Some(start + Duration::from_micros((budget_ms * 1e3) as u64)) }, i64::MAX);
+        let took = start.elapsed();
+        let (ns, calls) = emergent_universe::prof::take();
+        if f >= 60 {
+            for k in 0..emergent_universe::prof::N {
+                stage_ns[k] += ns[k];
+                stage_calls[k] += calls[k];
+            }
+        }
+        rows.push((f, took.as_secs_f64() * 1e3, frame.events));
+        if let Ok(path) = std::env::var("ES_DUMP") {
+            use std::io::Write;
+            if let Ok(mut out) = std::fs::OpenOptions::new().create(true).append(true).open(&path) {
+                let _ = writeln!(out, "{f} {} {}", took.as_secs_f64() * 1e3, frame.events);
+            }
+        }
+        held_max = held_max.max(p.u.held_scans());
+        last_stats = p.u.stats;
+    }
+    let late: Vec<_> = rows.iter().filter(|r| r.0 >= 60).collect();
+    let mut ms: Vec<f64> = late.iter().map(|r| r.1).collect();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let pct = |p: f64| if ms.is_empty() { 0.0 } else { ms[(((ms.len() - 1) as f64) * p).round() as usize] };
+    let mut evq: Vec<u64> = late.iter().map(|r| r.2).collect();
+    evq.sort_unstable();
+    let evp = |p: f64| if evq.is_empty() { 0 } else { evq[(((evq.len() - 1) as f64) * p).round() as usize] };
+    let over = late.iter().filter(|r| r.1 > budget_ms).count();
+    let worst = late.iter().max_by_key(|r| r.2);
+    let (_, rss2) = footprint();
+    let g = |c: &std::sync::atomic::AtomicU64| c.load(std::sync::atomic::Ordering::Relaxed);
+    let f64bits = |c: &std::sync::atomic::AtomicU64| f64::from_bits(c.load(std::sync::atomic::Ordering::Relaxed));
+    println!(
+        "window: r={:.3e} v={:.3e} h={:.3e} near={:.3e} reach={:.3e} speed_cap={:.3e} radius_cap={:.3e} bins={:.1}",
+        f64bits(&scanstat::W_R), f64bits(&scanstat::W_V), f64bits(&scanstat::W_H), f64bits(&scanstat::W_NEAR), f64bits(&scanstat::W_REACH), f64bits(&scanstat::W_VCAP), f64bits(&scanstat::W_RCAP), g(&scanstat::BINS_SUM) as f64 / (g(&scanstat::CALLS) as f64).max(1.0)
+    );
+    let (s0, t_first) = late_stats.unwrap_or((p.u.stats, p.u.now));
+    let game_s = (p.u.now - t_first) as f64 * emergent_universe::view::TICK_SECONDS;
+    let (kicks, evs) = (last_stats.kicks - s0.kicks, last_stats.events() - s0.events());
+    println!(
+        "ledger: kicks={} opens={} boundaries={} handoffs={} encounters={} decisions={} slices={} lost={} refused={} leavers={} dissolved={}",
+        last_stats.kicks - s0.kicks,
+        last_stats.opens - s0.opens,
+        last_stats.boundaries - s0.boundaries,
+        last_stats.handoffs - s0.handoffs,
+        last_stats.encounters - s0.encounters,
+        last_stats.decisions - s0.decisions,
+        last_stats.slices - s0.slices,
+        last_stats.lost - s0.lost,
+        last_stats.refused - s0.refused,
+        last_stats.leavers - s0.leavers,
+        last_stats.dissolved - s0.dissolved
+    );
+    use std::sync::atomic::Ordering::Relaxed;
+    let g = |c: &std::sync::atomic::AtomicU64| c.load(Relaxed);
+    let (calls, walks) = (g(&scanstat::CALLS), g(&scanstat::WALKS));
+    let captures = g(&scanstat::CAPTURES).max(1);
+    println!(
+        "scan: bodies={} scans={} kept={} bailed_count={} bailed_range={} no_doll={} | hit/scan mean {:.1} max {} | near/scan mean {:.1} max {} | full-walk scans {} mean {:.1} bodies | binding_at/scan mean {:.1} max {} | candidates/scan mean {:.1} max {} | unbounded/scan mean {:.1} | bins/scan mean {:.1}",
+        g(&scanstat::BODIES),
+        calls,
+        calls - g(&scanstat::BAIL_COUNT) - g(&scanstat::BAIL_RANGE),
+        g(&scanstat::BAIL_COUNT),
+        g(&scanstat::BAIL_RANGE),
+        g(&scanstat::NO_DOLL),
+        g(&scanstat::HIT_SUM) as f64 / calls.max(1) as f64,
+        g(&scanstat::HIT_MAX),
+        g(&scanstat::NEAR_SUM) as f64 / captures as f64,
+        g(&scanstat::NEAR_MAX),
+        walks,
+        g(&scanstat::WALK_SUM) as f64 / walks.max(1) as f64,
+        g(&scanstat::BIND_SUM) as f64 / captures as f64,
+        g(&scanstat::BIND_MAX),
+        g(&scanstat::CAND_SUM) as f64 / captures as f64,
+        g(&scanstat::CAND_MAX),
+        g(&scanstat::UNB_SUM) as f64 / calls.max(1) as f64,
+        g(&scanstat::BINS_SUM) as f64 / calls.max(1) as f64,
+    );
+    if emergent_universe::prof::ENABLED {
+        let n = late.len().max(1);
+        for k in 0..emergent_universe::prof::N {
+            if stage_calls[k] > 0 {
+                println!("  {:<38} {:>9.1} us/frame {:>8.2} calls/frame {:>10.0} ns/call", emergent_universe::prof::NAMES[k], stage_ns[k] as f64 / 1e3 / n as f64, stage_calls[k] as f64 / n as f64, stage_ns[k] as f64 / stage_calls[k] as f64);
+            }
+        }
+    }
+    println!(
+        "comb: p50_ev={} p99_ev={} max_ev={} worst_frame={} worst_ms={:.2}",
+        evp(0.5),
+        evp(0.99),
+        evp(1.0),
+        worst.map_or(-1, |r| r.0 as i64),
+        worst.map_or(0.0, |r| r.1)
+    );
+    println!(
+        "probe: form={form} extra={extra} bodies={bodies} frames={} build_s={build:.2} hwm_mb={:.0} p50_ms={:.3} p99_ms={:.3} max_ms={:.3} over={over} held_max={held_max} kicks={kicks} events={evs} game_s={game_s:.1} digest={}",
+        rows.len(),
+        rss2 as f64 / 1e6,
+        pct(0.5),
+        pct(0.99),
+        pct(1.0),
+        p.u.digest()
+    );
+}
