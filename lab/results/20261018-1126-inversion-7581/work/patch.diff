diff --git a/crates/universe/src/radial.rs b/crates/universe/src/radial.rs
index 9f822265..585be3cc 100644
--- a/crates/universe/src/radial.rs
+++ b/crates/universe/src/radial.rs
@@ -20,6 +20,64 @@ use crate::body::Kind;
 use crate::num::to_f64;
 use emergent_space::{binding::Trajectory, orbit::Scalar};
 use std::collections::HashMap;
+/// A print-only census of the scan's radial filter (the lab's formation probe): what the filter keeps,
+/// what it bails on, and what the caller then walks. Counters only; no read of them changes anything.
+pub mod scanstat {
+    /// The last window asked, and the doll's caps when it was (f64 bits; the probe's diagnosis).
+    pub static W_R: AtomicU64 = AtomicU64::new(0);
+    pub static W_V: AtomicU64 = AtomicU64::new(0);
+    pub static W_H: AtomicU64 = AtomicU64::new(0);
+    pub static W_REACH: AtomicU64 = AtomicU64::new(0);
+    pub static W_VCAP: AtomicU64 = AtomicU64::new(0);
+    pub static W_RCAP: AtomicU64 = AtomicU64::new(0);
+    pub static W_NEAR: AtomicU64 = AtomicU64::new(0);
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    /// Scans that reached the index (the doll is registered).
+    pub static CALLS: AtomicU64 = AtomicU64::new(0);
+    /// Scans of a doll the index does not know: the caller walks every body.
+    pub static NO_DOLL: AtomicU64 = AtomicU64::new(0);
+    /// Bails: the window spanned more than 4096 bins.
+    pub static BAIL_RANGE: AtomicU64 = AtomicU64::new(0);
+    /// Bails: the kept set exceeded `bodies/4 + 64`.
+    pub static BAIL_COUNT: AtomicU64 = AtomicU64::new(0);
+    /// Bodies in the window's bins, summed and worst over those scans.
+    pub static HIT_SUM: AtomicU64 = AtomicU64::new(0);
+    pub static HIT_MAX: AtomicU64 = AtomicU64::new(0);
+    /// Unbounded bodies (planets, moons, the player) added to every kept set.
+    pub static UNB_SUM: AtomicU64 = AtomicU64::new(0);
+    /// Bins a window spans, summed.
+    pub static BINS_SUM: AtomicU64 = AtomicU64::new(0);
+    /// Bodies registered when last asked.
+    pub static BODIES: AtomicU64 = AtomicU64::new(0);
+    /// The capture half (encounter.rs): scans taken, their near sets, and the walks the bails became.
+    pub static CAPTURES: AtomicU64 = AtomicU64::new(0);
+    pub static NEAR_SUM: AtomicU64 = AtomicU64::new(0);
+    pub static NEAR_MAX: AtomicU64 = AtomicU64::new(0);
+    pub static WALKS: AtomicU64 = AtomicU64::new(0);
+    pub static WALK_SUM: AtomicU64 = AtomicU64::new(0);
+    /// `binding_at` calls of the candidate loop (the cheap half's reads), summed and worst a scan.
+    pub static BIND_SUM: AtomicU64 = AtomicU64::new(0);
+    pub static BIND_MAX: AtomicU64 = AtomicU64::new(0);
+    /// Candidates a scan holds (its read set, and its memory), summed and worst.
+    pub static CAND_SUM: AtomicU64 = AtomicU64::new(0);
+    pub static CAND_MAX: AtomicU64 = AtomicU64::new(0);
+
+    /// Zero every counter (the probe's own reset, before its measured window).
+    pub fn reset() {
+        for c in [&CALLS, &NO_DOLL, &BAIL_RANGE, &BAIL_COUNT, &HIT_SUM, &HIT_MAX, &UNB_SUM, &BINS_SUM, &CAPTURES, &NEAR_SUM, &NEAR_MAX, &WALKS, &WALK_SUM, &BIND_SUM, &BIND_MAX, &CAND_SUM, &CAND_MAX] {
+            c.store(0, Relaxed);
+        }
+        for c in [&W_R, &W_V, &W_H, &W_REACH, &W_VCAP, &W_RCAP, &W_NEAR] {
+            c.store(0, Relaxed);
+        }
+        BODIES.store(0, Relaxed);
+    }
+
