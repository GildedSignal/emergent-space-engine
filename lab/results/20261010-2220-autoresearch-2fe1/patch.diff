+/// floor(sqrt(x)) for u64, f64-seeded then corrected by exact squaring, so the
+/// returned bits are identical to any exact search; the seed error is at most
+/// a few steps (x rounds to 53 bits before the IEEE-exact sqrt).
+#[inline]
+pub fn isqrt64(x: u64) -> u64 {
+    if x < 2 {
+        return x;
+    }
+    let mut r = (x as f64).sqrt() as u64;
+    if r == 0 {
+        r = 1;
+    }
+    while (r as u128) * (r as u128) > x as u128 {
+        r -= 1;
+    }
+    let mut up = r + 1;
+    while (up as u128) * (up as u128) <= x as u128 {
+        r = up;
+        up += 1;
+    }
+    r
+}
