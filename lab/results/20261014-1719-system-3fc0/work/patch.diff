+//! The wave probe: the player's item pull (`pull_ships`) during the belt's first-kick wave, bounded or not,
+//! must not move a bit — and its monster frames must die when it is bounded (lab run 20261014-1719-system-3fc0).
+//!
+//! cargo run --release -p emergent-universe --example wave_probe [-- <members> <game_seconds_cut> <rtf>]
+use emergent_universe::fleet::Order;
+use emergent_universe::scenario::plane;
+use emergent_universe::thrust::word;
+use emergent_universe::view::TICK_SECONDS;
+use emergent_universe::{Budget, Config};
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let members: u64 = args.next().and_then(|a| a.parse().ok()).unwrap_or(100_000);
+    let game_s: f64 = args.next().and_then(|a| a.parse().ok()).unwrap_or(16_000.0);
+    let rtf: f64 = args.next().and_then(|a| a.parse().ok()).unwrap_or(200.0);
+    let cut = (game_s / TICK_SECONDS) as i64;
+    let mut p = plane(Config::default(), 1, Order::Sparse, 1, members).unwrap();
+    let t_burn = (1.0 * rtf / TICK_SECONDS) as i64;
+    p.u.schedule(t_burn, word(2, 8)).unwrap();
+    let mut frames = Vec::new();
+    let mut stuck = 0usize;
+    let mut last_now = p.u.now;
+    let t0 = std::time::Instant::now();
+    for _ in 0..200_000 {
+        if p.u.now >= cut {
+            break;
+        }
+        let f0 = std::time::Instant::now();
+        p.u.frame_to(1.0 / 60.0, rtf, Budget::wall(12.0), cut);
+        frames.push(f0.elapsed().as_secs_f64() * 1e3);
+        stuck = if p.u.now > last_now { 0 } else { stuck + 1 };
+        last_now = p.u.now;
+        if frames.len() % 600 == 0 {
+            let worst = frames.iter().cloned().fold(0.0_f64, f64::max);
+            println!(
+                "progress frames={} now={} worst_ms={:.1} over12={}",
+                frames.len(),
+                p.u.now,
+                worst,
+                frames.iter().filter(|&&f| f > 12.0).count()
+            );
+            if stuck >= 600 {
+                println!("stalled: the horizon has not advanced for 600 frames");
+                break;
+            }
+        }
+    }
+    let reached = p.u.now;
+    let t_settle = std::time::Instant::now();
+    p.u.settle(cut);
+    frames.sort_by(|a, b| a.total_cmp(b));
+    let q = |pr: f64| frames[(pr * (frames.len() - 1) as f64) as usize];
+    println!(
+        "members={} game_s={} rtf={} digest={} reached={} kicks={} encounters={} contacts={} worst_ms={:.1} p99_ms={:.1} over12={} over50={} frames={} wall_s={:.0} settle_s={:.1}",
+        members,
+        game_s,
+        rtf,
+        p.u.digest(),
+        reached,
+        p.u.stats.kicks,
+        p.u.stats.encounters,
+        p.u.contacts,
+        frames.last().copied().unwrap_or(0.0),
+        q(0.99),
+        frames.iter().filter(|&&f| f > 12.0).count(),
+        frames.iter().filter(|&&f| f > 50.0).count(),
+        frames.len(),
+        t0.elapsed().as_secs_f64(),
+        t_settle.elapsed().as_secs_f64(),
+    );
+}
