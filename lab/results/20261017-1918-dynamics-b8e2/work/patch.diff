diff --git a/xtask/src/main.rs b/xtask/src/main.rs
index 9ef42f99..58b0e6bb 100644
--- a/xtask/src/main.rs
+++ b/xtask/src/main.rs
@@ -19,6 +19,45 @@ use std::{
     process::{Command, ExitCode},
 };
 type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+// The FLOW probe's instrument: live heap bytes and allocations, process-wide (the allocator is otherwise `System`).
+pub static LIVE_BYTES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static LIVE_ALLOCS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+struct Counting;
+unsafe impl std::alloc::GlobalAlloc for Counting {
+    unsafe fn alloc(&self, l: std::alloc::Layout) -> *mut u8 {
+        let p = std::alloc::System.alloc(l);
+        if !p.is_null() {
+            LIVE_BYTES.fetch_add(l.size() as u64, std::sync::atomic::Ordering::Relaxed);
+            LIVE_ALLOCS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+        p
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: std::alloc::Layout) {
+        std::alloc::System.dealloc(p, l);
+        LIVE_BYTES.fetch_sub(l.size() as u64, std::sync::atomic::Ordering::Relaxed);
+        LIVE_ALLOCS.fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: std::alloc::Layout, n: usize) -> *mut u8 {
+        let q = std::alloc::System.realloc(p, l, n);
+        if !q.is_null() {
+            LIVE_BYTES.fetch_add(n as u64, std::sync::atomic::Ordering::Relaxed);
+            LIVE_BYTES.fetch_sub(l.size() as u64, std::sync::atomic::Ordering::Relaxed);
+        }
+        q
+    }
+    unsafe fn alloc_zeroed(&self, l: std::alloc::Layout) -> *mut u8 {
+        let p = std::alloc::System.alloc_zeroed(l);
+        if !p.is_null() {
+            LIVE_BYTES.fetch_add(l.size() as u64, std::sync::atomic::Ordering::Relaxed);
+            LIVE_ALLOCS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+        p
+    }
+}
+
+#[global_allocator]
+static COUNTING: Counting = Counting;
 
 fn main() -> ExitCode {
     match run() {
