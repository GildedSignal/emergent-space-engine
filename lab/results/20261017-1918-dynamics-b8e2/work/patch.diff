         })).collect::<Vec<_>>(),
     })
 }
+
+// ---- the FLOW probe (print-only; enabled by RUIN_PROBE) ---------------------------------------------------------------
+// One CSV line per sampled frame (and one at the cut's settle): the held-scans queue's length, its arrival and
+// departure counts, and the process's live allocations. No decision reads these; the law is untouched.
+static PROBE_ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("RUIN_PROBE").is_ok_and(|v| v != "0"));
+static PROBE_FRAME: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static PROBE_LAST_PRINT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn flow_probe(s: &Session, tag: &str) {
+    if !*PROBE_ON {
+        return;
+    }
+    let u = &s.p.u;
+    let held = u.held_scans() as u64;
+    let n = PROBE_FRAME.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let last = PROBE_LAST_PRINT.load(std::sync::atomic::Ordering::Relaxed);
+    let every = std::env::var("RUIN_EVERY").ok().and_then(|v| v.parse::<u64>().ok()).unwrap_or(30).max(1);
+    let backlog: u64 = std::env::var("RUIN_BACKLOG").ok().and_then(|v| v.parse().ok()).unwrap_or(2048);
+    // A print every `every` frames, plus whenever the queue crosses a 64-step upward or nears the cap (the plateau).
+    let crossing = (held / 64) > (last / 64) || held + 4 >= backlog;
+    if tag == "f" && n % every != 0 && !crossing {
+        return;
+    }
+    PROBE_LAST_PRINT.store(held, std::sync::atomic::Ordering::Relaxed);
+    let gs = u.now as f64 * emergent_universe::view::TICK_SECONDS;
+    let rss = std::fs::read_to_string("/proc/self/statm")
+        .ok()
+        .and_then(|t| t.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+        .map(|p| p * 4096 / 1024)
+        .unwrap_or(0);
+    eprintln!(
+        "PROBE,{tag},{n},{gs:.1},{held},{},{},{},{},{}",
+        u.stats.scans_in, u.stats.scans_out,
+        crate::LIVE_BYTES.load(std::sync::atomic::Ordering::Relaxed),
+        crate::LIVE_ALLOCS.load(std::sync::atomic::Ordering::Relaxed),
+        rss
+    );
+}
