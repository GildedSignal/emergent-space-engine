         let t1 = Instant::now();
         let view = match gather_cached(&self.p.u, &self.names, &mut self.cache) {
             Some(v) => v,
@@ -165,6 +166,7 @@ impl Session {
     pub fn digest_at_cut(&mut self) -> (emergent_universe::num::Tick, String) {
         let t = self.cut.unwrap_or(self.p.u.now);
         self.p.u.settle(t);
