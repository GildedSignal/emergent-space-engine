+/// One re-kick on body `i` (the ES_REKICK bench's public entry; `Universe::es_rekick_sweep` drives it).
+pub fn es_rekick(ctx: &Ctx, i: usize, rec: BodyRec, t: Tick, dt_game_s: f64) -> Update {
+    let mut w = Work { ctx, i, rec, retired: Vec::new(), new_entry: None };
+    let _ = w.rekick(t, dt_game_s);
+    Update { rec: w.rec, retired: w.retired, new_entry: w.new_entry, kind: Resolved::Open }
+}
