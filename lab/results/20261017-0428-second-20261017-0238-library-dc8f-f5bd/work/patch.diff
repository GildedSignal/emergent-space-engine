+// ---- ES_REKICK bench timers (lab probe; inert unless ES_REKICK is set) ---------------------------
+pub static ES_RK_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static ES_RK_N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static ES_KICK_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static ES_KICK_N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static ES_CARRY_N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static ES_BENCH: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+
+fn es_bench_on() -> bool {
+    match ES_BENCH.load(std::sync::atomic::Ordering::Relaxed) {
+        0 => {
+            let on = es_flag("ES_REKICK");
+            ES_BENCH.store(if on { 2 } else { 1 }, std::sync::atomic::Ordering::Relaxed);
+            on
+        }
+        2 => true,
+        _ => false,
+    }
+}
