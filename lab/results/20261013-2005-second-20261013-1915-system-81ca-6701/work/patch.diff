+            let psi = st.psi as f64 / 2f64.powi(61);
+            let s = (psi / 2.0).sin();
+            let (t_mine, tau_mine, adv_mine) = inc.at(s);
+            // inbound half: the shipped solves the reflected phase — mirror mine
+            let (half_t, half_tau, half_adv) = inc.at(1.0);
+            let full_t = 2.0 * half_t;
+            // the read state's advance is q*sum (per-half-cycle integral units):
+            // my adv(phi) is the doubled (per-cycle) value, so compare at half scale
+            let (t_cmp, tau_cmp, adv_cmp) = if tn_target <= half_t {
+                (t_mine, tau_mine, adv_mine / 2.0)
+            } else {
+                (full_t - t_mine, 2.0 * half_tau - tau_mine, half_adv - adv_mine / 2.0)
+            };
+            let rel_t = (t_cmp - tn_target).abs() / tn_target;
+            let tau_ship = decode(st.proper_time) / tscale;
+            let rel_tau = (tau_cmp - tau_ship).abs() / tau_ship;
+            let adv_ship = decode(st.advance);
+            // advance crosses zero at periapsis: only rows where the shipped value is
+            // above its own Q30 storage quantum decide; the rest are counted, not judged
+            worst[0] = worst[0].max(rel_t);
+            worst[1] = worst[1].max(rel_tau);
+            if adv_ship.abs() > 1e-6 {
+                let rel_adv = (adv_cmp - adv_ship).abs() / adv_ship.abs();
+                worst[2] = worst[2].max(rel_adv);
+                nread += 1;
+            } else {
+                nsub += 1;
+            }
+        }
+        let t_target = encode(decode(o.period().unwrap()) * 0.31);
+        let t0 = Instant::now();
+        for _ in 0..2000 {
+            let u = 1.0 + 0.55 * (apo / peri - 1.0);
+            let s = ((1.0 - inc.cos_psi(u)) / 2.0).sqrt();
+            std::hint::black_box(inc.at(std::hint::black_box(s)));
+        }
+        let inc_ns = t0.elapsed().as_nanos() as f64 / 2000.0;
+        let t0 = Instant::now();
+        for _ in 0..2000 {
+            std::hint::black_box(o.signed_state(std::hint::black_box(t_target))).ok();
+        }
+        let state_ns = t0.elapsed().as_nanos() as f64 / 2000.0;
+        let tn_target = decode(t_target);
+        let t0 = Instant::now();
+        for _ in 0..2000 {
+            let (mut lo, mut hi) = (1e-9f64, 1.0f64);
+            let mut phi = 0.5f64;
+            for _ in 0..60 {
+                let (t1, _, _) = inc.at(phi);
+                if (t1 - tn_target).abs() <= 1e-14 * tn_target {
+                    break;
+                }
+                if t1 < tn_target {
+                    lo = phi;
+                } else {
+                    hi = phi;
+                }
+                phi = (lo + hi) / 2.0;
+            }
+            std::hint::black_box(phi);
+        }
+        let solve_ns = t0.elapsed().as_nanos() as f64 / 2000.0;
+        println!(
+            "  ({:>8.3},{:>6}) incomplete 3ch {:>6.0} ns; signed_state() {:>7.0} ns vs closed-form solve {:>7.0} ns",
+            r.p, r.e, inc_ns, state_ns, solve_ns
+        );
+    }
+    println!(
+        "READOUT n={nread} (+{nsub} sub-quantum adv rows): worst rel(t)={:.2e} rel(tau)={:.2e} rel(adv)={:.2e}",
+        worst[0], worst[1], worst[2]
+    );
+
+    // dump for the mpmath cross-check in regen.sh
+    println!("\nMPMATH-DUMP");
+    for (p, e) in [(12.0, 0.3), (12.0, 0.99), (7.3, 0.05), (8.0, 0.995), (96.0, 0.5), (50.0, 0.99999)] {
+        let k = key(p, e);
+        if let Ok(o) = Orbit::compile(k) {
+            let par = Par::from_key(&k);
+            let cf = channels_f64(&par);
+            let peri = decode(k.periapsis);
+            let tscale = peri * peri.sqrt();
+            let kk = k.k as f64 / 2f64.powi(48);
+            let q = 1.0 / (p * kk);
+            let _ = decode(o.advance().unwrap());
+            println!(
+                "MPK p={p} e={e} k={kk:.17} q={q:.17} ts={tscale:.17e} adv={:.17e} t_half={:.17e} tau_half={:.17e}",
+                cf.0, cf.1, cf.2
+            );
+        }
+    }
+}
