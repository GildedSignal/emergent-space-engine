+    let l2 = (32u64 << 32) - ((k << 32) | frac); // log2(2^32 / d), Q32
+    let ln = (l2 as u128 * 2_977_044_472u128) >> 32; // ln 2 = 2977044472 / 2^32; ln(2^32 / d), Q32
+    let e2 = ((ln * 2 * (sigma_milli as u128).pow(2)) << 64) / 1_000_000; // e², Q96
+    e2.isqrt() as u64 // e · 2^48
