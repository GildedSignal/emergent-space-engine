+pub fn rayleigh_q48(u: u32, sigma_milli: u64) -> u64 {
+    let d = (1u64 << 32) - u as u64; // the survival probability, d / 2^32, in (0, 1]
+    let k = 63 - d.leading_zeros() as u64;
+    let mut x = (d as u128) << (62 - k); // the mantissa in [1, 2), Q62
+    let mut frac = 0u64;
+    for _ in 0..32 {
